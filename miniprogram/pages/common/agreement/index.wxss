/* Agreement Reading Page Style */
.agreement-page {
  min-height: 100vh;
  padding: 0 28rpx 140rpx;
  background: linear-gradient(180deg, #fff5f8 0%, #fff8ec 42%, #fffaf6 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.agreement-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #ffd6e7 0%, #ffc0d9 54%, #fff0f5 100%);
  box-shadow: 0 18rpx 44rpx rgba(216, 27, 96, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #c2185b;
  background: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon {
  font-size: 28rpx;
}

.hero-title {
  color: #2d211a;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #6a4a58;
  font-size: 24rpx;
  line-height: 1.4;
}

.card {
  padding: 28rpx;
  border-radius: 36rpx;
  background: #fff;
  border: 2rpx solid rgba(233, 30, 99, 0.2);
  box-shadow: 0 14rpx 34rpx rgba(216, 27, 96, 0.06);
}

.agreement-card {
  display: flex;
  flex-direction: column;
  height: calc(100vh - 460rpx);
  min-height: 540rpx;
}

.agreement-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(233, 30, 99, 0.12);
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.header-icon {
  color: #e91e63;
  font-size: 36rpx;
}

.header-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
}

.countdown-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
}

.countdown-badge.active {
  color: #d32f2f;
  background: #ffebee;
}

.countdown-badge.done {
  color: #18a87c;
  background: #eafaf3;
}

.agreement-scroll-content {
  flex: 1;
  height: 100%;
  overflow-y: auto;
  padding-right: 8rpx;
  box-sizing: border-box;
}

.agreement-section {
  margin-bottom: 32rpx;
}

.section-title-pill {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 12rpx 28rpx;
  margin-bottom: 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f8bbd0 0%, #ffcdd2 100%);
  border: 2rpx solid #d81b60;
  box-sizing: border-box;
}

.pill-text {
  color: #880e4f;
  font-size: 30rpx;
  font-weight: 950;
  letter-spacing: 2rpx;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.6);
}

.pill-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 1.5rpx solid rgba(0, 0, 0, 0.15);
}

.dot-pink {
  background: #ff4081;
}

.dot-yellow {
  background: #ffeb3b;
}

.section-card-box {
  background: #ffffff;
  border: 2rpx solid #f48fb1;
  border-radius: 28rpx;
  padding: 24rpx 26rpx;
  box-shadow: 0 6rpx 16rpx rgba(216, 27, 96, 0.05);
}

.section-item {
  margin-bottom: 20rpx;
}

.section-item:last-child {
  margin-bottom: 0;
}

.item-title {
  color: #2d211a;
  font-size: 27rpx;
  font-weight: 950;
  margin-bottom: 6rpx;
  display: block;
}

.item-text-wrap {
  font-size: 25rpx;
  line-height: 1.65;
}

.seg-text {
  color: #4a423d;
}

.text-highlight {
  color: #d32f2f;
  font-weight: 950;
  background: rgba(211, 47, 47, 0.08);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin: 0 2rpx;
}

.agreement-action-area {
  margin-top: 24rpx;
}

.checkbox-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.custom-checkbox {
  transform: scale(0.85);
}

.label-text {
  color: #5f5650;
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.35;
}

.primary-btn {
  min-height: 84rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ff80ab 0%, #e91e63 100%);
  color: #fff;
  box-shadow: 0 10rpx 26rpx rgba(233, 30, 99, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 950;
  border: none;
  line-height: 1;
}

.continue-btn {
  width: 100%;
}

.disabled-btn {
  background: #e5e0dc !important;
  color: #a09790 !important;
  box-shadow: none !important;
  opacity: 0.85;
}

.ghost-btn {
  width: 100%;
  min-height: 72rpx;
  margin-top: 14rpx;
  border-radius: 24rpx;
  background: transparent;
  color: #8e8580;
  font-size: 25rpx;
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.text-link-clickable {
  text-decoration: underline;
  cursor: pointer;
}

/* Modal Popup Styles */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  box-sizing: border-box;
}

.deposit-modal {
  width: 100%;
  max-width: 620rpx;
  max-height: 80vh;
  border-radius: 40rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  padding: 32rpx 36rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(233, 30, 99, 0.12);
}

.header-title-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.modal-title-icon {
  color: #e91e63;
  font-size: 38rpx;
}

.modal-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f7f3f0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7a6a5e;
  font-size: 32rpx;
}

.modal-body-scroll {
  flex: 1;
  padding: 28rpx 36rpx;
  max-height: 56vh;
  box-sizing: border-box;
}

.deposit-section {
  margin-bottom: 24rpx;
}

.deposit-section:last-child {
  margin-bottom: 0;
}

.deposit-sec-title {
  color: #c2185b;
  font-size: 27rpx;
  font-weight: 950;
  margin-bottom: 8rpx;
}

.deposit-sec-p {
  color: #4a423d;
  font-size: 25rpx;
  line-height: 1.6;
}

.strong-text {
  color: #2d211a;
  font-weight: 900;
}

.modal-footer {
  padding: 24rpx 36rpx 32rpx;
  border-top: 1rpx solid rgba(233, 30, 99, 0.08);
}

.modal-confirm-btn {
  width: 100%;
  min-height: 80rpx;
  border-radius: 999rpx;
}
