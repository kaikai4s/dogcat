page { height: 100%; background: #fff9f2; }
.map-page {
  --accent: #176b5b; --soft: #eaf5ef; --ink: #2d211a;
  height: 100%; display: flex; flex-direction: column; overflow: hidden;
  color: var(--ink); font-size: 28rpx; background: #fff9f2;
}
.map-page.orders { --accent: #b84e1d; --soft: #fff0e5; }
.map-page button {
  width: auto; min-width: 0; margin: 0; padding: 0; line-height: 1.4;
  border: 0; border-radius: 0; font-size: 26rpx; letter-spacing: 0;
  white-space: nowrap; box-shadow: none; box-sizing: border-box;
}
.map-page button::after { border: 0; }
.map-page button[disabled] { opacity: .5; }
.map-page button:active { transform: scale(.98); }
.topbar { padding: 20rpx 28rpx 8rpx; flex-shrink: 0; background: #fff9f2; z-index: 3; }
.headline { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-bottom: 16rpx; }
.headline-copy { flex: 1; min-width: 0; }
.eyebrow { display: block; font-size: 17rpx; letter-spacing: 0; color: #74665b; white-space: nowrap; }
.title { font-weight: 800; font-size: 34rpx; margin-top: 8rpx; letter-spacing: 0; white-space: nowrap; }
.map-page .text-btn { background: transparent; color: var(--accent); min-height: 72rpx; display: flex; align-items: center; justify-content: center; padding: 0 12rpx; flex-shrink: 0; }
.map-page .list-button { min-width: 94rpx; border: 1rpx solid #e5ddd4; border-radius: 18rpx; background: #fff; }
.city-row { display: flex; gap: 12rpx; align-items: center; }
.city-input { display: flex; gap: 10rpx; align-items: center; background: #fff; border: 1rpx solid #e5ddd4; border-radius: 18rpx; padding: 0 18rpx; flex: 1; min-width: 0; height: 78rpx; }
.city-input input { flex: 1; width: 0; min-width: 0; min-height: 0; height: 100%; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; font-size: 26rpx; color: var(--ink); }
.city-input .remix-icon { color: var(--accent); flex-shrink: 0; }
.map-page .search-button { flex: 0 0 112rpx; background: var(--accent); color: #fff; border-radius: 18rpx; min-height: 78rpx; display: flex; align-items: center; justify-content: center; }
.filters { width: 100%; margin-top: 14rpx; white-space: nowrap; }
.filter-track { display: inline-flex; min-width: 100%; align-items: center; padding-bottom: 8rpx; white-space: nowrap; }
.filter-track picker { display: inline-block; flex-shrink: 0; }
.chip { display: inline-flex; align-items: center; justify-content: center; border-radius: 30rpx; border: 1rpx solid #e5ddd4; background: #fff; padding: 12rpx 20rpx; margin-right: 10rpx; min-height: 60rpx; color: #74665b; font-size: 23rpx; flex-shrink: 0; white-space: nowrap; }
.chip.chosen { background: var(--soft); border-color: var(--accent); color: var(--accent); font-weight: 600; }
.quiet-note { display: inline-block; font-size: 22rpx; color: #74665b; padding-right: 20rpx; flex-shrink: 0; white-space: nowrap; }
.map-area { position: relative; flex: 1; min-height: 0; overflow: hidden; background: #e9ece5; }
.native-map { width: 100%; height: 100%; }
.map-status { position: absolute; top: 16rpx; left: 20rpx; right: 20rpx; z-index: 6; pointer-events: none; }
.map-summary { width: 100%; background: #fff; border: 1rpx solid #e5ddd4; border-radius: 18rpx; padding: 16rpx 18rpx; display: flex; gap: 10rpx; align-items: center; font-size: 23rpx; }
.summary-dot { width: 12rpx; height: 12rpx; border-radius: 100%; background: var(--accent); flex-shrink: 0; }
.summary-count { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.timestamp { color: #74665b; flex-shrink: 0; font-size: 19rpx; white-space: nowrap; }
.map-page .area-search { margin: 12rpx auto 0; background: var(--accent); color: #fff; border-radius: 36rpx; min-height: 72rpx; padding: 14rpx 26rpx; font-size: 24rpx; pointer-events: auto; }
.error-banner { width: 100%; margin-top: 12rpx; background: #fff4ed; border: 1rpx solid #e9cfbe; border-radius: 18rpx; padding: 8rpx 16rpx; display: flex; align-items: center; gap: 10rpx; font-size: 24rpx; pointer-events: auto; }
.error-banner text { flex: 1; min-width: 0; max-height: 126rpx; overflow-y: auto; overflow-wrap: break-word; word-break: break-all; line-height: 1.5; }
.error-banner .text-btn { min-height: 64rpx; }
.map-tools { position: absolute; right: 20rpx; bottom: 300rpx; display: flex; flex-direction: column; gap: 14rpx; transition: bottom .22s ease; z-index: 2; }
.map-tools.raised { bottom: calc(58% + 18rpx); flex-direction: row; }
.map-tools.expanded-tools { display: none; }
.map-page .map-tools button { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; background: #fff; color: var(--accent); font-size: 34rpx; border-radius: 22rpx; box-shadow: 0 6rpx 20rpx rgba(45,33,26,.08); }
.zoom-tools { border-radius: 22rpx; overflow: hidden; background: #fff; }
.map-page .zoom-tools button { border-radius: 0; box-shadow: none; }
.zoom-tools button + button { border-top: 1rpx solid #eee; }
.map-tools.raised .zoom-tools { display: none; }
.bottom-hint { position: absolute; bottom: calc(20rpx + env(safe-area-inset-bottom)); left: 20rpx; right: 20rpx; border-radius: 26rpx; background: #fff; padding: 22rpx; box-shadow: 0 10rpx 40rpx rgba(45,33,26,.08); animation: fade-in .2s ease; }
.hint-title { font-size: 27rpx; font-weight: 700; margin-bottom: 8rpx; line-height: 1.45; }
.muted { color: #74665b; font-size: 23rpx; line-height: 1.65; overflow-wrap: break-word; word-break: break-all; }
.hint-footer { display: flex; flex-wrap: wrap; gap: 10rpx 16rpx; justify-content: space-between; font-size: 21rpx; color: var(--accent); margin-top: 16rpx; }
.hint-footer text { white-space: nowrap; }
.unmatched { font-size: 23rpx; color: var(--accent); margin-top: 10rpx; line-height: 1.5; }
.sheet { position: absolute; left: 0; right: 0; bottom: 0; height: 58%; max-height: 100%; background: #fff9f2; border-radius: 34rpx 34rpx 0 0; display: flex; flex-direction: column; z-index: 5; padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; box-shadow: 0 -10rpx 35rpx rgba(45,33,26,.08); transition: height .22s cubic-bezier(.2,.8,.2,1), transform .22s cubic-bezier(.2,.8,.2,1); }
.sheet-expanded { height: 100%; border-radius: 0; z-index: 7; }
.sheet-enter { animation: sheet-in .26s cubic-bezier(.2,.8,.2,1); }
.sheet.dragging { transition: none; }
.sheet-handle { padding: 0 24rpx 4rpx; flex-shrink: 0; }
.drag-grip { height: 36rpx; display: flex; align-items: center; justify-content: center; }
.handle-line { height: 7rpx; width: 66rpx; background: #d6cdc4; border-radius: 10rpx; }
.sheet-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.sheet-heading { flex: 1; min-width: 0; }
.sheet-title { font-size: 31rpx; font-weight: 800; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sheet-sub { font-size: 22rpx; color: var(--accent); margin-top: 6rpx; line-height: 1.5; }
.sheet-controls { display: flex; align-items: center; flex-shrink: 0; gap: 8rpx; }
.sheet-controls .text-btn { min-height: 64rpx; padding: 0 8rpx; font-size: 24rpx; }
.map-page .close-btn { width: 64rpx; height: 64rpx; background: #f0eae2; border-radius: 50%; color: #74665b; font-size: 34rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.privacy-line { padding: 8rpx 24rpx 12rpx; color: #74665b; font-size: 20rpx; line-height: 1.5; flex-shrink: 0; }
.sheet-notice { width: auto; margin: 0 20rpx 12rpx; flex-shrink: 0; }
.map-page .updates-button { margin: 0 20rpx 12rpx; padding: 14rpx 20rpx; background: var(--soft); color: var(--accent); border-radius: 16rpx; font-size: 23rpx; flex-shrink: 0; }
.cards-scroll { flex: 1; min-height: 0; height: 0; }
.cards { padding: 0 20rpx 24rpx; }
.task-card { padding: 24rpx; background: #fff; border-radius: 24rpx; border: 1rpx solid #e8dfd4; margin-bottom: 16rpx; }
.card-enter { animation: card-in .22s ease both; }
.card-top { display: flex; min-width: 0; }
.card-heading { display: flex; gap: 14rpx; flex: 1; min-width: 0; align-items: flex-start; }
.card-heading-copy { flex: 1; min-width: 0; }
.service-mark { color: var(--accent); background: var(--soft); width: 68rpx; height: 68rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; font-size: 32rpx; flex-shrink: 0; }
.card-title { font-size: 28rpx; font-weight: 700; line-height: 1.5; word-break: break-all; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.earnings { display: flex; justify-content: space-between; align-items: baseline; gap: 12rpx; margin-top: 18rpx; padding-top: 16rpx; border-top: 1rpx solid #efe7df; }
.earnings-label { font-size: 22rpx; color: #74665b; white-space: nowrap; flex-shrink: 0; }
.earnings-value { min-width: 0; font-size: 34rpx; font-weight: 800; color: var(--accent); white-space: nowrap; }
.urgent-tag { display: inline-block; background: #fff0e5; color: #a53d20; padding: 4rpx 10rpx; border-radius: 8rpx; font-size: 20rpx; margin-top: 6rpx; white-space: nowrap; }
.time-line { margin-top: 18rpx; font-weight: 600; font-size: 25rpx; line-height: 1.5; overflow-wrap: break-word; }
.pet-summary { font-size: 24rpx; color: #74665b; margin-top: 8rpx; line-height: 1.55; word-break: break-all; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.tags:empty { display: none; }
.soft-tag { background: var(--soft); color: var(--accent); font-size: 20rpx; padding: 5rpx 10rpx; border-radius: 8rpx; white-space: nowrap; }
.bundle-ribbon { background: #fff0e5; color: #a04418; font-size: 22rpx; margin: -24rpx -24rpx 20rpx; padding: 14rpx 20rpx; border-radius: 24rpx 24rpx 0 0; line-height: 1.5; }
.card-actions { display: flex; gap: 12rpx; margin-top: 20rpx; flex-shrink: 0; }
.map-page .primary, .map-page .secondary { width: auto; min-width: 0; min-height: 80rpx; border-radius: 18rpx; margin: 0; padding: 14rpx 12rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; font-weight: 600; font-size: 25rpx; box-shadow: none; white-space: nowrap; }
.map-page .primary { background: var(--accent); color: #fff; flex: 1; }
.map-page .secondary { background: #f1ede7; color: #62594f; flex: 1; }
.person { display: flex; gap: 16rpx; align-items: center; flex: 1; min-width: 0; }
.avatar { width: 88rpx; height: 88rpx; border-radius: 24rpx; flex-shrink: 0; }
.avatar-placeholder { background: var(--soft); display: flex; align-items: center; justify-content: center; font-size: 36rpx; color: var(--accent); }
.person-copy { flex: 1; min-width: 0; }
.person-name { font-size: 29rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.person-level { color: var(--accent); font-size: 22rpx; margin: 5rpx 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rating { font-size: 22rpx; color: #74665b; line-height: 1.5; }
.intro { font-size: 25rpx; line-height: 1.6; margin: 16rpx 0 8rpx; word-break: break-all; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.status-line { font-size: 22rpx; color: var(--accent); margin-top: 12rpx; line-height: 1.5; }
.status-line.paused { color: #74665b; }
.panel-empty, .panel-error { padding: 28rpx 12rpx; text-align: center; word-break: break-all; }
.empty-title { font-size: 28rpx; font-weight: 700; margin-bottom: 10rpx; }
.list-end { font-size: 21rpx; color: #74665b; text-align: center; padding: 10rpx 0 22rpx; }
.map-page .load-more { color: var(--accent); background: #fff; min-height: 80rpx; border-radius: 18rpx; padding: 18rpx; }
.skeleton-card { border-radius: 24rpx; background: #fff; padding: 24rpx; margin-bottom: 16rpx; }
.skeleton-line { height: 24rpx; width: 60%; background: #eee9e1; border-radius: 8rpx; margin-bottom: 18rpx; animation: loading 1.4s ease-in-out infinite; }
.skeleton-line.long { height: 32rpx; width: 85%; }
.skeleton-line.short { width: 35%; }
.map-unavailable { position: absolute; top: 110rpx; left: 24rpx; right: 24rpx; bottom: 260rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 18rpx; text-align: center; }
.fallback-actions { display: flex; width: 100%; max-width: 600rpx; gap: 12rpx; }
.success-toast { position: absolute; bottom: calc(20rpx + env(safe-area-inset-bottom)); left: 24rpx; right: 24rpx; padding: 20rpx; background: #176b5b; color: #fff; border-radius: 18rpx; z-index: 9; font-size: 24rpx; text-align: center; line-height: 1.5; animation: fade-in .18s ease; }
.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(45,33,26,.4); display: flex; align-items: center; justify-content: center; padding: 24rpx; z-index: 30; box-sizing: border-box; }
.risk-dialog { width: 100%; max-height: 88%; background: #fff9f2; border-radius: 28rpx; padding: 24rpx; box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden; }
.dialog-title { font-size: 32rpx; font-weight: 800; line-height: 1.4; flex-shrink: 0; word-break: break-all; }
.risk-scroll { flex: 1 1 auto; min-height: 0; height: 50vh; margin-top: 16rpx; }
.risk-item { padding: 16rpx 0; border-bottom: 1rpx solid #e5ddd4; font-size: 25rpx; line-height: 1.6; word-break: break-all; }
.risk-title { font-size: 27rpx; font-weight: 700; line-height: 1.5; margin-bottom: 6rpx; }
.risk-agree { display: flex; align-items: flex-start; gap: 10rpx; padding: 22rpx 0; color: var(--accent); font-size: 25rpx; line-height: 1.6; }
.agree-mark { flex-shrink: 0; }
.cluster-choice { display: flex; align-items: center; gap: 16rpx; }
.cluster-name { flex: 1; min-width: 0; }
.cluster-count { flex-shrink: 0; white-space: nowrap; color: var(--accent); font-size: 23rpx; }
.map-page .dialog-close { width: 100%; margin-top: 20rpx; flex: 0 0 auto; }
/* WXSS rejects universal selectors: explicitly target every animated element. */
.reduced-motion .map-tools, .reduced-motion .sheet { transition: none; }
.reduced-motion .sheet-enter, .reduced-motion .card-enter, .reduced-motion .bottom-hint, .reduced-motion .success-toast, .reduced-motion .skeleton-line { animation: none; }
.reduced-motion button:active { transform: none; }
@media (max-height: 620px) {
  .topbar { padding-top: 12rpx; }
  .headline { margin-bottom: 10rpx; }
  .bottom-hint { padding: 16rpx 20rpx; }
  .hint-footer { margin-top: 10rpx; }
  .has-sheet .map-tools { display: none; }
  .has-sheet .map-summary { display: none; }
  .sheet { height: 64%; }
  .sheet-expanded { height: 100%; }
  .sheet-handle { padding-bottom: 0; }
  .privacy-line { padding-top: 4rpx; padding-bottom: 8rpx; font-size: 19rpx; }
}
@keyframes sheet-in { from { transform: translateY(60rpx); opacity: .25; } to { transform: translateY(0); opacity: 1; } }
@keyframes card-in { from { transform: translateY(16rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes loading { 50% { opacity: .45; } }

.map-page .reference-picker { width: 100%; display: flex; align-items: center; gap: 10rpx; margin-top: 10rpx; padding: 10rpx 4rpx; min-height: 62rpx; background: transparent; color: #74665b; font-size: 23rpx; text-align: left; }
.reference-name { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.reference-action { flex-shrink: 0; color: var(--accent); white-space: nowrap; }
