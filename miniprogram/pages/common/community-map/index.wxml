<view class="map-page {{mode}} {{reducedMotion ? 'reduced-motion' : ''}} {{selected ? 'has-sheet' : ''}} {{expanded ? 'is-expanded' : ''}}">
  <view class="topbar">
    <view class="headline"><view class="headline-copy"><text class="eyebrow">DOVELIN · NEIGHBOURHOOD</text><view class="title">{{mode === 'orders' ? '小区里，发现好任务' : '身边的安心宠托师'}}</view></view><button class="text-btn list-button" bindtap="listView">列表 ↗</button></view>
    <view class="city-row"><view class="city-input"><text class="remix-icon ri-map-pin-line"></text><input placeholder="输入城市，如深圳市" value="{{city}}" bindinput="inputCity" bindconfirm="confirmCity" confirm-type="search" maxlength="40" /></view><button class="search-button" bindtap="confirmCity" disabled="{{checkingIdentity || !!submitting || !!confirmingOrderId}}" loading="{{loading}}">查看</button></view>
    <button class="reference-picker" bindtap="chooseReference" loading="{{choosingReference}}" disabled="{{checkingIdentity || !!submitting || !!confirmingOrderId || choosingReference}}"><text class="remix-icon ri-map-pin-2-line"></text><text class="reference-name">{{referenceName}}</text><text class="reference-action">更换位置 ›</text></button>
    <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-track" wx:if="{{mode === 'orders'}}">
        <view class="chip {{orderKind === 'all' ? 'chosen' : ''}}" data-kind="all" bindtap="changeKind">全部任务</view><view class="chip {{orderKind === 'normal' ? 'chosen' : ''}}" data-kind="normal" bindtap="changeKind">普通</view><view class="chip {{orderKind === 'urgent' ? 'chosen' : ''}}" data-kind="urgent" bindtap="changeKind">加急</view>
        <picker mode="date" value="{{filterDate}}" bindchange="changeDate"><view class="chip {{filterDate ? 'chosen' : ''}}">{{filterDate || '服务日期'}} ⌄</view></picker><view class="chip" wx:if="{{filterDate}}" bindtap="clearDate">清除日期</view><view class="chip {{inServiceRange ? 'chosen' : ''}}" bindtap="toggleRange">范围内</view><view class="chip {{inServiceTime ? 'chosen' : ''}}" bindtap="toggleTime">可服务时间</view>
      </view>
      <view class="filter-track" wx:else><view class="chip {{onlyDirect ? 'chosen' : ''}}" bindtap="toggleDirect">接受指定预约</view><picker range="{{genderLabels}}" value="{{genderIndex}}" bindchange="changeGender"><view class="chip">{{genderLabels[genderIndex]}} ⌄</view></picker><text class="quiet-note">按服务小区展示</text></view>
    </scroll-view>
  </view>
  <view class="map-area">
    <map wx:if="{{!mapError}}" hidden="{{!!acceptRisk || !!clusterChoices}}" id="communityMap" class="native-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{markers}}" bindmarkertap="markerTap" bindcallouttap="markerTap" bindregionchange="regionChanged" binderror="mapFailed" enable-rotate="{{false}}" enable-zoom="{{true}}" min-scale="5" max-scale="19" show-location="{{true}}" show-compass />
    <view class="map-unavailable" wx:if="{{mapError}}"><view class="empty-title">地图暂不可用</view><view class="muted">你仍可以在列表中选择订单和宠托师</view><view class="fallback-actions"><button class="secondary" bindtap="retryMap">重新加载地图</button><button class="primary" bindtap="listView">查看列表</button></view></view>
    <view class="map-status">
      <view class="map-summary"><view class="summary-dot"></view><text class="summary-count">{{communityCount}} 个小区 · {{visibleCount}} {{mode === 'orders' ? '个待接任务' : '位宠托师'}}</text><text class="timestamp" wx:if="{{updatedText}}">{{updatedText}} 更新</text></view>
      <view class="error-banner" wx:if="{{confirmingOrderId && !selected}}"><text>接单结果待确认，请勿重复提交</text><button class="text-btn" bindtap="confirmGrabResult" loading="{{!!submitting}}">确认结果</button></view>
      <view class="error-banner" wx:elif="{{error}}"><text>{{error}}</text><button class="text-btn" bindtap="retry">重试</button></view>
      <button class="area-search" wx:elif="{{dirty && !loading && !mapError}}" bindtap="refresh">↻ 搜索这片区域</button>
    </view>
    <view class="map-tools {{selected ? 'raised' : ''}} {{expanded ? 'expanded-tools' : ''}}" wx:if="{{!mapError}}"><button wx:if="{{hasReference}}" bindtap="returnToReference" aria-label="回到参考位置"><text class="remix-icon ri-map-pin-line"></text></button><button bindtap="locate" loading="{{locating}}" disabled="{{locating}}" aria-label="定位到我"><text wx:if="{{!locating}}" class="remix-icon ri-focus-3-line"></text></button><view class="zoom-tools"><button data-step="1" bindtap="zoom" disabled="{{zoomScale >= 19}}" aria-label="放大">＋</button><button data-step="-1" bindtap="zoom" disabled="{{zoomScale <= 5}}" aria-label="缩小">－</button></view></view>
    <view class="bottom-hint" wx:if="{{!selected}}"><view class="hint-title">{{loading ? '正在寻找附近的小区…' : '点击小区，' + (mode === 'orders' ? '展开待接任务' : '选择心仪的宠托师')}}</view><view class="muted">{{mode === 'orders' ? '按小区聚合 · 拼单整团接单' : '仅展示服务小区，不代表实时位置'}}</view><view class="unmatched" wx:if="{{unmatchedCount}}" bindtap="listView">另有 {{unmatchedCount}} 个任务暂未匹配小区，去列表查看 ›</view><view class="hint-footer"><text bindtap="listView">更多{{mode === 'orders' ? '任务' : '宠托师'}}到列表查看 ›</text><text bindtap="toggleMotion">{{reducedMotion ? '动态效果已减少' : '减少动态效果'}}</text></view></view>
    <view style="transform: translateY({{sheetOffset}}px);" class="sheet {{dragging ? 'dragging' : ''}} {{expanded ? 'sheet-expanded' : ''}} {{entering ? 'sheet-enter' : ''}}" wx:if="{{selected}}">
      <view class="sheet-handle"><view class="drag-grip" bindtouchstart="dragStart" catchtouchmove="dragMove" bindtouchend="dragEnd" bindtouchcancel="dragCancel" aria-label="拖动展开或收起"><view class="handle-line"></view></view><view class="sheet-head"><view class="sheet-heading"><view class="sheet-title">{{selected.name}}</view><view class="sheet-sub">{{total}} {{mode === 'orders' ? '个待接任务' : '位宠托师'}}<text wx:if="{{selected.urgentCount}}"> · {{selected.urgentCount}} 项含加急</text></view></view><view class="sheet-controls"><button class="text-btn" bindtap="toggleExpanded" disabled="{{!!submitting || !!confirmingOrderId}}">{{expanded ? '收起' : '展开'}}</button><button class="close-btn" bindtap="closePanel" aria-label="关闭" disabled="{{!!submitting || !!confirmingOrderId}}">×</button></view></view></view>
      <view class="privacy-line">{{mode === 'orders' ? '位置为小区公共参考点 · 接单需验证实时位置' : '常驻服务小区 · 可约情况需选择地址和时间后确认'}}</view>
      <view class="error-banner sheet-notice" wx:if="{{confirmingOrderId}}"><text>接单结果待确认，请勿重复提交</text><button class="text-btn" bindtap="confirmGrabResult" loading="{{!!submitting}}">确认结果</button></view>
      <button class="updates-button" wx:if="{{pendingUpdates}}" bindtap="retryPanel" disabled="{{panelRefreshing || !!submitting || !!confirmingOrderId || checkingIdentity}}">有新内容，点击更新</button>
      <scroll-view class="cards-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-top="{{cardsScrollTop}}" bindscroll="cardsScrolled" bindscrolltolower="more" bindtouchstart="cardTouchStart" bindtouchend="cardTouchEnd" bindtouchcancel="cardTouchEnd">
        <view class="cards">
          <view class="skeleton-card" wx:if="{{panelLoading && !cards.length}}" wx:for="{{[1,2,3]}}" wx:key="*this"><view class="skeleton-line long"></view><view class="skeleton-line"></view><view class="skeleton-line short"></view></view>
          <view class="task-card {{entering && index < 3 ? 'card-enter' : ''}}" wx:for="{{cards}}" wx:key="_id" style="animation-delay: {{index < 3 ? index * 30 : 0}}ms;">
            <block wx:if="{{mode === 'orders'}}">
              <view class="bundle-ribbon" wx:if="{{item.isGroupBuyBundle}}">同小区拼单 · {{item.householdCount}} 户 · 接整团</view>
              <view class="card-top"><view class="card-heading"><view class="service-mark"><text class="remix-icon ri-home-heart-line"></text></view><view class="card-heading-copy"><view class="card-title">{{item.serviceSummary || '上门宠物照护'}}</view><text class="urgent-tag" wx:if="{{item.isUrgent}}">加急任务</text></view></view></view>
              <view class="time-line">{{item.startTime}}</view><view class="muted">{{item.sessionCount}} 次服务 · 单次 {{item.durationMinutes}} 分钟</view><view class="pet-summary">{{item.petSummary}}</view>
              <view class="tags"><text class="soft-tag" wx:if="{{!item.inRange}}">需确认当前位置范围</text><text class="soft-tag" wx:if="{{!item.inTime}}">需确认履约时间</text></view>
              <view class="earnings"><text class="earnings-label">预计{{item.isGroupBuyBundle ? '整团' : '整单'}}收益</text><text class="earnings-value">{{item.staffEarningText}}</text></view>
            </block>
            <block wx:else>
              <view class="card-top"><view class="person"><image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" /><view wx:else class="avatar avatar-placeholder"><text class="remix-icon ri-user-heart-line"></text></view><view class="person-copy"><view class="person-name">{{item.displayName}}</view><view class="person-level">{{item.staffLevelText}}</view><view class="rating">{{item.reviewCount ? item.ratingAverage + ' 分 · ' + item.reviewCount + ' 条评价' : '新加入 · 暂无评价'}}</view></view></view></view>
              <view class="intro" wx:if="{{item.profileIntro}}">{{item.profileIntro}}</view><view class="muted">{{item.vaccineServicePolicyText}}</view><view class="status-line {{item.canDirectBook ? '' : 'paused'}}">{{item.canDirectBook ? '接受指定预约 · 地址与档期待确认' : '暂不接受指定预约'}}</view>
            </block>
            <view class="card-actions"><button class="secondary" data-id="{{item._id}}" bindtap="detail" disabled="{{!!submitting || !!confirmingOrderId || checkingIdentity}}">{{mode === 'orders' ? '订单详情' : '查看资料'}}</button><button wx:if="{{mode === 'orders'}}" class="primary" data-id="{{item._id}}" bindtap="grab" disabled="{{!!submitting || !!confirmingOrderId || checkingIdentity || panelLoading || panelRefreshing}}" loading="{{submitting === item._id}}">{{submitting === item._id ? '确认中' : (item.isGroupBuyBundle ? '接整团' : '立即抢单')}}</button><button wx:else class="primary" data-id="{{item._id}}" bindtap="book" disabled="{{!item.canDirectBook || !!submitting || checkingIdentity || panelLoading || panelRefreshing}}" loading="{{submitting === item._id}}">{{item.canDirectBook ? '指定预约' : '暂停预约'}}</button></view>
          </view>
          <view class="panel-empty" wx:if="{{!panelLoading && !cards.length && !panelError && !pendingUpdates}}"><view class="empty-title">当前没有符合条件的{{mode === 'orders' ? '任务' : '宠托师'}}</view><view class="muted">可以调整筛选，或查看其他小区</view></view>
          <view class="panel-error" wx:if="{{panelError}}"><text>{{panelError}}</text><button class="text-btn" bindtap="retryPanel">重试</button></view>
          <button class="load-more" wx:if="{{hasMore && !panelError}}" loading="{{panelLoading}}" disabled="{{panelLoading || panelRefreshing || checkingIdentity || !!submitting || !!confirmingOrderId}}" bindtap="more">查看更多</button><view class="list-end" wx:elif="{{cards.length && !pendingUpdates && !panelError}}">已展示当前筛选结果</view>
        </view>
      </scroll-view>
    </view>
    <view class="success-toast" wx:if="{{successOrderId}}" bindtap="successDetail">✓ 已确认接单成功 · 查看订单 ›</view>
  </view>
  <view class="modal-mask" wx:if="{{acceptRisk}}" catchtouchmove="noop"><view class="risk-dialog"><view class="dialog-title">{{acceptRisk.noticeTitle || '请确认履约要求'}}</view><scroll-view scroll-y class="risk-scroll"><block wx:if="{{riskStep === 1}}"><view class="risk-item" wx:for="{{acceptRisk.warnings}}" wx:key="type"><view class="risk-title">{{item.title}}</view><view class="muted">{{item.detail}}</view></view></block><block wx:else><view class="risk-item" wx:for="{{acceptRisk.noticeItems}}" wx:key="*this">{{index + 1}}. {{item}}</view><view class="risk-agree" bindtap="agreeRisk"><text class="agree-mark">{{riskAgreed ? '☑' : '☐'}}</text><text>我已阅读并确认能够按要求履约</text></view></block></scroll-view><view class="card-actions"><button class="secondary" bindtap="closeRisk" disabled="{{!!submitting}}">暂不接单</button><button class="primary" wx:if="{{riskStep === 1}}" bindtap="nextRisk">继续阅读</button><button class="primary" wx:else bindtap="confirmRisk" loading="{{!!submitting}}" disabled="{{!riskAgreed || !!submitting}}">确认接单</button></view></view></view>
  <view class="modal-mask" wx:if="{{clusterChoices}}" catchtouchmove="noop"><view class="risk-dialog"><view class="dialog-title">选择小区</view><scroll-view scroll-y class="risk-scroll"><view class="risk-item cluster-choice" wx:for="{{clusterChoices}}" wx:key="_id" data-id="{{item._id}}" bindtap="chooseClusterMember"><text class="cluster-name">{{item.name}}</text><text class="cluster-count">{{item.count}} {{mode === 'orders' ? '单' : '位'}}</text></view></scroll-view><button class="secondary dialog-close" bindtap="closeCluster">关闭</button></view></view>
</view>
