/* 页面样式使用 miniprogram/app.wxss 全局设计系统 */

.action-card {
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.action-create-btn {
  width: auto !important;
  min-height: 64rpx !important;
  height: 64rpx !important;
  padding: 0 32rpx !important;
  margin: 0 !important;
  font-size: 26rpx !important;
  font-weight: 700 !important;
  border-radius: 999rpx !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  flex-shrink: 0 !important;
}

.activity-card {
  margin-bottom: 24rpx;
  padding: 28rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(45, 33, 26, 0.04);
}

.activity-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.activity-title-wrap {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  flex: 1;
}

.activity-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #2d211a;
  line-height: 1.4;
}

.status-badge {
  white-space: nowrap !important;
  flex-shrink: 0 !important;
  font-size: 22rpx !important;
  min-height: 40rpx !important;
  height: 40rpx !important;
  padding: 0 16rpx !important;
  line-height: 40rpx !important;
  color: #ffffff !important;
  border-radius: 999rpx !important;
}

.badge-running {
  background: #059669 !important;
}

.badge-closed {
  background: #9ca3af !important;
}

.activity-desc {
  font-size: 25rpx;
  color: #7b6d65;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.prize-tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 12rpx 0;
}

.prize-tag-empty {
  font-size: 24rpx;
  color: #a89e98;
  margin: 8rpx 0;
}

.activity-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f6f2ee;
}

.opt-btn {
  width: auto !important;
  min-height: 56rpx !important;
  height: 56rpx !important;
  padding: 0 26rpx !important;
  margin: 0 !important;
  font-size: 24rpx !important;
  font-weight: 700 !important;
  border-radius: 999rpx !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  color: var(--theme-primary, #e05c8b) !important;
  border: 2rpx solid var(--theme-border, #fbcfe8) !important;
  background: #ffffff !important;
  flex-shrink: 0 !important;
}

.opt-danger {
  color: #ef4444 !important;
  border-color: rgba(239, 68, 68, 0.35) !important;
}

.compact-btn {
  width: auto !important;
  min-height: 52rpx !important;
  height: 52rpx !important;
  padding: 0 22rpx !important;
  margin: 0 !important;
  font-size: 23rpx !important;
  font-weight: 700 !important;
  border-radius: 999rpx !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  flex-shrink: 0 !important;
}

.danger-btn {
  color: #ef4444 !important;
  border-color: rgba(239, 68, 68, 0.35) !important;
}

.prize-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.pill-type {
  font-weight: 700;
  font-size: 20rpx;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
}

.pill-name {
  font-weight: 600;
}

.pill-prob {
  opacity: 0.85;
}

.pill-points {
  background: #fef3c7;
  color: #92400e;
}
.pill-points .pill-type {
  background: #fde68a;
}

.pill-coupon {
  background: #fce7f3;
  color: #9d174d;
}
.pill-coupon .pill-type {
  background: #fbcfe8;
}

.pill-title {
  background: #ede9fe;
  color: #6d28d9;
}
.pill-title .pill-type {
  background: #ddd6fe;
}

.pill-text {
  background: #f3f4f6;
  color: #4b5563;
}
.pill-text .pill-type {
  background: #e5e7eb;
}

/* Modal 弹窗体系 */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  background: rgba(30, 20, 15, 0.48);
  backdrop-filter: blur(4rpx);
}

.modal-card {
  width: 100%;
  height: 86vh;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  padding: 32rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.modal-head {
  flex-shrink: 0;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #2d211a;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #9ca3af;
  border-radius: 50%;
  background: #f3f4f6;
}

.modal-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  overflow-y: auto;
  box-sizing: border-box;
  padding-right: 4rpx;
}

.modal-scroll-spacer {
  height: 90rpx;
  width: 100%;
}

.modal-footer {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f3f4f6;
  margin-top: 10rpx;
  background: #ffffff;
}

.modal-footer-btn {
  width: auto !important;
  min-height: 76rpx !important;
  height: 76rpx !important;
  margin: 0 !important;
  font-size: 28rpx !important;
  font-weight: 700 !important;
  border-radius: 999rpx !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
}

.field-title {
  font-size: 28rpx;
  font-weight: 850;
  color: #2d211a;
  margin-bottom: 12rpx;
}

.prob-summary {
  font-size: 24rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.prob-valid {
  background: #d1fae5;
  color: #065f46;
}

.prob-invalid {
  background: #fee2e2;
  color: #991b1b;
}

.prize-item-card {
  padding: 18rpx 20rpx;
  background: #fafaf9;
  border: 1rpx solid #f0eeec;
  border-radius: 18rpx;
  margin-bottom: 12rpx;
}

.empty-prize-tip {
  padding: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  background: #fbf7f4;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.add-prize-box {
  padding: 22rpx 20rpx;
  background: #fffbfa;
  border: 2rpx dashed #fed7aa;
  border-radius: 20rpx;
  margin-top: 16rpx;
}

.action-add-prize-btn {
  width: 100% !important;
  min-height: 72rpx !important;
  height: 72rpx !important;
  margin: 16rpx 0 0 !important;
  font-size: 26rpx !important;
  font-weight: 700 !important;
  border-radius: 999rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  border: 2rpx solid #e05c8b !important;
  color: #e05c8b !important;
  background: #ffffff !important;
}

/* 萌宠祝福金句库样式 */
.blessing-picker-card {
  padding: 18rpx 20rpx;
  background: #fff8eb;
  border: 1rpx solid #fed7aa;
  border-radius: 20rpx;
  margin-bottom: 14rpx;
}

.random-dice-btn {
  font-size: 23rpx;
  font-weight: 700;
  color: #ea580c;
  background: #ffedd5;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  box-shadow: 0 4rpx 10rpx rgba(234, 88, 12, 0.1);
}

.random-dice-btn:active {
  background: #fed7aa;
}

.blessing-field {
  background: #ffffff !important;
  border: 1rpx solid #fdba74 !important;
  color: #c2410c !important;
  font-weight: 600 !important;
  font-size: 25rpx !important;
  display: flex !important;
  align-items: center !important;
}

.quick-chips-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.quick-chip {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #fcd34d;
  color: #b45309;
  font-size: 22rpx;
  font-weight: 600;
}

.quick-chip:active {
  background: #fef3c7;
}

.blessing-textarea {
  width: 100%;
  min-height: 110rpx;
  padding: 16rpx 20rpx;
  background: #fbfaf8;
  border: 1rpx solid #eae7e3;
  border-radius: 16rpx;
  font-size: 25rpx;
  color: #2d211a;
  box-sizing: border-box;
  line-height: 1.5;
}

