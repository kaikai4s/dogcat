<view class="{{themeClass}} {{fontClass}} page">
  <view class="dashboard-header">
    <view class="badge">管理端</view>
    <view class="title">抽奖活动管理</view>
    <view class="tip">配置抽奖活动与多样化奖品池（支持未中奖文案、积分自动到账、优惠券自动发券），每个奖品可自由配置中奖概率与库存。</view>
  </view>

  <view class="action-card card">
    <view class="between" style="align-items:center;">
      <view>
        <view class="strong" style="font-size:30rpx;color:#2d211a;">抽奖活动列表</view>
        <view class="muted" style="font-size:24rpx;margin-top:4rpx;">共 {{activities.length}} 个活动</view>
      </view>
      <button class="primary action-create-btn" bindtap="openCreateModal">+ 新建抽奖活动</button>
    </view>
  </view>

  <view class="card activity-card" wx:for="{{activities}}" wx:key="_id">
    <!-- 卡片头部：标题与状态 -->
    <view class="activity-head">
      <view class="activity-title-wrap">
        <view class="activity-title">{{item.name}}</view>
        <view class="badge status-badge {{item.enabled ? 'badge-running' : 'badge-closed'}}">
          {{item.enabled ? '进行中' : '已关闭'}}
        </view>
      </view>
    </view>

    <!-- 卡片说明 -->
    <view class="activity-desc" wx:if="{{item.description}}">{{item.description}}</view>

    <!-- 奖品池标签 -->
    <view class="prize-tag-list" wx:if="{{item.prizes && item.prizes.length}}">
      <view class="prize-pill {{p.type === 'points' ? 'pill-points' : (p.type === 'coupon' ? 'pill-coupon' : (p.type === 'pet_title' ? 'pill-title' : 'pill-text'))}}" wx:for="{{item.prizes}}" wx:for-item="p" wx:key="index">
        <text class="pill-type">{{p.type === 'points' ? '积分' : (p.type === 'coupon' ? '卡券' : (p.type === 'pet_title' ? '头衔' : '文案'))}}</text>
        <text class="pill-name">{{p.name}}</text>
        <text class="pill-prob">{{p.probability}}%</text>
      </view>
    </view>
    <view class="prize-tag-empty" wx:else>暂无奖品配置</view>

    <!-- 底部操作按钮栏：水平右对齐 -->
    <view class="activity-footer">
      <button class="ghost opt-btn" data-index="{{index}}" bindtap="toggle">{{item.enabled ? '关闭活动' : '开启活动'}}</button>
      <button class="ghost opt-btn" data-index="{{index}}" bindtap="openEditModal">编辑</button>
      <button class="ghost opt-btn opt-danger" data-index="{{index}}" bindtap="deleteActivity">删除</button>
    </view>
  </view>

  <view class="empty" wx:if="{{!activities.length}}">
    <view style="font-size:32rpx;margin-bottom:12rpx;">暂无抽奖活动</view>
    <view class="muted">点击上方“+ 新建抽奖活动”创建第一个抽奖活动吧</view>
  </view>

  <!-- 新建/编辑抽奖活动 Modal 弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" catchtouchmove="noop">
    <view class="modal-card">
      <view class="between modal-head">
        <view class="modal-title">{{modalTitle}}</view>
        <view class="modal-close" bindtap="closeModal">✕</view>
      </view>

      <scroll-view scroll-y class="modal-scroll">
        <view class="form-section">
          <view class="field-title">活动基础信息</view>
          <input placeholder="活动名称，如：新人宠粉大转盘" value="{{form.name}}" data-field="name" bindinput="input" />
          <input placeholder="活动说明，如：每日可参与一次，赢大额券与积分" value="{{form.description}}" data-field="description" bindinput="input" />
          <view class="between switch-row" style="margin-top:10rpx;">
            <view>
              <view class="strong">立即启用活动</view>
              <view class="muted" style="font-size:22rpx;">开启后客户将可在福利中心参与抽奖</view>
            </view>
            <switch checked="{{form.enabled}}" bindchange="toggleFormEnabled" />
          </view>
        </view>

        <!-- 奖品列表展示与概率统计 -->
        <view class="form-section" style="margin-top: 24rpx;">
          <view class="between" style="align-items:center; margin-bottom: 12rpx;">
            <view class="field-title" style="margin-bottom:0;">奖品池配置（已添加 {{form.prizes.length}} 项）</view>
            <view class="prob-summary {{totalProbability === 100 ? 'prob-valid' : 'prob-invalid'}}">
              概率合计：{{totalProbability}}% {{totalProbability === 100 ? '✔' : '(需等于100%)'}}
            </view>
          </view>

          <view class="prize-item-card" wx:for="{{form.prizes}}" wx:key="index">
            <view class="between" style="align-items:center;">
              <view style="flex:1;">
                <view style="display:flex; align-items:center; gap:10rpx; margin-bottom: 6rpx;">
                  <view class="badge {{item.type === 'points' ? 'pill-points' : (item.type === 'coupon' ? 'pill-coupon' : (item.type === 'pet_title' ? 'pill-title' : 'pill-text'))}}">
                    {{item.type === 'points' ? '积分奖励' : (item.type === 'coupon' ? '优惠券' : (item.type === 'pet_title' ? '宠物头衔' : '未中奖文案'))}}
                  </view>
                  <view class="strong">{{item.name}}</view>
                </view>
                <view class="muted" style="font-size:23rpx;">
                  <text wx:if="{{item.type === 'points'}}">赠送 {{item.points}} 积分 · </text>
                  <text wx:elif="{{item.type === 'coupon'}}">关联优惠券 · </text>
                  <text wx:elif="{{item.type === 'pet_title'}}">发放到奖励邮箱 · </text>
                  <text wx:else>显示文案「{{item.text}}」 · </text>
                  <text>中奖概率: {{item.probability}}% · 库存: {{item.stockLeft}} 份</text>
                </view>
              </view>
              <button class="ghost compact-btn danger-btn" data-index="{{index}}" bindtap="removePrize">移除</button>
            </view>
          </view>

          <view class="empty-prize-tip" wx:if="{{!form.prizes.length}}">
            暂未添加奖品，请在下方选择奖品类型并添加
          </view>

          <!-- 添加新奖品子模块 -->
          <view class="add-prize-box">
            <view class="strong" style="font-size:26rpx; margin-bottom: 12rpx;">+ 添加新奖品项</view>
            
            <view class="muted" style="font-size:24rpx; margin-bottom: 8rpx;">选择奖品类型</view>
            <view class="tabs" style="margin-bottom: 16rpx;">
              <button class="tab {{newPrize.type === 'text' ? 'active-tab' : ''}}" data-type="text" bindtap="setPrizeType">文字 (未中奖)</button>
              <button class="tab {{newPrize.type === 'points' ? 'active-tab' : ''}}" data-type="points" bindtap="setPrizeType">积分奖品</button>
              <button class="tab {{newPrize.type === 'coupon' ? 'active-tab' : ''}}" data-type="coupon" bindtap="setPrizeType">优惠券</button>
              <button class="tab {{newPrize.type === 'pet_title' ? 'active-tab' : ''}}" data-type="pet_title" bindtap="setPrizeType">宠物头衔</button>
            </view>

            <!-- 文字类型 (未中奖) -->
            <view wx:if="{{newPrize.type === 'text'}}">
              <view class="blessing-picker-card">
                <view class="between" style="align-items:center; margin-bottom: 12rpx;">
                  <view class="strong" style="font-size: 26rpx; color: #9a3412;">🐾 萌宠趣味金句库（猫咪/狗狗）</view>
                  <view class="random-dice-btn" bindtap="pickRandomBlessing">🎲 随机换一句</view>
                </view>

                <!-- 下拉选择 30 款猫狗品种金句 -->
                <picker range="{{petBlessingList}}" range-key="label" value="{{selectedBlessingIndex}}" bindchange="choosePetBlessing">
                  <view class="field blessing-field">
                    <text style="margin-right:8rpx;">🐾</text>
                    <text>点击挑选猫咪/狗狗品种金句（共30款）</text>
                  </view>
                </picker>

                <!-- 热门萌宠快捷标签 -->
                <view class="quick-chips-row">
                  <view class="quick-chip" wx:for="{{quickBlessingBreeds}}" wx:key="*this" data-breed="{{item}}" bindtap="applyQuickBlessing">
                    {{item}}
                  </view>
                </view>
              </view>

              <view class="muted" style="font-size:24rpx; margin: 10rpx 0 6rpx;">文案内容（抽中后对用户展示）</view>
              <textarea auto-height placeholder="未中奖文案，如：我是大金毛，你抽中了我今天会有滚滚财运哦～" value="{{newPrize.text}}" data-field="text" bindinput="prizeInput" class="blessing-textarea" />

              <view class="muted" style="font-size:24rpx; margin: 10rpx 0 6rpx;">奖品展示名称</view>
              <input placeholder="奖品展示名称，如：金毛送财运 / 谢谢参与" value="{{newPrize.name}}" data-field="name" bindinput="prizeInput" />
              <view class="notice" style="margin: 8rpx 0 14rpx;">抽中文字奖品相当于未中奖，不发放卡券或积分，向用户展示趣味萌宠祝福文案。</view>
            </view>

            <!-- 积分类型 -->
            <view wx:if="{{newPrize.type === 'points'}}">
              <input type="number" placeholder="赠送积分数量，如 20、50、100" value="{{newPrize.points}}" data-field="points" bindinput="prizeInput" />
              <input placeholder="奖品展示名称，如：50 积分" value="{{newPrize.name}}" data-field="name" bindinput="prizeInput" />
              <view class="notice" style="margin: 8rpx 0 14rpx;">抽中的积分将自动即时增加进用户的积分账户，并在积分明细中记录流水。</view>
            </view>

            <!-- 优惠券类型 -->
            <view wx:if="{{newPrize.type === 'coupon'}}">
              <picker range="{{templates}}" range-key="name" value="{{selectedTemplateIndex}}" bindchange="choosePrizeTemplate">
                <view class="field">选择优惠券模板：{{newPrize.couponName || '点击选择优惠券模板'}}</view>
              </picker>
              <input placeholder="奖品展示名称，如：满100减20优惠券" value="{{newPrize.name}}" data-field="name" bindinput="prizeInput" />
              <view class="notice" style="margin: 8rpx 0 14rpx;">抽中后将自动将所选优惠券发放到用户的个人卡券包。</view>
            </view>

            <!-- 宠物头衔类型 -->
            <view wx:if="{{newPrize.type === 'pet_title'}}">
              <picker range="{{petTitles}}" range-key="name" value="{{selectedPetTitleIndex}}" bindchange="choosePrizePetTitle">
                <view class="field">选择宠物头衔：{{newPrize.titleName || '点击选择宠物头衔'}}</view>
              </picker>
              <input placeholder="奖品展示名称，如：宠物头衔：闪耀萌宠" value="{{newPrize.name}}" data-field="name" bindinput="prizeInput" />
              <view class="notice" style="margin: 8rpx 0 14rpx;">抽中后将发送到用户奖励邮箱，用户领取后可给宠物佩戴；重复获得会转为补偿积分。</view>
            </view>

            <view style="display:flex; gap:16rpx; margin-top:8rpx;">
              <view style="flex:1;">
                <input type="number" placeholder="中奖概率（%，如 20）" value="{{newPrize.probability}}" data-field="probability" bindinput="prizeInput" />
              </view>
              <view style="flex:1;">
                <input type="number" placeholder="库存数量（份）" value="{{newPrize.stockLeft}}" data-field="stockLeft" bindinput="prizeInput" />
              </view>
            </view>

            <button class="ghost action-add-prize-btn" bindtap="addPrize">+ 添加此奖品至列表</button>
          </view>
          <!-- 垫底占位，彻底杜绝内容被底部操作栏遮挡 -->
          <view class="modal-scroll-spacer"></view>
        </view>
      </scroll-view>

      <view class="modal-footer">
        <button class="ghost modal-footer-btn" style="flex:1;" bindtap="closeModal">取消</button>
        <button class="primary modal-footer-btn" style="flex:2;" bindtap="save">保存抽奖活动</button>
      </view>
    </view>
  </view>
</view>
