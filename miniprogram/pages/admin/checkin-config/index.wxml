<view class="page">
  <view class="dashboard-header">
    <view class="badge">管理端</view>
    <view class="title">签到奖励配置</view>
    <view class="tip">按月配置每天的签到奖励，可发积分、优惠券或留空。</view>
  </view>

  <view class="card form-card">
    <view class="subtitle">月份配置</view>
    <input placeholder="月份，如 2026-08" value="{{monthKey}}" bindinput="monthInput" />
    <view style="display:flex;gap:16rpx;">
      <button class="ghost" style="flex:1;" bindtap="loadConfig">加载月份</button>
      <button class="primary" style="flex:1;" bindtap="save">保存配置</button>
    </view>
  </view>

  <view class="card day-card" wx:for="{{days}}" wx:key="day">
    <view class="between" style="align-items:flex-start;gap:20rpx;">
      <view>
        <view class="strong">第 {{item.day}} 天</view>
        <view class="muted">{{item.rewardTypeLabel}}</view>
      </view>
      <picker range="{{rewardTypeChoices}}" value="{{item.rewardType === 'points' ? 0 : (item.rewardType === 'coupon' ? 1 : 2)}}" data-index="{{index}}" bindchange="changeRewardType">
        <view class="field picker-field">{{item.rewardTypeLabel}}</view>
      </picker>
    </view>
    <input placeholder="奖励标题" value="{{item.title}}" data-index="{{index}}" data-field="title" bindinput="inputDayField" />
    <input placeholder="奖励说明" value="{{item.desc}}" data-index="{{index}}" data-field="desc" bindinput="inputDayField" />
    <input wx:if="{{item.rewardType === 'points'}}" type="number" placeholder="奖励积分" value="{{item.points}}" data-index="{{index}}" data-field="points" bindinput="inputDayField" />
    <picker wx:if="{{item.rewardType === 'coupon'}}" range="{{templates}}" range-key="name" data-index="{{index}}" bindchange="chooseCoupon">
      <view class="field picker-field">{{item.couponSnapshot ? item.couponSnapshot.name : (item.couponTemplateId || '请选择优惠券')}}</view>
    </picker>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon">⌂</view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/coupons/index" bindtap="go"><view class="nav-icon">券</view><view>优惠券</view></view>
    <view class="nav-item" data-url="/pages/admin/member-levels/index" bindtap="go"><view class="nav-icon">级</view><view>等级</view></view>
    <view class="nav-item" data-url="/pages/admin/points/index" bindtap="go"><view class="nav-icon">🪙</view><view>积分</view></view>
  </view>
</view>
