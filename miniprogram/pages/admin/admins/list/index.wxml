<view class="{{themeClass}} {{fontClass}} page admin-admins-page">
  <view class="dashboard-header">
    <view class="badge">权限管理</view>
    <view class="title">管理员管理</view>
    <view class="tip">通过用户 openid 添加或移除后台管理员权限。</view>
  </view>

  <view class="card compact">
    <view class="strong">添加管理员</view>
    <view class="muted">目标用户必须已注册且账号状态正常。</view>
    <view class="grant-row">
      <input value="{{openid}}" placeholder="输入用户 openid" bindinput="inputOpenid" />
      <button class="mini-btn" disabled="{{saving || !openid}}" bindtap="grantAdmin">{{saving ? '添加中...' : '添加管理员'}}</button>
    </view>
  </view>

  <view class="card compact">
    <view class="strong">筛选管理员</view>
    <input value="{{keyword}}" placeholder="搜索 openid、昵称、手机或状态" bindinput="inputKeyword" confirm-type="search" bindconfirm="submitSearch" />
    <view class="chip-row" style="margin-top:16rpx;">
      <button class="primary compact-btn" bindtap="submitSearch">搜索</button>
      <button class="ghost compact-btn" wx:if="{{keyword}}" bindtap="clearSearch">清空</button>
    </view>
  </view>

  <view wx:if="{{!admins.length && !loading}}" class="empty">暂无管理员</view>

  <view class="card admin-card" wx:for="{{admins}}" wx:key="_id">
    <view class="admin-head">
      <image wx:if="{{item.avatarUrl}}" class="admin-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="admin-avatar avatar-placeholder">{{item.avatarText}}</view>
      <view class="admin-main">
        <view class="between">
          <view class="strong admin-name">{{item.nickname}}</view>
          <view class="badge">{{item.status}}</view>
        </view>
        <view class="muted openid-text">{{item.openid}}</view>
        <view class="muted">{{item.phone || '未填写手机号'}}</view>
      </view>
    </view>
    <view wx:if="{{item.isSelf}}" class="self-tip">当前账号，不可移除</view>
    <button wx:else class="mini-btn danger-mini" data-openid="{{item.openid}}" disabled="{{removingOpenid === item.openid}}" bindtap="revokeAdmin">{{removingOpenid === item.openid ? '移除中...' : '移除管理员'}}</button>
  </view>

  <view class="muted" style="text-align:center;padding:24rpx 0;" wx:if="{{loading && admins.length}}">正在加载更多...</view>
  <view class="muted" style="text-align:center;padding:24rpx 0;" wx:if="{{!loading && admins.length && !hasMore}}">已显示全部管理员</view>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon remix-icon ri-dashboard-3-line"></view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/orders/list/index" bindtap="go"><view class="nav-icon remix-icon ri-file-list-3-line"></view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/admin/staff-audit/list/index" bindtap="go"><view class="nav-icon remix-icon ri-shield-check-line"></view><view>审核</view></view>
    <view class="nav-item" data-url="/pages/admin/incidents/list/index" bindtap="go"><view class="nav-icon remix-icon ri-alarm-warning-line"></view><view>异常</view></view>
  </view>
</view>
