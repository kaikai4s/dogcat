.container {
  padding: 24rpx;
  background: #f7f9f6;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #273629;
  display: block;
}

.subtitle {
  font-size: 24rpx;
  color: #798c7b;
  margin-top: 6rpx;
  display: block;
}

.primary-btn {
  background: #5b874b;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
}

.loading-state,
.error-state {
  text-align: center;
  padding: 80rpx 0;
  color: #889988;
  font-size: 28rpx;
}

.building-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.building-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-image-wrap {
  width: 140rpx;
  height: 140rpx;
  background: #f0f4ee;
  border-radius: 16rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.building-img {
  width: 100rpx;
  height: 100rpx;
}

.type-tag {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  font-size: 18rpx;
  text-align: center;
  color: #ffffff;
  padding: 2rpx 0;
  background: #5a7b5d;
}

.type-tag.repair_shop {
  background: #3c7cb0;
}
.type-tag.committee {
  background: #c54a3e;
}
.type-tag.pet_hospital {
  background: #2ea68f;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2b3b2c;
}

.enabled-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background: #e0e6de;
  color: #798777;
}

.enabled-badge.active {
  background: #e2f2dd;
  color: #427c36;
}

.card-desc {
  font-size: 24rpx;
  color: #758574;
  margin-top: 8rpx;
  display: block;
}

.card-props {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.prop-item {
  font-size: 22rpx;
  color: #637562;
  background: #f2f5ef;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.prop-item.highlight {
  color: #2a6836;
  background: #daf0d8;
  font-weight: 600;
}

.prop-item.cost {
  color: #ba7918;
  background: #fcf1db;
  font-weight: 600;
}

.committee-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #b5493b;
}

.chevron {
  font-size: 36rpx;
  color: #b0bfaf;
  margin-left: 12rpx;
}

/* 弹窗 */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-card {
  background: #ffffff;
  width: 90%;
  max-height: 85vh;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eef2ec;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3a2b;
}

.close-btn {
  background: none;
  border: none;
  font-size: 36rpx;
  color: #8b998a;
  padding: 0 10rpx;
}

.modal-body {
  padding: 24rpx 30rpx;
  flex: 1;
  overflow-y: auto;
  box-sizing: border-box;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #4b5c49;
  font-weight: 600;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  background: #f5f8f3;
  border: 1rpx solid #dce4d9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #2e3d2d;
}

.form-textarea {
  background: #f5f8f3;
  border: 1rpx solid #dce4d9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #2e3d2d;
  width: 100%;
  box-sizing: border-box;
  height: 120rpx;
}

.type-radio-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.radio-label {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #445543;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-col {
  flex: 1;
}

.tile-preview-card {
  background: #ebf6e8;
  border: 1rpx dashed #73ab6a;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.preview-title {
  font-size: 24rpx;
  color: #466e3f;
  font-weight: 600;
}

.preview-count {
  font-size: 26rpx;
  color: #1f6b21;
  font-weight: 700;
}

.preview-tip {
  font-size: 22rpx;
  color: #688a62;
  margin-top: 8rpx;
  display: block;
}

.section-divider {
  font-size: 26rpx;
  font-weight: 700;
  color: #ba473a;
  margin: 28rpx 0 16rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #f6dedb;
}

.form-tip {
  font-size: 22rpx;
  color: #c94f41;
  line-height: 1.4;
  display: block;
  margin-top: 10rpx;
}

.image-upload-box {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.checkerboard-bg {
  width: 140rpx;
  height: 140rpx;
  background: #f0f0f0;
  border-radius: 12rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.uploaded-img {
  width: 120rpx;
  height: 120rpx;
}

.upload-btn {
  font-size: 26rpx;
  background: #edf3ea;
  color: #3b5f33;
}

.switch-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-footer {
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #eef2ec;
  display: flex;
  gap: 20rpx;
}

.danger-btn {
  background: #fbeeed;
  color: #c44033;
  font-size: 28rpx;
  flex: 1;
}

.primary-btn {
  flex: 1;
}
