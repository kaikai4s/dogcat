<view class="container">
  <view class="header">
    <view class="title-wrap">
      <text class="title">乐园建筑管理</text>
      <text class="subtitle">可建建筑、尺寸预览换算草地、功能、会员解锁与积分配置</text>
    </view>
    <button wx:if="{{adminSuper || adminPermissions.playgroundBuilding_save}}" class="primary-btn" bindtap="edit" data-id="">新建建筑</button>
  </view>

  <view class="loading-state" wx:if="{{loading}}">正在加载建筑列表…</view>
  <view class="error-state" wx:if="{{error}}">{{error}}</view>

  <view class="category-tabs" wx:if="{{!loading && !form}}">
    <view wx:for="{{categories}}" wx:key="key" class="category-tab {{activeCategory === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchCategory">
      {{item.label}}
    </view>
  </view>

  <view class="building-list" wx:if="{{!loading && !form}}">
    <view class="building-card" wx:for="{{displayBuildings}}" wx:key="id" bindtap="edit" data-id="{{item.id}}">
      <view class="card-image-wrap">
        <image class="building-img" src="{{item.image || '/assets/default-building.png'}}" mode="aspectFit" />
        <text class="type-tag {{item.type}}">{{item.type === 'repair_shop' ? '修理厂' : item.type === 'pet_hospital' ? '宠物医院' : item.type === 'committee' ? '居委会' : item.type === 'wood_cabin' ? '小木屋' : item.type === 'floor' ? '地板' : item.type === 'tree' ? '景观树' : item.type === 'police_station' ? '督导所' : item.type === 'prison' ? '自省室' : '房屋'}}</text>
      </view>
      <view class="card-info">
        <view class="card-heading">
          <text class="card-title">{{item.name}}</text>
          <text class="enabled-badge {{item.enabled ? 'active' : ''}}">{{item.enabled ? '已启用' : '已下架'}}</text>
        </view>
        <text class="card-desc">{{item.desc || '暂无描述'}}</text>
        <view class="card-props">
          <text class="prop-item">尺寸: {{item.width}}×{{item.depth}}米</text>
          <text class="prop-item highlight">占 {{item.tileCount}} 块草地</text>
          <text class="prop-item">{{item.unlockLevelIds.length ? '指定会员等级可建造' : '所有会员可建造'}}</text>
        </view>
        <view class="committee-meta" wx:if="{{item.type === 'committee'}}">
          <text>每周处理奖励: {{item.weeklySalary || 0}}积分 · 调解: {{item.resolveReward || 0}}积分/起</text>
        </view>
      </view>
      <view class="chevron">›</view>
    </view>
  </view>

  <view class="building-list" wx:if="{{!form && !loading}}"><view class="title">新地皮会员解锁</view><text class="subtitle">每个规格单独保存，不选等级表示所有会员可用。</text><view class="building-card" wx:for="{{plotSizes}}" wx:key="size"><view><text>{{item.label}}</text><checkbox-group data-size="{{item.size}}" bindchange="plotLevelsChange"><label wx:for="{{item.choices}}" wx:for-item="level" wx:key="_id"><checkbox value="{{level._id}}" checked="{{level.checked}}" />{{level.name}}</label></checkbox-group><button wx:if="{{adminSuper || adminPermissions.playgroundBuilding_savePlotAccess}}" data-size="{{item.size}}" bindtap="savePlotLevels" disabled="{{busy}}">保存此规格</button></view></view></view>
  <!-- 编辑/新建弹窗 -->
  <view class="modal-backdrop" wx:if="{{form}}">
    <view class="modal-card">
      <view class="modal-header">
        <text class="modal-title">{{isNew ? '新建建筑' : '编辑建筑 · ' + form.name}}</text>
        <button class="close-btn" bindtap="close">✕</button>
      </view>

      <scroll-view scroll-y class="modal-body">
        <view class="form-group">
          <text class="form-label">建筑编号 (唯一英文ID)</text>
          <input class="form-input" disabled="{{!isNew}}" value="{{form.id}}" data-key="id" bindinput="input" placeholder="如 repair_shop_1" />
        </view>

        <view class="form-group">
          <text class="form-label">建筑名称</text>
          <input class="form-input" value="{{form.name}}" data-key="name" bindinput="input" placeholder="如 社区便民修理厂" />
        </view>

        <view class="form-group">
          <text class="form-label">功能类型</text>
          <radio-group class="type-radio-group" bindchange="typeChange">
            <label class="radio-label" wx:for="{{types}}" wx:key="key">
              <radio value="{{item.key}}" checked="{{form.type === item.key}}" />
              <text>{{item.label}}</text>
            </label>
          </radio-group>
        </view>

        <view class="form-group">
          <text class="form-label">功能描述与用途</text>
          <textarea class="form-textarea" value="{{form.desc}}" data-key="desc" bindinput="input" placeholder="简要说明此建筑的业务功能" />
        </view>

        <!-- 尺寸与草地换算预览 -->
        <view class="form-row">
          <view class="form-col">
            <text class="form-label">宽度 (米)</text>
            <input class="form-input" type="digit" value="{{form.width}}" data-key="width" bindinput="input" />
          </view>
          <view class="form-col">
            <text class="form-label">深度/长度 (米)</text>
            <input class="form-input" type="digit" value="{{form.depth}}" data-key="depth" bindinput="input" />
          </view>
        </view>

        <view class="tile-preview-card">
          <view class="preview-header">
            <text class="preview-title">草地地块占用换算（单块草地 3.5×3.5米）</text>
            <text class="preview-count">相当于占 {{form.tileCount}} 块草地</text>
          </view>
          <text class="preview-tip">建筑总占地面积约 {{form.width * form.depth}} 平方米。系统将在场景中按对应比例缩放渲染。</text>
        </view>

        <view class="form-group"><text class="form-label">会员等级（不选表示所有会员；勾选的等级分别生效）</text><checkbox-group bindchange="levelsChange"><label wx:for="{{levelChoices}}" wx:key="_id"><checkbox value="{{item._id}}" checked="{{item.checked}}" />{{item.name}}</label></checkbox-group></view>
        <view class="form-group" wx:if="{{form.type === 'repair_shop'}}"><text class="form-label">单次有效洗车奖励（会员积分，0关闭）</text><input class="form-input" type="number" value="{{form.washPoints}}" data-key="washPoints" bindinput="input" /></view>
        <!-- 居委会专属配置 -->
        <block wx:if="{{form.type === 'committee'}}">
          <view class="section-divider">居委会会员积分配置（0表示关闭）</view><view class="form-group"><text class="form-label">有效举报奖励（会员积分）</text><input class="form-input" type="number" value="{{form.reportPoints}}" data-key="reportPoints" bindinput="input" /></view><text class="form-tip">每周奖励要求任职满7天、最近7天处理过反馈，距上次领取满7天。</text>
          <view class="form-row">
            <view class="form-col">
              <text class="form-label">每周处理奖励 (积分/周)</text>
              <input class="form-input" type="number" value="{{form.weeklySalary}}" data-key="weeklySalary" bindinput="input" />
            </view>
            <view class="form-col">
              <text class="form-label">单次纠纷调解奖励 (积分/起)</text>
              <input class="form-input" type="number" value="{{form.resolveReward}}" data-key="resolveReward" bindinput="input" />
            </view>
          </view>
          <text class="form-tip">注意：每个社区有且仅能存在一个居委会；若有未处理纠纷超3天未调解，系统将自动收回该建筑与职务！</text>
        </block>

        <!-- 图片素材上传与透明预览 -->
        <view class="form-group">
          <text class="form-label">建筑/素材游戏图 (PNG/JPG/WEBP)</text>
          <view class="image-upload-box">
            <view class="checkerboard-bg" wx:if="{{form.image}}">
              <image class="uploaded-img" src="{{form.image}}" mode="aspectFit" />
            </view>
            <button wx:if="{{adminSuper || adminPermissions.playgroundBuilding_prepareUpload}}" class="upload-btn" bindtap="upload" disabled="{{busy}}">{{form.image ? '更换素材原图' : '选择并上传素材图'}}</button>
          </view>
        </view>

        <view class="form-group switch-group">
          <text class="form-label">是否上架允许建造</text>
          <switch checked="{{form.enabled}}" color="#6f8d58" bindchange="enabledChange" />
        </view>
      </scroll-view>

      <view class="modal-footer">
        <button class="danger-btn" wx:if="{{!isNew && (adminSuper || adminPermissions.playgroundBuilding_remove)}}" bindtap="removeBuilding" disabled="{{busy}}">删除建筑</button>
        <button wx:if="{{adminSuper || adminPermissions.playgroundBuilding_save}}" class="primary-btn" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存配置</button>
      </view>
    </view>
  </view>
</view>
