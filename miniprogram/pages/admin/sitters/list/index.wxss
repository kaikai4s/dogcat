.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-row input {
  flex: 1;
  margin-bottom: 0;
}

.search-row .mini-btn {
  flex-shrink: 0;
  margin: 0;
}

.role-tabs {
  margin-top: 24rpx;
  padding-bottom: 0;
}

.sitter-card {
  overflow: hidden;
}

.sitter-head {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.sitter-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #fff0f5;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f43f6b;
  font-weight: 900;
}

.sitter-main {
  flex: 1;
  min-width: 0;
}

.sitter-name,
.openid-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sitter-info {
  margin-top: 18rpx;
}

.featured-badge {
  color: #9a3412;
  background: linear-gradient(135deg, #fff7ed 0%, #fed7aa 100%);
}

.admin-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.admin-actions .mini-btn {
  flex: 1;
}

.ghost-mini {
  color: #f43f6b;
  background: #fff7fa;
  border: 2rpx solid rgba(244, 63, 107, 0.18);
}
