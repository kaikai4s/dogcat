.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-row input {
  flex: 1;
  margin-bottom: 0;
}

.search-row .mini-btn {
  flex-shrink: 0;
  margin: 0;
}

.role-tabs {
  margin-top: 20rpx;
  padding-bottom: 0;
}

.compact-admin-header {
  margin-bottom: 20rpx;
}

.sitter-compact-card {
  overflow: hidden;
}

.sitter-head {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.compact-sitter-head {
  align-items: flex-start;
}

.sitter-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #fff0f5;
}

.compact-avatar {
  width: 76rpx;
  height: 76rpx;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f43f6b;
  font-weight: 900;
}

.sitter-main {
  flex: 1;
  min-width: 0;
}

.compact-title-row {
  align-items: flex-start;
  gap: 12rpx;
}

.sitter-name,
.openid-text,
.compact-line {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.compact-line {
  margin-top: 6rpx;
  font-size: 23rpx;
}

.compact-meta-row {
  margin-top: 10rpx;
}

.sitter-action-row {
  margin-top: 16rpx;
  justify-content: flex-start;
  flex-wrap: wrap;
}

.sitter-action-row .mini-btn {
  margin: 0;
  min-height: 54rpx;
  flex: 1;
  min-width: 160rpx;
}

.sitter-detail-body {
  margin-top: 16rpx;
}

.openid-box {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(134, 144, 156, 0.08);
  color: var(--theme-muted);
  font-size: 22rpx;
  word-break: break-all;
}

.featured-badge {
  color: #9a3412;
  background: linear-gradient(135deg, #fff7ed 0%, #fed7aa 100%);
}

.ghost-mini {
  color: #f43f6b;
  background: #fff7fa;
  border: 2rpx solid rgba(244, 63, 107, 0.18);
}

.danger-mini {
  color: #dc2626;
  background: #fef2f2;
  border: 2rpx solid rgba(220, 38, 38, 0.18);
}

.danger-chip {
  background: #fef2f2 !important;
  color: #ef4444 !important;
  border: 1rpx solid rgba(239, 68, 68, 0.25) !important;
  font-weight: 850;
}

.danger-text {
  color: #ef4444 !important;
}

.success-text {
  color: #10b981 !important;
}

.sitter-problem-section {
  margin-top: 18rpx;
  padding: 16rpx;
  background: #fffafa;
  border: 1rpx solid rgba(239, 68, 68, 0.16);
  border-radius: 18rpx;
}

.sitter-problem-section.clean-section {
  background: #f0fdf4;
  border: 1rpx solid rgba(16, 185, 129, 0.18);
}

.clean-tip {
  font-size: 24rpx;
  color: #065f46;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.problem-section-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.problem-order-card {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 14rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid rgba(239, 68, 68, 0.12);
  box-shadow: 0 2rpx 6rpx rgba(239, 68, 68, 0.04);
}

.problem-order-card:last-child {
  margin-bottom: 0;
}

.problem-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.problem-orderno {
  font-size: 24rpx;
  font-weight: 850;
  color: #1f2937;
}

.problem-reason-type {
  font-size: 24rpx;
  font-weight: 800;
  color: #dc2626;
  margin-top: 6rpx;
}

.problem-desc {
  font-size: 23rpx;
  color: #4b5563;
  margin-top: 4rpx;
  line-height: 1.4;
}

.problem-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.problem-amount .price {
  color: #ef4444;
  font-weight: 900;
}

.problem-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

.problem-actions .mini-btn {
  flex: 1;
  min-height: 48rpx;
  font-size: 22rpx;
  padding: 0 12rpx;
}

.filter-toggle-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.filter-toggle-btn.active {
  background: #ff7a45;
  color: #fff;
}

.filter-panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff8ec;
  border: 1rpx solid rgba(255, 153, 102, 0.2);
}

.filter-section-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #d45f22;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.filter-row {
  margin-bottom: 16rpx;
}

.filter-label {
  font-size: 24rpx;
  font-weight: 850;
  color: #6b5b50;
  margin-bottom: 8rpx;
}

.range-inputs {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.range-inputs input {
  flex: 1;
  height: 64rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 153, 102, 0.2);
  padding: 0 16rpx;
  font-size: 24rpx;
}

.range-separator {
  color: #8e8580;
  font-size: 24rpx;
}

.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #7a6a5e;
  font-size: 22rpx;
  font-weight: 800;
  border: 1rpx solid rgba(255, 153, 102, 0.15);
}

.filter-chip.active {
  background: #ff7a45;
  color: #ffffff;
  border-color: #ff7a45;
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}

.batch-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.15);
}

.batch-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.batch-label {
  font-size: 24rpx;
  font-weight: 850;
  color: #4b5563;
}

.check-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #ffffff;
  font-size: 24rpx;
  transition: all 0.2s;
}

.check-box.checked {
  background: #ef4444;
  border-color: #ef4444;
}

.item-check-box {
  margin-right: 6rpx;
  margin-top: 20rpx;
}

.card-selected {
  border: 2rpx solid #fca5a5 !important;
  background: #fffafa !important;
}

.deposit-chip {
  background: #ecfdf5;
  color: #047857;
  font-weight: 850;
}

.meta-chip.danger-chip {
  background: #fef2f2;
  color: #dc2626;
  font-weight: 850;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 10001;
  display: flex;
  align-items: flex-end;
  background: rgba(45, 33, 26, 0.46);
  backdrop-filter: blur(4rpx);
}

.modal-card {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 34rpx 28rpx calc(64rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 38rpx;
  border-top-right-radius: 38rpx;
  background: #ffffff;
  box-sizing: border-box;
  box-shadow: 0 -12rpx 40rpx rgba(45, 33, 26, 0.16);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 950;
  color: #2d211a;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.modal-summary {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #fbf7f4;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.form-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 850;
  color: #55483f;
}

.form-section textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 153, 102, 0.22);
  background: #ffffff;
  font-size: 26rpx;
  color: #2d211a;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.modal-actions button {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 950;
}

.danger-btn {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: #ffffff;
}

.forfeit-target-staff {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  background: #fff7ed;
  border: 1rpx solid #ffedd5;
  border-radius: 12rpx;
  color: #c2410c;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.forfeit-balance-info {
  font-size: 24rpx;
  color: #78350f;
}

.forfeit-evidences-box {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  max-height: 40vh;
  overflow-y: auto;
  padding: 4rpx 0;
}

.evidence-select-card {
  background: #fbfbfc;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 18rpx;
  transition: all 0.2s ease;
}

.evidence-select-card.card-selected {
  background: #fffafa;
  border-color: #fca5a5;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.08);
}

.evidence-select-top {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.checkbox-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid #d1d5db;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  transition: all 0.15s ease;
}

.checkbox-box.checked {
  background: #ef4444;
  border-color: #ef4444;
  color: #ffffff;
  font-size: 28rpx;
}

.evidence-meta {
  flex: 1;
}

.evidence-reason-name {
  font-size: 26rpx;
  color: #1f2937;
}

.evidence-desc {
  margin-top: 4rpx;
  color: #4b5563;
  line-height: 1.4;
}

.evidence-order {
  margin-top: 4rpx;
  color: #9ca3af;
}

.evidence-amount-row {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #fed7aa;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
}

.suggest-tip {
  color: #dc2626;
  font-weight: bold;
}

.actual-input-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.actual-input-label {
  font-size: 22rpx;
  color: #047857;
  font-weight: 800;
}

.input-with-symbol {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #a7f3d0;
  border-radius: 10rpx;
  padding: 4rpx 10rpx;
}

.input-with-symbol .currency {
  font-size: 24rpx;
  color: #059669;
  font-weight: bold;
  margin-right: 4rpx;
}

.actual-amount-input {
  width: 140rpx;
  height: 48rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #047857;
}

.styled-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 153, 102, 0.25);
  background: #ffffff;
  font-size: 28rpx;
  color: #2d211a;
  box-sizing: border-box;
}

/* 举证截图上传组件 */
.forfeit-uploader-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 10rpx;
}

.uploader-thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: visible;
}

.thumb-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
}

.thumb-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  z-index: 2;
}

.uploader-add-btn {
  width: 120rpx;
  height: 120rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  color: #94a3b8;
}

.uploader-add-btn .ri-camera-line {
  font-size: 38rpx;
  line-height: 1;
}

.uploader-add-text {
  font-size: 20rpx;
  margin-top: 6rpx;
}


