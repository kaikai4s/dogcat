<view class="{{themeClass}} {{fontClass}} page admin-sitters-page">
  <view class="dashboard-header compact-admin-header">
    <view class="badge">人员管理</view>
    <view class="title">宠托师管理</view>
    <view class="tip">默认只展示关键身份信息，展开后查看服务区域、培训、晋升和账号详情。</view>
  </view>

  <view class="card compact">
    <view class="search-row">
      <input value="{{keyword}}" placeholder="搜索姓名 / 城市 / 手机号 / openid" bindinput="inputKeyword" confirm-type="search" bindconfirm="search" />
      <button class="mini-btn" bindtap="search">搜索</button>
    </view>
    <view class="status-tabs role-tabs">
      <view wx:for="{{statusTabs}}" wx:key="value" class="status-tab {{auditStatus === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="switchStatus">{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{!profiles.length && !loading}}" class="empty">暂无宠托师资料</view>

  <view class="admin-compact-card sitter-compact-card" wx:for="{{profiles}}" wx:key="_id">
    <view class="sitter-head compact-sitter-head">
      <image wx:if="{{item.userAvatarUrl}}" class="sitter-avatar compact-avatar" src="{{item.userAvatarUrl}}" mode="aspectFill" />
      <view wx:else class="sitter-avatar compact-avatar avatar-placeholder">{{item.avatarText}}</view>
      <view class="sitter-main">
        <view class="between compact-title-row">
          <view class="strong sitter-name">{{item.realName || '未填写姓名'}}</view>
          <view class="badge featured-badge" wx:if="{{item.isFeatured}}">精选</view>
          <view class="badge" wx:else>{{item.auditStatusText}}</view>
        </view>
        <view class="muted compact-line">{{item.phone || '未填写手机号'}} · {{item.serviceCity || '未填写城市'}}</view>
        <view class="meta-chip-row compact-meta-row">
          <view class="meta-chip chip-primary">{{item.staffLevelText || '申请人'}}</view>
          <view class="meta-chip">{{item.ratingText}}</view>
          <view class="meta-chip warning" wx:if="{{item.promotionStatus === 'pending'}}">转正审核中</view>
        </view>
      </view>
    </view>

    <view class="admin-summary-row sitter-action-row">
      <button class="mini-btn" data-id="{{item._id}}" bindtap="detail">{{item.actionText}}</button>
      <button class="mini-btn ghost-mini" wx:if="{{item.staffLevel === 'certified'}}" data-id="{{item._id}}" data-featured="{{item.isFeatured}}" bindtap="toggleFeatured">{{item.featuredActionText}}</button>
      <button class="mini-btn danger-mini" wx:if="{{item.canRevokeStaff}}" data-id="{{item._id}}" bindtap="revokeStaff">移除身份</button>
      <button class="mini-btn ghost-mini" data-index="{{index}}" bindtap="toggleDetails">{{item.expanded ? '收起详情' : '展开详情'}}</button>
    </view>

    <view class="collapse-body sitter-detail-body" wx:if="{{item.expanded}}">
      <view class="compact-info-grid">
        <view class="compact-info-item"><view class="compact-info-label">绑定账号</view><view class="compact-info-value">{{item.userNickname}}</view></view>
        <view class="compact-info-item"><view class="compact-info-label">服务区域</view><view class="compact-info-value">{{item.serviceAreas || '未填写'}}</view></view>
        <view class="compact-info-item"><view class="compact-info-label">培训状态</view><view class="compact-info-value">{{item.onboardingStatusText || '-'}}</view></view>
        <view class="compact-info-item"><view class="compact-info-label">晋升状态</view><view class="compact-info-value">{{item.promotionStatusText || '-'}}</view></view>
        <view class="compact-info-item"><view class="compact-info-label">实习订单</view><view class="compact-info-value">{{item.internCompletedOrderCount || 0}}/3</view></view>
        <view class="compact-info-item"><view class="compact-info-label">账号状态</view><view class="compact-info-value">{{item.userStatus || '未知'}}</view></view>
      </view>
      <view class="openid-box">{{item.openid}}</view>
    </view>
  </view>

  <button class="ghost" wx:if="{{hasMore}}" loading="{{loading}}" disabled="{{loading}}" bindtap="loadMore">{{loading ? '加载中...' : '加载更多'}}</button>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon remix-icon ri-dashboard-3-line"></view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/orders/list/index" bindtap="go"><view class="nav-icon remix-icon ri-file-list-3-line"></view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/admin/staff-audit/list/index" bindtap="go"><view class="nav-icon remix-icon ri-shield-check-line"></view><view>审核</view></view>
    <view class="nav-item" data-url="/pages/admin/incidents/list/index" bindtap="go"><view class="nav-icon remix-icon ri-alarm-warning-line"></view><view>异常</view></view>
  </view>
</view>
