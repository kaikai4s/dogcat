.page { min-height:100vh; padding:32rpx; box-sizing:border-box; background:#f7f6f2; color:#312d29; }
.title { font-size:38rpx; font-weight:700; }
.env { margin:16rpx 0 28rpx; font-size:24rpx; color:#7e7369; word-break:break-all; }
.card { background:#fff; padding:28rpx; border-radius:24rpx; margin-bottom:24rpx; }
.subtitle { font-size:30rpx; font-weight:700; margin-bottom:16rpx; }
.description { font-size:25rpx; line-height:1.7; color:#746b63; word-break:break-all; margin:12rpx 0; }
button { font-size:27rpx; margin-top:22rpx; border-radius:16rpx; }
.primary { background:#df7726; color:#fff; }
.summary-row { display:flex; justify-content:space-between; gap:16rpx; padding:18rpx 0; font-size:24rpx; border-bottom:1rpx solid #eee; }
.notice { font-size:25rpx; padding:20rpx; margin-top:20rpx; background:#fff1d8; border-radius:14rpx; line-height:1.7; color:#8c5b23; }
.footer { margin:28rpx 4rpx; }
.theme-night.page { background:#17151f; color:#f0e8df; }
.theme-night .card { background:#25212e; }
.theme-night .description, .theme-night .env { color:#b9ada2; }
