.manor-admin{box-sizing:border-box;min-height:100vh;padding:28rpx 28rpx calc(190rpx + env(safe-area-inset-bottom));background:#f3f6f3;color:#263f35}.manor-admin button::after{border:0}
.admin-hero{padding:14rpx 4rpx 26rpx}.eyebrow{font-size:22rpx;color:#54846e;letter-spacing:3rpx;font-weight:600}.page-title{font-size:42rpx;font-weight:800;line-height:1.5;margin-top:8rpx}.hero-tip{font-size:24rpx;color:#73877d;margin-top:6rpx;line-height:1.6}
.quick-links{display:flex;flex-wrap:wrap;gap:12rpx;margin-bottom:26rpx}.quick-links navigator{flex:1;min-width:170rpx;display:flex;align-items:center;gap:8rpx;padding:22rpx 14rpx;border-radius:18rpx;background:#fff;font-size:24rpx;white-space:nowrap}.quick-links .remix-icon{font-size:29rpx;color:#397660}.link-arrow{margin-left:auto;color:#92a297}
.card{margin-bottom:24rpx;padding:28rpx;border:1rpx solid #e3eae4;border-radius:28rpx;background:#fff;box-shadow:0 6rpx 24rpx rgba(38,63,53,.035)}.card-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding-bottom:16rpx}.card-title{font-size:32rpx;font-weight:700}.card-subtitle{font-size:23rpx;color:#7a8c80;margin-top:8rpx;line-height:1.6}.section-icon{font-size:39rpx;flex-shrink:0;width:68rpx;height:68rpx;line-height:68rpx;text-align:center;border-radius:19rpx;color:#397660;background:#edf5ee}
.manor-field{display:flex;align-items:center;justify-content:space-between;padding:23rpx 0;border-bottom:1rpx solid #edf1ed;gap:16rpx;font-size:27rpx}.field-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:7rpx}.field-tip{font-size:21rpx;color:#829086;line-height:1.6}.input-wrap{flex-shrink:0;box-sizing:border-box;display:flex;align-items:center;justify-content:flex-end;gap:8rpx;width:192rpx;border:1rpx solid #e2eae2;border-radius:14rpx;background:#f7f9f6;padding:14rpx 16rpx}.input-wrap input{width:100%;min-width:0;height:44rpx;min-height:0;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none;box-sizing:border-box;text-align:right;font-size:29rpx;font-weight:600;color:#2d5340}.input-wrap>text{flex-shrink:0;color:#87978b;font-size:21rpx;white-space:nowrap}.parameter-input{width:242rpx}.manor-field switch{flex-shrink:0;transform:scale(.88);transform-origin:right center}
.rule-preview{margin-top:24rpx;padding:24rpx;border-radius:18rpx;background:linear-gradient(125deg,#eaf4ec,#f6f8ed);border:1rpx solid #deebde}.preview-heading{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;color:#4e6d5c}.preview-tag{font-weight:700;padding:5rpx 14rpx;background:#dcebdd;border-radius:9rpx;color:#397660}.preview-price{font-size:26rpx;color:#397660;margin:12rpx 0 6rpx}.preview-price text{font-size:46rpx;font-weight:800;margin-left:6rpx}.preview-caption{font-size:22rpx;color:#7e8c7d}
.note{margin-top:22rpx;font-size:22rpx;line-height:1.8;color:#7f8d83}.dimension-row{display:flex;gap:16rpx;align-items:center;margin-top:18rpx}.dimension-item{flex:1;min-width:0;font-size:24rpx;color:#748477}.dimension-item .input-wrap{width:100%;margin-top:12rpx}.dimension-cross{font-size:30rpx;color:#a0ada0;padding-top:40rpx}
.species-tabs{display:flex;gap:8rpx;padding:7rpx;background:#f0f4ef;border-radius:18rpx;margin:12rpx 0 28rpx}.species-tabs button{flex:1;width:auto;margin:0;line-height:74rpx;border-radius:14rpx;font-size:27rpx;font-weight:600;background:transparent;color:#80917f}.species-tabs button.active{background:#397660;color:#fff;box-shadow:0 5rpx 14rpx rgba(57,118,96,.14)}
.parameter-group{padding-top:10rpx;margin-top:28rpx}.parameter-title{font-size:27rpx;font-weight:700;border-left:6rpx solid #7ba184;padding-left:13rpx;line-height:1.2}.parameter-caption{font-size:22rpx;color:#879486;line-height:1.7;margin-top:10rpx}
.save-dock{position:fixed;z-index:5;bottom:0;left:0;right:0;display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.98);border-top:1rpx solid #e2eae2;box-shadow:0 -8rpx 28rpx rgba(38,63,53,.04)}.save-status{display:flex;align-items:center;gap:10rpx;font-size:23rpx;color:#7d8c7e}.unsaved-dot,.saved-dot{width:12rpx;height:12rpx;border-radius:50%;background:#da9b45}.saved-dot{background:#83a990}.save-dock button{flex-shrink:0;margin:0;padding:0 30rpx;line-height:84rpx;border-radius:19rpx;font-size:27rpx;font-weight:600;color:#fff;background:#397660}.save-dock button[disabled]{color:#9daaa0;background:#e9efea}
.readonly-note{display:flex;align-items:center;gap:10rpx;padding:20rpx;margin:0 0 24rpx;border-radius:16rpx;background:#e7efe8;color:#637965;font-size:23rpx;line-height:1.7}.empty-state{text-align:center;padding:60rpx 24rpx;color:#7a8c80;font-size:27rpx}.empty-state button{margin-top:24rpx;font-size:26rpx;background:#e1eee4;color:#397660}
