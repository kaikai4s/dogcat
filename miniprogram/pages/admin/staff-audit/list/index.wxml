<view class="admin-audit-page {{themeClass}} {{fontClass}}">
  <view class="audit-hero">
    <view class="hero-badge"><text class="remix-icon ri-shield-check-fill"></text><text>资质审核</text></view>
    <view class="hero-title">员工审核</view>
    <view class="hero-desc">审核宠托师入驻资料，控制平台服务人员准入。</view>
  </view>

  <view class="status-tabs">
    <view class="status-tab {{activeStatus === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" data-status="{{item.value}}" bindtap="chooseStatus">{{item.label}}</view>
  </view>

  <view class="admin-card search-card-panel">
    <view class="search-field"><text class="remix-icon ri-search-line"></text><input placeholder="搜索姓名、手机、城市或区域" value="{{keyword}}" bindinput="inputKeyword" confirm-type="search" bindconfirm="submitSearch" /></view>
    <view class="filter-actions">
      <button class="primary-btn compact-btn" bindtap="submitSearch">搜索</button>
      <button class="ghost-btn compact-btn" wx:if="{{keyword}}" bindtap="clearSearch">清空</button>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && !staff.length}}"><text class="remix-icon ri-user-search-line empty-icon"></text><view>暂无符合条件的审核资料。</view></view>

  <view class="admin-card audit-card interactive" wx:for="{{staff}}" wx:key="_id" data-id="{{item._id}}" bindtap="detail">
    <view class="audit-main">
      <view class="audit-avatar"><text class="remix-icon ri-user-star-line"></text></view>
      <view class="audit-info">
        <view class="strong">{{item.realName}}</view>
        <view class="muted">{{item.serviceCity || '服务城市待完善'}}</view>
      </view>
      <view class="soft-badge status-badge">{{item.auditStatusText}}</view>
    </view>
  </view>

  <view class="load-tip" wx:if="{{loading && staff.length}}">正在加载更多...</view>
  <view class="load-tip" wx:if="{{!loading && staff.length && !hasMore}}">已显示全部审核资料</view>

  <view class="bottom-nav admin-bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon remix-icon ri-dashboard-3-line"></view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/orders/list/index" bindtap="go"><view class="nav-icon remix-icon ri-file-list-3-line"></view><view>订单</view></view>
    <view class="nav-item active"><view class="nav-icon remix-icon ri-shield-check-fill"></view><view>审核</view></view>
    <view class="nav-item" data-url="/pages/admin/incidents/list/index" bindtap="go"><view class="nav-icon remix-icon ri-alarm-warning-line"></view><view>异常</view></view>
  </view>
</view>
