@import "../list/index.wxss";

.audit-detail-page {
  padding-bottom: 120rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 72rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.1);
}

.info-row:last-child { border-bottom: none; }

.info-row .value {
  flex: 1;
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.4;
  text-align: right;
  word-break: break-all;
}

.evidence-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.service-option {
  min-width: 0;
  padding: 12rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.12);
}

.evidence-image {
  width: 100%;
  height: 170rpx;
  border-radius: 18rpx;
  background: #fff0e2;
}

.service-title {
  margin-top: 10rpx;
  color: #7a6a5e;
  font-size: 22rpx;
  font-weight: 850;
  text-align: center;
}

.remark-textarea {
  width: 100%;
  height: 190rpx;
  padding: 22rpx;
  border-radius: 26rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  color: #2d211a;
  font-size: 27rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.bottom-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 28rpx;
}

.bottom-actions .primary-btn,
.bottom-actions .danger-btn {
  min-height: 88rpx;
  border-radius: 999rpx;
}
