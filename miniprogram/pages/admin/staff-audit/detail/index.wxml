<view class="admin-audit-page audit-detail-page {{themeClass}} {{fontClass}}" wx:if="{{staff}}">
  <view class="audit-hero">
    <view class="hero-badge"><text class="remix-icon ri-user-star-fill"></text><text>审核详情</text></view>
    <view class="hero-title">{{staff.realName}}</view>
    <view class="hero-desc">核对身份和服务范围后，填写备注并给出审核结论。</view>
  </view>

  <view class="admin-card detail-card">
    <view class="card-subtitle"><text class="remix-icon ri-profile-line sub-icon"></text><text>入驻资料</text></view>
    <view class="info-row"><view class="label">姓名</view><view class="value">{{staff.realName}}</view></view>
    <view class="info-row"><view class="label">性别</view><view class="value">{{staff.gender === 'male' ? '男' : (staff.gender === 'female' ? '女' : '未填写')}}</view></view>
    <view class="info-row"><view class="label">手机</view><view class="value">{{staff.phone}}</view></view>
    <view class="info-row"><view class="label">城市</view><view class="value">{{staff.serviceCity}}</view></view>
    <view class="info-row"><view class="label">区域</view><view class="value">{{staff.serviceAreas}}</view></view>
    <view class="info-row"><view class="label">身份核验</view><view class="soft-badge status-badge">{{staff.identityStatus || 'pending'}}</view></view>
    <view class="info-row"><view class="label">人脸核验</view><view class="soft-badge status-badge">{{staff.faceVerifyStatus || 'manual_pending'}}</view></view>
    <view class="info-row"><view class="label">状态</view><view class="soft-badge status-badge">{{staff.auditStatusText}}</view></view>
  </view>

  <view class="admin-card form-card">
    <view class="card-subtitle"><text class="remix-icon ri-id-card-line sub-icon"></text><text>实名认证材料</text></view>
    <view class="evidence-grid">
      <view class="service-option" wx:if="{{staff.idCardFrontFileId}}" data-url="{{staff.idCardFrontFileId}}" bindtap="preview">
        <image class="evidence-image" src="{{staff.idCardFrontFileId}}" mode="aspectFill" />
        <view class="service-title">身份证人像面</view>
      </view>
      <view class="service-option" wx:if="{{staff.idCardBackFileId}}" data-url="{{staff.idCardBackFileId}}" bindtap="preview">
        <image class="evidence-image" src="{{staff.idCardBackFileId}}" mode="aspectFill" />
        <view class="service-title">身份证国徽面</view>
      </view>
      <view class="service-option" wx:if="{{staff.facePhotoFileId}}" data-url="{{staff.facePhotoFileId}}" bindtap="preview">
        <image class="evidence-image" src="{{staff.facePhotoFileId}}" mode="aspectFill" />
        <view class="service-title">自拍/人脸照</view>
      </view>
    </view>
  </view>

  <view class="admin-card form-card" wx:if="{{staff.auditStatus === 'approved' && !staff.gender}}">
    <view class="card-subtitle">核实补录性别</view>
    <view class="muted">请核对实名认证材料后补录，仅可补录一次，操作将留档。</view>
    <radio-group class="gender-options" bindchange="chooseGender">
      <label><radio value="male" checked="{{gender === 'male'}}" />男</label>
      <label><radio value="female" checked="{{gender === 'female'}}" />女</label>
    </radio-group>
    <textarea class="remark-textarea" placeholder="填写核实依据或说明" value="{{genderReason}}" bindinput="inputGenderReason" />
    <button class="primary-btn" loading="{{savingGender}}" disabled="{{savingGender}}" bindtap="completeGender">确认核实并补录</button>
  </view>

  <view class="admin-card form-card" wx:if="{{staff.auditStatus === 'pending'}}">
    <view class="card-subtitle"><text class="remix-icon ri-edit-line sub-icon"></text><text>审核备注</text></view>
    <textarea class="remark-textarea" placeholder="审核备注" value="{{remark}}" bindinput="input" />
    <view class="muted" wx:if="{{!staff.gender}}">申请人未填写性别，请退回补充后再审核。</view>
  </view>

  <view class="admin-card form-card" wx:else>
    <view class="card-subtitle"><text class="remix-icon ri-shield-check-line sub-icon"></text><text>审核结论</text></view>
    <view class="info-row"><view class="label">审核状态</view><view class="soft-badge status-badge">{{staff.auditStatusText}}</view></view>
    <view class="info-row" wx:if="{{staff.auditRemark}}"><view class="label">审核备注</view><view class="value">{{staff.auditRemark}}</view></view>
  </view>

  <view class="admin-card form-card" wx:if="{{staff.problemOrderCount > 0}}">
    <view class="card-subtitle"><text class="remix-icon ri-alarm-warning-fill sub-icon" style="color: #ef4444;"></text><text style="color: #ef4444;">出险与违规订单留证 ({{staff.problemOrderCount}}笔)</text></view>
    <view class="timeline" style="margin-top: 14rpx;">
      <view class="timeline-item" wx:for="{{staff.problemOrders}}" wx:key="_id">
        <view class="timeline-dot" style="background: #ef4444;"></view>
        <view class="timeline-content">
          <view class="strong" style="color: #ef4444; display: flex; justify-content: space-between; align-items: center;">
            <text>{{item.orderNo}} · {{item.reasonTypeName}}</text>
            <text class="badge {{item.status === 'forfeited' ? 'green' : 'pink'}}" style="font-size: 20rpx;">{{item.statusText || (item.status === 'forfeited' ? '已根据建议扣除保证金' : '待执行扣除')}}</text>
          </view>
          <view class="muted" style="margin-top: 6rpx;">{{item.reasonText}}</view>
          <view class="strong small" style="margin-top: 6rpx; display: flex; flex-wrap: wrap; gap: 12rpx; align-items: baseline;" wx:if="{{item.deductAmount > 0 || item.actualDeductAmount > 0}}">
            <text style="color: #ef4444;" wx:if="{{item.deductAmount > 0}}">建议扣除：¥{{item.deductAmount}}</text>
            <text style="color: #059669; font-weight: bold; background: #ecfdf5; padding: 2rpx 10rpx; border-radius: 6rpx; border: 1rpx solid #a7f3d0;" wx:if="{{item.status === 'forfeited'}}">实际根据建议扣除：¥{{item.actualDeductAmountText || item.actualDeductAmount || item.forfeitedAmount || item.deductAmount}}</text>
          </view>
          <view class="muted small" style="margin-top: 6rpx;">{{item.createdAt}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-actions" wx:if="{{staff.auditStatus === 'pending'}}">
    <button class="primary-btn" data-status="approved" bindtap="audit"><text class="remix-icon ri-check-line"></text><text>审核通过</text></button>
    <button class="danger-btn" data-status="rejected" bindtap="audit"><text class="remix-icon ri-close-line"></text><text>审核拒绝</text></button>
  </view>
</view>
