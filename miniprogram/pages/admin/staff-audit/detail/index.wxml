<view class="page" wx:if="{{staff}}"><view class="title">审核详情</view><view class="card"><view>姓名：{{staff.realName}}</view><view>手机：{{staff.phone}}</view><view>城市：{{staff.serviceCity}}</view><view>区域：{{staff.serviceAreas}}</view><view>状态：{{staff.auditStatus}}</view></view><textarea placeholder="审核备注" value="{{remark}}" bindinput="input"/><button class="primary" data-status="approved" bindtap="audit">审核通过</button><button class="danger" data-status="rejected" bindtap="audit">审核拒绝</button></view>