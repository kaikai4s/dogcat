@import "../list/index.wxss";

.incident-detail-page { padding-bottom: 120rpx; }

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 72rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.1);
}

.info-row:last-child { border-bottom: none; }
.info-row .value { flex: 1; color: #2d211a; font-size: 25rpx; font-weight: 850; text-align: right; word-break: break-all; }

.problem-text {
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff8ec;
  color: #2d211a;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.5;
}

.evidence-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.evidence-image {
  width: 100%;
  height: 180rpx;
  border-radius: 22rpx;
  background: #fff0e2;
}

.picker-field,
.form-input,
.form-textarea {
  width: 100%;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  color: #2d211a;
  font-size: 27rpx;
  box-sizing: border-box;
}

.picker-field,
.form-input { min-height: 82rpx; line-height: 82rpx; }

.form-textarea {
  height: 190rpx;
  padding-top: 22rpx;
  line-height: 1.45;
}

.form-btn {
  width: 100%;
  margin-top: 18rpx;
}

.price {
  margin-top: 12rpx;
  color: #e9672f;
  font-size: 34rpx;
  font-weight: 950;
}

.timeline {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.timeline-item {
  padding: 18rpx;
  border-radius: 24rpx;
  background: #fff8ec;
}

.log-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bottom-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 28rpx;
}

.three-actions { grid-template-columns: 1fr; }

.bottom-actions .primary-btn,
.bottom-actions .ghost-btn {
  min-height: 86rpx;
  border-radius: 999rpx;
}
