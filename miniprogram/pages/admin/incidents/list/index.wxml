<view class="page">
  <view class="dashboard-header">
    <view class="badge">风险处理</view>
    <view class="title">异常事件</view>
    <view class="tip">集中处理员工提交的 SOS 和履约异常。</view>
  </view>

  <view class="card" wx:for="{{incidents}}" wx:key="_id">
    <view class="between">
      <view>
        <view class="strong">{{item.incidentTypeText}}</view>
        <view class="muted">{{item.description}}</view>
      </view>
      <view class="badge">{{item.statusText}}</view>
    </view>
    <button class="mini-btn" size="mini" data-id="{{item._id}}" bindtap="resolve">标记处理</button>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon">⌂</view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/orders/list/index" bindtap="go"><view class="nav-icon">☷</view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/admin/staff-audit/list/index" bindtap="go"><view class="nav-icon">☑</view><view>审核</view></view>
    <view class="nav-item active"><view class="nav-icon">!</view><view>异常</view></view>
  </view>
</view>
