/* 会员等级管理端样式布局优化 */

.page {
  padding-bottom: 120rpx;
}

.dashboard-header {
  margin-bottom: 24rpx;
}

.header-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.add-level-btn {
  width: auto !important;
  min-height: 68rpx !important;
  padding: 0 28rpx !important;
  margin: 0 !important;
  font-size: 26rpx !important;
}

.preview-box {
  margin: 0 0 28rpx;
  padding: 24rpx 28rpx;
  background: var(--theme-bg-soft);
  border: 2rpx dashed var(--theme-border);
  border-radius: 20rpx;
}

.preview-title {
  font-size: 24rpx;
  color: var(--theme-muted);
  margin-bottom: 14rpx;
}

.preview-user-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.preview-name {
  font-size: 34rpx;
  font-weight: 800;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--theme-text);
  margin-bottom: 12rpx;
}

.field-label .required {
  color: var(--theme-primary);
}

.color-palette {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.color-dot-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 12rpx;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  background: var(--theme-bg-soft);
}

.color-dot-wrap.active {
  border-color: var(--theme-primary);
  background: var(--theme-primary-soft);
  box-shadow: 0 4rpx 12rpx rgba(244, 63, 107, 0.15);
}

.color-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(0, 0, 0, 0.1);
}

.color-name {
  font-size: 20rpx;
  color: var(--theme-muted);
}

.selector-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.grid-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 12rpx;
  background: var(--theme-bg-soft);
  border: 2rpx solid var(--theme-border);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.grid-item.active {
  border-color: var(--theme-primary);
  background: var(--theme-primary-soft);
  box-shadow: 0 4rpx 12rpx rgba(244, 63, 107, 0.12);
}

.grid-item-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--theme-text);
}

.section-title {
  font-size: 32rpx;
  font-weight: 850;
  color: var(--theme-title);
  margin: 36rpx 4rpx 18rpx;
}

.level-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.level-card {
  background: var(--theme-card-bg);
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 36rpx var(--theme-shadow);
  border: 1rpx solid var(--theme-border);
  display: flex;
  flex-direction: column;
}

.level-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.level-identity {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.level-name {
  font-size: 32rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.2;
}

.edit-btn {
  color: var(--theme-primary);
  background: var(--theme-primary-soft);
  border: 1rpx solid var(--theme-border);
}

.delete-btn {
  color: #ff4d4f;
  background: #fff0f0;
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

.level-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-bottom: 10rpx;
}

.meta-tag {
  font-size: 24rpx;
  color: var(--theme-muted);
  background: var(--theme-bg-soft);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.meta-tag.highlight {
  color: var(--theme-primary);
  font-weight: 700;
}

.level-desc {
  font-size: 25rpx;
  color: var(--theme-muted);
  margin-top: 6rpx;
  line-height: 1.4;
}

.chip-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

/* 弹窗 Modal 样式 */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-card.level-form-modal {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  padding: 32rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  animation: slideUp 0.25s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0edf0;
  margin-bottom: 20rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--theme-title);
}

.modal-close {
  font-size: 32rpx;
  color: var(--theme-muted);
  padding: 10rpx;
}

.modal-scroll-body {
  flex: 1;
  height: 60vh;
  max-height: 60vh;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0edf0;
}

.modal-actions button {
  margin: 0;
}
