<view class="{{themeClass}} {{fontClass}} page admin-user-edit-page">
  <view class="dashboard-header">
    <view class="badge">用户管理</view>
    <view class="title">编辑用户资料</view>
    <view class="tip">修改用户基础资料、状态、角色、积分和补签卡。</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中...</view>

  <view wx:if="{{user && !loading}}" class="card form-card">
    <view class="card-head-row">
      <view class="strong">账号档案与时间线</view>
      <button class="mini-btn view-pets-btn" bindtap="viewPets">查看TA的宠物 ({{user.stats.pets || 0}})</button>
    </view>
    <view class="info-list" style="margin-bottom: 24rpx;">
      <view class="info-row"><view class="label">OpenID</view><view class="value">{{openid}} <text class="copy-tag" data-text="{{openid}}" bindtap="copyText">复制</text></view></view>
      <view class="info-row highlight-time-row"><view class="label">注册时间</view><view class="value font-time">{{user.createdAt || '未知'}}</view></view>
      <view class="info-row"><view class="label">最后更新</view><view class="value">{{user.updatedAt || '未知'}}</view></view>
      <view class="info-row"><view class="label">专属邀请码</view><view class="value">{{user.inviteCode || '未生成'}} <text wx:if="{{user.inviteCode}}" class="copy-tag" data-text="{{user.inviteCode}}" bindtap="copyText">复制</text></view></view>
      <view class="info-row"><view class="label">绑定邀请人</view><view class="value">{{user.inviterOpenid || '无'}} <text wx:if="{{user.inviterOpenid}}" class="copy-tag" data-text="{{user.inviterOpenid}}" bindtap="copyText">复制</text></view></view>
      <view class="info-row"><view class="label">协议签署时间</view><view class="value">{{user.agreementSignedAt || '未记录'}}</view></view>
      <view class="info-row"><view class="label">累计完成订单</view><view class="value">{{user.completedOrderCount || 0}} 单</view></view>
    </view>

    <view class="strong">基础信息修改</view>

    <view class="field">
      <view class="label">昵称</view>
      <input value="{{form.nickname}}" data-key="nickname" bindinput="inputField" disabled="{{user.status === 'deleted'}}" />
    </view>
    <view class="field">
      <view class="label">手机号</view>
      <input value="{{form.phone}}" data-key="phone" bindinput="inputField" disabled="{{user.status === 'deleted'}}" />
    </view>
    <view class="field">
      <view class="label">头像地址</view>
      <input value="{{form.avatarUrl}}" data-key="avatarUrl" bindinput="inputField" disabled="{{user.status === 'deleted'}}" />
    </view>
    <view class="field">
      <view class="label">状态</view>
      <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="changeStatus" disabled="{{user.status === 'deleted'}}">
        <view class="picker-value">{{statusText}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">会员等级</view>
      <input value="{{form.memberLevelName}}" data-key="memberLevelName" bindinput="inputField" disabled="{{user.status === 'deleted'}}" />
    </view>
    <view class="field-row">
      <view class="field inline">
        <view class="label">可用积分</view>
        <input type="number" value="{{form.points}}" data-key="points" bindinput="inputField" disabled="{{user.status === 'deleted'}}" />
      </view>
      <view class="field inline">
        <view class="label">累计积分</view>
        <input type="number" value="{{form.totalPoints}}" data-key="totalPoints" bindinput="inputField" disabled="{{user.status === 'deleted'}}" />
      </view>
    </view>
    <view class="field">
      <view class="label">补签卡</view>
      <input type="number" value="{{form.retroCardCount}}" data-key="retroCardCount" bindinput="inputField" disabled="{{user.status === 'deleted'}}" />
    </view>

    <view class="field">
      <view class="label">角色</view>
      <checkbox-group bindchange="changeRoles">
        <label class="role-check" wx:for="{{roleOptions}}" wx:key="value">
          <checkbox value="{{item.value}}" checked="{{item.checked}}" disabled="{{user.status === 'deleted'}}" color="#f4436b" />
          <text>{{item.label}}</text>
        </label>
      </checkbox-group>
    </view>

    <button wx:if="{{adminSuper || adminPermissions.admin_updateUserProfile}}" class="primary" loading="{{saving}}" disabled="{{saving || user.status === 'deleted'}}" bindtap="save">保存修改</button>
    <button class="danger-btn" wx:if="{{(user.status !== 'deleted') && (adminSuper || adminPermissions.admin_deleteUser)}}" bindtap="deleteUser">删除用户</button>
    <button class="danger-btn" wx:if="{{(user.status === 'deleted') && (adminSuper || adminPermissions.admin_hardDeleteUser)}}" bindtap="hardDeleteUser">彻底删除</button>
  </view>

  <view wx:if="{{user && !loading}}" class="card">
    <view class="strong">关联数据统计</view>
    <view class="tip-text">删除用户会清理个人资料数据，订单记录会保留。</view>
    <view class="info-list">
      <view class="info-row" wx:for="{{statsRows}}" wx:key="label">
        <view class="label">{{item.label}}</view>
        <view class="value">{{item.value}}</view>
      </view>
    </view>
  </view>
</view>
<global-loading />
