.form-card {
  padding: 30rpx;
}

.openid-text {
  margin-top: 8rpx;
  word-break: break-all;
}

.field {
  margin-top: 24rpx;
}

.field-row {
  display: flex;
  gap: 18rpx;
}

.field.inline {
  flex: 1;
}

.field .label {
  margin-bottom: 10rpx;
  color: #7d6f76;
  font-size: 24rpx;
}

.picker-value {
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #fff7fa;
  display: flex;
  align-items: center;
  color: #2b2528;
}

.role-check {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin: 8rpx 28rpx 8rpx 0;
  color: #2b2528;
  font-size: 28rpx;
}

.role-check checkbox {
  transform: scale(1.2);
}

checkbox .wx-checkbox-input {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked {
  background: #f4436b;
  border-color: #f4436b;
}

checkbox .wx-checkbox-input.wx-checkbox-input-checked::before {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: transparent;
  transform: translate(-50%, -50%) scale(1);
  -webkit-transform: translate(-50%, -50%) scale(1);
}

.danger-btn {
  margin-top: 20rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: #fff0f3;
  color: #f4436b;
  font-weight: 800;
  line-height: 88rpx;
}

.danger-btn::after {
  border: 0;
}

.card-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.view-pets-btn {
  margin: 0 !important;
  background: #eff6ff !important;
  color: #2563eb !important;
  border: 1rpx solid #bfdbfe !important;
  font-size: 22rpx !important;
}

.copy-tag {
  background: #eef2ff;
  color: #4f46e5;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  cursor: pointer;
  margin-left: 8rpx;
}

.highlight-time-row {
  background: #fdfaf6;
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
}

.font-time {
  color: #d97706;
  font-weight: 600;
}

.tip-text {
  margin-top: 10rpx;
  color: #a59aa0;
  font-size: 24rpx;
}
