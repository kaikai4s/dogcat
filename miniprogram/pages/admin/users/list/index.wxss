.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-row input {
  flex: 1;
  margin-bottom: 0;
}

.search-row .mini-btn {
  flex-shrink: 0;
  margin: 0;
}

.role-tabs {
  margin-top: 24rpx;
  padding-bottom: 0;
}

.user-card {
  overflow: hidden;
}

.user-head {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #fff0f5;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f43f6b;
  font-weight: 900;
}

.user-main {
  flex: 1;
  min-width: 0;
}

.user-name,
.openid-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-info {
  margin-top: 18rpx;
}

.user-actions {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
}

.user-actions .mini-btn {
  margin: 0;
}

.user-actions .danger {
  background: #fff0f3;
  color: #f4436b;
}
