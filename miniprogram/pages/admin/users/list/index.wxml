<view class="{{themeClass}} {{fontClass}} page admin-users-page">
  <view class="dashboard-header">
    <view class="badge">人员管理</view>
    <view class="title">用户管理</view>
    <view class="tip">查看用户账号、角色、会员等级和积分信息。<text wx:if="{{total > 0}}">（共 {{total}} 位用户）</text></view>
  </view>

  <view class="card compact">
    <view class="search-row">
      <input value="{{keyword}}" placeholder="搜索昵称 / 手机号 / openid" bindinput="inputKeyword" confirm-type="search" bindconfirm="search" />
      <button class="mini-btn" bindtap="search">搜索</button>
    </view>
    <view class="status-tabs role-tabs">
      <view wx:for="{{roleTabs}}" wx:key="value" class="status-tab {{role === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="switchRole">{{item.label}}</view>
    </view>
  </view>

  <view wx:if="{{!users.length && !loading}}" class="empty">暂无用户</view>

  <view class="card user-card" wx:for="{{users}}" wx:key="_id">
    <view class="user-head">
      <view class="avatar-level-wrap">
        <image wx:if="{{item.avatarUrl}}" class="user-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="user-avatar avatar-placeholder">{{item.avatarText}}</view>
        <view class="avatar-level-badge badge-{{item.badgeStyle || 'gold'}}" wx:if="{{item.badgeTag || item.memberLevelName}}">{{item.badgeTag || item.memberLevelName}}</view>
      </view>
      <view class="user-main">
        <view class="between">
          <view class="strong user-name">
            <text class="{{item.nameEffect && item.nameEffect !== 'none' ? 'name-effect-' + item.nameEffect : ''}}" style="{{item.nameColor ? 'color: ' + item.nameColor + ';' : ''}}">{{item.nickname}}</text>
            <text class="member-badge badge-{{item.badgeStyle || 'gold'}}" wx:if="{{item.badgeTag || item.memberLevelName}}">{{item.badgeTag || item.memberLevelName}}</text>
          </view>
          <view class="badge">{{item.statusText}}</view>
        </view>
        <view class="muted openid-text">
          <text>{{item.openid}}</text>
          <text class="copy-tag" data-text="{{item.openid}}" bindtap="copyText">复制</text>
        </view>
      </view>
    </view>
    <view class="chip-row">
      <view class="chip pink" wx:for="{{item.roleTexts}}" wx:for-item="roleItem" wx:key="*this">{{roleItem}}</view>
    </view>
    <view class="info-list user-info">
      <view class="info-row"><view class="label">手机号</view><view class="value">{{item.phone || '未填写'}} <text wx:if="{{item.phone}}" class="copy-tag" data-text="{{item.phone}}" bindtap="copyText">复制</text></view></view>
      <view class="info-row"><view class="label">会员等级</view><view class="value">{{item.memberLevelName}}</view></view>
      <view class="info-row"><view class="label">可用积分</view><view class="value">{{item.points}}</view></view>
      <view class="info-row"><view class="label">累计积分</view><view class="value">{{item.totalPoints}}</view></view>
      <view class="info-row"><view class="label">专属邀请码</view><view class="value">{{item.inviteCode || '未生成'}} <text wx:if="{{item.inviteCode}}" class="copy-tag" data-text="{{item.inviteCode}}" bindtap="copyText">复制</text></view></view>
      <view class="info-row"><view class="label">绑定邀请人</view><view class="value">{{item.inviterOpenid || '无'}} <text wx:if="{{item.inviterOpenid}}" class="copy-tag" data-text="{{item.inviterOpenid}}" bindtap="copyText">复制</text></view></view>
      <view class="info-row"><view class="label">已完成服务</view><view class="value">{{item.completedOrderCount}} 单</view></view>
      <view class="info-row"><view class="label">补签卡</view><view class="value">{{item.retroCardCount}} 张</view></view>
      <view class="info-row highlight-time-row"><view class="label">注册时间</view><view class="value font-time">{{item.createdAtText}}</view></view>
      <view class="info-row"><view class="label">最后更新</view><view class="value">{{item.updatedAtText}}</view></view>
    </view>
    <view class="user-actions">
      <button class="mini-btn highlight-btn" data-openid="{{item.openid}}" bindtap="viewUserPets">查看TA的宠物</button>
      <button wx:if="{{adminSuper || adminPermissions.admin_getUserDetail}}" class="mini-btn" data-openid="{{item.openid}}" bindtap="editUser">编辑资料</button>
      <button class="mini-btn" wx:if="{{(item.status !== 'deleted') && (adminSuper || adminPermissions.admin_updateUserProfile)}}" data-openid="{{item.openid}}" bindtap="toggleUserStatus">{{item.status === 'disabled' ? '启用' : '禁用'}}</button>
      <button class="mini-btn danger" wx:if="{{(item.status !== 'deleted') && (adminSuper || adminPermissions.admin_deleteUser)}}" data-openid="{{item.openid}}" bindtap="deleteUser">删除用户</button>
      <button class="mini-btn danger" wx:if="{{(item.status === 'deleted') && (adminSuper || adminPermissions.admin_hardDeleteUser)}}" data-openid="{{item.openid}}" bindtap="hardDeleteUser">彻底删除</button>
    </view>
  </view>

  <button class="ghost" wx:if="{{hasMore}}" loading="{{loading}}" disabled="{{loading}}" bindtap="loadMore">{{loading ? '加载中...' : '加载更多'}}</button>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon remix-icon ri-dashboard-3-line"></view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/orders/list/index" bindtap="go"><view class="nav-icon remix-icon ri-file-list-3-line"></view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/admin/staff-audit/list/index" bindtap="go"><view class="nav-icon remix-icon ri-shield-check-line"></view><view>审核</view></view>
    <view class="nav-item" data-url="/pages/admin/incidents/list/index" bindtap="go"><view class="nav-icon remix-icon ri-alarm-warning-line"></view><view>异常</view></view>
  </view>
</view>
<global-loading />
