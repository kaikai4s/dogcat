.service-config-card {
  gap: 16rpx;
}

.service-config-card input[disabled] {
  color: #86909c;
  background: #f7f8fa;
}

.switch-row {
  margin-top: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(134, 144, 156, 0.12);
  border-bottom: 1rpx solid rgba(134, 144, 156, 0.12);
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.action-row .compact-btn {
  width: 100%;
}
