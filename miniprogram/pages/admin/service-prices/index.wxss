.compact-price-notice {
  padding: 22rpx;
}

.compact-main-action {
  min-height: 76rpx;
  margin: 16rpx 0 20rpx;
}

.service-summary-card .mini-btn,
.collapse-card .mini-btn {
  margin: 0;
  min-height: 52rpx;
  padding: 0 22rpx;
}

.compact-rule-item {
  padding: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
}

.compact-rule-item input,
.modal-scroll-body input,
.modal-scroll-body textarea,
.modal-scroll-body .field {
  margin-top: 16rpx;
}

.compact-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(134, 144, 156, 0.12);
}

.compact-switch-row:last-child {
  border-bottom: none;
}

.modal-scroll-body textarea {
  min-height: 150rpx;
}

.detail-textarea {
  min-height: 240rpx;
}

.case-section {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 248, 236, 0.72);
  border: 1rpx solid rgba(255, 153, 102, 0.16);
}

.case-head {
  padding-top: 0;
}

.case-head .mini-btn {
  min-height: 56rpx;
  margin: 0;
  padding: 0 20rpx;
}

.case-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.case-thumb {
  position: relative;
  height: 150rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff0e2;
}

.case-image {
  width: 100%;
  height: 100%;
}

.case-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(45, 33, 26, 0.68);
  font-size: 30rpx;
  line-height: 1;
}
