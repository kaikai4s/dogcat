.compact-price-notice {
  padding: 22rpx;
}

.compact-main-action {
  min-height: 76rpx;
  margin: 16rpx 0 20rpx;
}

.service-summary-card .mini-btn,
.collapse-card .mini-btn {
  margin: 0;
  min-height: 52rpx;
  padding: 0 22rpx;
}

.compact-rule-item {
  padding: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
}

.compact-rule-item input,
.modal-scroll-body input,
.modal-scroll-body textarea,
.modal-scroll-body .field {
  margin-top: 16rpx;
}

.compact-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(134, 144, 156, 0.12);
}

.compact-switch-row:last-child {
  border-bottom: none;
}

.modal-scroll-body textarea {
  min-height: 150rpx;
}

.detail-textarea {
  min-height: 240rpx;
}

.case-section {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 248, 236, 0.72);
  border: 1rpx solid rgba(255, 153, 102, 0.16);
}

.case-head {
  padding-top: 0;
}

.case-head .mini-btn {
  width: auto !important;
  min-height: 56rpx;
  margin: 0;
  padding: 0 20rpx;
  flex-shrink: 0;
}

.case-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.case-thumb {
  position: relative;
  height: 150rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff0e2;
}

.case-image {
  width: 100%;
  height: 100%;
}

.case-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(45, 33, 26, 0.68);
  font-size: 30rpx;
  line-height: 1;
}

.admin-service-thumb {
  width: 108rpx;
  height: 82rpx;
  border-radius: 16rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  background: #fff5ee;
}

.cover-header {
  margin-bottom: 12rpx;
}

.cover-header .strong {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--theme-title, #2d211a);
}

.cover-header .muted {
  font-size: 22rpx;
  color: var(--theme-muted, #8e8580);
  margin-top: 6rpx;
  line-height: 1.4;
}

.cover-actions-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  align-items: center;
}

.cover-action-btn {
  flex: 1;
  width: auto !important;
  min-height: 64rpx !important;
  height: 64rpx !important;
  line-height: 62rpx !important;
  padding: 0 20rpx !important;
  margin: 0 !important;
  border-radius: 999rpx;
  font-size: 24rpx !important;
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.cover-action-btn .btn-icon {
  font-size: 28rpx;
}

.cover-action-btn.primary-soft-btn {
  background: #fff0e6 !important;
  color: #ff6b35 !important;
  border: 1rpx solid #ffd8bf !important;
  font-weight: 700;
}

.cover-action-btn.ghost-btn {
  background: #ffffff !important;
  color: #7a6a5e !important;
  border: 1rpx solid #e0d5cb !important;
  font-weight: 600;
}

.admin-cover-box {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-top: 10rpx;
  background: #fff5ee;
  border: 1rpx solid rgba(255, 153, 102, 0.2);
}

.admin-cover-img {
  width: 100%;
  height: 100%;
}

.cover-hover-tag {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  background: rgba(45, 33, 26, 0.65);
  color: #ffffff;
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.empty-cover-uploader {
  margin-top: 14rpx;
  padding: 42rpx 20rpx;
  border: 2rpx dashed #ffb86c;
  border-radius: 20rpx;
  background: #fffbf7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.uploader-icon {
  font-size: 52rpx;
  color: #ff7a45;
  margin-bottom: 8rpx;
}

.uploader-text {
  font-size: 26rpx;
  font-weight: 850;
  color: #2d211a;
}

.uploader-sub {
  font-size: 22rpx;
  color: #8e8580;
  margin-top: 6rpx;
}

.admin-service-thumb-placeholder {
  width: 108rpx;
  height: 82rpx;
  border-radius: 16rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  background: #fdf6f0;
  border: 1rpx dashed #f0d5c0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c49c7a;
  font-size: 36rpx;
  box-sizing: border-box;
}

.danger-soft-btn {
  background: #fff0f0 !important;
  color: #e03131 !important;
  border: 1rpx solid #ffc9c9 !important;
}

