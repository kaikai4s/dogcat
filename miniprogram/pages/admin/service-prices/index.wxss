.compact-price-notice {
  padding: 22rpx;
}

.compact-main-action {
  min-height: 76rpx;
  margin: 16rpx 0 20rpx;
}

.service-summary-card .mini-btn,
.collapse-card .mini-btn {
  margin: 0;
  min-height: 52rpx;
  padding: 0 22rpx;
}

.compact-rule-item {
  padding: 18rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
}

.compact-rule-item input,
.modal-scroll-body input,
.modal-scroll-body textarea,
.modal-scroll-body .field {
  margin-top: 16rpx;
}

.compact-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(134, 144, 156, 0.12);
}

.compact-switch-row:last-child {
  border-bottom: none;
}

.modal-scroll-body textarea {
  min-height: 150rpx;
}
