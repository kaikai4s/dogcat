<view class="{{themeClass}} {{fontClass}} page">
  <view class="dashboard-header">
    <view class="badge">管理端</view>
    <view class="title">服务价格配置</view>
    <view class="tip">配置预约页服务、基础价格、多宠物加价、首页展示和自定义服务。</view>
  </view>

  <view class="notice">
    <view class="strong">价格说明</view>
    <view class="muted">上门费固定必选；其他服务可按“多一只宠物”或“多一只狗狗”设置额外加价。服务关闭后不可被下单选择。</view>
  </view>

  <button class="primary" bindtap="addService">添加自定义服务</button>

  <view class="card form-card service-config-card" wx:for="{{prices}}" wx:key="key">
    <view class="between">
      <view>
        <view class="strong">{{item.label || '新服务'}}</view>
        <view class="muted">{{item.key || '填写服务标识后保存'}}</view>
      </view>
      <switch checked="{{item.enabled}}" data-index="{{index}}" bindchange="toggleEnabled" />
    </view>

    <input placeholder="服务名称" value="{{item.label}}" data-index="{{index}}" data-field="label" bindinput="input" />
    <input placeholder="服务标识，如 grooming" value="{{item.key}}" data-index="{{index}}" data-field="key" bindinput="input" disabled="{{item.keyReadonly}}" />
    <input type="number" placeholder="基础价格" value="{{item.price}}" data-index="{{index}}" data-field="price" bindinput="input" />
    <input type="number" placeholder="多宠物加价金额" value="{{item.extraPetFee}}" data-index="{{index}}" data-field="extraPetFee" bindinput="input" />

    <picker range="{{extraPetRuleOptions}}" range-key="label" data-index="{{index}}" bindchange="chooseExtraPetRule" disabled="{{item.key === 'visit_fee'}}">
      <view class="field picker-field">加宠规则：{{item.extraPetRuleText}}</view>
    </picker>

    <view class="between switch-row">
      <view><view class="strong">首页展示</view><view class="muted">控制是否出现在客户端首页热门服务</view></view>
      <switch checked="{{item.showOnHome}}" data-index="{{index}}" bindchange="toggleShowOnHome" disabled="{{item.key === 'visit_fee'}}" />
    </view>

    <input type="number" placeholder="排序，数字越小越靠前" value="{{item.sortOrder}}" data-index="{{index}}" data-field="sortOrder" bindinput="input" />
    <textarea placeholder="服务说明" value="{{item.description}}" data-index="{{index}}" data-field="description" bindinput="input" />

    <view class="action-row">
      <button class="primary compact-btn" data-index="{{index}}" bindtap="save">保存服务</button>
      <button class="ghost compact-btn" wx:if="{{item.canDelete}}" data-index="{{index}}" bindtap="deleteService">{{item.isPreset ? '停用服务' : '删除服务'}}</button>
    </view>
  </view>

  <button class="ghost" bindtap="resetDefaults">恢复默认价格</button>

  <view class="card form-card">
    <view class="between">
      <view>
        <view class="subtitle">服务打卡证据规则</view>
        <view class="muted">按服务配置需要哪些打卡，同类打卡在多服务订单中会自动去重。</view>
      </view>
      <button class="primary compact-btn" bindtap="saveRules">保存规则</button>
    </view>
  </view>

  <view class="card form-card" wx:for="{{ruleGroups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="serviceType">
    <view class="between">
      <view>
        <view class="strong">{{group.title}}</view>
        <view class="muted">{{group.serviceType}} · {{group.rules.length}} 个打卡项</view>
      </view>
      <button class="ghost compact-btn" data-group-index="{{groupIndex}}" bindtap="addRule">新增打卡</button>
    </view>
    <view class="notice" wx:for="{{group.rules}}" wx:for-item="rule" wx:for-index="ruleIndex" wx:key="eventType">
      <picker range="{{eventOptions}}" range-key="label" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" bindchange="chooseRuleEvent">
        <view class="field picker-field">{{rule.label || rule.eventType}}</view>
      </picker>
      <view class="between">
        <view class="strong">必打卡</view>
        <switch checked="{{rule.required}}" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" bindchange="toggleRuleRequired" />
      </view>
      <view class="between">
        <view class="strong">启用</view>
        <switch checked="{{rule.enabled}}" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" bindchange="toggleRuleEnabled" />
      </view>
      <input type="number" placeholder="排序" value="{{rule.sortOrder}}" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" data-field="sortOrder" bindinput="ruleInput" />
      <input placeholder="说明" value="{{rule.description}}" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" data-field="description" bindinput="ruleInput" />
      <button class="ghost" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" bindtap="removeRule">删除此打卡项</button>
    </view>
  </view>

  <button class="ghost" bindtap="resetRuleDefaults">恢复默认打卡规则</button>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon remix-icon ri-dashboard-3-line"></view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/orders/list/index" bindtap="go"><view class="nav-icon remix-icon ri-file-list-3-line"></view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/admin/staff-audit/list/index" bindtap="go"><view class="nav-icon remix-icon ri-checkbox-circle-line"></view><view>审核</view></view>
    <view class="nav-item" data-url="/pages/admin/incidents/list/index" bindtap="go"><view class="nav-icon remix-icon ri-alarm-warning-line"></view><view>异常</view></view>
  </view>
</view>
