<view class="{{themeClass}} {{fontClass}} page">
  <view class="dashboard-header">
    <view class="badge">管理端</view>
    <view class="title">服务价格配置</view>
    <view class="tip">配置宠物主预约页展示的服务项目价格，关闭后该服务不可被选择。</view>
  </view>

  <view class="notice">
    <view class="strong">价格说明</view>
    <view class="muted">上门遛狗会结合宠物体重计算，小程序报价会以这里的基础价格为准。</view>
  </view>

  <view class="card form-card" wx:for="{{prices}}" wx:key="key">
    <view class="between">
      <view>
        <view class="strong">{{item.label}}</view>
        <view class="muted">{{item.key}}</view>
      </view>
      <switch checked="{{item.enabled}}" data-index="{{index}}" bindchange="toggleEnabled" />
    </view>
    <input type="number" placeholder="价格" value="{{item.price}}" data-index="{{index}}" data-field="price" bindinput="input" />
    <textarea placeholder="服务说明" value="{{item.description}}" data-index="{{index}}" data-field="description" bindinput="input" />
    <button class="primary" data-index="{{index}}" bindtap="save">保存价格</button>
  </view>

  <button class="ghost" bindtap="resetDefaults">恢复默认价格</button>

  <view class="card form-card">
    <view class="between">
      <view>
        <view class="subtitle">服务打卡证据规则</view>
        <view class="muted">按服务配置需要哪些打卡，同类打卡在多服务订单中会自动去重。</view>
      </view>
      <button class="primary compact-btn" bindtap="saveRules">保存规则</button>
    </view>
  </view>

  <view class="card form-card" wx:for="{{ruleGroups}}" wx:for-item="group" wx:for-index="groupIndex" wx:key="serviceType">
    <view class="between">
      <view>
        <view class="strong">{{group.serviceType}}</view>
        <view class="muted">{{group.rules.length}} 个打卡项</view>
      </view>
      <button class="ghost compact-btn" data-group-index="{{groupIndex}}" bindtap="addRule">新增打卡</button>
    </view>
    <view class="notice" wx:for="{{group.rules}}" wx:for-item="rule" wx:for-index="ruleIndex" wx:key="eventType">
      <picker range="{{eventOptions}}" range-key="label" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" bindchange="chooseRuleEvent">
        <view class="field picker-field">{{rule.label || rule.eventType}}</view>
      </picker>
      <view class="between">
        <view class="strong">必打卡</view>
        <switch checked="{{rule.required}}" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" bindchange="toggleRuleRequired" />
      </view>
      <view class="between">
        <view class="strong">启用</view>
        <switch checked="{{rule.enabled}}" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" bindchange="toggleRuleEnabled" />
      </view>
      <input type="number" placeholder="排序" value="{{rule.sortOrder}}" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" data-field="sortOrder" bindinput="ruleInput" />
      <input placeholder="说明" value="{{rule.description}}" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" data-field="description" bindinput="ruleInput" />
      <button class="ghost" data-group-index="{{groupIndex}}" data-rule-index="{{ruleIndex}}" bindtap="removeRule">删除此打卡项</button>
    </view>
  </view>

  <button class="ghost" bindtap="resetRuleDefaults">恢复默认打卡规则</button>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon">⌂</view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/orders/list/index" bindtap="go"><view class="nav-icon">☷</view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/admin/staff-audit/list/index" bindtap="go"><view class="nav-icon">☑</view><view>审核</view></view>
    <view class="nav-item" data-url="/pages/admin/incidents/list/index" bindtap="go"><view class="nav-icon">!</view><view>异常</view></view>
  </view>
</view>
