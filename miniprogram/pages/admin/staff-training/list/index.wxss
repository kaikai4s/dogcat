.admin-list-page { min-height: 100vh; padding: 28rpx 28rpx 140rpx; background: #fff8ec; color: #2d211a; box-sizing: border-box; }
.compact-header { padding: 16rpx 4rpx 20rpx; }
.title { font-size: 38rpx; font-weight: 950; }
.desc, .muted, .meta { margin-top: 8rpx; font-size: 24rpx; color: #7a6a5e; }
.compact-search-card { display: flex; gap: 16rpx; margin: 12rpx 0 18rpx; padding: 18rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(123,89,62,.06); }
.search-input { flex: 1; height: 66rpx; padding: 0 20rpx; background: #fff8ec; border-radius: 18rpx; font-size: 26rpx; }
.search-btn { width: 128rpx; height: 66rpx; border: none; border-radius: 18rpx; background: #ff8a4c; color: #fff; font-weight: 900; }
.compact-load-btn { min-height: 76rpx; margin-top: 18rpx; }
.empty { padding: 80rpx 0; text-align: center; color: #8e8580; }

/* 审核微信配置卡片 */
.audit-wechat-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 10rpx 0 18rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #07c160 0%, #05a34e 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(7, 193, 96, 0.22);
}

.banner-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.banner-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

.banner-info {
  flex: 1;
  min-width: 0;
}

.banner-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

.banner-val {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 950;
  word-break: break-all;
}

.banner-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #07a650;
  font-size: 24rpx;
  font-weight: 900;
  border: none;
  line-height: 1.2;
  flex-shrink: 0;
}

.banner-btn:active {
  transform: scale(0.96);
  opacity: 0.92;
}

/* 弹窗样式 */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-card {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 36rpx 20rpx;
  border-bottom: 1rpx solid #f4ede6;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 950;
  color: #2d211a;
}

.modal-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f5efe9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #8c7c72;
}

.modal-body {
  padding: 24rpx 36rpx;
}

.modal-tip {
  font-size: 22rpx;
  color: #8c7c72;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 24rpx;
  font-weight: 850;
  color: #4a3d35;
  margin-bottom: 10rpx;
}

.form-input {
  width: 100%;
  height: 74rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #fbf8f5;
  border: 1rpx solid #e8dfd7;
  font-size: 26rpx;
  color: #2d211a;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 36rpx 30rpx;
}

.modal-btn {
  flex: 1;
  height: 76rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.modal-btn.ghost {
  background: #f5efe9;
  color: #7a6a5e;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #07c160 0%, #05a34e 100%);
  color: #ffffff;
}

