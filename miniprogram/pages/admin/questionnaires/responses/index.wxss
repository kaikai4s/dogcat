.responses-page {
  min-height: 100vh;
  padding: 0 28rpx 100rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.hero {
  margin: 0 -28rpx 24rpx;
  padding: 38rpx 32rpx 30rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 16rpx 40rpx rgba(123, 89, 62, 0.08);
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  font-weight: 850;
  margin-bottom: 12rpx;
}

.hero-title {
  color: #2d211a;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.25;
}

.hero-desc {
  margin-top: 8rpx;
  color: #7a6a5e;
  font-size: 24rpx;
}

.analysis-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9a44 0%, #ff6b35 100%);
  color: #fff;
  font-size: 25rpx;
  font-weight: 900;
  border: none;
  line-height: 68rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(255, 107, 53, 0.25);
}

.analysis-btn::after {
  display: none;
}

/* 顶部快速统计栏 */
.stats-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.stat-cell {
  padding: 18rpx 10rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(8px);
  text-align: center;
  transition: all 0.2s ease;
}

.stat-val {
  color: #2d211a;
  font-size: 32rpx;
  font-weight: 950;
}

.stat-lbl {
  margin-top: 4rpx;
  color: #8e8580;
  font-size: 21rpx;
  font-weight: 700;
}

.stat-cell.green .stat-val { color: #16a34a; }
.stat-cell.orange .stat-val { color: #d97706; }
.stat-cell.red .stat-val { color: #dc2626; }

/* 工具条卡片 */
.toolbar-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(123, 89, 62, 0.05);
  border: 1rpx solid rgba(255, 153, 102, 0.12);
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff8ec;
  border: 1rpx solid rgba(255, 153, 102, 0.15);
}

.search-icon {
  color: #8e8580;
  font-size: 30rpx;
}

.search-input {
  flex: 1;
  color: #2d211a;
  font-size: 26rpx;
}

.filter-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #64748b;
  font-size: 23rpx;
  font-weight: 850;
  transition: all 0.2s ease;
}

.filter-tab.active {
  background: #fff0e2;
  color: #ea580c;
  font-weight: 950;
}

.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 153, 102, 0.12);
}

.batch-tip {
  color: #d97706;
  font-size: 23rpx;
  font-weight: 700;
}

.batch-btn {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #ea580c;
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 56rpx;
  border: none;
  margin: 0;
}

.batch-btn::after {
  display: none;
}

/* 回答卡片 */
.response-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 34rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(123, 89, 62, 0.06);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
}

.resp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.resp-user-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.user-avatar-tag {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.user-avatar-tag.client {
  background: #e0f2fe;
  color: #0284c7;
}

.user-avatar-tag.staff {
  background: #f0fdf4;
  color: #16a34a;
}

.user-meta {
  display: flex;
  flex-direction: column;
}

.user-role-text {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 950;
}

.user-time {
  color: #8e8580;
  font-size: 22rpx;
  margin-top: 2rpx;
}

.quality-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 950;
}

.badge-valid {
  background: #ecfdf3;
  color: #16a34a;
}

.badge-suspicious {
  background: #fff7ed;
  color: #d97706;
}

.badge-fake {
  background: #fff1f2;
  color: #dc2626;
}

.quality-callout {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  font-size: 23rpx;
  line-height: 1.45;
}

.quality-callout.suspicious {
  background: #fffbeb;
  border: 1rpx solid rgba(217, 119, 6, 0.2);
  color: #b45309;
}

.quality-callout.fake {
  background: #fef2f2;
  border: 1rpx solid rgba(220, 38, 38, 0.2);
  color: #b91c1c;
}

.callout-head {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-weight: 950;
  margin-bottom: 4rpx;
}

/* 问答明细 */
.answers-container {
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  background: #fffdfa;
}

.answer-item {
  margin-bottom: 16rpx;
}

.answer-item:last-child {
  margin-bottom: 0;
}

.q-title-row {
  display: flex;
  align-items: flex-start;
  gap: 6rpx;
  color: #6b5b52;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.4;
}

.q-num {
  color: #ff7a45;
}

.q-ans-box {
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #fff8ec;
  color: #2d211a;
  font-size: 26rpx;
  line-height: 1.5;
}

/* 底部奖励 */
.reward-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 153, 102, 0.12);
}

.reward-info {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #8e8580;
  font-size: 23rpx;
}

.reward-status-val.sent {
  color: #16a34a;
  font-weight: 900;
}

.reward-status-val.skipped {
  color: #dc2626;
  font-weight: 900;
}

.reward-status-val.failed {
  color: #ea580c;
  font-weight: 900;
}

.retry-btn {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9a44, #ff6b35);
  color: #fff;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 56rpx;
  border: none;
  margin: 0;
}

.retry-btn::after {
  display: none;
}

/* 空状态 */
.empty-state {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 44rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 30rpx rgba(123, 89, 62, 0.05);
}

.empty-icon {
  color: #ff9a44;
  font-size: 90rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
}

.empty-desc {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 24rpx;
}
