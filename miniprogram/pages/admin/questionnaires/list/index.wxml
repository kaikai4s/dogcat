<view class="page questionnaire-page">
  <!-- 顶部看板 -->
  <view class="hero">
    <view class="hero-header">
      <view class="hero-left">
        <view class="hero-badge">
          <text class="remix-icon ri-survey-line"></text>
          <text>调研与智能分析</text>
        </view>
        <view class="hero-title">问卷调查中心</view>
        <view class="hero-desc">发布用户/宠托师问卷，AI 自动整理图表与防乱填分析。</view>
      </view>
      <button class="create-hero-btn" bindtap="create">
        <text class="remix-icon ri-add-line"></text>新建问卷
      </button>
    </view>

    <!-- 数据概览小卡片 -->
    <view class="stats-grid">
      <view class="stat-box">
        <view class="stat-num">{{stats.total}}</view>
        <view class="stat-label">总问卷数</view>
      </view>
      <view class="stat-box highlight">
        <view class="stat-num">{{stats.publishedCount}}</view>
        <view class="stat-label">进行中</view>
      </view>
      <view class="stat-box">
        <view class="stat-num">{{stats.responseCount}}</view>
        <view class="stat-label">累计回收</view>
      </view>
      <view class="stat-box">
        <view class="stat-num">{{stats.validCount}}</view>
        <view class="stat-label">有效作答</view>
      </view>
    </view>
  </view>

  <!-- 筛选 Tabs -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.label}}
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && !displayList.length}}">
    <view class="empty-icon remix-icon ri-file-list-3-line"></view>
    <view class="empty-title">暂无该状态下的问卷</view>
    <view class="empty-desc">点击右上角“新建问卷”即可创建调研。</view>
  </view>

  <!-- 问卷列表 -->
  <view class="card-list" wx:if="{{displayList.length}}">
    <view class="questionnaire-card" wx:for="{{displayList}}" wx:key="_id">
      <!-- 头部：标题与状态 -->
      <view class="card-header" data-id="{{item._id}}" bindtap="responses">
        <view class="card-title-group">
          <view class="card-title">{{item.title}}</view>
          <view class="tag-row">
            <text class="tag role-tag">{{item.roleText}}</text>
            <text class="tag reward-tag" wx:if="{{item.rewardDesc}}">🎁 {{item.rewardDesc}}</text>
          </view>
        </view>
        <view class="status-pill status-{{item.status}}">{{item.statusText}}</view>
      </view>

      <!-- 说明描述 -->
      <view class="card-desc" data-id="{{item._id}}" bindtap="responses">
        {{item.description || '暂无说明，点击进入查看回收问卷详情'}}
      </view>

      <!-- 统计指标与时间 -->
      <view class="card-meta" data-id="{{item._id}}" bindtap="responses">
        <view class="meta-item">
          <text class="remix-icon ri-inbox-archive-line"></text>
          <text>回收 <text class="strong">{{item.responseCount || 0}}</text> 份</text>
        </view>
        <view class="meta-item">
          <text class="remix-icon ri-checkbox-circle-line"></text>
          <text>有效 <text class="strong green">{{item.validResponseCount || 0}}</text> 份</text>
        </view>
        <view class="meta-time">{{item.createdAtText}}</view>
      </view>

      <!-- 操作按钮条 -->
      <view class="card-actions">
        <button class="action-btn" data-id="{{item._id}}" bindtap="responses">
          <text class="remix-icon ri-eye-line"></text>回收({{item.responseCount || 0}})
        </button>
        <button class="action-btn highlight-btn" data-id="{{item._id}}" bindtap="analysis">
          <text class="remix-icon ri-robot-2-line"></text>AI分析
        </button>
        <button class="action-btn" data-id="{{item._id}}" bindtap="edit" wx:if="{{item.status !== 'closed'}}">
          <text class="remix-icon ri-edit-line"></text>编辑
        </button>
        <button class="action-btn" data-id="{{item._id}}" bindtap="clone">
          <text class="remix-icon ri-file-copy-line"></text>克隆
        </button>
        <button class="action-btn publish-btn" data-id="{{item._id}}" bindtap="publish" wx:if="{{item.status !== 'published'}}">
          <text class="remix-icon ri-send-plane-fill"></text>发布
        </button>
        <button class="action-btn close-btn" data-id="{{item._id}}" bindtap="close" wx:if="{{item.status === 'published'}}">
          <text class="remix-icon ri-stop-circle-line"></text>关闭
        </button>
        <button class="action-btn delete-btn" data-id="{{item._id}}" bindtap="deleteDraft" wx:if="{{item.status === 'draft' || (item.responseCount === 0)}}">
          <text class="remix-icon ri-delete-bin-line"></text>删除
        </button>
      </view>
    </view>
  </view>
</view>
