.questionnaire-page {
  min-height: 100vh;
  padding: 0 28rpx 100rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.hero {
  margin: 0 -28rpx 24rpx;
  padding: 40rpx 32rpx 34rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 16rpx 40rpx rgba(123, 89, 62, 0.08);
}

.hero-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-left {
  flex: 1;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.9);
  font-size: 23rpx;
  font-weight: 850;
  margin-bottom: 14rpx;
}

.hero-title {
  color: #2d211a;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.25;
}

.hero-desc {
  margin-top: 10rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.45;
}

.create-hero-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 72rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9a44 0%, #ff6b35 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.3);
  border: none;
  line-height: 72rpx;
  flex-shrink: 0;
}

.create-hero-btn::after {
  display: none;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.stat-box {
  padding: 20rpx 12rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(8px);
  text-align: center;
  box-shadow: 0 4rpx 14rpx rgba(123, 89, 62, 0.04);
}

.stat-box.highlight {
  background: #ffffff;
  border: 1rpx solid rgba(255, 122, 69, 0.25);
}

.stat-num {
  color: #2d211a;
  font-size: 34rpx;
  font-weight: 950;
}

.stat-box.highlight .stat-num {
  color: #ff6b35;
}

.stat-label {
  margin-top: 6rpx;
  color: #8e8580;
  font-size: 22rpx;
  font-weight: 700;
}

/* Tab 切换栏 */
.tab-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(123, 89, 62, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  color: #7a6a5e;
  font-size: 25rpx;
  font-weight: 850;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #ff9a44, #ff6b35);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 53, 0.25);
}

/* 卡片列表 */
.questionnaire-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 34rpx;
  background: #fff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 12rpx 30rpx rgba(123, 89, 62, 0.06);
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title-group {
  flex: 1;
  min-width: 0;
}

.card-title {
  color: #2d211a;
  font-size: 31rpx;
  font-weight: 950;
  line-height: 1.35;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.tag {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 850;
}

.role-tag {
  background: #f0f7ff;
  color: #0284c7;
}

.reward-tag {
  background: #fff5eb;
  color: #ea580c;
}

.status-pill {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.status-draft {
  background: #fef3c7;
  color: #b45309;
}

.status-published {
  background: #ecfdf3;
  color: #15803d;
}

.status-closed {
  background: #f4f4f5;
  color: #71717a;
}

.card-desc {
  margin-top: 14rpx;
  color: #7a6a5e;
  font-size: 25rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  background: #fffaf4;
  color: #8e8580;
  font-size: 23rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.meta-item .strong {
  color: #2d211a;
  font-weight: 900;
}

.meta-item .strong.green {
  color: #16a34a;
}

.meta-time {
  margin-left: auto;
  font-size: 22rpx;
}

.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(255, 153, 102, 0.12);
}

.action-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff4ea;
  color: #6b5b52;
  font-size: 23rpx;
  font-weight: 850;
  border: none;
  line-height: 60rpx;
  margin: 0;
}

.action-btn::after {
  display: none;
}

.action-btn.highlight-btn {
  background: linear-gradient(135deg, #fff2eb, #ffe4d6);
  color: #d45f22;
  font-weight: 950;
}

.action-btn.publish-btn {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #fff;
}

.action-btn.close-btn {
  background: #f4f4f5;
  color: #52525b;
}

.action-btn.delete-btn {
  background: #fff1f2;
  color: #e11d48;
}

/* 空状态 */
.empty-state {
  min-height: 420rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 44rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 12rpx 30rpx rgba(123, 89, 62, 0.05);
}

.empty-icon {
  color: #ff9a44;
  font-size: 90rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
}

.empty-desc {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 24rpx;
}
