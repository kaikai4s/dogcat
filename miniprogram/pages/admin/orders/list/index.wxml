<view class="{{themeClass}} {{fontClass}} page">
  <view class="dashboard-header">
    <view class="badge">运营管理</view>
    <view class="title">订单管理</view>
    <view class="tip">查看订单状态并为已支付订单分配服务人员。</view>
  </view>

  <view class="card order-filter-card">
    <view class="field-item"><text class="label">订单</text><input class="input" value="{{orderKeyword}}" bindinput="inputOrderKeyword" bindconfirm="submitSearch" confirm-type="search" placeholder="搜索订单ID或订单号" /></view>
    <view class="field-item"><text class="label">用户手机号</text><input class="input" type="number" value="{{clientPhone}}" bindinput="inputClientPhone" bindconfirm="submitSearch" confirm-type="search" placeholder="搜索用户手机号" /></view>
    <view class="field-item"><text class="label">宠托师手机号</text><input class="input" type="number" value="{{staffPhone}}" bindinput="inputStaffPhone" bindconfirm="submitSearch" confirm-type="search" placeholder="搜索宠托师手机号" /></view>
    <view class="filter-actions">
      <button class="primary compact-btn" bindtap="submitSearch">搜索</button>
      <button class="ghost compact-btn" bindtap="clearSearch">清空</button>
    </view>
  </view>

  <view class="status-tabs">
    <view class="status-tab {{activeStatus === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" data-status="{{item.value}}" bindtap="chooseStatus">{{item.label}}</view>
  </view>

  <view class="card batch-bar" wx:if="{{orders.length}}">
    <view class="muted">共 {{total}} 单，已选 {{selectedOrderIds.length}} 单</view>
    <view class="filter-actions">
      <button class="ghost compact-btn" bindtap="toggleSelectAll">全选/取消</button>
      <button class="danger compact-btn" loading="{{deleting}}" disabled="{{deleting || !selectedOrderIds.length}}" bindtap="batchDeleteOrders">批量删除</button>
    </view>
  </view>

  <view class="card order-card {{item.selected ? 'selected' : ''}}" wx:for="{{orders}}" wx:key="_id">
    <view class="order-select-row" data-id="{{item._id}}" bindtap="toggleSelect">
      <view class="select-box {{item.selected ? 'checked' : ''}}">{{item.selected ? '✓' : ''}}</view>
      <view class="muted">选择此订单</view>
    </view>
    <view class="interactive" data-id="{{item._id}}" bindtap="detail">
      <view class="between order-card-head">
        <view class="order-person">
          <image class="order-avatar" wx:if="{{item.clientSnapshot && item.clientSnapshot.avatarUrl}}" src="{{item.clientSnapshot.avatarUrl}}" mode="aspectFill" />
          <view class="order-avatar" wx:else>🐾</view>
          <view>
            <view class="strong">{{item.clientSnapshot.displayName || '宠物主'}} · {{item.orderNo}}</view>
            <view class="muted">{{item.petName}} · {{item.serviceSummary || (item.serviceType === 'walk' ? '上门遛狗' : '上门喂养')}}</view>
            <view class="muted">用户电话：{{item.clientContact.phone || item.clientSnapshot.phoneMasked || '未绑定'}}</view>
            <view class="muted">宠托师：{{item.staffContact.displayName || item.requestedStaffName || item.staffProfileId || '未接单'}}</view>
            <view class="muted">宠托师电话：{{item.staffContact.phone || '未绑定'}}</view>
            <view class="muted">创建：{{item.createdAtText || '-'}}</view>
            <view class="muted">预约：{{item.appointmentTimeText || '-'}}</view>
            <view class="muted" wx:if="{{item.publishMode === 'direct'}}">指定：{{item.requestedStaffName || '已指定宠护师'}}</view>
          </view>
        </view>
        <view>
          <view class="badge">{{item.publishMode === 'direct' ? '指定宠托师' : '公开发布'}}</view>
          <view class="badge">{{item.statusText}}</view>
        </view>
      </view>
    </view>
    <button class="mini-btn" wx:if="{{item.status === 'paid'}}" size="mini" data-id="{{item._id}}" bindtap="assign">派单</button>
  </view>

  <button class="ghost" wx:if="{{hasMore}}" loading="{{loading}}" disabled="{{loading}}" bindtap="loadMore">{{loading ? '加载中...' : '加载更多'}}</button>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon">⌂</view><view>控制台</view></view>
    <view class="nav-item active"><view class="nav-icon">☷</view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/admin/staff-audit/list/index" bindtap="go"><view class="nav-icon">☑</view><view>审核</view></view>
    <view class="nav-item" data-url="/pages/admin/incidents/list/index" bindtap="go"><view class="nav-icon">!</view><view>异常</view></view>
  </view>
</view>
