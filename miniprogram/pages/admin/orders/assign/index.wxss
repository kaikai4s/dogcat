@import "../list/index.wxss";

.assign-page {
  padding-bottom: 100rpx;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
}

.picker-main {
  flex: 1;
  min-width: 0;
}

.picker-field .value {
  margin-top: 8rpx;
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 900;
}

.picker-arrow {
  color: #b8aaa0;
  font-size: 42rpx;
}

.submit-btn {
  width: calc(100% - 56rpx);
  min-height: 88rpx;
  margin: 32rpx 28rpx 0;
  border-radius: 999rpx;
}
