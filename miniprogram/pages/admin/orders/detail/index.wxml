<view class="admin-order-page {{themeClass}} {{fontClass}}" wx:if="{{detail}}">
  <view class="admin-order-hero">
    <view class="hero-badge"><text class="remix-icon ri-file-text-fill"></text><text>订单详情</text></view>
    <view class="hero-title">{{detail.order.orderNo}}</view>
    <view class="hero-desc">汇总订单履约状态、轨迹、打卡、退款和门锁访问记录。</view>
  </view>

  <view class="admin-card person-card">
    <view class="card-subtitle"><text class="remix-icon ri-user-heart-line sub-icon"></text><text>客户信息</text></view>
    <view class="order-person">
      <view class="avatar-level-wrap">
        <image class="order-avatar" wx:if="{{detail.order.clientSnapshot && detail.order.clientSnapshot.avatarUrl}}" src="{{detail.order.clientSnapshot.avatarUrl}}" mode="aspectFill" />
        <view class="order-avatar placeholder" wx:else><text class="remix-icon ri-user-smile-line"></text></view>
        <view class="avatar-level-badge badge-{{detail.order.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{detail.order.clientSnapshot && (detail.order.clientSnapshot.badgeTag || detail.order.clientSnapshot.memberLevelName)}}">{{detail.order.clientSnapshot.badgeTag || detail.order.clientSnapshot.memberLevelName}}</view>
      </view>
      <view class="order-main">
        <view class="order-title">
          <text class="{{detail.order.clientSnapshot.nameEffect && detail.order.clientSnapshot.nameEffect !== 'none' ? 'name-effect-' + detail.order.clientSnapshot.nameEffect : ''}}" style="{{detail.order.clientSnapshot.nameColor ? 'color: ' + detail.order.clientSnapshot.nameColor + ';' : ''}}">{{detail.order.clientSnapshot.displayName || '宠物主'}}</text>
          <text class="member-badge badge-{{detail.order.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{detail.order.clientSnapshot && (detail.order.clientSnapshot.badgeTag || detail.order.clientSnapshot.memberLevelName)}}">{{detail.order.clientSnapshot.badgeTag || detail.order.clientSnapshot.memberLevelName}}</text>
        </view>
        <view class="order-desc">{{detail.order.clientContact.phone || detail.order.clientSnapshot.phoneMasked || '预约客户'}}</view>
      </view>
    </view>
  </view>

  <view class="admin-card detail-card">
    <view class="card-subtitle"><text class="remix-icon ri-information-line sub-icon"></text><text>订单资料</text></view>
    <view class="info-row"><view class="label">订单</view><view class="value">{{detail.order.orderNo}}</view></view>
    <view class="info-row"><view class="label">用户电话</view><view class="value">{{detail.order.clientContact.phone || '未绑定'}}</view></view>
    <view class="button-row"><button class="ghost-btn" bindtap="callClient"><text class="remix-icon ri-phone-line"></text><text>拨打用户电话</text></button><button class="ghost-btn" bindtap="copyOrderNo"><text class="remix-icon ri-file-copy-line"></text><text>复制订单号</text></button></view>
    <view class="info-row"><view class="label">服务</view><view class="value">{{detail.order.serviceSummary || (detail.order.serviceType === 'walk' ? '上门遛狗' : '上门喂养')}}</view></view>
    <view class="info-row" wx:if="{{detail.order.petSnapshot && detail.order.petSnapshot.beautyTitle && detail.order.petSnapshot.beautyTitle.title}}"><view class="label">宠物称号</view><view class="soft-badge">{{detail.order.petSnapshot.beautyTitle.title}}</view></view>
    <view class="info-row"><view class="label">发布方式</view><view class="value">{{detail.order.publishMode === 'direct' ? '指定宠托师' : '公开发布抢单'}}</view></view>
    <view class="info-row" wx:if="{{detail.order.publishMode === 'direct'}}"><view class="label">指定宠托师</view><view class="value">{{detail.order.requestedStaffName || '已指定宠托师'}}</view></view>
    <view class="info-row" wx:if="{{detail.order.staffOpenid}}"><view class="label">实际接单</view><view class="value">{{detail.order.staffContact.displayName || detail.order.staffProfileId || detail.order.staffOpenid}}</view></view>
    <view class="info-row" wx:if="{{detail.order.staffContact && detail.order.staffContact.phone}}"><view class="label">宠托师电话</view><view class="value">{{detail.order.staffContact.phone}}</view></view>
    <view class="button-row" wx:if="{{detail.order.staffContact && detail.order.staffContact.phone}}"><button class="ghost-btn" bindtap="callStaff"><text class="remix-icon ri-phone-line"></text><text>拨打宠托师电话</text></button></view>

    <!-- 原接单宠托师留证信息展示 -->
    <block wx:if="{{detail.order.originalStaffOpenid || (detail.order.previousStaffRecords && detail.order.previousStaffRecords.length)}}">
      <view class="info-row warning-row">
        <view class="label">原接单宠托师</view>
        <view class="value danger-text">{{detail.order.originalStaffName || detail.order.originalStaffOpenid}}（已转加急派单）</view>
      </view>
      <view class="info-row" wx:if="{{detail.order.originalStaffContact && detail.order.originalStaffContact.phone}}">
        <view class="label">原宠托师电话</view>
        <view class="value">{{detail.order.originalStaffContact.phone}}</view>
      </view>
      <view class="button-row" wx:if="{{detail.order.originalStaffContact && detail.order.originalStaffContact.phone}}">
        <button class="ghost-btn danger-ghost" bindtap="callOriginalStaff"><text class="remix-icon ri-phone-line"></text><text>拨打原宠托师电话</text></button>
      </view>
    </block>

    <view class="info-row" wx:if="{{detail.order.assignmentSource}}"><view class="label">派单来源</view><view class="value">{{detail.order.assignmentSourceText}}</view></view>
    <view class="info-row"><view class="label">地址</view><view class="value">{{detail.order.serviceAddress}}</view></view>
    <view class="info-row" wx:if="{{detail.order.addressDetail}}"><view class="label">详细地址</view><view class="value">{{detail.order.addressDetail}}</view></view>
    <view class="info-row"><view class="label">状态</view><view class="soft-badge status-badge">{{detail.order.statusText}}</view></view>
    <view class="info-row" wx:if="{{detail.order.autoCompleted}}"><view class="label">完单方式</view><view class="soft-badge auto-badge"><text class="remix-icon ri-sparkling-fill"></text><text>系统超时智能结算</text></view></view>
    <view class="info-row" wx:if="{{detail.order.isOverdue || detail.order.isStartOverdue || detail.order.isFinishOverdue}}"><view class="label">超时预警</view><view class="soft-badge overdue-badge"><text class="remix-icon ri-alarm-warning-line"></text><text>存在超时履约</text></view></view>
    <view class="info-row" wx:if="{{detail.order.isUrgent}}"><view class="label">加急公共单</view><view class="soft-badge urgent-badge"><text class="remix-icon ri-flashlight-fill"></text><text>加急调度 · 宠托师收益 ¥{{detail.order.urgentStaffReward}}</text></view></view>
    <view class="info-row" wx:if="{{detail.order.hasDepositPenaltyEvidence}}"><view class="label">保证金证据</view><view class="soft-badge danger-badge"><text class="remix-icon ri-shield-cross-fill"></text><text>已加入违规留证</text></view></view>
    <view class="info-row"><view class="label">支付状态</view><view class="value">{{detail.order.paymentStatusText}}</view></view>
    <view class="info-row" wx:if="{{detail.order.paymentNo}}"><view class="label">支付单号</view><view class="value">{{detail.order.paymentNo}}</view></view>
    <view class="info-row" wx:if="{{detail.order.wxTransactionId}}"><view class="label">微信交易号</view><view class="value">{{detail.order.wxTransactionId}}</view></view>
    <view class="info-row" wx:if="{{detail.order.paidAt}}"><view class="label">支付时间</view><view class="value">{{detail.order.paidAt}}</view></view>
    <view class="info-row"><view class="label">接单微信通知</view><view class="value">{{detail.order.acceptedNotifyStatusText}}</view></view>
    <view class="info-row"><view class="label">接单通知失败</view><view class="value">{{detail.order.acceptedNotifyErrorText}}</view></view>
    <view class="info-row" wx:if="{{detail.order.refundStatus}}"><view class="label">退款状态</view><view class="value">{{detail.order.refundStatusText || '已退款'}} ¥{{detail.order.refundAmount || 0}}</view></view>
    <view class="info-row" wx:if="{{detail.order.refundNo}}"><view class="label">退款单号</view><view class="value">{{detail.order.refundNo}}</view></view>
  </view>

  <view class="stats-grid admin-card">
    <view class="stat-item"><view class="stat-number">{{detail.tracks.length}}</view><view class="stat-label">轨迹点</view></view>
    <view class="stat-item"><view class="stat-number">{{detail.checkins.length}}</view><view class="stat-label">打卡</view></view>
    <view class="stat-item"><view class="stat-number">{{detail.unlockLogs.length}}</view><view class="stat-label">密码日志</view></view>
  </view>

  <!-- 保证金扣除留证记录卡片 -->
  <view class="admin-card" wx:if="{{detail.order.depositPenaltyEvidences && detail.order.depositPenaltyEvidences.length}}">
    <view class="card-subtitle"><text class="remix-icon ri-shield-cross-fill sub-icon danger-icon"></text><text>保证金扣除留证 ({{detail.order.depositPenaltyEvidences.length}}笔)</text></view>
    <view class="timeline">
      <view class="timeline-item" wx:for="{{detail.order.depositPenaltyEvidences}}" wx:key="_id">
        <view class="timeline-dot danger-dot"></view>
        <view class="timeline-content">
          <view class="between">
            <view class="strong danger-text">{{item.reasonTypeName}}</view>
            <view class="soft-badge {{item.status === 'forfeited' ? 'status-badge' : 'danger-badge'}}">{{item.status === 'forfeited' ? '已扣除保证金' : '待执行扣除'}}</view>
          </view>
          <view class="muted" style="margin-top: 4rpx;">责任人：{{item.staffRealName || item.staffOpenid}} · {{item.staffPhone || '无电话'}}</view>
          <view class="strong small" style="margin-top: 4rpx; color: #ef4444;" wx:if="{{item.deductAmount > 0}}">建议扣除：¥{{item.deductAmount}}</view>
          <view class="desc-box" style="margin-top: 6rpx; background: #fff5f5; padding: 12rpx; border-radius: 8rpx; font-size: 24rpx; color: #4b5563;">{{item.reasonText}}</view>
          <view class="muted small" style="margin-top: 6rpx;">{{item.createdAt}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="admin-card" wx:if="{{refunds.length}}">
    <view class="card-subtitle"><text class="remix-icon ri-refund-2-line sub-icon"></text><text>退款记录</text></view>
    <view class="timeline">
      <view class="timeline-item" wx:for="{{refunds}}" wx:key="_id">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="strong">{{item.refundNo}} · ¥{{item.refundAmount}}</view>
          <view class="muted">{{item.statusText || '已记录'}} · {{item.reason}}</view>
          <view class="muted">{{item.createdAt}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-actions">
    <button class="ghost-btn" bindtap="openStatusModal"><text class="remix-icon ri-edit-box-line"></text><text>修改状态</text></button>
    <button class="ghost-btn refund-btn" bindtap="openRefundModal" wx:if="{{detail.order.payAmount > 0}}"><text class="remix-icon ri-refund-2-line"></text><text>手动退款</text></button>
    <button class="primary-btn urgent-btn" bindtap="openUrgentModal" wx:if="{{detail.order.status === 'assigned' || detail.order.status === 'in_service' || detail.order.isStartOverdue || detail.order.isUrgent || detail.order.status === 'paid'}}"><text class="remix-icon ri-flashlight-fill"></text><text>转加急公共抢单</text></button>
    <button class="ghost-btn penalty-btn" bindtap="openEvidenceModal"><text class="remix-icon ri-shield-cross-line"></text><text>扣除保证金留证</text></button>
    <button class="ghost-btn" bindtap="evidence"><text class="remix-icon ri-shield-check-line"></text><text>证据链</text></button>
    <button class="ghost-btn" bindtap="incidents"><text class="remix-icon ri-customer-service-2-line"></text><text>查看异常 / 纠纷</text></button>
  </view>

  <!-- 修改状态弹窗 -->
  <view class="modal-mask" wx:if="{{showStatusModal}}">
    <view class="modal-card">
      <view class="modal-title">修改服务订单状态</view>
      <view class="modal-summary">
        <view class="strong small">{{detail.order.orderNo}}</view>
        <view class="muted">当前状态：{{detail.order.statusText}}</view>
      </view>
      <view class="form-section">
        <view class="form-label">目标状态</view>
        <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{selectedStatusIndex}}" bindchange="onStatusPickerChange">
          <view class="picker-line">
            <text>{{statusOptions[selectedStatusIndex].label}}</text>
            <text class="remix-icon ri-arrow-down-s-line"></text>
          </view>
        </picker>
        <view class="form-label">操作说明 / 变更原因</view>
        <textarea placeholder="请填写修改状态的原因或备注（必填，存入时间线与审计日志）" value="{{statusRemark}}" bindinput="inputStatusRemark" />
      </view>
      <view class="modal-actions">
        <button class="ghost-btn" bindtap="closeStatusModal">取消</button>
        <button class="primary-btn" loading="{{submittingStatus}}" disabled="{{submittingStatus}}" bindtap="submitUpdateStatus">确认修改</button>
      </view>
    </view>
  </view>

  <!-- 手动退款弹窗 -->
  <view class="modal-mask" wx:if="{{showRefundModal}}">
    <view class="modal-card">
      <view class="modal-title">手动处理退款</view>
      <view class="modal-summary">
        <view class="strong small">{{detail.order.orderNo}}</view>
        <view class="muted">实付金额：¥{{detail.order.payAmount || 0}} · 已退金额：¥{{detail.order.alreadyRefunded || 0}}</view>
        <view class="highlight-text">最多可退金额：¥{{detail.order.maxRefundable || 0}}</view>
      </view>
      <view class="form-section">
        <view class="form-label-row">
          <text class="form-label">退款金额 (元)</text>
          <text class="quick-link" bindtap="setFullRefund">全额退款 (¥{{detail.order.maxRefundable || 0}})</text>
        </view>
        <input type="digit" placeholder="请输入退款金额" value="{{refundAmountInput}}" bindinput="inputRefundAmount" />
        <view class="form-label">退款说明</view>
        <input placeholder="请填写退款原因或说明（必填）" value="{{refundReasonInput}}" bindinput="inputRefundReason" />
      </view>
      <view class="modal-actions">
        <button class="ghost-btn" bindtap="closeRefundModal">取消</button>
        <button class="primary-btn danger-btn" loading="{{submittingRefund}}" disabled="{{submittingRefund}}" bindtap="submitRefund">确认退款</button>
      </view>
    </view>
  </view>

  <!-- 转加急公共抢单弹窗 -->
  <view class="modal-mask" wx:if="{{showUrgentModal}}">
    <view class="modal-card">
      <view class="modal-title"><text class="remix-icon ri-flashlight-fill" style="color: #ea580c; margin-right: 8rpx;"></text>转为加急公共抢单</view>
      <view class="modal-summary">
        <view class="strong small">{{detail.order.orderNo}} · {{detail.order.serviceSummary}}</view>
        <view class="muted">客户支付：¥{{detail.order.payAmount}}（保持不变，无需客户补款）</view>
      </view>
      <view class="form-section">
        <view class="form-label">宠托师可获收益 (加价补贴)</view>
        <input type="digit" placeholder="输入宠托师收益（例如 80）" value="{{urgentStaffRewardInput}}" bindinput="inputUrgentReward" />
        <view class="muted" style="font-size: 22rpx; margin-top: 6rpx; color: #ea580c;">* 平台加价补贴，激励宠托师加急抢单。客户支付金额不受影响。</view>

        <view class="form-label" style="margin-top: 18rpx;">服务开始时间</view>
        <input placeholder="YYYY-MM-DD HH:mm" value="{{urgentStartTimeInput}}" bindinput="inputUrgentStartTime" />

        <view class="form-label" style="margin-top: 18rpx;">服务结束时间</view>
        <input placeholder="YYYY-MM-DD HH:mm" value="{{urgentEndTimeInput}}" bindinput="inputUrgentEndTime" />

        <view class="form-label" style="margin-top: 18rpx;">加急备注（抢单卡片展示）</view>
        <textarea placeholder="例如：原宠托师无法履约，已延后服务时间，请尽快接单并前往" value="{{urgentRemarkInput}}" bindinput="inputUrgentRemark" />
      </view>
      <view class="modal-actions">
        <button class="ghost-btn" bindtap="closeUrgentModal">取消</button>
        <button class="primary-btn" style="background: linear-gradient(135deg, #ff7849, #ea580c);" loading="{{submittingUrgent}}" disabled="{{submittingUrgent}}" bindtap="submitUrgentRepublish">发布加急单</button>
      </view>
    </view>
  </view>

  <!-- 录入扣除保证金证据弹窗 -->
  <view class="modal-mask" wx:if="{{showEvidenceModal}}">
    <view class="modal-card">
      <view class="modal-title"><text class="remix-icon ri-shield-cross-fill" style="color: #ef4444; margin-right: 8rpx;"></text>录入保证金扣除证据</view>
      <view class="modal-summary">
        <view class="strong small">{{detail.order.orderNo}}</view>
        <view class="muted">留证将同步记录到该宠托师异常档案，在宠托师管理及财务扣除保证金时直观显示证据链。</view>
      </view>
      <view class="form-section">
        <view class="form-label">责任宠托师</view>
        <picker mode="selector" range="{{evidenceStaffList}}" range-key="label" value="{{selectedStaffIndex}}" bindchange="onEvidenceStaffChange">
          <view class="picker-line">
            <text>{{evidenceStaffList[selectedStaffIndex].label}}</text>
            <text class="remix-icon ri-arrow-down-s-line"></text>
          </view>
        </picker>

        <view class="form-label" style="margin-top: 18rpx;">违规类型</view>
        <picker mode="selector" range="{{evidenceReasonTypes}}" range-key="label" value="{{selectedReasonTypeIndex}}" bindchange="onEvidenceReasonTypeChange">
          <view class="picker-line">
            <text>{{evidenceReasonTypes[selectedReasonTypeIndex].label}}</text>
            <text class="remix-icon ri-arrow-down-s-line"></text>
          </view>
        </picker>

        <view class="form-label" style="margin-top: 18rpx;">建议扣除保证金金额 (元)</view>
        <input type="digit" placeholder="建议扣除金额，例如：50" value="{{evidenceDeductAmountInput}}" bindinput="inputEvidenceDeductAmount" />

        <view class="form-label" style="margin-top: 18rpx;">违规事实留证说明 (必填)</view>
        <textarea placeholder="请填写违规细节（如：接单超时30分钟未到岗且失联、导致订单改派加急并由平台补贴费用）" value="{{evidenceReasonTextInput}}" bindinput="inputEvidenceReasonText" />

        <view class="form-label" style="margin-top: 18rpx;">留证凭证截图 (可选，最多4张)</view>
        <view class="image-uploader-grid" style="display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 8rpx;">
          <view class="image-thumb" wx:for="{{evidenceImages}}" wx:key="*this" style="position: relative; width: 120rpx; height: 120rpx;">
            <image src="{{item}}" mode="aspectFill" style="width: 100%; height: 100%; border-radius: 8rpx;" data-url="{{item}}" bindtap="previewEvidenceImage" />
            <view class="remove-btn" data-index="{{index}}" bindtap="removeEvidenceImage" style="position: absolute; top: -10rpx; right: -10rpx; background: rgba(0,0,0,0.6); color: #fff; width: 36rpx; height: 36rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24rpx;">×</view>
          </view>
          <view class="add-thumb-btn" bindtap="chooseEvidenceImages" wx:if="{{evidenceImages.length < 4}}" style="width: 120rpx; height: 120rpx; border: 2rpx dashed #d1d5db; border-radius: 8rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #9ca3af;">
            <text class="remix-icon ri-camera-line" style="font-size: 36rpx;"></text>
            <text style="font-size: 20rpx; margin-top: 4rpx;">加凭证</text>
          </view>
        </view>
      </view>
      <view class="modal-actions">
        <button class="ghost-btn" bindtap="closeEvidenceModal">取消</button>
        <button class="danger-btn" loading="{{submittingEvidence}}" disabled="{{submittingEvidence}}" bindtap="submitDepositEvidence">确认录入留证</button>
      </view>
    </view>
  </view>
</view>
