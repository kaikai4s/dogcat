@import "../list/index.wxss";

.person-card,
.detail-card {
  margin-top: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 72rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.1);
}

.info-row:last-child { border-bottom: none; }

.info-row .value {
  flex: 1;
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.4;
  text-align: right;
  word-break: break-all;
}

.button-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin: 12rpx 0 18rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.stat-item {
  padding: 20rpx 12rpx;
  border-radius: 24rpx;
  background: #fff8ec;
  text-align: center;
}

.stat-number {
  color: #e9672f;
  font-size: 34rpx;
  font-weight: 950;
}

.stat-label {
  margin-top: 6rpx;
  color: #8e8580;
  font-size: 22rpx;
}

.timeline {
  padding-left: 18rpx;
  border-left: 2rpx solid rgba(255, 153, 102, 0.18);
}

.timeline-item {
  position: relative;
  padding: 0 0 22rpx 18rpx;
}

.timeline-item:last-child { padding-bottom: 0; }

.timeline-dot {
  position: absolute;
  left: -27rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e9672f;
  border: 5rpx solid #fff0e2;
}

.timeline-content {
  padding: 18rpx;
  border-radius: 24rpx;
  background: #fff8ec;
}

.bottom-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.bottom-actions .refund-btn {
  color: #ea580c;
  background: #fff3eb;
}

/* Modal styles for status & refund operations */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  background: rgba(45, 33, 26, 0.46);
  backdrop-filter: blur(4rpx);
}

.modal-card {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  padding: 34rpx 28rpx 50rpx;
  border-top-left-radius: 38rpx;
  border-top-right-radius: 38rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 950;
  color: #2d211a;
  margin-bottom: 16rpx;
}

.modal-summary {
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #fff8ec;
  margin-bottom: 20rpx;
}

.highlight-text {
  margin-top: 8rpx;
  color: #e9672f;
  font-size: 25rpx;
  font-weight: 900;
}

.form-section {
  padding: 20rpx;
  border-radius: 26rpx;
  background: #fffaf4;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
}

.form-label {
  margin: 14rpx 0 8rpx;
  color: #7a6a5e;
  font-size: 23rpx;
  font-weight: 850;
}

.form-section .form-label:first-child {
  margin-top: 0;
}

.form-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quick-link {
  color: #e9672f;
  font-size: 23rpx;
  font-weight: 850;
  text-decoration: underline;
}

.modal-card input,
.modal-card textarea,
.picker-line {
  width: 100%;
  min-height: 72rpx;
  margin-top: 10rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.18);
  font-size: 25rpx;
  box-sizing: border-box;
}

.picker-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  line-height: 72rpx;
  color: #2d211a;
  font-weight: 850;
}

.picker-line .remix-icon {
  color: #8e8580;
  font-size: 32rpx;
}

.modal-card textarea {
  height: 160rpx;
  padding-top: 16rpx;
  line-height: 1.4;
}

.modal-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.urgent-badge {
  background: #fff0eb;
  color: #ea580c;
  border: 1rpx solid rgba(234, 88, 12, 0.2);
  font-weight: 850;
}

.urgent-action-btn {
  background: linear-gradient(135deg, #ff7849, #ea580c);
  color: #ffffff;
  font-weight: 850;
  box-shadow: 0 8rpx 20rpx rgba(234, 88, 12, 0.25);
}

.danger-dot {
  background: #ef4444 !important;
}

.danger-icon, .danger-text {
  color: #ef4444 !important;
}

.danger-badge {
  background: #fef2f2 !important;
  color: #ef4444 !important;
  border: 1rpx solid rgba(239, 68, 68, 0.2) !important;
  font-weight: 850;
}

.danger-ghost {
  border-color: rgba(239, 68, 68, 0.3) !important;
  color: #ef4444 !important;
}

.penalty-btn {
  border-color: rgba(239, 68, 68, 0.35) !important;
  color: #dc2626 !important;
  background: #fff5f5 !important;
}

.danger-btn {
  background: linear-gradient(135deg, #f87171, #ef4444);
  color: #ffffff;
  font-weight: 850;
  border-radius: 999rpx;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  box-shadow: 0 8rpx 20rpx rgba(239, 68, 68, 0.25);
}

/* 宠客即时沟通记录与防跳单风控卡片及弹窗样式 */
.chat-record-card {
  margin-top: 24rpx;
}

.card-subtitle-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.action-links {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-link {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #7a6a5e;
}

.action-link.highlight {
  color: #e9672f;
  font-weight: 850;
}

.risk-bypass-alert-banner {
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  border-radius: 18rpx;
  padding: 20rpx;
  margin: 16rpx 0;
}

.risk-alert-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-weight: 900;
  font-size: 25rpx;
  color: #dc2626;
  margin-bottom: 12rpx;
}

.risk-log-item {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #fee2e2;
  box-shadow: 0 2rpx 8rpx rgba(220, 38, 38, 0.05);
}

.risk-log-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.risk-role-badge {
  font-size: 20rpx;
  font-weight: 850;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.risk-role-badge.staff-badge {
  background: #dbeafe;
  color: #1d4ed8;
}

.risk-role-badge.client-badge {
  background: #fef3c7;
  color: #b45309;
}

.risk-time {
  font-size: 20rpx;
  color: #9ca3af;
}

.risk-tag {
  font-size: 20rpx;
  color: #dc2626;
  background: #fee2e2;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  font-weight: 850;
}

.risk-reason-text {
  font-size: 22rpx;
  color: #b91c1c;
  margin-bottom: 6rpx;
  font-weight: 700;
}

.risk-blocked-content {
  font-size: 23rpx;
  color: #374151;
  word-break: break-all;
  background: #f9fafb;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #ef4444;
}

.risk-action-tip {
  font-size: 21rpx;
  color: #991b1b;
  margin-top: 8rpx;
  line-height: 1.4;
}

.chat-message-list {
  max-height: 480rpx;
  overflow-y: auto;
  padding: 12rpx 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.chat-message-list-full {
  max-height: 52vh;
  overflow-y: auto;
  padding: 12rpx 4rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.chat-item {
  display: flex;
  flex-direction: column;
  max-width: 82%;
}

.chat-item.staff-item {
  align-self: flex-start;
}

.chat-item.client-item {
  align-self: flex-end;
}

.chat-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 6rpx;
}

.chat-item.staff-item .chat-meta {
  flex-direction: row;
}

.chat-item.client-item .chat-meta {
  flex-direction: row-reverse;
}

.chat-role {
  font-size: 21rpx;
  font-weight: 850;
  color: #6b7280;
}

.chat-time {
  font-size: 20rpx;
  color: #9ca3af;
}

.chat-content-bubble {
  font-size: 25rpx;
  line-height: 1.45;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  word-break: break-all;
}

.chat-item.staff-item .chat-content-bubble {
  background: #f3f4f6;
  color: #1f2937;
  border-top-left-radius: 4rpx;
  border: 1rpx solid #e5e7eb;
}

.chat-item.client-item .chat-content-bubble {
  background: linear-gradient(135deg, #ff7849, #ea580c);
  color: #ffffff;
  border-top-right-radius: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(234, 88, 12, 0.2);
}

.empty-chat-tip {
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  padding: 36rpx 0;
}

.modal-card-large {
  max-height: 85vh;
}

.modal-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.close-icon-btn {
  font-size: 32rpx;
  color: #9ca3af;
  padding: 8rpx 16rpx;
  cursor: pointer;
}

/* 加急时间组件与快捷标签样式 */
.picker-group-row {
  display: flex;
  gap: 14rpx;
  margin-top: 10rpx;
}

.picker-group-row picker {
  flex: 1;
}

.picker-item-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.25);
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 850;
  color: #2d211a;
  box-sizing: border-box;
}

.picker-item-box .picker-ico {
  color: #ea580c;
  font-size: 28rpx;
  margin-right: 8rpx;
}

.picker-item-box .picker-val {
  flex: 1;
  text-align: center;
}

.picker-item-box .picker-arr {
  color: #9ca3af;
  font-size: 28rpx;
  margin-left: 8rpx;
}

.quick-tags {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.quick-tag {
  font-size: 20rpx;
  color: #ea580c;
  background: #fff0eb;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 700;
  cursor: pointer;
}

.small-tip {
  font-size: 22rpx;
  margin-top: 8rpx;
  color: #ea580c;
  line-height: 1.3;
}


