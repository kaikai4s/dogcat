@import "../list/index.wxss";

.person-card,
.detail-card {
  margin-top: 24rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 72rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.1);
}

.info-row:last-child { border-bottom: none; }

.info-row .value {
  flex: 1;
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 850;
  line-height: 1.4;
  text-align: right;
  word-break: break-all;
}

.button-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin: 12rpx 0 18rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.stat-item {
  padding: 20rpx 12rpx;
  border-radius: 24rpx;
  background: #fff8ec;
  text-align: center;
}

.stat-number {
  color: #e9672f;
  font-size: 34rpx;
  font-weight: 950;
}

.stat-label {
  margin-top: 6rpx;
  color: #8e8580;
  font-size: 22rpx;
}

.timeline {
  padding-left: 18rpx;
  border-left: 2rpx solid rgba(255, 153, 102, 0.18);
}

.timeline-item {
  position: relative;
  padding: 0 0 22rpx 18rpx;
}

.timeline-item:last-child { padding-bottom: 0; }

.timeline-dot {
  position: absolute;
  left: -27rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e9672f;
  border: 5rpx solid #fff0e2;
}

.timeline-content {
  padding: 18rpx;
  border-radius: 24rpx;
  background: #fff8ec;
}

.bottom-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}
