.admin-notice-page {
  min-height: 100vh;
  padding: 0 28rpx 80rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.admin-notice-hero {
  margin: 0 -28rpx 24rpx;
  padding: 40rpx 32rpx 36rpx;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 16rpx 40rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 12rpx;
}

.hero-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.hero-title {
  color: #2d211a;
  font-size: 38rpx;
  font-weight: 950;
}

.hero-desc {
  margin-top: 8rpx;
  color: #7a6a5e;
  font-size: 24rpx;
}

.mark-read-btn {
  padding: 10rpx 22rpx !important;
  font-size: 23rpx !important;
  border-radius: 999rpx !important;
  background: rgba(255, 255, 255, 0.9) !important;
  color: #d45f22 !important;
  font-weight: 850 !important;
  border: 1rpx solid rgba(212, 95, 34, 0.2) !important;
  line-height: 1.4 !important;
}

.tabs-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 850;
  color: #7a6a5e;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #fff0e2;
  color: #d45f22;
}

.tab-badge {
  background: #ff4d4f;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.urgent-tab {
  color: #ea580c;
}

.urgent-tab.active {
  background: #fff2e8;
  color: #d4380d;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notice-card {
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.16);
  box-shadow: 0 8rpx 24rpx rgba(123, 89, 62, 0.05);
  position: relative;
  transition: all 0.2s ease;
}

.notice-card.urgent-card {
  border-color: #ff7a45;
  background: linear-gradient(180deg, #fffaf6 0%, #ffffff 100%);
  box-shadow: 0 10rpx 30rpx rgba(255, 122, 69, 0.1);
}

.card-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.level-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 900;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.level-badge.urgent {
  background: #fff1f0;
  color: #f5222d;
  border: 1rpx solid rgba(245, 34, 45, 0.2);
}

.level-badge.warning {
  background: #fffbe6;
  color: #fa8c16;
  border: 1rpx solid rgba(250, 140, 22, 0.2);
}

.level-badge.info {
  background: #e6f7ff;
  color: #1890ff;
}

.time-read-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.notice-time {
  font-size: 22rpx;
  color: #8e8580;
}

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 950;
  color: #2d211a;
  line-height: 1.35;
}

.notice-content {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #6b5b50;
  line-height: 1.55;
}

.notice-footer {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(255, 153, 102, 0.18);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
}

.footer-action-text {
  font-size: 24rpx;
  font-weight: 900;
  color: #ea580c;
}

.footer-arrow {
  color: #ea580c;
  font-size: 26rpx;
}

.empty-state {
  min-height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40rpx;
}

.empty-icon {
  font-size: 96rpx;
  color: #ea580c;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 950;
  color: #2d211a;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8e8580;
}

.list-state {
  text-align: center;
  padding: 24rpx 0;
  color: #8e8580;
  font-size: 24rpx;
}
