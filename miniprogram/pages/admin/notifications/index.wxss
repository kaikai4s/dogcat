.admin-notice-page {
  min-height: 100vh;
  padding: 0 28rpx 80rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.admin-notice-hero {
  margin: 0 -28rpx 24rpx;
  padding: 40rpx 32rpx 36rpx;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 16rpx 40rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 12rpx;
}

.hero-main {
  margin-bottom: 22rpx;
}

.hero-title {
  color: #2d211a;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.3;
}

.hero-desc {
  margin-top: 8rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.mark-read-btn {
  margin: 0 !important;
  padding: 12rpx 24rpx !important;
  font-size: 24rpx !important;
  border-radius: 999rpx !important;
  background: rgba(255, 255, 255, 0.9) !important;
  color: #d45f22 !important;
  font-weight: 850 !important;
  border: 1rpx solid rgba(212, 95, 34, 0.2) !important;
  line-height: 1.4 !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.tabs-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 850;
  color: #7a6a5e;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #fff0e2;
  color: #d45f22;
}

.tab-badge {
  background: #ff4d4f;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.urgent-tab {
  color: #ea580c;
}

.urgent-tab.active {
  background: #fff2e8;
  color: #d4380d;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.notice-card {
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.16);
  box-shadow: 0 8rpx 24rpx rgba(123, 89, 62, 0.05);
  position: relative;
  transition: all 0.2s ease;
}

.notice-card.urgent-card {
  border-color: #ff7a45;
  background: linear-gradient(180deg, #fffaf6 0%, #ffffff 100%);
  box-shadow: 0 10rpx 30rpx rgba(255, 122, 69, 0.1);
}

.card-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.level-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 900;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.level-badge.urgent {
  background: #fff1f0;
  color: #f5222d;
  border: 1rpx solid rgba(245, 34, 45, 0.2);
}

.level-badge.warning {
  background: #fffbe6;
  color: #fa8c16;
  border: 1rpx solid rgba(250, 140, 22, 0.2);
}

.level-badge.info {
  background: #e6f7ff;
  color: #1890ff;
}

.time-read-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.notice-time {
  font-size: 22rpx;
  color: #8e8580;
}

.unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff4d4f;
}

.notice-title {
  font-size: 30rpx;
  font-weight: 950;
  color: #2d211a;
  line-height: 1.35;
}

.notice-content {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #6b5b50;
  line-height: 1.55;
}

.notice-footer {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(255, 153, 102, 0.18);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
}

.footer-action-text {
  font-size: 24rpx;
  font-weight: 900;
  color: #ea580c;
}

.footer-arrow {
  color: #ea580c;
  font-size: 26rpx;
}

.empty-state {
  min-height: 380rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40rpx;
}

.empty-icon {
  font-size: 96rpx;
  color: #ea580c;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 950;
  color: #2d211a;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8e8580;
}

.list-state {
  text-align: center;
  padding: 24rpx 0;
  color: #8e8580;
  font-size: 24rpx;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.send-notice-btn {
  margin: 0 !important;
  padding: 12rpx 28rpx !important;
  font-size: 24rpx !important;
  border-radius: 999rpx !important;
  background: linear-gradient(135deg, #ff7a18 0%, #ea580c 100%) !important;
  color: #ffffff !important;
  font-weight: 850 !important;
  line-height: 1.4 !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 6rpx !important;
  box-shadow: 0 6rpx 18rpx rgba(234, 88, 12, 0.25) !important;
}

.broadcast-tab {
  color: #0284c7;
}

.badge-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.target-badge {
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #0369a1;
}

.target-badge.target-client {
  background: #fef3c7;
  color: #b45309;
}

.target-badge.target-staff {
  background: #ede9fe;
  color: #6d28d9;
}

.type-badge {
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
}

.type-badge.type-notice {
  background: #fee2e2;
  color: #b91c1c;
}

.type-badge.type-activity {
  background: #dcfce7;
  color: #15803d;
}

.level-badge-sm.urgent {
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
}

.status-tag {
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #16a34a;
  background: rgba(22, 163, 74, 0.1);
}

.status-tag.status-revoked {
  color: #94a3b8;
  background: rgba(148, 163, 184, 0.15);
}

.broadcast-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.broadcast-card.revoked {
  opacity: 0.65;
}

.broadcast-title {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 900;
  color: #1e293b;
  line-height: 1.4;
}

.broadcast-content {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
  white-space: pre-wrap;
}

.broadcast-link {
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #0284c7;
  word-break: break-all;
}

.broadcast-bottom {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sender-info {
  font-size: 22rpx;
  color: #94a3b8;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.revoke-btn {
  padding: 6rpx 18rpx !important;
  font-size: 22rpx !important;
  border-radius: 999rpx !important;
  background: #fff1f2 !important;
  color: #e11d48 !important;
  font-weight: 800 !important;
  line-height: 1.4 !important;
  border: 1rpx solid rgba(225, 29, 72, 0.2) !important;
}

/* 弹窗通用样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-panel.send-notice-modal {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  padding: 32rpx 32rpx env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  animation: slide-up 0.25s ease-out;
}

@keyframes slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #1e293b;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.title-icon {
  color: #ea580c;
}

.modal-close {
  padding: 8rpx;
  font-size: 36rpx;
  color: #94a3b8;
}

.modal-body {
  flex: 1;
  max-height: 58vh;
  padding: 20rpx 0;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 850;
  color: #334155;
  margin-bottom: 12rpx;
}

.form-label .required {
  color: #ef4444;
}

.form-label .optional {
  font-weight: normal;
  color: #94a3b8;
  font-size: 22rpx;
}

.chip-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip-item {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 800;
  border: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  transition: all 0.2s;
}

.chip-item.active {
  background: #fff0e2;
  color: #d45f22;
  border-color: #ffd9c8;
}

.chip-item.urgent-chip.active {
  background: #fef2f2;
  color: #dc2626;
  border-color: #fecaca;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  color: #1e293b;
}

.form-textarea {
  width: 100%;
  height: 180rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  color: #1e293b;
  line-height: 1.5;
}

.modal-footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.modal-footer button {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mt-20 {
  margin-top: 20rpx;
}
