<view class="{{themeClass}} {{fontClass}} page dashboard-page admin-home-page">
  <view class="dashboard-header">
    <view class="badge">管理端</view>
    <view class="title">运营控制台</view>
    <view class="tip">按业务域查看订单、人员、营销和平台配置，快速定位运营动作。</view>
  </view>

  <view class="stats-grid admin-stats-grid" wx:if="{{dashboard}}">
    <view class="stat-card" wx:for="{{overviewStats}}" wx:key="label">
      <view class="stat-number">{{item.value}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <view class="card chart-card" wx:if="{{dashboard && dashboard.monthly}}">
    <view class="between chart-head">
      <view>
        <view class="strong">本月趋势</view>
        <view class="muted">{{dashboard.monthly.monthKey}} 订单与新注册用户</view>
      </view>
      <view class="chart-total">
        <view>订单 {{dashboard.monthly.totals.orders || 0}}</view>
        <view>新用户 {{dashboard.monthly.totals.registrations || 0}}</view>
      </view>
    </view>
    <view class="chart-legend">
      <view class="legend-item"><view class="legend-dot order-dot"></view><view>订单</view></view>
      <view class="legend-item"><view class="legend-dot registration-dot"></view><view>新注册</view></view>
    </view>
    <scroll-view class="chart-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="monthly-chart">
        <view class="chart-day" wx:for="{{dashboard.monthly.days}}" wx:key="day">
          <view class="value-row">
            <view class="value-pill order-value" wx:if="{{item.orders}}">{{item.orders}}</view>
            <view class="value-pill registration-value" wx:if="{{item.registrations}}">{{item.registrations}}</view>
          </view>
          <view class="bar-box">
            <view class="bar-col">
              <view class="bar order-bar" style="height: {{item.orderHeight}}%;"></view>
            </view>
            <view class="bar-col">
              <view class="bar registration-bar" style="height: {{item.registrationHeight}}%;"></view>
            </view>
          </view>
          <view class="chart-label">{{item.day}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="card revenue-card" wx:if="{{dashboard && dashboard.monthly}}">
    <view class="between revenue-head">
      <view>
        <view class="strong">收入分析</view>
        <view class="muted">按支付金额统计本月收入表现</view>
      </view>
      <view class="revenue-badge">{{dashboard.monthly.monthKey}}</view>
    </view>
    <view class="revenue-grid">
      <view class="revenue-stat {{item.highlight ? 'highlight' : ''}}" wx:for="{{revenueStats}}" wx:key="label">
        <view class="revenue-number">{{item.value}}</view>
        <view class="revenue-label">{{item.label}}</view>
      </view>
    </view>
    <scroll-view class="revenue-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="revenue-chart">
        <view class="revenue-day" wx:for="{{dashboard.monthly.days}}" wx:key="day">
          <view class="revenue-value" wx:if="{{item.revenue}}">{{item.revenueText}}</view>
          <view class="revenue-bar-box">
            <view class="revenue-bar" style="height: {{item.revenueHeight}}%;"></view>
          </view>
          <view class="chart-label">{{item.day}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="admin-section" wx:for="{{adminSections}}" wx:key="title">
    <view class="section-head">
      <view>
        <view class="subtitle section-title">{{item.title}}</view>
        <view class="muted">{{item.desc}}</view>
      </view>
    </view>
    <view class="grid section-grid">
      <view class="card interactive action-card admin-action-card" wx:for="{{item.items}}" wx:for-item="entry" wx:key="title" data-url="{{entry.url}}" bindtap="go">
        <view class="action-icon remix-icon {{entry.icon}}"></view>
        <view class="action-title">{{entry.title}}</view>
        <view class="action-desc">{{entry.desc}}</view>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item active"><view class="nav-icon remix-icon ri-dashboard-3-fill"></view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/orders/list/index" bindtap="go"><view class="nav-icon remix-icon ri-file-list-3-line"></view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/admin/staff-audit/list/index" bindtap="go"><view class="nav-icon remix-icon ri-checkbox-circle-line"></view><view>审核</view></view>
    <view class="nav-item" data-url="/pages/admin/incidents/list/index" bindtap="go"><view class="nav-icon remix-icon ri-alarm-warning-line"></view><view>异常</view></view>
  </view>
</view>
