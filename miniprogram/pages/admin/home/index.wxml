<view class="{{themeClass}} {{fontClass}} page dashboard-page admin-home-page">
  <view class="dashboard-header">
    <view class="between header-top-line">
      <view class="badge">管理端</view>
      <view class="header-notice-pill" data-url="/pages/admin/notifications/index" bindtap="go">
        <text class="remix-icon ri-notification-3-line"></text>
        <text>通知待办</text>
        <view class="notice-dot" wx:if="{{unreadNotificationCount > 0}}">{{unreadNotificationCount}}</view>
      </view>
    </view>
    <navigator wx:if="{{adminSuper || adminPermissions.adminMall_listOrders}}" class="header-notice-pill" url="/pages/common/subscriptions/index?role=admin"><text class="remix-icon ri-notification-3-line"></text><text>商城订单订阅 ›</text></navigator>
    <view class="title">运营控制台</view>
    <view class="tip">按业务域查看订单、人员、营销和平台配置，快速定位运营动作。</view>
  </view>

  <!-- 紧急待办通知 Banner（如超时30分钟未开始） -->
  <view class="urgent-notice-banner" wx:if="{{urgentNotice}}" bindtap="tapUrgentNotice">
    <view class="urgent-banner-left">
      <view class="pulse-dot"></view>
      <text class="remix-icon ri-alarm-warning-fill banner-icon"></text>
      <view class="banner-texts">
        <view class="banner-title">{{urgentNotice.title}}</view>
        <view class="banner-sub">{{urgentNotice.tip}}</view>
      </view>
    </view>
    <view class="banner-btn">{{urgentNotice.actionText}}</view>
  </view>

  <view class="staff-audit-todo-card" wx:if="{{staffAuditTodo}}" data-url="{{staffAuditTodo.url}}" bindtap="go">
    <view class="todo-left">
      <view class="todo-icon remix-icon ri-shield-check-fill"></view>
      <view>
        <view class="todo-title">有新的宠托师申请待审核</view>
        <view class="todo-desc">{{staffAuditTodo.count}} 位申请人等待资质审核，点击进入员工审核。</view>
      </view>
    </view>
    <view class="todo-action">去审核</view>
  </view>

  <!-- 骨架预加载区域：在刚进入页面尚未获取到数据时展示，高保真占位避免页面突然撑开跳动 -->
  <block wx:if="{{dashboardLoading && !dashboard}}">
    <!-- 6 宫格核心指标骨架屏 -->
    <view class="stats-grid admin-stats-grid skeleton-stats-grid">
      <view class="stat-card skeleton-stat-card" wx:for="{{[1, 2, 3, 4, 5, 6]}}" wx:key="*this">
        <view class="skeleton-shimmer skeleton-stat-num"></view>
        <view class="skeleton-shimmer skeleton-stat-lbl"></view>
      </view>
    </view>

    <!-- 本月趋势卡片骨架屏 -->
    <view class="card chart-card skeleton-panel-card">
      <view class="between chart-head">
        <view>
          <view class="skeleton-shimmer skeleton-title-line"></view>
          <view class="skeleton-shimmer skeleton-sub-line" style="margin-top: 10rpx;"></view>
        </view>
        <view class="skeleton-shimmer skeleton-badge-box"></view>
      </view>
      <view class="chart-legend" style="margin: 22rpx 0 16rpx;">
        <view class="skeleton-shimmer skeleton-legend-pill"></view>
        <view class="skeleton-shimmer skeleton-legend-pill" style="width: 110rpx;"></view>
      </view>
      <view class="skeleton-chart-box">
        <view class="skeleton-chart-col" wx:for="{{[45, 60, 30, 75, 40, 85, 55, 90, 35, 65]}}" wx:key="*this">
          <view class="skeleton-shimmer skeleton-bar" style="height: {{item}}%;"></view>
          <view class="skeleton-shimmer skeleton-bar-label"></view>
        </view>
      </view>
    </view>

    <!-- 收入分析卡片骨架屏 -->
    <view class="card revenue-card skeleton-panel-card">
      <view class="between revenue-head">
        <view>
          <view class="skeleton-shimmer skeleton-title-line"></view>
          <view class="skeleton-shimmer skeleton-sub-line" style="margin-top: 10rpx; width: 260rpx;"></view>
        </view>
        <view class="skeleton-shimmer skeleton-month-pill"></view>
      </view>
      <view class="revenue-grid">
        <view class="revenue-stat skeleton-revenue-stat" wx:for="{{[1, 2, 3]}}" wx:key="*this">
          <view class="skeleton-shimmer skeleton-revenue-num"></view>
          <view class="skeleton-shimmer skeleton-revenue-lbl"></view>
        </view>
      </view>
      <view class="skeleton-chart-box" style="margin-top: 24rpx; height: 160rpx;">
        <view class="skeleton-chart-col" wx:for="{{[30, 50, 70, 40, 80, 60, 90, 45, 65, 85]}}" wx:key="*this">
          <view class="skeleton-shimmer skeleton-bar" style="height: {{item}}%;"></view>
          <view class="skeleton-shimmer skeleton-bar-label"></view>
        </view>
      </view>
    </view>
  </block>

  <view class="stats-grid admin-stats-grid" wx:if="{{dashboard}}">
    <view class="stat-card" wx:for="{{overviewStats}}" wx:key="label">
      <view class="stat-number">{{item.value}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <view class="card chart-card" wx:if="{{dashboard && dashboard.monthly}}">
    <view class="between chart-head">
      <view>
        <view class="strong">本月趋势</view>
        <view class="muted">{{dashboard.monthly.monthKey}} 订单与新注册用户</view>
      </view>
      <view class="chart-total">
        <view>订单 {{dashboard.monthly.totals.orders || 0}}</view>
        <view>新用户 {{dashboard.monthly.totals.registrations || 0}}</view>
      </view>
    </view>
    <view class="chart-legend">
      <view class="legend-item"><view class="legend-dot order-dot"></view><view>订单</view></view>
      <view class="legend-item"><view class="legend-dot registration-dot"></view><view>新注册</view></view>
    </view>
    <scroll-view class="chart-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="monthly-chart">
        <view class="chart-day" wx:for="{{dashboard.monthly.days}}" wx:key="day">
          <view class="value-row">
            <view class="value-pill order-value" wx:if="{{item.orders}}">{{item.orders}}</view>
            <view class="value-pill registration-value" wx:if="{{item.registrations}}">{{item.registrations}}</view>
          </view>
          <view class="bar-box">
            <view class="bar-col">
              <view class="bar order-bar" style="height: {{item.orderHeight}}%;"></view>
            </view>
            <view class="bar-col">
              <view class="bar registration-bar" style="height: {{item.registrationHeight}}%;"></view>
            </view>
          </view>
          <view class="chart-label">{{item.day}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="card revenue-card" wx:if="{{dashboard && dashboard.monthly}}">
    <view class="between revenue-head">
      <view>
        <view class="strong">收入分析</view>
        <view class="muted">按支付金额统计本月收入表现</view>
      </view>
      <view class="revenue-badge">{{dashboard.monthly.monthKey}}</view>
    </view>
    <view class="revenue-grid">
      <view class="revenue-stat {{item.highlight ? 'highlight' : ''}}" wx:for="{{revenueStats}}" wx:key="label">
        <view class="revenue-number">{{item.value}}</view>
        <view class="revenue-label">{{item.label}}</view>
      </view>
    </view>
    <scroll-view class="revenue-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
      <view class="revenue-chart">
        <view class="revenue-day" wx:for="{{dashboard.monthly.days}}" wx:key="day">
          <view class="revenue-value" wx:if="{{item.revenue}}">{{item.revenueText}}</view>
          <view class="revenue-bar-box">
            <view class="revenue-bar" style="height: {{item.revenueHeight}}%;"></view>
          </view>
          <view class="chart-label">{{item.day}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="admin-section" wx:for="{{adminSections}}" wx:key="title">
    <view class="section-head">
      <view>
        <view class="subtitle section-title">{{item.title}}</view>
        <view class="muted">{{item.desc}}</view>
      </view>
    </view>
    <view class="grid section-grid">
      <view class="card interactive action-card admin-action-card" wx:for="{{item.items}}" wx:for-item="entry" wx:key="title" data-url="{{entry.url}}" bindtap="go">
        <view class="action-icon remix-icon {{entry.icon}}">
          <view class="action-badge" wx:if="{{entry.pendingCount > 0}}">{{entry.pendingCount > 99 ? '99+' : entry.pendingCount}}</view>
        </view>
        <view class="action-title">{{entry.title}}</view>
        <view class="action-desc">{{entry.desc}}</view>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item active"><view class="nav-icon remix-icon ri-dashboard-3-fill"></view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/orders/list/index" bindtap="go"><view class="nav-icon remix-icon ri-file-list-3-line"></view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/admin/staff-audit/list/index" bindtap="go"><view class="nav-icon remix-icon ri-checkbox-circle-line"></view><view>审核</view></view>
    <view class="nav-item" data-url="/pages/admin/incidents/list/index" bindtap="go"><view class="nav-icon remix-icon ri-alarm-warning-line"></view><view>异常</view></view>
  </view>
</view>
<global-loading />
