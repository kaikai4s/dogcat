@import "./index.wxss";
.archive-overlay{position:fixed;inset:0;z-index:120;background:#fffef9;display:flex;flex-direction:column;padding:24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));box-sizing:border-box}.archive-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:32rpx;font-weight:600;padding-bottom:24rpx}.archive-overlay button{padding:16rpx 24rpx;min-height:80rpx;margin:0;background:#e8eedf;color:#476443;font-size:26rpx;line-height:1.6;border-radius:16rpx}.archive-overlay button::after{border:0}.archive-scroll{flex:1;min-height:0;height:0}.archive-section{padding:28rpx 0;border-top:1rpx solid #e1e6d8;margin-top:20rpx}.archive-result{width:300rpx;height:300rpx;background:#edf2e6;border-radius:18rpx}.memory-text{overflow-wrap:anywhere}
