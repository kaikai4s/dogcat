page{background:#f4f6f1;color:#304539}.memorial-admin{padding:36rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));max-width:960rpx;margin:auto}.memorial-admin view,.review-panel{box-sizing:border-box}.review-heading{display:flex;gap:22rpx;align-items:center;margin:12rpx 0 32rpx}.heading-icon{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;border-radius:28rpx;background:#dfe9dc;color:#4d6c4d;font-size:48rpx}.eyebrow{font-size:22rpx;color:#7c8a78;letter-spacing:2rpx;margin-bottom:8rpx}.heading{font-size:40rpx;font-weight:600;letter-spacing:2rpx}.tip{font-size:24rpx;color:#788274;line-height:1.8;margin:14rpx 0;white-space:normal}.subscription-card{padding:28rpx;border:1rpx solid #dce6d5;background:#edf3e7;border-radius:28rpx;margin-bottom:30rpx}.subscription-title{display:flex;gap:12rpx;align-items:center;font-size:28rpx;font-weight:600}.subscription-actions{display:flex;flex-wrap:wrap;align-items:center;gap:16rpx}.subscription-feedback{margin-top:18rpx;font-size:24rpx;line-height:1.7;color:#446c45}.memorial-admin button,.review-panel button{font-size:26rpx;padding:0 24rpx;min-height:76rpx;line-height:76rpx;border-radius:18rpx;box-shadow:none;margin:0;font-weight:500}.memorial-admin button::after,.review-panel button::after{border:0}.memorial-admin .primary,.review-panel .primary{background:#4d6b4e;color:#fffdf4}.memorial-admin .secondary,.review-panel .secondary{background:#edf0e8;color:#52634c}.memorial-admin .text-button{padding:0 8rpx;background:transparent;min-height:60rpx;line-height:60rpx;color:#5c7558;font-size:24rpx}.tabs{display:flex;gap:8rpx;padding:8rpx;border-radius:22rpx;background:#e9eee4}.tabs button{flex:1;min-width:0;background:transparent;color:#75836e}.tabs button.active{background:#fffef8;color:#3f5b40;box-shadow:0 4rpx 12rpx #34492b08}.list-toolbar{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:22rpx;color:#85917e;margin:18rpx 0 4rpx}.request-card{margin:18rpx 0 28rpx;padding:30rpx;background:#fffef9;border:1rpx solid #e7ebdf;border-radius:28rpx}.card-head{display:flex;gap:16rpx;justify-content:space-between;align-items:center}.name{font-size:32rpx;font-weight:600;line-height:1.5;overflow-wrap:anywhere}.status-badge{flex:none;font-size:22rpx;padding:8rpx 18rpx;border-radius:30rpx}.status-pending{background:#faf0d7;color:#967327}.status-approved{background:#e4eedc;color:#4e7048}.status-rejected{background:#f4e8e2;color:#9a7460}.plot-label{display:flex;gap:8rpx;align-items:center;font-size:24rpx;color:#65815b;margin:18rpx 0 24rpx}.detail-row{display:flex;justify-content:space-between;gap:24rpx;font-size:24rpx;margin:12rpx 0;line-height:1.7}.detail-row text:first-child{color:#8b9485;flex:none}.detail-row text:last-child{text-align:right;word-break:break-all}.epitaph{margin:26rpx 0;padding:24rpx;background:#f4f5ec;border-radius:18rpx;font-size:28rpx;line-height:1.9;white-space:pre-wrap;overflow-wrap:anywhere}.quote-label{font-size:22rpx;color:#8a967e;margin-bottom:8rpx}.review-note{font-size:25rpx;line-height:1.8;color:#8a6f5c;margin:20rpx 0;white-space:pre-wrap;word-break:break-all}.actions{display:flex;gap:16rpx;margin-top:26rpx}.actions button{flex:1;min-width:0;padding:0 16rpx}.empty-card{padding:70rpx 24rpx;text-align:center}.empty-icon{font-size:64rpx;color:#98ae8a;margin-bottom:24rpx}.empty-card .name{font-size:28rpx}.error-card{padding:24rpx;border-radius:20rpx;background:#fff0e2;color:#8d5c39;font-size:25rpx;line-height:1.8}.load-more{width:100%;background:#e8eedf;color:#4e6948}.review-mask{position:fixed;top:0;left:0;right:0;bottom:0;z-index:100;background:#20312688;display:flex;align-items:center;justify-content:center;padding:32rpx}.review-panel{width:100%;max-width:680rpx;max-height:85vh;overflow:auto;padding:36rpx;border-radius:30rpx;background:#fffef9}.review-pet{font-size:40rpx;color:#4d6b4e;margin:26rpx 0 12rpx;overflow-wrap:anywhere}.review-panel textarea{box-sizing:border-box;height:190rpx;width:100%;padding:24rpx;font-size:2