.memory-text{white-space:pre-wrap;line-height:1.8}.memory-photos{display:flex;flex-wrap:wrap;gap:12rpx;margin:18rpx 0}.memory-photos image{width:160rpx;height:160rpx;border-radius:12rpx}.memory-review video{width:100%;margin:16rpx 0}.memory-review button{white-space:normal;}

.tabs+.tabs{margin-top:16rpx}.portrait-references{display:flex;gap:20rpx;margin:24rpx 0}.portrait-references>view{flex:1;min-width:0;text-align:center;font-size:24rpx;color:#718268}.portrait-references image{display:block;width:100%;height:240rpx;border-radius:20rpx;background:#edf0e7;margin-bottom:12rpx}.portrait-result{text-align:center;padding:20rpx;margin:20rpx 0;border:1rpx solid #d6dfce;border-radius:20rpx;background:#e6eddd}.portrait-result image{width:300rpx;height:300rpx}.memorial-admin .portrait-upload{width:100%;margin-top:20rpx;min-height:88rpx;background:#eef3e8;border:2rpx dashed #91a780;color:#416146;white-space:normal;line-height:1.5;padding:20rpx}.confirm-portrait{display:block;width:280rpx;height:280rpx;margin:12rpx auto;background:#e6eddd;border-radius:18rpx}

.portrait-export{position:fixed;left:-2048px;top:0;width:512px;height:512px;pointer-events:none}

.placement-heading{font-size:28rpx;font-weight:600;color:#496344}.portrait-placement{position:relative;height:0;padding-top:114.285714%;width:100%;overflow:hidden;border-radius:18rpx;background:radial-gradient(ellipse at 48% 45%,#bdcc91,#92a86f)}.portrait-placement .placement-monument,.portrait-placement .placement-pet,.placement-pet-window,.placement-shadow,.placement-name{position:absolute;display:block;margin:0;border-radius:0;max-width:none;max-height:none}.placement-pet-window{overflow:hidden}.placement-shadow{background:rgba(40,55,30,.14);border-radius:50%}.placement-name{display:flex;align-items:center;justify-content:center;white-space:nowrap;overflow:hidden;font-size:26rpx;color:#665b4b;line-height:1}.portrait-size{text-align:left;margin-top:24rpx;padding-top:24rpx;border-top:1rpx solid #cad6bb}.size-heading{display:flex;justify-content:space-between;font-size:26rpx;color:#45633f;font-weight:600}.size-actions{display:flex;gap:12rpx;margin-top:16rpx}.memorial-admin .size-actions button{flex:1;min-width:0;min-height:44px;line-height:1.5;padding:20rpx 4rpx;white-space:normal}.preview-error{font-size:24rpx;line-height:1.6;color:#a15e42;margin-top:16rpx}.review-panel .portrait-placement{max-width:100%;margin-bottom:24rpx}.memorial-admin .portrait-review>.secondary{min-height:44px;white-space:normal;line-height:1.6;padding:20rpx;width:100%}

.review-panel-portrait{height:85vh}.review-panel .actions button{min-height:44px;line-height:1.5;padding:20rpx 12rpx}.review-panel .portrait-placement{box-sizing:border-box}

