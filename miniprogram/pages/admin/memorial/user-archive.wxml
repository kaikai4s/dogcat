<view class="memorial-admin"><view class="review-heading"><view class="heading-icon remix-icon ri-leaf-line"></view><view><view class="eyebrow">用户纪念园档案</view><view class="heading">TA 的时光小筑</view></view></view><button class="secondary" wx:if="{{adminSuper || adminPermissions.admin_getUserDetail}}" bindtap="profile">查看用户基础资料</button><view class="tip">包含所有园区的申请记录。时间均为北京时间。</view>
<view class="error-card" wx:if="{{error}}">{{error}}<button bindtap="load">重新加载</button></view>
<view class="request-card" wx:for="{{rows}}" wx:key="_id"><view class="card-head"><view class="name">{{item.petName}}</view><text class="status-badge status-{{item.status}}">{{item.statusText}}</text></view><view class="plot-label">{{item.gardenName}} · {{item.lawn}} · {{item.plotNumber}}号</view><view class="detail-row"><text>申请时间</text><text>{{item.createdText}}</text></view><view class="detail-row" wx:if="{{item.reviewedAt}}"><text>审核时间</text><text>{{item.reviewedText}}</text></view><view class="detail-row"><text>纪念日期</text><text>{{item.date}}</text></view><view class="epitaph">{{item.epitaph}}</view><view class="review-note" wx:if="{{item.reason}}">审核意见：{{item.reason}}</view><view class="actions"><button class="secondary" data-id="{{item._id}}" bindtap="locate">在园区定位</button><button wx:if="{{adminSuper || adminPermissions.memorial_getMemorialAdmin}}" class="primary" data-id="{{item._id}}" bindtap="openContent">查看回忆与画像</button></view></view>
<view class="empty-card" wx:if="{{!rows.length && !error}}">{{loading ? '正在读取档案…' : '该用户还没有申请时光小筑'}}</view><button wx:if="{{more}}" class="load-more" bindtap="load" data-more="true" disabled="{{loading}}">加载更多</button></view>
<view wx:if="{{selected}}" class="archive-overlay"><view class="archive-top"><view>小筑内容档案</view><button bindtap="closeContent">关闭</button></view><scroll-view scroll-y class="archive-scroll"><view class="tip" wx:if="{{detailLoading}}">正在读取内容…</view><view wx:if="{{detailError}}" class="error-card">{{detailError}}<button bindtap="openContent">重试</button></view><block wx:if="{{content}}"><view class="name">{{content.petName}} · {{content.gardenName}}</view><view class="tip">回忆状态：{{content.memoryLabel}} · {{content.isPublic ? '允许公开已通过的版本' : '仅主人可见'}}<view>最后整理：{{content.memoryTime}}（北京时间）</view></view><view class="review-note" wx:if="{{content.memoryReason}}">{{content.memoryReason}}</view><view class="archive-section"><view class="name">主人当前保存的内容</view><view class="tip">管理员资料视图，包含私人内容与待审核草稿。</view><template is="media" data="{{memory:content.draft,playingUrl:playingUrl}}"/></view><view class="archive-section"><view class="name">访客当前可见版本</view><template is="media" data="{{memory:content.story,playingUrl:playingUrl}}"/></view><view class="archive-section"><view class="name">宠物画像 · {{content.portraitLabel}}</view><view class="tip">{{content.portrait.note}}</view><view class="portrait-references"><view wx:for="{{content.portrait.photos}}" wx:key="uploadId"><image src="{{item.url}}" mode="aspectFit" data-url="{{item.url}}" bindtap="previewImage"/><text>{{index === 0 ? '正面参考照' : '侧面参考照'}}</text></view></view><image wx:if="{{content.portrait.result.url}}" class="archive-result" src="{{content.portrait.result.url}}" mode="aspectFit" data-url="{{content.portrait.result.url}}" bindtap="previewImage"/><view class="review-note">{{content.portrait.reason}}</view></view></block></scroll-view></view>
<template name="media"><view wx:if="{{memory}}" class="memory-review"><view class="tip">标记“入口展示”的照片、视频会在小筑弹窗中公开，其他内容保留在完整回忆中。</view><text class="memory-text" user-select>{{memory.text}}</text><view class="memory-photos"><view wx:for="{{memory.images}}" wx:key="uploadId"><image src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewImage"/><view class="tip" wx:if="{{item.entrance}}">入口展示</view></view></view><view wx:for="{{memory.videos}}" wx:key="uploadId"><video src="{{item.url}}" controls/><view class="tip" wx:if="{{item.entrance}}">入口展示</view></view><button class="secondary" wx:if="{{memory.music}}" data-url="{{memory.music.url}}" bindtap="playAudio">{{playingUrl === memory.music.url ? '停止播放' : '试听背景音乐'}} · {{memory.music.name}}</button></view><view wx:else class="tip">暂无内容</view></template>
