<view class="memorial-admin"><view class="heading">纪念碑申请审核</view><view class="tip">通过后在园区建立纪念碑；驳回会释放墓位并通知申请人。</view><view class="tabs"><button data-status="pending" bindtap="changeStatus">待审核</button><button data-status="approved" bindtap="changeStatus">已建立</button><button data-status="rejected" bindtap="changeStatus">已驳回</button></view><view class="tip">当前：{{status === 'pending' ? '待审核' : status === 'approved' ? '已建立' : '已驳回'}}</view><view wx:if="{{error}}">{{error}}</view><button bindtap="load" loading="{{loading}}" disabled="{{loading}}">刷新</button><view class="request-card" wx:for="{{rows}}" wx:key="_id"><view class="name">{{item.petName}}</view><view class="tip">{{item.applicant}} · {{item.date}} · {{item.lawn}}</view><view class="epitaph">{{item.epitaph}}</view><view class="tip" wx:if="{{item.reason}}">审核意见：{{item.reason}}</view><view class="actions" wx:if="{{item.status === 'pending' && (adminSuper || adminPermissions.memorial_review)}}"><button data-id="{{item._id}}" data-status="approved" bindtap="review" disabled="{{busy}}">通过并建立</button><button data-id="{{item._id}}" data-status="rejected" bindtap="review" disabled="{{busy}}">驳回</button></view></view><view class="tip" wx:if="{{!rows.length && !loading && !error}}">当前没有此状态的申请。</view><button wx:if="{{hasMore}}" data-more="true" bindtap="load" disabled="{{loading}}">加载更多</button></view><view class="review-mask" wx:if="{{reviewForm}}"><view class="review-panel"><view class="name">{{reviewForm.status === 'approved' ? '确认建立' : '驳回'}}“{{reviewForm.petName}}”的纪念碑</view><view class="tip">{{reviewForm.status === 'approved' ? '通过后名字、日期和寄语将公开展示在纪念园。' : '请填写具体原因，申请人可以修改后重新申请。'}}</view><textarea maxlength="200" value="{{reviewForm.reason}}" bindinput="reason" placeholder="{{reviewForm.status === 'approved' ? '审核备注（选填）' : '驳回原因（必填）'}}" disabled="{{busy}}" /><view class="actions"><button bindtap="close" disabled="{{busy}}">取消</button><button bindtap="confirm" loading="{{busy}}" disabled="{{busy}}">确认{{reviewForm.status === 'approved' ? '通过' : '驳回'}}</button></view></view></view>