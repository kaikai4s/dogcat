<view class="memorial-admin">
  <view class="review-heading"><view class="heading-icon remix-icon ri-leaf-line"></view><view><view class="eyebrow">纪念园 · 让思念有处安放</view><view class="heading">{{mode === 'memories' ? '纪念回忆审核' : mode === 'portraits' ? '宠物画像制作' : '时光小筑审核'}}</view></view></view>
  <button wx:if="{{adminSuper || adminPermissions.memorial_getOfferingSettings}}" class="offering-settings-entry" bindtap="openOfferingSettings" disabled="{{busy}}"><view><view class="subscription-title">鲜花与零食 · 场景显示</view><view class="tip">设置两种心意在小筑旁保留多久</view></view><text>设置 ›</text></button>
  <view class="subscription-card">
    <view class="subscription-title"><text class="remix-icon ri-notification-3-line"></text> 新申请，及时知晓</view>
    <view class="tip">{{subscriptionTip}}</view>
    <view class="subscription-actions"><button wx:if="{{subscriptionReady}}" class="primary" bindtap="subscribeAudit" loading="{{subscribing}}" disabled="{{subscribing}}">订阅审核提醒</button><button wx:else bindtap="loadSubscription">重新检查配置</button><button class="text-button" bindtap="openNotificationSettings">微信通知设置 ›</button></view>
    <view class="subscription-feedback" wx:if="{{subscriptionFeedback}}">{{subscriptionFeedback}}</view>
  </view>
  <view class="tabs"><button wx:if="{{adminSuper || adminPermissions.memorial_listAdmin}}" class="{{mode === 'applications' ? 'active' : ''}}" data-mode="applications" bindtap="changeMode">小筑申请</button><button wx:if="{{adminSuper || adminPermissions.memorial_listMemoriesAdmin}}" class="{{mode === 'memories' ? 'active' : ''}}" data-mode="memories" bindtap="changeMode">公开回忆</button><button wx:if="{{adminSuper || adminPermissions.memorial_listPortraitsAdmin}}" class="{{mode === 'portraits' ? 'active' : ''}}" data-mode="portraits" bindtap="changeMode">宠物画像</button></view>
  <view class="tabs"><button class="{{status === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="changeStatus" disabled="{{busy}}">待审核</button><button class="{{status === 'approved' ? 'active' : ''}}" data-status="approved" bindtap="changeStatus" disabled="{{busy}}">{{mode === 'memories' ? '已公开' : '已安放'}}</button><button class="{{status === 'rejected' ? 'active' : ''}}" data-status="rejected" bindtap="changeStatus" disabled="{{busy}}">需调整</button></view>
  <view class="list-toolbar"><text>{{mode === 'memories' ? '请逐一查看文字、全部照片、视频及音乐后审核' : mode === 'portraits' ? '参考照片制作画像，上传成品并确认安放' : '核对名字、位置与寄语后再处理'}}</text><button class="text-button" bindtap="load" loading="{{loading}}" disabled="{{loading || busy}}">刷新</button></view>
  <view class="error-card" wx:if="{{error}}">{{error}}<button bindtap="load" disabled="{{loading}}">重试</button></view>
  <view class="request-card" wx:for="{{rows}}" wx:key="_id">
    <view class="card-head"><view class="name">{{item.petName}}</view><text class="status-badge status-{{item.status}}">{{item.statusText}}</text></view>
    <view class="plot-label"><text class="remix-icon ri-map-pin-line"></text>{{item.gardenName}} · {{item.lawn}} · {{item.plotNumber}}号</view>
    <view class="detail-row"><text>申请人</text><text>{{item.applicant || '用户'}}</text></view>
    <view class="actions archive-links"><button wx:if="{{adminSuper || adminPermissions.admin_getUserDetail}}" class="secondary" data-id="{{item._id}}" bindtap="openUser" disabled="{{busy}}">用户资料</button><button wx:if="{{adminSuper || adminPermissions.memorial_listUserMemorialsAdmin}}" class="secondary" data-id="{{item._id}}" bindtap="openArchive" disabled="{{busy}}">TA 的小筑档案</button></view>
    <view class="detail-row" wx:if="{{mode === 'applications'}}"><text>纪念日期</text><text>{{item.date}}</text></view>
    <view class="detail-row"><text>提交时间</text><text>{{item.createdText}}（北京时间）</text></view>
    <view class="epitaph" wx:if="{{mode === 'applications'}}"><view class="quote-label">想对它说的话</view><view>{{item.epitaph}}</view></view>
    <view wx:if="{{item.memory}}" class="memory-review"><text class="memory-text" user-select>{{item.memory.text}}</text><view class="memory-photos"><view wx:for="{{item.memory.images}}" wx:for-item="photo" wx:key="uploadId"><image src="{{photo.url}}" mode="aspectFill" data-id="{{item._id}}" data-url="{{photo.url}}" bindtap="previewImage" /><view wx:if="{{photo.entrance}}" class="tip">入口展示</view></view></view><view wx:for="{{item.memory.videos}}" wx:for-item="clip" wx:key="uploadId"><video src="{{clip.url}}" controls /><view wx:if="{{clip.entrance}}" class="tip">入口展示</view></view><button wx:if="{{item.memory.music}}" data-url="{{item.memory.music.url}}" bindtap="playAudio">{{playingUrl === item.memory.music.url ? '停止音乐' : '试听背景音乐'}} · {{item.memory.music.name}}</button></view>
    <view wx:if="{{mode === 'portraits'}}" class="portrait-review">
      <view class="detail-row"><text>主人选择的姿势</text><text>{{item.poseLabel}}</text></view><view class="portrait-references"><view wx:for="{{item.photos}}" wx:for-item="photo" wx:key="uploadId"><image src="{{photo.url}}" mode="aspectFit" data-id="{{item._id}}" data-url="{{photo.url}}" bindtap="previewImage"/><text>{{index === 0 ? '正面参考照' : '侧面参考照'}}</text></view></view>
      <view class="epitaph" wx:if="{{item.note}}"><view class="quote-label">主人补充的特征</view>{{item.note}}</view>
      <view class="tip">2.5D 静态宠物画像 · 透明 PNG。请检查花纹、四肢、透明背景与脚掌位置。</view>
      <button class="secondary" data-id="{{item._id}}" bindtap="copyPortraitPrompt">复制画像制作提示词</button>
      <view class="portrait-result" wx:if="{{item.stagedAsset || item.result}}">
        <view class="placement-heading">平台安放预览</view><view class="tip">{{item.legacy ? '按这处小筑的原有平台比例展示' : '按这处小筑的样式与平台比例展示'}} · {{item.poseLabel}}</view>
        <template is="portrait-placement" data="{{p:item}}"/>
        <view class="tip" wx:if="{{item.previewPending}}">画像已上传，正在加载安放预览…</view><view class="preview-ready" wx:if="{{item.previewReady}}">预览已就绪，可调整大小后确认安放</view><view class="preview-error" wx:if="{{item.previewError}}">{{item.previewError}}<button class="secondary" data-id="{{item._id}}" bindtap="retryPlacement" loading="{{item.previewPending}}" disabled="{{busy || item.previewPending}}">重试预览</button></view>
        <view class="portrait-size" wx:if="{{item.stagedAsset}}"><view class="size-heading"><text>画像大小</text><text>{{item.preview.scalePercent}}%</text></view><view class="size-actions"><button class="secondary" data-id="{{item._id}}" data-step="-5" bindtap="resizePortrait" disabled="{{busy || item.preview.scalePercent <= 50}}">− 缩小</button><button class="secondary" data-id="{{item._id}}" data-step="0" bindtap="resizePortrait" disabled="{{busy}}">默认</button><button class="secondary" data-id="{{item._id}}" data-step="5" bindtap="resizePortrait" disabled="{{busy || item.preview.scalePercent >= 140}}">＋ 放大</button></view><view class="tip">50%～140% · 等比例缩放，底部始终贴住平台。小体型宠物可按效果调整。</view></view>
        <button class="text-button" data-id="{{item._id}}" data-url="{{item.stagedAsset ? item.stagedAsset.url : item.result.url}}" bindtap="previewImage">查看透明 PNG 原图</button><view class="tip">{{item.stagedAsset ? '确认通过后，将按此大小安放到园区' : '当前已安放的画像'}}</view>
      </view>
      <view wx:if="{{item.status === 'pending' && (adminSuper || adminPermissions.memorial_preparePortraitAsset)}}" class="portrait-upload-options"><button class="portrait-upload" data-id="{{item._id}}" bindtap="uploadPortrait" loading="{{uploadingPortraitId === item._id}}" disabled="{{busy}}">{{uploadingPortraitId === item._id ? portraitUploadTip : '从手机相册上传画像'}}</button><view class="tip">选择 10MB 以内、边长不超过 4096 像素的透明 PNG，系统会自动整理尺寸并保留透明背景。建议使用 512×512 或 1024×1024 原图，请勿截图或添加底色。</view></view>
    </view>
    <view class="review-note" wx:if="{{item.reason}}">审核意见：{{item.reason}}</view>
    <view class="actions" wx:if="{{item.status === 'pending' && (adminSuper || (mode === 'memories' ? adminPermissions.memorial_reviewMemory : mode === 'portraits' ? adminPermissions.memorial_reviewPortrait : adminPermissions.memorial_review))}}"><button class="secondary" data-id="{{item._id}}" data-status="rejected" bindtap="review" disabled="{{busy}}">请申请人调整</button><button class="primary" data-id="{{item._id}}" data-status="approved" bindtap="review" loading="{{mode === 'portraits' && item.previewPending}}" disabled="{{busy || (mode === 'portraits' && item.previewPending)}}">{{mode === 'memories' ? '通过并公开' : mode === 'portraits' ? '确认画像并安放' : '通过并安放'}}</button></view>
    <view class="tip" wx:elif="{{item.status === 'pending'}}">您可以查看申请，处理申请需要审核权限。</view>
  </view>
  <view class="empty-card" wx:if="{{!rows.length && !error}}"><view class="empty-icon remix-icon ri-leaf-line"></view><view class="name">{{loading ? '正在整理申请…' : status === 'pending' ? '暂时没有待审核申请' : '暂无相关记录'}}</view><view class="tip">{{loading ? '请稍候' : '每一份陪伴，都值得被温柔记住。'}}</view></view>
  <button wx:if="{{hasMore}}" class="load-more" data-more="true" bindtap="load" loading="{{loading}}" disabled="{{loading || busy}}">加载更多</button>
</view>
<view class="review-mask" wx:if="{{reviewForm}}">
  <scroll-view scroll-y class="review-panel {{mode === 'portraits' && reviewForm.status === 'approved' ? 'review-panel-portrait' : ''}}"><view class="eyebrow">{{reviewForm.lawn}} · {{reviewForm.plotNumber}}号</view><view class="name">{{reviewForm.status === 'approved' ? (mode === 'memories' ? '公开这份珍藏的回忆' : mode === 'portraits' ? '安放这份专属画像' : '为它安放一处时光') : '请申请人完善这份思念'}}</view><view class="review-pet">{{reviewForm.petName}}</view><view class="tip">{{reviewForm.status === 'approved' ? (mode === 'memories' ? '确认已查看全部文字、照片、视频及音乐；通过后访客可阅读本版回忆。' : mode === 'portraits' ? '确认姿势、花纹与平台上的大小合适；通过后按此效果安放。' : '确认后，名字、纪念日期与寄语将公开展示在园区。') : (mode === 'memories' ? '请说明需要调整的回忆内容。已有公开版本不受影响。' : mode === 'portraits' ? '请说明需要补充的照片或特征。已有画像会继续保留。' : '请温和、具体地说明需要调整的内容。位置会释放，申请人可重新选择并申请。')}}</view><view wx:if="{{mode === 'portraits' && reviewForm.status === 'approved'}}"><view class="tip">{{reviewForm.poseLabel}} · 大小 {{reviewForm.preview.scalePercent}}%</view><template is="portrait-placement" data="{{p:reviewForm}}"/><view class="tip" wx:if="{{reviewForm.previewPending}}">正在加载安放预览…</view><view class="preview-error" wx:if="{{reviewForm.previewError}}">{{reviewForm.previewError}}<button class="secondary" data-id="{{reviewForm.id}}" bindtap="retryPlacement" disabled="{{busy || reviewForm.previewPending}}">重试预览</button></view></view><textarea maxlength="200" value="{{reviewForm.reason}}" bindinput="reason" placeholder="{{reviewForm.status === 'approved' ? '审核备注（选填）' : '需要调整的内容（必填）'}}" disabled="{{busy}}" /><view class="actions"><button class="secondary" bindtap="close" disabled="{{busy}}">再看一下</button><button class="primary" bindtap="confirm" loading="{{busy}}" disabled="{{busy}}">{{reviewForm.status === 'approved' ? '确认通过' : '确认并通知'}}</button></view></scroll-view>
</view>

<template name="portrait-placement"><view class="portrait-placement">
  <image wx:if="{{p.monumentUrl}}" class="placement-monument" src="{{p.monumentUrl}}" style="{{p.preview.monument}}" mode="scaleToFill" data-key="{{p.previewKey}}" data-part="monument" data-attempt="{{p.previewAttempt}}" data-src="{{p.monumentUrl}}" bindload="placementImageLoaded" binderror="placementImageError"/>
  <view class="placement-name" style="{{p.preview.name}}">{{p.petName}}</view>
  <view class="placement-shadow" style="{{p.preview.shadow}}"></view>
  <view class="placement-pet-window" style="{{p.preview.pet}}"><image wx:if="{{p.petUrl}}" class="placement-pet" src="{{p.petUrl}}" style="{{p.preview.image}}" mode="scaleToFill" data-key="{{p.previewKey}}" data-part="pet" data-attempt="{{p.previewAttempt}}" data-src="{{p.petUrl}}" bindload="placementImageLoaded" binderror="placementImageError"/></view>
</view></template>

<canvas type="2d" id="portrait-export" class="portrait-export" aria-hidden="true"></canvas>

<view class="review-mask" wx:if="{{offeringSettings}}"><view class="review-panel offering-settings-panel"><view class="eyebrow">纪念园 · 心意的停留时间</view><view class="name">鲜花与零食显示设置</view><view class="tip">每次献上的鲜花、零食按下方时长留在场景中；小筑收到的累计总数永久保留。</view><view wx:if="{{offeringSettings.loading}}" class="tip">正在读取设置…</view><block wx:else><view class="offering-setting-field"><text>鲜花显示时长</text><view><input type="number" maxlength="5" data-field="flowerMinutes" value="{{offeringSettings.flowerMinutes}}" bindinput="inputOfferingSettings" disabled="{{offeringSettings.saving || offeringSettings.loadFailed || !(adminSuper || adminPermissions.memorial_saveOfferingSettings)}}"/><text>分钟</text></view></view><view class="offering-setting-field"><text>零食显示时长</text><view><input type="number" maxlength="5" data-field="snackMinutes" value="{{offeringSettings.snackMinutes}}" bindinput="inputOfferingSettings" disabled="{{offeringSettings.saving || offeringSettings.loadFailed || !(adminSuper || adminPermissions.memorial_saveOfferingSettings)}}"/><text>分钟</text></view></view><view class="tip">60 分钟 = 1 小时；1440 分钟 = 1 天。支持 1 分钟至 7 天，到期按分钟移除。保存后用于新献上的心意。</view></block><view wx:if="{{offeringSettings.error}}" class="offering-settings-error">{{offeringSettings.error}}<button class="secondary" bindtap="openOfferingSettings" disabled="{{offeringSettings.saving}}">重新读取设置</button></view><view class="actions"><button class="secondary" bindtap="closeOfferingSettings" disabled="{{offeringSettings.saving}}">关闭</button><button wx:if="{{adminSuper || adminPermissions.memorial_saveOfferingSettings}}" class="primary" bindtap="saveOfferingSettings" loading="{{offeringSettings.saving}}" disabled="{{offeringSettings.loading || offeringSettings.saving || offeringSettings.loadFailed}}">{{offeringSettings.saving ? '正在保存…' : '保存显示时长'}}</button></view></view></view>
