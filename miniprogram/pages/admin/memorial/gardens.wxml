<view class="memorial-admin">
  <view class="review-heading"><view class="heading-icon remix-icon ri-leaf-line"></view><view><view class="eyebrow">让每一份思念都有归处</view><view class="heading">纪念园管理</view></view></view>
  <view class="subscription-card"><view class="subscription-title">各自独立，共用温柔的风景</view><view class="tip">每个纪念园拥有独立的小筑位置和同园访客。新园区使用现有花园场景，名称可以随时修改。</view><button wx:if="{{adminSuper || adminPermissions.memorial_createGarden}}" class="primary" bindtap="create" disabled="{{busy}}">＋ 新建纪念园</button></view>
  <view class="error-card" wx:if="{{error}}">{{error}}<button bindtap="load">重新加载</button></view>
  <view class="request-card" wx:for="{{rows}}" wx:key="id"><view class="card-head"><view class="name">{{item.name}}</view><text class="status-badge {{item.accepting ? 'status-approved' : 'status-rejected'}}">{{item.accepting ? '接收新申请' : '暂停新申请'}}</text></view><view class="tip">创建时间：{{item.createdText}}{{item.createdAt ? '（北京时间）' : ''}}</view><view class="tip">{{item.accepting ? '用户可在空位申请时光小筑。' : '已有小筑仍可探望，用户可前往其他园区申请。'}}</view><view class="actions"><button class="secondary" data-id="{{item.id}}" bindtap="visit">进入园区</button><button wx:if="{{adminSuper || adminPermissions.memorial_updateGarden}}" class="primary" data-id="{{item.id}}" bindtap="edit" disabled="{{busy}}">编辑园区</button></view></view>
  <view class="tip" wx:if="{{loading}}">正在读取园区…</view><button class="load-more" wx:if="{{hasMore}}" bindtap="load" data-more="true" disabled="{{loading || busy}}">更多纪念园</button>
</view>
<view class="review-mask" wx:if="{{form}}"><view class="review-panel"><view class="name">{{form.id ? '编辑纪念园' : '新建纪念园'}}</view><view class="tip">给这片安放心愿与思念的花园取一个名字。</view><input class="garden-name-input" maxlength="30" value="{{form.name}}" bindinput="input" placeholder="例如：星河纪念园" disabled="{{busy}}"/><view class="garden-accepting"><view><view>接收新的小筑申请</view><view class="tip">关闭后保留探望和现有回忆。</view></view><switch checked="{{form.accepting}}" bindchange="accepting" disabled="{{busy}}" color="#4d6b4e"/></view><view class="actions"><button class="secondary" bindtap="close" disabled="{{busy}}">取消</button><button class="primary" bindtap="save" disabled="{{busy}}" loading="{{busy}}">保存园区</button></view></view></view>
