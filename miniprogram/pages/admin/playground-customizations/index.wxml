<view class="custom-admin">
  <view class="page-heading"><view><view class="page-title">乐园形象定制</view><view class="muted">按申请制作，专属绑定到具体角色或宠物</view></view><button bindtap="refresh" disabled="{{loading || busy}}">刷新</button></view>
  <scroll-view scroll-x class="tabs"><view class="tab {{status === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" data-status="{{item.value}}" bindtap="changeStatus">{{item.label}}</view></scroll-view>
  <view class="error-message" wx:if="{{error}}">{{error}}</view><view class="empty-message" wx:if="{{!loading && !applications.length}}">暂无这类申请</view>
  <view class="request-card" wx:for="{{applications}}" wx:key="_id"><view class="request-heading"><view><view class="request-name">{{item.ownerName}} · {{item.targetType === 'pet' ? item.targetName : '角色形象'}}</view><view class="muted">{{item.targetType === 'pet' ? '宠物定制' : '角色定制'}} · {{item.photos.length}} 张参考照</view></view><text class="status-pill {{item.status}}">{{item.statusText}}</text></view><view class="muted">{{item.timeText}}</view><view class="request-id">{{item._id}}</view><button wx:if="{{adminSuper || adminPermissions.playgroundAppearance_detailAdmin}}" data-id="{{item._id}}" bindtap="openDetail" disabled="{{busy}}">查看申请与照片</button></view>
  <button class="more-button" wx:if="{{hasMore}}" bindtap="loadMore" loading="{{loading}}" disabled="{{loading || busy}}">加载更多</button>
  <view class="detail-backdrop" wx:if="{{detail}}" catchtouchmove="swallow"><view class="detail-panel"><view class="detail-heading"><view><view class="page-title">{{detail.targetName}}</view><view class="muted">申请人 {{detail.ownerName}} · {{detail.statusText}}</view></view><button bindtap="closeDetail" disabled="{{busy}}">关闭</button></view>
    <scroll-view scroll-y class="detail-content"><view class="binding-note">专属对象：{{detail.targetType === 'pet' ? '这只宠物' : '申请人的角色'}}<view class="request-id">{{detail.targetId}}</view></view>
      <view class="section-title">参考照片</view><view class="photo-grid"><image wx:for="{{detail.photoUrls || detail.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewPhoto"/></view><view class="remark">{{detail.remark || '用户未补充其他说明'}}</view>
      <view wx:if="{{detail.canProcess && (adminSuper || (adminPermissions.playgroundAppearance_prepareUpload && adminPermissions.playgroundAppearance_publish))}}"><view class="section-title">上传完成的动作图集</view>
        <view wx:if="{{detail.targetType === 'character'}}">
          <view class="binding-note">角色需上传 8 张图：行走、奔跑各包含 SW 左前、SE 右前、NW 左后、NE 右后。文件须为静态 RGBA 透明 PNG、4列×3行，共12帧；推荐1024×768 像素、每格256×256（也支持每格128或512像素）；按左到右、上到下排列，单张不超过8MB。人物逐帧居中，脚底对齐，每个方向的行走第1帧用于待机。</view>
          <view class="section-title">制作提示词</view>
          <view class="prompt-controls"><view class="prompt-options"><button class="{{promptAction === 'walk' ? 'selected' : ''}}" data-action="walk" bindtap="selectPromptAction">行走</button><button class="{{promptAction === 'run' ? 'selected' : ''}}" data-action="run" bindtap="selectPromptAction">奔跑</button></view><view class="prompt-options"><button wx:for="{{directions}}" wx:key="key" class="{{promptDirection === item.key ? 'selected' : ''}}" data-direction="{{item.key}}" bindtap="selectPromptDirection">{{item.label}}</button></view></view>
          <textarea class="prompt-text" value="{{generationPrompt}}" disabled auto-height maxlength="2000"/><button class="copy-prompt" bindtap="copyPrompt">复制当前提示词</button>
          <view class="direction-atlas" wx:for="{{walkAtlases}}" wx:key="key"><view class="atlas-heading"><text>行走 · {{item.label}}</text><text class="muted">{{item.atlas ? item.atlas.name : '尚未选择'}}</text></view><view class="atlas-actions"><button data-action="walk" data-direction="{{item.key}}" bindtap="selectAtlas" disabled="{{busy}}">{{item.atlas ? '重新选择' : '选择12帧图集'}}</button><view class="sprite-preview character-preview" wx:if="{{item.atlas}}"><image src="{{item.atlas.path}}" style="left: {{previewLeft}}%; top: {{previewTop}}%;"/></view></view></view>
          <view class="direction-atlas" wx:for="{{runAtlases}}" wx:key="key"><view class="atlas-heading"><text>奔跑 · {{item.label}}</text><text class="muted">{{item.atlas ? item.atlas.name : '尚未选择'}}</text></view><view class="atlas-actions"><button data-action="run" data-direction="{{item.key}}" bindtap="selectAtlas" disabled="{{busy}}">{{item.atlas ? '重新选择' : '选择12帧图集'}}</button><view class="sprite-preview character-preview" wx:if="{{item.atlas}}"><image src="{{item.atlas.path}}" style="left: {{previewLeft}}%; top: {{previewTop}}%;"/></view></view></view>
        </view>
        <view wx:else class="muted">宠物动作图集：透明 RGBA PNG，4列 × 6行，共24帧；每格128、256或512像素，最大8MB，帧序从左到右、从上到下。</view>
        <view wx:if="{{detail.targetType !== 'character'}}" class="atlas-row"><view class="atlas-copy"><view>行走图集 · 必填</view><text class="muted">{{walk ? walk.name : '从相册选择透明PNG原图，请勿使用截图'}}</text><button wx:if="{{adminSuper || adminPermissions.playgroundAppearance_prepareUpload}}" data-action="walk" bindtap="selectAtlas" disabled="{{busy}}">{{walk ? '重新选择' : '选择24帧图集'}}</button></view><view class="sprite-preview" wx:if="{{walk}}"><image src="{{walk.path}}" style="left: {{previewLeft}}%; top: {{previewTop}}%;"/></view></view>
        <view class="binding-note">发布后仅替换本申请对象的形象。同一套图集不能再次绑定给其他角色或宠物。</view><button wx:if="{{adminSuper || (adminPermissions.playgroundAppearance_publish && adminPermissions.playgroundAppearance_prepareUpload)}}" class="publish-button" bindtap="publish" loading="{{busy}}" disabled="{{busy || (detail.targetType === 'character' ? !allAtlasesReady : !walk)}}">{{busy ? progress : '上传并发布专属形象'}}</button>
      </view>
      <view wx:if="{{detail.canProcess && (adminSuper || adminPermissions.playgroundAppearance_reject)}}" class="reject-section"><view class="section-title">照片不足或暂不能制作</view><textarea value="{{reason}}" maxlength="500" placeholder="说明需要补充哪些照片或未通过原因" bindinput="inputReason" disabled="{{busy}}"/><button wx:if="{{adminSuper || adminPermissions.playgroundAppearance_reject}}" bindtap="reject" disabled="{{busy}}">退回申请</button></view>
      <view wx:if="{{detail.reason}}" class="binding-note">处理说明：{{detail.reason}}</view>
      <view wx:if="{{detail.status === 'completed'}}" class="completed-manage-box">
        <view class="binding-note {{detail.appearanceDisabled ? 'disabled-warning' : ''}}">
          <text wx:if="{{!detail.appearanceDisabled}}">✅ 专属形象正常生效中。这套形象已专属绑定，不能更换绑定对象。</text>
          <text wx:if="{{detail.appearanceDisabled}}">⚠️ 专属形象已暂扣作废{{detail.appearanceDisabledReason ? '（说明：' + detail.appearanceDisabledReason + '）' : ''}}，庄园中显示通用外观。</text>
        </view>
        <view style="margin-top: 18rpx; display: flex; gap: 16rpx;">
          <button class="danger-button" style="background: #993322; color: #fff;" wx:if="{{!detail.appearanceDisabled && (adminSuper || adminPermissions.playgroundAppearance_disableAppearance)}}" bindtap="disableAppearance" disabled="{{busy}}">暂扣作废专属形象</button>
          <button class="publish-button" wx:if="{{detail.appearanceDisabled && (adminSuper || adminPermissions.playgroundAppearance_enableAppearance)}}" bindtap="enableAppearance" disabled="{{busy}}">重新启用专属形象</button>
        </view>
      </view>
    </scroll-view>
  </view></view>
</view>
