<view class="custom-admin">
  <view class="page-heading"><view><view class="page-title">乐园形象定制</view><view class="muted">按申请制作，专属绑定到具体角色或宠物</view></view><button bindtap="refresh" disabled="{{loading || busy}}">刷新</button></view>
  <scroll-view scroll-x class="tabs"><view class="tab {{status === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" data-status="{{item.value}}" bindtap="changeStatus">{{item.label}}</view></scroll-view>
  <view class="error-message" wx:if="{{error}}">{{error}}</view><view class="empty-message" wx:if="{{!loading && !applications.length}}">暂无这类申请</view>
  <view class="request-card" wx:for="{{applications}}" wx:key="_id"><view class="request-heading"><view><view class="request-name">{{item.ownerName}} · {{item.targetType === 'pet' ? item.targetName : '角色形象'}}</view><view class="muted">{{item.targetType === 'pet' ? '宠物定制' : '角色定制'}} · {{item.photos.length}} 张参考照</view></view><text class="status-pill {{item.status}}">{{item.statusText}}</text></view><view class="muted">{{item.timeText}}</view><view class="request-id">{{item._id}}</view><button wx:if="{{adminSuper || adminPermissions.playgroundAppearance_detailAdmin}}" data-id="{{item._id}}" bindtap="openDetail" disabled="{{busy}}">查看申请与照片</button></view>
  <button class="more-button" wx:if="{{hasMore}}" bindtap="loadMore" loading="{{loading}}" disabled="{{loading || busy}}">加载更多</button>
  <view class="detail-backdrop" wx:if="{{detail}}" catchtouchmove="swallow"><view class="detail-panel"><view class="detail-heading"><view><view class="page-title">{{detail.targetName}}</view><view class="muted">申请人 {{detail.ownerName}} · {{detail.statusText}}</view></view><button bindtap="closeDetail" disabled="{{busy}}">关闭</button></view>
    <scroll-view scroll-y class="detail-content"><view class="binding-note">专属对象：{{detail.targetType === 'pet' ? '这只宠物' : '申请人的角色'}}<view class="request-id">{{detail.targetId}}</view></view>
      <view class="section-title">参考照片</view><view class="photo-grid"><image wx:for="{{detail.photoUrls || detail.photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewPhoto"/></view><view class="remark">{{detail.remark || '用户未补充其他说明'}}</view>
      <view wx:if="{{detail.canProcess && (adminSuper || (adminPermissions.playgroundAppearance_prepareUpload && adminPermissions.playgroundAppearance_publish))}}"><view class="section-title">上传完成的动作图集</view><view class="muted">透明 RGBA PNG，4列 × 6行，共24帧；每格128、256或512像素，最大8MB。帧顺序从左到右、从上到下，第1帧作为待机姿势。</view>
        <view class="atlas-row"><view class="atlas-copy"><view>行走图集 · 必填</view><text class="muted">{{walk ? walk.name : '从相册选择透明PNG原图，请勿使用截图'}}</text><button wx:if="{{adminSuper || adminPermissions.playgroundAppearance_prepareUpload}}" data-action="walk" bindtap="selectAtlas" disabled="{{busy}}">{{walk ? '重新选择' : '选择24帧图集'}}</button></view><view class="sprite-preview" wx:if="{{walk}}"><image src="{{walk.path}}" style="left: {{previewLeft}}%; top: {{previewTop}}%;"/></view></view>
        <view class="atlas-row" wx:if="{{detail.targetType === 'character'}}"><view class="atlas-copy"><view>奔跑图集 · 选填</view><text class="muted">{{run ? run.name : '未提供时，奔跑使用行走图集加快播放'}}</text><button wx:if="{{adminSuper || adminPermissions.playgroundAppearance_prepareUpload}}" data-action="run" bindtap="selectAtlas" disabled="{{busy}}">{{run ? '重新选择' : '选择24帧奔跑图集'}}</button><button wx:if="{{run}}" bindtap="removeRun" disabled="{{busy}}">移除奔跑图集</button></view><view class="sprite-preview" wx:if="{{run}}"><image src="{{run.path}}" style="left: {{previewLeft}}%; top: {{previewTop}}%;"/></view></view>
        <view class="binding-note">发布后仅替换本申请对象的形象。同一套图集不能再次绑定给其他角色或宠物。</view><button wx:if="{{adminSuper || (adminPermissions.playgroundAppearance_publish && adminPermissions.playgroundAppearance_prepareUpload)}}" class="publish-button" bindtap="publish" loading="{{busy}}" disabled="{{busy || !walk}}">{{busy ? progress : '上传并发布专属形象'}}</button>
      </view>
      <view wx:if="{{detail.canProcess && (adminSuper || adminPermissions.playgroundAppearance_reject)}}" class="reject-section"><view class="section-title">照片不足或暂不能制作</view><textarea value="{{reason}}" maxlength="500" placeholder="说明需要补充哪些照片或未通过原因" bindinput="inputReason" disabled="{{busy}}"/><button wx:if="{{adminSuper || adminPermissions.playgroundAppearance_reject}}" bindtap="reject" disabled="{{busy}}">退回申请</button></view>
      <view wx:if="{{detail.reason}}" class="binding-note">处理说明：{{detail.reason}}</view><view wx:if="{{detail.status === 'completed'}}" class="binding-note">这套形象已专属绑定，不能更换绑定对象。需要更新形象时，由该用户重新申请。</view>
    </scroll-view>
  </view></view>
</view>
