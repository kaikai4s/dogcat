<view class="admin-vaccine-page {{themeClass}} {{fontClass}}">
  <view class="audit-hero">
    <view class="hero-badge"><text class="remix-icon ri-shield-check-fill"></text><text>宠物健康</text></view>
    <view class="hero-title">宠物疫苗审核</view>
    <view class="hero-desc">审核宠物主提交的疫苗接种证明，通过后宠物资料将展示绿色认证标记。</view>
  </view>

  <view class="status-tabs">
    <view class="status-tab {{activeStatus === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" data-status="{{item.value}}" bindtap="chooseStatus">{{item.label}}</view>
  </view>

  <view class="admin-card search-card-panel">
    <view class="search-field"><text class="remix-icon ri-search-line"></text><input placeholder="搜索宠物名、品种、证书编号" value="{{keyword}}" bindinput="inputKeyword" confirm-type="search" bindconfirm="submitSearch" /></view>
    <view class="filter-actions">
      <button class="primary-btn compact-btn" bindtap="submitSearch">搜索</button>
      <button class="ghost-btn compact-btn" wx:if="{{keyword}}" bindtap="clearSearch">清空</button>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && !applications.length}}"><text class="remix-icon ri-shield-cross-line empty-icon"></text><view>暂无疫苗认证申请。</view></view>

  <view class="admin-card vaccine-card" wx:for="{{applications}}" wx:key="_id">
    <view class="vaccine-head">
      <image class="pet-avatar" wx:if="{{item.petSnapshot.avatarFileId}}" src="{{item.petSnapshot.avatarFileId}}" mode="aspectFill" />
      <view class="pet-avatar empty" wx:else><text class="remix-icon ri-paw-print-line"></text></view>
      <view class="vaccine-main">
        <view class="strong">{{item.petSnapshot.name || '宠物'}} <text class="muted">{{item.petSnapshot.breed || ''}}</text></view>
        <view class="muted">主人：{{item.owner.nickname || item.owner.displayName || item.openid}}</view>
        <view class="muted">提交时间：{{item.createdAt}}</view>
      </view>
      <view class="soft-badge status-{{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="info-line" wx:if="{{item.certificateNo}}">证书编号：{{item.certificateNo}}</view>
    <view class="info-line" wx:if="{{item.validUntil}}">有效期：{{item.validUntil}}</view>
    <view class="info-line" wx:if="{{item.ownerRemark}}">说明：{{item.ownerRemark}}</view>
    <view class="file-row" wx:if="{{item.fileIds && item.fileIds.length}}">
      <image class="file-thumb" wx:for="{{item.fileIds}}" wx:for-item="fileId" wx:key="*this" src="{{fileId}}" mode="aspectFill" data-id="{{item._id}}" data-file="{{fileId}}" bindtap="previewFile" />
    </view>
    <view class="action-row" wx:if="{{item.status === 'pending'}}">
      <button class="ghost-btn compact-btn" data-id="{{item._id}}" bindtap="reject">驳回</button>
      <button class="primary-btn compact-btn" data-id="{{item._id}}" bindtap="approve">通过</button>
    </view>
  </view>

  <view class="load-tip" wx:if="{{loading && applications.length}}">正在加载更多...</view>
  <view class="load-tip" wx:if="{{!loading && applications.length && !hasMore}}">已显示全部申请</view>

  <view class="bottom-nav admin-bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon remix-icon ri-dashboard-3-line"></view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/orders/list/index" bindtap="go"><view class="nav-icon remix-icon ri-file-list-3-line"></view><view>订单</view></view>
    <view class="nav-item active"><view class="nav-icon remix-icon ri-shield-check-fill"></view><view>审核</view></view>
    <view class="nav-item" data-url="/pages/admin/incidents/list/index" bindtap="go"><view class="nav-icon remix-icon ri-alarm-warning-line"></view><view>异常</view></view>
  </view>
</view>
<global-loading />
