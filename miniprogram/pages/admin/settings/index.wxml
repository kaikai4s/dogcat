            <view class="strong-title-row">
              <view class="strong">特殊日期加价规则</view>
              <view class="badge">{{settings.pricingSurcharges.dateSurcharges.length || 0}} 条</view>
            </view>
            <view class="muted" style="margin-bottom: 16rpx;">例如法定节假日、特定周末等全天加价</view>

            <view class="surcharge-rule-item" wx:for="{{settings.pricingSurcharges.dateSurcharges}}" wx:key="id">
              <view class="rule-main">
                <view class="rule-title-line">
                  <text class="rule-tag">{{item.name}}</text>
                  <text class="rule-date">{{item.date}}</text>
                </view>
                <view class="rule-price">加价 +¥{{item.surcharge}}</view>
              </view>
              <view class="rule-actions">
                <switch checked="{{item.enabled !== false}}" data-id="{{item.id}}" bindchange="toggleDateSurchargeItem" />
                <view class="remix-icon ri-delete-bin-line delete-icon" data-id="{{item.id}}" bindtap="deleteDateSurchargeItem"></view>
              </view>
            </view>
            <view class="empty-tip" wx:if="{{!settings.pricingSurcharges.dateSurcharges.length}}">暂无特殊日期加价规则</view>

            <!-- 添加日期加价表单 -->
            <view class="add-rule-panel">
              <view class="form-row-grid">
                <picker mode="date" value="{{newDateRule.date}}" start="{{todayDate}}" bindchange="newDateRuleDateChange">
                  <view class="picker-input-field">{{newDateRule.date || '选择日期'}}</view>
                </picker>
                <input class="input" placeholder="名称(如国庆节)" value="{{newDateRule.name}}" bindinput="newDateRuleNameInput" />
                <input class="input" type="digit" placeholder="金额(¥)" value="{{newDateRule.surcharge}}" bindinput="newDateRuleAmountInput" />
              </view>
              <button class="ghost compact-btn add-btn" bindtap="addDateSurchargeItem">+ 添加日期加价</button>
            </view>
          </view>

          <!-- 2. 特殊时段加价列表 -->
          <view class="setting-block-card">
            <view class="strong-title-row">
              <view class="strong">特殊时段加价规则</view>
              <view class="badge">{{settings.pricingSurcharges.timeSlotSurcharges.length || 0}} 条</view>
            </view>
            <view class="muted" style="margin-bottom: 16rpx;">例如清晨 07:00-09:00 早高峰、晚间 20:00-22:00 等</view>

            <view class="surcharge-rule-item" wx:for="{{settings.pricingSurcharges.timeSlotSurcharges}}" wx:key="id">
              <view class="rule-main">
                <view class="rule-title-line">
                  <text class="rule-tag">{{item.name}}</text>
                  <text class="rule-time">{{item.startTime}} ~ {{item.endTime}}</text>
                </view>
                <view class="rule-price">加价 +¥{{item.surcharge}}</view>
              </view>
              <view class="rule-actions">
                <switch checked="{{item.enabled !== false}}" data-id="{{item.id}}" bindchange="toggleTimeSlotSurchargeItem" />
                <view class="remix-icon ri-delete-bin-line delete-icon" data-id="{{item.id}}" bindtap="deleteTimeSlotSurchargeItem"></view>
              </view>
            </view>
            <view class="empty-tip" wx:if="{{!settings.pricingSurcharges.timeSlotSurcharges.length}}">暂无特殊时段加价规则</view>

            <!-- 添加时段加价表单 -->
            <view class="add-rule-panel">
              <view class="form-row-grid-slot">
                <picker mode="time" value="{{newTimeSlotRule.startTime}}" bindchange="newTimeSlotRuleStartTimeChange">
                  <view class="picker-input-field">{{newTimeSlotRule.startTime || '开始时间'}}</view>
                </picker>
                <text class="time-sep">~</text>
                <picker mode="time" value="{{newTimeSlotRule.endTime}}" bindchange="newTimeSlotRuleEndTimeChange">
                  <view class="picker-input-field">{{newTimeSlotRule.endTime || '结束时间'}}</view>
                </picker>
              </view>
              <view class="form-row-grid-inputs">
                <input class="input" placeholder="名称(如清晨早高峰)" value="{{newTimeSlotRule.name}}" bindinput="newTimeSlotRuleNameInput" />
                <input class="input" type="digit" placeholder="金额(¥)" value="{{newTimeSlotRule.surcharge}}" bindinput="newTimeSlotRuleAmountInput" />
              </view>
              <button class="ghost compact-btn add-btn" bindtap="addTimeSlotSurchargeItem">+ 添加时段加价</button>
            </view>
          </view>
        </view>

        <view wx:if="{{activeSettingPanel === 'realNameVerification'}}" class="setting-modal-section">
          <view class="policy-notice">
            配置聚合数据【手机实名校验】接口的 AppKey。系统将在宠托师申请入驻时，直连三大运营商核验真实姓名、身份证号码与手机号是否一致。
          </view>

          <!-- 接口状态卡片（明确标注状态，避免与输入框混淆） -->
          <view class="juhe-status-card {{settings.juheTelecomKeyConfigured ? 'configured' : 'unconfigured'}}">
            <view class="juhe-status-header">
              <text class="label" style="margin-bottom:0;">接口运行状态</text>
              <text class="juhe-status-tag {{settings.juheTelecomKeyConfigured ? 'success' : 'warning'}}">
                {{settings.juheTelecomKeyConfigured ? '● 已配置真实接口' : '○ 模拟/Mock 测试模式'}}
              </text>
            </view>
            <view class="juhe-status-desc">
              {{settings.juheTelecomKeyConfigured ? ('当前密钥掩码：' + settings.juheTelecomKeyConfigured + '（宠托师入驻已直连三大运营商核验）') : '当前未配置真实 Key。宠托师入驻走本地算法核验，方便测试且不会产生真实扣费。'}}
            </view>
          </view>

          <view class="field-item juhe-key-field">
            <text class="label">输入 / 更新接口 AppKey</text>
            <input class="input juhe-real-input" type="text" maxlength="128" placeholder="请输入聚合数据 AppKey" value="{{settings.juheTelecomKeyInput}}" bindinput="inputJuheKey" cursor-spacing="40" adjust-position="{{true}}" confirm-type="done" />
          </view>

          <view class="policy-notice" style="font-size:22rpx; color:#86909c;">
            💡 提示：在聚合数据「个人中心 → 我的API → 手机实名校验」复制 AppKey 后填入。若留空并直接点击下方【保存设置】，则保持现有密钥不变。
          </view>
        </view>
      </scroll-view>

      <view class="modal-actions">
        <button class="ghost" style="flex: 1;" bindtap="closeSettingModal">关闭</button>
        <button class="primary" style="flex: 2;" disabled="{{saving}}" bindtap="save">{{saving ? '保存中...' : '保存设置'}}</button>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon remix-icon ri-dashboard-3-line"></view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/coupons/index" bindtap="go"><view class="nav-icon remix-icon ri-coupon-3-line"></view><view>优惠券</view></view>
    <view class="nav-item" data-url="/pages/admin/member-levels/index" bindtap="go"><view class="nav-icon remix-icon ri-vip-crown-line"></view><view>等级</view></view>
    <view class="nav-item active"><view class="nav-icon remix-icon ri-settings-4-line"></view><view>设置</view></view>
  </view>
</view>
<global-loading />
