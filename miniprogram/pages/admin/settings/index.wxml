          <view class="field-item"><text class="label">宠托师出发通知模板</text><input class="input" value="{{settings.subscription.templates.staffDeparture}}" data-field="staffDeparture" bindinput="subscriptionTemplateInput" placeholder="填写宠托师出发通知模板 ID" /></view>
