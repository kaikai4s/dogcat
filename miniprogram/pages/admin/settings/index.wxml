            <button wx:if="{{item.status === 'failed' || item.status === 'skipped'}}" class="ghost-btn" data-id="{{item.id}}" bindtap="retrySubscriptionDelivery"><text class="remix-icon ri-restart-line"></text><text>重试</text></button>
          </view>
