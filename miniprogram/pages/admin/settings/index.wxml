<view class="{{themeClass}} {{fontClass}} page settings-page">
  <view class="dashboard-header">
    <view class="badge">管理端</view>
    <view class="title">系统设置</view>
    <view class="tip">点击配置组进入弹框编辑，底部统一保存。</view>
  </view>

  <view class="settings-grid">
    <view class="admin-compact-card setting-overview-card" data-panel="debug" bindtap="openSettingModal">
      <view class="admin-summary-row">
        <view class="admin-summary-main">
          <view class="admin-summary-title">开发调试</view>
          <view class="admin-summary-sub">{{settingSummary.debug}}</view>
        </view>
        <view class="meta-chip {{settings.enableTestAddressMode ? 'warning' : ''}}">{{settings.enableTestAddressMode ? '联调中' : '关闭'}}</view>
      </view>
      <view class="setting-summary-line">地图选点测试开关，正式上线前保持关闭。</view>
    </view>

    <view class="admin-compact-card setting-overview-card" data-panel="petBreedAi" bindtap="openSettingModal">
      <view class="admin-summary-row">
        <view class="admin-summary-main">
          <view class="admin-summary-title">宠物档案 AI</view>
          <view class="admin-summary-sub">{{settingSummary.petBreedAi}}</view>
        </view>
        <view class="meta-chip {{settings.enablePetBreedAi ? 'success' : 'warning'}}">{{settings.enablePetBreedAi ? '开启' : '关闭'}}</view>
      </view>
      <view class="setting-summary-line">控制前台宠物档案“AI 识别种类/品种”按钮。</view>
    </view>

    <view class="admin-compact-card setting-overview-card" data-panel="payment" bindtap="openSettingModal">
      <view class="admin-summary-row">
        <view class="admin-summary-main">
          <view class="admin-summary-title">支付与退款</view>
          <view class="admin-summary-sub">{{settingSummary.payment}}</view>
        </view>
        <view class="meta-chip chip-primary">编辑</view>
      </view>
      <view class="meta-chip-row">
        <view class="meta-chip {{settings.payment.enabled ? 'success' : ''}}">{{settings.payment.enabled ? '支付开' : '支付关'}}</view>
        <view class="meta-chip">{{settings.payment.mode === 'wechat' ? '微信支付' : '模拟支付'}}</view>
        <view class="meta-chip {{settings.payment.refundEnabled ? 'success' : ''}}">{{settings.payment.refundEnabled ? '退款开' : '退款关'}}</view>
      </view>
    </view>

    <view class="admin-compact-card setting-overview-card" data-panel="subscription" bindtap="openSettingModal">
      <view class="admin-summary-row">
        <view class="admin-summary-main">
          <view class="admin-summary-title">订阅消息</view>
          <view class="admin-summary-sub">{{settingSummary.subscription}}</view>
        </view>
        <view class="meta-chip chip-primary">编辑</view>
      </view>
      <view class="setting-summary-line">模板未配置时只记录 skipped，不影响业务。</view>
    </view>

    <view class="admin-compact-card setting-overview-card" data-panel="customerService" bindtap="openSettingModal">
      <view class="admin-summary-row">
        <view class="admin-summary-main">
          <view class="admin-summary-title">客服与转接</view>
          <view class="admin-summary-sub">{{settingSummary.customerService}}</view>
        </view>
        <view class="meta-chip chip-primary">编辑</view>
      </view>
      <view class="setting-summary-line">宠托师异常联系平台客服，由管理员转接处理。</view>
    </view>

    <view class="admin-compact-card setting-overview-card" data-panel="checkinShare" bindtap="openSettingModal">
      <view class="admin-summary-row">
        <view class="admin-summary-main">
          <view class="admin-summary-title">签到分享卡片</view>
          <view class="admin-summary-sub">{{settingSummary.checkinShare}}</view>
        </view>
        <view class="meta-chip chip-primary">编辑</view>
      </view>
      <view class="setting-summary-line">配置签到中心邀请好友分享标题和封面。</view>
    </view>

    <view class="admin-compact-card setting-overview-card" data-panel="settlementReliability" bindtap="openSettingModal">
      <view class="admin-summary-row">
        <view class="admin-summary-main">
          <view class="admin-summary-title">结算与可靠性</view>
          <view class="admin-summary-sub">{{settingSummary.settlementReliability}}</view>
        </view>
        <view class="meta-chip chip-primary">编辑</view>
      </view>
      <view class="setting-summary-line">提现门槛、分成比例、轨迹补传和重试参数。</view>
    </view>

    <view class="admin-compact-card setting-overview-card" data-panel="carousel" bindtap="openSettingModal">
      <view class="admin-summary-row">
        <view class="admin-summary-main">
          <view class="admin-summary-title">首页顶部轮播</view>
          <view class="admin-summary-sub">{{settingSummary.carousel}}</view>
        </view>
        <view class="meta-chip chip-primary">管理</view>
      </view>
      <view class="meta-chip-row">
        <view class="meta-chip {{settings.homeHeroCarousel.enabled ? 'success' : ''}}">{{settings.homeHeroCarousel.enabled ? '已启用' : '已关闭'}}</view>
        <view class="meta-chip">{{settings.homeHeroCarousel.autoRotate ? '自动轮换' : '手动展示'}}</view>
        <view class="meta-chip">{{settings.homeHeroCarousel.rotateIntervalSec}} 秒</view>
      </view>
    </view>

    <view class="admin-compact-card setting-overview-card" data-panel="homePage" bindtap="openSettingModal">
      <view class="admin-summary-row">
        <view class="admin-summary-main">
          <view class="admin-summary-title">首页转化模块</view>
          <view class="admin-summary-sub">{{settingSummary.homePage}}</view>
        </view>
        <view class="meta-chip chip-primary">编辑</view>
      </view>
      <view class="setting-summary-line">控制首页 CTA、优惠、精选宠托师、活动入口等模块。</view>
    </view>

    <view class="admin-compact-card setting-overview-card" data-panel="staffTraining" bindtap="openSettingModal">
      <view class="admin-summary-row">
        <view class="admin-summary-main">
          <view class="admin-summary-title">宠托师培训</view>
          <view class="admin-summary-sub">{{settingSummary.staffTraining}}</view>
        </view>
        <view class="meta-chip chip-primary">配置</view>
      </view>
      <view class="setting-summary-line">配置宠托师培训视频、题目、选项、正确答案和及格分数。</view>
    </view>
  </view>

  <button class="primary save-settings-btn" disabled="{{saving}}" bindtap="save">{{saving ? '保存中...' : '保存全局设置'}}</button>

  <view class="modal-backdrop" wx:if="{{showSettingModal}}" bindtap="closeSettingModal" catchtouchmove="noop">
    <view class="modal-card settings-modal-card" catchtap="noop">
      <view class="modal-header">
        <view class="modal-title" wx:if="{{activeSettingPanel === 'debug'}}">开发调试</view>
        <view class="modal-title" wx:if="{{activeSettingPanel === 'petBreedAi'}}">宠物档案 AI</view>
        <view class="modal-title" wx:if="{{activeSettingPanel === 'payment'}}">支付与退款</view>
        <view class="modal-title" wx:if="{{activeSettingPanel === 'subscription'}}">订阅消息</view>
        <view class="modal-title" wx:if="{{activeSettingPanel === 'customerService'}}">客服与转接</view>
        <view class="modal-title" wx:if="{{activeSettingPanel === 'checkinShare'}}">签到分享卡片</view>
        <view class="modal-title" wx:if="{{activeSettingPanel === 'settlementReliability'}}">结算与可靠性</view>
        <view class="modal-title" wx:if="{{activeSettingPanel === 'carousel'}}">首页顶部轮播</view>
        <view class="modal-title" wx:if="{{activeSettingPanel === 'homePage'}}">首页转化模块</view>
        <view class="modal-title" wx:if="{{activeSettingPanel === 'staffTraining'}}">宠托师培训</view>
        <view class="modal-close" bindtap="closeSettingModal">×</view>
      </view>

      <scroll-view scroll-y class="modal-scroll-body settings-modal-scroll">
        <view wx:if="{{activeSettingPanel === 'debug'}}" class="setting-modal-section">
          <view class="compact-toggle-row">
            <view class="compact-toggle-main">
              <view class="strong">开启测试地址模式</view>
              <view class="muted">开启后选择服务位置时直接打开微信地图选点。</view>
            </view>
            <switch checked="{{settings.enableTestAddressMode}}" bindchange="toggleTestAddressMode" />
          </view>
          <view class="notice" wx:if="{{settings.enableTestAddressMode}}">当前构建已关闭 __usePrivacyCheck__；正式上线前请关闭该模式并恢复隐私校验。</view>
        </view>

        <view wx:if="{{activeSettingPanel === 'petBreedAi'}}" class="setting-modal-section">
          <view class="compact-toggle-row">
            <view class="compact-toggle-main">
              <view class="strong">启用宠物种类/品种 AI 识别</view>
              <view class="muted">关闭后，前台宠物档案不再显示 AI 识别按钮，后端接口也会拒绝识别请求。</view>
            </view>
            <switch checked="{{settings.enablePetBreedAi}}" bindchange="togglePetBreedAi" />
          </view>
          <view class="notice">该开关只控制宠物档案照片识别种类/品种功能，不影响手动填写宠物资料。</view>
        </view>

        <view wx:if="{{activeSettingPanel === 'payment'}}" class="setting-modal-section">
          <view class="compact-toggle-row">
            <view class="compact-toggle-main"><view class="strong">启用支付</view><view class="muted">关闭后用户不能发起支付。</view></view>
            <switch checked="{{settings.payment.enabled}}" bindchange="togglePaymentEnabled" />
          </view>
          <view class="field-item"><text class="label">支付模式</text><radio-group bindchange="paymentModeChange" class="radio-group"><label class="radio-label"><radio value="mock" checked="{{settings.payment.mode === 'mock'}}" /> 模拟支付</label><label class="radio-label"><radio value="wechat" checked="{{settings.payment.mode === 'wechat'}}" /> 微信支付</label></radio-group></view>
          <view class="field-item"><text class="label">商户号</text><input class="input" value="{{settings.payment.mchId}}" data-field="mchId" bindinput="paymentInput" placeholder="微信支付商户号" /></view>
          <view class="field-item"><text class="label">AppID</text><input class="input" value="{{settings.payment.appId}}" data-field="appId" bindinput="paymentInput" placeholder="小程序 AppID" /></view>
          <view class="field-item"><text class="label">支付回调地址</text><input class="input" value="{{settings.payment.notifyUrl}}" data-field="notifyUrl" bindinput="paymentInput" placeholder="https://..." /></view>
          <view class="field-item"><text class="label">证书序列号</text><input class="input" value="{{settings.payment.certSerialNo}}" data-field="certSerialNo" bindinput="paymentInput" placeholder="商户 API 证书序列号" /></view>
          <view class="field-item"><text class="label">API v3 Key</text><input class="input" password value="{{settings.payment.apiV3KeyInput}}" data-field="apiV3KeyInput" bindinput="paymentInput" placeholder="{{settings.payment.apiV3KeyConfigured ? '已配置，留空不修改' : '请输入 API v3 Key'}}" /></view>
          <view class="field-item"><text class="label">商户私钥</text><textarea class="input textarea-input" value="{{settings.payment.privateKeyInput}}" data-field="privateKeyInput" bindinput="paymentInput" placeholder="{{settings.payment.privateKeyConfigured ? '已配置，留空不修改' : '请输入 PEM 私钥'}}" /></view>
          <view class="field-item"><text class="label">平台公钥</text><textarea class="input textarea-input" value="{{settings.payment.platformPublicKeyInput}}" data-field="platformPublicKeyInput" bindinput="paymentInput" placeholder="{{settings.payment.platformPublicKeyConfigured ? '已配置，留空不修改' : '用于回调验签的微信支付平台公钥'}}" /></view>
          <view class="notice">密钥只提交到云函数，不会在前端回显。</view>
          <view class="compact-toggle-row"><view class="compact-toggle-main"><view class="strong">启用退款</view><view class="muted">开启后取消已支付订单会生成退款单。</view></view><switch checked="{{settings.payment.refundEnabled}}" bindchange="toggleRefundEnabled" /></view>
          <view class="compact-toggle-row"><view class="compact-toggle-main"><view class="strong">允许正式环境模拟支付</view><view class="muted">仅测试联调用，正式上线前应关闭。</view></view><switch checked="{{settings.payment.allowMockInProduction}}" bindchange="toggleAllowMockInProduction" /></view>
        </view>

        <view wx:if="{{activeSettingPanel === 'subscription'}}" class="setting-modal-section">
          <view class="compact-toggle-row"><view class="compact-toggle-main"><view class="strong">启用订阅消息</view><view class="muted">模板未配置时只记录 skipped 日志。</view></view><switch checked="{{settings.subscription.enabled}}" bindchange="toggleSubscriptionEnabled" /></view>
          <view class="field-item"><text class="label">支付成功模板</text><input class="input" value="{{settings.subscription.templates.orderPaid}}" data-field="orderPaid" bindinput="subscriptionTemplateInput" /></view>
          <view class="field-item"><text class="label">接单/派单模板</text><input class="input" value="{{settings.subscription.templates.orderAssigned}}" data-field="orderAssigned" bindinput="subscriptionTemplateInput" /></view>
          <view class="field-item"><text class="label">师傅接单模板</text><input class="input" value="{{settings.subscription.templates.orderAccepted}}" data-field="orderAccepted" bindinput="subscriptionTemplateInput" placeholder="收到师傅接单通知模板 ID" /></view>
          <view class="field-item"><text class="label">服务开始模板</text><input class="input" value="{{settings.subscription.templates.serviceStart}}" data-field="serviceStart" bindinput="subscriptionTemplateInput" /></view>
          <view class="field-item"><text class="label">服务完成模板</text><input class="input" value="{{settings.subscription.templates.serviceFinish}}" data-field="serviceFinish" bindinput="subscriptionTemplateInput" /></view>
          <view class="field-item"><text class="label">开锁请求模板</text><input class="input" value="{{settings.subscription.templates.remoteUnlock}}" data-field="remoteUnlock" bindinput="subscriptionTemplateInput" /></view>
          <view class="field-item"><text class="label">退款结果模板</text><input class="input" value="{{settings.subscription.templates.refundResult}}" data-field="refundResult" bindinput="subscriptionTemplateInput" /></view>
          <view class="field-item"><text class="label">纠纷更新模板</text><input class="input" value="{{settings.subscription.templates.disputeUpdate}}" data-field="disputeUpdate" bindinput="subscriptionTemplateInput" /></view>
          <view class="field-item"><text class="label">提现结果模板</text><input class="input" value="{{settings.subscription.templates.withdrawResult}}" data-field="withdrawResult" bindinput="subscriptionTemplateInput" /></view>
        </view>

        <view wx:if="{{activeSettingPanel === 'customerService'}}" class="setting-modal-section">
          <view class="notice">宠托师无法直接查看用户电话。远程开门或异常情况由平台客服转接。</view>
          <view class="field-item"><text class="label">客服电话</text><input class="input" value="{{settings.customerService.phone}}" data-field="phone" bindinput="customerServiceInput" placeholder="宠托师联系平台的电话" /></view>
          <view class="field-item"><text class="label">客服微信</text><input class="input" value="{{settings.customerService.wechatId}}" data-field="wechatId" bindinput="customerServiceInput" placeholder="可选，客服微信号" /></view>
          <view class="field-item"><text class="label">工作时间</text><input class="input" value="{{settings.customerService.workHours}}" data-field="workHours" bindinput="customerServiceInput" placeholder="例如：每天 9:00-21:00" /></view>
          <view class="field-item"><text class="label">公众号名称</text><input class="input" value="{{settings.customerService.officialAccountName}}" data-field="officialAccountName" bindinput="customerServiceInput" placeholder="可选" /></view>
        </view>

        <view wx:if="{{activeSettingPanel === 'checkinShare'}}" class="setting-modal-section">
          <view class="field-item"><text class="label">分享卡片标题</text><input class="input" value="{{settings.checkinShare.title}}" data-field="title" bindinput="checkinShareInput" placeholder="例如：来签到领福利，补签卡也能拿" /></view>
          <view class="field-item">
            <text class="label">封面图片</text>
            <view class="checkin-share-upload" bindtap="chooseCheckinShareImage">
              <image wx:if="{{settings.checkinShare.imageTempUrl}}" class="checkin-share-preview" src="{{settings.checkinShare.imageTempUrl}}" mode="aspectFill" />
              <view wx:else class="checkin-share-placeholder"><text class="remix-icon ri-image-add-line"></text><text>{{uploadingCheckinShareImage ? '上传中...' : '上传分享封面图'}}</text></view>
            </view>
            <view class="checkin-share-file" wx:if="{{settings.checkinShare.imageUrl}}">{{settings.checkinShare.imageUrl}}</view>
          </view>
        </view>

        <view wx:if="{{activeSettingPanel === 'settlementReliability'}}" class="setting-modal-section">
          <view class="field-item"><text class="label">宠托师分成比例</text><input class="input" type="digit" value="{{settings.settlement.staffCommissionRate}}" data-field="staffCommissionRate" bindinput="settlementInput" /></view>
          <view class="field-item"><text class="label">结算等待天数</text><input class="input" type="number" value="{{settings.settlement.settlementDelayDays}}" data-field="settlementDelayDays" bindinput="settlementInput" /></view>
          <view class="field-item"><text class="label">最低提现金额</text><input class="input" type="digit" value="{{settings.settlement.minWithdrawAmount}}" data-field="minWithdrawAmount" bindinput="settlementInput" /></view>
          <view class="field-item"><text class="label">提现手续费比例</text><input class="input" type="digit" value="{{settings.settlement.withdrawFeeRate}}" data-field="withdrawFeeRate" bindinput="settlementInput" /></view>
          <view class="compact-toggle-row"><view class="compact-toggle-main"><view class="strong">启用离线补传</view><view class="muted">弱网轨迹和打卡可本地排队后补传。</view></view><switch checked="{{settings.reliability.enableOfflineQueue}}" bindchange="toggleOfflineQueue" /></view>
          <view class="field-item"><text class="label">轨迹批量大小</text><input class="input" type="number" value="{{settings.reliability.maxTrackBatchSize}}" data-field="maxTrackBatchSize" bindinput="reliabilityInput" /></view>
          <view class="field-item"><text class="label">最大重试次数</text><input class="input" type="number" value="{{settings.reliability.maxRetryTimes}}" data-field="maxRetryTimes" bindinput="reliabilityInput" /></view>
        </view>

        <view wx:if="{{activeSettingPanel === 'carousel'}}" class="setting-modal-section">
          <view class="compact-toggle-row"><view class="compact-toggle-main"><view class="strong">启用首页轮播 Hero</view><view class="muted">关闭时首页显示默认静态 Hero。</view></view><switch checked="{{settings.homeHeroCarousel.enabled}}" bindchange="toggleCarouselEnabled" /></view>
          <view class="compact-toggle-row"><view class="compact-toggle-main"><view class="strong">自动轮换</view><view class="muted">视频播放时会自动暂停。</view></view><switch checked="{{settings.homeHeroCarousel.autoRotate}}" bindchange="toggleCarouselAutoRotate" /></view>
          <view class="field-item" wx:if="{{settings.homeHeroCarousel.autoRotate}}"><text class="label">轮换间隔（秒）</text><input class="input" type="number" value="{{settings.homeHeroCarousel.rotateIntervalSec}}" placeholder="例如 5" bindinput="inputIntervalSec" /></view>

          <view class="section-title-row between"><text class="section-title">轮播素材 ({{settings.homeHeroCarousel.items.length}} / 5)</text><button class="small-btn primary-btn" wx:if="{{settings.homeHeroCarousel.items.length < 5}}" bindtap="startAddItem">添加</button></view>
          <view class="carousel-list" wx:if="{{settings.homeHeroCarousel.items.length > 0}}">
            <view class="carousel-compact-item" wx:for="{{settings.homeHeroCarousel.items}}" wx:key="id">
              <view class="item-preview"><image wx:if="{{item.type === 'image'}}" src="{{item.tempUrl}}" mode="aspectFill" class="preview-img" /><view wx:else class="preview-video-box"><image src="{{item.posterTempUrl || item.tempUrl}}" mode="aspectFill" class="preview-img" /><view class="video-tag">视频</view></view></view>
              <view class="item-info"><view class="item-title-line"><text class="item-title">{{item.title || '(无标题)'}}</text><text class="badge-type">{{item.type === 'video' ? '视频' : '图片'}}</text></view><view class="item-sub" wx:if="{{item.subtitle}}">{{item.subtitle}}</view><view class="item-meta">排序 {{item.sort}} · {{item.enabled !== false ? '已启用' : '已禁用'}}</view></view>
              <view class="item-actions"><switch checked="{{item.enabled !== false}}" data-index="{{index}}" bindchange="toggleItemEnabled" class="mini-switch" /><button class="mini-btn" data-index="{{index}}" bindtap="startEditItem">编辑</button><button class="mini-btn danger" data-index="{{index}}" bindtap="deleteItem">删除</button></view>
            </view>
          </view>
          <view class="empty-tip" wx:else>暂无轮播素材，请点击添加。</view>

          <view class="edit-form-box" wx:if="{{showCarouselEditor}}">
            <view class="form-title">{{editingIndex >= 0 ? '编辑轮播素材' : '新增轮播素材'}}</view>
            <view class="field-item"><text class="label">素材类型</text><radio-group bindchange="typeChange" class="radio-group"><label class="radio-label"><radio value="image" checked="{{editingItem.type === 'image'}}" /> 图片</label><label class="radio-label"><radio value="video" checked="{{editingItem.type === 'video'}}" /> 视频</label></radio-group></view>
            <view class="field-item"><text class="label">{{editingItem.type === 'video' ? '视频文件' : '图片文件'}}</text><view class="upload-trigger" bindtap="chooseMediaFile"><view wx:if="{{editingItem.tempUrl}}" class="upload-preview-box"><image wx:if="{{editingItem.type === 'image'}}" src="{{editingItem.tempUrl}}" mode="aspectFill" class="upload-preview" /><text wx:else class="upload-preview-text">视频已选择/上传 (FileID: {{editingItem.fileId}})</text></view><view wx:else class="upload-placeholder">+ 上传{{editingItem.type === 'video' ? '视频' : '图片'}}</view></view></view>
            <view class="field-item" wx:if="{{editingItem.type === 'video'}}"><text class="label">视频封面图 (必填)</text><view class="upload-trigger" bindtap="choosePosterFile"><view wx:if="{{editingItem.posterTempUrl}}" class="upload-preview-box"><image src="{{editingItem.posterTempUrl}}" mode="aspectFill" class="upload-preview" /></view><view wx:else class="upload-placeholder">+ 上传视频封面图片</view></view></view>
            <view class="field-item"><text class="label">主标题</text><input class="input" value="{{editingItem.title}}" placeholder="如：专业的上门宠托服务" data-field="title" bindinput="editingInput" /></view>
            <view class="field-item"><text class="label">副标题</text><input class="input" value="{{editingItem.subtitle}}" placeholder="如：安全 · 贴心 · 实时反馈" data-field="subtitle" bindinput="editingInput" /></view>
            <view class="field-item"><text class="label">排序权重</text><input class="input" type="number" value="{{editingItem.sort}}" placeholder="数字越小越靠前" data-field="sort" bindinput="editingInput" /></view>
            <view class="compact-toggle-row"><text class="label">状态启用</text><switch checked="{{editingItem.enabled !== false}}" bindchange="toggleEditingEnabled" /></view>
            <view class="form-btn-row"><button class="mini-btn default" bindtap="cancelEditItem">取消</button><button class="mini-btn primary" bindtap="saveEditingItem">暂存到列表</button></view>
          </view>
        </view>

        <view wx:if="{{activeSettingPanel === 'homePage'}}" class="setting-modal-section">
          <view class="field-item"><text class="label">预约 CTA 标题</text><input class="input" value="{{settings.homePage.ctaTitle}}" data-field="ctaTitle" bindinput="homePageInput" /></view>
          <view class="field-item"><text class="label">预约 CTA 副标题</text><input class="input" value="{{settings.homePage.ctaSubtitle}}" data-field="ctaSubtitle" bindinput="homePageInput" /></view>
          <view class="field-item"><text class="label">预约按钮文案</text><input class="input" value="{{settings.homePage.ctaText}}" data-field="ctaText" bindinput="homePageInput" /></view>
          <view class="field-item"><text class="label">再次预约标题</text><input class="input" value="{{settings.homePage.repeatTitle}}" data-field="repeatTitle" bindinput="homePageInput" /></view>
          <view class="field-item"><text class="label">新人优惠标题</text><input class="input" value="{{settings.homePage.couponTitle}}" data-field="couponTitle" bindinput="homePageInput" /></view>
          <view class="field-item"><text class="label">保障说明标题</text><input class="input" value="{{settings.homePage.assuranceTitle}}" data-field="assuranceTitle" bindinput="homePageInput" /></view>
          <view class="section-title-row"><text class="section-title">首页模块开关</text></view>
          <view class="module-switch-row"><text>核心预约 CTA</text><switch checked="{{settings.homePage.modules.quickBooking !== false}}" data-key="quickBooking" bindchange="toggleHomeModule" /></view>
          <view class="module-switch-row"><text>附近宠托师入口</text><switch checked="{{settings.homePage.modules.nearbySitters !== false}}" data-key="nearbySitters" bindchange="toggleHomeModule" /></view>
          <view class="module-switch-row"><text>再次预约</text><switch checked="{{settings.homePage.modules.repeatBooking !== false}}" data-key="repeatBooking" bindchange="toggleHomeModule" /></view>
          <view class="module-switch-row"><text>热门服务卡</text><switch checked="{{settings.homePage.modules.hotServices !== false}}" data-key="hotServices" bindchange="toggleHomeModule" /></view>
          <view class="module-switch-row"><text>新人优惠</text><switch checked="{{settings.homePage.modules.newbieCoupon !== false}}" data-key="newbieCoupon" bindchange="toggleHomeModule" /></view>
          <view class="module-switch-row"><text>精选宠托师</text><switch checked="{{settings.homePage.modules.featuredSitters !== false}}" data-key="featuredSitters" bindchange="toggleHomeModule" /></view>
          <view class="module-switch-row"><text>平台保障</text><switch checked="{{settings.homePage.modules.platformAssurance !== false}}" data-key="platformAssurance" bindchange="toggleHomeModule" /></view>
          <view class="module-switch-row"><text>历史服务统计</text><switch checked="{{settings.homePage.modules.historyStats !== false}}" data-key="historyStats" bindchange="toggleHomeModule" /></view>
          <view class="module-switch-row"><text>抽奖活动横幅</text><switch checked="{{settings.homePage.modules.lottery !== false}}" data-key="lottery" bindchange="toggleHomeModule" /></view>
          <view class="module-switch-row"><text>最美宠物活动</text><switch checked="{{settings.homePage.modules.petBeautyActivity !== false}}" data-key="petBeautyActivity" bindchange="toggleHomeModule" /></view>
        </view>

        <view wx:if="{{activeSettingPanel === 'staffTraining'}}" class="setting-modal-section">
          <view class="section-title-row between"><text class="section-title">培训视频</text><button class="small-btn primary-btn" bindtap="addTrainingVideo">添加视频</button></view>
          <view class="notice">视频上传后请点击底部“保存设置”；员工端将优先通过播放完成记录观看。</view>
          <view class="quiz-edit-card" wx:for="{{settings.staffTraining.videos}}" wx:key="key" wx:for-item="v" wx:for-index="vIndex">
            <view class="quiz-card-header">
              <view class="form-title">视频 {{vIndex + 1}}</view>
              <view class="item-actions"><switch checked="{{v.enabled !== false}}" data-index="{{vIndex}}" bindchange="toggleTrainingVideoEnabled" class="mini-switch" /><button class="mini-btn danger" data-index="{{vIndex}}" bindtap="deleteTrainingVideo">删除</button></view>
            </view>
            <view class="field-item"><text class="label">标题</text><input class="input" value="{{v.title}}" data-index="{{vIndex}}" data-field="title" bindinput="trainingVideoInput" placeholder="例如：平台服务规范" /></view>
            <view class="field-item"><text class="label">说明</text><input class="input" value="{{v.description}}" data-index="{{vIndex}}" data-field="description" bindinput="trainingVideoInput" placeholder="视频内容说明" /></view>
            <view class="field-item"><text class="label">时长文案</text><input class="input" value="{{v.durationText}}" data-index="{{vIndex}}" data-field="durationText" bindinput="trainingVideoInput" placeholder="例如：约 5 分钟" /></view>
            <view class="field-item"><text class="label">排序</text><input class="input" type="number" value="{{v.sort}}" data-index="{{vIndex}}" data-field="sort" bindinput="trainingVideoInput" placeholder="数字越小越靠前" /></view>
            <view class="field-item">
              <text class="label">视频文件</text>
              <view class="upload-trigger" data-index="{{vIndex}}" bindtap="chooseTrainingVideoFile"><view wx:if="{{v.tempUrl}}" class="upload-placeholder">已上传视频，点击重新上传</view><view wx:else class="upload-placeholder">{{uploadingTrainingVideo ? '上传中...' : '+ 上传培训视频'}}</view></view>
              <view class="checkin-share-file" wx:if="{{v.fileId}}">{{v.fileId}}</view>
            </view>
            <view class="field-item">
              <text class="label">视频封面</text>
              <view class="upload-trigger" data-index="{{vIndex}}" bindtap="chooseTrainingPosterFile"><view wx:if="{{v.posterTempUrl}}" class="upload-preview-box"><image src="{{v.posterTempUrl}}" mode="aspectFill" class="upload-preview" /></view><view wx:else class="upload-placeholder">{{uploadingTrainingPoster ? '上传中...' : '+ 上传视频封面'}}</view></view>
            </view>
          </view>
          <view class="empty-tip" wx:if="{{!settings.staffTraining.videos.length}}">暂无培训视频，请点击添加视频。</view>

          <view class="section-title-row between"><text class="section-title">培训答题</text><button class="small-btn primary-btn" bindtap="addQuizQuestion">新增题目</button></view>
          <view class="field-item"><text class="label">及格分数</text><input class="input" type="number" value="{{settings.staffTraining.passScore}}" bindinput="trainingPassScoreInput" placeholder="1-100" /></view>
          <view class="notice">员工端只会看到题目和选项，不会返回正确答案。</view>
          <view class="quiz-edit-card" wx:for="{{settings.staffTraining.quiz}}" wx:key="id" wx:for-item="q" wx:for-index="qIndex">
            <view class="quiz-card-header">
              <view class="form-title">题目 {{qIndex + 1}}</view>
              <button class="mini-btn danger" data-index="{{qIndex}}" bindtap="deleteQuizQuestion">删除题目</button>
            </view>
            <view class="field-item"><text class="label">题干</text><input class="input" value="{{q.question}}" data-index="{{qIndex}}" bindinput="quizQuestionInput" placeholder="请输入题目内容" /></view>
            <view class="field-item">
              <text class="label">正确答案</text>
              <radio-group class="radio-group" data-index="{{qIndex}}" bindchange="quizAnswerChange">
                <label class="radio-label" wx:for="{{q.options}}" wx:key="value" wx:for-item="opt" wx:for-index="optIndex"><radio value="{{opt.value}}" checked="{{q.answer === opt.value}}" /> {{opt.value}}</label>
              </radio-group>
            </view>
            <view class="quiz-option-row" wx:for="{{q.options}}" wx:key="value" wx:for-item="opt" wx:for-index="optIndex">
              <view class="quiz-option-tag">{{opt.value}}</view>
              <input class="input quiz-option-input" value="{{opt.label}}" data-question-index="{{qIndex}}" data-option-index="{{optIndex}}" bindinput="quizOptionInput" placeholder="选项内容" />
              <button class="mini-btn danger" data-question-index="{{qIndex}}" data-option-index="{{optIndex}}" bindtap="deleteQuizOption">删</button>
            </view>
            <button class="mini-btn primary" data-index="{{qIndex}}" bindtap="addQuizOption">添加选项</button>
          </view>
        </view>
      </scroll-view>

      <view class="modal-actions">
        <button class="ghost" style="flex: 1;" bindtap="closeSettingModal">关闭</button>
        <button class="primary" style="flex: 2;" disabled="{{saving}}" bindtap="save">{{saving ? '保存中...' : '保存设置'}}</button>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon remix-icon ri-dashboard-3-line"></view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/coupons/index" bindtap="go"><view class="nav-icon remix-icon ri-coupon-3-line"></view><view>优惠券</view></view>
    <view class="nav-item" data-url="/pages/admin/member-levels/index" bindtap="go"><view class="nav-icon remix-icon ri-vip-crown-line"></view><view>等级</view></view>
    <view class="nav-item active"><view class="nav-icon remix-icon ri-settings-4-line"></view><view>设置</view></view>
  </view>
</view>
