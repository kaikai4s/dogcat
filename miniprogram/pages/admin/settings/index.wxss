.settings-page {
  padding-bottom: 180rpx;
}

.policy-notice {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fff8ec;
  color: #72543b;
  font-size: 25rpx;
  line-height: 1.6;
}
.danger-notice { background: #fff0f0; color: #a32929; }
.report-json { min-height: 260rpx; font-family: monospace; }

.settings-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.setting-overview-card {
  padding: 22rpx 24rpx;
}

.setting-summary-line {
  color: #7b7f88;
  font-size: 24rpx;
  line-height: 1.45;
  margin-top: 12rpx;
}

.save-settings-btn {
  margin: 28rpx 0 16rpx;
}

.settings-modal-card {
  max-height: 86vh;
}

.settings-modal-scroll {
  max-height: 62vh;
}

.setting-modal-section {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.compact-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f2f4;
}

.compact-toggle-row:last-child {
  border-bottom: 0;
}

.compact-toggle-main {
  flex: 1;
  min-width: 0;
}

.field-item {
  margin-bottom: 18rpx;
}

.field-item .label,
.label {
  font-size: 26rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.field-item .input,
.input {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #333;
  min-height: 78rpx;
}

.textarea-input {
  min-height: 180rpx;
  line-height: 1.45;
}

.picker-display {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  color: #333;
  min-height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999;
}

.radio-group {
  display: flex;
  gap: 28rpx;
  flex-wrap: wrap;
  padding: 8rpx 0;
}

.radio-label {
  font-size: 26rpx;
  color: #333;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-title-row {
  align-items: center;
  margin: 14rpx 0 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #2f3440;
}

.small-btn {
  font-size: 24rpx;
  padding: 6rpx 22rpx;
  border-radius: 24rpx;
  line-height: 1.6;
}

.primary-btn {
  background: #07c160;
  color: #fff;
}

.carousel-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.carousel-compact-item {
  display: flex;
  align-items: center;
  background: #f9fafb;
  border-radius: 18rpx;
  padding: 16rpx;
  gap: 16rpx;
}

.item-preview {
  width: 104rpx;
  height: 104rpx;
  border-radius: 14rpx;
  overflow: hidden;
  position: relative;
  background: #eee;
  flex-shrink: 0;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-video-box {
  width: 100%;
  height: 100%;
  position: relative;
}

.video-tag {
  position: absolute;
  bottom: 6rpx;
  right: 6rpx;
  background: rgba(0, 0, 0, 0.64);
  color: #fff;
  font-size: 19rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.item-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.badge-type {
  font-size: 20rpx;
  background: #e8f4ff;
  color: #1890ff;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.item-sub {
  font-size: 23rpx;
  color: #666;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-link {
  font-size: 21rpx;
  color: #1890ff;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-link.unlinked {
  color: #bbb;
}

.item-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.item-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.mini-btn {
  font-size: 23rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  line-height: 1.5;
  background: #eef2f5;
  color: #333;
}

.mini-btn.danger {
  background: #ffeef0;
  color: #ff4d4f;
}

.mini-btn.primary {
  background: #07c160;
  color: #fff;
}

.mini-btn.default {
  background: #eee;
  color: #666;
}

.empty-tip {
  text-align: center;
  padding: 34rpx;
  color: #999;
  font-size: 25rpx;
  background: #fafafa;
  border-radius: 14rpx;
}

.edit-form-box {
  margin-top: 18rpx;
  background: #fff;
  border: 1rpx solid #eceff3;
  border-radius: 18rpx;
  padding: 20rpx;
}

.form-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #333;
  margin-bottom: 18rpx;
}

.upload-trigger {
  width: 100%;
  height: 150rpx;
  background: #f7f8fa;
  border: 2rpx dashed #d9d9d9;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-placeholder {
  color: #8c8c8c;
  font-size: 25rpx;
}

.upload-preview-box {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-preview {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.upload-preview-text {
  font-size: 23rpx;
  color: #52c41a;
  padding: 20rpx;
  word-break: break-all;
}

.checkin-share-upload {
  width: 100%;
  height: 210rpx;
  margin-top: 10rpx;
  border-radius: 22rpx;
  background: #fff8ec;
  border: 2rpx dashed rgba(255, 153, 102, 0.28);
  overflow: hidden;
}

.checkin-share-preview {
  width: 100%;
  height: 100%;
  border-radius: 22rpx;
}

.checkin-share-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #d45f22;
  font-size: 25rpx;
  font-weight: 900;
}

.checkin-share-placeholder .remix-icon {
  font-size: 48rpx;
}

.checkin-share-file {
  margin-top: 10rpx;
  color: #8e8580;
  font-size: 21rpx;
  line-height: 1.35;
  word-break: break-all;
}

.form-btn-row {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 20rpx;
}

.module-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  font-size: 26rpx;
  color: #333;
}

.module-switch-row:last-child {
  border-bottom: 0;
}

.quiz-edit-card {
  background: #f9fafb;
  border: 1rpx solid #edf0f4;
  border-radius: 18rpx;
  padding: 18rpx;
}

.quiz-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 12rpx;
}

.quiz-card-header .form-title {
  margin-bottom: 0;
}

.quiz-option-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.quiz-option-tag {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e8f4ff;
  color: #1890ff;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.quiz-option-input {
  flex: 1;
  min-width: 0;
}

.section-subtitle {
  margin-top: 24rpx;
  font-size: 28rpx;
  font-weight: 850;
  color: #2d211a;
}

.supply-admin-item {
  margin-top: 14rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff8ec;
  border: 1rpx solid rgba(255, 153, 102, 0.2);
}

.supply-admin-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.supply-head-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mini-danger-btn {
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fee2e2;
  color: #dc2626;
  font-size: 22rpx;
  font-weight: 800;
  border: none;
}

.add-supply-btn {
  margin-top: 16rpx;
  width: 100%;
}

.strong-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.surcharge-rule-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 122, 69, 0.15);
  border-radius: 18rpx;
  margin-bottom: 14rpx;
}

.rule-main {
  flex: 1;
  min-width: 0;
}

.rule-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.rule-tag {
  font-size: 26rpx;
  font-weight: 700;
  color: #2d211a;
}

.rule-date, .rule-time {
  font-size: 24rpx;
  color: #ff7a45;
  background: #fff4eb;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.rule-price {
  font-size: 24rpx;
  color: #e65100;
  font-weight: 700;
}

.rule-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rule-actions .delete-icon {
  font-size: 34rpx;
  color: #ef4444;
  padding: 8rpx;
}

.add-rule-panel {
  margin-top: 18rpx;
  padding: 20rpx;
  background: #fff8ec;
  border-radius: 20rpx;
  border: 1rpx dashed rgba(255, 153, 102, 0.35);
}

.form-row-grid {
  display: grid;
  grid-template-columns: 1.2fr 1.2fr 1fr;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.form-row-grid-slot {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.form-row-grid-slot .time-sep {
  color: #8c827a;
  font-weight: bold;
}

.form-row-grid-inputs {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.picker-input-field {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  background: #ffffff;
  border: 1rpx solid #e2d7ce;
  border-radius: 14rpx;
  font-size: 25rpx;
  color: #2d211a;
  text-align: center;
}

.add-btn {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  font-weight: 650;
}

/* 聚合数据实名认证弹窗专属样式 */
.juhe-status-card {
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border: 1rpx solid #e5e6eb;
}
.juhe-status-card.configured {
  background: #f0fdf4;
  border-color: #86efac;
}
.juhe-status-card.unconfigured {
  background: #fffbeb;
  border-color: #fde68a;
}
.juhe-status-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.juhe-status-tag {
  font-size: 24rpx;
  font-weight: 700;
}
.juhe-status-tag.success { color: #16a34a; }
.juhe-status-tag.warning { color: #d97706; }
.juhe-status-desc {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.45;
}
.juhe-key-field {
  margin-top: 10rpx;
}
.juhe-real-input {
  height: 84rpx;
  line-height: 84rpx;
  background: #ffffff;
  border: 1rpx solid #e5e6eb;
  border-radius: 18rpx;
  font-size: 26rpx;
  color: #111827;
}

/* 微信服务号配置与指引样式 */
.oa-qrcode-upload-box {
  margin-top: 10rpx;
}
.oa-qrcode-preview-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #ebdcd0;
}
.oa-qrcode-img {
  width: 260rpx;
  height: 260rpx;
  border-radius: 12rpx;
  border: 1rpx solid #f3ece4;
  background: #fdfdfd;
}
.oa-qrcode-ops {
  display: flex;
  gap: 16rpx;
}
.official-account-guide-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff8ec;
  border: 1rpx solid #fce3c7;
}
.official-account-guide-card .guide-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #d45f22;
  margin-bottom: 20rpx;
}
.official-account-guide-card .guide-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.official-account-guide-card .guide-step:last-child {
  margin-bottom: 0;
}
.official-account-guide-card .step-num {
  width: 38rpx;
  height: 38rpx;
  line-height: 38rpx;
  text-align: center;
  background: #ff8a45;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  border-radius: 50%;
  flex-shrink: 0;
}
.official-account-guide-card .step-head {
  font-size: 26rpx;
  font-weight: 700;
  color: #2d211a;
  margin-bottom: 4rpx;
}
.official-account-guide-card .step-desc {
  font-size: 23rpx;
  color: #7a6a5e;
  line-height: 1.5;
}

/* 微信转账多场景配置样式 */
.transfer-scene-selector {
  display: flex;
  background: #f5f3f0;
  border-radius: 14rpx;
  padding: 6rpx;
  margin: 16rpx 0 20rpx 0;
  gap: 8rpx;
}
.transfer-scene-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 4rpx;
  font-size: 23rpx;
  color: #7a6a5e;
  border-radius: 10rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}
.transfer-scene-tab.active {
  background: #ffffff;
  color: #ff8a45;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}
.transfer-scene-box {
  background: #faf8f5;
  border: 1rpx solid #ede8e3;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.transfer-scene-badge {
  display: inline-block;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  border-radius: 8rpx;
  background: #fff0db;
  color: #c25e16;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.item-actions-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
  margin-bottom: 16rpx;
}




/* Compact question summaries keep the 50-question bank manageable on phones. */
.quiz-bank-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin: 18rpx 0; }
.quiz-bank-toolbar button { margin: 0; }
.quiz-bank-panel { padding: 22rpx; border: 1rpx solid #cce0d8; border-radius: 20rpx; background: #f3f8f5; margin-bottom: 22rpx; }
.quiz-bank-search { margin-top: 20rpx; }
.quiz-bank-list { max-height: 700rpx; height: 600rpx; margin-bottom: 20rpx; }
.quiz-bank-item { padding: 22rpx 0; border-bottom: 1rpx solid #dce8e2; }
.quiz-bank-item-main { display: flex; align-items: flex-start; gap: 10rpx; }
.quiz-bank-item-main > view { flex: 1; min-width: 0; }
.quiz-bank-category { color: #61756b; font-size: 22rpx; }
.quiz-bank-question, .quiz-summary-title { color: #233c32; font-size: 27rpx; line-height: 1.6; word-break: break-all; }
.quiz-bank-preview { padding: 12rpx 0 0 58rpx; font-size: 24rpx; line-height: 1.7; color: #52635c; }
.quiz-bank-answer { color: #286d52; font-weight: 600; margin-top: 8rpx; }
.quiz-bank-empty { padding: 48rpx 16rpx; text-align: center; color: #78877f; }
.quiz-summary { flex: 1; min-width: 0; }
.quiz-expand-label { color: #327a65; font-size: 23rpx; }
.quiz-editor-body { border-top: 1rpx solid #e1e8e4; padding-top: 18rpx; }
.quiz-question-textarea { width: 100%; box-sizing: border-box; min-height: 100rpx; }
