.page { padding: 32rpx; background: #fff; color: #202824; min-height: 100vh; box-sizing: border-box; }
.heading { font-size: 38rpx; font-weight: 600; margin-bottom: 24rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid #e4e8e6; }
.row > view { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.row button { flex-shrink: 0; margin: 0; }
.muted { color: #68736d; font-size: 24rpx; overflow-wrap: anywhere; }
.tabs, .actions { display: flex; gap: 16rpx; margin: 24rpx 0; }
.tabs button, .actions button { flex: 1; margin: 0; }
.active { color: #166349; border-bottom: 4rpx solid #166349; }
.leaf { display: flex; align-items: center; padding: 18rpx 0 18rpx 16rpx; font-size: 28rpx; }
.branch { border-bottom: 2rpx solid #cbd8d0; }
input { border-bottom: 1rpx solid #b9c9c0; padding: 20rpx 0; margin: 16rpx 0; }
.notice { background: #f1f5f3; padding: 24rpx; font-size: 26rpx; line-height: 1.7; }
.empty { text-align: center; padding: 64rpx 0; color: #68736d; }
button { border-radius: 8rpx; }
