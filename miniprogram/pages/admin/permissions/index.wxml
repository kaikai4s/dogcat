<view class="page">
  <view class="heading">用户组与权限</view>
  <view wx:if="{{access && !access.enabled}}" class="notice">
    <view>当前为旧版全权限模式</view>
    <button bindtap="enable" disabled="{{busy}}">启用用户组权限管理</button>
  </view>
  <block wx:if="{{access.enabled && access.superAdmin}}">
    <view class="tabs"><button bindtap="tab" data-tab="groups" class="{{tab === 'groups' ? 'active' : ''}}">用户组</button><button bindtap="tab" data-tab="members" class="{{tab === 'members' ? 'active' : ''}}">后台人员</button></view>
    <block wx:if="{{tab === 'groups' && !editor}}">
      <button bindtap="edit">新增用户组</button>
      <view class="row" wx:for="{{groups}}" wx:key="_id"><view><view>{{item.name}}</view><text class="muted">{{item.enabled ? '启用' : '停用'}} · {{item.permissions.length}} 项权限</text></view><button size="mini" bindtap="edit" data-id="{{item._id}}">编辑</button></view>
      <view class="empty" wx:if="{{!groups.length}}">暂无用户组</view>
    </block>
    <block wx:if="{{editor}}">
      <input value="{{editor.name}}" maxlength="40" placeholder="用户组名称" bindinput="name" />
      <view class="row"><text>启用用户组</text><switch checked="{{editor.enabled}}" bindchange="enabled" /></view>
      <view class="branch" wx:for="{{tree}}" wx:key="id" wx:for-item="node">
        <view class="row"><text>{{node.label}}</text><checkbox-group data-id="{{node.id}}" bindchange="branch"><label><checkbox checked="{{node.checked}}" value="all" />全选</label></checkbox-group></view>
        <checkbox-group data-id="{{node.id}}" bindchange="permissions"><label class="leaf" wx:for="{{node.children}}" wx:key="id"><checkbox value="{{item.id}}" checked="{{item.checked}}" /><text>{{item.label}}</text></label></checkbox-group>
      </view>
      <view class="actions"><button bindtap="cancel">取消</button><button type="primary" bindtap="save" disabled="{{busy}}">保存权限</button></view>
    </block>
    <block wx:if="{{tab === 'members'}}">
      <view wx:if="{{!member}}"><input value="{{targetOpenid}}" placeholder="已注册用户 OpenID" bindinput="inputTarget" /><button bindtap="editMember">添加或编辑后台人员</button></view>
      <view wx:if="{{member}}">
        <view class="muted">{{member.openid}}</view>
        <checkbox-group bindchange="groupsChanged"><label class="leaf" wx:for="{{groupOptions}}" wx:key="_id"><checkbox value="{{item._id}}" checked="{{item.checked}}" />{{item.name}}</label></checkbox-group>
        <view class="notice">未选择任何用户组时，该人员没有后台业务权限。</view>
        <view class="actions"><button bindtap="cancel">取消</button><button type="primary" bindtap="saveMember" disabled="{{busy}}">保存分组</button></view>
      </view>
      <view class="row" wx:for="{{members}}" wx:key="_id"><view><view>{{item.nickname || '未设置昵称'}}</view><text class="muted">{{item.openid}}</text></view><button size="mini" bindtap="editMember" data-openid="{{item.openid}}">分配用户组</button></view>
    </block>
  </block>
</view>
