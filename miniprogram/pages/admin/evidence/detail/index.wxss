@import "../../orders/list/index.wxss";

.admin-evidence-page {
  min-height: 100vh;
  padding: 0 28rpx 100rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.evidence-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.1);
}

.info-row .value {
  flex: 1;
  color: #2d211a;
  font-size: 27rpx;
  font-weight: 900;
  text-align: right;
  word-break: break-all;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.stat-item {
  padding: 24rpx 12rpx;
  border-radius: 26rpx;
  background: #fff8ec;
  text-align: center;
}

.stat-number {
  color: #e9672f;
  font-size: 36rpx;
  font-weight: 950;
}

.stat-label {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 22rpx;
  line-height: 1.3;
}
