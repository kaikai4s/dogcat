<view class="page">
  <view class="dashboard-header">
    <view class="badge">管理端</view>
    <view class="title">优惠券管理</view>
    <view class="tip">配置优惠券模板，按会员段位批量发券或精确发给指定用户。</view>
  </view>

  <view class="card form-card">
    <view class="subtitle">模板配置</view>
    <input placeholder="优惠券名称，如 满80减20" value="{{form.name}}" data-field="name" bindinput="input" />
    <input placeholder="优惠说明" value="{{form.description}}" data-field="description" bindinput="input" />
    <input type="number" placeholder="优惠金额" value="{{form.discountAmount}}" data-field="discountAmount" bindinput="input" />
    <input type="number" placeholder="最低订单金额" value="{{form.minOrderAmount}}" data-field="minOrderAmount" bindinput="input" />
    <input type="number" placeholder="有效天数" value="{{form.validDays}}" data-field="validDays" bindinput="input" />
    <input type="number" placeholder="每人限制张数" value="{{form.perUserLimit}}" data-field="perUserLimit" bindinput="input" />
    <input type="number" placeholder="总发放上限，0为不限" value="{{form.totalIssueLimit}}" data-field="totalIssueLimit" bindinput="input" />
    <view class="between switch-row">
      <view class="strong">启用模板</view>
      <switch checked="{{form.enabled}}" bindchange="toggleEnabled" />
    </view>
    <button class="primary" bindtap="saveTemplate">保存模板</button>
    <button class="ghost" bindtap="resetForm">新建模板</button>
  </view>

  <view class="card form-card">
    <view class="subtitle">发放优惠券</view>
    <view class="status-tabs" style="margin-bottom:24rpx;">
      <view class="status-tab {{issueMode === 'level' ? 'active' : ''}}" data-mode="level" bindtap="switchIssueMode">按会员段位</view>
      <view class="status-tab {{issueMode === 'openid' ? 'active' : ''}}" data-mode="openid" bindtap="switchIssueMode">精确发券</view>
    </view>

    <picker range="{{templates}}" range-key="name" bindchange="chooseIssueTemplate">
      <view class="field">模板：{{issueMode === 'level' ? (issueByLevel.templateId || '请选择') : (issueByOpenid.templateId || '请选择')}}</view>
    </picker>

    <view wx:if="{{issueMode === 'level'}}">
      <view class="muted" style="margin:16rpx 0 8rpx;">选择段位（可多选）：</view>
      <view wx:if="{{!levels.length}}" class="muted">暂无等级，请先在「会员等级」页配置</view>
      <view wx:for="{{levels}}" wx:key="_id" class="between" style="padding:12rpx 0;border-bottom:1rpx solid #f5e6ec;">
        <view>{{item.icon}} {{item.name}} <text class="muted">（≥{{item.minPoints}}积分）</text></view>
        <switch checked="{{issueByLevel.targetLevels.indexOf(item.name) !== -1}}" data-name="{{item.name}}" bindchange="toggleLevel" />
      </view>
      <view class="muted" style="margin-top:12rpx;">已选：{{issueByLevel.targetLevels.join('、') || '未选择'}}</view>
    </view>

    <view wx:if="{{issueMode === 'openid'}}">
      <input placeholder="用户 openid" value="{{issueByOpenid.openid}}" bindinput="openidInput" />
    </view>

    <button class="primary" bindtap="issueCoupon">发放优惠券</button>
  </view>

  <view style="display:flex;gap:16rpx;padding:0 32rpx 24rpx;">
    <button class="ghost" style="flex:1;" bindtap="go" data-url="/pages/admin/member-levels/index">会员等级</button>
    <button class="ghost" style="flex:1;" bindtap="go" data-url="/pages/admin/points/index">积分管理</button>
    <button class="ghost" style="flex:1;" bindtap="go" data-url="/pages/admin/lottery/index">抽奖活动</button>
  </view>

  <view class="card" wx:for="{{templates}}" wx:key="_id">
    <view class="between">
      <view>
        <view class="strong">{{item.name}}</view>
        <view class="muted">满 ¥{{item.minOrderAmount}} 减 ¥{{item.discountAmount}} · {{item.validDays}}天有效</view>
        <view class="muted">已发 {{item.issuedCount || 0}} 张 · 每人 {{item.perUserLimit}} 张</view>
      </view>
      <view class="badge">{{item.enabled ? '启用' : '停用'}}</view>
    </view>
    <button class="ghost compact-btn" data-index="{{index}}" bindtap="chooseTemplate">编辑</button>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/admin/home/index" bindtap="go"><view class="nav-icon">⌂</view><view>控制台</view></view>
    <view class="nav-item" data-url="/pages/admin/orders/list/index" bindtap="go"><view class="nav-icon">☷</view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/admin/staff-audit/list/index" bindtap="go"><view class="nav-icon">☑</view><view>审核</view></view>
    <view class="nav-item" data-url="/pages/admin/incidents/list/index" bindtap="go"><view class="nav-icon">!</view><view>异常</view></view>
  </view>
</view>
