/* Admin finance page - Cute Pet Style UI redesign */
.admin-finance-page {
  min-height: 100vh;
  padding: 0 28rpx 100rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.admin-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon { font-size: 28rpx; }

.hero-title {
  color: #2d211a;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.date-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}

.search-field {
  flex: 1;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: #fff8ec;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid rgba(255, 153, 102, 0.2);
  box-sizing: border-box;
}

.search-field .field-icon {
  color: #e9672f;
  font-size: 30rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 24rpx;
  color: #2d211a;
  height: 100%;
}

.clear-icon {
  color: #b0a49c;
  font-size: 32rpx;
  padding: 6rpx;
  flex-shrink: 0;
}

.search-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 850;
  flex-shrink: 0;
}

.active-filter-tip {
  margin-top: 14rpx;
  padding: 8rpx 16rpx;
  background: #fff3e6;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: #d45f22;
}

.filter-tip-icon {
  font-size: 24rpx;
}

.filter-tip-text {
  flex: 1;
}

.clear-filter-text {
  text-decoration: underline;
  cursor: pointer;
  font-weight: bold;
}

.date-field {
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: #fff8ec;
  color: #2d211a;
  font-size: 24rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.field-icon {
  color: #e9672f;
  font-size: 30rpx;
}

.finance-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.stat-card {
  padding: 22rpx 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 10rpx 26rpx rgba(123, 89, 62, 0.05);
}

.stat-card.highlight {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
}

.stat-value {
  color: #2d211a;
  font-size: 34rpx;
  font-weight: 950;
}

.stat-card.highlight .stat-value,
.stat-card.highlight .stat-label {
  color: #ffffff;
}

.stat-label {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 22rpx;
}

.chip-tabs {
  white-space: nowrap;
  margin: 28rpx 0 20rpx;
}

.sub-tabs {
  margin-top: 0;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  min-width: 112rpx;
  padding: 0 24rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #7a6a5e;
  font-size: 26rpx;
  font-weight: 850;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 8rpx 20rpx rgba(123, 89, 62, 0.04);
}

.chip.small {
  height: 56rpx;
  min-width: 96rpx;
  font-size: 24rpx;
}

.chip.active {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  border-color: transparent;
}

.record-card {
  margin-top: 18rpx;
  padding: 24rpx;
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.1);
}

.record-title {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 950;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
}

.badge.pink { background: #ffebe6; color: #e9672f; }
.badge.green { background: #e6f8ea; color: #00b42a; }
.badge.gray { background: #f0eae5; color: #8e8580; }

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.08);
}

.info-row:last-child { border-bottom: none; }
.ship-input { box-sizing: border-box; width: 100%; height: 76rpx; margin-top: 12rpx; padding: 0 18rpx; border: 1rpx solid #eaded3; border-radius: 8rpx; background: #fff8f2; font-size: 26rpx; }

.info-row .label {
  color: #8e8580;
  font-size: 24rpx;
}

.info-row .value {
  max-width: 65%;
  color: #2d211a;
  font-size: 24rpx;
  font-weight: 760;
  text-align: right;
  word-break: break-all;
}

.price {
  color: #e9672f;
  font-size: 28rpx;
  font-weight: 950;
}

.info-row .value.danger,
.danger {
  color: #dc2626;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
  width: 100%;
  box-sizing: border-box;
}

.action-row button,
.action-row .compact-btn {
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100% !important;
  height: 76rpx !important;
  min-height: 76rpx !important;
  padding: 0 16rpx !important;
  margin: 0 !important;
  border-radius: 20rpx !important;
  font-size: 25rpx !important;
  font-weight: 900 !important;
  line-height: 1 !important;
  white-space: nowrap !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
}

.withdraw-audit-actions {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 20rpx !important;
  width: 100% !important;
  margin-top: 24rpx !important;
  padding-top: 20rpx !important;
  border-top: 1rpx dashed rgba(255, 153, 102, 0.18) !important;
  box-sizing: border-box !important;
}

.withdraw-audit-actions .withdraw-btn {
  flex: 1 1 0% !important;
  width: auto !important;
  min-width: 0 !important;
  margin: 0 !important;
  height: 84rpx !important;
  padding: 0 16rpx !important;
  border-radius: 20rpx !important;
  font-size: 28rpx !important;
  font-weight: 800 !important;
  line-height: 1 !important;
  white-space: nowrap !important;
  box-sizing: border-box !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  letter-spacing: 2rpx !important;
  transition: all 0.2s ease !important;
}

.withdraw-reject-btn {
  color: #d93026 !important;
  background: #fff2f0 !important;
  border: 1.5rpx solid #ffccc7 !important;
}

.withdraw-reject-btn:active {
  background: #ffebe8 !important;
  border-color: #ffa39e !important;
  transform: scale(0.98);
}

.withdraw-approve-btn {
  color: #ffffff !important;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%) !important;
  border: 1.5rpx solid #059669 !important;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.28) !important;
}

.withdraw-approve-btn:active {
  background: #047857 !important;
  box-shadow: 0 4rpx 10rpx rgba(16, 185, 129, 0.2) !important;
  transform: scale(0.98);
}

.withdraw-start-btn {
  color: #ffffff;
  background: #2563eb;
  box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, 0.18);
}

.withdraw-history-box {
  margin-top: 18rpx;
  border-radius: 18rpx;
  background: #fdfaf7;
  border: 1rpx solid rgba(255, 153, 102, 0.18);
  overflow: hidden;
  transition: all 0.2s ease;
}

.withdraw-history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  cursor: pointer;
  background: #fdfaf7;
}

.withdraw-history-header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.withdraw-history-header-left .history-icon {
  color: #ff7a45;
  font-size: 26rpx;
}

.withdraw-history-title {
  color: #4a382c;
  font-size: 23rpx;
  font-weight: 800;
}

.withdraw-history-header-right {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
}

.withdraw-history-header-right .toggle-text {
  color: #ff7a45;
  font-weight: 700;
}

.withdraw-history-header-right .toggle-arrow {
  color: #ff7a45;
  font-size: 26rpx;
  transition: transform 0.2s ease;
}

.withdraw-history-list {
  padding: 0 20rpx 12rpx;
  border-top: 1rpx dashed rgba(255, 153, 102, 0.15);
  background: #ffffff;
}

.withdraw-history-item {
  display: grid;
  grid-template-columns: 1fr 1fr 1.35fr;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 0;
  color: #7a6a5e;
  font-size: 22rpx;
  border-bottom: 1rpx solid #f6f3ee;
}

.withdraw-history-item:last-child {
  border-bottom: none;
}

.withdraw-history-item .history-amount {
  color: #2d211a;
  font-weight: 800;
}

.withdraw-history-item .history-status {
  font-weight: 700;
}

.withdraw-history-item .history-status.paid {
  color: #00b42a;
}

.withdraw-history-item .history-status.rejected,
.withdraw-history-item .history-status.transfer_failed {
  color: #f53f3f;
}

.withdraw-history-item .history-status.pending,
.withdraw-history-item .history-status.transferring {
  color: #ff7a45;
}

.withdraw-history-item .history-time {
  text-align: right;
  color: #a89a8f;
  font-size: 20rpx;
}

.admin-finance-page button::after {
  display: none !important;
}

.primary-btn,
.ghost-btn,
.withdraw-start-btn {
  min-height: 76rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
  box-sizing: border-box;
}

.primary-btn {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.primary-btn:active {
  opacity: 0.9;
  transform: translateY(1rpx);
}

.ghost-btn {
  background: #fff0e2;
  color: #7a6a5e;
}

.ghost-btn:active {
  background: #ffe6d4;
}

button.full-btn {
  width: 100% !important;
  margin: 16rpx 0 0 0 !important;
  height: 76rpx !important;
  min-height: 76rpx !important;
  border-radius: 20rpx !important;
  font-size: 26rpx !important;
  font-weight: 900 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
}

.release-failed-btn {
  color: #b42318 !important;
  background: #fff5f4 !important;
  border: 1rpx solid #fecdca !important;
  box-shadow: none !important;
  font-size: 24rpx !important;
  font-weight: 850 !important;
  height: 70rpx !important;
  min-height: 70rpx !important;
  border-radius: 18rpx !important;
  margin-top: 14rpx !important;
}

.release-failed-btn:active {
  background: #fee4e2 !important;
}

.empty-state {
  margin-top: 38rpx;
  padding: 48rpx 0;
  text-align: center;
  color: #8e8580;
  font-size: 26rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  display: flex;
  align-items: flex-end;
  background: rgba(45, 33, 26, 0.46);
  backdrop-filter: blur(4rpx);
}

.modal-card {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 34rpx 28rpx 50rpx;
  border-top-left-radius: 38rpx;
  border-top-right-radius: 38rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 950;
  color: #2d211a;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.modal-summary {
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #fbf7f4;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.form-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 850;
  color: #55483f;
}

.form-section input {
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 153, 102, 0.22);
  background: #ffffff;
  font-size: 28rpx;
  color: #2d211a;
  box-sizing: border-box;
}

.form-section textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 153, 102, 0.22);
  background: #ffffff;
  font-size: 26rpx;
  color: #2d211a;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.modal-actions button {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 950;
}

.danger-btn {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  color: #ffffff;
}

/* 保证金精准定位与联动筛选样式 */
.deposit-filter-bar {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
}

.filter-bar-content {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #9a3412;
}

.filter-bar-content .filter-icon {
  font-size: 28rpx;
  color: #ea580c;
}

.filter-bar-content .filter-name {
  font-weight: 850;
  color: #c2410c;
}

.filter-bar-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #78716c;
  padding: 6rpx 14rpx;
  background: #ffffff;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.card.record-card.target-highlight {
  border: 2rpx solid #ea580c;
  box-shadow: 0 12rpx 36rpx rgba(234, 88, 12, 0.16);
  position: relative;
  background: linear-gradient(180deg, #fffbf5 0%, #ffffff 100%);
}

.forfeit-target-staff {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  background: #fff7ed;
  border: 1rpx solid #ffedd5;
  border-radius: 12rpx;
  color: #c2410c;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.evidence-bind-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
  border-radius: 12rpx;
  color: #166534;
  font-size: 22rpx;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

/* 违规扣除弹窗图片上传器样式 */
.forfeit-uploader-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 10rpx;
}

.uploader-thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: visible;
}

.thumb-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
}

.thumb-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  z-index: 2;
}

.uploader-add-btn {
  width: 120rpx;
  height: 120rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  color: #94a3b8;
}

.uploader-add-btn .ri-camera-line {
  font-size: 38rpx;
  line-height: 1;
}

.uploader-add-text {
  font-size: 20rpx;
  margin-top: 6rpx;
}

