<wxs module="beijingTime" src="../../../utils/beijing-time.wxs" />
<view class="page admin-finance-page {{themeClass}} {{fontClass}}">
  <view class="admin-hero">
    <view class="hero-badge"><text class="remix-icon ri-wallet-3-fill hero-icon"></text><text>财务管理</text></view>
    <view class="hero-title">经营看板与提现审核</view>
    <view class="hero-desc">查看 GMV、实收、退款、收益和提现进度。第一版提现采用人工线下打款。</view>
  </view>

  <view class="card filter-card">
    <view class="date-row">
      <picker mode="date" value="{{startDate}}" bindchange="chooseStartDate">
        <view class="date-field"><text class="remix-icon ri-calendar-line field-icon"></text><text>开始：{{startDate}}</text></view>
      </picker>
      <picker mode="date" value="{{endDate}}" bindchange="chooseEndDate">
        <view class="date-field"><text class="remix-icon ri-calendar-check-line field-icon"></text><text>结束：{{endDate}}</text></view>
      </picker>
    </view>
  </view>

  <view class="stats-grid finance-grid">
    <view class="stat-card {{item.highlight ? 'highlight' : ''}}" wx:for="{{metricCards}}" wx:key="label">
      <view class="stat-value">{{item.value}}</view>
      <view class="stat-label">{{item.label}}</view>
    </view>
  </view>

  <scroll-view scroll-x class="chip-tabs">
    <view class="chip {{activeTab === 'withdraws' ? 'active' : ''}}" data-tab="withdraws" bindtap="switchTab">提现</view>
    <view class="chip {{activeTab === 'deposits' ? 'active' : ''}}" data-tab="deposits" bindtap="switchTab">保证金</view>
    <view class="chip {{activeTab === 'supplies' ? 'active' : ''}}" data-tab="supplies" bindtap="switchTab">用品报销</view>
    <view class="chip {{activeTab === 'payments' ? 'active' : ''}}" data-tab="payments" bindtap="switchTab">支付</view>
    <view class="chip {{activeTab === 'refunds' ? 'active' : ''}}" data-tab="refunds" bindtap="switchTab">退款</view>
    <view class="chip {{activeTab === 'earnings' ? 'active' : ''}}" data-tab="earnings" bindtap="switchTab">收益</view>
    <view class="chip {{activeTab === 'logs' ? 'active' : ''}}" data-tab="logs" bindtap="switchTab">流水</view>
  </scroll-view>

  <block wx:if="{{activeTab === 'withdraws'}}">
    <scroll-view scroll-x class="chip-tabs sub-tabs">
      <view class="chip small {{status === '' ? 'active' : ''}}" data-status="" bindtap="filter">全部</view>
      <view class="chip small {{status === 'pending' ? 'active' : ''}}" data-status="pending" bindtap="filter">待审核</view>
      <view class="chip small {{status === 'approved' ? 'active' : ''}}" data-status="approved" bindtap="filter">待打款</view>
      <view class="chip small {{status === 'paid' ? 'active' : ''}}" data-status="paid" bindtap="filter">已打款</view>
    </scroll-view>

    <view class="card record-card" wx:for="{{requests}}" wx:key="_id">
      <view class="record-head"><view class="record-title">提现申请</view><view class="badge pink">{{item.status}}</view></view>
      <view class="info-row"><view class="label">申请人</view><view class="value">{{item.staffOpenid}}</view></view>
      <view class="info-row"><view class="label">金额</view><view class="price">¥{{item.amountText}}</view></view>
      <view class="info-row"><view class="label">收款人</view><view class="value">{{item.accountName || '未填写'}}</view></view>
      <view class="info-row"><view class="label">收款账号</view><view class="value">{{item.accountNo || '未填写'}}</view></view>
      <view class="info-row"><view class="label">申请时间</view><view class="value">{{beijingTime.format(item.createdAt)}}</view></view>
      <view class="info-row" wx:if="{{item.auditRemark}}"><view class="label">审核备注</view><view class="value">{{item.auditRemark}}</view></view>
      <view class="action-row" wx:if="{{item.status === 'pending'}}">
        <button class="ghost-btn compact-btn" data-id="{{item._id}}" data-approved="false" bindtap="audit">驳回</button>
        <button class="primary-btn compact-btn" data-id="{{item._id}}" data-approved="true" bindtap="audit">通过</button>
      </view>
      <button class="primary-btn full-btn" wx:if="{{item.status === 'approved'}}" data-id="{{item._id}}" bindtap="markPaid">标记已打款</button>
    </view>
    <view class="empty-state" wx:if="{{!requests.length}}">暂无提现申请。</view>
  </block>

  <block wx:if="{{activeTab === 'deposits'}}">
    <view class="deposit-filter-bar" wx:if="{{targetStaffOpenid}}">
      <view class="filter-bar-content">
        <text class="remix-icon ri-filter-3-fill filter-icon"></text>
        <text>已筛选宠托师：<text class="filter-name">{{targetStaffLabel || targetStaffOpenid}}</text></text>
      </view>
      <view class="filter-bar-action" bindtap="clearStaffFilter">
        <text>查看全部</text>
        <text class="remix-icon ri-close-line"></text>
      </view>
    </view>
    <view class="card record-card {{item.staffOpenid === targetStaffOpenid ? 'target-highlight' : ''}}" wx:for="{{deposits}}" wx:key="_id" wx:if="{{!targetStaffOpenid || item.staffOpenid === targetStaffOpenid}}">
      <view class="record-head">
        <view class="record-title">宠托师保证金</view>
        <view class="badge {{item.status === 'paid' ? 'green' : 'pink'}}">{{item.statusText || item.status}}</view>
      </view>
      <view class="info-row"><view class="label">宠托师</view><view class="value">{{item.staffRealName || item.staffNickname || item.staffOpenid}}</view></view>
      <view class="info-row"><view class="label">手机号</view><view class="value">{{item.staffPhone || '未填写'}}</view></view>
      <view class="info-row"><view class="label">宠托师等级</view><view class="value">{{item.staffLevel === 'certified' ? '认证宠托师' : (item.staffLevel === 'intern' ? '实习宠托师' : '待定')}}</view></view>
      <view class="info-row"><view class="label">应缴金额</view><view class="price">¥{{item.amountText}}</view></view>
      <view class="info-row"><view class="label">已缴金额</view><view class="value">¥{{item.paidAmountText}}</view></view>
      <view class="info-row"><view class="label">可退金额</view><view class="price">¥{{item.availableRefundAmountText}}</view></view>
      <view class="info-row" wx:if="{{item.refundedAmount > 0}}"><view class="label">已退金额</view><view class="value">¥{{item.refundedAmountText}}</view></view>
      <view class="info-row" wx:if="{{item.forfeitedAmount > 0}}"><view class="label">已没收金额</view><view class="value danger">¥{{item.forfeitedAmountText}}</view></view>
      <view class="info-row" wx:if="{{item.refundReason}}"><view class="label">退出退款原因</view><view class="value">{{item.refundReason}}</view></view>
      <view class="info-row" wx:if="{{item.lastForfeitReason}}"><view class="label">最近没收原因</view><view class="value">{{item.lastForfeitReason}}</view></view>
      <view class="info-row" wx:if="{{item.lastForfeitImages && item.lastForfeitImages.length}}">
        <view class="label">违规举证照片（内部留存）</view>
        <view class="value">{{item.lastForfeitImages.length}}张（仅管理员可见）</view>
      </view>
      <scroll-view scroll-x class="chip-tabs" wx:if="{{item.lastForfeitImages && item.lastForfeitImages.length}}" style="margin-top: 8rpx; margin-bottom: 12rpx;">
        <image wx:for="{{item.lastForfeitImages}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" style="width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 12rpx; border: 1rpx solid #fed7aa;" data-urls="{{item.lastForfeitImages}}" data-current="{{img}}" bindtap="previewForfeitReceipt" />
      </scroll-view>
      <view class="info-row"><view class="label">记录时间</view><view class="value">{{beijingTime.format(item.paidAt || item.createdAt)}}</view></view>
      
      <view class="action-row" wx:if="{{item.refundStatus === 'requested'}}">
        <button class="ghost-btn compact-btn" data-id="{{item._id}}" data-approved="false" bindtap="auditDepositRefund">驳回退款</button>
        <button class="primary-btn compact-btn" data-id="{{item._id}}" data-approved="true" bindtap="auditDepositRefund">通过退款审核</button>
      </view>
      <button class="primary-btn full-btn" wx:if="{{item.status === 'refund_approved'}}" disabled="{{actionBusy}}" data-id="{{item._id}}" bindtap="confirmDepositRefund">确认已实际退款</button>
      <button class="ghost-btn full-btn" wx:if="{{item.canForfeit}}" data-id="{{item._id}}" data-max="{{item.availableRefundAmount}}" data-staff="{{item.staffRealName || item.staffNickname || item.staffOpenid}}" bindtap="forfeitDeposit">违规没收保证金</button>
    </view>
    <view class="empty-state" wx:if="{{!deposits.length}}">暂无宠托师保证金记录。</view>
  </block>

  <block wx:if="{{activeTab === 'supplies'}}">
    <view class="card record-card" wx:for="{{supplies}}" wx:key="_id">
      <view class="record-head">
        <view class="record-title">首次用品报销</view>
        <view class="badge {{item.status === 'paid' ? 'green' : (item.status === 'approved' ? 'pink' : 'gray')}}">{{item.statusText || item.status}}</view>
      </view>
      <view class="info-row"><view class="label">申请人</view><view class="value">{{item.staffRealName || item.staffNickname || item.staffOpenid}}</view></view>
      <view class="info-row"><view class="label">手机号</view><view class="value">{{item.staffPhone || '未填写'}}</view></view>
      <view class="info-row"><view class="label">申请金额</view><view class="price">¥{{item.amountText}}</view></view>
      <view class="info-row" wx:if="{{item.approvedAmount != null}}"><view class="label">核准金额</view><view class="price">¥{{item.approvedAmountText}}</view></view>
      <view class="info-row" wx:if="{{item.remark}}"><view class="label">申请备注</view><view class="value">{{item.remark}}</view></view>
      <view class="info-row" wx:if="{{item.rejectReason}}"><view class="label">驳回原因</view><view class="value">{{item.rejectReason}}</view></view>
      <view class="info-row"><view class="label">申请时间</view><view class="value">{{beijingTime.format(item.createdAt)}}</view></view>
      
      <view class="info-row" wx:if="{{item.mediaFileIds && item.mediaFileIds.length}}">
        <view class="label">凭证截图（点击预览）</view>
        <view class="value">{{item.mediaFileIds.length}}张</view>
      </view>
      <scroll-view scroll-x class="chip-tabs" wx:if="{{item.mediaFileIds && item.mediaFileIds.length}}">
        <image wx:for="{{item.mediaFileIds}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill" style="width: 120rpx; height: 120rpx; border-radius: 12rpx; margin-right: 12rpx;" data-urls="{{item.mediaFileIds}}" data-current="{{img}}" bindtap="previewReceipt" />
      </scroll-view>

      <view class="action-row" wx:if="{{item.status === 'pending'}}">
        <button class="ghost-btn compact-btn" data-id="{{item._id}}" data-approved="false" bindtap="auditSupplyReimbursement">驳回申请</button>
        <button class="primary-btn compact-btn" data-id="{{item._id}}" data-approved="true" data-amount="{{item.amount}}" bindtap="auditSupplyReimbursement">审核通过</button>
      </view>
      <button class="primary-btn full-btn" wx:if="{{item.status === 'approved'}}" disabled="{{actionBusy}}" data-id="{{item._id}}" bindtap="paySupplyReimbursement">确认已实际打款</button>
    </view>
    <view class="empty-state" wx:if="{{!supplies.length}}">暂无用品报销记录。</view>
  </block>

  <block wx:if="{{activeTab === 'payments'}}">
    <view class="card record-card" wx:for="{{payments}}" wx:key="_id">
      <view class="record-head"><view class="record-title">支付单号</view><view class="badge green">{{item.status}}</view></view>
      <view class="info-row"><view class="label">单号</view><view class="value">{{item.paymentNo || item._id}}</view></view>
      <view class="info-row"><view class="label">订单</view><view class="value">{{item.orderId}}</view></view>
      <view class="info-row"><view class="label">金额</view><view class="price">¥{{item.amountText}}</view></view>
      <view class="info-row"><view class="label">渠道</view><view class="value">{{item.channel || 'mock'}}</view></view>
      <view class="info-row"><view class="label">时间</view><view class="value">{{beijingTime.format(item.paidAt || item.createdAt)}}</view></view>
    </view>
    <view class="empty-state" wx:if="{{!payments.length}}">暂无支付流水。</view>
  </block>

  <block wx:if="{{activeTab === 'refunds'}}">
    <view class="card record-card" wx:for="{{refunds}}" wx:key="_id">
      <view class="record-head"><view class="record-title">退款单号</view><view class="badge pink">{{item.status}}</view></view>
      <view class="info-row"><view class="label">单号</view><view class="value">{{item.refundNo || item._id}}</view></view>
      <view class="info-row"><view class="label">订单</view><view class="value">{{item.orderId}}</view></view>
      <view class="info-row"><view class="label">金额</view><view class="price">¥{{item.amountText}}</view></view>
      <view class="info-row"><view class="label">原因</view><view class="value">{{item.reason || '-'}}</view></view>
      <view class="info-row"><view class="label">时间</view><view class="value">{{beijingTime.format(item.createdAt)}}</view></view>
    </view>
    <view class="empty-state" wx:if="{{!refunds.length}}">暂无退款记录。</view>
  </block>

  <block wx:if="{{activeTab === 'earnings'}}">
    <view class="card record-card" wx:for="{{earnings}}" wx:key="_id">
      <view class="record-head"><view class="record-title">宠托师收益</view><view class="badge pink">{{item.status}}</view></view>
      <view class="info-row"><view class="label">宠托师</view><view class="value">{{item.staffOpenid}}</view></view>
      <view class="info-row"><view class="label">订单</view><view class="value">{{item.orderId}}</view></view>
      <view class="info-row"><view class="label">收益</view><view class="price">¥{{item.amountText}}</view></view>
      <view class="info-row"><view class="label">可提现时间</view><view class="value">{{beijingTime.format(item.availableAt)}}</view></view>
    </view>
    <view class="empty-state" wx:if="{{!earnings.length}}">暂无收益明细。</view>
  </block>

  <block wx:if="{{activeTab === 'logs'}}">
    <view class="card record-card" wx:for="{{logs}}" wx:key="_id">
      <view class="record-head"><view class="record-title">{{item.action}}</view><view class="badge gray">流水</view></view>
      <view class="info-row"><view class="label">对象</view><view class="value">{{item.targetType}} / {{item.targetId}}</view></view>
      <view class="info-row"><view class="label">金额变动</view><view class="price">¥{{item.amountDelta || 0}}</view></view>
      <view class="info-row"><view class="label">时间</view><view class="value">{{beijingTime.format(item.createdAt)}}</view></view>
    </view>
    <view class="empty-state" wx:if="{{!logs.length}}">暂无财务流水。</view>
  </block>

  <!-- 违规扣除保证金弹窗 (扣除金额与扣除描述分设两个独立栏位) -->
  <view class="modal-mask" wx:if="{{showForfeitModal}}">
    <view class="modal-card">
      <view class="modal-title">
        <text class="remix-icon ri-shield-cross-fill" style="color: #ef4444; margin-right: 8rpx;"></text>
        <text>违规扣除 / 没收保证金</text>
      </view>
      <view class="modal-summary">
        <view class="forfeit-target-staff" wx:if="{{forfeitStaffName}}">
          <text class="remix-icon ri-user-star-line"></text>
          <text>责任宠托师：<text class="strong">{{forfeitStaffName}}</text></text>
        </view>
        <view class="evidence-bind-tag" wx:if="{{forfeitEvidenceId}}">
          <text class="remix-icon ri-link"></text>
          <text>已联动出险违规证据单，扣款成功后证据将自动核销</text>
        </view>
        <view class="muted">当前记录最大可扣金额：<text style="color: #ea580c; font-weight: bold;">¥{{forfeitMaxAmount}}</text>。扣除后将直接核减宠托师可用保证金并记录流水留痕。</view>
      </view>
      <view class="form-section">
        <!-- 关联扣除建议列表 -->
        <view wx:if="{{forfeitEvidences && forfeitEvidences.length > 0}}" style="margin-bottom: 16rpx;">
          <view class="form-label" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx;">
            <text class="strong">关联扣除建议（勾选更改为已根据建议扣除）</text>
          </view>
          <view class="forfeit-evidences-box" style="display: flex; flex-direction: column; gap: 14rpx; max-height: 35vh; overflow-y: auto;">
            <view class="evidence-select-card {{item.selected ? 'card-selected' : ''}}" wx:for="{{forfeitEvidences}}" wx:key="_id" style="background: #fbfbfc; border: 2rpx solid {{item.selected ? '#fca5a5' : '#e5e7eb'}}; border-radius: 14rpx; padding: 16rpx;">
              <view class="evidence-select-top" data-index="{{index}}" bindtap="toggleEvidenceSelect" style="display: flex; align-items: flex-start; gap: 14rpx;">
                <view class="checkbox-box" style="width: 36rpx; height: 36rpx; border-radius: 6rpx; border: 2rpx solid {{item.selected ? '#ef4444' : '#d1d5db'}}; background: {{item.selected ? '#ef4444' : '#fff'}}; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 24rpx; flex-shrink: 0; margin-top: 4rpx;">
                  <text class="remix-icon ri-check-line" wx:if="{{item.selected}}"></text>
                </view>
                <view class="evidence-meta" style="flex: 1;">
                  <view class="evidence-reason-name strong" style="font-size: 24rpx; color: #1f2937;">{{item.reasonTypeName}}</view>
                  <view class="evidence-desc muted small" style="margin-top: 2rpx; color: #4b5563;">{{item.reasonText || '违规留证'}}</view>
                  <view class="evidence-order muted small" wx:if="{{item.orderNo}}" style="color: #9ca3af;">订单：{{item.orderNo}}</view>
                </view>
              </view>
              <view class="evidence-amount-row" wx:if="{{item.selected}}" style="margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx dashed #fed7aa; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10rpx;">
                <text class="suggest-tip muted small" style="color: #dc2626; font-weight: bold;" wx:if="{{item.deductAmount > 0}}">建议扣除：¥{{item.deductAmount}}</text>
                <view class="actual-input-wrap" style="display: flex; align-items: center; gap: 6rpx;">
                  <text class="actual-input-label" style="font-size: 22rpx; color: #047857; font-weight: bold;">实际根据建议扣除：</text>
                  <view class="input-with-symbol" style="display: flex; align-items: center; background: #fff; border: 1rpx solid #a7f3d0; border-radius: 8rpx; padding: 2rpx 8rpx;">
                    <text style="font-size: 22rpx; color: #059669; font-weight: bold; margin-right: 4rpx;">¥</text>
                    <input style="width: 120rpx; height: 44rpx; font-size: 24rpx; font-weight: bold; color: #047857;" type="digit" placeholder="金额" value="{{item.actualDeductAmountInput}}" data-index="{{index}}" bindinput="inputEvidenceActualAmount" />
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="form-label" style="display: flex; justify-content: space-between;">
          <text>扣除总金额 (元) *</text>
          <text class="muted" style="font-size: 22rpx;">不可超过 ¥{{forfeitMaxAmount}}</text>
        </view>
        <input type="digit" placeholder="请输入扣除金额，例如：100" value="{{forfeitAmountInput}}" bindinput="inputForfeitAmount" />

        <view class="form-label" style="margin-top: 18rpx;">扣除原因及违规描述 (必填)</view>
        <textarea placeholder="请填写具体扣除原因（如：严重违规私单交易、未到岗爽约、虚假打卡等）" value="{{forfeitReasonInput}}" bindinput="inputForfeitReason" />

        <view class="form-label" style="margin-top: 18rpx; display: flex; justify-content: space-between; align-items: center;">
          <text>违规举证截图 (仅管理可见，只限照片，最多4张)</text>
          <text class="muted" style="font-size: 22rpx;">{{forfeitImages.length}}/4</text>
        </view>
        <view class="forfeit-uploader-grid">
          <view class="uploader-thumb" wx:for="{{forfeitImages}}" wx:key="*this">
            <image src="{{item}}" mode="aspectFill" class="thumb-img" data-url="{{item}}" bindtap="previewForfeitModalImage" />
            <view class="thumb-remove" data-index="{{index}}" bindtap="removeForfeitImage">×</view>
          </view>
          <view class="uploader-add-btn" wx:if="{{forfeitImages.length < 4}}" bindtap="chooseForfeitImages">
            <text class="remix-icon ri-camera-line"></text>
            <text class="uploader-add-text">上传照片</text>
          </view>
        </view>
        <view class="muted" style="font-size: 22rpx; margin-top: 8rpx;">* 仅限照片/截图。举证留存仅管理员在后台可见，宠托师端不可见；可作为后续不认账时的维权证据。</view>
      </view>
      <view class="modal-actions">
        <button class="ghost-btn" bindtap="closeForfeitModal">取消</button>
        <button class="danger-btn" loading="{{forfeiting}}" disabled="{{forfeiting}}" bindtap="submitForfeitDeposit">确认扣除</button>
      </view>
    </view>
  </view>
</view>
