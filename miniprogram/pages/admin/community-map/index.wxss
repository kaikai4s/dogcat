@import "../../../styles/community-settings.wxss";
.admin-map-page { padding: 28rpx 28rpx 60rpx; color: #2d211a; }
.admin-map-page button, .edit-panel button { width: auto; min-width: 0; margin: 0; padding: 16rpx 20rpx; line-height: 1.4; font-size: 25rpx; white-space: nowrap; letter-spacing: 0; box-shadow: none; }
.admin-map-page button::after, .edit-panel button::after { border: 0; }
.management-tools { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; }
.management-tools picker { flex: 1; min-width: 0; }
.city-filter { padding: 18rpx; border: 1rpx solid #e6ddd4; border-radius: 16rpx; font-size: 25rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.admin-map-page .link-button { flex-shrink: 0; background: transparent; color: #176b5b; padding: 12rpx; font-size: 24rpx; }
.admin-map-page .add-button, .edit-panel .choose-button { background: #eaf5ef; color: #176b5b; border-radius: 18rpx; flex-shrink: 0; }
.admin-map-page .search-row input { width: 0; min-width: 0; height: 76rpx; margin: 0; border: 0; flex: 1; }
.admin-map-page .search-btn { flex: 0 0 auto; }
.management-tabs { display: flex; gap: 10rpx; background: #eee9e1; padding: 6rpx; border-radius: 20rpx; }
.management-tab { flex: 1; min-width: 0; text-align: center; padding: 18rpx 8rpx; border-radius: 16rpx; font-size: 25rpx; white-space: nowrap; color: #74665b; }
.management-tab.active { background: #fff; color: #176b5b; font-weight: 700; }
.result-line, .row-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.result-line { margin-top: 12rpx; color: #74665b; font-size: 24rpx; }
.community-name { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.state-tag { flex-shrink: 0; white-space: nowrap; padding: 6rpx 12rpx; background: #eaf5ef; color: #176b5b; font-size: 22rpx; border-radius: 12rpx; }
.candidate-count { font-size: 25rpx; color: #176b5b; line-height: 1.5; }
.row-actions { display: flex; gap: 12rpx; margin-top: 16rpx; }
.row-actions button { flex: 1; }
.admin-map-page .more-button { width: 100%; margin-top: 20rpx; }
.empty-copy { padding: 36rpx 12rpx; text-align: center; }
.error-box { background: #fff0e5; padding: 18rpx; border-radius: 16rpx; font-size: 25rpx; color: #9e451f; }
.edit-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(45,33,26,.4); z-index: 20; display: flex; align-items: center; justify-content: center; padding: 24rpx; }
.edit-panel { width: 100%; max-height: 90%; display: flex; flex-direction: column; border-radius: 28rpx; background: #fff9f2; overflow: hidden; }
.edit-header { padding: 24rpx 24rpx 0; flex-shrink: 0; }
.edit-scroll { flex: 1 1 auto; min-height: 0; height: 55vh; }
.edit-content { padding: 12rpx 24rpx 24rpx; }
.edit-panel .choose-button { width: 100%; padding: 22rpx 12rpx; }
.field-label { margin-top: 18rpx; font-size: 24rpx; color: #74665b; }
.edit-panel .field { background: #f0ece6; border: 0; border-radius: 14rpx; padding: 16rpx; font-size: 26rpx; margin: 8rpx 0; height: 78rpx; box-sizing: border-box; width: 100%; }
.edit-panel .aliases { height: 160rpx; }
.advanced-trigger { margin: 20rpx 0; font-size: 25rpx; color: #176b5b; }
.switch-line { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; margin: 20rpx 0; font-size: 27rpx; }
.edit-footer { display: flex; gap: 12rpx; padding: 20rpx 24rpx; border-top: 1rpx solid #e6ddd4; flex-shrink: 0; }
.edit-footer .secondary { flex: 0 0 auto; }
.edit-footer .primary { flex: 1; }
