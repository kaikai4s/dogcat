<wxs module="beijingTime" src="../../../../utils/beijing-time.wxs" />
<view class="admin-mall-page">
  <view class="admin-hero">
    <view class="hero-copy">
      <view class="badge">用品商城</view>
      <view class="title">商城订单</view>
      <view class="tip">按状态处理发货、物流和售后审核，优先关注待发货与待审核订单。</view>
    </view>
    <view class="hero-stats">
      <view><text>{{stats.pendingShip}}</text><text>待发货</text></view>
      <view><text>{{stats.refundApplied}}</text><text>售后待审</text></view>
      <view><text>{{stats.shipped}}</text><text>运输中</text></view>
    </view>
  </view>

  <view class="search-card">
    <input placeholder="订单号 / 手机 / 快递公司 / 快递单号" value="{{keyword}}" bindinput="inputKeyword" bindconfirm="search" />
    <button bindtap="search">搜索</button>
  </view>

  <scroll-view scroll-x class="cat-row compact-row">
    <view class="filter {{status === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" data-status="{{item.value}}" bindtap="chooseStatus">{{item.label}}</view>
  </scroll-view>

  <view class="order-card" wx:for="{{orders}}" wx:key="_id">
    <view class="order-head">
      <view class="order-title-block">
        <view class="strong">{{item.orderNo}}</view>
        <view class="muted">{{beijingTime.format(item.createdAt)}}</view>
      </view>
      <view class="badge {{item.statusClass}}">{{item.statusText}}</view>
    </view>

    <view class="order-summary">
      <view>
        <view class="muted">商品摘要</view>
        <view class="strong small">{{item.goodsSummary}}</view>
      </view>
      <view class="summary-price">¥{{item.payAmount}}</view>
    </view>

    <view class="goods-line" wx:for="{{item.items}}" wx:for-item="goods" wx:key="productId">
      <image wx:if="{{goods.coverFileId}}" src="{{goods.coverFileId}}" mode="aspectFill" />
      <view wx:else class="goods-placeholder">图</view>
      <view class="goods-main">
        <view class="strong small">{{goods.name}}</view>
        <view class="muted">{{goods.specText || '默认规格'}} × {{goods.quantity}}</view>
      </view>
      <view class="price">¥{{goods.price}}</view>
    </view>

    <view class="info-grid order-info-grid">
      <view><text>收货人</text><text>{{item.shippingAddress.contactName}}</text></view>
      <view><text>手机号</text><text>{{item.shippingAddress.contactPhone}}</text></view>
      <view class="wide"><text>收货地址</text><text>{{item.addressText || '-'}}</text></view>
      <view><text>支付</text><text>{{item.paymentStatusText}}</text></view>
      <view><text>售后</text><text>{{item.refundStatusText}}</text></view>
      <view class="wide"><text>物流</text><text>{{item.logisticsText}}</text></view>
    </view>

    <view class="refund-note" wx:if="{{item.refundStatus === 'applied' || item.refundStatus === 'return_shipped' || item.refundStatus === 'return_pending_ship'}}">
      <view class="badge danger-badge">{{item.afterSaleType === 'return_and_refund' ? '退货退款' : (item.afterSaleType === 'compensation' ? '少发/破损赔付' : '仅退款')}}</view>
      <view class="muted">{{item.refundReason || '用户申请售后'}}</view>
      <view class="muted" wx:if="{{item.refundStatus === 'return_shipped' && item.returnExpress}}">退货单号：{{item.returnExpress.expressCompany}} {{item.returnExpress.trackingNo}}</view>
    </view>
    <view class="refund-note" wx:if="{{item.compensationAmount}}">
      <view class="badge success">已赔付</view>
      <view class="muted">已赔付买家 ¥{{item.compensationAmount}} {{item.compensationRemark ? '(' + item.compensationRemark + ')' : ''}}</view>
    </view>

    <view class="actions inline-actions order-actions">
      <button wx:if="{{(item.canShip) && (adminSuper || adminPermissions.adminMall_shipOrder)}}" class="primary" data-id="{{item._id}}" bindtap="showShip">录入发货</button>
      <button wx:if="{{(item.trackingNo) && (adminSuper || adminPermissions.adminMall_queryOrderLogistics)}}" class="primary" data-id="{{item._id}}" bindtap="viewLogistics">查看物流</button>
      <button wx:if="{{item.trackingNo}}" data-id="{{item._id}}" bindtap="copyLogistics">复制单号</button>
      <button wx:if="{{(item.canAuditRefund) && (adminSuper || adminPermissions.adminMall_auditRefund)}}" class="danger" data-id="{{item._id}}" bindtap="showRefund">{{item.refundStatus === 'return_shipped' ? '验货退款' : '售后审核'}}</button>
      <button wx:if="{{adminSuper || adminPermissions.adminMall_updateOrderStatus}}" data-id="{{item._id}}" bindtap="openStatusModal">修改状态</button>
      <button wx:if="{{(item.canManualRefund) && (adminSuper || adminPermissions.adminMall_refundOrder)}}" class="danger" data-id="{{item._id}}" bindtap="openManualRefundModal">手动退款</button>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && !orders.length}}">暂无商城订单</view>

  <view class="modal-mask" wx:if="{{shipping}}">
    <view class="modal-card">
      <view class="modal-title">订单发货</view>
      <view class="modal-summary" wx:if="{{activeOrder}}">
        <view class="strong small">{{activeOrder.orderNo}}</view>
        <view class="muted">{{activeOrder.shippingAddress.contactName}} · {{activeOrder.shippingAddress.contactPhone}}</view>
        <view class="muted">{{activeOrder.addressText}}</view>
      </view>
      <view class="form-section">
        <view class="form-label">常用快递公司快捷选择</view>
        <view class="express-chip-row">
          <view class="chip {{shipForm.expressCompany === item ? 'active' : ''}}" wx:for="{{expressOptions}}" wx:key="*this" data-name="{{item}}" bindtap="chooseExpress">{{item}}</view>
        </view>
        <view class="form-label">快递公司名称</view>
        <input placeholder="如 顺丰速运 / 京东快递 / 中通快递" value="{{shipForm.expressCompany}}" data-field="expressCompany" bindinput="inputShip" />
        <view class="form-label">快递单号</view>
        <input placeholder="请输入快递单号" value="{{shipForm.trackingNo}}" data-field="trackingNo" bindinput="inputShip" />
      </view>
      <view class="modal-actions"><button bindtap="hideShip">取消</button><button wx:if="{{adminSuper || adminPermissions.adminMall_shipOrder}}" class="primary" bindtap="submitShip">确认发货</button></view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{refunding}}">
    <view class="modal-card">
      <view class="modal-title">{{activeOrder.refundStatus === 'return_shipped' ? '退货验货与退款' : '售后审核'}}</view>
      <view class="modal-summary" wx:if="{{activeOrder}}">
        <view class="strong small">{{activeOrder.orderNo}} · 实付 ¥{{activeOrder.payAmount}}</view>
        <view class="muted">售后类型：{{activeOrder.afterSaleType === 'return_and_refund' ? '退货退款' : (activeOrder.afterSaleType === 'compensation' ? '少发/破损赔付' : '仅退款')}}</view>
        <view class="muted">申请原因：{{activeOrder.refundReason || '未填写'}}</view>
        <view class="highlight-text" wx:if="{{activeOrder.refundStatus === 'return_shipped' && activeOrder.returnExpress}}">
          📦 买家已寄回：{{activeOrder.returnExpress.expressCompany}} · {{activeOrder.returnExpress.trackingNo}}
        </view>
        <view class="refund-images" wx:if="{{activeOrder.refundImages && activeOrder.refundImages.length}}">
          <image wx:for="{{activeOrder.refundImages}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
        </view>
      </view>
      <view class="form-section">
        <view class="switch-line">同意退款<switch checked="{{refundForm.approved}}" bindchange="switchRefund" /></view>
        <view wx:if="{{refundForm.approved}}">
          <view class="form-label">退款金额</view>
          <input type="digit" placeholder="退款金额" value="{{refundForm.refundAmount}}" data-field="refundAmount" bindinput="inputRefund" />
        </view>
        <view class="form-label">审核备注</view>
        <textarea placeholder="说明处理原因，用户可据此理解售后结果" value="{{refundForm.remark}}" data-field="remark" bindinput="inputRefund" />
      </view>
      <view class="modal-actions"><button bindtap="hideRefund">取消</button><button wx:if="{{adminSuper || adminPermissions.adminMall_auditRefund}}" class="primary" bindtap="submitRefund">提交审核</button></view>
    </view>
  </view>

  <!-- 修改订单状态弹窗 -->
  <view class="modal-mask" wx:if="{{showStatusModal}}">
    <view class="modal-card">
      <view class="modal-title">修改商城订单状态</view>
      <view class="modal-summary" wx:if="{{statusOrder}}">
        <view class="strong small">{{statusOrder.orderNo}}</view>
        <view class="muted">当前状态：{{statusOrder.statusText}}</view>
      </view>
      <view class="form-section">
        <view class="form-label">目标状态</view>
        <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="onStatusPickerChange">
          <view class="picker-line picker-select">
            <text>{{statusOptions[statusIndex].label}}</text>
            <text class="arrow">▼</text>
          </view>
        </picker>
        <view class="form-label">操作说明 / 变更原因</view>
        <textarea placeholder="请填写修改状态的原因（必填，存入操作日志与说明）" value="{{statusRemark}}" bindinput="inputStatusRemark" />
      </view>
      <view class="modal-actions">
        <button bindtap="closeStatusModal">取消</button>
        <button wx:if="{{adminSuper || adminPermissions.adminMall_updateOrderStatus}}" class="primary" loading="{{submittingStatus}}" disabled="{{submittingStatus}}" bindtap="submitUpdateStatus">确认修改</button>
      </view>
    </view>
  </view>

  <!-- 手动退款弹窗 -->
  <view class="modal-mask" wx:if="{{showManualRefundModal}}">
    <view class="modal-card">
      <view class="modal-title">手动处理退款</view>
      <view class="modal-summary" wx:if="{{manualRefundOrder}}">
        <view class="strong small">{{manualRefundOrder.orderNo}}</view>
        <view class="muted">实付金额：¥{{manualRefundOrder.payAmount || 0}} · 已退金额：¥{{manualRefundOrder.alreadyRefunded || 0}}</view>
        <view class="highlight-text">最多可退金额：¥{{manualRefundOrder.maxRefundable || 0}}</view>
      </view>
      <view class="form-section">
        <view class="form-label-row">
          <text class="form-label">退款金额 (元)</text>
          <text class="quick-link" bindtap="setFullManualRefund">全额退款 (¥{{manualRefundOrder.maxRefundable || 0}})</text>
        </view>
        <input type="digit" placeholder="请输入退款金额" value="{{manualRefundAmount}}" data-field="manualRefundAmount" bindinput="inputManualRefund" />
        <view class="form-label">退款说明</view>
        <input placeholder="请填写退款原因或说明（必填）" value="{{manualRefundReason}}" data-field="manualRefundReason" bindinput="inputManualRefund" />
      </view>
      <view class="modal-actions">
        <button bindtap="closeManualRefundModal">取消</button>
        <button wx:if="{{adminSuper || adminPermissions.adminMall_refundOrder}}" class="danger" loading="{{submittingManualRefund}}" disabled="{{submittingManualRefund}}" bindtap="submitManualRefund">确认退款</button>
      </view>
    </view>
  </view>

  <!-- 查看物流轨迹弹窗 -->
  <view class="modal-mask" wx:if="{{showLogisticsModal}}">
    <view class="modal-card tall logistics-modal">
      <view class="modal-title">物流轨迹追踪</view>
      <view class="modal-summary" wx:if="{{activeOrder}}">
        <view class="strong small">{{activeOrder.orderNo}}</view>
        <view class="muted">{{activeOrder.expressCompany}} · 单号：{{activeOrder.trackingNo}}</view>
      </view>
      <view wx:if="{{loadingLogistics}}" class="logistics-loading">
        <text class="spin-icon">⏳</text>
        <text>正在查询物流节点...</text>
      </view>
      <view wx:elif="{{activeLogistics && activeLogistics.traces && activeLogistics.traces.length}}" class="timeline-box">
        <view class="timeline-item {{index === 0 ? 'latest' : ''}}" wx:for="{{activeLogistics.traces}}" wx:key="time">
          <view class="timeline-dot-wrap">
            <view class="timeline-dot {{index === 0 ? 'pulse' : ''}}"></view>
            <view class="timeline-line" wx:if="{{index < activeLogistics.traces.length - 1}}"></view>
          </view>
          <view class="timeline-content">
            <view class="timeline-context">{{item.context}}</view>
            <view class="timeline-time">{{item.time}}</view>
          </view>
        </view>
      </view>
      <view wx:else class="logistics-empty">
        <text>{{activeLogistics.message || '暂无轨迹信息，请稍后重试。'}}</text>
      </view>
      <view class="modal-actions">
        <button class="primary" bindtap="closeLogisticsModal">关闭</button>
      </view>
    </view>
  </view>
</view>
<global-loading />
