.page { padding: 32rpx; }
.title { font-size: 42rpx; font-weight: 700; color: #2f241d; margin-bottom: 16rpx; }
.subtitle { font-size: 30rpx; font-weight: 600; margin: 28rpx 0 16rpx; }
.tip, .muted { color: #8a7b70; font-size: 26rpx; margin-bottom: 20rpx; }
.card { background: #fff; border-radius: 22rpx; padding: 28rpx; margin-bottom: 20rpx; }
.primary { background: #5b3f2f; color: #fff; border-radius: 999rpx; margin: 20rpx 0; }
.ghost { background: #fff; color: #5b3f2f; border-radius: 999rpx; margin: 20rpx 0; }
