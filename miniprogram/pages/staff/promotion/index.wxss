.promotion-page { min-height: 100vh; padding: 0 28rpx 160rpx; background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 100%); color: #2d211a; box-sizing: border-box; }
.hero { margin: 0 -28rpx 24rpx; padding: 44rpx 34rpx 38rpx; border-bottom-left-radius: 48rpx; border-bottom-right-radius: 48rpx; background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 100%); }
.badge { display: inline-flex; padding: 6rpx 18rpx; border-radius: 999rpx; color: #d45f22; background: rgba(255,255,255,.85); font-size: 24rpx; font-weight: 850; }
.title { margin-top: 16rpx; font-size: 40rpx; font-weight: 950; }
.desc, .muted { margin-top: 8rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.45; }
.card { margin-top: 24rpx; padding: 28rpx; border-radius: 36rpx; background: #fff; border: 1rpx solid rgba(255,153,102,.14); box-shadow: 0 14rpx 34rpx rgba(123,89,62,.06); }
.card-title { font-size: 30rpx; font-weight: 950; margin-bottom: 18rpx; }
.status-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.level { font-size: 34rpx; font-weight: 950; color: #e9672f; }
.progress { font-size: 42rpx; font-weight: 950; color: #00a870; }
.bar { margin-top: 22rpx; height: 18rpx; border-radius: 999rpx; background: #fff0e2; overflow: hidden; }
.bar-inner { height: 100%; border-radius: 999rpx; background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%); }
.reject { margin-top: 18rpx; color: #d45f22; font-size: 24rpx; }
.order-card { padding: 20rpx 0; border-bottom: 1rpx solid rgba(255,153,102,.12); }
.order-card:last-child { border-bottom: none; }
.order-title { font-size: 28rpx; font-weight: 900; }
.empty { padding: 30rpx 0; text-align: center; color: #8e8580; font-size: 26rpx; }
.textarea { width: 100%; min-height: 150rpx; padding: 20rpx; border-radius: 24rpx; background: #fff8ec; box-sizing: border-box; font-size: 26rpx; }
.primary-btn, .ghost-btn { margin-top: 24rpx; height: 88rpx; border: none; border-radius: 999rpx; font-size: 28rpx; font-weight: 900; display: flex; align-items: center; justify-content: center; }
.primary-btn { color: #fff; background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%); }
.ghost-btn { color: #d45f22; background: #fff0e2; }
