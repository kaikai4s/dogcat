<view class="page staff-sos-page {{themeClass}} {{fontClass}}">
  <view class="staff-hero danger-hero">
    <view class="hero-badge danger-badge">
      <text class="remix-icon ri-alarm-warning-fill hero-icon"></text>
      <text>紧急协助</text>
    </view>
    <view class="hero-title">一键 SOS</view>
    <view class="hero-desc">遇到宠物异常、入户风险或突发情况时立即提交，平台将进入异常处理流程。</view>
  </view>

  <view class="danger-notice-card">
    <view class="notice-head">
      <text class="remix-icon ri-shield-flash-line notice-icon"></text>
      <text>请优先保障人宠安全</text>
    </view>
    <view class="notice-desc">描述现场情况并提交平台处理；如需电话联络宠物主，请联系平台客服并报订单号，由管理员转接。</view>
  </view>

  <view class="card cs-card">
    <view class="card-subtitle">
      <text class="remix-icon ri-customer-service-2-line sub-icon"></text>
      <text>平台客服转接</text>
    </view>
    <view class="info-list">
      <view class="info-row"><view class="label">订单号</view><view class="value">{{order.orderNo || orderId}}</view></view>
      <view class="info-row"><view class="label">客服电话</view><view class="value">{{customerService.phone || '暂未配置'}}</view></view>
      <view class="info-row" wx:if="{{customerService.workHours}}"><view class="label">工作时间</view><view class="value">{{customerService.workHours}}</view></view>
    </view>
    <view class="action-grid">
      <button class="ghost-btn" bindtap="callCustomerService">
        <text class="remix-icon ri-phone-line"></text>
        <text>联系平台客服</text>
      </button>
      <button class="ghost-btn" bindtap="copyOrderNo">
        <text class="remix-icon ri-file-copy-line"></text>
        <text>复制订单号</text>
      </button>
    </view>
  </view>

  <view class="card form-card">
    <view class="card-subtitle">
      <text class="remix-icon ri-edit-2-line sub-icon danger-icon"></text>
      <text>现场情况说明</text>
    </view>
    <textarea class="sos-textarea" placeholder="请描述宠物状态、现场风险、已采取措施等" value="{{description}}" bindinput="input" />
  </view>

  <button class="danger-btn submit-sos-btn" bindtap="submit">
    <text class="remix-icon ri-alarm-warning-line"></text>
    <text>提交 SOS</text>
  </button>
</view>
