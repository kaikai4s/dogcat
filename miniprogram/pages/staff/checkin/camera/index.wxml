<view class="page">
  <view class="top-nav">
    <view class="nav-round" bindtap="goBack">‹</view>
  </view>
  <view class="dashboard-header">
    <view class="badge">实时证据</view>
    <view class="title">{{eventTypeText}} 打卡</view>
    <view class="tip">使用实时相机拍照上传，补充备注后提交到订单证据链。</view>
  </view>

  <view class="camera-shell">
    <camera device-position="back" flash="off" class="camera"></camera>
  </view>

  <button class="ghost" bindtap="takePhoto">实时拍照</button>
  <view class="notice" wx:if="{{mediaFileId}}">
    <view class="strong">照片已上传</view>
    <view class="muted">请确认现场情况后提交打卡。</view>
  </view>

  <view class="card form-card">
    <textarea placeholder="备注" value="{{remark}}" bindinput="input" />
  </view>

  <button class="primary" bindtap="submit">提交打卡</button>
</view>
