<view class="page staff-camera-page {{themeClass}} {{fontClass}}">
  <view class="staff-hero">
    <view class="hero-badge">
      <text class="remix-icon ri-camera-lens-fill hero-icon"></text>
      <text>现场证据</text>
    </view>
    <view class="hero-title">{{eventTypeText}} 打卡</view>
    <view class="hero-desc">{{isBeautyCheckin ? '上传服务中拍到的宠物美照，宠物家长可在服务报告中保存或加入宠物相册。' : '拍照或上传截图后将保存至订单证据链，服务结束前可删除并重新上传。'}}</view>
  </view>

  <view class="card form-card">
    <view class="card-subtitle">
      <text class="remix-icon ri-edit-2-line sub-icon"></text>
      <text>本次打卡备注</text>
    </view>
    <textarea class="remark-textarea" placeholder="备注（会随本次上传的照片保存）" value="{{remark}}" bindinput="input" />
  </view>

  <button class="primary-btn upload-btn" loading="{{uploading}}" disabled="{{uploading}}" bindtap="chooseAndCreateCheckins">
    <text class="remix-icon ri-image-add-line"></text>
    <text>{{uploading ? '上传中...' : (isBeautyCheckin ? '拍照 / 上传美照' : '拍照 / 上传截图')}}</text>
  </button>

  <view class="card photo-card">
    <view class="photo-head">
      <view>
        <view class="card-subtitle no-margin">
          <text class="remix-icon ri-gallery-line sub-icon"></text>
          <text>已上传照片</text>
        </view>
        <view class="photo-tip">{{photos.length}} 张，至少保留 1 张才计入必打卡。</view>
      </view>
      <view class="photo-count">{{photos.length}}</view>
    </view>

    <view class="photo-grid" wx:if="{{photos.length}}">
      <view class="photo-cell" wx:for="{{photos}}" wx:key="_id">
        <image class="checkin-photo" src="{{item.mediaFileId}}" mode="aspectFill" data-url="{{item.mediaFileId}}" bindtap="previewPhoto" />
        <view class="photo-meta">{{item.remark || '无备注'}}</view>
        <button class="mini-delete" data-id="{{item._id}}" loading="{{deletingId === item._id}}" disabled="{{deletingId === item._id}}" bindtap="deletePhoto">
          <text class="remix-icon ri-delete-bin-line"></text>
          <text>删除</text>
        </button>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <text class="remix-icon ri-image-add-line empty-icon"></text>
      <view class="empty-text">暂无照片，请拍照或上传截图</view>
    </view>
  </view>

  <button class="ghost-btn back-btn" bindtap="goBack">
    <text class="remix-icon ri-arrow-left-line"></text>
    <text>完成返回</text>
  </button>
</view>
