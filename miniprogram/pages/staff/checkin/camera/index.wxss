.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 18rpx;
}

.photo-cell {
  position: relative;
}

.checkin-photo {
  width: 100%;
  height: 180rpx;
  border-radius: 18rpx;
  background: var(--theme-bg-soft);
}

.photo-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--theme-text-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-delete {
  margin-top: 8rpx;
  padding: 0;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  color: #be123c;
  background: #fff1f2;
  border-radius: 14rpx;
}
