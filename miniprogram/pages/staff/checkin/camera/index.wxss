/* Staff checkin camera - Cute Pet Style UI redesign */
.staff-camera-page {
  min-height: 100vh;
  padding: 0 28rpx 100rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.staff-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon { font-size: 28rpx; }

.hero-title {
  color: #2d211a;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.card-subtitle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  margin-bottom: 18rpx;
}

.card-subtitle.no-margin { margin-bottom: 0; }

.sub-icon {
  color: #e9672f;
  font-size: 34rpx;
}

.remark-textarea {
  width: 100%;
  min-height: 150rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fff8ec;
  border: 1rpx solid rgba(255, 153, 102, 0.15);
  font-size: 26rpx;
  color: #2d211a;
  box-sizing: border-box;
}

.primary-btn,
.ghost-btn {
  min-height: 84rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
  line-height: 1;
}

.primary-btn {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.ghost-btn {
  background: #fff0e2;
  color: #7a6a5e;
}

.upload-btn,
.back-btn {
  width: 100%;
  margin-top: 24rpx;
}

.photo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.photo-tip {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 23rpx;
}

.photo-count {
  width: 58rpx;
  height: 58rpx;
  border-radius: 20rpx;
  background: #fff0e2;
  color: #e9672f;
  font-size: 28rpx;
  font-weight: 950;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.photo-cell {
  min-width: 0;
}

.checkin-photo {
  width: 100%;
  height: 180rpx;
  border-radius: 22rpx;
  background: #fff0e2;
}

.photo-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8e8580;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-delete {
  margin-top: 8rpx;
  padding: 0;
  height: 52rpx;
  border-radius: 16rpx;
  background: #fff4f7;
  color: #be123c;
  font-size: 22rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: none;
  line-height: 1;
}

.empty-state {
  padding: 60rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8e8580;
}

.empty-icon {
  font-size: 90rpx;
  color: #e2d9d2;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 26rpx;
}
