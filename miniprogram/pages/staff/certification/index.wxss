/* Staff certification page - Cute Pet Style UI redesign */
.staff-cert-page {
  min-height: 100vh;
  padding: 0 28rpx 200rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.staff-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon {
  font-size: 28rpx;
}

.hero-title {
  color: #2d211a;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.status-notice-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #fff4f0;
  border: 1rpx solid rgba(233, 103, 47, 0.2);
}

.status-notice-card.approved-card {
  background: linear-gradient(180deg, #f0faf2 0%, #f7fbf8 100%);
  border: 2rpx solid rgba(0, 180, 42, 0.22);
  box-shadow: 0 12rpx 32rpx rgba(0, 180, 42, 0.06);
}

.notice-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.notice-icon {
  font-size: 34rpx;
  color: #e9672f;
}

.green-icon {
  color: #00b42a !important;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #2d211a;
}

.notice-status {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 950;
  color: #e9672f;
}

.notice-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6d645e;
  line-height: 1.55;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.card-subtitle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  margin-bottom: 20rpx;
}

.card-subtitle.between-head {
  justify-content: space-between;
}

.sub-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.sub-icon {
  color: #e9672f;
  font-size: 34rpx;
}

.required-tag {
  font-size: 22rpx;
  color: #e9672f;
  font-weight: 850;
}

.section-divider {
  height: 1rpx;
  background: rgba(255, 153, 102, 0.12);
  margin: 32rpx 0;
}

.section-sub-tip {
  font-size: 22rpx;
  color: #8e8580;
  margin-top: -10rpx;
  margin-bottom: 20rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  font-size: 26rpx;
  font-weight: 850;
  color: #7a6a5e;
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #fff8ec;
  border: 1rpx solid rgba(255, 153, 102, 0.15);
  font-size: 28rpx;
  color: #2d211a;
  box-sizing: border-box;
}

.textarea-field {
  width: 100%;
  height: 140rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #fff8ec;
  border: 1rpx solid rgba(255, 153, 102, 0.15);
  font-size: 26rpx;
  color: #2d211a;
  box-sizing: border-box;
}

.photo-upload-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.upload-item {
  position: relative;
  height: 180rpx;
  border-radius: 24rpx;
  background: #fff8ec;
  border: 1rpx dashed rgba(233, 103, 47, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.upload-icon {
  font-size: 44rpx;
  color: #e9672f;
}

.upload-title {
  font-size: 20rpx;
  color: #7a6a5e;
  font-weight: 850;
}

.upload-status {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(45, 33, 26, 0.65);
  color: #ffffff;
  font-size: 18rpx;
  text-align: center;
  padding: 4rpx 0;
}

.upload-status.uploaded {
  background: rgba(0, 180, 42, 0.85);
}

.location-box {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff8ec;
  border: 1rpx dashed rgba(233, 103, 47, 0.3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.loc-info {
  flex: 1;
  min-width: 0;
}

.loc-text {
  font-size: 26rpx;
  font-weight: 850;
  color: #2d211a;
}

.loc-placeholder {
  font-size: 24rpx;
  color: #e9672f;
  font-weight: 850;
}

.loc-coord {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8e8580;
}

.mini-btn {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.radius-options {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.radius-pill {
  padding: 14rpx 28rpx;
  border-radius: 20rpx;
  background: #f7f3ee;
  color: #7a6a5e;
  font-size: 26rpx;
  font-weight: 850;
  border: 2rpx solid transparent;
}

.radius-pill.selected {
  background: #fff0e2;
  color: #e9672f;
  border-color: #ffb86c;
}

.action-btn-container {
  margin-top: 32rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
  line-height: 1;
}

/* Approved Card Actions */
.approved-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 30rpx;
}

.cert-btn {
  width: 100% !important;
  height: 94rpx !important;
  border-radius: 28rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  padding: 0 32rpx !important;
  box-sizing: border-box !important;
  border: none !important;
  line-height: 1 !important;
  transition: all 0.2s ease;
}

.cert-btn:after {
  display: none !important;
}

.cert-btn:active {
  transform: scale(0.985);
  opacity: 0.92;
}

.cert-btn-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.cert-icon {
  font-size: 36rpx;
}

.cert-arrow {
  font-size: 38rpx;
  opacity: 0.65;
}

/* 主按钮：品质感暖橙渐变 */
.primary-cert-btn {
  background: linear-gradient(135deg, #ff9447 0%, #fa541c 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 10rpx 28rpx rgba(250, 84, 28, 0.28) !important;
}

.primary-cert-btn .cert-icon {
  color: #ffe7ba;
}

/* 次按钮：白底橙边高质感卡片样式 */
.secondary-cert-btn {
  background: #ffffff !important;
  color: #d45f22 !important;
  border: 2rpx solid #ffd8bf !important;
  box-shadow: 0 8rpx 20rpx rgba(123, 89, 62, 0.05) !important;
}

.secondary-cert-btn .cert-icon {
  color: #fa541c;
}

/* 返回个人中心按钮：轻量透气质感 */
.back-profile-btn {
  width: 100% !important;
  height: 84rpx !important;
  margin: 36rpx auto 60rpx !important;
  border-radius: 26rpx !important;
  background: #ffffff !important;
  color: #8a7a70 !important;
  border: 1.5rpx solid rgba(138, 122, 112, 0.22) !important;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.03) !important;
  font-size: 26rpx !important;
  font-weight: 850 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 10rpx !important;
  line-height: 1 !important;
}

.back-profile-btn:after {
  display: none !important;
}

.back-profile-btn:active {
  transform: scale(0.985);
  background: #fdfaf7 !important;
  color: #5c4e46 !important;
}

/* Staff Bottom Nav */
.staff-bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 14rpx 10rpx calc(14rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff !important;
  border-top: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 -10rpx 36rpx rgba(123, 89, 62, 0.12);
  backdrop-filter: blur(16rpx);
  box-sizing: border-box;
}

.staff-bottom-nav .nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: #8e8580;
  font-weight: 700;
}

.staff-bottom-nav .nav-item.active {
  color: #e9672f;
  font-weight: 950;
}

.staff-bottom-nav .nav-icon {
  font-size: 44rpx;
  position: relative;
  line-height: 1;
}

.nav-red-dot {
  position: absolute;
  top: -2rpx;
  right: -6rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #f53f3f;
}
.gender-options { display: flex; align-items: center; gap: 48rpx; padding: 20rpx 0; }
.gender-option { display: flex; align-items: center; gap: 12rpx; font-size: 28rpx; }
