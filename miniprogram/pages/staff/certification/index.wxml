<view class="page"><view class="title">员工认证</view><view class="card" wx:if="{{profile}}">审核状态：{{profile.auditStatus}}</view><input placeholder="真实姓名" value="{{form.realName}}" data-field="realName" bindinput="input"/><input placeholder="手机号" value="{{form.phone}}" data-field="phone" bindinput="input"/><input placeholder="服务城市" value="{{form.serviceCity}}" data-field="serviceCity" bindinput="input"/><textarea placeholder="服务区域" value="{{form.serviceAreas}}" data-field="serviceAreas" bindinput="input"/><button class="primary" bindtap="submit">提交认证</button></view>