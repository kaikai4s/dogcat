<view class="page staff-schedule-page {{themeClass}} {{fontClass}}">

  <view class="staff-hero">
    <view class="hero-badge">
      <text class="remix-icon ri-calendar-event-fill hero-icon"></text>
      <text>排班日历</text>
    </view>
    <view class="hero-title">日期例外与预约占用</view>
    <view class="hero-desc">按周规则可在个人中心配置，在此处可灵活设定具体日期的休息或加班时间。</view>
  </view>

  <view class="card weekly-rule-card">
    <view class="info-row">
      <view class="label">
        <text class="remix-icon ri-calendar-check-line rule-icon"></text>
        <text>默认按周规则</text>
      </view>
      <view class="value schedule-text">{{weeklyScheduleText || '全天可预约'}}</view>
    </view>
  </view>

  <view class="section-title">
    <text class="remix-icon ri-calendar-2-line section-icon"></text>
    <text>排班预定计划</text>
  </view>

  <view class="calendar-grid">
    <view
      wx:for="{{calendar}}"
      wx:key="dateKey"
      class="card day-card {{selectedDate === item.dateKey ? 'active' : ''}} {{item.status === 'available' ? '' : 'rest'}}"
      data-date="{{item.dateKey}}"
      bindtap="selectDay"
    >
      <view class="day-head">
        <view class="date-text">{{item.dateKey}}</view>
        <view class="badge {{item.source === 'exception' ? 'pink' : 'gray'}}">{{item.sourceText}}</view>
      </view>
      <view class="day-sub">{{item.dayName}} · {{item.statusText}}</view>
      <view class="slot-text">
        <text class="remix-icon ri-time-line slot-icon"></text>
        <text>{{item.slotText}}</text>
      </view>
      <view class="busy-text" wx:if="{{item.busyText}}">{{item.busyText}}</view>
    </view>
  </view>

  <view class="card editor-card" wx:if="{{selectedDay}}">
    <view class="editor-head">
      <view class="editor-title-box">
        <view class="editor-title">设置 {{selectedDay.dateKey}}</view>
        <view class="editor-sub">{{selectedDay.dayName}} · 已接订单会自动占用该时间段</view>
      </view>
      <view class="badge pink">{{selectedDay.busyText}}</view>
    </view>

    <view class="chip-row">
      <view class="chip {{form.status === 'available' ? 'pink active' : ''}}" bindtap="setAvailable">
        <text class="remix-icon ri-checkbox-circle-line chip-icon"></text>
        <text>可预约接单</text>
      </view>
      <view class="chip {{form.status === 'unavailable' ? 'pink active' : ''}}" bindtap="setUnavailable">
        <text class="remix-icon ri-close-circle-line chip-icon"></text>
        <text>设为休息</text>
      </view>
    </view>

    <view wx:if="{{form.status === 'available'}}" class="slots-editor">
      <view class="slot-row" wx:for="{{form.slots}}" wx:key="index">
        <view class="slot-label">
          <text class="remix-icon ri-time-fill slot-row-icon"></text>
          <text>{{item.start}}:00 - {{item.end}}:00</text>
        </view>
        <view class="remove-btn" data-index="{{index}}" bindtap="removeSlot">
          <text class="remix-icon ri-delete-bin-line"></text> 删除
        </view>
      </view>

      <view class="add-row">
        <picker mode="selector" range="{{hourLabels}}" value="{{startHourIndex}}" bindchange="bindStartHourChange">
          <view class="picker-field">{{hourLabels[startHourIndex]}}</view>
        </picker>
        <view class="to-text">至</view>
        <picker mode="selector" range="{{hourLabels}}" value="{{endHourIndex}}" bindchange="bindEndHourChange">
          <view class="picker-field">{{hourLabels[endHourIndex]}}</view>
        </picker>
        <button class="add-btn" bindtap="addSlot">+ 添加</button>
      </view>
    </view>

    <input class="input-field remark-input" placeholder="输入备注，如临时休息、加班" value="{{form.remark}}" bindinput="inputRemark" />

    <view wx:if="{{selectedDay.busyOrders.length}}" class="busy-list">
      <view class="busy-subtitle">
        <text class="remix-icon ri-bookmark-3-line busy-icon"></text>
        <text>已接订单占用时间</text>
      </view>
      <view class="busy-item" wx:for="{{selectedDay.busyOrders}}" wx:key="orderId">
        <view class="busy-time">⏰ {{item.startTime}} 至 {{item.endTime}}</view>
        <view class="busy-summary">{{item.serviceSummary}}</view>
      </view>
    </view>

    <view class="action-btn-group">
      <button class="ghost-btn" bindtap="resetException">恢复按周规则</button>
      <button class="primary-btn" bindtap="saveException">保存日期例外</button>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && !calendar.length}}">
    <text class="remix-icon ri-calendar-close-line empty-icon"></text>
    <view class="empty-text">暂无排班数据</view>
  </view>
</view>
