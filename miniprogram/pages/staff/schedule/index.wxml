<view class="page staff-schedule-page {{themeClass}} {{fontClass}}">

  <view class="staff-hero">
    <view class="hero-badge">
      <text class="remix-icon ri-calendar-event-fill hero-icon"></text>
      <text>按周服务时间设置</text>
    </view>
    <view class="hero-title">设置每周接单时间</view>
    <view class="hero-desc">配置每周一至周日的服务时间段，用于判断订单是否在服务时间内</view>
  </view>

  <view class="preset-actions">
    <button class="preset-btn primary" bindtap="presetWeeklySchedule">
      <text class="remix-icon ri-checkbox-circle-line"></text>
      <text>一键设置全周 08:00-22:00</text>
    </button>
    <button class="preset-btn ghost" bindtap="clearWeeklySchedule">
      <text class="remix-icon ri-close-circle-line"></text>
      <text>清空所有时间</text>
    </button>
  </view>

  <!-- 星期切换 -->
  <scroll-view scroll-x class="weekday-tabs">
    <view
      wx:for="{{weekdays}}"
      wx:key="day"
      bindtap="switchDay"
      data-day="{{item.day}}"
      class="weekday-tab {{activeDay === item.day ? 'active' : ''}}"
    >
      <text>{{item.label}}</text>
      <text class="count" wx:if="{{weeklySchedule[item.day] && weeklySchedule[item.day].length > 0}}">({{weeklySchedule[item.day].length}})</text>
    </view>
  </scroll-view>

  <!-- 当前星期的时间段编辑 -->
  <view class="card schedule-editor-card">
    <view class="editor-head">
      <view class="editor-title">{{weekdays[activeDay - 1].label}} 服务时间段</view>
      <view class="clear-link" bindtap="clearCurrentDay">清空本日</view>
    </view>

    <!-- 时间段列表 -->
    <view class="slot-list" wx:if="{{weeklySchedule[activeDay] && weeklySchedule[activeDay].length > 0}}">
      <view
        wx:for="{{weeklySchedule[activeDay]}}"
        wx:key="index"
        class="slot-item"
      >
        <view class="slot-text">
          <text class="remix-icon ri-time-fill slot-icon"></text>
          <text>{{item.start}}:00 - {{item.end}}:00</text>
        </view>
        <view class="del-btn" data-index="{{index}}" bindtap="removeSlot">
          <text class="remix-icon ri-delete-bin-line"></text> 删除
        </view>
      </view>
    </view>
    <view class="empty-slot" wx:else>
      <text class="remix-icon ri-information-line empty-icon"></text>
      <text>{{weekdays[activeDay - 1].label}} 暂无服务时间段（该天不接单）</text>
    </view>

    <!-- 添加时间段 -->
    <view class="add-slot-section">
      <view class="add-slot-title">添加时间段</view>
      <view class="add-slot-row">
        <picker mode="selector" range="{{hourLabels}}" value="{{startHourIndex}}" bindchange="bindStartHourChange">
          <view class="picker-field">{{hourLabels[startHourIndex]}}</view>
        </picker>
        <text class="to-text">至</text>
        <picker mode="selector" range="{{hourLabels}}" value="{{endHourIndex}}" bindchange="bindEndHourChange">
          <view class="picker-field">{{hourLabels[endHourIndex]}}</view>
        </picker>
        <button class="add-btn" bindtap="addSlot">
          <text class="remix-icon ri-add-line"></text> 添加
        </button>
      </view>
    </view>

    <!-- 保存按钮 -->
    <button class="save-btn primary-btn" bindtap="saveWeeklySchedule" disabled="{{saving}}">
      <text class="remix-icon ri-save-line"></text>
      <text>{{saving ? '保存中...' : '保存按周服务时间'}}</text>
    </button>
  </view>

  <view class="empty-state" wx:if="{{loading}}">
    <text class="remix-icon ri-loader-4-line empty-icon rotating"></text>
    <view class="empty-text">加载中...</view>
  </view>
</view>
