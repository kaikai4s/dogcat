/* Staff schedule - Weekly service time settings */
.staff-schedule-page {
  min-height: 100vh;
  padding: 0 28rpx 100rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.staff-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon {
  font-size: 28rpx;
}

.hero-title {
  color: #2d211a;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

/* Preset actions */
.preset-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.preset-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  line-height: 1;
}

.preset-btn.primary {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.preset-btn.ghost {
  background: #fff0e2;
  color: #7a6a5e;
}

.preset-btn .remix-icon {
  font-size: 32rpx;
}

/* Weekday tabs */
.weekday-tabs {
  margin-top: 28rpx;
  white-space: nowrap;
}

.weekday-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 120rpx;
  height: 72rpx;
  margin-right: 12rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx solid rgba(255, 153, 102, 0.14);
  font-size: 26rpx;
  font-weight: 850;
  color: #7a6a5e;
  transition: all 0.2s ease;
}

.weekday-tab:last-child {
  margin-right: 0;
}

.weekday-tab.active {
  background: linear-gradient(135deg, #fff4e6 0%, #ffe8d6 100%);
  border-color: #ffb86c;
  color: #e9672f;
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 69, 0.15);
}

.weekday-tab .count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 122, 69, 0.15);
  font-size: 22rpx;
  font-weight: 900;
  color: #e9672f;
}

/* Schedule editor card */
.card {
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.schedule-editor-card {
  border: 2rpx solid rgba(255, 153, 102, 0.25);
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.editor-title {
  font-size: 32rpx;
  font-weight: 950;
  color: #2d211a;
}

.clear-link {
  color: #e9672f;
  font-size: 24rpx;
  font-weight: 850;
  padding: 6rpx 12rpx;
}

/* Slot list */
.slot-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.slot-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #fff8ec 0%, #fff4e6 100%);
  border: 1rpx solid rgba(255, 153, 102, 0.18);
}

.slot-text {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 850;
  color: #2d211a;
}

.slot-icon {
  color: #ff7a45;
  font-size: 32rpx;
}

.del-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(245, 63, 63, 0.08);
  color: #f53f3f;
  font-size: 24rpx;
  font-weight: 850;
}

.del-btn .remix-icon {
  font-size: 28rpx;
}

/* Empty slot */
.empty-slot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 40rpx 24rpx;
  border-radius: 22rpx;
  background: #faf7f5;
  border: 2rpx dashed rgba(142, 133, 128, 0.3);
  font-size: 26rpx;
  color: #8e8580;
  margin-bottom: 20rpx;
}

.empty-icon {
  font-size: 32rpx;
  color: #c9bfb8;
}

/* Add slot section */
.add-slot-section {
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 153, 102, 0.12);
  margin-top: 8rpx;
}

.add-slot-title {
  font-size: 26rpx;
  font-weight: 850;
  color: #7a6a5e;
  margin-bottom: 16rpx;
}

.add-slot-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.picker-field {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border-radius: 20rpx;
  background: #f7f3ee;
  border: 2rpx solid rgba(255, 153, 102, 0.18);
  font-size: 26rpx;
  font-weight: 850;
  color: #2d211a;
}

.to-text {
  font-size: 26rpx;
  color: #8e8580;
  font-weight: 850;
}

.add-btn {
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: none;
  line-height: 1;
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 69, 0.2);
}

.add-btn .remix-icon {
  font-size: 28rpx;
}

/* Save button */
.save-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 32rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
  line-height: 1;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 69, 0.25);
}

.save-btn .remix-icon {
  font-size: 36rpx;
}

.save-btn[disabled] {
  opacity: 0.6;
  box-shadow: none;
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #8e8580;
}

.empty-state .empty-icon {
  font-size: 120rpx;
  color: #e2d9d2;
}

.empty-state .empty-icon.rotating {
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

.empty-state .empty-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #8e8580;
}

/* Schedule Type Tabs */
.schedule-type-tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.schedule-tab {
  flex: 1;
  height: 84rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid rgba(255, 153, 102, 0.16);
  font-size: 27rpx;
  font-weight: 850;
  color: #7a6a5e;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  position: relative;
  transition: all 0.2s ease;
}

.schedule-tab.active {
  background: linear-gradient(135deg, #fff2e6 0%, #ffe6d4 100%);
  border-color: #ff8848;
  color: #ea580c;
  box-shadow: 0 6rpx 18rpx rgba(234, 88, 12, 0.14);
}

.schedule-tab .tab-icon {
  font-size: 32rpx;
}

.schedule-tab .tab-badge {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #ea580c;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1.2;
}

/* Card desc */
.card-desc {
  font-size: 24rpx;
  color: #8a7a70;
  line-height: 1.45;
  margin-bottom: 22rpx;
}

.card-icon {
  color: #ea580c;
  margin-right: 8rpx;
  font-size: 34rpx;
}

/* Until date card */
.until-status-box {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #faf7f4;
  border: 1rpx solid #eedecf;
  margin-bottom: 24rpx;
}

.until-status-box.has-until {
  background: #fff7ed;
  border-color: #fdba74;
}

.until-status-box .status-icon {
  font-size: 42rpx;
  color: #9a8a7e;
  flex-shrink: 0;
}

.until-status-box.has-until .status-icon {
  color: #ea580c;
}

.until-status-box .status-title {
  font-size: 28rpx;
  font-weight: 850;
  color: #2d211a;
}

.until-status-box.has-until .status-title {
  color: #c2410c;
}

.until-status-box .status-sub {
  font-size: 22rpx;
  color: #8a7a70;
  margin-top: 4rpx;
}

.until-actions-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.until-actions-row .preset-btn {
  flex: none;
  padding: 0 28rpx;
}

.until-actions-row .save-until-btn {
  margin-left: auto;
}

.danger-ghost {
  color: #dc2626 !important;
  background: #fef2f2 !important;
}

/* Rest dates card */
.add-rest-section {
  padding-top: 10rpx;
  margin-bottom: 28rpx;
}

.add-rest-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.rest-picker-field {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #2d211a;
}

.rest-picker-field .remix-icon {
  color: #ea580c;
  font-size: 32rpx;
}

.add-rest-btn {
  flex: none;
  min-width: 220rpx;
}

.rest-list-title {
  font-size: 26rpx;
  font-weight: 850;
  color: #4a3e36;
  margin-bottom: 16rpx;
}

.rest-dates-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.rest-date-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #fff9f6;
  border: 1rpx solid rgba(234, 88, 12, 0.2);
}

.rest-item-info {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.rest-date-text {
  font-size: 28rpx;
  font-weight: 850;
  color: #2d211a;
}

.rest-badge {
  font-size: 20rpx;
  font-weight: 850;
  color: #dc2626;
  background: #fee2e2;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.resume-work-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 60rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f0fdf4;
  color: #16a34a;
  border: 1rpx solid rgba(22, 163, 74, 0.25);
  font-size: 23rpx;
  font-weight: 850;
  line-height: 1;
}

.empty-icon.green {
  color: #16a34a !important;
}
