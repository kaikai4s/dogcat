.schedule-text {
  max-width: 460rpx;
  text-align: right;
  font-size: 24rpx;
  color: #666;
}

.calendar-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16rpx;
}

.day-card {
  border: 2rpx solid transparent;
  margin-bottom: 0;
}

.day-card.active {
  border-color: var(--theme-primary);
  box-shadow: 0 12rpx 28rpx var(--theme-shadow);
}

.day-card.rest {
  background: #fafafa;
}

.slot-text {
  margin: 10rpx 0;
  font-size: 26rpx;
  color: var(--theme-title);
  font-weight: 600;
}

.editor-head {
  align-items: flex-start;
  margin-bottom: 18rpx;
}

.slot-row,
.busy-item {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  background: var(--theme-bg-soft);
  color: var(--theme-title);
  font-size: 26rpx;
}

.remove {
  color: var(--theme-primary);
  font-size: 24rpx;
}

.add-row,
.row {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto;
  align-items: center;
  gap: 12rpx;
  margin: 18rpx 0;
}

.row {
  grid-template-columns: 1fr 1fr;
  margin-bottom: 0;
}

.remark {
  margin-top: 18rpx;
}

.busy-list {
  margin-top: 22rpx;
}
