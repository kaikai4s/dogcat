/* Staff schedule calendar - Cute Pet Style UI redesign */
.staff-schedule-page {
  min-height: 100vh;
  padding: 0 28rpx 100rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.staff-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon {
  font-size: 28rpx;
}

.hero-title {
  color: #2d211a;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.weekly-rule-card {
  margin-top: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-row .label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #7a6a5e;
  font-size: 26rpx;
  font-weight: 850;
}

.rule-icon {
  color: #e9672f;
  font-size: 32rpx;
}

.schedule-text {
  max-width: 440rpx;
  text-align: right;
  font-size: 26rpx;
  color: #2d211a;
  font-weight: 850;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 32rpx 0 20rpx;
  font-size: 30rpx;
  font-weight: 950;
  color: #2d211a;
}

.section-icon {
  color: #e9672f;
  font-size: 34rpx;
}

.calendar-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.day-card {
  margin-top: 0;
  padding: 24rpx 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.day-card.active {
  border-color: #ffb86c;
  background: #fffdfa;
  box-shadow: 0 12rpx 30rpx rgba(255, 122, 69, 0.12);
}

.day-card.rest {
  background: #faf7f5;
  opacity: 0.85;
}

.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-text {
  font-size: 30rpx;
  font-weight: 950;
  color: #2d211a;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
}

.badge.pink {
  background: #ffebe6;
  color: #e9672f;
}

.badge.gray {
  background: #f0eae5;
  color: #8e8580;
}

.day-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8e8580;
}

.slot-text {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #2d211a;
  font-weight: 850;
}

.slot-icon {
  color: #e9672f;
  font-size: 28rpx;
}

.busy-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #d45f22;
}

/* Editor card */
.editor-card {
  margin-top: 32rpx;
  border: 2rpx solid rgba(255, 153, 102, 0.25);
}

.editor-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.editor-title {
  font-size: 32rpx;
  font-weight: 950;
  color: #2d211a;
}

.editor-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8e8580;
}

.chip-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.chip {
  flex: 1;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f7f3ee;
  color: #7a6a5e;
  font-size: 26rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 2rpx solid transparent;
}

.chip.active {
  background: #fff0e2;
  color: #e9672f;
  border-color: #ffb86c;
}

.chip-icon {
  font-size: 32rpx;
}

.slots-editor {
  margin-bottom: 20rpx;
}

.slot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 20rpx;
  background: #fff8ec;
  border: 1rpx solid rgba(255, 153, 102, 0.12);
}

.slot-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 850;
  color: #2d211a;
}

.slot-row-icon {
  color: #e9672f;
  font-size: 28rpx;
}

.remove-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #f53f3f;
  font-size: 22rpx;
  font-weight: 850;
  padding: 6rpx 12rpx;
}

.add-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.picker-field {
  padding: 12rpx 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.2);
  font-size: 24rpx;
  font-weight: 850;
  color: #2d211a;
}

.to-text {
  font-size: 24rpx;
  color: #8e8580;
}

.add-btn {
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
  margin-left: auto;
}

.input-field {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 22rpx;
  background: #f7f3ee;
  border: 1rpx solid rgba(255, 153, 102, 0.1);
  font-size: 26rpx;
  color: #2d211a;
  box-sizing: border-box;
  margin-top: 16rpx;
}

.busy-list {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 153, 102, 0.12);
}

.busy-subtitle {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #d45f22;
  margin-bottom: 12rpx;
}

.busy-icon {
  font-size: 30rpx;
}

.busy-item {
  padding: 16rpx 20rpx;
  margin-bottom: 10rpx;
  border-radius: 18rpx;
  background: #fff4f0;
  border: 1rpx solid rgba(233, 103, 47, 0.15);
}

.busy-time {
  font-size: 26rpx;
  font-weight: 850;
  color: #2d211a;
}

.busy-summary {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7a6a5e;
}

.action-btn-group {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.ghost-btn {
  height: 80rpx;
  border-radius: 24rpx;
  background: #fff0e2;
  color: #7a6a5e;
  font-size: 26rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
}

.primary-btn {
  height: 80rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
  line-height: 1;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #8e8580;
}

.empty-icon {
  font-size: 100rpx;
  color: #e2d9d2;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 28rpx;
}
