<view class="page staff-profile-page">
  <view class="dashboard-header">
    <view class="badge">宠托师</view>
    <view class="title">我的宠托师主页</view>
    <view class="tip">这里是宠托师身份下的个人中心，不会跳回宠物主端。</view>
  </view>

  <view class="profile-hero staff-hero">
    <image class="profile-avatar" wx:if="{{avatarUrl}}" src="{{avatarUrl}}" mode="aspectFill" />
    <view class="profile-avatar" wx:else>护</view>
    <view class="profile-main">
      <view class="profile-name">{{displayName}}</view>
      <view class="profile-points">{{statusTitle}} · {{statusTip}}</view>
    </view>
  </view>

  <view class="card info-list" wx:if="{{profile}}">
    <view class="info-row"><view class="label">手机号</view><view class="value">{{profile.phone || '未填写'}}</view></view>
    <view class="info-row"><view class="label">服务城市</view><view class="value">{{profile.serviceCity || '未填写'}}</view></view>
    <view class="info-row"><view class="label">服务区域</view><view class="value">{{profile.serviceAreas || '未填写'}}</view></view>
    <view class="info-row"><view class="label">审核状态</view><view class="badge">{{statusTitle}}</view></view>
  </view>

  <view class="grid">
    <view class="card interactive action-card" data-url="/pages/staff/home/index" bindtap="go">
      <view class="action-icon">接</view>
      <view class="strong">接单工作台</view>
      <view class="muted">查看附近订单</view>
    </view>
    <view class="card interactive action-card" data-url="/pages/staff/orders/list/index" bindtap="go">
      <view class="action-icon">单</view>
      <view class="strong">我的任务</view>
      <view class="muted">查看已接订单</view>
    </view>
  </view>

  <view class="card menu-list">
    <view class="menu-item interactive" bindtap="editProfile">
      <view class="menu-left"><view class="menu-icon">名</view><view>编辑个人资料</view></view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item interactive" bindtap="openCertification">
      <view class="menu-left"><view class="menu-icon">证</view><view>入驻认证资料</view></view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item">
      <view class="menu-left"><view class="menu-icon">收</view><view>收益统计</view></view>
      <view class="menu-arrow">待完善</view>
    </view>
    <view class="menu-item">
      <view class="menu-left"><view class="menu-icon">评</view><view>我的评价</view></view>
      <view class="menu-arrow">待完善</view>
    </view>
    <view class="menu-item interactive" bindtap="backClientProfile">
      <view class="menu-left"><view class="menu-icon">主</view><view>切回宠物主个人中心</view></view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/staff/home/index" bindtap="go"><view class="nav-icon">⌂</view><view>工作台</view></view>
    <view class="nav-item" data-url="/pages/staff/orders/list/index" bindtap="go"><view class="nav-icon">☷</view><view>任务</view></view>
    <view class="nav-item" data-url="/pages/staff/certification/index" bindtap="go"><view class="nav-icon">☑</view><view>认证</view></view>
    <view class="nav-item active"><view class="nav-icon">♙</view><view>我的</view></view>
  </view>
</view>
