.staff-hero { margin-bottom: 24rpx; }
.staff-hero .profile-avatar { background: linear-gradient(135deg, var(--theme-primary) 0%, var(--theme-primary-2) 100%); color: #fff; }

.config-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 3000;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.6);
}

.config-modal-panel {
  width: 100%;
  max-height: 88vh;
  padding: 36rpx 30rpx calc(140rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 32rpx 32rpx 0 0;
  background: var(--theme-card-bg);
}

.config-modal-footer {
  position: sticky;
  bottom: 0;
  z-index: 2;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin: 30rpx -30rpx calc(-140rpx - env(safe-area-inset-bottom));
  padding: 22rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  background: var(--theme-card-bg);
  border-top: 1rpx solid var(--theme-border);
}

.config-footer-btn {
  width: 100%;
  margin: 0;
}
