<wxs module="beijingTime" src="../../../utils/beijing-time.wxs" />
<view class="page training-page {{themeClass}} {{fontClass}}">
  <staff-active-service-banner />
  <view class="hero">
    <view class="badge">宠托师成长中心</view>
    <view class="title">培训与线上视频审核</view>
    <view class="desc">依次完成培训视频、答题和管理员微信视频审核后，即可成为实习宠托师。</view>
  </view>

  <view class="card" wx:if="{{profile}}">
    <view class="card-title">当前身份</view>
    <view class="status-row">
      <view class="level">{{profile.staffLevelText}}</view>
      <view class="pill">{{profile.onboardingStatusText}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">入驻保证金与退出退款</view>
    <view class="guide-box warning-box" wx:if="{{depositState && depositState.supplyDeliveryRequired && depositState.deposit && depositState.deposit.status === 'paid' && !depositState.deposit.supplyPolicyAcceptedAt}}">已缴押金用户：平台首次用品寄送适用新规则，请在下方核对收货地址和用品费用后主动确认。暂不确认不会发货或扣用品费用，仍可按原缴纳规则申请退出退款。</view>
    <view class="muted">资料审核通过后，按平台配置缴纳可退保证金；金额以服务端展示为准，不设默认金额。</view>
    <view class="guide-box">
      <view>未领取平台首次用品的，退出时按原保证金规则结算；已确认并收到平台用品的，按用品费用减免审核结果结算。</view>
      <view>微信小店商品与平台寄送的首次用品互不关联。</view>
    </view>
    <view class="muted" wx:if="{{depositLoading}}">正在获取保证金状态...</view>
    <view class="muted" wx:if="{{depositError}}">状态获取失败，请刷新后再操作。</view>
    <block wx:if="{{depositState}}">
      <!-- 管理员要求重新缴纳警示条 -->
      <view class="repay-alert-box" wx:if="{{depositState.needsRepay}}">
        <view class="repay-alert-title"><text class="remix-icon ri-alarm-warning-fill"></text> 管理员已要求重新足额缴纳保证金</view>
        <view class="repay-alert-reason">原因：{{depositState.repayReason || '保证金余额不足或发生履约出险扣除，重新足额缴纳前暂不可接单'}}</view>
        <view class="repay-alert-amount">
          <text style="color: #991b1b; font-size: 24rpx; font-weight: 850;">需足额缴纳保证金额度：</text>
          <text style="color: #dc2626; font-size: 30rpx; font-weight: 950;">¥{{depositState.config.amount}}</text>
        </view>
        <view class="repay-alert-tip">⚠️ 在足额缴纳履约保证金之前，系统将限制接单与抢单资格。</view>
      </view>

      <view wx:if="{{depositState.config.amount != null}}">平台基准金额：¥{{depositState.config.amount}}</view>
      <view class="muted" wx:else>平台尚未提供缴纳金额，请勿自行转账。</view>
      <view class="muted" wx:if="{{!depositState.config.enabled}}">保证金缴纳当前未开放。</view>

      <view class="guide-box" wx:if="{{depositState.deposit}}">
        <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx;">
          <text class="strong-text" style="font-size: 30rpx;">当前保证金余额</text>
          <text class="price" style="font-size: 36rpx; font-weight: 950; color: #ea580c;">¥{{depositState.deposit.availableRefundAmount != null ? depositState.deposit.availableRefundAmount : '0.00'}}</text>
        </view>
        <view>当前状态：<text style="font-weight: 850; color: {{depositState.needsRepay ? '#ef4444' : '#10b981'}};">{{depositState.needsRepay ? '需补缴' : (depositState.deposit.statusText || '已缴纳')}}</text></view>
        <view wx:if="{{depositState.deposit.paidAmount != null}}">已缴总额：¥{{depositState.deposit.paidAmount}}</view>
        <view wx:if="{{depositState.deposit.forfeitedAmount > 0}}" style="color: #ef4444;">累计违规扣除：¥{{depositState.deposit.forfeitedAmount}}</view>
        <view wx:if="{{depositState.deposit.refundedAmount > 0}}">已退款金额：¥{{depositState.deposit.refundedAmount}}</view>
        <view wx:if="{{depositState.deposit.supplyFeeDeductedAmount > 0}}">已结算首次用品费用：¥{{depositState.deposit.supplyFeeDeductedAmount}}</view>
        <view wx:if="{{depositState.deposit.refundStatus}}">退款状态：{{depositState.deposit.refundStatusText || '退款处理中'}}</view>
      </view>
      <view class="muted" wx:else>暂无保证金缴纳记录。</view>

      <!-- 保证金变动明细与变更描述 -->
      <view class="deposit-events-section" wx:if="{{depositState.events && depositState.events.length}}">
        <view class="events-title"><text class="remix-icon ri-file-list-3-line"></text> 保证金变动明细与变更描述</view>
        <view class="event-item-card" wx:for="{{depositState.events}}" wx:key="_id">
          <view class="event-row-head">
            <view class="event-type-badge {{item.type === 'pay' ? 'badge-green' : (item.type === 'forfeit' ? 'badge-red' : 'badge-gray')}}">{{item.typeName}}</view>
            <view class="event-amount {{item.type === 'pay' ? 'amount-plus' : (item.type === 'forfeit' ? 'amount-minus' : '')}}">{{item.amountText}}</view>
          </view>
          <view class="event-desc">{{item.reason || '无具体说明'}}</view>
          <view class="event-time">{{beijingTime.format(item.createdAt)}}</view>
        </view>
      </view>

      <view class="rule-text" wx:if="{{!depositState.supplies.shippingEnabled && !(depositState.deposit && depositState.deposit.supplyShipment)}}">{{depositState.config.rulesText}}</view>
      <view class="rule-text" wx:if="{{!depositState.supplies.shippingEnabled && !(depositState.deposit && depositState.deposit.supplyShipment)}}">{{depositState.config.refundRulesText}}</view>
      <view class="rule-text" wx:else>首次用品费用按本人确认时的金额和实际发货、减免审核结果结算；未确认或未发货不扣用品费，未同意新规则的已缴用户仍可按原缴纳规则退出。</view>
      <view class="rule-text">{{depositState.config.forfeitRulesText}}</view>
      <view class="supply-delivery" wx:if="{{depositState.supplies.shippingEnabled || depositState.firstSupplyShipment}}">
        <view class="card-title">平台首次用品寄送</view>
        <view class="warning-text">用品费用 ¥{{depositState.firstSupplyShipment ? depositState.firstSupplyFeeAmount : (depositState.deposit && depositState.deposit.supplyPolicyAcceptedAt ? depositState.deposit.supplyFeeAmount : depositState.supplies.supplyFeeAmount)}}。认证后符合条件可申请费用减免；审核通过，退出退押金时不扣；未申请或未通过，已发货用品费用从可退押金中结算。申请待审先暂停结算。微信小店订单不参与此流程。</view>
        <view class="muted" wx:if="{{depositState.deposit && depositState.deposit.supplyPolicyAcceptedAt}}">已确认用品规则，费用按确认时金额固定。</view>
        <view class="muted" wx:if="{{depositState.firstSupplyShipment}}">已发货：{{depositState.firstSupplyShipment.expressCompany}} · {{depositState.firstSupplyShipment.trackingNo}}</view>
        <button class="ghost-btn" wx:if="{{depositState.firstSupplyShipment}}" bindtap="copySupplyTracking">复制快递单号</button>
        <button class="ghost-btn" wx:if="{{depositState.firstSupplyShipment}}" bindtap="querySupplyLogistics" disabled="{{depositBusy}}">查询用品物流</button>
        <view class="muted" wx:if="{{supplyLogistics}}">{{supplyLogistics.stateText || supplyLogistics.message}}</view>
        <view class="muted" wx:for="{{supplyLogistics.traces}}" wx:key="index">{{item.time || item.datetime}} {{item.context || item.description}}</view>
        <block wx:if="{{depositState.supplyDeliveryRequired && (depositState.canPay || (depositState.deposit && depositState.deposit.status === 'paid' && !depositState.deposit.supplyShipment))}}">
          <button class="ghost-btn" bindtap="chooseSupplyAddress" disabled="{{depositBusy}}">选择微信收货地址</button>
          <view class="field-label">收件人</view><input class="supply-address-input" value="{{supplyAddress.name}}" data-field="name" bindinput="supplyAddressInput" placeholder="收件人姓名" maxlength="40" />
          <view class="field-label">收件手机号</view><input class="supply-address-input" type="number" value="{{supplyAddress.phone}}" data-field="phone" bindinput="supplyAddressInput" placeholder="11 位手机号" maxlength="11" />
          <view class="field-label">省 / 市 / 区</view>
          <view class="supply-region"><input class="supply-address-input" value="{{supplyAddress.province}}" data-field="province" bindinput="supplyAddressInput" placeholder="省" /><input class="supply-address-input" value="{{supplyAddress.city}}" data-field="city" bindinput="supplyAddressInput" placeholder="市" /><input class="supply-address-input" value="{{supplyAddress.district}}" data-field="district" bindinput="supplyAddressInput" placeholder="区" /></view>
          <view class="field-label">详细地址</view><input class="supply-address-input" value="{{supplyAddress.detail}}" data-field="detail" bindinput="supplyAddressInput" placeholder="街道、门牌号" maxlength="100" />
          <checkbox-group bindchange="agreeSupply"><label class="acknowledgement"><checkbox value="agreed" checked="{{supplyAgreed}}" />我已核对收货地址，知悉平台首次用品费用及退押金时的减免／结算方式；不确认则不发货、不扣用品费，已缴押金仍可按原规则申请退款。</label></checkbox-group>
          <button class="primary-btn" wx:if="{{depositState.deposit && depositState.deposit.status === 'paid'}}" bindtap="confirmSupplyDelivery" disabled="{{!supplyAgreed || depositBusy}}">确认规则并提交收货地址</button>
        </block>
      </view>
      <block wx:if="{{depositState.canPay}}">
        <checkbox-group bindchange="agreeDeposit">
          <label class="acknowledgement"><checkbox value="agreed" checked="{{depositAgreed}}" disabled="{{depositBusy || depositLoading}}" />我已阅读并同意保证金缴纳与退出规则；首次用品费用按上方单独确认的规则结算。</label>
        </checkbox-group>
        <button class="primary-btn" bindtap="payDeposit" loading="{{depositBusy}}" disabled="{{!depositAgreed || (depositState.supplyDeliveryRequired && !supplyAgreed) || depositBusy || depositLoading || depositState.config.amount == null}}">{{depositState.needsRepay ? '重新足额缴纳保证金' : '微信支付保证金'}}</button>
      </block>
      <block wx:if="{{depositState.canRequestRefund}}">
        <textarea class="refund-input" placeholder="请填写自愿退出及退款原因" value="{{refundReason}}" bindinput="inputRefundReason" maxlength="500" disabled="{{depositBusy}}" />
        <button class="ghost-btn" bindtap="requestRefund" disabled="{{depositBusy || depositLoading}}">申请退出 / 保证金退款</button>
      </block>
    </block>
    <button class="ghost-btn" bindtap="loadDeposit" disabled="{{depositBusy || depositLoading}}">刷新保证金及退款状态</button>
    <view class="muted" wx:if="{{depositState.paymentSyncPending}}">微信支付结果暂未核实，请稍后刷新状态，勿重复支付。</view>
    <view class="muted">支付或退款是否完成均以服务端核实结果为准。</view>
  </view>

  <view class="card">
    <view class="card-title">视频审核物资与首次报销</view>
    <view class="guide-box">
      <view>视频审核必须准备：一次性手套、一次性口罩、一次性鞋套宠物安全消毒液。</view>
      <view>审核标准严格，备齐物资不代表必然通过，其他不符合要求的情况也可能导致审核失败。</view>
      <view>未获得正式认证不得申请首次用品费用减免；达到资格并通过审核后，退出结算不扣首次用品费用。后续用品由本人承担。</view>
    </view>
    <view class="muted">{{depositState.supplies.auditNotice}}</view>
    <view class="muted">{{depositState.supplies.serviceReminder}}</view>
    <button class="ghost-btn" bindtap="goReimbursement">首次用品费用减免 / 查看进度</button>
  </view>

  <view class="card">
    <view class="card-title">培训进度</view>
    <view class="steps">
      <view class="step {{item.done ? 'done' : ''}}" wx:for="{{steps}}" wx:key="title">
        <view class="dot">{{index + 1}}</view>
        <view class="step-main">
          <view class="step-title">{{item.title}}</view>
          <view class="step-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">培训视频</view>
    <view class="video-card" wx:for="{{videos}}" wx:key="key">
      <video
        wx:if="{{item.tempUrl}}"
        id="video-{{item.key}}"
        class="training-video"
        src="{{item.tempUrl}}"
        poster="{{item.posterTempUrl}}"
        controls
        enable-progress-gesture="{{item.watched ? true : false}}"
        show-progress="{{true}}"
        object-fit="contain"
        data-key="{{item.key}}"
        bindtimeupdate="onVideoTimeUpdate"
        bindseeking="onVideoSeeking"
        bindseekcomplete="onVideoSeekComplete"
        bindended="onVideoEnded"
      ></video>
      <view class="video-main">
        <view class="video-head-row">
          <view class="video-title">{{item.title}}</view>
          <view class="watch-status-badge {{item.watched ? 'done' : (item.progressPercent > 0 ? 'watching' : 'pending')}}">
            <text class="remix-icon {{item.watched ? 'ri-checkbox-circle-fill' : (item.progressPercent > 0 ? 'ri-play-circle-line' : 'ri-time-line')}}"></text>
            <text>{{item.watched ? '已看完' : (item.progressPercent > 0 ? '已看 ' + item.progressPercent + '%' : '待观看')}}</text>
          </view>
        </view>
        <view class="muted">{{item.durationText}} · {{item.description}}</view>
        <view class="done-text" wx:if="{{item.watched}}">✅ 已全程看完 {{item.watchedAtText}}</view>
        <view class="progress-tip" wx:elif="{{item.tempUrl}}">
          <text class="remix-icon ri-shield-check-line"></text>
          <text>防快进保护：须从头至尾完整播放，中途不可跳过或快进。</text>
        </view>
        <view class="muted" wx:else>视频资源暂不可播放，请联系管理员配置素材。</view>
      </view>
    </view>
    <view class="muted" wx:if="{{!videos.length}}">管理员暂未配置培训视频。</view>
  </view>

  <view class="card" wx:if="{{quiz}}">
    <view class="quiz-toggle" bindtap="toggleQuiz" role="button" aria-label="展开或收起培训答题">
      <view class="quiz-heading"><view class="card-title">培训答题</view><view class="quiz-caption">{{!quiz.unlocked ? '完成视频后解锁' : (quiz.passed ? '已通过 · 可展开回顾' : '点击展开，开始答题')}}</view></view>
      <text class="remix-icon {{!quiz.unlocked ? 'ri-lock-2-line' : 'ri-arrow-down-s-line'}} quiz-chevron {{quizExpanded ? 'expanded' : ''}}"></text>
    </view>
    <view class="quiz-locked" wx:if="{{!quiz.unlocked}}">已完成 {{watchedVideoCount}} / {{videos.length}} 个培训视频。请先完整观看全部视频，题目将在完成后解锁。</view>
    <view class="quiz-content" wx:if="{{quiz.unlocked && quizExpanded}}">
    <view class="muted">{{quiz.passed ? '已通过，得分 ' + quiz.score : '达到 ' + quiz.passScore + ' 分即可通过'}}</view>
    <view class="question" wx:for="{{quiz.questions}}" wx:key="id" wx:for-item="q">
      <view class="question-title">{{index + 1}}. {{q.question}}</view>
      <view class="option {{answers[q.id] === opt.value ? 'selected' : ''}}" wx:for="{{q.options}}" wx:key="value" wx:for-item="opt" data-question-id="{{q.id}}" data-value="{{opt.value}}" bindtap="selectAnswer">
        <text>{{opt.value}}.</text><text>{{opt.label}}</text>
      </view>
    </view>
    <button class="primary-btn" wx:if="{{!quiz.passed}}" bindtap="submitQuiz" loading="{{quizBusy}}" disabled="{{quizBusy}}">提交答题</button>
    </view>
  </view>

  <view class="card audit-card" wx:if="{{videoAuditGuide}}">
    <view class="card-title">线上视频通话审核</view>
    <view class="muted">{{videoAuditGuide.description}}</view>
    <view class="guide-box">
      <view class="wechat-row">
        <text>微信号：</text>
        <text class="wechat-val" user-select="{{true}}">{{videoAuditGuide.wechatId || '未配置'}}</text>
        <button class="mini-copy-btn" data-wechat="{{videoAuditGuide.wechatId}}" bindtap="copyAuditWechat">复制</button>
      </view>
      <view>添加备注：{{videoAuditGuide.remarkTemplate}}</view>
      <view wx:if="{{profile.videoAuditRemark}}">审核备注：{{profile.videoAuditRemark}}</view>
    </view>
    <view class="guide-box">
      <view class="strong-text">【视频通话审核必备物品要求】</view>
      <view>视频考核时须在镜头前展示已自备齐备的必备防护用品：</view>
      <view class="supply-list" style="margin: 12rpx 0;">
        <view class="supply-item-row" wx:for="{{supplyItems}}" wx:key="name">
          <view class="supply-item-info">
            <text class="supply-dot">•</text>
            <text class="supply-name">{{item.name}}</text>
            <text class="supply-desc" wx:if="{{item.description}}">（{{item.description}}）</text>
          </view>
          <view class="supply-buy-btn" wx:if="{{item.purchaseUrl}}" data-url="{{item.purchaseUrl}}" data-name="{{item.name}}" bindtap="openPurchaseUrl">
            <text class="remix-icon ri-shopping-cart-2-line"></text>
            <text>购买链接</text>
          </view>
        </view>
      </view>
      <view class="warning-text">平台审核要求上述物品为【必备】，缺一不可。</view>
    </view>
    <view class="guide-box warning-box">
      <view class="strong-text">【严审标准与风险提示】</view>
      <view>平台对审核员有严格的标准要求，存在考核不通过的风险。备齐物资是参加考核的前提，不代表必然通过；若因专业技能、服务规范或其他原因未正式通过认证，平台不予报销宠物用品。</view>
      <view class="muted">在正式成为【认证宠托师】后，可申请首次宠物用品报销（每人仅限首次申请，后续用品自备且不报销）。</view>
    </view>
    <button class="primary-btn" wx:if="{{canRequestVideoAudit}}" bindtap="requestVideoAudit">提交线上视频审核申请</button>
    <button class="ghost-btn" wx:elif="{{profile.videoAuditStatus === 'pending'}}">等待管理员审核</button>
    <button class="ghost-btn" wx:elif="{{profile.videoAuditStatus === 'approved'}}">视频审核已通过</button>
  </view>

  <button class="primary-btn" wx:if="{{profile.staffLevel === 'intern'}}" bindtap="goPromotion">查看实习转正进度</button>

  <!-- 自定义长按复制与一键复制弹窗 -->
  <view class="copy-modal-mask" wx:if="{{copyModal.show}}" catchtouchmove="noop" bindtap="closeCopyModal">
    <view class="copy-modal-card" catchtap="noop">
      <view class="copy-modal-header">
        <view class="copy-modal-title">{{copyModal.title}}</view>
        <view class="copy-modal-close" bindtap="closeCopyModal">
          <text class="remix-icon ri-close-line"></text>
        </view>
      </view>
      <view class="copy-modal-tip">{{copyModal.tip}}</view>
      <view class="copy-modal-content-box">
        <text class="copy-modal-text" user-select="{{true}}" selectable="{{true}}">{{copyModal.content}}</text>
      </view>
      <view class="copy-modal-hint">提示：可直接长按上方文字选择复制，也可点击下方按钮一键复制。</view>
      <view class="copy-modal-actions">
        <button class="copy-modal-btn ghost" bindtap="closeCopyModal">关闭</button>
        <button class="copy-modal-btn primary" bindtap="executeCopyModal">
          <text class="remix-icon ri-file-copy-line"></text>
          <text>{{copyModal.btnText || '一键复制'}}</text>
        </button>
      </view>
    </view>
  </view>
</view>
<global-loading />
