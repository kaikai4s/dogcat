.acknowledgement { display: block; font-size: 26rpx; line-height: 1.7; margin-top: 24rpx; }
.refund-input { box-sizing: border-box; width: 100%; min-height: 160rpx; margin-top: 24rpx; padding: 20rpx; background: #fff8ec; border-radius: 20rpx; font-size: 26rpx; }
.supply-delivery { border-top: 1rpx solid #eee1d6; margin-top: 24rpx; padding-top: 24rpx; }
.field-label { font-size: 24rpx; color: #6b5b50; margin: 14rpx 0 6rpx; }
.supply-address-input { box-sizing: border-box; width: 100%; min-width: 0; height: 76rpx; padding: 0 18rpx; background: #fff8ec; border: 1rpx solid #eedbcc; border-radius: 8rpx; font-size: 26rpx; }
.supply-region { display: flex; gap: 10rpx; }
