.deposit-address-confirmed { display: flex; gap: 12rpx; align-items: flex-start; padding: 20rpx; margin-top: 20rpx; border-radius: 18rpx; background: #edf8ef; }
.deposit-address-confirmed > .remix-icon { font-size: 32rpx; color: #187548; }
.deposit-address-confirmed .strong-text { font-size: 25rpx; color: #187548; line-height: 1.6; }
.deposit-address-confirmed > view { flex: 1; min-width: 0; overflow-wrap: anywhere; }
