.training-page { min-height: 100vh; padding: 0 28rpx 160rpx; background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 100%); color: #2d211a; box-sizing: border-box; }
.hero { margin: 0 -28rpx 24rpx; padding: 44rpx 34rpx 38rpx; border-bottom-left-radius: 48rpx; border-bottom-right-radius: 48rpx; background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 100%); }
.badge, .pill { display: inline-flex; padding: 6rpx 18rpx; border-radius: 999rpx; color: #d45f22; background: rgba(255,255,255,.85); font-size: 24rpx; font-weight: 850; }
.title { margin-top: 16rpx; font-size: 40rpx; font-weight: 950; }
.desc, .muted { margin-top: 8rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.45; }
.card { margin-top: 24rpx; padding: 28rpx; border-radius: 36rpx; background: #fff; border: 1rpx solid rgba(255,153,102,.14); box-shadow: 0 14rpx 34rpx rgba(123,89,62,.06); }
.card-title { font-size: 30rpx; font-weight: 950; margin-bottom: 18rpx; }
.status-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.level { font-size: 36rpx; font-weight: 950; color: #e9672f; }
.steps { display: flex; flex-direction: column; gap: 18rpx; }
.step { display: flex; align-items: center; gap: 18rpx; }
.dot { width: 48rpx; height: 48rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff0e2; color: #d45f22; font-weight: 900; }
.step.done .dot { background: #e6f8ea; color: #00b42a; }
.step-title { font-size: 28rpx; font-weight: 850; }
.step-desc { margin-top: 4rpx; font-size: 22rpx; color: #8e8580; }
.question { margin-top: 26rpx; }
.question-title { font-size: 28rpx; font-weight: 850; margin-bottom: 14rpx; }
.option { display: flex; gap: 12rpx; padding: 18rpx 20rpx; margin-top: 12rpx; border-radius: 22rpx; background: #fff8ec; color: #6b5b50; font-size: 26rpx; }
.option.selected { background: #ffebe6; color: #e9672f; font-weight: 850; }
.video-card { display: flex; flex-direction: column; align-items: stretch; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid rgba(255,153,102,.12); }
.video-card:last-child { border-bottom: none; }
.video-main { flex: 1; min-width: 0; }
.training-video { width: 100%; height: 360rpx; border-radius: 24rpx; overflow: hidden; background: #1f1f1f; }
.video-title { font-size: 28rpx; font-weight: 900; }
.done-text { margin-top: 8rpx; font-size: 22rpx; color: #00a870; }
.guide-box { margin: 18rpx 0; padding: 20rpx; border-radius: 24rpx; background: #fff8ec; color: #6b5b50; font-size: 26rpx; line-height: 1.8; }
.primary-btn, .ghost-btn, .mini-btn { border: none; border-radius: 999rpx; font-weight: 900; display: flex; align-items: center; justify-content: center; }
.primary-btn { margin-top: 24rpx; height: 88rpx; color: #fff; background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%); font-size: 28rpx; }
.ghost-btn { margin-top: 24rpx; height: 88rpx; color: #d45f22; background: #fff0e2; font-size: 28rpx; }
.mini-btn { min-width: 150rpx; height: 64rpx; padding: 0 20rpx; color: #fff; background: #ff8a4c; font-size: 24rpx; }
.mini-btn.done { color: #00a870; background: #e6f8ea; }
.rule-text { white-space: pre-wrap; font-size: 26rpx; line-height: 1.7; margin-top: 12rpx; }
.acknowledgement { display: block; font-size: 26rpx; line-height: 1.7; margin-top: 24rpx; }
.refund-input { box-sizing: border-box; width: 100%; min-height: 160rpx; margin-top: 24rpx; padding: 20rpx; background: #fff8ec; border-radius: 20rpx; font-size: 26rpx; }
button[disabled] { opacity: .55; }
.strong-text { font-weight: 900; color: #2d211a; margin-bottom: 8rpx; }
.warning-text { color: #e9672f; font-weight: 850; margin-top: 8rpx; }
.warning-box { background: #fff0eb; border: 1rpx solid #ffd1be; color: #8a3c1b; }
.wechat-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 6rpx; flex-wrap: wrap; }
.wechat-val { font-weight: 950; color: #e9672f; font-size: 28rpx; }
.mini-copy-btn { display: inline-flex; align-items: center; justify-content: center; height: 46rpx; padding: 0 20rpx; border-radius: 999rpx; background: #e9672f; color: #fff; font-size: 22rpx; font-weight: 900; line-height: 1; border: none; }
.mini-copy-btn:active { transform: scale(0.96); opacity: .9; }

.supply-list { display: flex; flex-direction: column; gap: 12rpx; }
.supply-item-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.supply-item-info { display: flex; align-items: center; flex-wrap: wrap; gap: 6rpx; font-size: 24rpx; color: #2d211a; }
.supply-dot { color: #e9672f; font-weight: 900; }
.supply-name { font-weight: 850; }
.supply-desc { color: #7a6a5e; font-size: 22rpx; }
.supply-buy-btn { display: inline-flex; align-items: center; gap: 6rpx; padding: 6rpx 16rpx; border-radius: 999rpx; background: #fff0e2; color: #e9672f; font-size: 22rpx; font-weight: 850; flex-shrink: 0; }
.supply-buy-btn:active { opacity: 0.8; transform: scale(0.96); }

