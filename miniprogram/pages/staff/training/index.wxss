.done-text { margin-top: 8rpx; font-size: 22rpx; color: #00a870; }
.guide-box { margin: 18rpx 0; padding: 20rpx; border-radius: 24rpx; background: #fff8ec; color: #6b5b50; font-size: 26rpx; line-height: 1.8; }
.primary-btn, .ghost-btn, .mini-btn { border: none; border-radius: 999rpx; font-weight: 900; display: flex; align-items: center; justify-content: center; }
.primary-btn { margin-top: 24rpx; height: 88rpx; color: #fff; background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%); font-size: 28rpx; }
.ghost-btn { margin-top: 24rpx; height: 88rpx; color: #d45f22; background: #fff0e2; font-size: 28rpx; }
.mini-btn { min-width: 150rpx; height: 64rpx; padding: 0 20rpx; color: #fff; background: #ff8a4c; font-size: 24rpx; }
