.deposit-modal-card { display: flex; flex-direction: column; width: 100%; max-width: 690rpx; max-height: 88vh; min-height: 0; border-radius: 30rpx; overflow: hidden; color: var(--text-primary, #2d211a); background: var(--bg-card, #fff); }
.deposit-modal-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 28rpx 28rpx 20rpx; flex-shrink: 0; border-bottom: 1rpx solid #eee1d6; }
