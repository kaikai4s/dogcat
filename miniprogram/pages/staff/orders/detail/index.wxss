.pet-header { align-items: flex-start; }
.photo-container { position: relative; width: 140rpx; height: 140rpx; margin-right: 22rpx; flex-shrink: 0; }
.pet-photo { width: 140rpx; height: 140rpx; border-radius: 34rpx; background: var(--theme-primary-soft); }
.empty-photo { display: flex; align-items: center; justify-content: center; font-size: 54rpx; }
.preview-tip { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0, 0, 0, 0.55); color: #fff; font-size: 18rpx; text-align: center; border-bottom-left-radius: 34rpx; border-bottom-right-radius: 34rpx; padding: 2rpx 0; }
.pet-name-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 6rpx; }
.pet-name { font-size: 32rpx; font-weight: 800; color: #1a1a1a; }
.species-badge { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 20rpx; background: var(--theme-primary-soft); color: var(--theme-primary); font-weight: 600; }
.pet-info-list { margin-top: 20rpx; }
.highlight-row { background: #fff8f0; padding: 14rpx 18rpx; border-radius: 16rpx; margin-bottom: 12rpx; border-left: 6rpx solid #ff9500; }
.label-highlight { color: #d97706; font-weight: 700; }
.value-highlight { color: #92400e; font-weight: 700; }
.danger-row { background: #fff1f2; border-left-color: var(--theme-primary); }
.label-danger { color: #e11d48; font-weight: 700; }
.value-danger { color: #be123c; font-weight: 700; }
