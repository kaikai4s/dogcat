<wxs module="beijingTime" src="../../../../utils/beijing-time.wxs" />
<view class="page staff-service-page {{themeClass}} {{fontClass}}">
  <staff-active-service-banner />
  <view class="staff-hero">
    <view class="hero-badge">
      <text class="remix-icon ri-shield-check-fill hero-icon"></text>
      <text>现场服务</text>
    </view>
    <view class="hero-title">服务履约控制台</view>
    <view class="hero-desc">按流程上传轨迹并完成打卡；门锁密码仅在服务窗口内展示并记录访问日志。</view>
  </view>

  <!-- 隐私沟通与通话快捷栏 -->
  <view class="contact-actions-bar" wx:if="{{order}}">
    <button class="ghost-btn contact-btn" bindtap="openPrivacyCall">
      <text class="remix-icon ri-phone-lock-fill"></text>
      <text>双向隐私通话</text>
    </button>
    <button class="ghost-btn contact-btn" bindtap="openSessionChat">
      <text class="remix-icon ri-message-3-fill"></text>
      <text>在线安全沟通</text>
    </button>
  </view>

  <view class="care-quick-card {{order.hasHighRiskCare ? 'high' : ''}}" wx:if="{{order && order.petNoticeRows && order.petNoticeRows.length}}" bindtap="toggleCareCard">
    <view class="care-quick-left">
      <text class="remix-icon ri-shield-heart-fill care-quick-icon"></text>
      <view>
        <view class="care-quick-title">{{order.hasHighRiskCare ? '高风险照护 · 点击查看' : '照护卡快捷查看'}}</view>
        <view class="care-quick-desc">下单时照护快照，服务前请核对喂食/用药/禁忌。</view>
      </view>
    </view>
    <text class="remix-icon {{showCareCard ? 'ri-arrow-up-s-line' : 'ri-arrow-down-s-line'}} care-quick-arrow"></text>
  </view>

  <!-- 出发前往服务地点卡片（已接单但尚未出发） -->
  <view class="card depart-card" wx:if="{{order && order.canDepart}}">
    <view class="card-subtitle">
      <text class="remix-icon ri-riding-line sub-icon"></text>
      <text>准备出发</text>
    </view>
    <view class="depart-desc">出发前往服务地点时，请点击下方按钮。系统将开启“时空雷达”，向宠物主实时同步预计到达时间，临近1公里时自动推送微信提醒。</view>
    <button class="primary-btn full-btn" loading="{{departing}}" disabled="{{departing}}" bindtap="departForService">
      <text class="remix-icon ri-navigation-fill"></text>
      <text>现在出发前往服务地点</text>
    </button>
  </view>

  <!-- 时空雷达运行中卡片（正在前往服务地点中） -->
  <view class="card radar-transit-card" wx:if="{{order && order.isOnTheWay}}">
    <view class="card-subtitle">
      <text class="remix-icon ri-radar-fill sub-icon radar-pulse-icon"></text>
      <text>时空雷达运行中 · 正在前往客户家</text>
    </view>
    <view class="radar-stats-grid">
      <view class="radar-stat-item">
        <view class="radar-stat-label">预计到达时间</view>
        <view class="radar-stat-val">{{order.travelEtaMinutes !== undefined ? order.travelEtaMinutes + ' 分钟' : '计算中'}}</view>
      </view>
      <view class="radar-stat-item">
        <view class="radar-stat-label">距客户家</view>
        <view class="radar-stat-val">{{order.travelDistanceKm !== undefined ? order.travelDistanceKm + ' 公里' : '计算中'}}</view>
      </view>
    </view>
    <view class="radar-proximity-notice" wx:if="{{order.radarProximityNotified || (order.travelDistanceKm && order.travelDistanceKm <= 1.0)}}">
      <text class="remix-icon ri-notification-3-fill"></text>
      <text>已触发临近到家提醒（距客户家1公里内/10分钟）</text>
    </view>
    <button class="ghost-btn full-btn refresh-eta-btn" loading="{{updatingTravelLocation}}" disabled="{{updatingTravelLocation}}" bindtap="updateTravelLocation">
      <text class="remix-icon ri-refresh-line"></text>
      <text>更新当前行程与到达时间</text>
    </button>
    <view class="radar-hint">到达现场后，请先佩戴手套鞋套完成隔离消毒拍照，即可点击下方“开始服务”。</view>
  </view>

  <view class="card pet-card" wx:if="{{order && order.petSnapshot}}">
    <view class="card-subtitle">
      <text class="remix-icon ri-footprint-line sub-icon"></text>
      <text>服务对象与照顾备注</text>
    </view>
    <view class="pet-row">
      <image class="pet-photo" wx:if="{{order.petSnapshot.avatarFileId}}" src="{{order.petSnapshot.avatarFileId}}" mode="aspectFill" bindtap="previewPetPhoto" />
      <view class="pet-photo placeholder" wx:else><text class="remix-icon ri-footprint-line"></text></view>
      <view class="pet-info">
        <view class="pet-name">{{order.petSnapshot.name || order.petName}} · {{order.petSnapshot.breed || '未知品种'}}</view>
        <view class="pet-title-badge" wx:if="{{order.petSnapshot.beautyTitle && order.petSnapshot.beautyTitle.title}}"><text class="remix-icon ri-vip-crown-line"></text><text>{{order.petSnapshot.beautyTitle.title}}</text></view>
        <view class="pet-desc" wx:if="{{order.petSnapshot.personality}}">性格：{{order.petSnapshot.personality}}</view>
        <view class="pet-note" wx:if="{{order.petSnapshot.specialNotes}}">备注：{{order.petSnapshot.specialNotes}}</view>
      </view>
    </view>
  </view>

  <view class="card requirement-card" wx:if="{{order}}">
    <view class="card-subtitle">
      <text class="remix-icon ri-list-check-3-line sub-icon"></text>
      <text>服务要求与注意事项</text>
    </view>
    <view class="requirement-grid">
      <view class="requirement-item">
        <view class="requirement-label">服务要求</view>
        <view class="requirement-value">{{order.serviceRequirementText}}</view>
      </view>
      <view class="requirement-item">
        <view class="requirement-label">服务时间</view>
        <view class="requirement-value highlight">{{order.serviceTimeText}}</view>
      </view>
      <view class="requirement-item" wx:if="{{order.isMultiDay}}">
        <view class="requirement-label">订单总时间</view>
        <view class="requirement-value">{{order.fullServiceTimeText}}</view>
      </view>
      <view class="requirement-item">
        <view class="requirement-label">客户备注</view>
        <view class="requirement-value">{{order.customerRemarkText || '客户暂无额外备注'}}</view>
      </view>
    </view>
    <view class="duration-section" wx:if="{{order.walkDurationRows && order.walkDurationRows.length}}">
      <view class="duration-title"><text class="remix-icon ri-walk-line"></text><text>遛狗时间</text></view>
      <view class="duration-chip" wx:for="{{order.walkDurationRows}}" wx:key="index">{{item.text}}</view>
    </view>
    <view class="duration-section" wx:if="{{order.playDurationRows && order.playDurationRows.length}}">
      <view class="duration-title"><text class="remix-icon ri-gamepad-line"></text><text>陪玩时间</text></view>
      <view class="duration-chip" wx:for="{{order.playDurationRows}}" wx:key="index">{{item.text}}</view>
    </view>
    <view class="pet-notice-section" wx:if="{{showCareCard && order.petNoticeRows && order.petNoticeRows.length}}">
      <view class="duration-title"><text class="remix-icon ri-error-warning-line"></text><text>下单时照护快照</text></view>
      <view class="care-snapshot-tip">后续修改宠物档案不会影响本订单已同步的信息。</view>
      <view class="pet-notice-row" wx:for="{{order.petNoticeRows}}" wx:for-item="petNotice" wx:key="index">
        <view class="pet-notice-head">
          <text class="pet-notice-name">{{petNotice.name}}</text>
          <text class="pet-risk-pill risk-{{petNotice.riskClass}}">{{petNotice.riskLevelText}}</text>
        </view>
        <view class="pet-notice-tags" wx:if="{{petNotice.tags && petNotice.tags.length}}">
          <text class="pet-notice-tag" wx:for="{{petNotice.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view wx:if="{{petNotice.sections && petNotice.sections.length}}">
          <view class="pet-notice-line" wx:for="{{petNotice.sections}}" wx:for-item="section" wx:key="label">
            <text class="pet-notice-label">{{section.label}}</text>
            <text class="pet-notice-text">{{section.text}}</text>
          </view>
        </view>
        <view class="pet-notice-empty" wx:else>暂无特别注意事项</view>
      </view>
    </view>
  </view>

  <view class="card operation-card">
    <view class="card-subtitle">
      <text class="remix-icon ri-play-circle-line sub-icon"></text>
      <text>服务操作</text>
    </view>
    <view class="service-timer-card" wx:if="{{order && order.serviceStarted}}">
      <text class="remix-icon ri-timer-flash-line timer-icon"></text>
      <view>
        <view class="timer-label">当前已服务</view>
        <view class="timer-value">{{serviceElapsedText}}</view>
      </view>
    </view>
    <view class="multi-day-tip" wx:if="{{order && order.isMultiDay}}">
      <text class="remix-icon ri-calendar-check-line"></text>
      <text>连续多天订单：每天需要重新开始服务并完成当天任务。</text>
    </view>
    <view class="pre-service-card" wx:if="{{order && order.canStartService}}">
      <view class="guide-box">
        <view class="strong-text">服务必备物品自备提醒：</view>
        <view class="supply-list">
          <view class="supply-item-row" wx:for="{{supplyItems}}" wx:key="name">
            <view class="supply-item-info">
              <text class="supply-dot">•</text>
              <text class="supply-name">{{item.name}}</text>
              <text class="supply-desc" wx:if="{{item.description}}">（{{item.description}}）</text>
            </view>
            <view class="supply-buy-btn" wx:if="{{item.purchaseUrl}}" data-url="{{item.purchaseUrl}}" data-name="{{item.name}}" bindtap="openPurchaseUrl">
              <text class="remix-icon ri-shopping-cart-2-line"></text>
              <text>购买链接</text>
            </view>
          </view>
        </view>
      </view>
      <view class="sanitization-status-box {{order.sanitizationCompleted ? 'done' : 'pending'}}" wx:if="{{order.sanitizationRequired}}">
        <view class="status-title">
          <text class="remix-icon {{order.sanitizationCompleted ? 'ri-checkbox-circle-fill' : 'ri-error-warning-fill'}}"></text>
          <text>{{order.sanitizationCompleted ? '已完成隔离病菌拍照打卡' : '服务前必须进行隔离病菌拍照打卡'}}</text>
        </view>
        <view class="status-desc">{{order.sanitizationCompleted ? '已现场拍摄手套口罩鞋套与消毒用品照片，符合服务开始要求。' : '根据服务规范，开始服务前必须现场佩戴手套口罩鞋套、手持消毒用品拍照打卡，未打卡无法开始服务。'}}</view>
        <button class="{{order.sanitizationCompleted ? 'ghost-btn' : 'primary-btn'}} full-btn" data-type="sanitization" bindtap="checkin">
          <text class="remix-icon ri-camera-lens-line"></text>
          <text>{{order.sanitizationCompleted ? '查看 / 补拍隔离病菌照片' : '立即拍摄：隔离病菌打卡'}}</text>
        </button>
      </view>
    </view>
    <view class="overdue-alert-banner" wx:if="{{order && order.isStartOverdue}}">
      <text class="remix-icon ri-alarm-warning-fill"></text>
      <text>服务已超出约定开始时间 {{order.startOverdueMinutes}} 分钟，请尽快打卡开始！</text>
    </view>
    <button class="primary-btn full-btn" wx:if="{{order && order.canStartService}}" loading="{{starting}}" disabled="{{starting}}" bindtap="start">{{starting ? '处理中...' : (order.isStartOverdue ? '加急开始服务' : '开始服务')}}</button>
    <button class="ghost-btn full-btn" loading="{{requestingEarlyStart}}" disabled="{{requestingEarlyStart || (earlyStartRequest && earlyStartRequest.status === 'pending')}}" wx:if="{{order && order.canRequestEarlyStart}}" bindtap="requestEarlyStart">{{earlyStartRequest && earlyStartRequest.status === 'pending' ? '提前开始申请待确认' : '申请提前开始服务'}}</button>
    <button class="ghost-btn full-btn cancel-accepted-btn" style="margin-top: 16rpx; color: #ef4444; border-color: #fca5a5;" loading="{{cancelling}}" disabled="{{cancelling}}" wx:if="{{order && !order.serviceStarted && (order.status === 'assigned' || order.status === 'on_the_way')}}" bindtap="cancelAcceptedOrder"><text class="remix-icon ri-close-circle-line"></text><text>取消接单 / 放弃服务</text></button>

    <view class="notice-card" wx:if="{{earlyStartRequest}}">
      <view class="notice-title">提前开始申请：{{earlyStartRequest.status === 'approved' ? '已同意' : (earlyStartRequest.status === 'rejected' ? '已拒绝' : '待宠物主确认')}}</view>
      <view class="notice-desc" wx:if="{{earlyStartRequest.reason}}">{{earlyStartRequest.reason}}</view>
    </view>

    <view class="security-card" wx:if="{{order && order.serviceStarted && order.orderHomeSecurity}}">
      <view class="security-head">
        <text class="remix-icon ri-door-lock-line security-icon"></text>
        <text>入户方式：{{order.orderHomeSecurity.lockMethodText}}</text>
      </view>
      <view class="security-desc" wx:if="{{order.orderHomeSecurity.type === 'someone_home'}}">有人在家，到达后敲门即可。</view>

      <view wx:if="{{order.orderHomeSecurity.type === 'remote_unlock'}}">
        <view class="security-desc">请到达客户门前确认环境安全后，点击下方“请求开门”。系统将向宠物主发送微信提醒，由宠物主在智能锁 App 远程开门；如需电话催办可联系平台客服协助。</view>
        <view class="info-row"><view class="label">订单号</view><view class="value">{{order.orderNo}}</view></view>
        <view class="info-row"><view class="label">客服电话</view><view class="value">{{customerService.phone || '暂未配置'}}</view></view>
        <view class="info-row" wx:if="{{customerService.workHours}}"><view class="label">服务时间</view><view class="value">{{customerService.workHours}}</view></view>
        <button class="ghost-btn full-btn" loading="{{requestingRemoteUnlock}}" disabled="{{requestingRemoteUnlock}}" bindtap="requestRemoteUnlock">已到达服务地点 / 请求开门</button>
        <view class="security-actions">
          <button class="ghost-btn" bindtap="callCustomerService"><text class="remix-icon ri-phone-line"></text>联系客服</button>
          <button class="ghost-btn" bindtap="copyOrderNo"><text class="remix-icon ri-file-copy-line"></text>复制订单号</button>
        </view>
        <view class="security-desc" wx:if="{{order.orderHomeSecurity.remoteUnlock && order.orderHomeSecurity.remoteUnlock.lastRequestedAt}}">最近请求：{{beijingTime.format(order.orderHomeSecurity.remoteUnlock.lastRequestedAt)}}</view>
        <view class="security-desc" wx:if="{{order.orderHomeSecurity.remoteUnlock && order.orderHomeSecurity.remoteUnlock.lastNotifyStatus}}">微信通知：{{order.orderHomeSecurity.remoteUnlock.lastNotifyStatusText || '已处理'}}</view>
        <view class="security-desc danger" wx:if="{{order.orderHomeSecurity.remoteUnlock && order.orderHomeSecurity.remoteUnlock.lastNotifyError}}">失败原因：{{order.orderHomeSecurity.remoteUnlock.lastNotifyError}}</view>
      </view>

      <view wx:if="{{order.orderHomeSecurity.type === 'one_time_code'}}">
        <view class="security-desc" wx:if="{{order.orderHomeSecurity.oneTimeCode && order.orderHomeSecurity.oneTimeCode.effectiveStart}}">密码区间：{{beijingTime.format(order.orderHomeSecurity.oneTimeCode.effectiveStart)}} 至 {{beijingTime.format(order.orderHomeSecurity.oneTimeCode.effectiveEnd)}}</view>
        <view class="security-desc success-desc" wx:if="{{order.isDoorLockCodeDestroyed || order.orderHomeSecurity.destroyed || order.orderHomeSecurity.isPasswordDestroyed || (order.orderHomeSecurity.oneTimeCode && order.orderHomeSecurity.oneTimeCode.destroyed)}}">
          <text class="remix-icon ri-shield-check-fill"></text>
          <text>门锁密码已安全销毁（已确认离户脱敏抹除，不可再查看）</text>
        </view>
        <button class="ghost-btn full-btn" wx:if="{{!order.isDoorLockCodeDestroyed && !order.orderHomeSecurity.destroyed && !order.orderHomeSecurity.isPasswordDestroyed && (!order.orderHomeSecurity.oneTimeCode || !order.orderHomeSecurity.oneTimeCode.destroyed)}}" bindtap="unlock"><text class="remix-icon ri-eye-line"></text>查看一次性开门密码</button>
      </view>

      <view wx:if="{{order.orderHomeSecurity.type === 'key'}}">
        <view class="info-row"><view class="label">钥匙位置</view><view class="value">{{order.orderHomeSecurity.key.location}}</view></view>
        <view class="image-list" wx:if="{{order.orderHomeSecurity.key.imageFileIds.length}}"><image wx:for="{{order.orderHomeSecurity.key.imageFileIds}}" wx:key="*this" class="security-image" src="{{item}}" mode="aspectFill" /></view>
        <view class="security-desc">{{order.orderHomeSecurity.key.returnedAt ? '已完成放回钥匙打卡，照片已留存' : '钥匙安全责任：请核对照片寻匙开门；服务结束离开前必须原位放回并拍照打卡，确保锁闭'}}</view>
        <button class="ghost-btn full-btn" wx:if="{{!order.orderHomeSecurity.key.returnedAt}}" loading="{{returningKey}}" disabled="{{returningKey}}" bindtap="chooseKeyReturnImage">上传放回钥匙图片</button>
        <view class="image-list" wx:if="{{keyReturnImageFileIds.length}}"><image wx:for="{{keyReturnImageFileIds}}" wx:key="*this" class="security-image" src="{{item}}" mode="aspectFill" /></view>
        <button class="primary-btn full-btn" wx:if="{{!order.orderHomeSecurity.key.returnedAt}}" loading="{{returningKey}}" disabled="{{returningKey}}" bindtap="recordKeyReturned">确认已放回钥匙</button>
      </view>
    </view>
  </view>

  <view class="security-card unlock-result" wx:if="{{order && order.serviceStarted && unlock && !order.isDoorLockCodeDestroyed && !order.orderHomeSecurity.destroyed && !order.orderHomeSecurity.isPasswordDestroyed}}">
    <view class="info-row"><view class="label">入户方式</view><view class="value">{{unlock.lockMethodText || '服务入户'}}</view></view>
    <view class="info-row" wx:if="{{unlock.doorLockCode}}"><view class="label">{{unlock.sessionIndex ? '第' + unlock.sessionIndex + '天门锁密码' : '门锁密码'}}</view><view class="value code-text">{{unlock.doorLockCode}}</view></view>
    <view class="security-desc" wx:if="{{unlock.doorLockCode}}">此密码为客户在智能门锁 App 中生成的本场次临时开门密码，仅在当前服务时间窗口内有效。</view>
    <view class="info-row" wx:if="{{unlock.keyLocation}}"><view class="label">钥匙位置</view><view class="value">{{unlock.keyLocation}}</view></view>
    <view class="info-row" wx:if="{{unlock.entryNotes}}"><view class="label">入户备注</view><view class="value">{{unlock.entryNotes}}</view></view>
  </view>

  <view wx:if="{{order && order.serviceStarted}}">
    <view class="card track-card">
      <view class="card-subtitle">
        <text class="remix-icon ri-map-pin-line sub-icon"></text>
        <text>轨迹记录</text>
      </view>
      <view class="badge green" wx:if="{{autoTracking}}">{{backgroundTracking ? '后台记录中' : '自动记录中'}}</view>
      <view class="track-text">{{trackStatusText}}</view>
      <view class="track-text" wx:if="{{latestTrackText}}">{{latestTrackText}}</view>
      <button class="ghost-btn full-btn" bindtap="uploadPoint">手动补记当前位置</button>
      <view class="track-tips">服务期间会定时记录当前位置，用户端会按时间生成路径。</view>
      <view class="track-count">已上传轨迹点：{{pointCount}}</view>
      <view class="track-tips danger" wx:if="{{offlineTaskCount}}">待补传数据：{{offlineTaskCount}} 条，网络恢复后自动上传。</view>
    </view>

    <view class="section-title">
      <text class="remix-icon ri-camera-lens-line section-icon"></text>
      <text>打卡证据</text>
    </view>
    <view class="checkin-grid" wx:if="{{order.checkinRequirements && order.checkinRequirements.length}}">
      <button class="checkin-btn" wx:for="{{order.checkinRequirements}}" wx:key="eventType" data-type="{{item.eventType}}" bindtap="checkin">
        <text class="remix-icon {{item.photoCount ? 'ri-checkbox-circle-fill' : 'ri-camera-lens-line'}} checkin-icon"></text>
        <text>{{item.label}}</text>
        <text class="checkin-meta" wx:if="{{item.photoCount}}">{{item.photoCount}}张</text>
        <text class="checkin-meta" wx:elif="{{item.required}}">必打卡</text>
        <text class="checkin-meta" wx:else>选填</text>
      </button>
    </view>
    <view class="empty-state" wx:else>暂无打卡要求</view>

    <view class="overdue-alert-banner warning" wx:if="{{order && order.isFinishOverdue}}">
      <text class="remix-icon ri-time-fill"></text>
      <text>已超过约定服务时间 {{order.finishOverdueMinutes}} 分钟！{{order.allCheckinsDone ? '打卡已齐全，请点击下方【完成服务】结算收益；若超时30分钟未操作，系统将自动结算。' : '请确认服务进度并尽快补全打卡照片。'}}</text>
    </view>
    <button class="primary-btn finish-btn {{order.allCheckinsDone ? 'highlight-btn' : ''}}" loading="{{finishing}}" disabled="{{finishing}}" bindtap="finish">{{finishing ? '处理中...' : (order.allCheckinsDone ? '确认离开并完成服务' : '完成服务')}}</button>
  </view>
</view>

<!-- 双向隐私通话合规弹窗 -->
<view class="custom-modal-mask" wx:if="{{showCallModal}}">
  <view class="custom-modal-box">
    <view class="custom-modal-title">
      <text class="remix-icon ri-shield-check-fill security-badge-icon"></text>
      <text>双向隐私保护通话</text>
    </view>
    <view class="privacy-warning-box">
      <view class="warning-title">
        <text class="remix-icon ri-alarm-warning-fill"></text>
        <text>通话全程录音与质检提醒</text>
      </view>
      <view class="warning-text">{{privacyCallInfo.warningNotice || '平台提示：通话全程已录音并开启AI风控质检。请严格遵守平台规范，严禁私下索要或告知电话、微信、私下交易等跳单导流行为，违者将被扣除保证金并永久封禁。'}}</view>
    </view>
    <view class="privacy-phone-card">
      <view class="phone-label">平台分配隐私保护号：</view>
      <view class="phone-number">{{privacyCallInfo.privacyNumber || '400-888-9999'}}</view>
      <view class="phone-ext" wx:if="{{privacyCallInfo.extensionCode}}">分机号：{{privacyCallInfo.extensionCode}}</view>
      <view class="phone-target">接听方：客户（{{privacyCallInfo.maskedTargetPhone || '号码已隐藏'}}）</view>
    </view>
    <view class="custom-modal-actions">
      <button class="primary-btn call-action-btn" bindtap="confirmPrivacyCall">拨打虚拟号</button>
      <button class="ghost-btn cancel-action-btn" bindtap="closePrivacyCallModal">取消</button>
    </view>
  </view>
</view>

<!-- 在线即时安全沟通弹窗 -->
<view class="custom-modal-mask" wx:if="{{showChatModal}}">
  <view class="chat-modal-box">
    <view class="chat-header">
      <view class="chat-title">订单安全即时会话</view>
      <view class="remix-icon ri-close-line close-btn" bindtap="closeSessionChat"></view>
    </view>
    <view class="chat-warning-banner">
      <text class="remix-icon ri-shield-alert-fill"></text>
      <text>严禁索要或发送微信号/手机号/私下转账，系统AI实时风控拦截。</text>
    </view>
    <view wx:if="{{sessionChatError}}" class="chat-sync-status">{{sessionChatError}}</view>
    <scroll-view class="chat-body" scroll-y scroll-into-view="{{sessionScrollTarget}}" bindscroll="onSessionChatScroll" bindscrolltolower="onSessionChatBottom" lower-threshold="60">
      <view class="chat-empty" wx:if="{{!sessionMessages.length}}">暂无沟通记录，若有突发情况请在此与客户联系</view>
      <view class="chat-msg-row {{item.senderRole === 'staff' ? 'self' : 'other'}}" wx:for="{{sessionMessages}}" wx:key="_id" id="session-message-{{index}}">
        <view class="msg-sender">{{item.senderRole === 'staff' ? '我 (宠托师)' : '客户'}}</view>
        <view class="msg-bubble">{{item.content}}</view>
        <view class="msg-time">{{beijingTime.format(item.createdAt)}}</view>
      </view>
    </scroll-view>
    <view wx:if="{{sessionUnreadCount}}" class="chat-new-messages" bindtap="scrollSessionChatToBottom">{{sessionUnreadCount}} 条新消息 · 点击查看</view>
    <view class="chat-footer">
      <input class="chat-input" placeholder="输入沟通信息（自动风控过滤）" value="{{sessionInputText}}" bindinput="onChatInput" />
      <button class="primary-btn chat-send-btn" loading="{{sendingChatMessage}}" disabled="{{sendingChatMessage}}" bindtap="sendChatMessage">发送</button>
    </view>
  </view>
</view>

<view class="care-risk-modal-mask" wx:if="{{showCareRiskModal}}" catchtap="closeCareRiskModal">
  <view class="care-risk-modal" catchtap="true">
    <view class="care-risk-title">高风险照护确认</view>
    <view class="care-risk-desc">开始服务前，请确认已阅读以下宠物的喂食、用药、禁忌和紧急备注。</view>
    <view class="care-risk-pet" wx:for="{{order.highRiskCareCards}}" wx:for-item="care" wx:key="name">
      <view class="pet-notice-head">
        <text class="pet-notice-name">{{care.name}}</text>
        <text class="pet-risk-pill risk-{{care.riskClass}}">{{care.riskLevelText}}</text>
      </view>
      <view class="pet-notice-tags" wx:if="{{care.tags && care.tags.length}}">
        <text class="pet-notice-tag" wx:for="{{care.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
      <view class="pet-notice-line" wx:for="{{care.sections}}" wx:for-item="section" wx:key="label">
        <text class="pet-notice-label">{{section.label}}</text>
        <text class="pet-notice-text">{{section.text}}</text>
      </view>
    </view>
    <button class="primary-btn full-btn" bindtap="confirmCareRiskStart">我已阅读，继续开始服务</button>
    <button class="ghost-btn full-btn" bindtap="closeCareRiskModal">取消</button>
  </view>
</view>

<global-loading />
