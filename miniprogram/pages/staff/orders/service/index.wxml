<view class="page staff-service-page {{themeClass}} {{fontClass}}">
  <staff-active-service-banner />
  <view class="staff-hero">
    <view class="hero-badge">
      <text class="remix-icon ri-shield-check-fill hero-icon"></text>
      <text>现场服务</text>
    </view>
    <view class="hero-title">服务履约控制台</view>
    <view class="hero-desc">按流程上传轨迹并完成打卡；门锁密码仅在服务窗口内展示并记录访问日志。</view>
  </view>

  <view class="card pet-card" wx:if="{{order && order.petSnapshot}}">
    <view class="card-subtitle">
      <text class="remix-icon ri-footprint-line sub-icon"></text>
      <text>服务对象与照顾备注</text>
    </view>
    <view class="pet-row">
      <image class="pet-photo" wx:if="{{order.petSnapshot.avatarFileId}}" src="{{order.petSnapshot.avatarFileId}}" mode="aspectFill" bindtap="previewPetPhoto" />
      <view class="pet-photo placeholder" wx:else><text class="remix-icon ri-footprint-line"></text></view>
      <view class="pet-info">
        <view class="pet-name">{{order.petSnapshot.name || order.petName}} · {{order.petSnapshot.breed || '未知品种'}}</view>
        <view class="pet-title-badge" wx:if="{{order.petSnapshot.beautyTitle && order.petSnapshot.beautyTitle.title}}"><text class="remix-icon ri-vip-crown-line"></text><text>{{order.petSnapshot.beautyTitle.title}}</text></view>
        <view class="pet-desc" wx:if="{{order.petSnapshot.personality}}">性格：{{order.petSnapshot.personality}}</view>
        <view class="pet-note" wx:if="{{order.petSnapshot.specialNotes}}">备注：{{order.petSnapshot.specialNotes}}</view>
      </view>
    </view>
  </view>

  <view class="card requirement-card" wx:if="{{order}}">
    <view class="card-subtitle">
      <text class="remix-icon ri-list-check-3-line sub-icon"></text>
      <text>服务要求与注意事项</text>
    </view>
    <view class="requirement-grid">
      <view class="requirement-item">
        <view class="requirement-label">服务要求</view>
        <view class="requirement-value">{{order.serviceRequirementText}}</view>
      </view>
      <view class="requirement-item">
        <view class="requirement-label">服务时间</view>
        <view class="requirement-value highlight">{{order.serviceTimeText}}</view>
      </view>
      <view class="requirement-item" wx:if="{{order.isMultiDay}}">
        <view class="requirement-label">订单总时间</view>
        <view class="requirement-value">{{order.fullServiceTimeText}}</view>
      </view>
      <view class="requirement-item">
        <view class="requirement-label">客户备注</view>
        <view class="requirement-value">{{order.customerRemarkText || '客户暂无额外备注'}}</view>
      </view>
    </view>
    <view class="duration-section" wx:if="{{order.walkDurationRows && order.walkDurationRows.length}}">
      <view class="duration-title"><text class="remix-icon ri-walk-line"></text><text>遛狗时间</text></view>
      <view class="duration-chip" wx:for="{{order.walkDurationRows}}" wx:key="index">{{item.text}}</view>
    </view>
    <view class="duration-section" wx:if="{{order.playDurationRows && order.playDurationRows.length}}">
      <view class="duration-title"><text class="remix-icon ri-gamepad-line"></text><text>陪玩时间</text></view>
      <view class="duration-chip" wx:for="{{order.playDurationRows}}" wx:key="index">{{item.text}}</view>
    </view>
    <view class="pet-notice-section" wx:if="{{order.petNoticeRows && order.petNoticeRows.length}}">
      <view class="duration-title"><text class="remix-icon ri-error-warning-line"></text><text>狗狗/宠物注意事项</text></view>
      <view class="pet-notice-row" wx:for="{{order.petNoticeRows}}" wx:key="index">
        <text class="pet-notice-name">{{item.name}}</text>
        <text class="pet-notice-text">{{item.text}}</text>
      </view>
    </view>
  </view>

  <view class="card operation-card">
    <view class="card-subtitle">
      <text class="remix-icon ri-play-circle-line sub-icon"></text>
      <text>服务操作</text>
    </view>
    <view class="service-timer-card" wx:if="{{order && order.serviceStarted}}">
      <text class="remix-icon ri-timer-flash-line timer-icon"></text>
      <view>
        <view class="timer-label">当前已服务</view>
        <view class="timer-value">{{serviceElapsedText}}</view>
      </view>
    </view>
    <view class="multi-day-tip" wx:if="{{order && order.isMultiDay}}">
      <text class="remix-icon ri-calendar-check-line"></text>
      <text>连续多天订单：每天需要重新开始服务并完成当天任务。</text>
    </view>
    <view class="pre-service-card" wx:if="{{order && order.canStartService}}">
      <view class="guide-box">
        <view class="strong-text">服务必备物品自备提醒：</view>
        <view class="supply-list">
          <view class="supply-item-row" wx:for="{{supplyItems}}" wx:key="name">
            <view class="supply-item-info">
              <text class="supply-dot">•</text>
              <text class="supply-name">{{item.name}}</text>
              <text class="supply-desc" wx:if="{{item.description}}">（{{item.description}}）</text>
            </view>
            <view class="supply-buy-btn" wx:if="{{item.purchaseUrl}}" data-url="{{item.purchaseUrl}}" data-name="{{item.name}}" bindtap="openPurchaseUrl">
              <text class="remix-icon ri-shopping-cart-2-line"></text>
              <text>购买链接</text>
            </view>
          </view>
        </view>
      </view>
      <view class="sanitization-status-box {{order.sanitizationCompleted ? 'done' : 'pending'}}" wx:if="{{order.sanitizationRequired}}">
        <view class="status-title">
          <text class="remix-icon {{order.sanitizationCompleted ? 'ri-checkbox-circle-fill' : 'ri-error-warning-fill'}}"></text>
          <text>{{order.sanitizationCompleted ? '已完成隔离病菌拍照打卡' : '服务前必须进行隔离病菌拍照打卡'}}</text>
        </view>
        <view class="status-desc">{{order.sanitizationCompleted ? '已现场拍摄手套口罩鞋套与消毒用品照片，符合服务开始要求。' : '根据服务规范，开始服务前必须现场佩戴手套口罩鞋套、手持消毒用品拍照打卡，未打卡无法开始服务。'}}</view>
        <button class="{{order.sanitizationCompleted ? 'ghost-btn' : 'primary-btn'}} full-btn" data-type="sanitization" bindtap="checkin">
          <text class="remix-icon ri-camera-lens-line"></text>
          <text>{{order.sanitizationCompleted ? '查看 / 补拍隔离病菌照片' : '立即拍摄：隔离病菌打卡'}}</text>
        </button>
      </view>
    </view>
    <view class="overdue-alert-banner" wx:if="{{order && order.isStartOverdue}}">
      <text class="remix-icon ri-alarm-warning-fill"></text>
      <text>服务已超出约定开始时间 {{order.startOverdueMinutes}} 分钟，请尽快打卡开始！</text>
    </view>
    <button class="primary-btn full-btn" wx:if="{{order && order.canStartService}}" loading="{{starting}}" disabled="{{starting}}" bindtap="start">{{starting ? '处理中...' : (order.isStartOverdue ? '加急开始服务' : '开始服务')}}</button>
    <button class="ghost-btn full-btn" loading="{{requestingEarlyStart}}" disabled="{{requestingEarlyStart || (earlyStartRequest && earlyStartRequest.status === 'pending')}}" wx:if="{{order && order.canRequestEarlyStart}}" bindtap="requestEarlyStart">{{earlyStartRequest && earlyStartRequest.status === 'pending' ? '提前开始申请待确认' : '申请提前开始服务'}}</button>

    <view class="notice-card" wx:if="{{earlyStartRequest}}">
      <view class="notice-title">提前开始申请：{{earlyStartRequest.status === 'approved' ? '已同意' : (earlyStartRequest.status === 'rejected' ? '已拒绝' : '待宠物主确认')}}</view>
      <view class="notice-desc" wx:if="{{earlyStartRequest.reason}}">{{earlyStartRequest.reason}}</view>
    </view>

    <view class="security-card" wx:if="{{order && order.serviceStarted && order.orderHomeSecurity}}">
      <view class="security-head">
        <text class="remix-icon ri-door-lock-line security-icon"></text>
        <text>入户方式：{{order.orderHomeSecurity.lockMethodText}}</text>
      </view>
      <view class="security-desc" wx:if="{{order.orderHomeSecurity.type === 'someone_home'}}">有人在家，到达后敲门即可。</view>

      <view wx:if="{{order.orderHomeSecurity.type === 'remote_unlock'}}">
        <view class="security-desc">到达服务地点后请求远程开门，系统会给宠物主发送微信提醒；如需电话催办，请联系客服并报订单号。</view>
        <view class="info-row"><view class="label">订单号</view><view class="value">{{order.orderNo}}</view></view>
        <view class="info-row"><view class="label">客服电话</view><view class="value">{{customerService.phone || '暂未配置'}}</view></view>
        <view class="info-row" wx:if="{{customerService.workHours}}"><view class="label">服务时间</view><view class="value">{{customerService.workHours}}</view></view>
        <button class="ghost-btn full-btn" loading="{{requestingRemoteUnlock}}" disabled="{{requestingRemoteUnlock}}" bindtap="requestRemoteUnlock">已到达服务地点 / 请求开门</button>
        <view class="security-actions">
          <button class="ghost-btn" bindtap="callCustomerService"><text class="remix-icon ri-phone-line"></text>联系客服</button>
          <button class="ghost-btn" bindtap="copyOrderNo"><text class="remix-icon ri-file-copy-line"></text>复制订单号</button>
        </view>
        <view class="security-desc" wx:if="{{order.orderHomeSecurity.remoteUnlock && order.orderHomeSecurity.remoteUnlock.lastRequestedAt}}">最近请求：{{order.orderHomeSecurity.remoteUnlock.lastRequestedAt}}</view>
        <view class="security-desc" wx:if="{{order.orderHomeSecurity.remoteUnlock && order.orderHomeSecurity.remoteUnlock.lastNotifyStatus}}">微信通知：{{order.orderHomeSecurity.remoteUnlock.lastNotifyStatusText || '已处理'}}</view>
        <view class="security-desc danger" wx:if="{{order.orderHomeSecurity.remoteUnlock && order.orderHomeSecurity.remoteUnlock.lastNotifyError}}">失败原因：{{order.orderHomeSecurity.remoteUnlock.lastNotifyError}}</view>
      </view>

      <view wx:if="{{order.orderHomeSecurity.type === 'one_time_code'}}">
        <view class="security-desc">密码区间：{{order.orderHomeSecurity.oneTimeCode.effectiveStart}} 至 {{order.orderHomeSecurity.oneTimeCode.effectiveEnd}}</view>
        <button class="ghost-btn full-btn" bindtap="unlock"><text class="remix-icon ri-eye-line"></text>查看一次性开门密码</button>
      </view>

      <view wx:if="{{order.orderHomeSecurity.type === 'key'}}">
        <view class="info-row"><view class="label">钥匙位置</view><view class="value">{{order.orderHomeSecurity.key.location}}</view></view>
        <view class="image-list" wx:if="{{order.orderHomeSecurity.key.imageFileIds.length}}"><image wx:for="{{order.orderHomeSecurity.key.imageFileIds}}" wx:key="*this" class="security-image" src="{{item}}" mode="aspectFill" /></view>
        <view class="security-desc">{{order.orderHomeSecurity.key.returnedAt ? '已完成放回钥匙打卡' : '完成服务前必须打卡放回钥匙位置'}}</view>
        <button class="ghost-btn full-btn" wx:if="{{!order.orderHomeSecurity.key.returnedAt}}" loading="{{returningKey}}" disabled="{{returningKey}}" bindtap="chooseKeyReturnImage">上传放回钥匙图片</button>
        <view class="image-list" wx:if="{{keyReturnImageFileIds.length}}"><image wx:for="{{keyReturnImageFileIds}}" wx:key="*this" class="security-image" src="{{item}}" mode="aspectFill" /></view>
        <button class="primary-btn full-btn" wx:if="{{!order.orderHomeSecurity.key.returnedAt}}" loading="{{returningKey}}" disabled="{{returningKey}}" bindtap="recordKeyReturned">确认已放回钥匙</button>
      </view>
    </view>
  </view>

  <view class="security-card unlock-result" wx:if="{{order && order.serviceStarted && unlock}}">
    <view class="info-row"><view class="label">入户方式</view><view class="value">{{unlock.lockMethodText || '服务入户'}}</view></view>
    <view class="info-row" wx:if="{{unlock.doorLockCode}}"><view class="label">门锁密码</view><view class="value code-text">{{unlock.doorLockCode}}</view></view>
    <view class="info-row" wx:if="{{unlock.keyLocation}}"><view class="label">钥匙位置</view><view class="value">{{unlock.keyLocation}}</view></view>
    <view class="info-row" wx:if="{{unlock.entryNotes}}"><view class="label">入户备注</view><view class="value">{{unlock.entryNotes}}</view></view>
  </view>

  <view wx:if="{{order && order.serviceStarted}}">
    <view class="card track-card">
      <view class="card-subtitle">
        <text class="remix-icon ri-map-pin-line sub-icon"></text>
        <text>轨迹记录</text>
      </view>
      <view class="badge green" wx:if="{{autoTracking}}">{{backgroundTracking ? '后台记录中' : '自动记录中'}}</view>
      <view class="track-text">{{trackStatusText}}</view>
      <view class="track-text" wx:if="{{latestTrackText}}">{{latestTrackText}}</view>
      <button class="ghost-btn full-btn" bindtap="uploadPoint">手动补记当前位置</button>
      <view class="track-tips">服务期间会定时记录当前位置，用户端会按时间生成路径。</view>
      <view class="track-count">已上传轨迹点：{{pointCount}}</view>
      <view class="track-tips danger" wx:if="{{offlineTaskCount}}">待补传数据：{{offlineTaskCount}} 条，网络恢复后自动上传。</view>
    </view>

    <view class="section-title">
      <text class="remix-icon ri-camera-lens-line section-icon"></text>
      <text>打卡证据</text>
    </view>
    <view class="checkin-grid" wx:if="{{order.checkinRequirements && order.checkinRequirements.length}}">
      <button class="checkin-btn" wx:for="{{order.checkinRequirements}}" wx:key="eventType" data-type="{{item.eventType}}" bindtap="checkin">
        <text class="remix-icon {{item.photoCount ? 'ri-checkbox-circle-fill' : 'ri-camera-lens-line'}} checkin-icon"></text>
        <text>{{item.label}}</text>
        <text class="checkin-meta" wx:if="{{item.photoCount}}">{{item.photoCount}}张</text>
        <text class="checkin-meta" wx:elif="{{item.required}}">必打卡</text>
        <text class="checkin-meta" wx:else>选填</text>
      </button>
    </view>
    <view class="empty-state" wx:else>暂无打卡要求</view>

    <view class="overdue-alert-banner warning" wx:if="{{order && order.isFinishOverdue}}">
      <text class="remix-icon ri-time-fill"></text>
      <text>已超过约定服务时间 {{order.finishOverdueMinutes}} 分钟！{{order.allCheckinsDone ? '打卡已齐全，请点击下方【完成服务】结算收益；若超时30分钟未操作，系统将自动结算。' : '请确认服务进度并尽快补全打卡照片。'}}</text>
    </view>
    <button class="primary-btn finish-btn {{order.allCheckinsDone ? 'highlight-btn' : ''}}" loading="{{finishing}}" disabled="{{finishing}}" bindtap="finish">{{finishing ? '处理中...' : (order.allCheckinsDone ? '完成服务（打卡已齐全）' : '完成服务')}}</button>
  </view>
</view>
