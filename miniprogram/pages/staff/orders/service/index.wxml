<view class="page"><view class="title">服务执行</view><button class="primary" bindtap="start">开始服务</button><button class="ghost" bindtap="unlock">查看限时门锁密码</button><view class="card" wx:if="{{unlock}}"><view>门锁密码：{{unlock.doorLockCode}}</view><view>钥匙：{{unlock.keyLocation}}</view></view><button class="ghost" bindtap="uploadPoint">上传当前定位</button><view class="muted">已上传轨迹点：{{pointCount}}</view><view class="subtitle">打卡</view><button data-type="enter_door" bindtap="checkin">入户打卡</button><button data-type="leash_on" bindtap="checkin">牵引出门</button><button data-type="feed" bindtap="checkin">喂食</button><button data-type="water" bindtap="checkin">饮水</button><button data-type="pet_status" bindtap="checkin">宠物状态</button><button data-type="return_home" bindtap="checkin">回家入户</button><button data-type="leave_door" bindtap="checkin">离户闭锁</button><button class="primary" bindtap="finish">完成服务</button></view>