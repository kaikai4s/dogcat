<view class="page">
  <view class="dashboard-header">
    <view class="badge">现场服务</view>
    <view class="title">服务执行</view>
    <view class="tip">按流程上传轨迹、完成打卡，门锁密码仅在服务窗口内展示并记录访问日志。</view>
  </view>

  <view class="card pet-card" wx:if="{{order && order.petSnapshot}}">
    <view class="subtitle">服务对象与照顾备注</view>
    <view class="row">
      <image class="pet-photo" wx:if="{{order.petSnapshot.avatarFileId}}" src="{{order.petSnapshot.avatarFileId}}" mode="aspectFill" bindtap="previewPetPhoto" style="width: 100rpx; height: 100rpx; border-radius: 24rpx; margin-right: 18rpx; flex-shrink: 0;" />
      <view style="flex: 1;">
        <view class="strong">{{order.petSnapshot.name || order.petName}} ({{order.petSnapshot.breed || '未知品种'}})</view>
        <view class="muted" wx:if="{{order.petSnapshot.personality}}">性格：{{order.petSnapshot.personality}}</view>
        <view class="muted" wx:if="{{order.petSnapshot.specialNotes}}" style="color: #be123c; font-weight: bold;">备注：{{order.petSnapshot.specialNotes}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="subtitle">服务操作</view>
    <button class="primary" loading="{{starting}}" disabled="{{starting}}" bindtap="start">{{starting ? '处理中...' : '开始服务'}}</button>
    <button class="ghost" bindtap="unlock">查看限时门锁密码</button>
  </view>

  <view class="notice" wx:if="{{unlock}}">
    <view class="info-row"><view class="label">门锁密码</view><view class="value">{{unlock.doorLockCode}}</view></view>
    <view class="info-row"><view class="label">钥匙位置</view><view class="value">{{unlock.keyLocation}}</view></view>
    <view class="info-row" wx:if="{{unlock.entryNotes}}"><view class="label">入户备注</view><view class="value">{{unlock.entryNotes}}</view></view>
  </view>

  <view class="card">
    <view class="subtitle">轨迹记录</view>
    <view class="badge" wx:if="{{autoTracking}}">{{backgroundTracking ? '后台记录中' : '自动记录中'}}</view>
    <view class="muted">{{trackStatusText}}</view>
    <view class="muted" wx:if="{{latestTrackText}}">{{latestTrackText}}</view>
    <button class="ghost" bindtap="uploadPoint">手动补记当前位置</button>
    <view class="muted">服务期间会定时记录当前位置，用户端会按时间生成路径。</view>
    <view class="muted">已上传轨迹点：{{pointCount}}</view>
    <view class="muted" wx:if="{{offlineTaskCount}}">待补传数据：{{offlineTaskCount}} 条，网络恢复后自动上传。</view>
  </view>

  <view class="subtitle">打卡证据</view>
  <view class="grid">
    <button class="ghost" data-type="enter_door" bindtap="checkin">入户打卡</button>
    <button class="ghost" data-type="leash_on" bindtap="checkin">牵引出门</button>
    <button class="ghost" data-type="feed" bindtap="checkin">喂食</button>
    <button class="ghost" data-type="water" bindtap="checkin">饮水</button>
    <button class="ghost" data-type="clean" bindtap="checkin">清洁打卡</button>
    <button class="ghost" data-type="medicine" bindtap="checkin">喂药打卡</button>
    <button class="ghost" data-type="pet_status" bindtap="checkin">宠物状态</button>
    <button class="ghost" data-type="return_home" bindtap="checkin">回家入户</button>
    <button class="ghost" data-type="leave_door" bindtap="checkin">离户闭锁</button>
  </view>

  <button class="primary" loading="{{finishing}}" disabled="{{finishing}}" bindtap="finish">{{finishing ? '处理中...' : '完成服务'}}</button>
</view>
