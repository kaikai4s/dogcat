<view class="page"><view class="title">我的任务</view><view class="card" wx:for="{{orders}}" wx:key="_id" data-id="{{item._id}}" bindtap="detail"><view class="strong">{{item.petName}} · {{item.serviceType === 'walk' ? '遛狗' : '喂养'}}</view><view class="muted">{{item.status}} · {{item.startTime}}</view></view><view class="empty" wx:if="{{!orders.length}}">暂无任务</view></view>