<view class="page staff-orders-page {{themeClass}} {{fontClass}}">
  <staff-active-service-banner />
  <view class="staff-orders-hero">
    <view class="hero-badge">服务履约</view>
    <view class="hero-title">我的任务</view>
    <view class="hero-desc">查看已接单与服务中任务，按时前往客户家中打卡履约。</view>
  </view>

  <scroll-view scroll-x class="status-tabs">
    <view class="status-tab {{activeStatus === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" data-status="{{item.value}}" bindtap="chooseStatus">{{item.label}}</view>
  </scroll-view>

  <view class="card task-card" wx:for="{{orders}}" wx:key="_id">
    <view class="task-head" data-id="{{item._id}}" bindtap="detail">
      <view class="order-person">
        <view class="avatar-level-wrap">
          <image class="order-avatar" wx:if="{{item.petSnapshot && item.petSnapshot.avatarFileId}}" src="{{item.petSnapshot.avatarFileId}}" mode="aspectFill" />
          <image class="order-avatar" wx:elif="{{item.clientSnapshot && item.clientSnapshot.avatarUrl}}" src="{{item.clientSnapshot.avatarUrl}}" mode="aspectFill" />
          <view class="order-avatar placeholder" wx:else><text class="remix-icon ri-user-3-line"></text></view>
          <view class="avatar-level-badge badge-{{item.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{!(item.petSnapshot && item.petSnapshot.avatarFileId) && item.clientSnapshot && (item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName)}}">{{item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName}}</view>
        </view>
        <view class="order-info">
          <view class="order-title">
            <text class="pet-name">{{item.petName}}</text>
            <view class="pet-title-badge" wx:if="{{item.petSnapshot && item.petSnapshot.beautyTitle && item.petSnapshot.beautyTitle.title}}">
              <text class="remix-icon ri-vip-crown-line"></text>{{item.petSnapshot.beautyTitle.title}}
            </view>
            <text class="breed-badge" wx:if="{{item.petSnapshot && item.petSnapshot.breed}}">{{item.petSnapshot.breed}}</text>
            <text class="owner-name {{item.clientSnapshot.nameEffect && item.clientSnapshot.nameEffect !== 'none' ? 'name-effect-' + item.clientSnapshot.nameEffect : ''}}" style="{{item.clientSnapshot.nameColor ? 'color: ' + item.clientSnapshot.nameColor + ';' : ''}}">· {{item.clientSnapshot.displayName || '宠物主'}}</text>
            <text class="member-badge badge-{{item.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{item.clientSnapshot && (item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName)}}">{{item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName}}</text>
          </view>
          <view class="service-type">{{item.serviceSummary || (item.serviceType === 'walk' ? '上门遛狗' : '上门喂养')}}</view>
        </view>
      </view>
      <view class="status-badge">{{item.statusText}}</view>
    </view>

    <view class="info-grid">
      <view class="info-item">
        <text class="remix-icon ri-time-line icon"></text>
        <text class="val">{{item.appointmentTimeText || item.startTime}}</text>
      </view>
      <view class="info-item">
        <text class="remix-icon ri-map-pin-2-line icon"></text>
        <text class="val">{{item.serviceAddress || '未填写地址'}}</text>
      </view>
      <view class="info-item">
        <text class="remix-icon ri-navigation-line icon"></text>
        <text class="val">距当前位置 {{item.distanceText || '未定位'}}</text>
      </view>
    </view>

    <view class="pet-note-card" wx:if="{{item.petSnapshot && (item.petSnapshot.personality || item.petSnapshot.specialNotes)}}">
      <text class="remix-icon ri-footprint-line note-icon"></text>
      <view class="note-text">
        <text wx:if="{{item.petSnapshot.personality}}">性格：{{item.petSnapshot.personality}} </text>
        <text wx:if="{{item.petSnapshot.specialNotes}}">备注：{{item.petSnapshot.specialNotes}}</text>
      </view>
    </view>

    <view class="card-action-row nav-only-row">
      <button class="ghost-btn nav-btn" data-latitude="{{item.addressLatitude}}" data-longitude="{{item.addressLongitude}}" data-name="{{item.serviceAddress}}" data-address="{{item.addressDetail}} {{item.doorplate}}" catchtap="openNavigation">
        <text class="remix-icon ri-map-pin-line"></text>导航
      </button>
    </view>
  </view>

  <view class="list-state" wx:if="{{loading && orders.length}}">正在加载更多任务...</view>
  <view class="list-state" wx:if="{{!loading && orders.length && !hasMore}}">已显示全部服务任务</view>

  <view class="card empty order-empty" wx:if="{{!loading && !orders.length}}">
    <view class="empty-icon remix-icon ri-file-list-3-line"></view>
    <view class="empty-title">暂无该状态任务</view>
    <view class="empty-desc">前往工作台抢单或接单后，任务会显示在这里。</view>
  </view>

  <view class="bottom-nav staff-bottom-nav">
    <view class="nav-item" data-url="/pages/staff/home/index" bindtap="go"><view class="nav-icon remix-icon ri-home-5-line"></view><view>工作台</view></view>
    <view class="nav-item active"><view class="nav-icon remix-icon ri-file-list-3-fill"></view><view>任务</view></view>
    <view class="nav-item" data-url="/pages/staff/messages/index" bindtap="go"><view class="nav-icon remix-icon ri-message-3-line"><view class="nav-unread-count" wx:if="{{messageUnreadCount > 0}}">{{messageUnreadCountText}}</view></view><view>消息</view></view>
    <view class="nav-item" data-url="/pages/staff/certification/index" bindtap="go"><view class="nav-icon remix-icon ri-checkbox-circle-line"></view><view>认证</view></view>
    <view class="nav-item" bindtap="backProfile"><view class="nav-icon remix-icon ri-user-3-line"></view><view>我的</view></view>
  </view>
</view>
