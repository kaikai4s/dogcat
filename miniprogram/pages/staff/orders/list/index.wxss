/* Staff order task center - Warm Cute Pet Style UI redesign */
.staff-orders-page {
  min-height: 100vh;
  padding: 0 28rpx 160rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.staff-orders-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
}

.hero-title {
  margin-top: 20rpx;
  color: #2d211a;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.18;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 26rpx;
  line-height: 1.4;
}

.order-filter-card {
  margin: -10rpx 28rpx 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 153, 102, 0.16);
  box-shadow: 0 8rpx 24rpx rgba(123, 89, 62, 0.05);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 16rpx 0 20rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #fbf8f5;
  border: 1rpx solid rgba(255, 153, 102, 0.18);
}

.search-icon {
  font-size: 30rpx;
  color: #ff7a45;
  flex-shrink: 0;
}

.filter-input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  min-height: 60rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  background: transparent !important;
  font-size: 26rpx;
  line-height: 60rpx;
  color: #2d211a;
}

.clear-icon {
  font-size: 32rpx;
  color: #bbb;
  padding: 6rpx;
}

.search-confirm-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 850;
  color: #fff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  flex-shrink: 0;
}

.date-filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.date-picker-item {
  flex: 1;
  min-width: 0;
}

.date-picker-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 64rpx;
  min-height: 64rpx;
  padding: 0 16rpx;
  margin: 0;
  border-radius: 999rpx;
  background: #fbf8f5;
  border: 1rpx solid rgba(255, 153, 102, 0.18);
  font-size: 23rpx;
  color: #8e8580;
  box-sizing: border-box;
}

.date-picker-btn.has-val {
  color: #d45f22;
  font-weight: 800;
  border-color: #ff9966;
  background: #fff5ee;
}

.picker-icon {
  font-size: 26rpx;
  color: #ff7a45;
}

.date-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.date-sep {
  color: #8e8580;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.filter-reset-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.status-tabs {
  position: sticky;
  top: 0;
  z-index: 20;
  width: 100%;
  white-space: nowrap;
  margin: 0 -28rpx 20rpx;
  padding: 18rpx 28rpx;
  background: rgba(255, 250, 246, 0.96);
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.08);
  backdrop-filter: blur(14rpx);
  box-sizing: border-box;
}

.status-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  margin-right: 14rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #8e8580;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  font-size: 26rpx;
  font-weight: 760;
  box-shadow: 0 8rpx 20rpx rgba(123, 89, 62, 0.05);
}

.status-tab.active {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  border: none;
  box-shadow: 0 12rpx 26rpx rgba(255, 122, 69, 0.22);
}

.task-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.task-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.order-person {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.order-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
}

.order-avatar.placeholder {
  background: #fff0e2;
  color: #e9672f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.order-info {
  flex: 1;
  min-width: 0;
}

.order-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
}

.pet-name {
  color: #2d211a;
}

.pet-title-badge {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  color: #b45309;
  background: #fff7d6;
  font-size: 19rpx;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

.pet-title-badge .remix-icon {
  color: #f59e0b;
  font-size: 22rpx;
}

.breed-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: #fff0e2;
  font-size: 20rpx;
  font-weight: 850;
}

.owner-name {
  color: #7a6a5e;
  font-size: 26rpx;
}

.service-type {
  margin-top: 6rpx;
  color: #8e8580;
  font-size: 24rpx;
}

.status-badge {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: #fff0e2;
  font-size: 22rpx;
  font-weight: 850;
}

.info-grid {
  margin-top: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.1);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #574b42;
  font-size: 25rpx;
}

.info-item .icon {
  color: #e9672f;
  font-size: 28rpx;
  flex-shrink: 0;
}

.pet-note-card {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #fff4f7;
  border: 1rpx solid rgba(244, 63, 107, 0.15);
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.note-icon {
  color: #f43f6b;
  font-size: 28rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.note-text {
  color: #be123c;
  font-size: 23rpx;
  line-height: 1.4;
}

.card-action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.nav-only-row {
  grid-template-columns: 1fr;
}

.ghost-btn {
  height: 72rpx;
  border-radius: 24rpx;
  background: #fff0e2;
  color: #7a6a5e;
  font-size: 26rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
}

.nav-btn {
  gap: 6rpx;
  color: #e9672f;
}

.list-state {
  padding: 28rpx 0 10rpx;
  text-align: center;
  color: #8e8580;
  font-size: 24rpx;
}

.order-empty {
  margin-top: 24rpx;
  padding: 48rpx 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  text-align: center;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 16rpx;
  border-radius: 32rpx;
  color: #e9672f;
  background: #fff0e2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.empty-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 24rpx;
}
