.order-actions { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-top: 18rpx; }
.three-actions { grid-template-columns: repeat(3, 1fr); }
.ghost-mini { background: var(--theme-bg-soft); color: var(--theme-primary); border: 2rpx solid var(--theme-border); }

/* 独立城市选择栏 */
.city-selector-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--theme-card-bg);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  font-size: 26rpx;
  color: var(--theme-text);
  font-weight: 600;
  border: 1rpx solid #eee;
}

.city-icon { font-size: 26rpx; }
.city-name { font-size: 26rpx; color: var(--theme-text); }
.arrow-down { font-size: 20rpx; color: var(--theme-muted); margin-left: 4rpx; }

/* 筛选触发展示按钮 */
.filter-trigger-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  background: #f5f5f5;
  color: #555;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  position: relative;
}

.filter-trigger-btn.active {
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
  font-weight: 600;
}

.active-dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--theme-primary);
  border-radius: 50%;
}

/* 下拉筛选面板 */
.filter-dropdown-panel {
  background: var(--theme-card-bg);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  border: 2rpx solid #f0f0f0;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.04);
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.filter-label {
  font-size: 24rpx;
  color: #888888;
  font-weight: 500;
}

.filter-chips {
  display: flex;
  gap: 16rpx;
}

.filter-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #f8f8f8;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666666;
  border: 1rpx solid #e0e0e0;
}

.filter-chip.selected {
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
  border-color: var(--theme-primary);
  font-weight: 600;
}

.chip-icon {
  font-size: 22rpx;
}

.date-picker-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.date-input-box {
  background: #f8f8f8;
  border: 1rpx solid #e0e0e0;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #444;
}

.clear-date-btn {
  background: #eee !important;
  color: #666 !important;
  border-radius: 12rpx !important;
  font-size: 24rpx !important;
  margin: 0 !important;
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.reset-btn {
  background: #f5f5f5 !important;
  color: #666 !important;
  border-radius: 30rpx !important;
  font-size: 24rpx !important;
  margin: 0 !important;
}

.confirm-btn {
  background: var(--theme-primary) !important;
  color: #ffffff !important;
  border-radius: 30rpx !important;
  font-size: 24rpx !important;
  margin: 0 !important;
}
