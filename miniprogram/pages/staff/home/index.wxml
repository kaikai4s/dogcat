<view class="page dashboard-page">
  <view class="dashboard-header">
    <view class="between" style="align-items: center;">
      <view>
        <view class="badge">宠托师</view>
        <view class="title">服务工作台</view>
      </view>
      <picker mode="region" bindchange="onCityPickerChange">
        <view class="city-selector-btn">
          <text class="city-icon">📍</text>
          <text class="city-name">{{selectedCity || '选择城市'}}</text>
          <text class="arrow-down">▼</text>
        </view>
      </picker>
    </view>
    <view class="tip">默认根据选定城市推荐可接订单，支持高级条件筛选。</view>
  </view>

  <view class="notice-bar" wx:if="{{missingAddressNotice}}" style="background: #fff0f3; border: 2rpx solid #f43f6b; color: #d32f2f; padding: 24rpx; border-radius: 16rpx; margin-bottom: 24rpx; display: flex; align-items: center; justify-content: space-between;">
    <view style="flex: 1; padding-right: 16rpx;">
      <view style="font-weight: bold; font-size: 28rpx; margin-bottom: 6rpx;">⚠️ 尚未设置固定服务地址与范围</view>
      <view style="font-size: 24rpx; color: #666;">无法正常接单及在宠托师列表中被搜索到，请前往个人中心设置！</view>
    </view>
    <button size="mini" style="background: #f43f6b; color: #fff; border-radius: 30rpx; padding: 0 24rpx; margin: 0; font-size: 24rpx;" data-url="/pages/staff/profile/index" bindtap="go">去设置</button>
  </view>

  <view class="grid">
    <view class="card interactive action-card" data-url="/pages/staff/certification/index" bindtap="go">
      <view class="action-icon">证</view>
      <view class="strong">入驻认证</view>
      <view class="muted">资质审核与服务区域</view>
    </view>
    <view class="card interactive action-card" data-url="/pages/staff/orders/list/index" bindtap="go">
      <view class="action-icon">务</view>
      <view class="strong">我的任务</view>
      <view class="muted">订单履约与打卡</view>
    </view>
    <view class="card interactive action-card" data-url="/pages/staff/schedule/index" bindtap="go">
      <view class="action-icon">排</view>
      <view class="strong">排班日历</view>
      <view class="muted">休息、加班与占用</view>
    </view>
  </view>

  <view class="soft-panel">
    <view class="between">
      <view>
        <view class="strong">指定给我的订单</view>
        <view class="muted">宠物主指定你接单的订单只在这里展示</view>
      </view>
      <view class="badge">{{directOrders.length}} 单</view>
    </view>
  </view>

  <view class="card order-card" wx:for="{{directOrders}}" wx:key="_id">
    <view class="between order-card-head">
      <view class="order-person">
        <image class="order-avatar" wx:if="{{item.clientSnapshot && item.clientSnapshot.avatarUrl}}" src="{{item.clientSnapshot.avatarUrl}}" mode="aspectFill" />
        <view class="order-avatar" wx:else>🐾</view>
        <view>
          <view class="strong">{{item.clientSnapshot.displayName || '宠物主'}} · {{item.petName}}</view>
          <view class="muted">{{item.serviceSummary || (item.serviceType === 'walk' ? '上门遛狗' : '上门喂养')}}</view>
        </view>
      </view>
      <view class="badge">指定</view>
    </view>
    <view class="muted order-card-address">{{item.serviceAddress || '未填写地址'}}</view>
    <view class="chip-row">
      <view class="chip">{{item.startTime}}</view>
      <view class="chip pink">¥{{item.payAmount}}</view>
      <view class="chip blue">{{item.distanceText || '未定位'}}</view>
    </view>
    <view class="order-actions three-actions">
      <button class="mini-btn" size="mini" data-id="{{item._id}}" bindtap="detail">详情</button>
      <button class="mini-btn" size="mini" data-id="{{item._id}}" bindtap="accept">接单</button>
      <button class="mini-btn ghost-mini" size="mini" data-latitude="{{item.addressLatitude}}" data-longitude="{{item.addressLongitude}}" data-name="{{item.serviceAddress}}" data-address="{{item.addressDetail}} {{item.doorplate}}" bindtap="openNavigation">导航</button>
    </view>
  </view>

  <view class="soft-panel">
    <view class="between" style="align-items: center;">
      <view>
        <view class="strong">附近可接订单</view>
        <view class="muted">{{locationText}}</view>
      </view>
      <view style="display: flex; align-items: center; gap: 12rpx;">
        <view class="filter-trigger-btn {{inServiceRange || inServiceTime || filterDate ? 'active' : ''}}" bindtap="toggleFilterPanel">
          <text>筛选 ⚙️</text>
          <text class="active-dot" wx:if="{{inServiceRange || inServiceTime || filterDate}}"></text>
        </view>
        <view class="badge">{{nearbyOrders.length}} 单</view>
      </view>
    </view>

    <!-- 下拉筛选面板 -->
    <view class="filter-dropdown-panel" wx:if="{{showFilterPanel}}">
      <view class="filter-group">
        <view class="filter-label">高级过滤选项</view>
        <view class="filter-chips">
          <view class="filter-chip {{inServiceRange ? 'selected' : ''}}" bindtap="toggleInServiceRange">
            <text class="chip-icon">{{inServiceRange ? '✓' : '+'}}</text>
            <text>服务范围内</text>
          </view>
          <view class="filter-chip {{inServiceTime ? 'selected' : ''}}" bindtap="toggleInServiceTime">
            <text class="chip-icon">{{inServiceTime ? '✓' : '+'}}</text>
            <text>服务时间内</text>
          </view>
        </view>
      </view>

      <view class="filter-group" style="margin-top: 16rpx;">
        <view class="filter-label">履约日期筛选</view>
        <view class="date-picker-row">
          <picker mode="date" value="{{filterDate}}" bindchange="onDateChange" style="flex: 1;">
            <view class="date-input-box">
              <text>{{filterDate || '选择特定履约日期 (YYYY-MM-DD)'}}</text>
            </view>
          </picker>
          <button class="clear-date-btn" size="mini" wx:if="{{filterDate}}" bindtap="clearDate">清除</button>
        </view>
      </view>

      <view class="filter-actions">
        <button class="reset-btn" size="mini" bindtap="resetFilters">重置全部</button>
        <button class="confirm-btn" size="mini" bindtap="toggleFilterPanel">收起面板</button>
      </view>
    </view>

    <button class="primary" style="margin-top: 16rpx;" loading="{{loadingNearby}}" bindtap="refreshNearby">手动更新工作台位置并推荐</button>
  </view>

  <view class="card order-card" wx:for="{{nearbyOrders}}" wx:key="_id">
    <view class="between order-card-head">
      <view class="order-person">
        <image class="order-avatar" wx:if="{{item.clientSnapshot && item.clientSnapshot.avatarUrl}}" src="{{item.clientSnapshot.avatarUrl}}" mode="aspectFill" />
        <view class="order-avatar" wx:else>🐾</view>
        <view>
          <view class="strong">{{item.clientSnapshot.displayName || '宠物主'}} · {{item.petName}}</view>
          <view class="muted">{{item.serviceSummary || (item.serviceType === 'walk' ? '上门遛狗' : '上门喂养')}}</view>
        </view>
      </view>
      <view class="badge">{{item.distanceText}}</view>
    </view>
    <view class="muted order-card-address">{{item.serviceAddress || '未填写地址'}}</view>
    <view class="chip-row">
      <view class="chip">{{item.startTime}}</view>
      <view class="chip pink">¥{{item.payAmount}}</view>
      <view class="chip blue">待接单</view>
    </view>
    <view class="order-actions three-actions">
      <button class="mini-btn" size="mini" data-id="{{item._id}}" bindtap="detail">详情</button>
      <button class="mini-btn" size="mini" data-id="{{item._id}}" bindtap="accept">抢单</button>
      <button class="mini-btn ghost-mini" size="mini" data-latitude="{{item.addressLatitude}}" data-longitude="{{item.addressLongitude}}" data-name="{{item.serviceAddress}}" data-address="{{item.addressDetail}} {{item.doorplate}}" bindtap="openNavigation">导航</button>
    </view>
  </view>

  <view class="empty" wx:if="{{locationReady && !nearbyOrders.length}}">
    <view>附近暂无可接订单，稍后再刷新看看～</view>
  </view>

  <view class="notice">
    <view class="strong">服务提醒</view>
    <view class="muted">门锁密码仅在服务时间窗口内可查看，所有访问都会记录日志。</view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item active"><view class="nav-icon">⌂</view><view>工作台</view></view>
    <view class="nav-item" data-url="/pages/staff/orders/list/index" bindtap="go"><view class="nav-icon">☷</view><view>任务</view></view>
    <view class="nav-item" data-url="/pages/staff/certification/index" bindtap="go"><view class="nav-icon">☑</view><view>认证</view></view>
    <view class="nav-item" bindtap="backProfile"><view class="nav-icon">♙</view><view>我的</view></view>
  </view>
</view>
