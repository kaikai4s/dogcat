<wxs module="beijingTime" src="../../../utils/beijing-time.wxs" />
<view class="page staff-home-page {{themeClass}} {{fontClass}}">
  <staff-active-service-banner />
  <view class="staff-home-hero">
    <view class="hero-topline">
      <view class="hero-badge">宠托师端</view>
      <picker mode="region" bindchange="onCityPickerChange">
        <view class="city-selector-btn">
          <text class="remix-icon ri-map-pin-2-fill city-icon"></text>
          <text class="city-name">{{selectedCity || '选择城市'}}</text>
          <text class="remix-icon ri-arrow-down-s-line arrow-icon"></text>
        </view>
      </picker>
    </view>
    <view class="hero-title">服务履约工作台</view>
    <view class="hero-desc">默认根据选定城市推荐可接订单，支持高级条件筛选与路线导航。</view>
  </view>

  <view class="notice-card deposit-warning-notice" wx:if="{{depositNotice && depositNotice.needDeposit}}">
    <view class="notice-main">
      <view class="notice-title">
        <text class="remix-icon {{depositNotice.isRepay ? 'ri-alarm-warning-fill' : 'ri-shield-keyhole-fill'}} notice-icon"></text>
        <text>{{depositNotice.title || '未缴纳履约保证金'}}</text>
        <text class="deposit-amount-tag" wx:if="{{depositNotice.amount}}">需缴纳 ¥{{depositNotice.amount}}</text>
      </view>
      <view class="notice-desc">{{depositNotice.message || ('平台已开启履约保证金（¥' + depositNotice.amount + '），未缴纳暂不可抢单或被指定接单，请先缴纳。')}}</view>
    </view>
    <button class="notice-btn deposit-btn" bindtap="goDeposit">去缴纳</button>
  </view>

  <view class="notice-card warning-notice" wx:if="{{missingAddressNotice}}">
    <view class="notice-main">
      <view class="notice-title">
        <text class="remix-icon ri-alert-fill notice-icon"></text>
        <text>未设置服务地址与接单范围</text>
      </view>
      <view class="notice-desc">无法正常接单及在列表被宠物主检索，请尽快设置。</view>
    </view>
    <button class="notice-btn" data-url="/pages/staff/profile/index" bindtap="go">去设置</button>
  </view>

  <view class="action-grid">
    <view class="action-card" data-url="/pages/staff/certification/index" bindtap="go">
      <view class="icon-box"><text class="remix-icon ri-shield-user-line action-icon"></text></view>
      <view class="action-title">入驻认证</view>
      <view class="action-sub">资质审核与区域</view>
    </view>
    <view class="action-card" data-url="/pages/staff/orders/list/index" bindtap="go">
      <view class="icon-box"><text class="remix-icon ri-file-list-3-line action-icon"></text></view>
      <view class="action-title">我的任务</view>
      <view class="action-sub">订单履约打卡</view>
    </view>
    <view class="action-card" data-url="/pages/staff/schedule/index" bindtap="go">
      <view class="icon-box"><text class="remix-icon ri-calendar-event-line action-icon"></text></view>
      <view class="action-title">排班日历</view>
      <view class="action-sub">休息与接单设置</view>
    </view>
    <view class="action-card" data-url="/pages/staff/incidents/list/index" bindtap="go">
      <view class="icon-box"><text class="remix-icon ri-alarm-warning-line action-icon"></text></view>
      <view class="action-title">纠纷 / SOS</view>
      <view class="action-sub">异常上报与处置</view>
    </view>
  </view>

  <view class="section-card" wx:if="{{directOrders && directOrders.length}}">
    <view class="section-head">
      <view class="section-title-group">
        <text class="remix-icon ri-user-heart-line title-icon"></text>
        <text class="section-title">指定给我的订单</text>
      </view>
      <view class="count-badge">{{directOrders.length}} 单</view>
    </view>
    <view class="section-sub">宠物主指定你履约的订单专区</view>

    <view class="order-card" wx:for="{{directOrders}}" wx:key="_id">
      <view class="order-card-head">
        <view class="order-person">
          <view class="avatar-level-wrap">
            <image class="order-avatar" wx:if="{{item.petSnapshot && item.petSnapshot.avatarFileId}}" src="{{item.petSnapshot.avatarFileId}}" mode="aspectFill" />
            <image class="order-avatar" wx:elif="{{item.clientSnapshot && item.clientSnapshot.avatarUrl}}" src="{{item.clientSnapshot.avatarUrl}}" mode="aspectFill" />
            <view class="order-avatar placeholder" wx:else><text class="remix-icon ri-user-3-line"></text></view>
            <view class="avatar-level-badge badge-{{item.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{!(item.petSnapshot && item.petSnapshot.avatarFileId) && item.clientSnapshot && (item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName)}}">{{item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName}}</view>
          </view>
          <view class="order-person-info">
            <view class="order-title-row">
              <text class="order-client-name {{item.clientSnapshot.nameEffect && item.clientSnapshot.nameEffect !== 'none' ? 'name-effect-' + item.clientSnapshot.nameEffect : ''}}" style="{{item.clientSnapshot.nameColor ? 'color: ' + item.clientSnapshot.nameColor + ';' : ''}}">{{item.clientSnapshot.displayName || '宠物主'}}</text>
              <text class="member-badge badge-{{item.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{item.clientSnapshot && (item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName)}}">{{item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName}}</text>
              <text class="order-pet-name">· {{item.petName}}</text>
              <view class="pet-title" wx:if="{{(item.petSnapshot && item.petSnapshot.beautyTitle && item.petSnapshot.beautyTitle.title) || (item.beautyTitle && item.beautyTitle.title)}}">
                <text class="remix-icon ri-vip-crown-fill"></text>
                <text>{{(item.petSnapshot && item.petSnapshot.beautyTitle && item.petSnapshot.beautyTitle.title) || (item.beautyTitle && item.beautyTitle.title)}}</text>
              </view>
            </view>
            <view class="order-service">{{item.serviceSummary || (item.serviceType === 'walk' ? '上门遛狗' : '上门喂养')}}</view>
          </view>
        </view>
        <view class="badge pink">指定单</view>
      </view>

      <view class="order-card-address">
        <text class="remix-icon ri-map-pin-2-line addr-icon"></text>
        <text>{{item.serviceAddress || '未填写地址'}}</text>
      </view>

      <view class="chip-row">
        <view class="chip"><text class="remix-icon ri-time-line"></text>{{beijingTime.format(item.startTime)}}</view>
        <view class="chip green" wx:if="{{item.staffEarning}}"><text class="remix-icon ri-money-cny-circle-line"></text>{{item.staffEarningText}}</view>
        <view class="chip blue"><text class="remix-icon ri-navigation-line"></text>{{item.distanceText || '未定位'}}</view>
      </view>

      <view class="order-actions">
        <button class="ghost-btn" data-id="{{item._id}}" bindtap="detail">详情</button>
        <button class="primary-btn" data-id="{{item._id}}" bindtap="accept">接单</button>
        <button class="ghost-btn nav-btn" data-latitude="{{item.addressLatitude}}" data-longitude="{{item.addressLongitude}}" data-name="{{item.serviceAddress}}" data-address="{{item.addressDetail}} {{item.doorplate}}" bindtap="openNavigation">
          <text class="remix-icon ri-map-pin-line"></text>导航
        </button>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-head">
      <view class="section-title-group">
        <text class="remix-icon ri-radar-line title-icon"></text>
        <text class="section-title">附近可接订单</text>
      </view>
      <view class="head-right">
        <view class="filter-trigger-btn {{inServiceRange || inServiceTime || filterDate ? 'active' : ''}}" bindtap="toggleFilterPanel">
          <text class="remix-icon ri-filter-3-line filter-icon"></text>
          <text>筛选</text>
          <view class="active-dot" wx:if="{{inServiceRange || inServiceTime || filterDate}}"></view>
        </view>
        <view class="count-badge">{{nearbyOrders.length}} 单</view>
      </view>
    </view>
    <view class="section-sub">{{locationText}}</view>

    <!-- 下拉筛选面板 -->
    <view class="filter-dropdown-panel" wx:if="{{showFilterPanel}}">
      <view class="filter-group">
        <view class="filter-label">高级过滤条件</view>
        <view class="filter-chips">
          <view class="filter-chip {{inServiceRange ? 'selected' : ''}}" bindtap="toggleInServiceRange">
            <text class="remix-icon {{inServiceRange ? 'ri-checkbox-circle-fill' : 'ri-add-circle-line'}} chip-icon"></text>
            <text>接单范围内</text>
          </view>
          <view class="filter-chip {{inServiceTime ? 'selected' : ''}}" bindtap="toggleInServiceTime">
            <text class="remix-icon {{inServiceTime ? 'ri-checkbox-circle-fill' : 'ri-add-circle-line'}} chip-icon"></text>
            <text>可服务时间内</text>
          </view>
        </view>
      </view>

      <view class="filter-group" style="margin-top: 20rpx;">
        <view class="filter-label">特定履约日期筛选</view>
        <view class="date-picker-row">
          <picker mode="date" value="{{filterDate}}" bindchange="onDateChange" style="flex: 1;">
            <view class="date-input-box">
              <text class="remix-icon ri-calendar-line"></text>
              <text>{{filterDate || '选择特定履约日期'}}</text>
            </view>
          </picker>
          <button class="clear-date-btn" wx:if="{{filterDate}}" bindtap="clearDate">清除日期</button>
        </view>
      </view>

      <view class="filter-actions">
        <button class="reset-btn" bindtap="resetFilters">重置全部</button>
        <button class="confirm-btn" bindtap="toggleFilterPanel">收起面板</button>
      </view>
    </view>

    <!-- 抢单模式切换 Tab -->
    <view class="grab-tabs-bar">
      <view class="grab-tab-item {{grabTab === 'normal' ? 'active' : ''}}" data-tab="normal" bindtap="switchGrabTab">
        <text>附近普通单</text>
        <text class="grab-tab-count" wx:if="{{nearbyOrders.length}}">({{nearbyOrders.length}})</text>
      </view>
      <view class="grab-tab-item urgent-tab-item {{grabTab === 'urgent' ? 'active' : ''}}" data-tab="urgent" bindtap="switchGrabTab">
        <text class="remix-icon ri-flashlight-fill urgent-tab-icon"></text>
        <text>加急公共单</text>
        <view class="urgent-tab-badge" wx:if="{{urgentOrders.length}}">{{urgentOrders.length}}</view>
      </view>
    </view>

    <!-- 普通单筛选与位置更新（仅普通单模式展示筛选） -->
    <block wx:if="{{grabTab === 'normal'}}">
      <button class="ghost-btn refresh-btn" loading="{{loadingNearby}}" bindtap="refreshNearby">
        <text class="remix-icon ri-refresh-line"></text>
        <text>更新位置并刷新订单</text>
      </button>
    </block>
    <block wx:else>
      <button class="ghost-btn refresh-btn urgent-refresh-btn" loading="{{loadingNearby}}" bindtap="refreshNearby">
        <text class="remix-icon ri-refresh-line"></text>
        <text>刷新加急公共单</text>
      </button>
    </block>
  </view>

  <!-- 普通公共抢单列表 -->
  <block wx:if="{{grabTab === 'normal'}}">
    <view class="order-card" wx:for="{{nearbyOrders}}" wx:key="_id">
      <view class="order-card-head">
        <view class="order-person">
          <view class="avatar-level-wrap">
            <image class="order-avatar" wx:if="{{item.petSnapshot && item.petSnapshot.avatarFileId}}" src="{{item.petSnapshot.avatarFileId}}" mode="aspectFill" />
            <image class="order-avatar" wx:elif="{{item.clientSnapshot && item.clientSnapshot.avatarUrl}}" src="{{item.clientSnapshot.avatarUrl}}" mode="aspectFill" />
            <view class="order-avatar placeholder" wx:else><text class="remix-icon ri-user-3-line"></text></view>
            <view class="avatar-level-badge badge-{{item.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{!(item.petSnapshot && item.petSnapshot.avatarFileId) && item.clientSnapshot && (item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName)}}">{{item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName}}</view>
          </view>
          <view class="order-person-info">
            <view class="order-title-row">
              <text class="order-client-name {{item.clientSnapshot.nameEffect && item.clientSnapshot.nameEffect !== 'none' ? 'name-effect-' + item.clientSnapshot.nameEffect : ''}}" style="{{item.clientSnapshot.nameColor ? 'color: ' + item.clientSnapshot.nameColor + ';' : ''}}">{{item.clientSnapshot.displayName || '宠物主'}}</text>
              <text class="member-badge badge-{{item.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{item.clientSnapshot && (item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName)}}">{{item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName}}</text>
              <text class="order-pet-name">· {{item.petName}}</text>
              <view class="pet-title" wx:if="{{(item.petSnapshot && item.petSnapshot.beautyTitle && item.petSnapshot.beautyTitle.title) || (item.beautyTitle && item.beautyTitle.title)}}">
                <text class="remix-icon ri-vip-crown-fill"></text>
                <text>{{(item.petSnapshot && item.petSnapshot.beautyTitle && item.petSnapshot.beautyTitle.title) || (item.beautyTitle && item.beautyTitle.title)}}</text>
              </view>
            </view>
            <view class="order-service">{{item.serviceSummary || (item.serviceType === 'walk' ? '上门遛狗' : '上门喂养')}}</view>
          </view>
        </view>
        <view class="count-badge">{{item.distanceText}}</view>
      </view>

      <view class="order-card-address">
        <text class="remix-icon ri-map-pin-2-line addr-icon"></text>
        <text>{{item.serviceAddress || '未填写地址'}}</text>
      </view>

      <view class="chip-row">
        <view class="chip"><text class="remix-icon ri-time-line"></text>{{beijingTime.format(item.startTime)}}</view>
        <view class="chip green" wx:if="{{item.staffEarning}}"><text class="remix-icon ri-money-cny-circle-line"></text>{{item.staffEarningText}}</view>
        <view class="chip blue">待抢单</view>
        <view class="chip warn" wx:if="{{!item.inRange}}">超出范围</view>
        <view class="chip warn" wx:if="{{!item.inTime}}">非服务时间</view>
      </view>

      <view class="order-actions">
        <button class="ghost-btn" data-id="{{item._id}}" bindtap="detail">订单详情</button>
        <button class="primary-btn" data-id="{{item._id}}" bindtap="accept">立即抢单</button>
        <button class="ghost-btn nav-btn" data-latitude="{{item.addressLatitude}}" data-longitude="{{item.addressLongitude}}" data-name="{{item.serviceAddress}}" data-address="{{item.addressDetail}} {{item.doorplate}}" bindtap="openNavigation">
          <text class="remix-icon ri-map-pin-line"></text>导航
        </button>
      </view>
    </view>

    <view class="list-state" wx:if="{{loadingNearby && nearbyOrders.length}}">正在加载更多可接订单...</view>
    <view class="list-state" wx:if="{{!loadingNearby && nearbyOrders.length && !nearbyHasMore}}">已显示全部可接订单</view>

    <view class="card empty order-empty" wx:if="{{locationReady && !nearbyOrders.length}}">
      <view class="empty-icon remix-icon ri-radar-line"></view>
      <view class="empty-title">附近暂无普通待抢订单</view>
      <view class="empty-desc">调整服务城市或过滤条件，或查看【加急公共单】～</view>
    </view>
  </block>

  <!-- 加急公共抢单列表 -->
  <block wx:else>
    <view class="order-card urgent-order-card" wx:for="{{urgentOrders}}" wx:key="_id">
      <view class="urgent-card-top-bar">
        <view class="urgent-badge-pill">
          <text class="remix-icon ri-flashlight-fill"></text>
          <text>平台加急单</text>
        </view>
        <view class="urgent-bonus-tag" wx:if="{{item.urgentBonus > 0}}">
          <text>加价补贴 +¥{{item.urgentBonus}}</text>
        </view>
      </view>

      <view class="order-card-head">
        <view class="order-person">
          <view class="avatar-level-wrap">
            <image class="order-avatar" wx:if="{{item.petSnapshot && item.petSnapshot.avatarFileId}}" src="{{item.petSnapshot.avatarFileId}}" mode="aspectFill" />
            <image class="order-avatar" wx:elif="{{item.clientSnapshot && item.clientSnapshot.avatarUrl}}" src="{{item.clientSnapshot.avatarUrl}}" mode="aspectFill" />
            <view class="order-avatar placeholder" wx:else><text class="remix-icon ri-user-3-line"></text></view>
          </view>
          <view class="order-person-info">
            <view class="order-title-row">
              <text class="order-client-name">{{item.clientSnapshot.displayName || '客户'}}</text>
              <text class="order-pet-name">· {{item.petName}}</text>
            </view>
            <view class="order-service">{{item.serviceSummary || (item.serviceType === 'walk' ? '上门遛狗' : '上门喂养')}}</view>
          </view>
        </view>
        <view class="count-badge urgent-dist-badge">{{item.distanceText || '已测距'}}</view>
      </view>

      <view class="order-card-address">
        <text class="remix-icon ri-map-pin-2-line addr-icon"></text>
        <text>{{item.serviceAddress || '未填写地址'}}</text>
      </view>

      <!-- 加急备注说明 -->
      <view class="urgent-remark-banner" wx:if="{{item.urgentRemark}}">
        <text class="remix-icon ri-information-fill urgent-remark-icon"></text>
        <text class="urgent-remark-text">{{item.urgentRemark}}</text>
      </view>

      <view class="chip-row">
        <view class="chip"><text class="remix-icon ri-time-line"></text>{{beijingTime.format(item.startTime)}}</view>
        <view class="chip urgent-earning-chip"><text class="remix-icon ri-money-cny-circle-line"></text>收益 {{item.staffEarningText}} (含补贴)</view>
      </view>

      <view class="order-actions">
        <button class="ghost-btn" data-id="{{item._id}}" bindtap="detail">订单详情</button>
        <button class="primary-btn urgent-grab-btn" data-id="{{item._id}}" bindtap="accept">
          <text class="remix-icon ri-flashlight-fill"></text>加急抢单
        </button>
        <button class="ghost-btn nav-btn" data-latitude="{{item.addressLatitude}}" data-longitude="{{item.addressLongitude}}" data-name="{{item.serviceAddress}}" data-address="{{item.addressDetail}} {{item.doorplate}}" bindtap="openNavigation">
          <text class="remix-icon ri-map-pin-line"></text>导航
        </button>
      </view>
    </view>

    <view class="card empty order-empty" wx:if="{{!urgentOrders.length}}">
      <view class="empty-icon remix-icon ri-checkbox-circle-fill" style="color: #52c41a;"></view>
      <view class="empty-title">当前暂无加急公共单</view>
      <view class="empty-desc">平台所有加急订单均已被抢单或履约中，可前往【附近普通单】查看～</view>
    </view>
  </block>

  <view class="notice-card info-notice">
    <text class="remix-icon ri-shield-check-line notice-icon"></text>
    <view class="notice-text">
      <text class="strong">隐私安全保障：</text>
      <text>客户门锁密码仅在服务时间窗口内解密可读，操作日志全流程加密记录。</text>
    </view>
  </view>

  <view class="risk-modal-mask" wx:if="{{acceptRisk}}" catchtap="closeAcceptRiskModal">
    <view class="risk-modal" catchtap="true">
      <view class="risk-modal-head">
        <view class="risk-title">{{acceptRisk.noticeTitle}}</view>
        <view class="risk-close" bindtap="closeAcceptRiskModal">×</view>
      </view>
      <view wx:if="{{acceptRiskStep === 1}}">
        <view class="risk-desc">该订单与你的接单设置不完全匹配，请确认是否仍要继续接单。</view>
        <view class="risk-warning" wx:for="{{acceptRisk.warnings}}" wx:key="type">
          <view class="risk-warning-title">{{item.title}}</view>
          <view class="risk-warning-detail">{{item.detail}}</view>
        </view>
        <button class="primary-btn risk-action" bindtap="continueAcceptRisk">我已知晓，继续接单</button>
        <button class="ghost-btn risk-action" bindtap="closeAcceptRiskModal">取消</button>
      </view>
      <view wx:else>
        <view class="risk-desc strong">请阅读以下履约影响与处罚说明</view>
        <view class="risk-rule" wx:for="{{acceptRisk.noticeItems}}" wx:key="*this">{{index + 1}}. {{item}}</view>
        <label class="risk-check" bindtap="toggleAcceptRiskAgreed">
          <checkbox checked="{{acceptRiskAgreed}}" color="#ff7a45" />
          <text>我已阅读并会遵守相关规定</text>
        </label>
        <button class="primary-btn risk-action {{acceptRiskAgreed ? '' : 'disabled'}}" loading="{{acceptingRiskOrder}}" disabled="{{!acceptRiskAgreed || acceptingRiskOrder}}" bindtap="confirmRiskAccept">确认接单</button>
        <button class="ghost-btn risk-action" disabled="{{acceptingRiskOrder}}" bindtap="closeAcceptRiskModal">取消</button>
      </view>
    </view>
  </view>

  <view class="bottom-nav staff-bottom-nav">
    <view class="nav-item active"><view class="nav-icon remix-icon ri-home-5-fill"></view><view>工作台</view></view>
    <view class="nav-item" data-url="/pages/staff/orders/list/index" bindtap="go"><view class="nav-icon remix-icon ri-file-list-3-line"></view><view>任务</view></view>
    <view class="nav-item" data-url="/pages/staff/messages/index" bindtap="go"><view class="nav-icon remix-icon ri-message-3-line"><view class="nav-unread-count" wx:if="{{messageUnreadCount > 0}}">{{messageUnreadCountText}}</view></view><view>消息</view></view>
    <view class="nav-item" data-url="/pages/staff/certification/index" bindtap="go"><view class="nav-icon remix-icon ri-checkbox-circle-line"></view><view>认证</view></view>
    <view class="nav-item" bindtap="backProfile"><view class="nav-icon remix-icon ri-user-3-line"></view><view>我的</view></view>
  </view>
</view>
