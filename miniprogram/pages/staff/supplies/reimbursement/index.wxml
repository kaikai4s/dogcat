<view class="page reimbursement-page {{themeClass}} {{fontClass}}">
  <staff-active-service-banner />
  <view class="hero">
    <view class="badge">平台出资 · 首次物资</view>
    <view class="title">物资报销</view>
    <view class="desc">平台首次用品费用减免；微信小店销售与此独立。</view>
  </view>

  <view class="card">
    <view class="card-title">申请前请确认</view>
    <view class="guide-box">
      <view>视频审核必须准备：一次性手套、一次性口罩、一次性鞋套、宠物安全消毒用品。</view>
      <view class="supply-list" style="margin: 12rpx 0;" wx:if="{{supplies.items && supplies.items.length}}">
        <view class="supply-item-row" wx:for="{{supplies.items}}" wx:key="name">
          <view class="supply-item-info">
            <text class="supply-dot">•</text>
            <text class="supply-name">{{item.name}}</text>
            <text class="supply-desc" wx:if="{{item.description}}">（{{item.description}}）</text>
          </view>
          <view class="supply-buy-btn" wx:if="{{item.purchaseUrl}}" data-url="{{item.purchaseUrl}}" data-name="{{item.name}}" bindtap="openPurchaseUrl">
            <text class="remix-icon ri-shopping-cart-2-line"></text>
            <text>购买链接</text>
          </view>
        </view>
      </view>
      <view>严格审核可能因其他原因不通过，备齐物资不保证审核通过。</view>
      <view>只有正式认证宠托师可申请首次物资报销，实习人员不可申请；未正式认证不报销。</view>
      <view>后续用品由本人承担。平台寄送的首次用品审核通过后，退出退押金时不扣用品费用；未申请或未通过则按确认的费用结算。</view>
    </view>
    <view class="muted">{{supplies.auditNotice}}</view>
    <view class="muted">{{supplies.serviceReminder}}</view>
    <view class="muted" wx:if="{{supplies.reimbursementEnabled === false && !shipmentDepositId}}">平台暂未开放报销申请。</view>
    <view class="muted" wx:if="{{profile && profile.staffLevel !== 'certified'}}">当前尚未正式认证，暂不能提交申请。</view>
    <block wx:if="{{qualification && qualification.conditions}}">
      <view class="muted" wx:if="{{qualification.mode === 'either'}}">报销资格：以下条件满足任意一项即可。</view>
      <view class="muted" wx:for="{{qualification.conditions}}" wx:key="mode">{{item.mode === 'invite_count' ? '有效邀请绑定人数' : '已完成订单数'}}：{{item.progressCount}} / {{item.requiredCount}}（{{item.met ? '已达标' : '未达标'}}）</view>
    </block>
    <view class="muted" wx:elif="{{qualification && !qualification.qualificationMet}}">报销资格进度：{{qualification.progressCount}} / {{qualification.requiredCount}}（{{qualification.mode === 'invite_count' ? '有效邀请绑定人数' : '已完成订单数'}}）</view>
    <view class="muted" wx:if="{{deliveryMode && !purchaseMet}}">平台首次用品发货后才可申请费用减免。</view>
    <view class="muted" wx:elif="{{supplies.purchaseRequired && !purchaseMet}}">请先在平台线上店铺购买一次性用品，完成支付后再申请。</view>
  </view>

  <view class="card">
    <view class="card-title">申请与到账状态</view>
    <view class="muted" wx:if="{{loading}}">正在获取最新状态...</view>
    <view class="warning" wx:if="{{loadError}}">状态获取失败，暂不可操作。以下历史信息可能已过期，请刷新重试。</view>
    <view class="status-label">{{statusLabel}}</view>
    <block wx:if="{{application}}">
      <view class="detail" wx:if="{{application.amount != null}}">{{application.benefitType === 'supply_fee_waiver' ? '申请减免用品费用' : '申请金额'}}：¥{{application.amount}}</view>
      <view class="detail" wx:if="{{application.approvedAmount != null}}">核准金额：¥{{application.approvedAmount}}</view>
      <view class="detail" wx:else>核准金额：待审核确认</view>
      <view class="detail" wx:if="{{application.remark}}">申请备注：{{application.remark}}</view>
      <view class="warning" wx:if="{{failureReason}}">驳回 / 失败原因：{{failureReason}}</view>
      <view class="receipt-grid" wx:if="{{submittedReceipts.length}}">
        <view class="receipt" wx:for="{{submittedReceipts}}" wx:key="*this">
          <image class="receipt-image" src="{{item}}" mode="aspectFill" data-submitted="yes" data-index="{{index}}" bindtap="previewReceipt" />
          <view class="muted">已提交凭证 {{index + 1}}</view>
        </view>
      </view>
    </block>
    <view class="warning" wx:if="{{transferNotice}}">{{transferNotice}}</view>
    <button class="primary-btn" wx:if="{{canConfirmTransfer}}" bindtap="confirmTransfer" disabled="{{busy || loading || uploading}}" loading="{{busy}}">查看收款 / 确认商家转账</button>
    <button class="ghost-btn" bindtap="refresh" disabled="{{busy || loading || uploading}}">刷新审核与到账状态</button>
    <view class="muted" wx:if="{{application && application.benefitType !== 'supply_fee_waiver'}}">审核通过不代表已付款。商家转账未配置时仍为等待付款，以服务端核实结果为准。</view>
    <view class="muted" wx:else>费用减免通过后在退出退押金审核时结算，不单独打款。</view>
  </view>

  <view class="card" wx:if="{{canApply}}">
    <view class="card-title">{{deliveryMode ? '申请首次用品费用减免' : '提交线上店铺采购报销'}}</view>
    <view class="privacy-notice">{{deliveryMode ? '仅平台寄送的首次用品可申请减免。审核通过后，退出退押金时不扣用品费用；申请待审期间暂缓退款结算。' : '报销金额由平台后台统一设置，每位宠托师仅可申请一次。请先在平台线上店铺购买一次性用品并选择已支付订单。'}}</view>
    <picker wx:if="{{!deliveryMode && eligibleMallOrders.length}}" mode="selector" range-key="orderNo" range="{{eligibleMallOrders}}" bindchange="selectMallOrder">
      <view class="form-input">{{mallOrderId ? '已选择线上订单' : '请选择线上用品订单'}}</view>
    </picker>
    <view class="receipt-grid">
      <view class="receipt" wx:for="{{receipts}}" wx:key="fileId">
        <image class="receipt-image" src="{{item.preview}}" mode="aspectFill" data-index="{{index}}" bindtap="previewReceipt" />
        <button class="remove-btn" data-index="{{index}}" bindtap="removeReceipt" disabled="{{busy || uploading}}">移除</button>
      </view>
    </view>
    <button class="ghost-btn" bindtap="chooseReceipts" disabled="{{busy || uploading || loading || receipts.length >= 9}}" loading="{{uploading}}">上传截图（可选，{{receipts.length}}/9）</button>
    <view class="muted">{{deliveryMode ? '本次用品费用以确认时金额为准' : '本次固定报销金额：¥' + (supplies.reimbursementAmount || supplies.maxReimbursementAmount)}}</view>
    <view class="field-label">申请备注</view>
    <textarea class="form-textarea" value="{{remark}}" bindinput="inputRemark" placeholder="可填写采购明细、日期及其他说明" maxlength="500" disabled="{{busy || uploading}}" />
    <button class="primary-btn" bindtap="submit" loading="{{busy}}" disabled="{{busy || uploading || loading}}">{{deliveryMode ? '提交费用减免申请' : '提交报销申请'}}</button>
  </view>
  <view class="card muted" wx:elif="{{!loading && !loadError}}">当前不可提交新申请。需正式认证、平台开放且服务端确认具备首次报销资格；已有申请请查看上方进度。</view>

  <!-- 自定义长按复制与一键复制弹窗 -->
  <view class="copy-modal-mask" wx:if="{{copyModal.show}}" catchtouchmove="noop" bindtap="closeCopyModal">
    <view class="copy-modal-card" catchtap="noop">
      <view class="copy-modal-header">
        <view class="copy-modal-title">{{copyModal.title}}</view>
        <view class="copy-modal-close" bindtap="closeCopyModal">
          <text class="remix-icon ri-close-line"></text>
        </view>
      </view>
      <view class="copy-modal-tip">{{copyModal.tip}}</view>
      <view class="copy-modal-content-box">
        <text class="copy-modal-text" user-select="{{true}}" selectable="{{true}}">{{copyModal.content}}</text>
      </view>
      <view class="copy-modal-hint">提示：可直接长按上方文字选择复制，也可点击下方按钮一键复制。</view>
      <view class="copy-modal-actions">
        <button class="copy-modal-btn ghost" bindtap="closeCopyModal">关闭</button>
        <button class="copy-modal-btn primary" bindtap="executeCopyModal">
          <text class="remix-icon ri-file-copy-line"></text>
          <text>{{copyModal.btnText || '一键复制'}}</text>
        </button>
      </view>
    </view>
  </view>
</view>
<global-loading />
