.reimbursement-page {
  min-height: 100vh;
  padding: 0 28rpx 100rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.title {
  color: #2d211a;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.2;
}

.desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #2d211a;
  margin-bottom: 16rpx;
}

.guide-box {
  background: #fff8ec;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #72543b;
  margin-bottom: 16rpx;
}

.muted {
  font-size: 24rpx;
  color: #8e8580;
  line-height: 1.5;
  margin-top: 10rpx;
}

.warning {
  font-size: 24rpx;
  color: #e9672f;
  background: #fff0eb;
  padding: 16rpx;
  border-radius: 16rpx;
  line-height: 1.5;
  margin-top: 12rpx;
}

.status-label {
  display: inline-block;
  font-size: 32rpx;
  font-weight: 900;
  color: #d45f22;
  margin: 12rpx 0;
}

.detail {
  font-size: 26rpx;
  color: #2d211a;
  line-height: 1.8;
}

.privacy-notice {
  font-size: 24rpx;
  color: #7a6a5e;
  line-height: 1.5;
  background: #fff8ec;
  padding: 16rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.qualification-panel { margin-top: 24rpx; padding: 24rpx; border: 2rpx solid #86baa6; border-radius: 16rpx; background: #edf7f2; box-sizing: border-box; }
.qualification-title { display: flex; align-items: center; gap: 12rpx; color: #205342; font-size: 30rpx; font-weight: 900; line-height: 1.4; }
.qualification-title .remix-icon { flex-shrink: 0; font-size: 34rpx; }
.qualification-summary { margin-top: 12rpx; color: #31574c; font-size: 25rpx; line-height: 1.55; font-weight: 700; overflow-wrap: anywhere; }
.condition-row { display: flex; align-items: flex-start; gap: 14rpx; padding: 18rpx 0; border-top: 1rpx solid #cee6d9; }
.qualification-summary + .condition-row { margin-top: 18rpx; }
.condition-number { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; border-radius: 50%; background: #d8ebe2; color: #205342; font-size: 22rpx; font-weight: 900; }
.condition-main { flex: 1; min-width: 0; }
.condition-name { font-size: 26rpx; font-weight: 850; color: #263b31; line-height: 1.4; overflow-wrap: anywhere; }
.condition-progress { margin-top: 5rpx; font-size: 23rpx; color: #526d5f; line-height: 1.4; }
.condition-status { flex-shrink: 0; margin-top: 2rpx; font-size: 22rpx; font-weight: 800; color: #9b5129; }
.condition-row.met .condition-status { color: #18744e; }
.qualification-result { padding-top: 12rpx; border-top: 1rpx solid #cee6d9; font-size: 24rpx; line-height: 1.5; color: #205342; font-weight: 800; }
.rules-consent { margin: 18rpx 0; padding: 18rpx; border: 1rpx solid #dfb693; border-radius: 12rpx; background: #fff8f0; }
.rules-consent-row { display: flex; align-items: flex-start; gap: 12rpx; width: 100%; box-sizing: border-box; }
.rules-consent-row checkbox { flex-shrink: 0; margin-top: 2rpx; transform: scale(.82); transform-origin: top left; }
.rules-consent-row text { flex: 1; min-width: 0; font-size: 25rpx; line-height: 1.5; font-weight: 800; color: #743819; overflow-wrap: anywhere; }

.receipt-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin: 16rpx 0;
}

.receipt {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.receipt-image {
  width: 100%;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f5ece5;
}

.remove-btn {
  margin-top: 8rpx;
  width: 100%;
  height: 48rpx;
  font-size: 22rpx;
  line-height: 48rpx;
  color: #e9672f;
  background: #fff0eb;
  border-radius: 12rpx;
  border: none;
  padding: 0;
}

.field-label {
  font-size: 26rpx;
  font-weight: 800;
  color: #2d211a;
  margin-top: 20rpx;
  margin-bottom: 8rpx;
}

.form-input {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #fff8ec;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.form-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx 20rpx;
  background: #fff8ec;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.primary-btn,
.ghost-btn {
  width: 100%;
  height: 84rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 20rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.ghost-btn {
  background: #fff0e2;
  color: #d45f22;
}

button[disabled] {
  opacity: 0.55;
}

.supply-list { display: flex; flex-direction: column; gap: 12rpx; }
.supply-item-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.supply-item-info { display: flex; align-items: center; flex-wrap: wrap; gap: 6rpx; font-size: 24rpx; color: #2d211a; }
.supply-dot { color: #e9672f; font-weight: 900; }
.supply-name { font-weight: 850; }
.supply-desc { color: #7a6a5e; font-size: 22rpx; }
.supply-buy-btn { display: inline-flex; align-items: center; gap: 6rpx; padding: 6rpx 16rpx; border-radius: 999rpx; background: #fff0e2; color: #e9672f; font-size: 22rpx; font-weight: 850; flex-shrink: 0; }
.supply-buy-btn:active { opacity: 0.8; transform: scale(0.96); }

.copy-modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(0, 0, 0, 0.65);
  box-sizing: border-box;
}

.copy-modal-card {
  width: 100%;
  max-width: 620rpx;
  border-radius: 32rpx;
  background: #ffffff;
  padding: 36rpx 32rpx 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.25);
  box-sizing: border-box;
}

.copy-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.copy-modal-title {
  font-size: 32rpx;
  font-weight: 950;
  color: #2d211a;
}

.copy-modal-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f5ede6;
  color: #8e8580;
  font-size: 32rpx;
}

.copy-modal-tip {
  font-size: 24rpx;
  color: #7a6a5e;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.copy-modal-content-box {
  background: #fff8ec;
  border: 2rpx dashed #fcd3b6;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  word-break: break-all;
  user-select: text;
  -webkit-user-select: text;
}

.copy-modal-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #e9672f;
  line-height: 1.6;
  user-select: text;
  -webkit-user-select: text;
}

.copy-modal-hint {
  font-size: 22rpx;
  color: #a89b92;
  margin-bottom: 28rpx;
  line-height: 1.4;
}

.copy-modal-actions {
  display: flex;
  gap: 16rpx;
}

.copy-modal-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0;
  border: none;
}

.copy-modal-btn.ghost {
  background: #f5ede6;
  color: #7a6a5e;
}

.copy-modal-btn.primary {
  background: linear-gradient(135deg, #ffb86c, #ff7a45);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(233, 103, 47, 0.3);
}

.copy-modal-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}
