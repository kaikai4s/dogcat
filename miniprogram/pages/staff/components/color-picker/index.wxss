.picker { margin: 20rpx 0; }
.color-plane { position: relative; height: 240rpx; border-radius: 16rpx; touch-action: none; }
.white-layer, .black-layer { position: absolute; inset: 0; border-radius: inherit; pointer-events: none; }
.white-layer { background: linear-gradient(to right, #fff, rgba(255,255,255,0)); }
.black-layer { background: linear-gradient(to bottom, rgba(0,0,0,0), #000); }
.color-cursor { position: absolute; width: 28rpx; height: 28rpx; box-sizing: border-box; border: 3rpx solid #fff; border-radius: 50%; box-shadow: 0 0 0 2rpx rgba(0,0,0,.45); transform: translate(-50%, -50%); pointer-events: none; }
.hue-track { margin: 30rpx 10rpx 0; height: 32rpx; border-radius: 20rpx; background: linear-gradient(to right, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00); }
.hue-track slider { margin: 0; height: 32rpx; }
.picker-tip { font-size: 22rpx; color: #807166; margin-top: 22rpx; }
