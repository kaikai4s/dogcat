@import "../../../styles/subscription-entry.wxss";
/* Staff messages page - Cute Pet Style UI redesign */
.staff-messages-page {
  min-height: 100vh;
  padding: 0 28rpx 180rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.staff-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon { font-size: 28rpx; }

.hero-title {
  color: #2d211a;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.card {
  padding: 26rpx;
  border-radius: 34rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 12rpx 32rpx rgba(123, 89, 62, 0.06);
}

.message-card {
  display: flex;
  gap: 20rpx;
  align-items: center;
  position: relative;
}

.message-card-side {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-left: 8rpx;
}

.message-delete-action {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b5a498;
  background: #fdf5ef;
  font-size: 32rpx;
  transition: all 0.2s ease;
}

.message-delete-action:active,
.delete-hover {
  color: #e03131 !important;
  background: #ffe3e3 !important;
  transform: scale(0.92);
}

.message-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0e2;
  color: #e9672f;
  font-size: 42rpx;
  flex-shrink: 0;
}

.message-card-dot,
.nav-red-dot {
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #f53f3f;
  border: 4rpx solid #fff;
}

.message-card-count,
.nav-unread-count {
  position: absolute;
  right: -12rpx;
  top: -10rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #f53f3f;
  color: #ffffff;
  border: 4rpx solid #ffffff;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-align: center;
  box-sizing: content-box;
}

.nav-unread-count {
  right: -18rpx;
  top: -12rpx;
  min-width: 26rpx;
  height: 26rpx;
  font-size: 16rpx;
  line-height: 26rpx;
}

.message-main {
  flex: 1;
  min-width: 0;
}

.message-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.message-title {
  flex: 1;
  min-width: 0;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.25;
}

.message-time {
  flex-shrink: 0;
  color: #8e8580;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.message-preview {
  margin-top: 10rpx;
  color: #7a6a5e;
  font-size: 25rpx;
  line-height: 1.45;
}

.message-meta {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1;
}

.status-badge.default {
  background: #ffebe6;
  color: #e9672f;
}

.status-badge.warning {
  background: #fff0d9;
  color: #d45f22;
}

.status-badge.blue {
  background: #eaf3ff;
  color: #2563eb;
}

.status-badge.purple {
  background: #f3e8ff;
  color: #7e22ce;
}

.status-badge.green {
  background: #e6f8ea;
  color: #00b42a;
}

.status-badge.red {
  background: #fff1f2;
  color: #be123c;
}

.status-badge.gray {
  background: #f0eae5;
  color: #8e8580;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
}

.badge.pink {
  background: #ffebe6;
  color: #e9672f;
}

.order-no {
  color: #8e8580;
  font-size: 22rpx;
}

.arrow-icon {
  margin-top: 28rpx;
  color: #c4b8b0;
  font-size: 34rpx;
}

.load-tip {
  text-align: center;
  padding: 28rpx 0;
  color: #8e8580;
  font-size: 24rpx;
}

.empty-state {
  margin-top: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #8e8580;
}

.empty-icon {
  font-size: 110rpx;
  color: #e2d9d2;
}

.empty-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 900;
  color: #2d211a;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.primary-link {
  margin-top: 24rpx;
  padding: 18rpx 34rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.staff-bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 14rpx 10rpx calc(14rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #ffffff !important;
  border-top: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 -10rpx 36rpx rgba(123, 89, 62, 0.12);
  backdrop-filter: blur(16rpx);
  box-sizing: border-box;
}

.staff-bottom-nav .nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  font-size: 20rpx;
  color: #8e8580;
  font-weight: 700;
}

.staff-bottom-nav .nav-item.active {
  color: #e9672f;
  font-weight: 950;
}

.staff-bottom-nav .nav-icon {
  font-size: 44rpx;
  position: relative;
  line-height: 1;
}

/* 分类 Tabs 样式 */
.messages-tabs-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 12rpx 0 20rpx;
  padding: 6rpx;
  background: #f7ebe1;
  border-radius: 999rpx;
  position: relative;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 850;
  color: #8c786a;
  transition: all 0.2s ease;
  position: relative;
}

.tab-item.active {
  background: #ffffff;
  color: #e9672f;
  box-shadow: 0 4rpx 14rpx rgba(233, 103, 47, 0.15);
}

.tab-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 28rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.notices-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 10rpx 14rpx;
  margin-top: 6rpx;
}

.notices-count {
  font-size: 24rpx;
  color: #8c786a;
  font-weight: 750;
}

.read-all-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: #e9672f;
  font-weight: 850;
  padding: 10rpx 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(233, 103, 47, 0.28);
  border-radius: 999rpx;
  box-shadow: 0 4rpx 14rpx rgba(233, 103, 47, 0.1);
  transition: all 0.2s ease;
}

.read-all-btn:active {
  background: #fff4ed;
  transform: scale(0.96);
}

/* 系统通知卡片样式 */
.notice-card {
  padding: 28rpx;
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  position: relative;
  transition: all 0.2s ease;
}

.notice-unread {
  border-left: 8rpx solid #ff7a45;
  background: #ffffff;
}

.notice-read {
  border-left: 8rpx solid transparent;
  background: #faf7f5;
  opacity: 0.9;
}

.notice-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.notice-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.notice-type-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 850;
  line-height: 1.2;
}

.type-system {
  background: #fff0d9;
  color: #d45f22;
}

.type-notice {
  background: #eaf3ff;
  color: #2563eb;
}

.type-activity {
  background: #e6f8ea;
  color: #00b42a;
}

.notice-urgent-tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 850;
  background: #fff1f2;
  color: #e03131;
}

.notice-unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
}

.notice-time {
  color: #a89b90;
  font-size: 22rpx;
}

.notice-title-row {
  display: flex;
  align-items: center;
}

.notice-title {
  color: #2d211a;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 1.35;
}

.notice-content-preview {
  color: #63554b;
  font-size: 25rpx;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

.notice-footer {
  margin-top: 6rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #f0e6dc;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  color: #e9672f;
  font-size: 23rpx;
  font-weight: 850;
}

/* 通知详情弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(4rpx);
  z-index: 1100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.notice-modal-dialog {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 38rpx 34rpx 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.modal-tags {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.modal-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #f7ebe1;
  color: #8c786a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.modal-title {
  color: #2d211a;
  font-size: 34rpx;
  font-weight: 950;
  line-height: 1.35;
  margin-bottom: 10rpx;
}

.modal-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #a89b90;
  font-size: 22rpx;
  margin-bottom: 22rpx;
}

.modal-body {
  max-height: 480rpx;
  min-height: 120rpx;
  margin-bottom: 30rpx;
}

.modal-content-text {
  color: #4f4239;
  font-size: 27rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-all;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.modal-primary-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  border: none;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.25);
}

.modal-dismiss-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 999rpx;
  background: #f7ebe1;
  color: #7a6a5e;
  font-size: 28rpx;
  font-weight: 850;
  border: none;
  text-align: center;
}
