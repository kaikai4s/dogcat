/* Staff message thread - Cute Pet Style UI redesign */
.staff-thread-page {
  min-height: 100vh;
  padding: 0 28rpx 190rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.staff-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon { font-size: 28rpx; }

.hero-title {
  color: #2d211a;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.25;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.chat-list {
  padding-bottom: 20rpx;
}

.chat-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin: 24rpx 0;
}

.chat-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0e2;
  color: #e9672f;
  font-size: 38rpx;
  flex-shrink: 0;
}

.chat-content {
  flex: 1;
  min-width: 0;
}

.chat-time {
  margin-bottom: 10rpx;
  color: #8e8580;
  font-size: 22rpx;
}

.chat-bubble {
  display: inline-block;
  max-width: 560rpx;
  padding: 22rpx 24rpx;
  border-radius: 10rpx 28rpx 28rpx 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(123, 89, 62, 0.06);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
}

.chat-title {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 950;
  line-height: 1.35;
}

.chat-detail {
  margin-top: 10rpx;
  color: #7a6a5e;
  font-size: 25rpx;
  line-height: 1.5;
}

.chat-input-placeholder {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  padding: 18rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 14rpx 38rpx rgba(123, 89, 62, 0.12);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
}

.readonly-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #8e8580;
  font-size: 24rpx;
  margin-bottom: 14rpx;
}

.tip-icon {
  color: #e9672f;
  font-size: 28rpx;
}

.primary-btn {
  width: 100%;
  height: 78rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
  line-height: 1;
}

.empty-state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8e8580;
}

.empty-icon {
  font-size: 110rpx;
  color: #e2d9d2;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 28rpx;
}
