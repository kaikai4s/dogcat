/* Staff incident detail - Cute Pet Style UI redesign */
.staff-incident-detail-page {
  min-height: 100vh;
  padding: 0 28rpx 100rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.staff-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff1f2 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #be123c;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon { font-size: 28rpx; }

.hero-title {
  color: #2d211a;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.25;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.card-subtitle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  margin-bottom: 18rpx;
}

.sub-icon {
  color: #e9672f;
  font-size: 34rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.08);
}

.info-row:last-child { border-bottom: none; }

.info-row .label {
  color: #8e8580;
  font-size: 25rpx;
}

.info-row .value {
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 850;
  text-align: right;
  max-width: 65%;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
}

.badge.pink {
  background: #ffebe6;
  color: #e9672f;
}

.desc-text {
  color: #7a6a5e;
  font-size: 25rpx;
  line-height: 1.5;
}

.evidence-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.evidence-image,
.evidence-item image {
  width: 100%;
  height: 160rpx;
  border-radius: 22rpx;
  background: #fff0e2;
}

.resolution-card {
  background: #fffbf7;
}

.resolution-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  margin-bottom: 8rpx;
}

.price-text {
  margin-top: 12rpx;
  color: #e9672f;
  font-size: 38rpx;
  font-weight: 950;
}

.timeline {
  padding-left: 18rpx;
  border-left: 2rpx solid rgba(255, 153, 102, 0.16);
}

.timeline-item {
  position: relative;
  padding: 0 0 28rpx 20rpx;
}

.timeline-item:last-child { padding-bottom: 0; }

.timeline-dot {
  position: absolute;
  left: -25rpx;
  top: 4rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #e9672f;
  border: 4rpx solid #fff0e2;
}

.timeline-role {
  color: #2d211a;
  font-size: 26rpx;
  font-weight: 950;
  margin-bottom: 8rpx;
}

.timeline-time {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 22rpx;
}

.comment-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fff8ec;
  border: 1rpx solid rgba(255, 153, 102, 0.15);
  font-size: 26rpx;
  color: #2d211a;
  box-sizing: border-box;
}

.upload-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.upload-count {
  color: #8e8580;
  font-size: 24rpx;
}

.mini-btn {
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #fff0e2;
  color: #d45f22;
  font-size: 24rpx;
  font-weight: 850;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: none;
  line-height: 1;
}

.evidence-item {
  position: relative;
}

.remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #f53f3f;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
  font-weight: 900;
}

.primary-btn,
.ghost-btn {
  width: 100%;
  min-height: 84rpx;
  margin-top: 22rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
}

.primary-btn {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.ghost-btn {
  background: #fff0e2;
  color: #7a6a5e;
}
