<view class="page">

  <view class="dashboard-header">
    <view class="badge">履约异常</view>
    <view class="title">纠纷 / SOS 处理</view>
    <view class="tip">查看你提交的 SOS 和客户投诉，及时补充说明与证据。</view>
  </view>

  <view wx:if="{{!incidents.length && !loading}}" class="empty">
    暂无相关纠纷或 SOS。
    <button class="ghost" bindtap="goOrders">查看我的任务</button>
  </view>

  <view class="card interactive" wx:for="{{incidents}}" wx:key="_id" data-id="{{item._id}}" bindtap="detail">
    <view class="between">
      <view>
        <view class="strong">{{item.title || item.incidentTypeText}}</view>
        <view class="muted">{{item.description}}</view>
        <view class="muted">订单 {{item.orderId}} · {{item.createdAt}}</view>
      </view>
      <view class="badge">{{item.statusText}}</view>
    </view>
    <view class="chip-row">
      <view class="chip pink">{{item.incidentTypeText}}</view>
      <view class="chip" wx:if="{{item.refundNo}}">退款处理中</view>
    </view>
  </view>
</view>
