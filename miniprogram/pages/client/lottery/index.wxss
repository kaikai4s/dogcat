/* 页面样式使用 miniprogram/app.wxss 全局设计系统 */

.draw-disabled {
  margin-top: 40rpx;
  padding: 24rpx;
  border-radius: 999rpx;
  color: var(--theme-muted);
  background: var(--theme-bg-soft);
  border: 2rpx solid var(--theme-border);
  font-size: 32rpx;
  font-weight: 800;
}

.lottery-records {
  margin-top: 24rpx;
}

.lottery-records .subtitle {
  margin: 0;
}

.record-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid var(--theme-border);
}

.record-row:first-of-type {
  border-top: none;
}

.empty-record {
  padding: 36rpx 0 8rpx;
  text-align: center;
}
