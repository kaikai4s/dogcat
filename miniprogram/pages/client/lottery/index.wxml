<view class="page">
  <view class="dashboard-header">
    <view class="badge">福利中心</view>
    <view class="title">幸运抽奖</view>
    <view class="tip">每天可参与一次，随机获得优惠券奖励。</view>
  </view>

  <view wx:if="{{activity}}">
    <view class="card" style="text-align:center;padding:60rpx 32rpx;">
      <view style="font-size:100rpx;margin-bottom:24rpx;">🎰</view>
      <view class="strong" style="font-size:40rpx;margin-bottom:12rpx;">{{activity.name}}</view>
      <view class="muted" wx:if="{{activity.description}}">{{activity.description}}</view>
      <view class="muted" style="margin-top:12rpx;">共 {{activity.prizeCount}} 种奖品</view>
      <button class="primary" style="margin-top:40rpx;font-size:36rpx;padding:24rpx;" loading="{{drawing}}" bindtap="draw">
        {{drawing ? '抽取中...' : '立即抽奖'}}
      </button>
    </view>

    <view class="card" wx:if="{{result}}">
      <view class="subtitle">本次结果</view>
      <view class="between">
        <view class="strong">{{result.prizeName}}</view>
        <view class="badge" wx:if="{{result.couponId}}">已存入优惠券</view>
      </view>
    </view>
  </view>

  <view class="card" wx:else style="text-align:center;padding:80rpx 32rpx;">
    <view style="font-size:80rpx;margin-bottom:24rpx;">🌙</view>
    <view class="strong">暂无进行中的抽奖活动</view>
    <view class="muted" style="margin-top:12rpx;">关注平台动态，等待下次活动开启</view>
  </view>
</view>
