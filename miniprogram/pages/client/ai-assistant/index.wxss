.ai-page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background-color: #FFF3F7;
  display: flex;
  flex-direction: column;
}

.ai-header {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(224, 92, 139, 0.08);
}

.ai-header .title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2b2b2b;
  margin-bottom: 8rpx;
}

.ai-header .tip {
  font-size: 24rpx;
  color: #7a7a7a;
}

.chat-list {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 140rpx;
}

.chat-msg {
  max-width: 85%;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.chat-msg.user {
  align-self: flex-end;
  background: #e05c8b;
  color: #ffffff;
  border-bottom-right-radius: 4rpx;
}

.chat-msg.ai {
  align-self: flex-start;
  background: #ffffff;
  color: #2b2b2b;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.preset-box {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.preset-chip {
  background: #fff0f5;
  color: #e05c8b;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  border: 1rpx solid #ffd6e5;
}

.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 20rpx 24rpx 40rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.input-bar input {
  flex: 1;
  background: #f7f7f7;
  height: 80rpx;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #e05c8b !important;
  color: #ffffff !important;
  border-radius: 40rpx !important;
  font-size: 28rpx !important;
  padding: 0 32rpx !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  margin: 0 !important;
}
