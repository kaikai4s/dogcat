/* Client AI assistant - Cute Pet Style UI redesign */
.ai-page { min-height: 100vh; padding: 0 28rpx 220rpx; box-sizing: border-box; background: linear-gradient(180deg,#fff8ec 0%,#fffaf6 42%,#f7fbfa 100%); color: #2d211a; display: flex; flex-direction: column; }
.ai-hero { margin: 0 -28rpx 20rpx; padding: 42rpx 34rpx 34rpx; border-bottom-left-radius: 48rpx; border-bottom-right-radius: 48rpx; background: linear-gradient(135deg,#fff0c9 0%,#ffd9c8 54%,#fff5f0 100%); box-shadow: 0 18rpx 44rpx rgba(123,89,62,.08); }
.hero-badge { display: inline-flex; align-items: center; gap: 8rpx; padding: 6rpx 18rpx; border-radius: 999rpx; color: #d45f22; background: rgba(255,255,255,.85); font-size: 24rpx; font-weight: 850; margin-bottom: 16rpx; }
.hero-icon { font-size: 28rpx; }
.hero-title { color: #2d211a; font-size: 42rpx; font-weight: 950; line-height: 1.2; }
.hero-desc { margin-top: 12rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.4; }
.preset-box { margin-top: 22rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.preset-chip { display: inline-flex; align-items: center; gap: 6rpx; background: rgba(255,255,255,.86); color: #d45f22; font-size: 24rpx; font-weight: 850; padding: 10rpx 18rpx; border-radius: 999rpx; border: 1rpx solid rgba(255,153,102,.14); }
.preset-chip .remix-icon { font-size: 26rpx; }
.ai-disclaimer-strip { display: flex; align-items: center; gap: 10rpx; padding: 14rpx 20rpx; margin-bottom: 22rpx; background: rgba(255,238,224,.75); border: 1rpx solid rgba(255,122,69,.2); border-radius: 20rpx; box-sizing: border-box; }
.strip-icon { font-size: 26rpx; color: #ff7a45; flex-shrink: 0; }
.strip-text { font-size: 21rpx; line-height: 1.35; color: #a4501f; font-weight: 650; }
.chat-list { flex: 1; display: flex; flex-direction: column; gap: 20rpx; }
.chat-item { display: flex; flex-direction: column; }
.chat-item.user { align-items: flex-end; }
.chat-item.ai { align-items: flex-start; }
.chat-msg { max-width: 85%; border-radius: 28rpx; padding: 22rpx 24rpx; font-size: 28rpx; line-height: 1.6; word-break: break-word; }
.chat-msg.user { background: linear-gradient(135deg,#ffb86c 0%,#ff7a45 100%); color: #fff; border-bottom-right-radius: 8rpx; box-shadow: 0 10rpx 24rpx rgba(255,122,69,.16); }
.chat-msg.ai { background: #fff; color: #2d211a; border-bottom-left-radius: 8rpx; box-shadow: 0 12rpx 30rpx rgba(123,89,62,.06); border: 1rpx solid rgba(255,153,102,.14); }
.ai-msg-tip { display: inline-flex; align-items: center; gap: 6rpx; margin-top: 8rpx; margin-left: 14rpx; font-size: 20rpx; color: #b59f93; line-height: 1; }
.ai-msg-tip .remix-icon { font-size: 22rpx; color: #ffaa5b; }
.input-wrap { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(14rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); padding: 16rpx 18rpx 14rpx; box-shadow: 0 16rpx 38rpx rgba(123,89,62,.12); border: 1rpx solid rgba(255,153,102,.14); border-radius: 32rpx; display: flex; flex-direction: column; gap: 10rpx; backdrop-filter: blur(16rpx); z-index: 20; box-sizing: border-box; }
.input-row { display: flex; gap: 14rpx; align-items: center; width: 100%; }
.input-row input { flex: 1; min-width: 0; background: #fff8ec; height: 76rpx; border-radius: 26rpx; padding: 0 24rpx; color: #2d211a; font-size: 26rpx; }
.input-disclaimer { display: flex; align-items: center; justify-content: center; gap: 6rpx; color: #a89a90; font-size: 20rpx; line-height: 1.2; text-align: center; }
.input-disclaimer .remix-icon { font-size: 22rpx; color: #ff9a44; }
.send-btn { min-width: 140rpx; height: 76rpx; border-radius: 26rpx; margin: 0 !important; background: linear-gradient(135deg,#ffb86c 0%,#ff7a45 100%) !important; color: #fff !important; display: flex; align-items: center; justify-content: center; gap: 6rpx; font-size: 25rpx !important; font-weight: 900; line-height: 1 !important; padding: 0 22rpx !important; border: none; box-shadow: 0 10rpx 24rpx rgba(255,122,69,.18); }
.send-btn::after { display: none; }
.send-btn .remix-icon { font-size: 28rpx; }
