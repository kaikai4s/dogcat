<view class="ai-page {{themeClass}} {{fontClass}}">
  <view class="ai-hero">
    <view class="hero-badge"><text class="remix-icon ri-robot-2-fill hero-icon"></text><text>AI 宠护</text></view>
    <view class="hero-title">AI 宠护小助手</view>
    <view class="hero-desc">智能解答养宠知识、饮食指导、行为习惯与服务安排问题。</view>
    <view class="preset-box">
      <view class="preset-chip" bindtap="askPreset" data-text="狗狗外出爆冲怎么办？"><text class="remix-icon ri-run-line"></text><text>爆冲防护</text></view>
      <view class="preset-chip" bindtap="askPreset" data-text="猫咪换粮呕吐如何处理？"><text class="remix-icon ri-restaurant-line"></text><text>饮食消化</text></view>
      <view class="preset-chip" bindtap="askPreset" data-text="上门喂养需要准备什么？"><text class="remix-icon ri-home-heart-line"></text><text>上门准备</text></view>
    </view>
  </view>

  <view class="ai-disclaimer-strip">
    <text class="remix-icon ri-shield-check-line strip-icon"></text>
    <text class="strip-text">免责提示：AI 生成内容可能存在不准确或虚构，仅供参考，不作为专业医疗诊疗建议。</text>
  </view>

  <view class="chat-list">
    <block wx:for="{{messages}}" wx:key="index">
      <view class="chat-item {{item.role}}">
        <view class="chat-msg {{item.role}}">
          <text selectable="{{true}}">{{item.content}}</text>
        </view>
        <view class="ai-msg-tip" wx:if="{{item.role === 'ai' && item.content}}">
          <text class="remix-icon ri-sparkling-fill"></text>
          <text>AI 生成仅供参考 · 急症请及时就医</text>
        </view>
      </view>
    </block>
  </view>

  <view class="input-wrap">
    <view class="input-row">
      <input placeholder="请输入养宠或服务咨询问题..." value="{{inputText}}" bindinput="onInput" bindconfirm="send" />
      <button class="send-btn" loading="{{loading}}" bindtap="send"><text class="remix-icon ri-send-plane-fill"></text><text>发送</text></button>
    </view>
    <view class="input-disclaimer">
      <text class="remix-icon ri-information-line"></text>
      <text>AI 技术生成内容仅供参考，涉及疾病诊疗与用药请以专业兽医为准</text>
    </view>
  </view>
</view>
