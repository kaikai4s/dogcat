/* 首页新增转化模块 */
.home-cta-card {
  background: linear-gradient(135deg, #ff6b94 0%, #ff9f7c 100%);
  color: #fff;
}

.cta-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.cta-title {
  font-size: 34rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.cta-sub {
  font-size: 24rpx;
  line-height: 1.5;
  opacity: 0.9;
}

.cta-btn {
  flex-shrink: 0;
  min-width: 176rpx;
  padding: 22rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #f43f6b;
  font-size: 28rpx;
  font-weight: 900;
}

.repeat-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.repeat-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0f5;
  font-size: 38rpx;
}

.service-scroll,
.sitter-scroll {
  white-space: nowrap;
  width: 100%;
}

.service-price-card,
.sitter-home-card {
  display: inline-block;
  vertical-align: top;
  white-space: normal;
  width: 232rpx;
  margin-right: 18rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff7fa;
  border: 1rpx solid rgba(244, 63, 107, 0.12);
}

.service-price-icon {
  font-size: 46rpx;
  margin-bottom: 12rpx;
}

.service-price-name,
.assurance-title {
  font-size: 28rpx;
  font-weight: 850;
  color: #2b2528;
}

.service-price-desc,
.assurance-desc,
.coupon-rule {
  min-height: 64rpx;
  margin-top: 8rpx;
  color: #969196;
  font-size: 23rpx;
  line-height: 1.4;
}

.service-price-text,
.coupon-amount {
  margin-top: 14rpx;
  color: #f43f6b;
  font-size: 32rpx;
  font-weight: 900;
}

.coupon-grid,
.assurance-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.coupon-mini {
  min-height: 220rpx;
  padding: 20rpx 14rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #fff2d8 0%, #fff 100%);
  text-align: center;
  border: 1rpx solid rgba(255, 170, 70, 0.18);
}

.coupon-tag {
  display: inline-flex;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(244, 63, 107, 0.1);
  color: #f43f6b;
  font-size: 20rpx;
  font-weight: 800;
}

.coupon-claim-btn {
  height: 52rpx;
  line-height: 52rpx;
  margin-top: 14rpx;
  border-radius: 999rpx;
  background: #f43f6b;
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.coupon-claim-btn[disabled] {
  opacity: 0.65;
}

.coupon-name {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #6b3d00;
}

.sitter-home-card {
  width: 310rpx;
  background: #fff;
}

.sitter-home-card .sitter-avatar-wrapper {
  margin-bottom: 16rpx;
}

.featured-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff0d7;
  color: #a06400;
  font-size: 22rpx;
}

.sitter-home-card .sitter-name-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.sitter-home-card .sitter-bio {
  min-height: 64rpx;
  margin: 10rpx 0;
}

.recent-order-story {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #fff7fa 0%, #ffffff 100%);
  border: 1rpx solid rgba(244, 63, 107, 0.1);
  box-shadow: 0 12rpx 34rpx rgba(116, 91, 101, 0.08);
}

.recent-story-head {
  align-items: flex-start;
  gap: 18rpx;
}

.recent-service-line,
.recent-checkin-line,
.recent-more {
  margin-top: 18rpx;
  color: #6f6870;
  font-size: 24rpx;
  line-height: 1.45;
}

.service-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #f43f6b;
  box-shadow: 0 0 0 8rpx rgba(244, 63, 107, 0.1);
}

.recent-people-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.recent-people-grid > view {
  padding: 18rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #f5e8ee;
}

.recent-review-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fffaf0;
}

.recent-stars {
  margin-bottom: 10rpx;
  color: #ffad1f;
  font-size: 24rpx;
  font-weight: 900;
}

.recent-stars text {
  margin-left: 10rpx;
  color: #6b3d00;
}

.recent-photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 16rpx;
}

.recent-checkin-photo {
  width: 100%;
  height: 150rpx;
  border-radius: 20rpx;
  background: #fff0f5;
}

.recent-more {
  color: #f43f6b;
  font-weight: 850;
  text-align: right;
}

.assurance-item {
  padding: 22rpx 14rpx;
  border-radius: 24rpx;
  background: #f8fbff;
  text-align: center;
}

.assurance-icon {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}

.lottery-float-card {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 190rpx;
  z-index: 20000;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 34rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff4d6d 0%, #ff8a3d 100%);
  box-shadow: 0 18rpx 46rpx rgba(244, 63, 107, 0.32);
  overflow: hidden;
}

.lottery-float-glow {
  position: absolute;
  right: -36rpx;
  top: -46rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  pointer-events: none;
}

.lottery-float-card .lottery-icon,
.lottery-float-card .lottery-info,
.lottery-float-card .lottery-btn {
  position: relative;
  z-index: 1;
}

.lottery-float-card .lottery-sub {
  color: rgba(255, 255, 255, 0.86);
}

.lottery-float-card .lottery-btn {
  background: #ffffff;
  color: #f43f6b;
}
