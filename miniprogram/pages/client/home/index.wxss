/* 顶部悬浮拼单通知（超通透柔光玻璃样式，浮层覆盖在页面上方，不挤占原本UI流） */
.home-group-notice-wrapper {
  position: fixed;
  top: 24rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 1000;
  pointer-events: auto;
  animation: noticeSlideDown 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes noticeSlideDown {
  from {
    transform: translateY(-40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.home-group-notice-stack {
  position: relative;
  width: 100%;
}

.home-group-notice-card {
  padding: 24rpx 28rpx 20rpx;
  border-radius: 32rpx;
  /* 超高通透柔光玻璃（Ultra-Translucent Frosted Glass）：底色降至18%~26%，极具空气感与晶莹剔透质感 */
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.24) 0%, rgba(240, 253, 244, 0.08) 45%, rgba(255, 255, 255, 0.16) 100%);
  backdrop-filter: blur(44rpx) saturate(220%);
  -webkit-backdrop-filter: blur(44rpx) saturate(220%);
  /* 晶莹柔光玻璃微高光与内折射反光 */
  border: 1.5rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 
    0 20rpx 48rpx rgba(15, 23, 42, 0.07),
    0 4rpx 14rpx rgba(5, 150, 105, 0.05),
    0 0 20rpx rgba(255, 255, 255, 0.40),
    inset 0 1.5rpx 3rpx rgba(255, 255, 255, 0.90),
    inset 0 -1rpx 2rpx rgba(255, 255, 255, 0.20);
  color: #0f172a;
  box-sizing: border-box;
}

.theme-night .home-group-notice-card {
  background: linear-gradient(135deg, rgba(30, 41, 59, 0.28) 0%, rgba(15, 23, 42, 0.18) 100%);
  backdrop-filter: blur(44rpx) saturate(220%);
  -webkit-backdrop-filter: blur(44rpx) saturate(220%);
  border: 1.5rpx solid rgba(255, 255, 255, 0.18);
  box-shadow: 
    0 20rpx 48rpx rgba(0, 0, 0, 0.45),
    0 0 24rpx rgba(16, 185, 129, 0.10),
    inset 0 1rpx 3rpx rgba(255, 255, 255, 0.25);
  color: #f1f5f9;
}

/* 卡片堆叠层级与动效 */
.card-stack-layer {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  pointer-events: none;
  box-sizing: border-box;
  transform-origin: center bottom;
}

/* 堆叠第 1 底层（第二张卡片） */
.card-stack-layer-1 {
  z-index: 2;
  transform: translateY(14rpx) scale(0.96);
  opacity: 0.68;
  filter: blur(2rpx);
  -webkit-filter: blur(2rpx);
  transition: transform 0.26s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.26s ease, filter 0.26s ease;
}

/* 堆叠第 1 底层平滑顶上来变为顶层卡片 */
.card-stack-layer-1.promoting-to-top {
  transform: translateY(0) scale(1) !important;
  opacity: 1 !important;
  filter: blur(0px) !important;
  -webkit-filter: blur(0px) !important;
  z-index: 5;
}

/* 堆叠第 2 底层（第三张卡片微缩轮廓） */
.card-stack-layer-2 {
  z-index: 1;
  transform: translateY(26rpx) scale(0.91);
  opacity: 0.38;
  height: 100%;
  filter: blur(4rpx);
  -webkit-filter: blur(4rpx);
}

/* 当前最上方顶层卡片 */
.card-stack-top {
  position: relative;
  z-index: 10;
  transform-origin: center center;
  touch-action: pan-y;
  will-change: transform, opacity, filter;
}

/* 卡片向上飞出并模糊淡出动画 */
.card-stack-top.card-dismissing {
  transition: transform 0.26s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.26s ease, filter 0.26s ease !important;
  transform: translateY(-160rpx) !important;
  opacity: 0 !important;
  filter: blur(16px) !important;
  -webkit-filter: blur(16px) !important;
  pointer-events: none;
}

/* 手势松手回弹原位平滑过渡 */
.card-stack-top.card-rebounding {
  transition: transform 0.25s cubic-bezier(0.2, 0.9, 0.4, 1), opacity 0.25s ease, filter 0.25s ease !important;
}

