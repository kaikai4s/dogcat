<view class="page dashboard-page">
  <!-- 动态轮播 Hero 模式 -->
  <view class="pet-hero hero-carousel-wrapper" wx:if="{{heroCarouselEnabled && heroSlides.length > 0}}">
    <view class="hero-top">
      <view class="hero-location interactive" bindtap="updateLocation">
        <view class="location-pin">📍</view>
        <view>
          <view class="location-name">{{locationName}}</view>
          <view class="location-tip" wx:if="{{locationTip}}">{{locationTip}}</view>
        </view>
        <view class="location-arrow">⌄</view>
      </view>
    </view>

    <swiper
      class="hero-swiper"
      autoplay="{{heroAutoplay}}"
      interval="{{heroRotateInterval}}"
      circular="{{true}}"
      current="{{heroCurrent}}"
      previous-margin="50rpx"
      next-margin="50rpx"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{heroSlides}}" wx:key="id" class="hero-swiper-item">
        <view class="slide-media-container {{index === heroCurrent ? 'active-slide' : 'inactive-slide'}}">
          <!-- 图片类型 -->
          <image
            wx:if="{{item.type === 'image'}}"
            src="{{item.url}}"
            mode="aspectFit"
            class="slide-image"
            data-item="{{item}}"
            bindtap="previewHeroMedia"
          />

          <!-- 视频类型 -->
          <view wx:else class="slide-video-box">
            <!-- 封面图及手动播放按钮 -->
            <view wx:if="{{heroPlayingVideoId !== item.id}}" class="video-poster-wrapper" data-id="{{item.id}}" data-item="{{item}}" bindtap="previewHeroMedia">
              <image src="{{item.posterUrl || item.url}}" mode="aspectFit" class="slide-image" />
              <view class="video-play-overlay">
                <view class="play-icon-btn">▶</view>
              </view>
            </view>
            <!-- 播放器主体 -->
            <video
              wx:else
              id="hero_video_{{item.id}}"
              src="{{item.url}}"
              poster="{{item.posterUrl}}"
              controls="{{true}}"
              autoplay="{{true}}"
              show-fullscreen-btn="{{false}}"
              class="slide-video"
              data-id="{{item.id}}"
              bindpause="onVideoPauseOrEnded"
              bindended="onVideoPauseOrEnded"
            />
          </view>

          <!-- 文字遮罩 -->
          <view class="slide-overlay-content">
            <view class="hero-kicker" wx:if="{{item.title}}">{{item.title}}</view>
            <view class="hero-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <!-- 自定义精致指示器 -->
    <view class="carousel-dots" wx:if="{{heroSlides.length > 1}}">
      <view
        wx:for="{{heroSlides}}"
        wx:key="id"
        class="dot-item {{index === heroCurrent ? 'active' : ''}}"
      />
    </view>
  </view>

  <!-- 静态降级 Hero 模式 -->
  <view class="pet-hero" wx:else>
    <view class="hero-top">
      <view class="hero-location interactive" bindtap="updateLocation">
        <view class="location-pin">📍</view>
        <view>
          <view class="location-name">{{locationName}}</view>
          <view class="location-tip" wx:if="{{locationTip}}">{{locationTip}}</view>
        </view>
        <view class="location-arrow">⌄</view>
      </view>
    </view>
    <view class="hero-kicker">高信任上门宠护</view>
    <view class="hero-title">上门喂猫 / 遛狗 / 陪伴照护</view>
    <view class="hero-subtitle">查看附近宠托师，服务轨迹和关键打卡全程可见。</view>
    <view class="hero-chip">GPS 轨迹 + 实时打卡 + 服务报告</view>
  </view>

  <!-- 核心金刚区与快捷入口 -->
  <view class="hero-services-grid">
    <view class="hero-service-card pink-theme interactive" data-url="/pages/client/orders/create/index" bindtap="goProtected">
      <view class="card-text-box">
        <view class="service-title">上门喂猫</view>
        <view class="service-sub">核心照护 干净卫生</view>
      </view>
      <view class="service-emoji">🐱</view>
    </view>
    <view class="hero-service-card blue-theme interactive" data-url="/pages/client/orders/create/index" bindtap="goProtected">
      <view class="card-text-box">
        <view class="service-title">上门遛狗</view>
        <view class="service-sub">科学遛狗 安全有保障</view>
      </view>
      <view class="service-emoji">🐶</view>
    </view>
  </view>

  <!-- 快捷功能横向金刚区 -->
  <view class="card nav-quick-bar">
    <view class="quick-nav-item interactive" data-url="/pages/client/sitters/apply/index" bindtap="goProtected">
      <view class="nav-icon-box pink"><text class="icon-emoji">👩‍🌾</text></view>
      <text class="nav-label">入驻宠托师</text>
    </view>
    <view class="quick-nav-item interactive" data-url="/pages/client/orders/create/index" bindtap="goProtected">
      <view class="nav-icon-box orange"><text class="icon-emoji">🎁</text></view>
      <text class="nav-label">特惠养宠</text>
    </view>
    <view class="quick-nav-item interactive" data-url="/pages/client/coupons/list/index" bindtap="goProtected">
      <view class="nav-icon-box red"><text class="icon-emoji">🧧</text></view>
      <text class="nav-label">储值有礼</text>
    </view>
    <view class="quick-nav-item interactive" data-url="/pages/client/pets/list/index" bindtap="goProtected">
      <view class="nav-icon-box purple"><text class="icon-emoji">🐾</text></view>
      <text class="nav-label">宠物档案</text>
    </view>
    <view class="quick-nav-item interactive" data-url="/pages/client/home-security/index" bindtap="goProtected">
      <view class="nav-icon-box green"><text class="icon-emoji">🏠</text></view>
      <text class="nav-label">家庭安防</text>
    </view>
  </view>

  <!-- 历史服务记录 / 数据看板 -->
  <view class="card history-stats-card">
    <view class="card-header between">
      <text class="header-title">历史服务记录</text>
      <view class="header-more" data-url="/pages/client/sitters/list/index" bindtap="go">
        <text>查看更多服务记录和评价</text><text class="arrow">›</text>
      </view>
    </view>

    <view class="stats-three-grid">
      <view class="stat-box yellow-bg">
        <view class="stat-icon-circle yellow">🐱</view>
        <view class="stat-num yellow-text">{{statsData.catCount}} <text class="stat-unit">只</text></view>
        <view class="stat-desc">已喂养猫咪</view>
      </view>
      <view class="stat-box pink-bg">
        <view class="stat-icon-circle pink">🐶</view>
        <view class="stat-num pink-text">{{statsData.dogCount}} <text class="stat-unit">只</text></view>
        <view class="stat-desc">已遛狗狗数</view>
      </view>
      <view class="stat-box blue-bg">
        <view class="stat-icon-circle blue">👥</view>
        <view class="stat-num blue-text">{{statsData.ratingCount}} <text class="stat-unit">次</text></view>
        <view class="stat-desc">家长好评数</view>
      </view>
    </view>
  </view>

  <!-- 优选宠托师推荐卡片 -->
  <view class="card sitter-featured-card">
    <view class="card-header between">
      <text class="header-title">优选宠托师</text>
      <view class="header-more" data-url="/pages/client/sitters/list/index" bindtap="go">
        <text>查看更多</text><text class="arrow">›</text>
      </view>
    </view>

    <view class="sitter-item-row interactive" data-url="/pages/client/sitters/list/index" bindtap="go">
      <view class="sitter-avatar-wrapper">
        <view class="sitter-avatar-emoji">🐱🐶</view>
      </view>
      <view class="sitter-main-info">
        <view class="sitter-name-line between">
          <view class="sitter-name">{{topSitter.name}}</view>
          <view class="sitter-distance">📍 {{topSitter.distance}}</view>
        </view>
        <view class="sitter-rating-line">
          <text class="stars">⭐⭐⭐⭐⭐</text>
          <text class="score">{{topSitter.rating}}</text>
          <text class="divider">|</text>
          <text class="count">已服务{{topSitter.orderCount}}次</text>
        </view>
        <view class="sitter-bio">{{topSitter.bio}}</view>
        <view class="sitter-tags-row">
          <text class="tag-pill yellow-tag" wx:for="{{topSitter.tags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 抽奖活动/福利横幅 -->
  <view class="card interactive lottery-banner-card" wx:if="{{lotteryActivity}}" bindtap="goLottery">
    <view class="lottery-icon">🎰</view>
    <view class="lottery-info">
      <view class="lottery-title">{{lotteryActivity.name}}</view>
      <view class="lottery-sub">每天参与一次，随机赢优惠券</view>
    </view>
    <view class="lottery-btn">去抽奖</view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item active"><view class="nav-icon">⌂</view><view>首页</view></view>
    <view class="nav-item" data-url="/pages/client/sitters/list/index" bindtap="go"><view class="nav-icon">🐾</view><view>宠托师</view></view>
    <view class="nav-item" data-url="/pages/client/orders/list/index" bindtap="goProtected"><view class="nav-icon">☷</view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/client/profile/index" bindtap="go"><view class="nav-icon">♙</view><view>我的</view></view>
  </view>
</view>
