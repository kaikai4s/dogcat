<view class="page dashboard-page">
  <view class="pet-hero">
    <view class="hero-top">
      <view class="hero-location interactive" bindtap="updateLocation">
        <view class="location-pin">📍</view>
        <view>
          <view class="location-name">{{locationName}}</view>
          <view class="location-tip" wx:if="{{locationTip}}">{{locationTip}}</view>
        </view>
        <view class="location-arrow">⌄</view>
      </view>
      <view class="hero-mini-pill">附近推荐 · 一键预约</view>
    </view>
    <view class="hero-kicker">高信任上门宠护</view>
    <view class="hero-title">上门喂猫 / 遛狗 / 陪伴照护</view>
    <view class="hero-subtitle">查看附近宠托师，服务轨迹和关键打卡全程可见。</view>
    <view class="hero-chip">GPS 轨迹 + 实时打卡 + 服务报告</view>
  </view>

  <view class="grid">
    <view class="card interactive service-card" data-url="/pages/client/orders/create/index" bindtap="goProtected">
      <view class="action-icon">📝</view>
      <view class="strong">立即预约</view>
      <view class="muted">选择服务、时间和地址，快速创建订单</view>
    </view>
    <view class="card interactive service-card" data-url="/pages/client/sitters/list/index" bindtap="go">
      <view class="action-icon">🐾</view>
      <view class="strong">找宠托师</view>
      <view class="muted">按城市和区域筛选，指定熟悉的宠托师</view>
    </view>
  </view>

  <view class="card">
    <view class="subtitle">热门服务</view>
    <view class="grid">
      <view class="quick-card interactive" data-url="/pages/client/orders/create/index" bindtap="goProtected">
        <view class="action-icon">🐶</view>
        <view class="strong">上门遛狗</view>
        <view class="muted">牵引出门 / 路线可视 / 服务报告</view>
      </view>
      <view class="quick-card interactive" data-url="/pages/client/orders/create/index" bindtap="goProtected">
        <view class="action-icon">🐱</view>
        <view class="strong">上门喂猫</view>
        <view class="muted">换粮换水 / 清洁照护 / 陪伴互动</view>
      </view>
      <view class="quick-card interactive" data-url="/pages/client/sitters/list/index" bindtap="go">
        <view class="action-icon">⭐</view>
        <view class="strong">附近宠托师</view>
        <view class="muted">根据你选择的位置推荐可预约服务者</view>
      </view>
      <view class="quick-card interactive" data-url="/pages/client/orders/list/index" bindtap="goProtected">
        <view class="action-icon">📋</view>
        <view class="strong">我的订单</view>
        <view class="muted">查看轨迹、打卡和服务报告</view>
      </view>
    </view>
  </view>

  <view class="soft-panel">
    <view class="between">
      <view>
        <view class="strong">为什么宠物主放心下单</view>
        <view class="muted">平台审核宠托师，支持服务轨迹、关键打卡和服务总结查看。</view>
      </view>
      <view class="badge">安心履约</view>
    </view>
    <view class="chip-row">
      <view class="chip">平台审核</view>
      <view class="chip pink">实时打卡</view>
      <view class="chip blue">服务报告</view>
    </view>
  </view>

  <view class="card">
    <view class="subtitle">常用入口</view>
    <view class="grid">
      <view class="quick-card interactive" data-url="/pages/client/pets/list/index" bindtap="goProtected">
        <view class="action-icon">🐾</view>
        <view class="strong">宠物档案</view>
        <view class="muted">完善爱宠资料，预约时自动带入</view>
      </view>
      <view class="quick-card interactive" data-url="/pages/client/home-security/index" bindtap="goProtected">
        <view class="action-icon">🏠</view>
        <view class="strong">家庭安防</view>
        <view class="muted">门锁入户说明和紧急联系信息</view>
      </view>
    </view>
  </view>

  <view class="card interactive" wx:if="{{lotteryActivity}}" bindtap="goLottery" style="display:flex;align-items:center;gap:24rpx;">
    <view style="font-size:60rpx;">🎰</view>
    <view style="flex:1;">
      <view class="strong">{{lotteryActivity.name}}</view>
      <view class="muted">每天参与一次，随机赢优惠券</view>
    </view>
    <view class="badge" style="background:#e05c8b;color:#fff;">去抽奖</view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item active"><view class="nav-icon">⌂</view><view>首页</view></view>
    <view class="nav-item" data-url="/pages/client/sitters/list/index" bindtap="go"><view class="nav-icon">🐾</view><view>宠托师</view></view>
    <view class="nav-item" data-url="/pages/client/orders/list/index" bindtap="goProtected"><view class="nav-icon">☷</view><view>订单</view></view>
    <view class="nav-item" data-url="/pages/client/profile/index" bindtap="go"><view class="nav-icon">♙</view><view>我的</view></view>
  </view>
</view>
