<view class="page dashboard-page">
  <!-- 动态轮播 Hero 模式 -->
  <view class="pet-hero hero-carousel-wrapper" wx:if="{{heroCarouselEnabled && heroSlides.length > 0}}">
    <view class="hero-top">
      <view class="hero-location interactive" bindtap="updateLocation">
        <view class="location-pin">📍</view>
        <view>
          <view class="location-name">{{locationName}}</view>
          <view class="location-tip" wx:if="{{locationTip}}">{{locationTip}}</view>
        </view>
        <view class="location-arrow">⌄</view>
      </view>
    </view>

    <swiper class="hero-swiper" autoplay="{{heroAutoplay}}" interval="{{heroRotateInterval}}" circular="{{true}}" previous-margin="50rpx" next-margin="50rpx" bindchange="onSwiperChange">
      <swiper-item wx:for="{{heroSlides}}" wx:key="id" class="hero-swiper-item">
        <view class="slide-media-container {{index === heroCurrent ? 'active-slide' : 'inactive-slide'}}">
          <image wx:if="{{item.type === 'image'}}" src="{{item.url}}" mode="aspectFit" class="slide-image" data-item="{{item}}" bindtap="previewHeroMedia" />
          <view wx:else class="slide-video-box">
            <view wx:if="{{heroPlayingVideoId !== item.id}}" class="video-poster-wrapper" data-id="{{item.id}}" data-item="{{item}}" bindtap="previewHeroMedia">
              <image src="{{item.posterUrl || item.url}}" mode="aspectFit" class="slide-image" />
              <view class="video-play-overlay"><view class="play-icon-btn">▶</view></view>
            </view>
            <video wx:else id="hero_video_{{item.id}}" src="{{item.url}}" poster="{{item.posterUrl}}" controls="{{true}}" autoplay="{{true}}" show-fullscreen-btn="{{false}}" class="slide-video" data-id="{{item.id}}" bindpause="onVideoPauseOrEnded" bindended="onVideoPauseOrEnded" />
          </view>
          <view class="slide-overlay-content">
            <view class="hero-kicker" wx:if="{{item.title}}">{{item.title}}</view>
            <view class="hero-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="carousel-dots" wx:if="{{heroSlides.length > 1}}">
      <view wx:for="{{heroSlides}}" wx:key="id" class="dot-item {{index === heroCurrent ? 'active' : ''}}" />
    </view>
  </view>

  <!-- 静态降级 Hero 模式 -->
  <view class="pet-hero" wx:else>
    <view class="hero-top">
      <view class="hero-location interactive" bindtap="updateLocation">
        <view class="location-pin">📍</view>
        <view>
          <view class="location-name">{{locationName}}</view>
          <view class="location-tip" wx:if="{{locationTip}}">{{locationTip}}</view>
        </view>
        <view class="location-arrow">⌄</view>
      </view>
    </view>
    <view class="hero-kicker">高信任上门宠护</view>
    <view class="hero-title">上门喂猫 / 遛狗 / 陪伴照护</view>
    <view class="hero-subtitle">查看附近宠托师，服务轨迹和关键打卡全程可见。</view>
    <view class="hero-chip">GPS 轨迹 + 实时打卡 + 服务报告</view>
  </view>

  <!-- 核心 CTA -->
  <view class="card home-cta-card" wx:if="{{homePage.modules.quickBooking}}">
    <view class="cta-main">
      <view>
        <view class="cta-title">{{homePage.ctaTitle}}</view>
        <view class="cta-sub">{{homePage.ctaSubtitle}}</view>
      </view>
      <button class="cta-btn" data-url="/pages/client/orders/create/index" bindtap="goProtected">{{homePage.ctaText}}</button>
    </view>
  </view>

  <!-- 核心金刚区与快捷入口 -->
  <view class="hero-services-grid">
    <view class="hero-service-card pink-theme interactive" data-url="/pages/client/orders/create/index" bindtap="goProtected">
      <view class="card-text-box"><view class="service-title">上门喂猫</view><view class="service-sub">核心照护 干净卫生</view></view>
      <view class="service-emoji">🐱</view>
    </view>
    <view class="hero-service-card blue-theme interactive" data-url="/pages/client/orders/create/index" bindtap="goProtected">
      <view class="card-text-box"><view class="service-title">上门遛狗</view><view class="service-sub">科学遛狗 安全有保障</view></view>
      <view class="service-emoji">🐶</view>
    </view>
  </view>

  <view class="card nav-quick-bar">
    <view class="quick-nav-item interactive" data-url="/pages/client/sitters/list/index" bindtap="go" wx:if="{{homePage.modules.nearbySitters}}">
      <view class="nav-icon-box green"><text class="icon-emoji">📍</text></view><text class="nav-label">附近宠托师</text>
    </view>
    <view class="quick-nav-item interactive" data-url="/pages/client/sitters/apply/index" bindtap="goProtected">
      <view class="nav-icon-box pink"><text class="icon-emoji">👩‍🌾</text></view><text class="nav-label">入驻宠托师</text>
    </view>
    <view class="quick-nav-item interactive" data-url="/pages/client/coupons/list/index" bindtap="goProtected">
      <view class="nav-icon-box red"><text class="icon-emoji">🧧</text></view><text class="nav-label">优惠券</text>
    </view>
    <view class="quick-nav-item interactive" data-url="/pages/client/pets/list/index" bindtap="goProtected">
      <view class="nav-icon-box purple"><text class="icon-emoji">🐾</text></view><text class="nav-label">宠物档案</text>
    </view>
    <view class="quick-nav-item interactive" data-url="/pages/client/home-security/index" bindtap="goProtected">
      <view class="nav-icon-box orange"><text class="icon-emoji">🏠</text></view><text class="nav-label">家庭安防</text>
    </view>
  </view>

  <!-- 再次预约 -->
  <view class="card repeat-card interactive" wx:if="{{homePage.modules.repeatBooking && repeatOrder}}" data-url="/pages/client/orders/create/index" bindtap="goProtected">
    <view class="card-header between"><text class="header-title">{{homePage.repeatTitle}}</text><text class="header-more">一键复购 ›</text></view>
    <view class="repeat-row"><view class="repeat-icon">🔁</view><view><view class="strong">{{repeatOrder.petName}} · {{repeatOrder.serviceSummary}}</view><view class="muted">复用历史服务习惯，快速填写预约</view></view></view>
  </view>

  <!-- 热门服务卡 -->
  <view class="card" wx:if="{{homePage.modules.hotServices && servicePrices.length}}">
    <view class="card-header between"><text class="header-title">热门服务</text><view class="header-more" data-url="/pages/client/orders/create/index" bindtap="goProtected"><text>去下单</text><text class="arrow">›</text></view></view>
    <scroll-view scroll-x class="service-scroll">
      <view class="service-price-card interactive" wx:for="{{servicePrices}}" wx:key="key" data-url="/pages/client/orders/create/index" bindtap="goProtected">
        <view class="service-price-icon">{{item.icon}}</view>
        <view class="service-price-name">{{item.label}}</view>
        <view class="service-price-desc">{{item.description}}</view>
        <view class="service-price-text">{{item.priceText}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 新人优惠 -->
  <view class="card coupon-home-card" wx:if="{{homePage.modules.newbieCoupon && coupons.length}}">
    <view class="card-header between"><text class="header-title">{{homePage.couponTitle}}</text><view class="header-more" data-url="/pages/client/coupons/list/index" bindtap="goProtected"><text>查看</text><text class="arrow">›</text></view></view>
    <view class="coupon-grid">
      <view class="coupon-mini interactive" wx:for="{{coupons}}" wx:key="_id" data-url="/pages/client/coupons/list/index" bindtap="goProtected">
        <view class="coupon-amount">¥{{item.discountAmount}}</view>
        <view class="coupon-name">{{item.name}}</view>
        <view class="coupon-rule">{{item.ruleText}}</view>
      </view>
    </view>
  </view>

  <!-- 历史服务记录 / 数据看板 -->
  <view class="card history-stats-card" wx:if="{{homePage.modules.historyStats}}">
    <view class="card-header between">
      <text class="header-title">历史服务记录</text>
      <view class="header-more" data-url="/pages/client/sitters/list/index" bindtap="go"><text>查看更多服务记录和评价</text><text class="arrow">›</text></view>
    </view>
    <view class="stats-three-grid">
      <view class="stat-box yellow-bg"><view class="stat-icon-circle yellow">✅</view><view class="stat-num yellow-text">{{statsData.completedCount}} <text class="stat-unit">单</text></view><view class="stat-desc">已完成服务</view></view>
      <view class="stat-box pink-bg"><view class="stat-icon-circle pink">👩‍🌾</view><view class="stat-num pink-text">{{statsData.sitterCount}} <text class="stat-unit">位</text></view><view class="stat-desc">认证宠托师</view></view>
      <view class="stat-box blue-bg"><view class="stat-icon-circle blue">👥</view><view class="stat-num blue-text">{{statsData.ratingCount}} <text class="stat-unit">次</text></view><view class="stat-desc">家长好评数</view></view>
    </view>
  </view>

  <!-- 优选宠托师推荐卡片 -->
  <view class="card sitter-featured-card" wx:if="{{homePage.modules.featuredSitters && featuredSitters.length}}">
    <view class="card-header between"><text class="header-title">优选宠托师</text><view class="header-more" data-url="/pages/client/sitters/list/index" bindtap="go"><text>查看更多</text><text class="arrow">›</text></view></view>
    <scroll-view scroll-x class="sitter-scroll">
      <view class="sitter-home-card interactive" wx:for="{{featuredSitters}}" wx:key="_id" data-url="/pages/client/sitters/detail/index?id={{item._id}}" bindtap="go">
        <view class="sitter-avatar-wrapper"><view class="sitter-avatar-emoji">🐱🐶</view></view>
        <view class="sitter-name-line"><view class="sitter-name">{{item.displayName}}</view><view class="badge featured-badge" wx:if="{{item.isFeatured}}">精选</view></view>
        <view class="sitter-rating-line"><text class="stars">⭐</text><text class="score">{{item.ratingAverage || '新'}}</text><text class="divider">|</text><text class="count">{{item.reviewCount}}条评价</text></view>
        <view class="sitter-bio">{{item.serviceSummary}}</view>
        <view class="sitter-distance" wx:if="{{item.distanceText}}">📍 {{item.distanceText}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 最近完成订单 / 服务履约动态 -->
  <view class="card recent-order-card" wx:if="{{recentOrders.length}}">
    <view class="card-header between"><text class="header-title">近期完成订单</text><text class="muted">脱敏展示 · 不含位置</text></view>
    <view class="recent-order-story interactive" wx:for="{{recentOrders}}" wx:key="_id" data-url="/pages/client/orders/public-detail/index?id={{item._id}}" bindtap="go">
      <view class="recent-story-head between">
        <view><view class="strong">{{item.orderTitle}} · {{item.petName}}</view><view class="muted">{{item.startTime || item.completedAt}}</view></view>
        <view class="badge">{{item.statusText}}</view>
      </view>
      <view class="recent-service-line"><text class="service-dot"></text><text>{{item.serviceSummary}}</text></view>
      <view class="recent-people-grid">
        <view><view class="muted">宠物主</view><view class="strong">{{item.clientName}}</view></view>
        <view><view class="muted">宠托师</view><view class="strong">{{item.staffName}}</view></view>
      </view>
      <view class="recent-review-box" wx:if="{{item.review}}">
        <view class="recent-stars">★★★★★ <text>{{item.review.ratingText}}</text></view>
        <view class="muted" wx:if="{{item.review.content}}">“{{item.review.content}}”</view>
        <view class="tag-row" wx:if="{{item.review.tags.length}}"><text class="tag-pill yellow-tag" wx:for="{{item.review.tags}}" wx:key="*this">{{item}}</text></view>
      </view>
      <view class="recent-checkin-line" wx:if="{{item.checkinCount}}">打卡 {{item.checkinCount}} 次 · {{item.checkinSummary}}</view>
      <view class="recent-photo-grid" wx:if="{{item.checkinPhotos.length}}">
        <image class="recent-checkin-photo" wx:for="{{item.checkinPhotos}}" wx:key="_id" src="{{item.mediaFileId}}" mode="aspectFill" />
      </view>
      <view class="recent-more">查看脱敏订单详情 ›</view>
    </view>
  </view>

  <!-- 平台保障 -->
  <view class="card assurance-card" wx:if="{{homePage.modules.platformAssurance && assuranceItems.length}}">
    <view class="card-header"><text class="header-title">{{homePage.assuranceTitle}}</text></view>
    <view class="assurance-grid">
      <view class="assurance-item" wx:for="{{assuranceItems}}" wx:key="title"><view class="assurance-icon">{{item.icon}}</view><view class="assurance-title">{{item.title}}</view><view class="assurance-desc">{{item.desc}}</view></view>
    </view>
  </view>

  <!-- 抽奖活动/福利横幅 -->
  <view class="card interactive lottery-banner-card" wx:if="{{homePage.modules.lottery && lotteryLoaded && lotteryActivity && !lotteryFloatVisible}}" bindtap="goLottery">
    <view class="lottery-icon">🎰</view><view class="lottery-info"><view class="lottery-title">{{lotteryActivity.name}}</view><view class="lottery-sub" wx:if="{{lotteryActivity.canDraw}}">今日还有 {{lotteryActivity.remainingDrawCount}} 次抽奖机会</view><view class="lottery-sub" wx:else>每天参与一次，随机赢优惠券</view></view><view class="lottery-btn">去抽奖</view>
  </view>

</view>

<view class="lottery-float-card interactive" wx:if="{{homePage.modules.lottery && lotteryActivity && lotteryFloatVisible}}" bindtap="goLottery">
  <view class="lottery-float-glow"></view>
  <view class="lottery-icon">🎰</view>
  <view class="lottery-info"><view class="lottery-title">{{lotteryActivity.name}}</view><view class="lottery-sub" wx:if="{{lotteryActivity.remainingDrawCount !== undefined}}">今日还有 {{lotteryActivity.remainingDrawCount}} 次抽奖机会，点我开奖</view><view class="lottery-sub" wx:else>今日抽奖机会待领取，点我开奖</view></view>
  <view class="lottery-btn">立即抽</view>
</view>

<view class="bottom-nav">
  <view class="nav-item active"><view class="nav-icon">⌂</view><view>首页</view></view>
  <view class="nav-item" data-url="/pages/client/sitters/list/index" bindtap="go"><view class="nav-icon">🐾</view><view>宠托师</view></view>
  <view class="nav-item" data-url="/pages/client/orders/list/index" bindtap="goProtected"><view class="nav-icon">☷</view><view>订单</view></view>
  <view class="nav-item" data-url="/pages/client/profile/index" bindtap="go"><view class="nav-icon">♙</view><view>我的</view></view>
</view>
