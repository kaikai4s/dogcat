<view class="message-thread-page {{themeClass}} {{fontClass}} page" wx:if="{{thread}}">
  <view class="thread-hero">
    <view class="hero-badge"><text class="remix-icon ri-chat-3-fill hero-icon"></text><text>订单消息</text></view>
    <view class="hero-title">{{thread.orderTitle || '订单消息'}}</view>
    <view class="hero-desc">订单 {{thread.orderNo || thread.orderId}}</view>
  </view>

  <view class="chat-list">
    <view class="chat-row" wx:for="{{messages}}" wx:key="_id">
      <view class="chat-avatar"><text class="remix-icon ri-notification-3-line"></text></view>
      <view class="chat-content">
        <view class="chat-time">{{item.createdAtText}}</view>
        <view class="chat-bubble">
          <view class="chat-title">{{item.title}}</view>
          <view class="chat-detail" wx:if="{{item.detail}}">{{item.detail}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="chat-input-placeholder">
    <view class="readonly-tip"><text class="remix-icon ri-information-line"></text><text>此处仅展示订单系统消息，暂不支持发送消息</text></view>
    <button class="primary-btn" bindtap="viewOrder"><text class="remix-icon ri-file-list-3-line"></text><text>查看订单详情</text></button>
  </view>
</view>

<view class="message-thread-page {{themeClass}} {{fontClass}} page" wx:else>
  <view class="empty-state">
    <text class="remix-icon ri-chat-3-line empty-icon"></text>
    <view class="empty-title">{{loading ? '正在加载消息...' : '消息会话不存在'}}</view>
  </view>
</view>
