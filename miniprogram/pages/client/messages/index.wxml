<view class="messages-page {{themeClass}} {{fontClass}} page">
  <navigator class="subscription-entry" url="/pages/common/subscriptions/index?role=client">
    <view class="subscription-entry-icon"><text class="remix-icon ri-notification-3-line"></text></view>
    <view class="subscription-entry-copy"><view class="subscription-entry-title">订阅消息通知</view><view class="subscription-entry-desc">及时接收接单、服务进度等提醒</view></view>
    <view class="subscription-entry-action">去开启 <text class="remix-icon ri-arrow-right-s-line"></text></view>
  </navigator>
  <view class="messages-hero">
    <view class="hero-badge"><text class="remix-icon ri-message-3-fill hero-icon"></text><text>消息中心</text></view>
    <view class="hero-title">{{activeTab === 'order' ? '订单消息' : '系统通知'}}</view>
    <view class="hero-desc">{{activeTab === 'order' ? '订单支付、接单、服务进度等提醒集中展示在这里。' : '平台公告、升级通知、活动福利与重要提醒。'}}</view>
  </view>

  <!-- 消息分类 Tabs 切换 -->
  <view class="messages-tabs-bar">
    <view class="tab-item {{activeTab === 'order' ? 'active' : ''}}" data-tab="order" bindtap="switchTab">
      <text class="tab-text">订单消息</text>
      <view class="tab-badge" wx:if="{{orderHasUnread}}">{{orderUnreadCountText}}</view>
    </view>
    <view class="tab-item {{activeTab === 'system' ? 'active' : ''}}" data-tab="system" bindtap="switchTab">
      <text class="tab-text">系统通知</text>
      <view class="tab-badge" wx:if="{{systemHasUnread}}">{{systemUnreadCountText}}</view>
    </view>
  </view>

  <!-- 订单消息列表 -->
  <block wx:if="{{activeTab === 'order'}}">
    <view class="card message-card interactive" wx:for="{{threads}}" wx:key="_id" data-id="{{item._id}}" data-order-id="{{item.orderId}}" bindtap="openThread" bindlongpress="onThreadLongPress">
      <view class="message-icon">
        <view class="remix-icon ri-notification-3-fill msg-icon-inner"></view>
        <view class="message-card-dot" wx:if="{{item.showUnreadDot}}"></view>
        <view class="message-card-count" wx:elif="{{item.unreadCount > 1}}">{{item.unreadCountText}}</view>
      </view>
      <view class="message-main">
        <view class="message-title-row">
          <view class="message-title">{{item.titleText}}</view>
          <view class="message-time">{{item.lastMessageAtText}}</view>
        </view>
        <view class="message-preview">{{item.lastMessageTitle || '订单消息'}}<text wx:if="{{item.lastMessageDetail}}"> · {{item.lastMessageDetail}}</text></view>
        <view class="message-meta">
          <view class="status-badge {{item.orderStatusClass}}">{{item.orderStatusText || '处理中'}}</view>
          <view class="order-meta"><text class="remix-icon ri-file-list-3-line"></text><text>订单 {{item.orderNo || item.orderId}}</text></view>
        </view>
      </view>
      <view class="message-card-side">
        <view class="message-delete-action" data-id="{{item._id}}" catchtap="deleteThread" hover-class="delete-hover" title="删除">
          <text class="remix-icon ri-delete-bin-line"></text>
        </view>
      </view>
    </view>

    <view class="list-tip" wx:if="{{loading && threads.length}}">正在加载更多...</view>
    <view class="list-tip" wx:if="{{!loading && threads.length && !hasMore}}">已显示全部消息</view>

    <view class="empty-state" wx:if="{{!loading && !threads.length}}">
      <text class="remix-icon ri-chat-3-line empty-icon"></text>
      <view class="empty-title">暂无订单消息</view>
      <view class="empty-desc">预约、支付和服务进度更新会显示在这里。</view>
      <navigator class="primary-btn" url="/pages/client/orders/create/index"><text class="remix-icon ri-calendar-check-line"></text><text>去预约</text></navigator>
    </view>
  </block>

  <!-- 系统通知列表 -->
  <block wx:if="{{activeTab === 'system'}}">
    <view class="notices-toolbar" wx:if="{{systemNotices.length > 0}}">
      <view class="notices-count">系统公告与提醒 (共{{systemTotal || systemNotices.length}}条)</view>
      <view class="read-all-btn" wx:if="{{systemHasUnread}}" bindtap="markAllSystemRead">
        <text class="remix-icon ri-check-double-line"></text>
        <text>全部标为已读</text>
      </view>
    </view>
    <view class="card notice-card interactive {{item.isRead ? 'notice-read' : 'notice-unread'}}" wx:for="{{systemNotices}}" wx:key="_id" data-id="{{item._id}}" bindtap="tapNotice">
      <view class="notice-top">
        <view class="notice-tags">
          <view class="notice-type-tag type-{{item.type || 'system'}}">{{item.typeText || '系统通知'}}</view>
          <view class="notice-urgent-tag" wx:if="{{item.level === 'urgent'}}">重要</view>
          <view class="notice-unread-dot" wx:if="{{!item.isRead}}"></view>
        </view>
        <view class="notice-time">{{item.createdAtText}}</view>
      </view>
      <view class="notice-title-row">
        <view class="notice-title">{{item.title}}</view>
      </view>
      <view class="notice-content-preview">{{item.content}}</view>
      <view class="notice-footer" wx:if="{{item.targetUrl}}">
        <text class="notice-link-text">查看详情</text>
        <text class="remix-icon ri-arrow-right-s-line"></text>
      </view>
    </view>

    <view class="list-tip" wx:if="{{systemLoading && systemNotices.length}}">正在加载更多通知...</view>
    <view class="list-tip" wx:if="{{!systemLoading && systemNotices.length && !systemHasMore}}">已显示全部通知</view>

    <view class="empty-state" wx:if="{{!systemLoading && !systemNotices.length}}">
      <text class="remix-icon ri-notification-badge-line empty-icon"></text>
      <view class="empty-title">暂无系统通知</view>
      <view class="empty-desc">平台公告、福利活动与更新通知会在这里显示。</view>
    </view>
  </block>

  <!-- 系统通知详情弹窗 -->
  <view class="modal-mask" wx:if="{{showNoticeModal}}" catchtap="closeNoticeModal">
    <view class="notice-modal-dialog" catchtap="true">
      <view class="modal-header">
        <view class="modal-tags">
          <view class="notice-type-tag type-{{selectedNotice.type || 'system'}}">{{selectedNotice.typeText || '系统通知'}}</view>
          <view class="notice-urgent-tag" wx:if="{{selectedNotice.level === 'urgent'}}">重要</view>
        </view>
        <view class="modal-close" catchtap="closeNoticeModal"><text class="remix-icon ri-close-line"></text></view>
      </view>
      <view class="modal-title">{{selectedNotice.title}}</view>
      <view class="modal-time"><text class="remix-icon ri-time-line"></text><text>{{selectedNotice.createdAtText}}</text></view>
      <scroll-view scroll-y class="modal-body">
        <text class="modal-content-text">{{selectedNotice.content}}</text>
      </scroll-view>
      <view class="modal-actions">
        <button class="modal-primary-btn" wx:if="{{selectedNotice.targetUrl}}" bindtap="handleNoticeAction">前往查看</button>
        <button class="modal-dismiss-btn" bindtap="closeNoticeModal">我知道了</button>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" data-url="/pages/client/home/index" bindtap="go"><view class="nav-icon remix-icon ri-home-5-line"></view><view>首页</view></view>
    <view class="nav-item" data-url="/pages/client/sitters/list/index" bindtap="go"><view class="nav-icon remix-icon ri-team-line"></view><view>宠托师</view></view>
    <view class="nav-item" data-url="/pages/client/orders/list/index" bindtap="go"><view class="nav-icon remix-icon ri-file-list-3-line"></view><view>订单</view></view>
    <view class="nav-item active"><view class="nav-icon remix-icon ri-message-3-fill"><view class="nav-unread-count" wx:if="{{messageUnreadCount > 0}}">{{messageUnreadCountText}}</view></view><view>消息</view></view>
    <view class="nav-item" data-url="/pages/client/profile/index" bindtap="go"><view class="nav-icon remix-icon ri-user-3-line"></view><view>我的</view></view>
  </view>
</view>
<global-loading />
