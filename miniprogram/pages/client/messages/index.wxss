/* Client messages - Cute Pet Style UI redesign */
.messages-page {
  min-height: 100vh;
  padding: 0 28rpx 180rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.messages-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon { font-size: 28rpx; }

.hero-title {
  color: #2d211a;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.card {
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
  border-radius: 36rpx;
}

.message-card {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding: 26rpx;
  margin-top: 18rpx;
}

.message-icon {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff0e2;
  color: #e9672f;
  flex-shrink: 0;
}

.msg-icon-inner {
  font-size: 44rpx;
  color: #ff7a45;
  background: transparent !important;
  border: none !important;
}

.message-card-dot,
.nav-red-dot {
  position: absolute;
  right: -4rpx;
  top: -4rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ef4444;
  border: 4rpx solid #fff;
}

.message-card-count,
.nav-unread-count {
  position: absolute;
  right: -12rpx;
  top: -10rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  border: 4rpx solid #ffffff;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 30rpx;
  text-align: center;
  box-sizing: content-box;
}

.nav-unread-count {
  right: -18rpx;
  top: -12rpx;
  min-width: 26rpx;
  height: 26rpx;
  font-size: 16rpx;
  line-height: 26rpx;
}

.message-main {
  flex: 1;
  min-width: 0;
}

.message-title-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.message-title {
  flex: 1;
  min-width: 0;
  color: #2d211a;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 1.35;
}

.message-time {
  flex-shrink: 0;
  color: #a89b90;
  font-size: 23rpx;
  line-height: 1.35;
}

.message-preview {
  margin-top: 10rpx;
  color: #7a6a5e;
  font-size: 25rpx;
  line-height: 1.5;
}

.message-meta {
  margin-top: 14rpx;
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1;
}

.status-badge.default {
  background: #ffebe6;
  color: #e9672f;
}

.status-badge.warning {
  background: #fff0d9;
  color: #d45f22;
}

.status-badge.blue {
  background: #eaf3ff;
  color: #2563eb;
}

.status-badge.purple {
  background: #f3e8ff;
  color: #7e22ce;
}

.status-badge.green {
  background: #e6f8ea;
  color: #00b42a;
}

.status-badge.red {
  background: #fff1f2;
  color: #be123c;
}

.status-badge.gray {
  background: #f0eae5;
  color: #8e8580;
}

.order-meta {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: #8e8580;
  font-size: 23rpx;
}

.order-meta .remix-icon {
  color: #e9672f;
  font-size: 25rpx;
}

.list-tip {
  text-align: center;
  padding: 26rpx 0;
  color: #8e8580;
  font-size: 24rpx;
}

.empty-state {
  min-height: 440rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 44rpx;
  margin-top: 24rpx;
}

.empty-icon {
  color: #e9672f;
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
}

.empty-desc {
  margin-top: 10rpx;
  color: #8e8580;
  font-size: 24rpx;
  line-height: 1.45;
}

.primary-btn {
  margin-top: 24rpx;
  min-height: 74rpx;
  padding: 0 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.primary-btn .remix-icon { font-size: 28rpx; }

.bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 14rpx 10rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 16rpx 38rpx rgba(123, 89, 62, 0.12);
  backdrop-filter: blur(16rpx);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  color: #8e8580;
  font-size: 20rpx;
  font-weight: 800;
}

.nav-item.active {
  color: #e9672f;
}

.nav-icon {
  position: relative;
  font-size: 42rpx;
  line-height: 1;
}
