.pet-beauty-page {
  min-height: 100vh;
  padding: 0 28rpx 140rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
}

/* 微信小程序 button 默认样式重置 */
button.vote-btn,
button.primary-btn,
button.ghost-btn,
button.small-vote-btn,
button.search-btn,
button.load-more {
  margin: 0 !important;
  padding: 0;
  width: auto !important;
  font-weight: normal;
  line-height: 1.4;
  box-sizing: border-box;
  position: static;
}

button.vote-btn::after,
button.primary-btn::after,
button.ghost-btn::after,
button.small-vote-btn::after,
button.search-btn::after,
button.load-more::after {
  display: none;
}

.beauty-hero {
  margin: 0 -28rpx 24rpx;
  padding: 44rpx 34rpx 40rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.88);
  font-size: 24rpx;
  font-weight: 900;
}

.hero-badge .remix-icon {
  font-size: 28rpx;
  color: #ff4d4f;
}

.hero-title {
  margin-top: 18rpx;
  color: #2d211a;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 25rpx;
  line-height: 1.45;
}

.hero-state {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.section-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.section-title {
  color: #2d211a;
  font-size: 34rpx;
  font-weight: 950;
}

.section-desc {
  margin-top: 6rpx;
  color: #8e8580;
  font-size: 24rpx;
}

.section-icon {
  color: #ff7a45;
  font-size: 44rpx;
}

.month-picker-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: #fff0e2;
  font-size: 24rpx;
  font-weight: 900;
  border: 1rpx solid rgba(255, 153, 102, 0.2);
  white-space: nowrap;
}

.month-picker-btn .remix-icon {
  font-size: 26rpx;
}

.photo-wall {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.pet-card {
  overflow: hidden;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #fffaf4 0%, #ffffff 100%);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 8rpx 22rpx rgba(123, 89, 62, 0.04);
}

.pet-cover-wrapper {
  width: 100%;
  height: 240rpx;
  background: #fff0e2;
  overflow: hidden;
}

.pet-cover-wrapper.single .pet-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-cover-wrapper.grid-4 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 4rpx;
}

.pet-cover-wrapper.grid-9 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 4rpx;
}

.grid-img {
  width: 100%;
  height: 100%;
  display: block;
}

.pet-info {
  padding: 20rpx;
}

.pet-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
  overflow: hidden;
}

.pet-name {
  color: #2d211a;
  font-size: 29rpx;
  font-weight: 950;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
  min-width: 0;
}

.pet-title {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  color: #b45309;
  background: #fff7d6;
  font-size: 19rpx;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

.pet-info .pet-title {
  margin-top: 0;
}

.pet-title .remix-icon {
  font-size: 22rpx;
  color: #f59e0b;
}

.pet-meta {
  margin-top: 10rpx;
  color: #8e8580;
  font-size: 23rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.vote-btn {
  width: 100% !important;
  min-height: 66rpx;
  height: 66rpx;
  margin: 18rpx 0 0 !important;
  border: none;
  border-radius: 22rpx;
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-size: 25rpx;
  font-weight: 900;
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 69, 0.2);
}

.vote-btn[disabled] {
  opacity: 0.62;
  box-shadow: none;
}

.search-box-wrapper {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
  width: 100%;
}

.search-field {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  border-radius: 26rpx;
  background: #fff8ec;
  border: 1rpx solid rgba(255, 153, 102, 0.16);
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
}

.search-field .remix-icon {
  color: #e9672f;
  font-size: 32rpx;
  flex-shrink: 0;
}

.search-field .clear-icon {
  color: #c4b5fd;
  font-size: 32rpx;
  flex-shrink: 0;
}

.search-field input {
  flex: 1;
  min-width: 0;
  height: 100%;
  font-size: 26rpx;
  color: #2d211a;
  background: transparent;
  border: none;
}

.search-btn {
  height: 80rpx !important;
  line-height: 80rpx !important;
  padding: 0 32rpx !important;
  border-radius: 26rpx;
  font-size: 26rpx;
  white-space: nowrap;
  flex-shrink: 0;
  display: flex !important;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  box-shadow: 0 6rpx 18rpx rgba(255, 122, 69, 0.2);
}

.ghost-btn {
  color: #d45f22;
  background: #fff0e2;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 28rpx;
  background: #fffdfa;
  border: 1rpx solid rgba(255, 153, 102, 0.1);
  box-shadow: 0 4rpx 14rpx rgba(123, 89, 62, 0.03);
  box-sizing: border-box;
}

.rank-item.top-three {
  background: linear-gradient(135deg, #fffaf0 0%, #ffffff 100%);
  border: 1rpx solid rgba(255, 184, 108, 0.3);
}

.rank-item.rank-1 {
  background: linear-gradient(135deg, #fff4e5 0%, #fffdf8 100%);
  border-color: #ffd09b;
}

.rank-badge-box {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.crown-icon {
  position: absolute;
  top: -12rpx;
  font-size: 32rpx;
}

.rank-1 .crown-icon { color: #ffb020; }
.rank-2 .crown-icon { color: #94a3b8; }
.rank-3 .crown-icon { color: #d97706; }

.rank-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7a6a5e;
  background: #fff0e2;
  font-size: 26rpx;
  font-weight: 950;
}

.top-three .rank-no {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
}

.rank-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #fff0e2;
  flex-shrink: 0;
}

.rank-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.rank-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
}

.rank-name {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 950;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 220rpx;
}

.rank-meta {
  color: #8e8580;
  font-size: 23rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rank-meta .dot {
  color: #d4c5b9;
}

.exclusive-tag {
  color: #b45309;
  background: #fff7d6;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 850;
}

.rank-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.rank-votes {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  color: #ff7a45;
}

.rank-votes .remix-icon {
  font-size: 26rpx;
}

.vote-num {
  font-size: 32rpx;
  font-weight: 950;
  line-height: 1;
}

.vote-unit {
  font-size: 22rpx;
  color: #8e8580;
}

.small-vote-btn {
  min-height: 52rpx !important;
  height: 52rpx !important;
  line-height: 52rpx !important;
  padding: 0 20rpx !important;
  border-radius: 16rpx;
  border: none;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.small-vote-btn[disabled] {
  background: #fff0e2;
  color: #a89b90;
  opacity: 0.8;
}

.empty-state {
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #8e8580;
  font-size: 25rpx;
  text-align: center;
}

.empty-icon {
  color: #e9672f;
  font-size: 88rpx;
}

.load-more {
  width: 100% !important;
  margin-top: 24rpx !important;
  min-height: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  display: flex !important;
  align-items: center;
  justify-content: center;
}

/* View preference applies to the same ranking, search and voting state. */
.rank-view-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 24rpx 0;
}

.rank-view-caption { color: #7a6a5e; font-size: 24rpx; }
.rank-view-switch { display: flex; padding: 6rpx; border-radius: 22rpx; background: #efe9e2; }
button.rank-view-option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0;
  padding: 0 20rpx;
  min-height: 64rpx;
  border: 0;
  border-radius: 18rpx;
  background: transparent;
  color: #8e8580;
  font-size: 24rpx;
  line-height: 1.3;
}
button.rank-view-option.is-active { color: #b85b2c; background: #fff; font-weight: 800; box-shadow: 0 4rpx 12rpx rgba(83, 60, 44, .07); }
.rank-view-option::after,
.gallery-vote-btn::after { border: none; }
.view-waterfall .beauty-hero { padding-bottom: 28rpx; }
.view-waterfall .ranking-card { padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.ranking-card .section-head { flex-wrap: wrap; }
.rank-waterfall { display: flex; align-items: flex-start; gap: 20rpx; }
.rank-column { flex: 1; min-width: 0; position: relative; z-index: 1; }
.gallery-card { margin-bottom: 24rpx; overflow: visible; border-radius: 28rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(77, 57, 43, .06); position: relative; z-index: 1; }
.gallery-cover { position: relative; height: 440rpx; min-height: 440rpx; max-height: 440rpx; overflow: visible; background: transparent; border-top-left-radius: 28rpx; border-top-right-radius: 28rpx; touch-action: pan-y; }
.gallery-image { display: block; width: 100%; height: 100%; object-fit: cover; }
.gallery-placeholder { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 28rpx 28rpx 0 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16rpx; color: #ad9989; font-size: 23rpx; background: #f1e9df; }
.gallery-placeholder .remix-icon { font-size: 66rpx; }
.gallery-photo-count { position: absolute; top: 16rpx; right: 16rpx; display: flex; align-items: center; gap: 6rpx; padding: 6rpx 12rpx; border-radius: 999rpx; color: #fff; background: rgba(30, 26, 22, .45); font-size: 20rpx; }
.gallery-rank { position: absolute; left: 14rpx; right: 14rpx; bottom: 14rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; min-height: 48rpx; padding: 8rpx; border-radius: 14rpx; color: #fff; background: rgba(30, 26, 22, .72); font-size: 22rpx; font-weight: 800; z-index: 12; }
.gallery-rank-top .remix-icon { color: #ffdb8f; }
.gallery-body { padding: 20rpx; background: #fff; border-bottom-left-radius: 28rpx; border-bottom-right-radius: 28rpx; position: relative; z-index: 3; }
.gallery-name { color: #30271f; font-size: 30rpx; font-weight: 900; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gallery-meta { margin-top: 8rpx; color: #8e8580; font-size: 23rpx; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gallery-id { margin-top: 6rpx; color: #a3978c; font-size: 20rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gallery-title { display: flex; align-items: center; gap: 6rpx; width: fit-content; max-width: 100%; margin-top: 14rpx; padding: 6rpx 12rpx; border-radius: 10rpx; background: #fff6e5; color: #a57529; font-size: 20rpx; }
.gallery-title .remix-icon { flex-shrink: 0; }
.gallery-title text:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.gallery-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: nowrap;
  gap: 8rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f0ea;
  box-sizing: border-box;
  width: 100%;
}
.gallery-votes {
  position: relative;
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
  color: #ff2d55;
  white-space: nowrap;
  overflow: visible;
}
.gallery-votes .remix-icon {
  font-size: 26rpx;
  flex-shrink: 0;
  color: #ff2d55 !important;
  text-shadow: 0 2rpx 8rpx rgba(255, 45, 85, 0.28);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.3s ease;
}
.gallery-vote-number {
  font-size: 28rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #30271f;
  display: inline-block;
}
.gallery-vote-label { color: #a3978c; font-size: 20rpx; flex-shrink: 0; }

.vote-action-box {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

button.gallery-vote-btn {
  width: auto !important;
  max-width: 140rpx !important;
  min-width: 100rpx !important;
  flex-shrink: 0;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  min-height: 52rpx !important;
  height: 52rpx !important;
  line-height: 52rpx !important;
  margin: 0 !important;
  padding: 0 16rpx !important;
  border: none;
  border-radius: 16rpx;
  color: #b45b30;
  background: #fff0e2;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
  box-sizing: border-box;
}
button.gallery-vote-btn[disabled] { color: #a89b90; background: #f4f1ed; opacity: 0.85; }

/* ==================== 多图可拖拽卡片堆叠 (Draggable Card Stack) ==================== */
.gallery-cover.has-stack {
  height: 440rpx;
  min-height: 440rpx;
  max-height: 440rpx;
  overflow: visible !important;
  background: transparent !important;
  touch-action: pan-y;
  position: relative;
}

.card-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  box-sizing: border-box;
  transform-origin: 50% 80%;
  backface-visibility: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  background: #ffffff;
}

.card-layer image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  pointer-events: none;
  user-select: none;
}

/* 顶层主卡片 (手势跟手拖拽、位移比例旋转、快速甩出) */
.card-layer-top,
.card-role-top {
  z-index: 10;
  transform: translate3d(0, 0, 0) rotate(0deg);
  opacity: 1;
  box-shadow: 0 16rpx 36rpx rgba(45, 33, 26, 0.12), 0 4rpx 10rpx rgba(45, 33, 26, 0.05);
  touch-action: pan-y;
  pointer-events: auto;
}

/* 中间卡片 (下一张平滑缩放补位，随时准备顶上) */
.card-layer-next,
.card-role-next {
  z-index: 5;
  transform: scale(0.88) translateY(14rpx);
  opacity: 0.88;
  box-shadow: 0 10rpx 24rpx rgba(45, 33, 26, 0.08);
  pointer-events: none;
}

/* 底部卡片 (深度背景层) */
.card-layer-bottom,
.card-role-bottom {
  z-index: 2;
  transform: scale(0.80) translateY(26rpx);
  opacity: 0.60;
  box-shadow: 0 6rpx 16rpx rgba(45, 33, 26, 0.04);
  pointer-events: none;
}

/* 隐藏深层卡片 (超过3张时的缓冲卡片) */
.card-role-hidden {
  z-index: 1;
  transform: scale(0.75) translateY(32rpx);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.gallery-image.single-image {
  width: 100%;
  height: 440rpx;
  object-fit: cover;
  display: block;
}

/* 照片角标 (圆角黑色胶囊风格，参考效果图 TODAY 标签) */
.stack-badge-count {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 15;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: rgba(30, 26, 22, 0.75);
  backdrop-filter: blur(8px);
  font-size: 20rpx;
  font-weight: 850;
  letter-spacing: 1rpx;
}

/* 点状指示器 */
.stack-dots {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  z-index: 15;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(30, 26, 22, 0.45);
  backdrop-filter: blur(6px);
}

.stack-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  transition: all 0.25s ease;
}

.stack-dot.active {
  width: 18rpx;
  border-radius: 999rpx;
  background: #ff8c42;
}

/* ==================== 宠物大图卡片堆叠沉浸式浮层 (Preview Modal) ==================== */
.pet-stack-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(18, 14, 11, 0.88);
  backdrop-filter: blur(12px);
  animation: modal-fade-in 0.25s ease-out;
}

.modal-content {
  position: relative;
  z-index: 10;
  width: 650rpx;
  max-width: 90vw;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: modal-pop-up 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.1);
}

@keyframes modal-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes modal-pop-up {
  from { opacity: 0; transform: scale(0.92) translateY(30rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.modal-header {
  width: 100%;
