  width: 100%;
  height: 100%;
  border-radius: inherit;
  z-index: 1;
  pointer-events: none;
}

.grid-img,
.pet-cover {
  opacity: 0;
  transition: opacity 0.3s ease;
}

.grid-img.is-loaded,
.pet-cover.is-loaded {
  opacity: 1;
}

