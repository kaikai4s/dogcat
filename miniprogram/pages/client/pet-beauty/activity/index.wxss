  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
}

.modal-card-stage {
  position: relative;
  width: 620rpx;
  height: 760rpx;
  border-radius: 36rpx;
  perspective: 1200px;
  touch-action: pan-y;
}

.modal-card-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 36rpx;
  overflow: hidden;
  transform-origin: 50% 100%;
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.35);
  background: #2b221b;
}

.modal-card-layer image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  pointer-events: none;
}

.modal-card-top,
.modal-card-layer.card-role-top {
  z-index: 10;
  transform: translate3d(0, 0, 0) rotate(0deg);
  opacity: 1;
  pointer-events: auto;
}

.modal-card-next,
.modal-card-layer.card-role-next {
  z-index: 5;
  transform: scale(0.92) translateY(18rpx);
  opacity: 0.88;
  filter: brightness(0.95);
  pointer-events: none;
}

.modal-card-bottom,
.modal-card-layer.card-role-bottom {
  z-index: 2;
  transform: scale(0.85) translateY(32rpx);
  opacity: 0.6;
  filter: brightness(0.9);
  pointer-events: none;
}

.modal-card-layer.card-role-hidden {
  z-index: 1;
  transform: scale(0.80) translateY(40rpx);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

