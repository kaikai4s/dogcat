<wxs module="cardDrag" src="./card-stack.wxs" />
<view class="page pet-beauty-page view-{{rankView}} {{themeClass}}">
  <view class="beauty-hero">
    <view class="hero-badge"><text class="remix-icon ri-heart-3-fill"></text><text>最美宠物活动</text></view>
    <view class="hero-title">{{monthKey}} 最美爱宠榜</view>
    <view class="hero-desc">上传宠物美照参与月榜，每天可以为喜欢的毛孩子投一票。</view>
    <view class="hero-state">{{locked ? '本月榜单已锁定' : (hasVotedToday ? '今日已投票' : '今日还可投票')}}</view>
  </view>

  <view class="rank-view-toolbar">
    <view class="rank-view-caption">发现每一份可爱</view>
    <view class="rank-view-switch">
      <button class="rank-view-option {{rankView === 'waterfall' ? 'is-active' : ''}}" data-view="waterfall" bindtap="switchRankView" aria-label="大图瀑布流" aria-pressed="{{rankView === 'waterfall'}}"><text class="remix-icon ri-layout-grid-line"></text><text>大图</text></button>
      <button class="rank-view-option {{rankView === 'list' ? 'is-active' : ''}}" data-view="list" bindtap="switchRankView" aria-label="经典排行" aria-pressed="{{rankView === 'list'}}"><text class="remix-icon ri-list-ordered"></text><text>经典排行</text></button>
    </view>
  </view>

  <view class="section-card" wx:if="{{rankView === 'list'}}">
    <view class="section-head">
      <view><view class="section-title">美照墙</view><view class="section-desc">点击卡片查看宠物全部美照</view></view>
      <text class="remix-icon ri-image-fill section-icon"></text>
    </view>
    <view class="photo-wall" wx:if="{{candidates.length}}">
      <view class="pet-card" wx:for="{{candidates}}" wx:for-index="idx" wx:key="petId" data-id="{{item.petId}}" bindtap="previewPet" wx:if="{{idx < 4}}">
        <view class="pet-cover-wrapper {{item.beautyPhotos.length > 1 ? 'grid-' + (item.beautyPhotos.length > 4 ? 9 : 4) : 'single'}}">
          <block wx:if="{{item.beautyPhotos.length > 1}}">
            <image class="grid-img" wx:for="{{item.beautyPhotos}}" wx:for-item="img" wx:key="id" src="{{img.fileId}}" mode="aspectFill" />
          </block>
          <image class="pet-cover" wx:else src="{{item.avatarFileId || item.beautyPhotos[0].fileId}}" mode="aspectFill" />
        </view>
        <view class="pet-info">
          <view class="pet-name-row">
            <text class="pet-name">{{item.name}}</text>
            <view class="pet-title" wx:if="{{item.beautyTitle && item.beautyTitle.title}}">
              <text class="remix-icon ri-vip-crown-fill"></text>
              <text>{{item.beautyTitle.title}}</text>
            </view>
          </view>
          <view class="pet-meta">{{item.ageText}} · {{item.speciesText}}</view>
          <button class="vote-btn" catchtap="vote" data-id="{{item.petId}}" loading="{{votingPetId === item.petId}}" disabled="{{locked || hasVotedToday || votingPetId === item.petId}}"><text class="remix-icon {{votedPetId === item.petId ? 'ri-thumb-up-fill' : 'ri-thumb-up-line'}}"></text><text>{{item.voteCount}}票</text></button>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <text class="remix-icon ri-image-add-line empty-icon"></text>
      <view>暂无宠物美照，先去宠物档案上传吧</view>
    </view>
  </view>

  <view class="section-card ranking-card">
    <view class="section-head">
      <view>
        <view class="section-title">月度星耀榜</view>
        <view class="section-desc">{{isHistory ? '往期封榜Top100历史纪录' : '前100名将在月底锁定并颁发专属月榜称号'}}</view>
      </view>
      <picker range="{{monthOptions}}" range-key="label" value="{{selectedMonthIndex}}" bindchange="onMonthChange" wx:if="{{monthOptions.length > 1}}">
        <view class="month-picker-btn">
          <text class="remix-icon ri-calendar-event-line"></text>
          <text>{{monthOptions[selectedMonthIndex].label}}</text>
          <text class="remix-icon ri-arrow-down-s-line"></text>
        </view>
      </picker>
      <text class="remix-icon ri-trophy-fill section-icon" wx:else></text>
    </view>
    <view class="search-box-wrapper">
      <view class="search-field">
        <text class="remix-icon ri-search-2-line"></text>
        <input placeholder="搜索宠物名字或专属ID (如 P8K3...)" value="{{keyword}}" bindinput="inputKeyword" bindconfirm="submitSearch" confirm-type="search" />
        <text class="remix-icon ri-close-circle-fill clear-icon" wx:if="{{keyword}}" bindtap="clearSearch"></text>
      </view>
      <button class="primary-btn search-btn" bindtap="submitSearch">搜索</button>
    </view>

    <view class="rank-waterfall" wx:if="{{ranking.length && rankView === 'waterfall'}}">
      <view class="rank-column" wx:for="{{rankColumns}}" wx:for-item="column" wx:key="id">
        <view class="gallery-card" wx:for="{{column.pets}}" wx:key="petId">
          <!-- 封面卡片堆叠区域 -->
          <view class="gallery-cover {{item.hasMultiplePhotos ? 'has-stack' : ''}}" 
                data-id="{{item.petId}}"
                bindtap="previewPet">
            
            <!-- 多图可拖拽卡片堆叠 (每张照片拥有独立持久节点，底层无缝顶上，杜绝重载与闪烁) -->
            <block wx:if="{{item.hasMultiplePhotos}}">
              <view wx:for="{{item.stackCards}}"
                    wx:for-item="card"
                    wx:key="photoIndex"
                    id="card-{{item.petId}}-{{card.photoIndex}}"
                    class="card-layer card-role-{{card.role}}"
                    style="z-index: {{card.zIndex}};"
                    data-petid="{{item.petId}}"
                    data-photocount="{{item.photoCount}}"
                    data-photoindex="{{card.photoIndex}}"
                    data-role="{{card.role}}"
                    prop="{{item.activePhotoIndex}}"
                    change:prop="{{cardDrag.onActiveIndexChange}}"
                    bindtouchstart="{{cardDrag.touchstart}}"
                    bindtouchmove="{{cardDrag.touchmove}}"
                    bindtouchend="{{cardDrag.touchend}}"
                    bindtouchcancel="{{cardDrag.touchcancel}}">
                <image src="{{card.photoUrl}}" mode="aspectFill" />
              </view>

              <!-- 点状进度指示器 -->
              <view class="stack-dots" wx:if="{{item.photoCount <= 6}}">
                <view class="stack-dot {{dot.active ? 'active' : ''}}" wx:for="{{item.dots}}" wx:for-item="dot" wx:key="index"></view>
              </view>

              <!-- 照片张数角标 -->
              <view class="stack-badge-count">
                <text class="remix-icon ri-image-line"></text>
                <text>{{item.displayPhotoIndex}}/{{item.photoCount}}</text>
              </view>
            </block>

            <!-- 单图普通展示 -->
            <block wx:else>
              <image wx:if="{{item.topPhotoUrl || item.coverUrl}}" class="gallery-image" src="{{item.topPhotoUrl || item.coverUrl}}" mode="aspectFill" lazy-load />
              <view class="gallery-placeholder" wx:else>
                <text class="remix-icon ri-image-line"></text>
                <text>美照待更新</text>
              </view>
            </block>

            <!-- 排名角标 -->
            <view class="gallery-rank {{item.displayRank <= 3 ? 'gallery-rank-top' : ''}}">
              <text class="remix-icon ri-vip-crown-fill" wx:if="{{item.displayRank <= 3}}"></text>
              <text>{{isHistory ? '历史月榜' : '本月人气'}} · 第{{item.displayRank}}名</text>
            </view>
          </view>

          <!-- 卡片信息区域 -->
          <view class="gallery-body" data-id="{{item.petId}}" bindtap="previewPet">
            <view class="gallery-name">{{item.name}}</view>
            <view class="gallery-meta">{{item.ageText || '年龄未填写'}} · {{item.speciesText || '毛孩子'}}</view>
            <view class="gallery-id" wx:if="{{item.exclusiveId}}">ID · {{item.exclusiveId}}</view>
            <view class="gallery-title" wx:if="{{item.beautyTitle && item.beautyTitle.title}}"><text class="remix-icon ri-medal-line"></text><text>{{item.beautyTitle.title}}</text></view>
            <view class="gallery-footer">
              <view class="gallery-votes"><text class="remix-icon ri-heart-3-fill"></text><text class="gallery-vote-number">{{item.voteCount}}</text><text class="gallery-vote-label">票</text></view>
              <button class="gallery-vote-btn" catchtap="vote" data-id="{{item.petId}}" loading="{{votingPetId === item.petId}}" disabled="{{locked || isHistory || hasVotedToday || votingPetId}}">{{isHistory || locked ? '已封榜' : (votedPetId === item.petId ? '已投票' : '投一票')}}</button>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="rank-list" wx:elif="{{ranking.length}}">
      <view class="rank-item {{(item.rank || index + 1) <= 3 ? 'top-three rank-' + (item.rank || index + 1) : ''}}" wx:for="{{ranking}}" wx:key="petId" data-id="{{item.petId}}" bindtap="previewPet">
        <view class="rank-badge-box">
          <text class="remix-icon ri-vip-crown-fill crown-icon" wx:if="{{(item.rank || index + 1) === 1}}"></text>
          <text class="remix-icon ri-award-fill crown-icon" wx:elif="{{(item.rank || index + 1) <= 3}}"></text>
          <view class="rank-no">{{item.rank || index + 1}}</view>
        </view>
        <image class="rank-avatar" src="{{item.avatarFileId || item.beautyPhotos[0].fileId}}" mode="aspectFill" />
        <view class="rank-main">
          <view class="rank-name-row">
            <text class="rank-name">{{item.name}}</text>
            <view class="pet-title" wx:if="{{item.beautyTitle && item.beautyTitle.title}}">
              <text class="remix-icon ri-vip-crown-line"></text>{{item.beautyTitle.title}}
            </view>
          </view>
          <view class="rank-meta">
            <text>{{item.ageText}}</text>
            <text class="dot">·</text>
            <text>{{item.speciesText}}</text>
            <text class="exclusive-tag" wx:if="{{item.exclusiveId}}">ID: {{item.exclusiveId}}</text>
          </view>
        </view>
        <view class="rank-actions">
          <view class="rank-votes">
            <text class="remix-icon ri-thumb-up-fill"></text>
            <text class="vote-num">{{item.voteCount}}</text>
            <text class="vote-unit">票</text>
          </view>
          <button class="small-vote-btn" catchtap="vote" data-id="{{item.petId}}" loading="{{votingPetId === item.petId}}" disabled="{{locked || isHistory || hasVotedToday || votingPetId === item.petId}}">
            <text class="remix-icon {{votedPetId === item.petId ? 'ri-heart-3-fill' : 'ri-heart-3-line'}}"></text>
            <text>{{isHistory ? '已封榜' : (votedPetId === item.petId ? '已投' : '投票')}}</text>
          </button>
        </view>
      </view>
    </view>
    <view class="empty-state" wx:else>
      <text class="remix-icon ri-trophy-line empty-icon"></text>
      <view>{{loading ? '正在加载爱宠榜…' : (keyword ? '未搜索到符合条件的宠物' : '暂无上榜宠物，快去上传美照吧')}}</view>
    </view>
    <button class="ghost-btn load-more" wx:if="{{hasMore}}" loading="{{loading}}" bindtap="loadMore">加载更多排行</button>
  </view>

  <!-- 宠物大图卡片堆叠沉浸式浮层 -->
  <view class="pet-stack-modal {{showPreviewModal ? 'is-visible' : ''}}" wx:if="{{showPreviewModal}}" catchtouchmove="noop">
    <view class="modal-backdrop" bindtap="closePreviewModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <view class="modal-pet-info">
          <view class="modal-pet-name">
            <text>{{previewModalPet.name}}</text>
            <view class="modal-rank-badge {{previewModalPet.displayRank <= 3 ? 'top-rank' : ''}}">
              <text class="remix-icon ri-vip-crown-fill" wx:if="{{previewModalPet.displayRank <= 3}}"></text>
              <text>第{{previewModalPet.displayRank}}名</text>
            </view>
          </view>
          <view class="modal-pet-meta">{{previewModalPet.ageText || '未知年龄'}} · {{previewModalPet.speciesText || '毛孩子'}}</view>
        </view>
        <view class="modal-close-btn" bindtap="closePreviewModal">
          <text class="remix-icon ri-close-line"></text>
        </view>
      </view>

      <!-- 弹窗内大图堆叠舞台 -->
      <view class="modal-card-stage">
        <view wx:for="{{previewModalPet.stackCards}}"
              wx:for-item="card"
              wx:key="photoIndex"
              id="card-{{previewModalPet.petId}}-{{card.photoIndex}}"
              class="modal-card-layer card-role-{{card.role}}"
              style="z-index: {{card.zIndex}};"
              data-petid="{{previewModalPet.petId}}"
              data-photocount="{{previewModalPet.photoCount}}"
              data-photoindex="{{card.photoIndex}}"
              data-role="{{card.role}}"
              prop="{{previewModalPet.activePhotoIndex}}"
              change:prop="{{cardDrag.onActiveIndexChange}}"
              bindtouchstart="{{cardDrag.touchstart}}"
              bindtouchmove="{{cardDrag.touchmove}}"
              bindtouchend="{{cardDrag.touchend}}"
              bindtouchcancel="{{cardDrag.touchcancel}}">
          <image src="{{card.photoUrl}}" mode="aspectFill" />
        </view>

        <!-- 计数徽标 -->
        <view class="modal-count-pill" wx:if="{{previewModalPet.photoCount > 1}}">
          <text class="remix-icon ri-image-line"></text>
          <text>{{previewModalPet.displayPhotoIndex}} / {{previewModalPet.photoCount}}</text>
        </view>
      </view>

      <!-- 弹窗底部操作条 -->
      <view class="modal-footer">
        <view class="modal-votes-count">
          <text class="remix-icon ri-heart-3-fill"></text>
          <text class="votes-num">{{previewModalPet.voteCount}}</text>
          <text class="votes-text">得票</text>
        </view>
        <button class="modal-vote-btn" catchtap="vote" data-id="{{previewModalPet.petId}}" loading="{{votingPetId === previewModalPet.petId}}" disabled="{{locked || isHistory || hasVotedToday || votingPetId}}">
          <text class="remix-icon ri-heart-3-fill"></text>
          <text>{{isHistory || locked ? '已封榜' : (votedPetId === previewModalPet.petId ? '已投票' : '为Ta投一票')}}</text>
        </button>
      </view>
    </view>
  </view>
</view>
<global-loading />
