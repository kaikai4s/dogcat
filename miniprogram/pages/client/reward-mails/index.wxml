<view class="reward-mail-page {{themeClass}} {{fontClass}} page">
  <view class="mail-hero">
    <view class="hero-badge"><text class="remix-icon ri-mail-gift-fill hero-icon"></text><text>站内奖励</text></view>
    <view class="hero-title">奖励邮箱</view>
    <view class="hero-desc">未读奖励会在“我的”显示红点，打开后可领取积分或优惠券。</view>
  </view>

  <view wx:if="{{mails.length}}">
    <view class="card mail-card" wx:for="{{mails}}" wx:key="_id" data-id="{{item._id}}" bindtap="openMail">
      <view class="mail-head">
        <view class="mail-icon"><text class="remix-icon ri-mail-gift-line"></text><view class="mail-dot" wx:if="{{item.unread}}"></view></view>
        <view class="mail-main">
          <view class="mail-title">{{item.title}}</view>
          <view class="mail-content">{{item.content || '打开后即可领取奖励。'}}</view>
        </view>
      </view>
      <view class="meta-row">
        <view class="status-badge">{{item.rewardSummary}}</view>
        <view class="mail-time">{{item.createdAtText}}</view>
      </view>
      <view class="action-row">
        <view class="mail-status">{{item.statusText}}</view>
        <button class="mini-btn" wx:if="{{item.claimable}}" data-id="{{item._id}}" disabled="{{claimingId === item._id}}" catchtap="claimMail"><text class="remix-icon ri-gift-line"></text><text>{{claimingId === item._id ? '领取中...' : '领取奖励'}}</text></button>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <text class="remix-icon ri-mail-line empty-icon"></text>
    <view class="empty-title">暂时还没有奖励邮件</view>
    <view class="empty-desc">后续活动和会员奖励会在这里发放。</view>
  </view>
</view>
