/* Client reward mails - Cute Pet Style UI redesign */
.reward-mail-page { min-height: 100vh; padding: 0 28rpx 100rpx; background: linear-gradient(180deg,#fff8ec 0%,#fffaf6 42%,#f7fbfa 100%); color: #2d211a; box-sizing: border-box; }
.mail-hero { margin: 0 -28rpx 24rpx; padding: 42rpx 34rpx 38rpx; border-bottom-left-radius: 48rpx; border-bottom-right-radius: 48rpx; background: linear-gradient(135deg,#fff0c9 0%,#ffd9c8 54%,#fff5f0 100%); box-shadow: 0 18rpx 44rpx rgba(123,89,62,.08); }
.hero-badge { display: inline-flex; align-items: center; gap: 8rpx; padding: 6rpx 18rpx; border-radius: 999rpx; color: #d45f22; background: rgba(255,255,255,.85); font-size: 24rpx; font-weight: 850; margin-bottom: 16rpx; }
.hero-icon { font-size: 28rpx; }
.hero-title { color: #2d211a; font-size: 42rpx; font-weight: 950; line-height: 1.2; }
.hero-desc { margin-top: 12rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.4; }
.card,
.empty-state { background: #fff; border: 1rpx solid rgba(255,153,102,.14); box-shadow: 0 14rpx 34rpx rgba(123,89,62,.06); border-radius: 36rpx; }
.mail-card { padding: 28rpx; margin-bottom: 20rpx; }
.mail-head { display: flex; gap: 18rpx; align-items: flex-start; }
.mail-icon { position: relative; width: 78rpx; height: 78rpx; border-radius: 28rpx; background: #fff0e2; color: #e9672f; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.mail-icon .remix-icon { font-size: 38rpx; }
.mail-dot { position: absolute; right: -4rpx; top: -4rpx; width: 18rpx; height: 18rpx; border-radius: 50%; background: #ef4444; border: 4rpx solid #fff; }
.mail-main { flex: 1; min-width: 0; }
.mail-title { color: #2d211a; font-size: 30rpx; font-weight: 950; line-height: 1.35; }
.mail-content { margin-top: 8rpx; color: #7a6a5e; font-size: 25rpx; line-height: 1.45; }
.meta-row,
.action-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 18rpx; }
.status-badge { padding: 6rpx 16rpx; border-radius: 999rpx; background: #e6f8ea; color: #00b42a; font-size: 22rpx; font-weight: 850; white-space: nowrap; }
.mail-time,
.mail-status { color: #8e8580; font-size: 24rpx; }
.mini-btn { min-height: 58rpx; padding: 0 20rpx; border-radius: 999rpx; background: linear-gradient(135deg,#ffb86c 0%,#ff7a45 100%); color: #fff; display: flex; align-items: center; justify-content: center; gap: 6rpx; font-size: 23rpx; font-weight: 900; border: none; line-height: 1; flex-shrink: 0; }
.mini-btn::after { display: none; }
.mini-btn .remix-icon { font-size: 26rpx; }
.empty-state { min-height: 420rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 44rpx; }
.empty-icon { color: #e9672f; font-size: 100rpx; margin-bottom: 16rpx; }
.empty-title { color: #2d211a; font-size: 30rpx; font-weight: 950; }
.empty-desc { margin-top: 10rpx; color: #8e8580; font-size: 24rpx; line-height: 1.45; }
button[disabled] { opacity: .62; }
