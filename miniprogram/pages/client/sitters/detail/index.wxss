/* Client sitter detail page - Cute pet style UI redesign */
.sitter-detail-page {
  min-height: 100vh;
  padding: 0 28rpx 60rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.sitter-hero {
  position: relative;
  overflow: hidden;
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

/* 占位高度仅在动画结束后提交；运动阶段只合成 transform / opacity。 */
.hero-slot {
  --hero-duration: 420ms;
  --hero-easing: cubic-bezier(0.22, 0.61, 0.36, 1);
  --hero-collapsed: 520rpx;
  --hero-expanded: 92vh;
  --hero-width: 100vw;
  --card-cw: calc((100vw - 68rpx) * 0.82);
  --card-ew: calc((100vw - 68rpx) * 0.94);
  height: var(--hero-collapsed);
  padding: 0;
  overflow: visible;
  background: none;
  box-shadow: none;
  position: relative;
  z-index: 1;
}
.hero-slot.committed-expanded { height: var(--hero-expanded); }
.hero-reveal-mask, .hero-reveal-scene {
  position: absolute; left: 0; top: 0; width: 100%; height: var(--hero-expanded);
}
.hero-reveal-mask {
  overflow: hidden; border-radius: 0 0 48rpx 48rpx;
  transform: translate3d(0, calc(var(--hero-collapsed) - var(--hero-expanded)), 0);
}
.hero-reveal-scene { transform: translate3d(0, calc(var(--hero-expanded) - var(--hero-collapsed)), 0); }
.expanded .hero-reveal-mask, .expanded .hero-reveal-scene { transform: translate3d(0, 0, 0); }
.hero-media { position: absolute; left: 0; top: 0; width: 100%; height: var(--hero-expanded); transform: translate3d(0, var(--media-start-y, 0px), 0); }
.expanded .hero-media { transform: translate3d(0, 0, 0); }
.hero-bg, .hero-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hero-shade, .hero-glass-shade { background: linear-gradient(180deg, rgba(45,33,26,.06), rgba(45,33,26,.34)); }
.hero-card-surface {
  position: absolute; left: 0; top: 0; width: var(--card-cw); height: var(--card-ch, 360rpx);
  border-radius: 36rpx; overflow: hidden; transform-origin: 0 0;
  box-shadow: 0 18rpx 46rpx rgba(45,33,26,.14);
  transform: translate3d(var(--card-cx, 70rpx), var(--card-cy, 80rpx), 0) scale(1, 1);
}
.expanded .hero-card-surface { transform: translate3d(var(--card-ex), var(--card-ey), 0) scale(var(--card-scale-x), var(--card-scale-y)); }
.hero-card-tint { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border: 1rpx solid rgba(255,255,255,.6); border-radius: inherit; box-sizing: border-box; }
/* 固定尺寸的图片层预先模糊，随名片合成；不实时采样背后的移动画面。 */
.hero-glass { position: absolute; left: 0; top: 0; overflow: hidden; pointer-events: none; }
.hero-glass-normal { width: var(--card-cw); height: var(--card-ch); opacity: 1; }
.hero-glass-compact { width: var(--card-ew); height: var(--card-eh); transform-origin: 0 0; transform: scale(var(--glass-scale-x), var(--glass-scale-y)); opacity: 0; }
.hero-glass-photo, .hero-glass-shade { position: absolute; width: var(--hero-width); height: var(--hero-expanded); }
.hero-glass-photo { filter: blur(var(--hero-blur, 0rpx)); }
.hero-glass-normal .hero-glass-photo, .hero-glass-normal .hero-glass-shade { left: var(--glass-cx); top: var(--glass-cy); }
.hero-glass-compact .hero-glass-photo, .hero-glass-compact .hero-glass-shade { left: var(--glass-ex); top: var(--glass-ey); }
.expanded .hero-glass-normal { opacity: 0; }
.expanded .hero-glass-compact { opacity: 1; }
.hero-info-panel { position: relative; padding: 30rpx 32rpx; border-radius: 36rpx; box-sizing: border-box; }
.hero-copy { position: absolute; left: 0; top: 0; margin: 0; z-index: 2; pointer-events: none; }
.hero-copy-normal { width: var(--card-cw); transform: translate3d(var(--card-cx, 70rpx), var(--card-cy, 80rpx), 0); opacity: 1; }
.hero-copy-compact { width: var(--card-ew); padding: 18rpx 26rpx; transform: translate3d(var(--compact-start-x, 34rpx), var(--compact-start-y, 80rpx), 0); opacity: 0; }
.expanded .hero-copy-normal { transform: translate3d(var(--normal-end-x), var(--normal-end-y), 0); opacity: 0; }
.expanded .hero-copy-compact { transform: translate3d(var(--card-ex), var(--card-ey), 0); opacity: 1; }
.sitter-hero .hero-copy-compact .title { margin-top: 10rpx; font-size: 34rpx; }
.sitter-hero .hero-copy-compact .tip { margin-top: 6rpx; font-size: 24rpx; line-height: 1.35; }
.sitter-hero .hero-copy-compact .hero-meta, .sitter-hero .hero-copy-compact .hero-expand-tip { margin-top: 6rpx; font-size: 20rpx; }
.is-moving .hero-reveal-mask, .is-moving .hero-reveal-scene, .is-moving .hero-media, .is-moving .hero-card-surface { transition: transform var(--hero-duration) var(--hero-easing); }
.is-moving .hero-copy { transition: transform var(--hero-duration) var(--hero-easing), opacity 140ms ease; }
.is-moving .hero-glass { transition: opacity var(--hero-duration) var(--hero-easing); }
.is-moving.expanded .hero-copy-compact, .is-moving:not(.expanded) .hero-copy-normal { transition-delay: 0ms, 100ms; }
.motion-ready .hero-reveal-mask, .motion-ready .hero-reveal-scene, .motion-ready .hero-media, .motion-ready .hero-card-surface, .motion-ready .hero-copy { will-change: transform, opacity; }
.motion-ready .hero-glass { will-change: opacity; }
.sitter-body { position: relative; z-index: 0; transform: translate3d(0, 0, 0); will-change: transform; }
.sitter-hero.plain .hero-info-panel { width: 100%; }

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sitter-hero .hero-info-panel .badge,
.sitter-hero .hero-info-panel .hero-count,
.sitter-hero .hero-info-panel .title,
.sitter-hero .hero-info-panel .tip,
.sitter-hero .hero-info-panel .hero-meta,
.sitter-hero .hero-info-panel .hero-expand-tip {
  color: inherit;
  white-space: normal;
  word-break: break-all;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
}

.hero-count {
  font-size: 24rpx;
  color: #7a6a5e;
  font-weight: 760;
}

.sitter-hero .title {
  margin-top: 20rpx;
  color: #2d211a;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.18;
}

.sitter-hero .tip {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 26rpx;
  line-height: 1.45;
}

.hero-meta {
  margin-top: 10rpx;
  color: #9b7b68;
  font-size: 22rpx;
  font-weight: 760;
}

.hero-expand-tip {
  margin-top: 18rpx;
  color: #d45f22;
  font-size: 22rpx;
  font-weight: 850;
  text-align: center;
}

.sitter-body > .sitter-main-card { margin-top: -8rpx; }

.sitter-main-card {
  margin-top: -20rpx;
  padding: 32rpx 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.sitter-head {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.sitter-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(123, 89, 62, 0.1);
  border: 4rpx solid #ffffff;
}

.sitter-main {
  flex: 1;
  min-width: 0;
}

.sitter-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.sitter-name {
  color: #2d211a;
  font-size: 36rpx;
  font-weight: 950;
}

.muted {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 24rpx;
  line-height: 1.4;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: #8e8580;
  background: #f7f3ef;
  font-size: 22rpx;
  font-weight: 760;
}

.chip.pink {
  color: #d45f22;
  background: #fff0e2;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 153, 102, 0.1);
}

.stat-card {
  padding: 20rpx 12rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.1);
  text-align: center;
}

.stat-number {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #e9672f;
  font-size: 34rpx;
  font-weight: 950;
}

.star-icon {
  color: #ffb86c;
  font-size: 28rpx;
}

.stat-label {
  margin-top: 6rpx;
  color: #8e8580;
  font-size: 22rpx;
}

.sitter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.compact-btn {
  flex: 1;
  min-height: 84rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1;
}

.ghost {
  color: #7a6a5e;
  background: #fff0e2;
  border: none;
}

.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 69, 0.2);
}

.action-icon {
  font-size: 34rpx;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.action-icon.favorited {
  color: #ffb86c;
}

.info-list-card,
.schedule-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  margin-bottom: 20rpx;
  line-height: 1;
}

.section-icon {
  color: #e9672f;
  font-size: 34rpx;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.08);
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-row .label {
  color: #8e8580;
  font-size: 26rpx;
}

.info-row .value {
  color: #2d211a;
  font-size: 26rpx;
  font-weight: 760;
  text-align: right;
  max-width: 60%;
}

.schedule-box {
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  border: 1rpx dashed rgba(255, 153, 102, 0.22);
  color: #7a6a5e;
  font-size: 26rpx;
  line-height: 1.5;
}

.reviews-header {
  margin: 36rpx 0 16rpx;
  padding: 0 6rpx;
}

.review-card {
  margin-top: 20rpx;
  padding: 26rpx 28rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.12);
  box-shadow: 0 10rpx 26rpx rgba(123, 89, 62, 0.04);
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-user {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.avatar-placeholder {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fff0e2;
  color: #e9672f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.strong {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 850;
}

.review-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.review-stars-wrap {
  display: inline-flex;
  align-items: center;
  gap: 2rpx;
}

.review-stars-wrap .remix-icon {
  font-size: 24rpx;
}

.review-stars-wrap .star-icon-active {
  color: #ffb020;
}

.review-stars-wrap .star-icon-inactive {
  color: #d8d3cf;
}

.rating-val {
  color: #e9672f;
  font-size: 26rpx;
  font-weight: 900;
}

.review-content {
  margin-top: 14rpx;
  color: #574b42;
  font-size: 26rpx;
  line-height: 1.5;
}

.review-empty {
  margin-top: 20rpx;
  padding: 44rpx 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  text-align: center;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 16rpx;
  border-radius: 32rpx;
  color: #e9672f;
  background: #fff0e2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.empty-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 24rpx;
  line-height: 1.4;
}

.bottom-actions {
  margin-top: 36rpx;
}

.back-btn {
  width: 100%;
  min-height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #7a6a5e;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  font-size: 28rpx;
  font-weight: 850;
}

.intern-benefit-box {
  margin: 24rpx 0 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border: 1rpx solid rgba(37, 99, 235, 0.2);
}

.benefit-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #1d4ed8;
  font-size: 27rpx;
  font-weight: 900;
}

.benefit-icon {
  font-size: 30rpx;
  color: #2563eb;
}

.benefit-desc {
  margin-top: 8rpx;
  color: #3b82f6;
  font-size: 23rpx;
  line-height: 1.45;
}

.intern-benefit-box .chip-row {
  margin-top: 12rpx;
  gap: 12rpx;
}

.intern-benefit-box .chip {
  background: rgba(255, 255, 255, 0.9);
  color: #1d4ed8;
  border: 1rpx solid rgba(37, 99, 235, 0.25);
  font-weight: 800;
  box-shadow: 0 2rpx 8rpx rgba(37, 99, 235, 0.08);
}

