<template name="heroCopy">
  <view class="hero-topline"><view class="badge">宠托师名片</view><view class="hero-count">{{sitter.isFeatured ? '平台精选' : (sitter.favorite ? '已收藏' : '可收藏')}}</view></view>
  <view class="title">{{sitter.displayName}}</view>
  <view class="tip" wx:if="{{sitter.profileIntro}}">{{sitter.profileIntro}}</view>
  <view class="tip" wx:else>{{sitter.serviceCity}} · {{sitter.levelName}}</view>
  <view class="hero-meta" wx:if="{{sitter.profileIntro}}">{{sitter.serviceCity}} · {{sitter.levelName}}</view>
  <view class="hero-expand-tip" wx:if="{{sitter.profileBackgroundFileId}}">{{compact ? '点击收起主页背景' : '点击展开主页背景'}}</view>
</template>
<view class="page sitter-detail-page {{themeClass}} {{fontClass}}" wx:if="{{sitter}}">
  <view wx:if="{{sitter.profileBackgroundFileId}}" class="sitter-hero hero-slot {{heroExpanded ? 'expanded' : ''}} {{heroCommittedExpanded ? 'committed-expanded' : ''}} {{heroReady ? 'motion-ready' : ''}} {{heroMoving ? 'is-moving' : ''}}" style="{{heroLayoutStyle}} --hero-blur: {{sitter.profileCardBlur * 0.24}}rpx;" bindtap="toggleHeroExpand">
    <view class="hero-reveal-mask">
      <view class="hero-reveal-scene">
        <view class="hero-media"><image class="hero-bg" src="{{sitter.profileBackgroundFileId}}" mode="aspectFill" /><view class="hero-shade"></view></view>
        <view class="hero-card-surface">
          <block wx:if="{{sitter.profileCardBlur > 0}}">
            <view class="hero-glass hero-glass-normal"><image class="hero-glass-photo" src="{{sitter.profileBackgroundFileId}}" mode="aspectFill" /><view class="hero-glass-shade"></view></view>
            <view class="hero-glass hero-glass-compact"><image class="hero-glass-photo" src="{{sitter.profileBackgroundFileId}}" mode="aspectFill" /><view class="hero-glass-shade"></view></view>
          </block>
          <view class="hero-card-tint" style="{{heroSurfaceStyle}}"></view>
        </view>
        <view class="hero-info-panel hero-copy hero-copy-normal" style="color: {{sitter.profileCardTextColor}};" aria-hidden="{{heroExpanded}}"><template is="heroCopy" data="{{sitter, compact: false}}" /></view>
        <view class="hero-info-panel hero-copy hero-copy-compact" style="color: {{sitter.profileCardTextColor}};" aria-hidden="{{!heroExpanded}}"><template is="heroCopy" data="{{sitter, compact: true}}" /></view>
      </view>
    </view>
  </view>
  <view wx:else class="sitter-hero plain"><view class="hero-info-panel" style="{{profileCardStyle}}"><template is="heroCopy" data="{{sitter, compact: false}}" /></view></view>
  <view class="sitter-body" style="{{heroBodyStyle}}">
  <view class="card sitter-main-card">
    <view class="sitter-head">
      <image class="sitter-avatar" wx:if="{{sitter.avatarUrl}}" src="{{sitter.avatarUrl}}" mode="aspectFill" />
      <image class="sitter-avatar" wx:else src="../../../../images/icons/avatar.png" mode="aspectFill" />
      <view class="sitter-main">
        <view class="sitter-name-row">
          <text class="sitter-name">{{sitter.displayName}}</text>
          <view class="chip pink" wx:if="{{sitter.isFeatured}}">平台精选</view>
          <view class="chip blue" wx:if="{{sitter.staffLevel === 'intern'}}">实习宠托师</view>
        </view>
        <view class="muted">{{sitter.serviceSummary || '专业爱宠、用心照护'}}</view>
        <view class="chip-row">
          <view class="chip {{sitter.gender === 'male' ? 'blue' : (sitter.gender === 'female' ? 'pink' : '')}}">{{sitter.gender === 'male' ? '男' : (sitter.gender === 'female' ? '女' : '性别待核实')}}</view>
          <view class="chip pink" wx:for="{{sitter.publicTags}}" wx:key="*this">{{item}}</view>
        </view>
      </view>
    </view>

    <view class="intern-benefit-box" wx:if="{{sitter.staffLevel === 'intern'}}">
      <view class="benefit-title">
        <text class="remix-icon ri-information-line benefit-icon"></text>
        <text>实习宠托师 · 平台服务经验积累中</text>
      </view>
      <view class="benefit-desc">实习代表正在积累平台服务经验，不等于没有养宠经历。请结合下方已核验事项、个人介绍与真实评价，选择适合您宠物的照护人员。</view>
      <view class="benefit-desc">预约前建议确认宠物性格、牵引或喂食要求及特殊注意事项；服务项目与反馈要求以订单说明为准。</view>
      <view class="chip-row" wx:if="{{sitter.verifiedServiceTags.length}}">
        <view class="chip" wx:for="{{sitter.verifiedServiceTags}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="benefit-desc">个人介绍由宠托师本人填写，不等同于平台核验。</view>
      <view class="benefit-desc">如有实习期预约优惠，以订单结算页展示为准。</view>
    </view>

    <view class="stats-grid">
      <view class="stat-card">
        <view class="stat-number">
          <text class="remix-icon ri-star-fill star-icon"></text>
          <text>{{sitter.ratingAverage || '-'}}</text>
        </view>
        <view class="stat-label">综合评分</view>
      </view>
      <view class="stat-card">
        <view class="stat-number">{{sitter.reviewCount || 0}}</view>
        <view class="stat-label">累计评价</view>
      </view>
      <view class="stat-card" wx:if="{{sitter.serviceRadiusKm}}">
        <view class="stat-number">{{sitter.serviceRadiusKm}}km</view>
        <view class="stat-label">接单范围</view>
      </view>
    </view>

    <view class="sitter-actions">
      <button class="ghost compact-btn" bindtap="toggleFavorite">
        <text class="remix-icon {{sitter.favorite ? 'ri-star-fill' : 'ri-star-line'}} action-icon {{sitter.favorite ? 'favorited' : ''}}"></text>
        <text>{{sitter.favorite ? '取消收藏' : '收藏宠托师'}}</text>
      </button>
      <button class="primary compact-btn {{sitter.acceptDirectOrders === false ? 'disabled' : ''}}" bindtap="book">
        <text class="remix-icon ri-hand-heart-line action-icon"></text>
        <text>{{sitter.acceptDirectOrders === false ? '暂不接指定单' : '指定预约'}}</text>
      </button>
    </view>
  </view>

  <view class="card info-list-card">
    <view class="section-title">
      <text class="remix-icon ri-map-pin-user-line section-icon"></text>
      <text>服务范围与区域</text>
    </view>
    <view class="info-row">
      <view class="label">服务城市</view>
      <view class="value">{{sitter.serviceCity}}</view>
    </view>
    <view class="info-row">
      <view class="label">服务区域</view>
      <view class="value">{{sitter.serviceAreas || '覆盖周边主要小区'}}</view>
    </view>
    <view class="info-row" wx:if="{{sitter.publicServiceAddress || sitter.serviceAddress}}">
      <view class="label">{{sitter.publicServiceAddress ? '服务网点' : '常用出发行程'}}</view>
      <view class="value">{{sitter.publicServiceAddress || sitter.serviceAddress}}</view>
    </view>
  </view>

  <view class="card schedule-card">
    <view class="section-title">
      <text class="remix-icon ri-time-line section-icon"></text>
      <text>按周可预约时间段</text>
    </view>
    <view class="schedule-box">
      {{sitter.weeklyScheduleText || '全天均可沟通与预约服务'}}
    </view>
  </view>

  <view class="reviews-header">
    <view class="section-title">
      <text class="remix-icon ri-chat-smile-2-line section-icon"></text>
      <text>客户评价 ({{sitter.recentReviews.length || 0}})</text>
    </view>
  </view>

  <view class="card review-card" wx:for="{{sitter.recentReviews}}" wx:key="_id">
    <view class="review-head">
      <view class="review-user">
        <view class="avatar-level-wrap">
          <image class="avatar-placeholder" wx:if="{{item.clientAvatarUrl}}" src="{{item.clientAvatarUrl}}" mode="aspectFill" style="padding: 0; overflow: hidden;" />
          <view class="avatar-placeholder" wx:else><text class="remix-icon ri-user-heart-line"></text></view>
          <view class="avatar-level-badge badge-{{item.badgeStyle || 'gold'}}" wx:if="{{item.badgeTag || item.memberLevelName}}">{{item.badgeTag || item.memberLevelName}}</view>
        </view>
        <text class="strong {{item.nameEffect && item.nameEffect !== 'none' ? 'name-effect-' + item.nameEffect : ''}}" style="{{item.nameColor ? 'color: ' + item.nameColor + ';' : ''}}">{{item.clientName || '宠物主'}}</text>
        <text class="member-badge badge-{{item.badgeStyle || 'gold'}}" wx:if="{{item.badgeTag || item.memberLevelName}}">{{item.badgeTag || item.memberLevelName}}</text>
      </view>
      <view class="review-rating">
        <view class="review-stars-wrap">
          <text class="remix-icon {{item.rating >= star ? 'ri-star-fill star-icon-active' : 'ri-star-line star-icon-inactive'}}" wx:for="{{[1,2,3,4,5]}}" wx:for-item="star" wx:key="*this"></text>
        </view>
        <text class="rating-val">{{item.rating}}分</text>
      </view>
    </view>
    <view class="review-content">{{item.content || '用户未填写文字评价'}}</view>
    <view class="chip-row" wx:if="{{item.tags && item.tags.length}}">
      <view class="chip" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</view>
    </view>
  </view>

  <view class="card empty review-empty" wx:if="{{!sitter.recentReviews.length}}">
    <view class="empty-icon remix-icon ri-message-2-line"></view>
    <view class="empty-title">暂无服务评价</view>
    <view class="empty-desc">暂无平台服务评价。您可以先查看个人介绍与已展示的审核信息，预约前确认宠物需求是否适合。</view>
  </view>

  <view class="bottom-actions">
    <button class="ghost back-btn" bindtap="goList">
      <text class="remix-icon ri-arrow-left-line"></text>
      <text>返回宠托师列表</text>
    </button>
  </view>
</view>
</view>
<global-loading />
