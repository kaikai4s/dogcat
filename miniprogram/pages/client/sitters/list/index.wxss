/* Sitters list cute pet redesign styles */
.sitter-page {
  padding-top: 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
}

.sitter-hero {
  position: relative;
  z-index: 1;
  padding: 34rpx 30rpx 42rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.hero-badge {
  background: rgba(255, 255, 255, 0.85);
  color: #d45f22;
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  font-weight: 850;
}

.hero-count {
  color: #e9672f;
  font-size: 25rpx;
  font-weight: 900;
}

.hero-title {
  color: #2d211a;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-tip {
  margin-top: 10rpx;
  color: #7a6a5e;
  font-size: 25rpx;
  line-height: 1.4;
}

.sitter-search-wrap {
  margin: -28rpx 28rpx 0;
  position: relative;
  z-index: 10;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 6rpx 8rpx 6rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.2);
  box-shadow: 0 10rpx 24rpx rgba(123, 89, 62, 0.08);
}

.search-icon-cute {
  font-size: 32rpx;
  color: #ff7a45;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  font-size: 26rpx;
  color: #2d211a;
  background: transparent !important;
  border: none !important;
}

.search-btn-cute {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 69, 0.2);
}

.filter-card {
  margin: 24rpx 28rpx 0;
  padding: 26rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
}

.filter-section {
  margin-bottom: 20rpx;
}

.filter-section.last {
  margin-bottom: 0;
}

.filter-title {
  margin-bottom: 12rpx;
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 900;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 14rpx;
}

.filter-row.wrap {
  flex-wrap: wrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #7a6a5e;
  background: #fff8f4;
  border: 1rpx solid rgba(255, 153, 102, 0.15);
  font-size: 24rpx;
  font-weight: 800;
}

.filter-chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.trust-banner {
  margin: 24rpx 28rpx 0;
  padding: 28rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #fff6ee 0%, #fff0e6 100%);
  border: 1rpx solid rgba(255, 153, 102, 0.22);
  box-shadow: 0 10rpx 24rpx rgba(123, 89, 62, 0.04);
}

.trust-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.trust-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2d211a;
  font-size: 29rpx;
  font-weight: 950;
}

.trust-icon {
  font-size: 32rpx;
  color: #ff7a45;
}

.trust-badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 21rpx;
  font-weight: 850;
}

.trust-desc {
  margin-top: 10rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.45;
}

.trust-btn-cute {
  width: 100%;
  min-height: 72rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.loading-card {
  margin: 24rpx 28rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  text-align: center;
  color: #8e8580;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 26rpx;
}

.spin-icon {
  font-size: 32rpx;
  color: #ff7a45;
}

.sitter-item-card {
  margin: 24rpx 28rpx 0;
  padding: 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.sitter-item-head {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.sitter-avatar-container {
  flex-shrink: 0;
}

.sitter-avatar-img,
.sitter-avatar-placeholder {
  width: 110rpx;
  height: 110rpx;
  border-radius: 32rpx;
  background: #fff0e2;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.12);
}

.sitter-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff7a45;
}

.sitter-avatar-placeholder .remix-icon {
  font-size: 58rpx;
}

.sitter-item-main {
  flex: 1;
  min-width: 0;
}

.sitter-title-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.sitter-name-block {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sitter-name {
  color: #2d211a;
  font-size: 32rpx;
  font-weight: 950;
}

.sitter-city-tag {
  color: #8e8580;
  font-size: 24rpx;
}

.sitter-rating-line {
  margin: 8rpx 0 12rpx;
}

.rating-box {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
}

.star-gold-icon {
  font-size: 26rpx;
  color: #ffb800;
}

.rating-num {
  color: #d45f22;
  font-weight: 900;
}

.review-count {
  color: #8e8580;
  font-size: 22rpx;
}

.chip-cute {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.pink-cute { color: #f43f6b; background: #fff0f5; }
.blue-cute { color: #2563eb; background: #eff6ff; }
.gray-cute { color: #7a6a5e; background: #f7f5f4; }

.pin-mini-icon {
  font-size: 22rpx;
  color: #2563eb;
}

.sitter-intro {
  margin: 18rpx 0 14rpx;
  color: #2d211a;
  font-size: 27rpx;
  line-height: 1.48;
  font-style: italic;
}

.area-tags-row {
  margin-bottom: 20rpx;
}

.area-chip {
  display: inline-flex;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #8e8580;
  background: #f8f6f5;
  font-size: 21rpx;
  margin-right: 8rpx;
}

.sitter-item-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.primary-cute-btn,
.ghost-cute-btn {
  min-height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
}

.primary-cute-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 69, 0.22);
}

.ghost-cute-btn {
  color: #d45f22;
  background: #fff0e2;
}

.sitter-empty {
  margin: 40rpx 28rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.95);
}

.empty-icon {
  font-size: 72rpx;
  color: #ffb86c;
}

.empty-title {
  margin-top: 14rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
}

.empty-desc {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 24rpx;
}

.empty-actions {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin-top: 24rpx;
}
