/* Sitters list cute pet redesign styles */
.sitter-page {
  padding-top: 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
}

.sitter-hero {
  position: relative;
  z-index: 1;
  padding: 34rpx 30rpx 42rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.hero-badge {
  background: rgba(255, 255, 255, 0.85);
  color: #d45f22;
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  font-weight: 850;
}

.hero-count {
  color: #e9672f;
  font-size: 25rpx;
  font-weight: 900;
}

.hero-title {
  color: #2d211a;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-tip {
  margin-top: 10rpx;
  color: #7a6a5e;
  font-size: 25rpx;
  line-height: 1.4;
}

.sitter-location-bar {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 16rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(123, 89, 62, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
}

.location-bar-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex: 1;
  min-width: 0;
}

.location-pin {
  color: #ff5e36;
  font-size: 34rpx;
  flex-shrink: 0;
}

.location-detail {
  flex: 1;
  min-width: 0;
}

.location-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location-name {
  font-size: 27rpx;
  font-weight: 850;
  color: #2d211a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 420rpx;
}

.location-change-tag {
  font-size: 20rpx;
  color: #ff5e36;
  background: #fff0eb;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 750;
  flex-shrink: 0;
}

.location-address {
  font-size: 22rpx;
  color: #8c7c72;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-top: 4rpx;
}

.location-arrow {
  color: #bfaea5;
  font-size: 32rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.sitter-search-wrap {
  margin: -28rpx 28rpx 0;
  position: relative;
  z-index: 10;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 6rpx 8rpx 6rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.2);
  box-shadow: 0 10rpx 24rpx rgba(123, 89, 62, 0.08);
}

.search-icon-cute {
  font-size: 32rpx;
  color: #ff7a45;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 60rpx;
  min-height: 60rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  font-size: 26rpx;
  line-height: 60rpx;
  color: #2d211a;
  background: transparent !important;
  border: none !important;
}

.search-btn-cute {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 69, 0.2);
}

.filter-card {
  margin: 24rpx 28rpx 0;
  padding: 26rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
}

.filter-section {
  margin-bottom: 20rpx;
}

.filter-section.last {
  margin-bottom: 0;
}

.filter-title {
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 900;
}

.filter-section > .filter-title {
  margin-bottom: 12rpx;
}

.filter-title-row {
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.filter-more-text {
  color: #ff7a45;
  font-size: 22rpx;
  font-weight: 850;
  flex-shrink: 0;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 14rpx;
}

.filter-row.wrap {
  flex-wrap: wrap;
}

.compact-filter-row {
  max-height: 126rpx;
  overflow: hidden;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #7a6a5e;
  background: #fff8f4;
  border: 1rpx solid rgba(255, 153, 102, 0.15);
  font-size: 24rpx;
  font-weight: 800;
}

.filter-chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.more-chip {
  color: #ff7a45;
  background: #fff0e6;
  border-color: rgba(255, 122, 69, 0.24);
}

.selector-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: flex-end;
  background: rgba(23, 18, 16, 0.42);
}

.selector-sheet {
  width: 100%;
  max-height: 72vh;
  padding: 28rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: var(--theme-card-bg, #ffffff);
  box-shadow: 0 -18rpx 48rpx rgba(0, 0, 0, 0.16);
  box-sizing: border-box;
}

.selector-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 22rpx;
}

.selector-title {
  color: var(--theme-title, #2d211a);
  font-size: 32rpx;
  font-weight: 950;
}

.selector-desc {
  margin-top: 6rpx;
  color: var(--theme-muted, #7a6a5e);
  font-size: 24rpx;
}

.selector-close {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--theme-muted, #8e8580);
  background: var(--theme-bg-soft, #fff8f4);
  font-size: 34rpx;
  flex-shrink: 0;
}

.selector-list {
  max-height: 52vh;
}

.selector-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 64rpx;
  margin: 0 14rpx 16rpx 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: var(--theme-text, #2d211a);
  background: var(--theme-bg-soft, #fff8f4);
  border: 1rpx solid var(--theme-border, rgba(255, 153, 102, 0.15));
  font-size: 25rpx;
  font-weight: 850;
  box-sizing: border-box;
}

.selector-chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  border-color: transparent;
}

.trust-banner {
  margin: 24rpx 28rpx 0;
  padding: 28rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #fff6ee 0%, #fff0e6 100%);
  border: 1rpx solid rgba(255, 153, 102, 0.22);
  box-shadow: 0 10rpx 24rpx rgba(123, 89, 62, 0.04);
}

.trust-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.trust-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2d211a;
  font-size: 29rpx;
  font-weight: 950;
}

.trust-icon {
  font-size: 32rpx;
  color: #ff7a45;
}

.trust-badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 21rpx;
  font-weight: 850;
}

.trust-desc {
  margin-top: 10rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.45;
}

.trust-btn-cute {
  width: 100%;
  min-height: 72rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.loading-card {
  margin: 24rpx 28rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  text-align: center;
  color: #8e8580;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 26rpx;
}

.spin-icon {
  font-size: 32rpx;
  color: #ff7a45;
}

.sitter-item-card {
  margin: 24rpx 28rpx 0;
  padding: 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.sitter-item-head {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.sitter-avatar-container {
  flex-shrink: 0;
}

.sitter-avatar-img,
.sitter-avatar-placeholder {
  width: 110rpx;
  height: 110rpx;
  border-radius: 32rpx;
  background: #fff0e2;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.12);
}

.sitter-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff7a45;
}

.sitter-avatar-placeholder .remix-icon {
  font-size: 58rpx;
}

.sitter-item-main {
  flex: 1;
  min-width: 0;
}

.sitter-title-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.sitter-name-block {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sitter-name {
  color: #2d211a;
  font-size: 32rpx;
  font-weight: 950;
}

.sitter-city-tag {
  color: #8e8580;
  font-size: 24rpx;
}

.sitter-rating-line {
  margin: 8rpx 0 12rpx;
}

.rating-box {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
}

.star-gold-icon {
  font-size: 26rpx;
  color: #ffb800;
}

.rating-num {
  color: #d45f22;
  font-weight: 900;
}

.review-count {
  color: #8e8580;
  font-size: 22rpx;
}

.chip-cute {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 850;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.pink-cute { color: #f43f6b; background: #fff0f5; }
.blue-cute { color: #2563eb; background: #eff6ff; }
.gray-cute { color: #7a6a5e; background: #f7f5f4; }
.out-range-cute { color: #9a3412; background: #fff7ed; }

.pin-mini-icon {
  font-size: 22rpx;
  color: #2563eb;
}

.sitter-intro {
  margin: 18rpx 0 14rpx;
  color: #2d211a;
  font-size: 27rpx;
  line-height: 1.48;
  font-style: italic;
}

.area-tags-row {
  margin-bottom: 20rpx;
}

.area-chip {
  display: inline-flex;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #8e8580;
  background: #f8f6f5;
  font-size: 21rpx;
  margin-right: 8rpx;
}

.sitter-item-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.primary-cute-btn,
.ghost-cute-btn {
  width: 100% !important;
  min-width: 0 !important;
  margin: 0 !important;
  box-sizing: border-box !important;
  min-height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  padding: 0 16rpx;
}

.primary-cute-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  box-shadow: 0 10rpx 24rpx rgba(255, 122, 69, 0.22);
}

.primary-cute-btn.disabled,
.primary-cute-btn[disabled] {
  color: #9ca3af !important;
  background: #f3f4f6 !important;
  box-shadow: none !important;
}

.ghost-cute-btn {
  color: #d45f22;
  background: #fff0e2;
}

.list-state {
  padding: 28rpx 0;
  color: #8e8580;
  font-size: 24rpx;
  text-align: center;
}

.sitter-empty {
  margin: 40rpx 28rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.95);
  box-sizing: border-box;
}

.empty-icon {
  font-size: 72rpx;
  color: #ffb86c;
}

.empty-title {
  margin-top: 14rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
}

.empty-desc {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 24rpx;
}

.empty-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: 32rpx;
}

.intern-discount-banner {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  margin: 14rpx 0 10rpx;
  border-radius: 16rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 750;
}

.intern-banner-icon {
  font-size: 26rpx;
}
