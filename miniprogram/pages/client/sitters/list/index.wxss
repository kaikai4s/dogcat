.sitter-page {
  padding-top: 32rpx;
}

.sitter-hero {
  position: relative;
  z-index: 1;
  min-height: 300rpx;
  margin: -36rpx -30rpx 26rpx;
  padding: 88rpx 34rpx 42rpx;
  overflow: hidden;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #ffd3df 0%, #ffbfd2 56%, #fff0f5 100%);
  box-shadow: 0 18rpx 46rpx rgba(244, 63, 107, 0.12);
}

.sitter-hero::after {
  content: "🐱";
  position: absolute;
  right: 42rpx;
  bottom: 28rpx;
  font-size: 104rpx;
  opacity: 0.22;
}

.hero-topline,
.sitter-head,
.sitter-actions {
  display: flex;
  align-items: center;
}

.hero-topline {
  position: relative;
  z-index: 1;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.hero-count {
  color: #9f4960;
  font-size: 26rpx;
  font-weight: 850;
}

.sitter-search {
  margin-top: -12rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: #2b2528;
}

.filter-card {
  padding: 26rpx;
}

.filter-section {
  margin-bottom: 24rpx;
}

.filter-section.last {
  margin-bottom: 0;
}

.filter-title {
  margin-bottom: 14rpx;
  color: #686267;
  font-size: 25rpx;
  font-weight: 850;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.filter-row {
  display: flex;
  gap: 14rpx;
}

.filter-row.wrap {
  flex-wrap: wrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: #8c858b;
  background: #fff6f9;
  border: 1rpx solid rgba(244, 63, 107, 0.12);
  font-size: 25rpx;
  font-weight: 750;
}

.filter-chip.active {
  color: #fff;
  background: linear-gradient(135deg, #ff7a9c 0%, #f43f6b 100%);
  box-shadow: 0 10rpx 24rpx rgba(244, 63, 107, 0.22);
}

.sitter-trust .pet-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.74);
  font-size: 52rpx;
}

.loading-card {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
  padding: 28rpx;
  text-align: center;
  color: #969196;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 28rpx;
}

.sitter-card {
  padding: 28rpx;
}

.sitter-head {
  gap: 20rpx;
}

.sitter-avatar {
  width: 110rpx;
  height: 110rpx;
  flex-shrink: 0;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #fff0f5 0%, #ffe1eb 100%);
  font-size: 58rpx;
  box-shadow: inset 0 -12rpx 24rpx rgba(244, 63, 107, 0.08);
}

.sitter-main {
  flex: 1;
  min-width: 0;
}

.sitter-summary {
  margin: 22rpx 0 12rpx;
  color: #5f585e;
  font-size: 28rpx;
  line-height: 1.55;
}

.area-row {
  margin-bottom: 22rpx;
}

.sitter-actions {
  gap: 18rpx;
}

.compact-btn {
  flex: 1;
  min-height: 74rpx;
  font-size: 27rpx;
}

.featured-badge {
  color: #9a3412;
  background: linear-gradient(135deg, #fff7ed 0%, #fed7aa 100%);
}

.sitter-rating-row {
  margin: 8rpx 0 12rpx;
}

.rating-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  color: #b45309;
  font-size: 25rpx;
  font-weight: 850;
}

.rating-chip text {
  color: #8c858b;
  font-weight: 650;
}

.muted-rating {
  color: #a7a0a6;
  font-weight: 650;
}
