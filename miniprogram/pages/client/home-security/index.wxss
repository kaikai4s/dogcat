/* Client home security - Cute Pet Style UI redesign */
.home-security-page { min-height: 100vh; padding: 0 28rpx 100rpx; background: linear-gradient(180deg,#fff8ec 0%,#fffaf6 42%,#f7fbfa 100%); color: #2d211a; box-sizing: border-box; }
.security-hero { margin: 0 -28rpx 24rpx; padding: 42rpx 34rpx 38rpx; border-bottom-left-radius: 48rpx; border-bottom-right-radius: 48rpx; background: linear-gradient(135deg,#fff0c9 0%,#ffd9c8 54%,#fff5f0 100%); box-shadow: 0 18rpx 44rpx rgba(123,89,62,.08); }
.hero-badge { display: inline-flex; align-items: center; gap: 8rpx; padding: 6rpx 18rpx; border-radius: 999rpx; color: #d45f22; background: rgba(255,255,255,.85); font-size: 24rpx; font-weight: 850; margin-bottom: 16rpx; }
.hero-icon { font-size: 28rpx; }
.hero-title { color: #2d211a; font-size: 42rpx; font-weight: 950; line-height: 1.2; }
.hero-desc { margin-top: 12rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.4; }
.intro-card,
.card,
.empty-state { background: #fff; border: 1rpx solid rgba(255,153,102,.14); box-shadow: 0 14rpx 34rpx rgba(123,89,62,.06); border-radius: 36rpx; }
.intro-card { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 28rpx; margin-bottom: 24rpx; }
.intro-title,
.security-title { color: #2d211a; font-size: 30rpx; font-weight: 950; }
.intro-desc,
.security-meta,
.notice-text { margin-top: 8rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.45; }
.intro-icon { width: 82rpx; height: 82rpx; border-radius: 30rpx; background: #fff0e2; color: #e9672f; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.intro-icon .remix-icon { font-size: 42rpx; }
.security-card { padding: 28rpx; margin-bottom: 22rpx; }
.security-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 12rpx; }
.ghost-btn { min-height: 68rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; gap: 6rpx; font-size: 23rpx; font-weight: 900; border: none; line-height: 1; background: #fff0e2; color: #7a6a5e; }
.ghost-btn::after { display: none; }
.ghost-btn .remix-icon { font-size: 26rpx; }
.compact-btn { padding: 0 16rpx; flex-shrink: 0; margin: 0; }
.info-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 16rpx 0; border-bottom: 1rpx solid rgba(255,153,102,.08); }
.info-row:last-child { border-bottom: none; }
.label { color: #8e8580; font-size: 24rpx; flex-shrink: 0; min-width: 130rpx; }
.value { color: #574b42; font-size: 25rpx; line-height: 1.45; text-align: right; word-break: break-all; }
.security-block { margin-top: 16rpx; padding: 18rpx; border-radius: 26rpx; background: #fff8ec; }
.image-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 14rpx; margin-top: 14rpx; }
.security-image { width: 100%; height: 160rpx; border-radius: 22rpx; background: #fff0e2; }
.empty-state { min-height: 420rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 44rpx; }
.empty-icon { color: #e9672f; font-size: 100rpx; margin-bottom: 16rpx; }
.empty-title { color: #2d211a; font-size: 30rpx; font-weight: 950; }
.empty-desc { margin-top: 10rpx; color: #8e8580; font-size: 24rpx; line-height: 1.45; }
