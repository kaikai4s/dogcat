<view class="page">
  <view class="top-nav">
    <view class="nav-round" bindtap="goBack">‹</view>
  </view>
  <view class="dashboard-header">
    <view class="badge">家庭安全</view>
    <view class="title">家庭安防</view>
    <view class="tip">门锁密码会加密保存，仅分配员工在服务时间窗口内可查看。</view>
  </view>

  <view class="soft-panel">
    <view class="between">
      <view>
        <view class="strong">限时密码保护</view>
        <view class="muted">每次访问都会记录到证据链</view>
      </view>
      <view class="pet-avatar">🔐</view>
    </view>
  </view>

  <view class="notice" wx:if="{{masked}}">
    <view class="strong">已保存门锁密码</view>
    <view class="muted">{{masked}}</view>
  </view>

  <view class="card form-card">
    <input password placeholder="门锁密码（重新保存时填写）" value="{{form.doorLockCode}}" data-field="doorLockCode" bindinput="input" />
    <input placeholder="钥匙位置" value="{{form.keyLocation}}" data-field="keyLocation" bindinput="input" />
    <textarea placeholder="入户说明" value="{{form.entryNotes}}" data-field="entryNotes" bindinput="input" />
    <input placeholder="监控位置说明" value="{{form.cameraLocations}}" data-field="cameraLocations" bindinput="input" />
    <input placeholder="紧急联系人" value="{{form.emergencyContactName}}" data-field="emergencyContactName" bindinput="input" />
    <input placeholder="紧急联系电话" value="{{form.emergencyContactPhone}}" data-field="emergencyContactPhone" bindinput="input" />
  </view>

  <button class="primary" bindtap="save">保存安防信息</button>
</view>
