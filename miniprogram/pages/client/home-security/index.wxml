<view class="page"><view class="title">家庭安防</view><view class="muted" wx:if="{{masked}}">已保存门锁密码：{{masked}}</view><view class="form"><input password placeholder="门锁密码（重新保存时填写）" value="{{form.doorLockCode}}" data-field="doorLockCode" bindinput="input"/><input placeholder="钥匙位置" value="{{form.keyLocation}}" data-field="keyLocation" bindinput="input"/><textarea placeholder="入户说明" value="{{form.entryNotes}}" data-field="entryNotes" bindinput="input"/><input placeholder="监控位置说明" value="{{form.cameraLocations}}" data-field="cameraLocations" bindinput="input"/><input placeholder="紧急联系人" value="{{form.emergencyContactName}}" data-field="emergencyContactName" bindinput="input"/><input placeholder="紧急联系电话" value="{{form.emergencyContactPhone}}" data-field="emergencyContactPhone" bindinput="input"/></view><button class="primary" bindtap="save">保存</button></view>