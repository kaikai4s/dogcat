page {
  background: var(--theme-bg);
}

.settings-page {
  min-height: 100vh;
  background: var(--theme-bg);
  color: var(--theme-text);
  padding-bottom: 80rpx;
}

.settings-nav {
  height: 176rpx;
  padding: 72rpx 24rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--theme-card-bg);
  border-bottom: 1rpx solid var(--theme-border);
}

.settings-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--theme-title);
}

.settings-card {
  margin-top: 12rpx;
  background: var(--theme-card-bg);
}

.privacy-card {
  margin-top: 64rpx;
}

.settings-row {
  min-height: 112rpx;
  margin-left: 24rpx;
  padding: 0 20rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--theme-border);
  font-size: 34rpx;
  color: var(--theme-text);
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-arrow,
.settings-value {
  color: var(--theme-muted);
  font-size: 28rpx;
  font-weight: 500;
}

.settings-arrow {
  font-size: 52rpx;
  font-weight: 300;
}

.logout-btn {
  width: 608rpx;
  height: 96rpx;
  margin: 126rpx auto 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-primary);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 500;
}

.logout-btn:active,
.settings-row:active {
  opacity: 0.75;
}
