px;border-radius:22rpx;background:#fff8ec;box-sizing:border-box}.modal-actions{display:flex;gap:16rpx;justify-content:flex-end;margin-top:20rpx}.modal-actions button{min-width:160rpx;height:68rpx;line-height:68rpx;border-radius:999rpx;font-size:25rpx}

/* ================== 商品详情页高品质升级与动效 ================== */
.fade-in-page {
  animation: pageFadeIn 0.35s ease-out;
}

@keyframes pageFadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.detail-page {
  padding-bottom: 210rpx;
}

/* 顶部轮播图卡片 */
.swiper-wrap {
  position: relative;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(123, 89, 62, 0.1);
}

.detail-swiper {
  height: 600rpx;
  background: #fff;
}

.swiper-img {
  width: 100%;
  height: 600rpx;
  transition: transform 0.3s ease;
}

.swiper-corner-badge {
  position: absolute;
  right: 20rpx;
  bottom: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  backdrop-filter: blur(8rpx);
}

/* 价格与销售标题卡片 */
.main-info-card {
  margin-top: 24rpx;
}

.detail-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.price-main {
  color: #ff5000;
  display: flex;
  align-items: baseline;
}

.yen-symbol {
  font-size: 32rpx;
  font-weight: 900;
  margin-right: 4rpx;
}

.price-val {
  font-size: 52rpx;
  font-weight: 950;
  letter-spacing: -1rpx;
}

.orig-price {
  margin-left: 14rpx;
  color: #b8aaa0;
  font-size: 26rpx;
  text-decoration: line-through;
}

.sales-tag {
  color: #a89b92;
  font-size: 23rpx;
  font-weight: 700;
}

/* 亮点标签 */
.highlights-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.highlight-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fff2eb, #ffe8dc);
  border: 1rpx solid rgba(255, 122, 69, 0.2);
  color: #d45f22;
  font-size: 22rpx;
  font-weight: 850;
  animation: popIn 0.3s ease-out;
}

@keyframes popIn {
  0% { transform: scale(0.9); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.meta-item {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}

.meta-label {
  color: #a89b92;
  font-weight: 700;
}

.detail-warn {
  margin-top: 14rpx;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  background: #fef2f2;
  color: #dc2626;
  font-size: 23rpx;
  font-weight: 850;
}

/* 服务保障背书条 */
.guarantee-card {
  padding: 22rpx 28rpx;
  background: #fdfbf7;
  border: 1rpx solid rgba(255, 153, 102, 0.16);
}

.guarantee-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.guarantee-badge {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #10b981;
  color: #fff;
  font-size: 20rpx;
  font-weight: 850;
}

.guarantee-sub {
  color: #7a6a5e;
  font-size: 23rpx;
  font-weight: 700;
}

.guarantee-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 24rpx;
  margin-top: 14rpx;
}

.guarantee-item {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: #4b3d33;
  font-size: 23rpx;
  font-weight: 750;
}

.guarantee-check {
  color: #10b981;
  font-weight: 900;
  font-size: 22rpx;
}

/* 规格选择 */
.spec-group {
  margin-top: 22rpx;
}

.spec-title {
  color: #7a6a5e;
  font-size: 25rpx;
  font-weight: 850;
}

.spec-values {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.spec-chip {
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  background: #fff8ec;
  color: #7a6a5e;
  font-size: 24rpx;
  font-weight: 850;
  border: 1rpx solid rgba(255, 153, 102, 0.2);
  transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.spec-chip:active {
  transform: scale(0.92);
}

.spec-chip.active {
  color: #fff;
  background: linear-gradient(135deg, #ff9a44, #ff6b3d);
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 61, 0.28);
  transform: scale(1.04);
}

/* 结构化产品参数表 */
.section-head-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff8ec;
  color: #d45f22;
  font-size: 21rpx;
  font-weight: 800;
}

.section-tag.warm-tag {
  background: #eff6ff;
  color: #2563eb;
}

.params-table {
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid #f2e9e1;
  background: #fff;
}

.param-tr {
  display: flex;
  border-bottom: 1rpx solid #f7efe8;
  font-size: 25rpx;
  line-height: 1.5;
}

.param-tr:last-child {
  border-bottom: 0;
}

.param-th {
  width: 190rpx;
  padding: 16rpx 20rpx;
  background: #fdfaf7;
  color: #8e8580;
  font-weight: 800;
  border-right: 1rpx solid #f7efe8;
  flex-shrink: 0;
}

.param-td {
  flex: 1;
  padding: 16rpx 20rpx;
  color: #2d211a;
  font-weight: 700;
}

/* 使用说明与建议卡片 */
.instruction-content {
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border-left: 6rpx solid #3b82f6;
}

.instruction-text {
  font-size: 25rpx;
  line-height: 1.7;
  color: #334155;
  white-space: pre-wrap;
}

/* 商品图文详情长图 */
.content-card {
  padding-bottom: 16rpx;
}

.desc-text-box {
  margin-bottom: 24rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fffaf4;
  color: #5c4e43;
  font-size: 26rpx;
  line-height: 1.7;
}

.detail-images-box {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin: 0 -28rpx;
}

.detail-img-item {
  width: 100%;
  display: flex;
}

.detail-long-image {
  width: 100%;
  display: block;
  transition: opacity 0.3s ease;
}

.image-preview-tip {
  padding: 24rpx 0 10rpx;
  text-align: center;
  color: #b8aaa0;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.desc-empty {
  padding: 40rpx 0;
  text-align: center;
  color: #b8aaa0;
  font-size: 24rpx;
}

/* 底部操作悬浮栏与动效 */
.detail-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -8rpx 30rpx rgba(123, 89, 62, 0.08);
  backdrop-filter: blur(16rpx);
  box-sizing: border-box;
}

.cart-entry-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.cart-entry-wrap:active {
  transform: scale(0.9);
}

.cart-bouncing {
  animation: cartBounce 0.6s ease-in-out;
}

@keyframes cartBounce {
  0% { transform: scale(1); }
  30% { transform: scale(1.35) rotate(-8deg); }
  60% { transform: scale(0.9) rotate(4deg); }
  80% { transform: scale(1.1) rotate(-2deg); }
  100% { transform: scale(1) rotate(0); }
}

.cart-icon-box {
  font-size: 38rpx;
  line-height: 1;
}

.cart-label {
  font-size: 20rpx;
  font-weight: 800;
  color: #7a6a5e;
  margin-top: 4rpx;
}

/* 步进器，彻底重置任何全局样式干扰 */
.qty-stepper {
  display: inline-flex;
  align-items: center;
  height: 64rpx;
  border-radius: 999rpx;
  background: #fdfaf6;
  border: 1rpx solid rgba(255, 122, 69, 0.2);
  padding: 0 4rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  overflow: hidden;
}

.step-btn {
  width: 52rpx !important;
  height: 52rpx !important;
  line-height: 52rpx !important;
  min-height: 0 !important;
  border-radius: 50% !important;
  background: #fff !important;
  color: #d45f22 !important;
  font-size: 28rpx !important;
  font-weight: 900 !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  box-shadow: 0 2rpx 8rpx rgba(123, 89, 62, 0.08) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  flex-shrink: 0;
}

.step-btn::after {
  border: 0 !important;
}

.step-btn:active {
  transform: scale(0.92);
}

.step-input,
.detail-qty input {
  width: 60rpx !important;
  height: 52rpx !important;
  min-height: 0 !important;
  line-height: 52rpx !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  box-shadow: none !important;
  text-align: center !important;
  font-size: 26rpx !important;
  font-weight: 950 !important;
  color: #2d211a !important;
  box-sizing: border-box !important;
}

/* 按钮组双拼圆角胶囊 */
.btn-group {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 61, 0.25);
}

.action-btn {
  flex: 1;
  height: 72rpx !important;
  line-height: 72rpx !important;
  min-height: 0 !important;
  border-radius: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  font-size: 25rpx !important;
  font-weight: 850 !important;
  border: none !important;
  text-align: center;
  box-sizing: border-box;
  transition: opacity 0.15s ease;
}

.action-btn::after {
  border: 0 !important;
}

.action-btn:active {
  opacity: 0.88;
}

.cart-action-btn {
  background: linear-gradient(135deg, #ffb86c, #ff9245) !important;
  color: #fff !important;
}

.buy-action-btn {
  background: linear-gradient(135deg, #ff7a45, #ff5000) !important;
  color: #fff !important;
}

.action-btn[disabled] {
  opacity: 0.5 !important;
  background: #d4cfcb !important;
  color: #fff !important;
}
