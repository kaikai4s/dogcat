px;border-radius:22rpx;background:#fff8ec;box-sizing:border-box}.modal-actions{display:flex;gap:16rpx;justify-content:flex-end;margin-top:20rpx}.modal-actions button{min-width:160rpx;height:68rpx;line-height:68rpx;border-radius:999rpx;font-size:25rpx}

/* ================== 用户端商城订单详情升级与物流时间轴动效 ================== */
.fade-in-page {
  animation: pageFadeIn 0.35s ease-out;
}

@keyframes pageFadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.order-detail-page {
  padding-bottom: 180rpx;
}

/* 顶部状态 Hero */
.status-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0cc 60%, #fff8f0 100%);
  border-radius: 36rpx;
  box-shadow: 0 16rpx 36rpx rgba(255, 122, 69, 0.1);
}

.hero-left {
  flex: 1;
}

.status-title {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 950;
  color: #2d211a;
}

.status-kicker {
  background: #ff7a45 !important;
  color: #fff !important;
  font-weight: 900;
}

.status-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
}

.status-emoji {
  font-size: 52rpx;
  line-height: 1;
}

/* 物流追踪核心卡片 */
.logistics-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1rpx solid rgba(255, 122, 69, 0.15);
  box-shadow: 0 14rpx 32rpx rgba(123, 89, 62, 0.06);
}

.logistics-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f7efe8;
}

.head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.logistics-title {
  font-size: 30rpx;
  font-weight: 950;
  color: #2d211a;
}

.logistics-state-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 850;
}

.badge-transit {
  background: #e0f2fe;
  color: #0284c7;
}

.badge-delivered {
  background: #dcfce7;
  color: #16a34a;
}

.head-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff8ec;
  color: #d45f22;
  font-size: 22rpx;
  font-weight: 850;
  border: 1rpx solid rgba(255, 122, 69, 0.18);
  transition: transform 0.2s ease;
}

.action-btn:active {
  transform: scale(0.94);
}

.refresh-btn.spinning .refresh-icon {
  animation: rotateSpin 0.8s linear infinite;
}

@keyframes rotateSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 快递信息条 */
.express-info-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #fdfaf6;
  border: 1rpx solid #f5ede4;
}

.express-company-name {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.company-text {
  font-size: 28rpx;
  font-weight: 950;
  color: #2d211a;
}

.tracking-text {
  font-size: 23rpx;
  font-weight: 700;
  color: #7a6a5e;
  font-family: monospace;
}

.express-tel {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 850;
}

/* 时间轴 */
.timeline-box {
  margin-top: 28rpx;
  padding-left: 8rpx;
}

.timeline-node {
  display: flex;
  position: relative;
  padding-bottom: 32rpx;
}

.timeline-node:last-child {
  padding-bottom: 8rpx;
}

.node-axis {
  width: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  flex-shrink: 0;
}

.node-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #d4cfcb;
  margin-top: 8rpx;
  z-index: 2;
  transition: all 0.3s ease;
}

.timeline-node.node-latest .node-dot {
  width: 26rpx;
  height: 26rpx;
  background: #10b981;
}

/* 雷达呼吸脉冲光环动画 */
.pulse-beacon {
  animation: beaconPulse 1.8s ease-in-out infinite;
}

@keyframes beaconPulse {
  0% {
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
  }
  60% {
    box-shadow: 0 0 0 16rpx rgba(16, 185, 129, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
  }
}

.node-line {
  position: absolute;
  top: 30rpx;
  bottom: 0;
  width: 2rpx;
  background: #e8e2dc;
  z-index: 1;
}

.node-body {
  flex: 1;
  margin-left: 16rpx;
}

.node-context {
  font-size: 26rpx;
  line-height: 1.55;
  color: #6b5e55;
}

.timeline-node.node-latest .node-context {
  color: #10b981;
  font-weight: 850;
  font-size: 27rpx;
}

.node-time {
  font-size: 22rpx;
  color: #a3978f;
  margin-top: 8rpx;
}

.logistics-loading-bar {
  padding: 36rpx 0;
  text-align: center;
  color: #8e8580;
  font-size: 25rpx;
}

.loading-spin {
  display: inline-block;
  margin-right: 10rpx;
  animation: spinIcon 1s linear infinite;
}

@keyframes spinIcon {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 按钮与底部栏 */
.items-count {
  font-size: 23rpx;
  color: #8e8580;
  font-weight: normal;
}

.item-detail {
  flex: 1;
  min-width: 0;
}

.pay-price {
  color: #ff5000;
  font-size: 38rpx;
  font-weight: 950;
}

/* ================== 底部操作悬浮条与等宽双按钮规范 ================== */
.bottom-bar {
  position: fixed !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  z-index: 30 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  gap: 20rpx !important;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)) !important;
  background: rgba(255, 255, 255, 0.96) !important;
  backdrop-filter: blur(20rpx) !important;
  box-shadow: 0 -8rpx 28rpx rgba(123, 89, 62, 0.08) !important;
  box-sizing: border-box !important;
}

.bottom-bar button {
  flex: 1 !important;
  width: auto !important;
  min-width: 0 !important;
  height: 84rpx !important;
  min-height: 84rpx !important;
  line-height: 84rpx !important;
  border-radius: 999rpx !important;
  font-size: 28rpx !important;
  font-weight: 850 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 0 !important;
  padding: 0 24rpx !important;
  box-sizing: border-box !important;
  text-align: center !important;
  transition: all 0.2s ease !important;
}

.bottom-bar button::after {
  border: none !important;
}

.bottom-bar button:active {
  transform: scale(0.98);
  opacity: 0.92;
}

.bottom-bar .ghost-btn {
  background: #ffffff !important;
  color: #7a6a5e !important;
  border: 2rpx solid #e5ded7 !important;
  box-shadow: 0 4rpx 14rpx rgba(123, 89, 62, 0.04) !important;
}

.bottom-bar .ghost-btn:active {
  background: #faf6f2 !important;
  border-color: #d8cec5 !important;
}

.bottom-bar .buy-btn,
.bottom-bar .primary {
  background: linear-gradient(135deg, #ff9a44, #ff6b3d) !important;
  color: #ffffff !important;
  border: none !important;
  box-shadow: 0 8rpx 22rpx rgba(255, 107, 61, 0.32) !important;
}

.bottom-bar .buy-btn:active,
.bottom-bar .primary:active {
  background: linear-gradient(135deg, #f28b35, #f55b2b) !important;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 61, 0.22) !important;
}

.refund-type-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  background: #ffede6;
  color: #ff5000;
  border-radius: 999rpx;
  font-weight: 700;
}

.highlight-text {
  color: #e65100;
  font-weight: 700;
  margin-top: 10rpx;
}

.return-address-box,
.return-express-box {
  margin-top: 18rpx;
  padding: 20rpx;
  background: #fffbf5;
  border: 1rpx dashed rgba(255, 122, 69, 0.35);
  border-radius: 18rpx;
}

.box-title {
  font-size: 26rpx;
  font-weight: 850;
  color: #2d211a;
  margin-bottom: 8rpx;
}

.box-content {
  font-size: 24rpx;
  color: #55443a;
  line-height: 1.45;
}

.box-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}

.small-btn {
  height: 56rpx !important;
  line-height: 56rpx !important;
  font-size: 23rpx !important;
  padding: 0 22rpx !important;
  margin: 0 !important;
  border-radius: 999rpx !important;
}

.type-pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.type-pill {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #f7f3ee;
  color: #7a6a5e;
  font-size: 24rpx;
  font-weight: 700;
  border: 1rpx solid transparent;
}

.type-pill.active {
  background: #fff0e6;
  color: #ff5000;
  border-color: #ff7a45;
  font-weight: 850;
}

.single-line-input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  background: #fff8ec;
  border-radius: 16rpx;
  font-size: 26rpx;
  margin-top: 10rpx;
  box-sizing: border-box;
}

