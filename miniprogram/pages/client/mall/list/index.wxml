<view wx:if="{{!configLoaded}}" class="mall-page"><view class="list-state">加载中...</view></view>
<view wx:elif="{{shopConfig.enabled && shopSupported && mallMode === 'shop'}}" class="shop-page">
  <view class="shop-bar">
    <view class="shop-bar-title">微信小店</view>
    <button class="shop-mode-switch" data-mode="local" bindtap="switchMallMode">平台商品</button>
  </view>
  <view wx:if="{{shopConfigError}}" class="shop-config-error">
    <text>小店状态暂时无法更新。</text><button bindtap="retryShopConfig">重试</button>
  </view>
  <store-home class="wechat-shop-home" appid="{{shopConfig.appid}}" />
</view>
<dovlin-refresh wx:else id="dovlinRefresh" bind:refresh="onCustomRefresh" bind:scrolltolower="onReachBottom">
<view class="mall-page">
  <view wx:if="{{shopConfigError}}" class="shop-config-error">
    <text>小店状态暂时无法更新。</text><button bindtap="retryShopConfig">重试</button>
  </view>
  <view wx:if="{{shopConfig.enabled && shopSupported}}" class="mall-mode-bar">
    <text>平台商品</text>
    <button class="shop-mode-switch" data-mode="shop" bindtap="switchMallMode">微信小店</button>
  </view>
  <view wx:if="{{shopConfig.enabled && !shopSupported}}" class="shop-unsupported">当前设备或微信版本暂不支持小店展示，请使用手机微信或升级微信。</view>
  <view class="mall-hero">
    <view class="mall-kicker">宠物用品商城</view>
    <view class="mall-title">给毛孩子挑点好物</view>
    <view class="mall-desc">主粮、零食、清洁用品一站选购。</view>
    <view class="mall-actions"><button bindtap="cart">购物车</button><button bindtap="orders">平台订单</button></view>
  </view>

  <view class="search-card">
    <input placeholder="搜索商品" value="{{keyword}}" bindinput="inputKeyword" confirm-type="search" bindconfirm="search" />
    <button bindtap="search">搜索</button>
  </view>

  <scroll-view scroll-x class="category-tabs">
    <view class="category-tab {{categoryId === '' ? 'active' : ''}}" data-id="" bindtap="chooseCategory">全部</view>
    <view class="category-tab {{categoryId === item._id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="_id" data-id="{{item._id}}" bindtap="chooseCategory">{{item.name}}</view>
  </scroll-view>

  <view class="sort-row">
    <view class="sort-chip {{sort === '' ? 'active' : ''}}" data-sort="" bindtap="chooseSort">默认</view>
    <view class="sort-chip {{sort === 'sales_desc' ? 'active' : ''}}" data-sort="sales_desc" bindtap="chooseSort">销量</view>
    <view class="sort-chip {{sort === 'price_asc' ? 'active' : ''}}" data-sort="price_asc" bindtap="chooseSort">价格升序</view>
    <view class="sort-chip {{sort === 'price_desc' ? 'active' : ''}}" data-sort="price_desc" bindtap="chooseSort">价格降序</view>
  </view>

  <view class="product-grid">
    <view class="product-card" wx:for="{{products}}" wx:key="_id">
      <image class="product-img" src="{{item.coverFileId || item.imageFileIds[0]}}" mode="aspectFill" data-id="{{item._id}}" bindtap="detail" />
      <view class="product-body" data-id="{{item._id}}" bindtap="detail">
        <view class="product-name">{{item.name}}</view>
        <view class="product-sub">{{item.subtitle || item.specText}}</view>
      </view>
      <view class="product-foot">
        <view class="price-block"><text class="price">{{item.priceText || item.displayPrice}}</text><text class="stock">库存{{item.totalStock || item.stock}}</text></view>
        <button class="cart-btn" data-id="{{item._id}}" data-index="{{index}}" bindtap="addCart" disabled="{{item.soldOut}}">{{item.soldOut ? '售罄' : (item.hasSku ? '选规格' : '加购')}}</button>
      </view>
    </view>
  </view>

  <view class="list-state" wx:if="{{loading}}">加载中...</view>
  <view class="empty" wx:if="{{!loading && !products.length}}">暂无商品</view>
</view>
</dovlin-refresh>
<global-loading />
