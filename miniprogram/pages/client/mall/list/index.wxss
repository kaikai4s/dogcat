.mall-page{min-height:100vh;padding:24rpx 24rpx 150rpx;background:linear-gradient(180deg,#fff8ec 0%,#fffaf6 45%,#f7fbfa 100%);color:#2d211a;box-sizing:border-box}.mall-hero{padding:34rpx;border-radius:36rpx;background:linear-gradient(135deg,#fff0c9 0%,#ffd9c8 55%,#fff5f0 100%);box-shadow:0 16rpx 36rpx rgba(123,89,62,.08)}.mall-hero.small{padding:28rpx}.mall-kicker{display:inline-flex;padding:8rpx 18rpx;border-radius:999rpx;background:rgba(255,255,255,.76);color:#d45f22;font-size:23rpx;font-weight:850}.mall-title,.page-title{margin-top:18rpx;font-size:42rpx;font-weight:950;line-height:1.2}.page-title{margin:8rpx 0 24rpx}.mall-desc{margin-top:10rpx;color:#7a6a5e;font-size:26rpx}.mall-actions{display:flex;gap:16rpx;margin-top:24rpx}.mall-actions button,.search-card button,.cart-btn,.bottom-bar button,.empty button{height:64rpx;line-height:64rpx;border-radius:999rpx;background:#fff;color:#d45f22;font-size:24rpx;font-weight:850}.search-card{display:flex;gap:14rpx;margin-top:22rpx;padding:16rpx;border-radius:28rpx;background:#fff;border:1rpx solid rgba(255,153,102,.14);box-shadow:0 10rpx 24rpx rgba(123,89,62,.05)}.search-card input{flex:1;height:64rpx;padding:0 18rpx;border-radius:999rpx;background:#fff8ec;font-size:26rpx}.category-tabs{white-space:nowrap;margin:22rpx -24rpx 0;padding:0 24rpx}.category-tab,.sort-chip{display:inline-flex;align-items:center;justify-content:center;margin-right:14rpx;padding:16rpx 24rpx;border-radius:999rpx;background:#fff;color:#8e8580;font-size:25rpx;font-weight:760;border:1rpx solid rgba(255,153,102,.14)}.category-tab.active,.sort-chip.active{color:#fff;background:linear-gradient(135deg,#ffb86c,#ff7a45);border-color:transparent}.sort-row{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:20rpx}.product-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx;margin-top:22rpx}.product-card,.checkout-card,.order-card,.cart-item{border-radius:30rpx;background:#fff;border:1rpx solid rgba(255,153,102,.12);box-shadow:0 12rpx 28rpx rgba(123,89,62,.05);overflow:hidden}.product-img{width:100%;height:250rpx;background:#fff0e2}.product-body{padding:18rpx 18rpx 8rpx}.product-name,.cart-name,.mini-name{font-size:28rpx;font-weight:900;line-height:1.35;color:#2d211a}.product-sub,.cart-sub,.mini-sub,.addr-text,.empty-line{margin-top:6rpx;color:#8e8580;font-size:23rpx;line-height:1.42}.product-foot{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:8rpx 18rpx 20rpx}.price,.detail-price,.sum-price{color:#e9672f;font-weight:950}.stock{display:block;margin-top:4rpx;color:#a89b92;font-size:21rpx}.cart-btn{min-width:104rpx;background:#fff0e2!important}.detail-swiper{height:560rpx;border-radius:34rpx;overflow:hidden;background:#fff}.detail-swiper image{width:100%;height:560rpx}.detail-card{margin-top:20rpx;padding:28rpx;border-radius:30rpx;background:#fff;border:1rpx solid rgba(255,153,102,.12)}.detail-price{font-size:44rpx}.detail-price text{margin-left:12rpx;color:#b8aaa0;font-size:24rpx;text-decoration:line-through}.detail-title{margin-top:14rpx;font-size:36rpx;font-weight:950}.detail-sub,.desc-text{margin-top:10rpx;color:#7a6a5e;font-size:26rpx;line-height:1.6}.detail-meta{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:18rpx}.detail-meta text,.badge{padding:8rpx 16rpx;border-radius:999rpx;background:#fff0e2;color:#d45f22;font-size:22rpx;font-weight:800}.section-title,.card-head{font-size:30rpx;font-weight:950}.bottom-bar{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));background:rgba(255,250,246,.96);box-shadow:0 -10rpx 30rpx rgba(123,89,62,.08);box-sizing:border-box}.bottom-bar .primary,.modal-actions .primary{color:#fff;background:linear-gradient(135deg,#ffb86c,#ff7a45)!important}.ghost{background:#fff!important;color:#d45f22!important}.qty-box{display:flex;align-items:center;gap:10rpx}.qty-box button{width:58rpx;height:58rpx;line-height:58rpx;border-radius:18rpx;background:#fff0e2;color:#d45f22}.qty-box input{width:70rpx;text-align:center;font-weight:900}.cart-item{display:flex;align-items:center;gap:18rpx;margin-top:18rpx;padding:18rpx}.cart-item image,.mini-item image{width:118rpx;height:118rpx;border-radius:22rpx;background:#fff0e2;flex-shrink:0}.check{width:42rpx;height:42rpx;line-height:42rpx;text-align:center;border-radius:999rpx;background:#f2ede8;color:transparent;font-size:24rpx}.check.active{background:#ff7a45;color:#fff}.cart-main{flex:1;min-width:0}.cart-row{display:flex;align-items:center;justify-content:space-between;margin-top:14rpx}.remove{width:64rpx!important;height:58rpx!important;line-height:58rpx!important;border-radius:18rpx!important;background:#fef2f2!important;color:#dc2626!important;font-size:22rpx!important}.sum-label{font-size:22rpx;color:#8e8580}.checkout-card,.order-card{margin-top:18rpx;padding:24rpx}.card-head,.order-head,.order-foot{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.card-head text{color:#d45f22;font-size:24rpx}.addr-name{margin-top:14rpx;font-size:28rpx;font-weight:900}.mini-item{display:flex;align-items:center;gap:16rpx;margin-top:18rpx}.mini-item>view{flex:1;min-width:0}.picker-line{margin-top:16rpx;padding:20rpx;border-radius:20rpx;background:#fff8ec;color:#7a6a5e}.amount-card>view{display:flex;justify-content:space-between;margin-top:14rpx;color:#7a6a5e;font-size:25rpx}.amount-card .pay-line{padding-top:16rpx;border-top:1rpx solid #f2e6dc;color:#2d211a;font-size:30rpx;font-weight:950}.list-state,.empty{margin-top:40rpx;text-align:center;color:#8e8580;font-size:26rpx}.empty button{margin-top:18rpx;width:220rpx}.modal-mask{position:fixed;inset:0;z-index:40;display:flex;align-items:flex-end;background:rgba(0,0,0,.35)}.modal-card{width:100%;padding:28rpx;border-top-left-radius:34rpx;border-top-right-radius:34rpx;background:#fff;box-sizing:border-box}.modal-card textarea{width:100%;height:180rpx;padding:18rpx;border-radius:22rpx;background:#fff8ec;box-sizing:border-box}.modal-actions{display:flex;gap:16rpx;justify-content:flex-end;margin-top:20rpx}.modal-actions button{min-width:160rpx;height:68rpx;line-height:68rpx;border-radius:999rpx;font-size:25rpx}
