/* Client profile: identity, assets, grouped menus and settings architecture */
.profile-page,
.profile-settings-page {
  min-height: 100vh;
  padding: 0 0 178rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  overflow-x: hidden;
}

.profile-page::before,
.profile-page::after,
.profile-hero::before,
.profile-hero::after {
  display: none !important;
  content: none !important;
}

.profile-page .remix-icon,
.profile-settings-page .remix-icon {
  position: relative;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  color: #ff8a45;
  font-size: 40rpx;
  border: none !important;
  outline: none !important;
  box-shadow: none !important;
  background: transparent !important;
}

.profile-page .remix-icon::before,
.profile-settings-page .remix-icon::before {
  font-family: "remixicon" !important;
  font-size: inherit;
  line-height: 1;
}

.settings-hero,
.profile-hero {
  position: relative;
  padding: 34rpx 30rpx 42rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background:
    radial-gradient(circle at 90% 18%, rgba(255, 255, 255, 0.50) 0 64rpx, transparent 65rpx),
    radial-gradient(circle at 12% 74%, rgba(114, 211, 183, 0.16) 0 74rpx, transparent 75rpx),
    linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.settings-kicker {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  font-weight: 850;
}

.settings-title {
  margin-top: 20rpx;
  color: #2d211a;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.18;
}

.settings-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 26rpx;
  line-height: 1.45;
}

.settings-section,
.asset-card,
.menu-section,
.guest-card,
.quick-card,
.modal-card {
  margin: 24rpx 28rpx 0;
  padding: 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.settings-section-title,
.menu-section-title {
  margin-bottom: 10rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
}

.settings-row,
.menu-item,
.guest-card,
.asset-head,
.quick-card,
.menu-left,
.menu-right-wrap,
.profile-hero,
.profile-name-row,
.info-row {
  display: flex;
  align-items: center;
}

.settings-row {
  min-height: 104rpx;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.12);
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-row-main {
  flex: 1;
  min-width: 0;
}

.settings-label,
.strong {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.settings-help,
.muted,
.modal-tip,
.profile-points {
  margin-top: 6rpx;
  color: #8e8580;
  font-size: 24rpx;
  line-height: 1.42;
}

.font-preview {
  margin-top: 8rpx;
  color: #2d211a;
  font-size: 27rpx;
  font-weight: 850;
}

.settings-value,
.settings-arrow,
.menu-arrow,
.menu-right-info {
  flex-shrink: 0;
  color: #d45f22;
  font-size: 25rpx;
  font-weight: 850;
}

.settings-arrow,
.menu-arrow {
  color: #b8aaa0;
  font-size: 48rpx;
  line-height: 1;
}

.settings-logout {
  width: 520rpx;
  min-height: 92rpx;
  margin: 42rpx auto 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-size: 30rpx;
  font-weight: 950;
  box-shadow: 0 14rpx 32rpx rgba(255, 122, 69, 0.22);
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 100%;
}

.profile-hero-top {
  display: flex;
  align-items: center;
  gap: 22rpx;
  width: 100%;
}

.profile-level-tag-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 12rpx;
  margin-top: 10rpx;
  max-width: 100%;
}

.profile-level-mini-badge {
  flex-shrink: 0;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 38rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8a45 0%, #e9672f 100%);
  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  box-sizing: border-box;
}

.profile-level-mini-detail {
  flex-shrink: 0;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  height: 38rpx;
  color: #d45f22;
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1;
}

.profile-avatar-wrap {
  position: relative;
  flex-shrink: 0;
  width: 132rpx;
  height: 132rpx;
}

.profile-avatar {
  width: 132rpx !important;
  height: 132rpx !important;
  max-width: 132rpx !important;
  max-height: 132rpx !important;
  border-radius: 36rpx !important;
  background: linear-gradient(180deg, #ffffff 0%, #fff8e8 100%);
  box-shadow: 0 16rpx 36rpx rgba(123, 89, 62, 0.12);
  overflow: hidden;
  box-sizing: border-box;
  flex-shrink: 0;
}

.profile-avatar.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9672f;
  width: 132rpx !important;
  height: 132rpx !important;
  min-height: 132rpx !important;
  padding: 0 !important;
  gap: 0 !important;
  text-align: initial !important;
}

.profile-avatar.empty::before {
  display: none !important;
  content: none !important;
}

.profile-avatar.empty .remix-icon {
  width: 70rpx !important;
  height: 70rpx !important;
  font-size: 70rpx !important;
  line-height: 1 !important;
  color: #e9672f !important;
  background: transparent !important;
}


.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  gap: 12rpx;
  flex-wrap: wrap;
  padding-right: 150rpx;
  box-sizing: border-box;
}

.profile-name {
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #2d211a;
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1.2;
}

.profile-name-row .member-badge {
  vertical-align: middle;
}

.profile-level {
  margin-top: 8rpx;
  color: #e9672f;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 800;
}

.checkin-pill {
  position: absolute;
  right: 30rpx;
  top: 36rpx;
  z-index: 2;
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 69, 0.24);
  white-space: nowrap;
}

.guest-card {
  gap: 18rpx;
}

.guest-card .compact-btn {
  flex-shrink: 0;
  min-width: 220rpx;
}

.guest-icon,
.asset-icon,
.quick-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 24rpx;
  color: #e9672f;
  background: #fff0e2;
  box-shadow: inset 0 -8rpx 18rpx rgba(255, 184, 108, 0.12);
}

.guest-main {
  flex: 1;
  min-width: 0;
}

.compact-btn,
.profile-primary-btn,
.profile-ghost-btn {
  min-height: 76rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
}

.profile-primary-btn {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  box-shadow: 0 12rpx 26rpx rgba(255, 122, 69, 0.20);
}

.profile-ghost-btn {
  color: #d45f22;
  background: #fff0e2;
}

.asset-card {
  background:
    radial-gradient(circle at 92% 18%, rgba(255, 184, 108, 0.16) 0 56rpx, transparent 57rpx),
    linear-gradient(135deg, #fff8e8 0%, #ffffff 100%);
}

.asset-head {
  justify-content: space-between;
  gap: 18rpx;
}

.asset-icon {
  width: 78rpx;
  height: 78rpx;
}

.quick-card-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin: 24rpx 28rpx 0;
}

.quick-card {
  min-height: 180rpx;
  margin: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 18rpx;
}

.quick-icon.green {
  color: #18a87c;
  background: #eafaf3;
}

.quick-icon.orange {
  color: #e9672f;
  background: #fff0e2;
}

.menu-section {
  padding: 28rpx 20rpx 26rpx;
}

.profile-grid-panel {
  display: grid;
  gap: 24rpx 6rpx;
  width: 100%;
  box-sizing: border-box;
  padding-top: 10rpx;
}

.profile-grid-panel.cols-4 {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.profile-grid-panel.cols-5 {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

.profile-grid-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  position: relative;
  isolation: isolate;
}

.profile-icon-wrap {
  position: relative;
  z-index: 1;
  width: 78rpx;
  height: 78rpx;
  border-radius: 28rpx;
  background: #fff8e8;
  color: #e9672f;
  box-shadow: inset 0 -8rpx 18rpx rgba(255, 184, 108, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.profile-icon-wrap .remix-icon {
  color: inherit !important;
  font-size: 40rpx !important;
  width: 40rpx !important;
  height: 40rpx !important;
  line-height: 1 !important;
  background: transparent !important;
}

.profile-icon-wrap.green { color: #18a87c; background: #eafaf3; }
.profile-icon-wrap.peach { color: #d45f22; background: #fff0e2; }
.profile-icon-wrap.orange { color: #ff7d00; background: #fff4df; }
.profile-icon-wrap.blue { color: #3b82f6; background: #eff6ff; }
.profile-icon-wrap.purple { color: #8b5cf6; background: #f5f0ff; }
.profile-icon-wrap.coral { color: #ff5722; background: #fff0eb; }
.profile-icon-wrap.red { color: #ef4444; background: #fef2f2; }
.profile-icon-wrap.teal { color: #07c160; background: #e8faf0; }

.profile-grid-label {
  position: relative;
  z-index: 10;
  margin-top: 12rpx;
  max-width: 128rpx;
  color: #5f5650;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 8rpx;
  padding: 0 4rpx;
  font-size: 22rpx;
  font-weight: 760;
  line-height: 1.25;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-grid-label.danger-text {
  color: #e53e3e;
}

.profile-badge-pill {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff9f43 0%, #ff6b35 100%);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 28rpx;
  text-align: center;
  white-space: nowrap;
  box-shadow: 0 4rpx 10rpx rgba(255, 107, 53, 0.35);
  border: 2rpx solid #ffffff;
  z-index: 2;
  box-sizing: border-box;
}

.profile-badge-pill.danger {
  background: linear-gradient(135deg, #ff4d4f 0%, #f5222d 100%);
  box-shadow: 0 4rpx 10rpx rgba(245, 34, 45, 0.35);
}

.profile-badge-pill.info {
  background: linear-gradient(135deg, #ff9800 0%, #e65100 100%);
  box-shadow: 0 4rpx 10rpx rgba(230, 81, 0, 0.35);
  max-width: 86rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.profile-badge-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff4d4f;
  border: 2rpx solid #ffffff;
  z-index: 2;
}

.menu-item {
  min-height: 104rpx;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.12);
  color: #2d211a;
  font-size: 29rpx;
  font-weight: 850;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-left {
  min-width: 0;
  flex: 1;
  gap: 16rpx;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  background: transparent !important;
  box-shadow: none !important;
  border: none !important;
  outline: none !important;
  border-radius: 0 !important;
  color: #ff7a45;
}

.menu-icon.danger {
  color: #f53f3f;
  background: transparent !important;
  border: none !important;
}

.menu-right-wrap {
  gap: 12rpx;
}

.menu-dot,
.nav-red-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #f53f3f;
  box-shadow: 0 0 0 5rpx rgba(245, 63, 63, 0.12);
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 30000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 28rpx;
  background: rgba(45, 33, 26, 0.38);
}

.modal-card {
  width: 100%;
  margin: 0 0 calc(18rpx + env(safe-area-inset-bottom));
  padding: 34rpx 30rpx 30rpx;
  border-radius: 38rpx;
}

.modal-title {
  color: #2d211a;
  font-size: 34rpx;
  font-weight: 950;
}

.info-list,
.form-item,
.modal-actions {
  margin-top: 20rpx;
}

.info-row {
  justify-content: space-between;
  gap: 18rpx;
  min-height: 72rpx;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.12);
}

.info-row:last-child {
  border-bottom: 0;
}

.label {
  color: #8e8580;
  font-size: 24rpx;
}

.value {
  color: #2d211a;
  font-size: 26rpx;
  font-weight: 850;
}

.two-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.modal-actions .profile-primary-btn,
.modal-actions .profile-ghost-btn {
  width: 100%;
  min-height: 84rpx;
  margin-top: 12rpx;
}

.two-actions .profile-primary-btn,
.two-actions .profile-ghost-btn {
  margin-top: 0;
}

.feedback-textarea,
.feedback-input {
  width: 100%;
  border-radius: 26rpx;
  color: #2d211a;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.16);
  font-size: 27rpx;
}

.feedback-textarea {
  height: 190rpx;
  padding: 22rpx;
  line-height: 1.45;
}

.feedback-input {
  min-height: 88rpx;
  padding: 0 22rpx;
}

.client-bottom-nav {
  border-top: 1rpx solid rgba(255, 153, 102, 0.12);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 36rpx rgba(123, 89, 62, 0.08);
}

.client-bottom-nav .nav-item {
  color: #8e8580;
}

.client-bottom-nav .nav-item.active {
  color: #e9672f;
  font-weight: 850;
}

.client-bottom-nav .nav-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}


.client-bottom-nav .nav-red-dot {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
}

.interactive:active,
button:active,
.nav-item:active {
  transform: scale(0.985);
  opacity: 0.86;
}
