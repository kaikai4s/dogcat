.profile-card .strong {
  font-size: 24rpx;
}

.profile-card .muted {
  font-size: 18rpx;
}

.guest-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.guest-panel .compact-btn {
  flex-shrink: 0;
}

.profile-settings-page {
  min-height: 100vh;
  background: var(--theme-bg);
  color: var(--theme-text);
  padding: 0 0 80rpx;
  overflow: hidden;
}

.settings-card {
  margin-top: 0;
  background: var(--theme-card-bg);
}

.privacy-card {
  margin-top: 64rpx;
}

.settings-row {
  min-height: 112rpx;
  margin-left: 24rpx;
  padding: 0 20rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--theme-border);
  font-size: 34rpx;
  color: var(--theme-text);
}

.settings-row:last-child {
  border-bottom: none;
}

.settings-arrow,
.settings-value {
  color: var(--theme-muted);
  font-size: 28rpx;
  font-weight: 500;
}

.settings-arrow {
  font-size: 52rpx;
  font-weight: 300;
}

.settings-logout {
  width: 608rpx;
  height: 96rpx;
  margin: 126rpx auto 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--theme-primary);
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 500;
}

.settings-logout:active,
.settings-row:active {
  opacity: 0.75;
}

.menu-right-info {
  color: var(--theme-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.menu-right-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ff4d6d;
  box-shadow: 0 0 0 6rpx rgba(255, 77, 109, 0.12);
}
