<wxs module="beijingTime" src="../../../../utils/beijing-time.wxs" />
<view class="{{themeClass}} {{fontClass}} page assets-page">
  <view class="asset-hero card">
    <view class="hero-topline">
      <view>
        <view class="hero-kicker">我的资产</view>
        <view class="hero-title">可提现余额</view>
      </view>
      <view class="hero-badge">微信零钱</view>
    </view>
    <view class="balance-line">
      <text class="currency">¥</text>
      <text class="amount">{{summary.availableAmount || '0.00'}}</text>
    </view>
    <view class="hero-tip">最低提现 ¥{{summary.minWithdrawAmount || 0}}，提现申请提交后由平台审核处理</view>
    <view wx:if="{{summary && summary.wechatTransferQuota}}" class="quota-tip">今日平台剩余额度：{{summary.wechatTransferQuota.platformDailyRemainingAmount === null ? '不限' : '¥' + summary.wechatTransferQuota.platformDailyRemainingAmount}}</view>
    <view class="withdraw-rules-card" wx:if="{{summary && summary.withdrawalRules}}">
      <view class="withdraw-rules-title"><view><text class="remix-icon ri-file-list-3-line"></text><text>提现规则</text></view><text class="withdraw-rules-caption">提交前请先阅读</text></view>
      <view class="withdraw-rule-metrics">
        <view class="withdraw-rule-metric"><text class="metric-value">{{summary.withdrawalRules.minAmountText}} - {{summary.withdrawalRules.singleMaxAmountText}}</text><text class="metric-label">单笔金额</text></view>
        <view class="withdraw-rule-metric"><text class="metric-value metric-count-value">{{summary.withdrawalRules.dailyCountText}}</text><text class="metric-label">每日次数</text></view>
      </view>
      <view class="withdraw-rule-list">
        <view class="withdraw-rule-item"><text class="remix-icon ri-calendar-check-line"></text><view><text class="rule-item-label">每日额度</text><text class="rule-item-desc">{{summary.withdrawalRules.dailyAmountText}}</text></view></view>
        <view class="withdraw-rule-item"><text class="remix-icon ri-time-line"></text><view><text class="rule-item-label">申请时间</text><text class="rule-item-desc">{{summary.withdrawalRules.requestTimeText}}</text></view></view>
        <view class="withdraw-rule-item"><text class="remix-icon ri-shield-check-line"></text><view><text class="rule-item-label">审核与到账</text><text class="rule-item-desc">{{summary.withdrawalRules.auditTimeText}}；{{summary.withdrawalRules.arrivalTimeText}}</text></view></view>
      </view>
      <view class="withdraw-rule-note">{{summary.withdrawalRules.settlementText}}</view>
    </view>
    <view class="withdraw-input-row">
      <text class="withdraw-input-prefix">¥</text>
      <input class="withdraw-input" type="digit" value="{{withdrawAmount}}" bindinput="inputWithdrawAmount" placeholder="输入提现金额" />
    </view>
    <button class="withdraw-btn" bindtap="withdraw" loading="{{withdrawing}}" disabled="{{withdrawing || !summary || summary.availableAmount < summary.minWithdrawAmount}}">提现到微信零钱</button>
  </view>

  <view class="invite-card card">
    <view class="section-head">
      <view>
        <view class="section-title">我的邀请码</view>
        <view class="section-subtitle">好友绑定邀请码并建立宠物档案后获得佣金</view>
      </view>
      <button wx:if="{{!invitationMaintenance && !maintenanceLoading}}" class="share-btn" open-type="share">分享邀请</button>
    </view>
    <view wx:if="{{invitationMaintenance && !maintenanceLoading}}" class="invitation-maintenance-tip" role="alert">分享赚取佣金功能暂时不可使用，正在维护中。历史收益与提现不受影响。</view>
    <view wx:if="{{!invitationMaintenance && !maintenanceLoading}}" class="code-box">
      <text class="invite-code">{{inviteCode || '生成中'}}</text>
      <button class="copy-code-btn" bindtap="copyInviteCode" disabled="{{!inviteCode}}">复制邀请码</button>
    </view>
    <view class="invitation-rule-tip" wx:if="{{summary && summary.invitationMaxRewardPerUser > 0}}">每人累计邀请佣金最多 ¥{{summary.invitationMaxRewardPerUser}}（已提现佣金也计入）</view>
    <view wx:if="{{!invitationMaintenance && !maintenanceLoading && (!summary || !summary.inviterOpenid)}}" class="bind-row">
      <input class="bind-input" placeholder="输入他人邀请码" value="{{bindCode}}" bindinput="inputBindCode" />
      <button class="bind-btn" bindtap="bindInvite">绑定</button>
    </view>
    <view wx:elif="{{summary && summary.inviterOpenid}}" class="bound-tip">
      <text class="remix-icon ri-checkbox-circle-fill"></text>
      <view class="bound-text">
        <view>已绑定邀请码，绑定后不可修改。</view>
        <view class="bound-code" wx:if="{{summary.boundInviteCode}}">绑定的邀请码：{{summary.boundInviteCode}}</view>
      </view>
    </view>
  </view>

  <!-- 待确认收款快捷提示条 (当未在提现记录栏位时突出显示) -->
  <view class="pending-confirm-banner" wx:if="{{hasPendingWithdrawConfirm && activeTab !== 'withdraws'}}" bindtap="goToWithdrawsTab">
    <view class="banner-left">
      <text class="remix-icon ri-alarm-warning-fill banner-icon"></text>
      <text class="banner-text">您有提现申请待微信零钱确认收款</text>
    </view>
    <view class="banner-right">
      <text>前往确认</text>
      <text class="remix-icon ri-arrow-right-s-line"></text>
    </view>
  </view>

  <!-- 记录栏位切换卡片 -->
  <view class="records-card card">
    <!-- 栏位切换 Tab Bar -->
    <view class="records-tab-bar">
      <view class="records-tab {{activeTab === 'invites' ? 'active' : ''}}" data-tab="invites" bindtap="switchRecordTab">
        <text>邀请记录</text>
        <text class="tab-count" wx:if="{{summary && summary.invites && summary.invites.length}}">({{summary.invites.length}})</text>
      </view>
      <view class="records-tab {{activeTab === 'earnings' ? 'active' : ''}}" data-tab="earnings" bindtap="switchRecordTab">
        <text>收益明细</text>
        <text class="tab-count" wx:if="{{summary && summary.earnings && summary.earnings.length}}">({{summary.earnings.length}})</text>
      </view>
      <view class="records-tab {{activeTab === 'withdraws' ? 'active' : ''}}" data-tab="withdraws" bindtap="switchRecordTab">
        <text>提现记录</text>
        <text class="tab-count" wx:if="{{summary && summary.withdraws && summary.withdraws.length}}">({{summary.withdraws.length}})</text>
        <view class="tab-dot" wx:if="{{hasPendingWithdrawConfirm}}"></view>
      </view>
    </view>

    <!-- Tab 1: 邀请记录 -->
    <block wx:if="{{activeTab === 'invites'}}">
      <view wx:if="{{!summary || !summary.invites || !summary.invites.length}}" class="empty-state">
        <view class="empty-icon remix-icon ri-user-add-line"></view>
        <view class="empty-text">暂无邀请绑定记录</view>
      </view>
      <view wx:else class="record-list">
        <view wx:for="{{summary.invites}}" wx:key="_id" class="record-row invite-record-row">
          <image wx:if="{{item.invitedAvatarUrl}}" class="invite-avatar" src="{{item.invitedAvatarUrl}}" mode="aspectFill" />
          <view wx:else class="invite-avatar placeholder remix-icon ri-user-smile-line"></view>
          <view class="record-main">
            <view class="record-title">{{item.invitedNickname || '好友'}} 绑定了邀请码</view>
            <view class="record-time">{{item.invitedOpenidMasked ? item.invitedOpenidMasked + ' · ' : ''}}{{beijingTime.format(item.createdAt)}}</view>
          </view>
          <view class="invite-reward">
            <text class="reward-amount" wx:if="{{item.rewardStatus === 'success'}}">+¥{{item.rewardAmount || 0}}</text>
            <text class="status-pill {{item.rewardStatus || 'pending'}}">{{item.rewardStatusText || '待入账'}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- Tab 2: 收益明细 -->
    <block wx:if="{{activeTab === 'earnings'}}">
      <view wx:if="{{!summary || !summary.earnings || !summary.earnings.length}}" class="empty-state">
        <view class="empty-icon remix-icon ri-seedling-line"></view>
        <view class="empty-text">暂无收益记录</view>
      </view>
      <view wx:else class="record-list">
        <view wx:for="{{summary.earnings}}" wx:key="_id" class="record-row">
          <view class="record-main">
            <view class="record-title">{{item.sourceType === 'invite_binding' ? '邀请活动佣金' : item.sourceType}}</view>
            <view class="record-time">{{beijingTime.format(item.createdAt)}}</view>
          </view>
          <text class="income-amount">+¥{{item.amount}}</text>
        </view>
      </view>
    </block>

    <!-- Tab 3: 提现记录 -->
    <block wx:if="{{activeTab === 'withdraws'}}">
      <view class="withdraw-hint-box" wx:if="{{transferNotice}}">
        <text class="remix-icon ri-information-line"></text>
        <text>{{transferNotice}}</text>
      </view>

      <view wx:if="{{!summary || !summary.withdraws || !summary.withdraws.length}}" class="empty-state">
        <view class="empty-icon remix-icon ri-wallet-3-line"></view>
        <view class="empty-text">暂无提现记录</view>
      </view>
      <view wx:else class="withdraw-card-list">
        <view wx:for="{{summary.withdraws}}" wx:key="_id" class="withdraw-item-card">
          <view class="withdraw-item-head">
            <view class="withdraw-item-amount-wrap">
              <text class="withdraw-item-label">提现金额</text>
              <text class="withdraw-item-amount">¥{{item.amountText || item.amount}}</text>
            </view>
            <view class="status-pill {{item.status === 'paid' ? 'success' : (item.status === 'rejected' || item.status === 'transfer_failed' ? 'danger' : (item.canConfirmTransfer ? 'pending' : 'pending'))}}">
              {{item.statusText || '处理中'}}
            </view>
          </view>

          <!-- 待收款确认按钮 -->
          <button class="confirm-transfer-btn"
                  wx:if="{{item.canConfirmTransfer}}"
                  disabled="{{transferBusy || confirmingId === item._id}}"
                  loading="{{confirmingId === item._id}}"
                  data-id="{{item._id}}"
                  bindtap="confirmWithdrawTransfer">
            <text class="remix-icon ri-wechat-pay-line" wx:if="{{confirmingId !== item._id}}"></text>
            <text>{{confirmingId === item._id ? '正在同步到账状态...' : '点击完成微信零钱确认收款'}}</text>
          </button>

          <!-- 查询微信打款状态按钮 -->
          <button class="query-transfer-btn"
                  wx:if="{{item.status === 'transferring'}}"
                  disabled="{{transferBusy || confirmingId === item._id}}"
                  data-id="{{item._id}}"
                  bindtap="queryWithdrawTransfer">
            <text class="remix-icon ri-refresh-line"></text>
            <text>查询微信转账状态</text>
          </button>

          <view class="withdraw-hint-box" wx:if="{{item.status === 'transferring' && !item.canConfirmTransfer}}" style="margin-top: 16rpx; padding: 16rpx 20rpx; background: #f0fdf4; border-radius: 12rpx; color: #166534; font-size: 24rpx; display: flex; align-items: center; gap: 8rpx;">
            <text class="remix-icon ri-information-line"></text>
            <text>后台审核已通过，系统已自动发起微信打款，资金将自动转入微信零钱，无需手动确认。</text>
          </view>

          <!-- 提现详情明细 -->
          <view class="withdraw-item-details">
            <view class="detail-row">
              <text class="detail-label">申请时间</text>
              <text class="detail-value">{{beijingTime.format(item.createdAt)}}</text>
            </view>
            <view class="detail-row" wx:if="{{item.wechatTransferState}}">
              <text class="detail-label">微信处理状态</text>
              <text class="detail-value {{item.wechatTransferState === 'WAIT_USER_CONFIRM' ? 'text-highlight' : ''}}">{{item.wechatTransferStateText || item.wechatTransferState}}</text>
            </view>
            <view class="detail-row" wx:if="{{item.auditRemark}}">
              <text class="detail-label">审核备注</text>
              <text class="detail-value">{{item.auditRemark}}</text>
            </view>
            <view class="detail-row" wx:if="{{item.failureReason}}">
              <text class="detail-label">失败原因</text>
              <text class="detail-value text-danger">{{item.failureReason}}</text>
            </view>
            <view class="detail-row" wx:if="{{item.paidAt}}">
              <text class="detail-label">到账时间</text>
              <text class="detail-value">{{beijingTime.format(item.paidAt)}}</text>
            </view>
            <view class="detail-row" wx:if="{{item.status !== 'paid' && item.updatedAt}}">
              <text class="detail-label">最近处理</text>
              <text class="detail-value">{{beijingTime.format(item.updatedAt)}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
