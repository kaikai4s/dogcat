<wxs module="beijingTime" src="../../../../utils/beijing-time.wxs" />
<view class="page assets-page">
  <view class="card hero"><view class="eyebrow">我的资产</view><view class="amount">¥{{summary.availableAmount || '0.00'}}</view><view class="muted">可提现余额 · 最低提现 ¥{{summary.minWithdrawAmount || 0}}</view><button class="primary" bindtap="withdraw" loading="{{withdrawing}}" disabled="{{withdrawing || !summary || summary.availableAmount < summary.minWithdrawAmount}}">提现到微信零钱</button></view>
  <view class="card"><view class="card-title">我的邀请码</view><view class="invite-code">{{inviteCode}}</view><button class="ghost" open-type="share">分享邀请</button><view wx:if="{{!summary.inviterOpenid}}" class="bind-row"><input placeholder="输入他人邀请码" value="{{bindCode}}" bindinput="inputBindCode" /><button class="primary small" bindtap="bindInvite">绑定</button></view><view wx:else class="muted">已绑定邀请码，绑定后不可修改。</view></view>
  <view class="card"><view class="card-title">收益明细</view><view wx:if="{{!summary.earnings.length}}" class="muted">暂无收益记录</view><view wx:for="{{summary.earnings}}" wx:key="_id" class="row"><view><text>{{item.sourceType === 'invite_binding' ? '邀请绑定收益' : item.sourceType}}</text><view class="muted">{{beijingTime.format(item.createdAt)}}</view></view><text class="income">+¥{{item.amount}}</text></view></view>
  <view class="card"><view class="card-title">提现记录</view><view wx:if="{{!summary.withdraws.length}}" class="muted">暂无提现记录</view><view wx:for="{{summary.withdraws}}" wx:key="_id" class="row"><view><text>{{item.status === 'paid' ? '已到账' : item.status === 'rejected' ? '已驳回' : '处理中'}}</text><view class="muted">{{beijingTime.format(item.createdAt)}}</view></view><text>¥{{item.amount}}</text></view></view>
</view>
