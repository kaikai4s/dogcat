.assets-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff7eb 0%, #fffaf3 46%, #fff7ef 100%);
}

.assets-page .card {
  margin-bottom: 22rpx;
  border-radius: 34rpx;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 42rpx rgba(123, 89, 62, 0.08);
  overflow: hidden;
}

.asset-hero {
  position: relative;
  padding: 34rpx 30rpx 30rpx;
  background: radial-gradient(circle at 86% 10%, rgba(255, 184, 108, 0.35), transparent 30%),
    linear-gradient(145deg, #fffaf2 0%, #fff0df 52%, #ffe5dc 100%);
}

.asset-hero::after {
  content: '';
  position: absolute;
  right: -46rpx;
  bottom: -58rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: rgba(255, 122, 69, 0.1);
}

.hero-topline,
.section-head,
.record-row,
.bound-tip {
  display: flex;
  align-items: center;
}

.hero-topline,
.section-head,
.record-row {
  justify-content: space-between;
  gap: 20rpx;
}

.hero-kicker,
.section-subtitle,
.record-time,
.hero-tip {
  color: #8e8172;
}

.hero-kicker {
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 8rpx;
  color: #2d211a;
  font-size: 32rpx;
  font-weight: 950;
}

.hero-badge {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #9a5a00;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(255, 159, 67, 0.2);
  font-size: 22rpx;
  font-weight: 900;
}

.balance-line {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  margin: 28rpx 0 12rpx;
  color: #2d211a;
  line-height: 1;
}

.currency {
  margin: 0 8rpx 8rpx 0;
  font-size: 34rpx;
  font-weight: 950;
}

.amount {
  font-size: 78rpx;
  font-weight: 950;
  letter-spacing: -2rpx;
}

.hero-tip,
.quota-tip {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  line-height: 1.5;
}

.quota-tip {
  margin-top: 10rpx;
  color: #9a5a00;
}

.withdraw-input-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 78rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.76);
  border: 1rpx solid rgba(255, 122, 69, 0.14);
  box-sizing: border-box;
}

.withdraw-input-prefix {
  color: #ea580c;
  font-size: 30rpx;
  font-weight: 950;
}

.withdraw-input {
  flex: 1;
  min-width: 0;
  height: 78rpx;
  min-height: 0;
  margin: 0;
  padding: 0;
  color: #2d211a;
  background: transparent !important;
  border: 0 !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 78rpx;
}

.withdraw-btn,
.share-btn,
.bind-btn {
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-weight: 950;
  box-sizing: border-box;
}

.withdraw-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 88rpx;
  margin-top: 30rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff7a45 0%, #ea580c 100%);
  box-shadow: 0 16rpx 30rpx rgba(234, 88, 12, 0.2);
  font-size: 28rpx;
}

.withdraw-btn[disabled] {
  color: #c2b7ad;
  background: #f5eee8;
  box-shadow: none;
}

.invite-card,
.records-card {
  padding: 30rpx;
}

.section-head.compact {
  align-items: flex-start;
}

.section-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
}

.section-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.35;
}

.share-btn {
  flex-shrink: 0;
  min-width: 154rpx;
  min-height: 62rpx;
  padding: 0 24rpx;
  color: #7c4a2e;
  background: #fff1e1;
  border: 1rpx solid rgba(255, 122, 69, 0.16);
  font-size: 24rpx;
  box-shadow: none;
}

.code-box {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #fff8f0 0%, #fff1e6 100%);
  border: 1rpx dashed rgba(124, 74, 46, 0.18);
}

.invite-code {
  display: block;
  width: 100%;
  color: #2d211a;
  font-size: 40rpx;
  font-weight: 950;
  letter-spacing: 7rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.copy-code-btn {
  width: 100%;
  min-height: 58rpx;
  margin: 18rpx 0 0;
  padding: 0 22rpx;
  border: 0;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ea580c;
  background: rgba(255, 255, 255, 0.76);
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1;
}

.copy-code-btn[disabled] {
  color: #c2b7ad;
  background: rgba(255, 255, 255, 0.52);
}

.bind-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.bind-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 24rpx;
  color: #2d211a;
  background: #fff8f0;
  border: 1rpx solid rgba(124, 74, 46, 0.08);
  font-size: 25rpx;
  box-sizing: border-box;
}

.bind-btn {
  flex-shrink: 0;
  width: 160rpx;
  min-height: 76rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #7a573e 0%, #5e4533 100%);
  font-size: 25rpx;
  box-shadow: 0 12rpx 24rpx rgba(94, 69, 51, 0.18);
}

.bound-tip {
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  color: #6f5b4d;
  background: #fff8f0;
  font-size: 24rpx;
}

.bound-tip .remix-icon {
  color: #25a55f;
  font-size: 30rpx;
}

.bound-text {
  flex: 1;
  min-width: 0;
  line-height: 1.45;
}

.bound-code {
  margin-top: 6rpx;
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 950;
  word-break: break-all;
}

.record-list {
  margin-top: 12rpx;
}

.record-row {
  min-height: 94rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(124, 74, 46, 0.08);
}

.record-row:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.invite-record-row {
  gap: 16rpx;
}

.invite-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff1e1;
}

.invite-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #b7794c;
  font-size: 34rpx;
}

.invite-reward {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.reward-amount {
  color: #ea580c;
  font-size: 28rpx;
  font-weight: 950;
}

.record-title {
  color: #2d211a;
  font-size: 27rpx;
  font-weight: 850;
}

.record-time {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.income-amount,
.withdraw-amount {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-size: 28rpx;
  font-weight: 950;
}

.income-amount {
  color: #ea580c;
}

.withdraw-amount {
  color: #5e4533;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 900;
}

.status-pill.success {
  color: #16834a;
  background: #e8f8ef;
}

.status-pill.danger {
  color: #dc2626;
  background: #fff1f1;
}

.status-pill.pending {
  color: #9a5a00;
  background: #fff1c7;
}

.status-pill.muted {
  color: #6b7280;
  background: #f3f4f6;
}

.empty-state {
  margin-top: 24rpx;
  padding: 34rpx 20rpx;
  border-radius: 28rpx;
  text-align: center;
  background: linear-gradient(135deg, #fffaf4 0%, #fff6ee 100%);
  border: 1rpx solid rgba(124, 74, 46, 0.08);
}

.empty-icon {
  color: #d6b59a;
  font-size: 46rpx;
}

.empty-text {
  margin-top: 10rpx;
  color: #9a8b7b;
  font-size: 24rpx;
}

@media (max-width: 360px) {
  .bind-row {
    flex-direction: column;
    align-items: stretch;
  }

  .bind-btn {
    width: 100%;
  }

  .invite-code {
    font-size: 36rpx;
    letter-spacing: 5rpx;
  }
}

.pending-confirm-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff7eb 0%, #ffedd5 100%);
  border: 1rpx solid rgba(234, 88, 12, 0.28);
  box-shadow: 0 10rpx 28rpx rgba(234, 88, 12, 0.12);
  animation: pulse-border 2s infinite ease-in-out;
}

.pending-confirm-banner .banner-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.pending-confirm-banner .banner-icon {
  color: #ea580c;
  font-size: 36rpx;
}

.pending-confirm-banner .banner-text {
  color: #c2410c;
  font-size: 26rpx;
  font-weight: 900;
}

.pending-confirm-banner .banner-right {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: #ea580c;
  font-size: 24rpx;
  font-weight: 850;
}

.records-tab-bar {
  display: flex;
  align-items: center;
  background: #f7ede2;
  border-radius: 22rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
  gap: 8rpx;
}

.records-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #8e8172;
  padding: 18rpx 0;
  border-radius: 18rpx;
  transition: all 0.2s ease;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.records-tab.active {
  background: #ffffff;
  color: #2d211a;
  font-weight: 950;
  box-shadow: 0 4rpx 16rpx rgba(124, 74, 46, 0.08);
}

.tab-count {
  font-size: 22rpx;
  color: #a09282;
  font-weight: 600;
}

.records-tab.active .tab-count {
  color: #ea580c;
}

.tab-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ea580c;
  display: inline-block;
  margin-left: 2rpx;
  animation: pulse-border 1.5s infinite ease-in-out;
}

.withdraw-hint-box {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #fff8ec;
  border: 1rpx dashed rgba(255, 153, 102, 0.35);
  font-size: 23rpx;
  line-height: 1.5;
  color: #d45f22;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.withdraw-card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 12rpx;
}

.withdraw-item-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fffbf7;
  border: 1rpx solid rgba(124, 74, 46, 0.09);
}

.withdraw-item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(124, 74, 46, 0.07);
}

.withdraw-item-amount-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.withdraw-item-label {
  font-size: 24rpx;
  color: #8e8172;
}

.withdraw-item-amount {
  font-size: 34rpx;
  font-weight: 950;
  color: #2d211a;
}

.confirm-transfer-btn {
  width: 100%;
  min-height: 80rpx;
  margin: 18rpx 0 10rpx;
  padding: 0 24rpx;
  border: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff8c42 0%, #ea580c 100%);
  font-size: 26rpx;
  font-weight: 950;
  box-shadow: 0 8rpx 20rpx rgba(234, 88, 12, 0.25);
  animation: pulse-border 2s infinite ease-in-out;
}

.query-transfer-btn {
  width: 100%;
  min-height: 74rpx;
  margin: 14rpx 0 10rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(255, 122, 69, 0.25);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #d45f22;
  background: #fff8ec;
  font-size: 25rpx;
  font-weight: 850;
}

.withdraw-item-details {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 14rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 23rpx;
  line-height: 1.4;
}

.detail-label {
  color: #8e8172;
}

.detail-value {
  color: #2d211a;
  font-weight: 750;
  max-width: 65%;
  text-align: right;
  word-break: break-all;
}

.detail-value.text-highlight {
  color: #ea580c;
  font-weight: 900;
}

.detail-value.text-danger {
  color: #dc2626;
}

@keyframes pulse-border {
  0% { transform: scale(1); }
  50% { transform: scale(1.015); }
  100% { transform: scale(1); }
}
.invitation-maintenance-tip{margin:20rpx 0 8rpx;padding:20rpx 24rpx;background:#fff4e6;border-left:5rpx solid #bd6a38;color:#67442c;font-size:25rpx;line-height:1.6;overflow-wrap:break-word}
