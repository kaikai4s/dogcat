.assets-page{padding:24rpx;background:#fff8ec;min-height:100vh}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 8rpx 30rpx rgba(100,70,30,.06)}.eyebrow,.muted{color:#8e8172;font-size:25rpx}.amount{font-size:72rpx;font-weight:700;margin:22rpx 0;color:#33261d}.card-title{font-weight:700;font-size:32rpx;margin-bottom:22rpx}.primary,.ghost{margin-top:22rpx;border-radius:999rpx}.primary{background:#5e4533;color:#fff}.ghost{background:#f4eee5;color:#5e4533}.invite-code{font-size:44rpx;letter-spacing:6rpx;font-weight:700}.bind-row{display:flex;gap:14rpx;margin-top:22rpx}.bind-row input{flex:1;background:#f7f2eb;border-radius:14rpx;padding:20rpx}.small{margin:0;width:150rpx}.row{display:flex;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #f0e8dd}.income{color:#d46a3b;font-weight:700}
