<view class="profile-edit-page {{themeClass}} {{fontClass}} page">
  <view class="profile-hero">
    <view class="hero-badge"><text class="remix-icon ri-user-3-fill hero-icon"></text><text>个人资料</text></view>
    <view class="hero-title">编辑个人资料</view>
    <view class="hero-desc">设置昵称、头像和手机号，多芙琳宠护端会优先显示昵称。</view>
  </view>

  <view class="card form-card">
    <view class="card-subtitle"><text class="remix-icon ri-image-edit-line sub-icon"></text><text>头像</text></view>
    <view class="avatar-picker-wrap">
      <button class="avatar-picker-btn" open-type="chooseAvatar" bindtap="preparePrivacyAuthorize" bindchooseavatar="onChooseAvatar">
        <view class="avatar-picker">
          <image class="avatar-preview" wx:if="{{form.avatarUrl}}" src="{{form.avatarUrl}}" mode="aspectFill" />
          <view class="avatar-empty" wx:else><text class="remix-icon ri-camera-line"></text><text>微信头像</text></view>
        </view>
      </button>
      <view class="avatar-level-badge badge-{{form.badgeStyle || 'gold'}}" wx:if="{{form.badgeTag || form.memberLevelName}}">{{form.badgeTag || form.memberLevelName}}</view>
    </view>
    <view class="avatar-hint">点击可一键选用当前微信头像</view>

    <view class="card-subtitle"><text class="remix-icon ri-profile-line sub-icon"></text><text>基础资料</text></view>
    <input class="input-field" type="nickname" placeholder="昵称（点击键盘可一键填入微信昵称）" value="{{form.nickname}}" data-field="nickname" bindinput="input" bindblur="onNicknameBlur" />
    <view class="card-subtitle"><text class="remix-icon ri-phone-line sub-icon"></text><text>联系电话</text></view>
    <view class="phone-input-card">
      <input class="input-field phone-input" placeholder="请通过微信授权绑定手机号" value="{{form.phone}}" disabled />
      <button class="phone-auth-btn" open-type="getPhoneNumber" bindtap="preparePrivacyAuthorize" bindgetphonenumber="bindPhone">快捷授权</button>
    </view>
    <view class="field-tip">手机号仅支持微信授权绑定，不能手动填写。</view>
  </view>

  <button class="primary-btn submit-btn" bindtap="save"><text class="remix-icon ri-save-3-line"></text><text>保存资料</text></button>
</view>
<global-loading />
