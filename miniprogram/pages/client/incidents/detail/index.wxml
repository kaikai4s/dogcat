<view class="incident-detail-page {{themeClass}} {{fontClass}} page" wx:if="{{detail}}">
  <view class="incident-hero">
    <view class="hero-badge"><text class="remix-icon ri-customer-service-2-fill hero-icon"></text><text>纠纷详情</text></view>
    <view class="hero-title">{{detail.incident.title || detail.incident.incidentTypeText}}</view>
    <view class="hero-desc">平台处理期间可继续补充说明和证据。</view>
  </view>

  <view class="card info-card">
    <view class="card-subtitle"><text class="remix-icon ri-file-list-3-line sub-icon"></text><text>工单信息</text></view>
    <view class="info-row"><view class="label">类型</view><view class="value">{{detail.incident.incidentTypeText}}</view></view>
    <view class="info-row"><view class="label">状态</view><view class="status-badge">{{detail.incident.statusText}}</view></view>
    <view class="info-row"><view class="label">订单</view><view class="value">{{detail.incident.orderId}}</view></view>
    <view class="info-row"><view class="label">提交时间</view><view class="value">{{detail.incident.createdAt}}</view></view>
    <view class="info-row" wx:if="{{detail.incident.refundNo}}"><view class="label">关联退款</view><view class="value">{{detail.incident.refundNo}}</view></view>
  </view>

  <view class="card">
    <view class="card-subtitle"><text class="remix-icon ri-file-text-line sub-icon"></text><text>问题说明</text></view>
    <view class="desc-text">{{detail.incident.description}}</view>
    <view class="evidence-grid" wx:if="{{detail.incident.mediaFileIds.length}}">
      <image class="evidence-image" wx:for="{{detail.incident.mediaFileIds}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
    </view>
  </view>

  <view class="card resolution-card" wx:if="{{detail.incident.resolution}}">
    <view class="card-subtitle"><text class="remix-icon ri-shield-check-line sub-icon"></text><text>处理方案</text></view>
    <view class="resolution-title">{{detail.incident.resolution.type || '处理结果'}}</view>
    <view class="desc-text">{{detail.incident.resolution.content}}</view>
    <view class="refund-price" wx:if="{{detail.incident.resolution.refundAmount}}">¥{{detail.incident.resolution.refundAmount}}</view>
  </view>

  <view class="card" wx:if="{{detail.comments.length}}">
    <view class="card-subtitle"><text class="remix-icon ri-chat-3-line sub-icon"></text><text>沟通记录</text></view>
    <view class="timeline">
      <view class="timeline-item" wx:for="{{detail.comments}}" wx:key="_id">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="timeline-title">{{item.actorRole}}</view>
          <view class="timeline-desc">{{item.content}}</view>
          <view class="evidence-grid" wx:if="{{item.mediaFileIds.length}}">
            <image class="evidence-image" wx:for="{{item.mediaFileIds}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
          </view>
          <view class="timeline-time">{{item.createdAt}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card form-card">
    <view class="card-subtitle"><text class="remix-icon ri-edit-box-line sub-icon"></text><text>补充说明</text></view>
    <textarea class="textarea-field" placeholder="继续补充情况或处理诉求" value="{{comment}}" bindinput="inputComment" maxlength="500" />
    <view class="upload-head">
      <view class="upload-count">证据照片 {{mediaFileIds.length}}/9</view>
      <button class="mini-btn" wx:if="{{mediaFileIds.length < 9}}" bindtap="chooseEvidence"><text class="remix-icon ri-image-add-line"></text><text>添加</text></button>
    </view>
    <view class="evidence-grid" wx:if="{{mediaFileIds.length}}">
      <view class="evidence-item" wx:for="{{mediaFileIds}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" />
        <view class="remove" data-index="{{index}}" bindtap="removeEvidence"><text class="remix-icon ri-close-line"></text></view>
      </view>
    </view>
  </view>

  <view class="bottom-actions">
    <button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitComment"><text class="remix-icon ri-send-plane-fill"></text><text>提交补充</text></button>
    <button class="ghost-btn" bindtap="goOrder"><text class="remix-icon ri-file-list-3-line"></text><text>查看订单</text></button>
  </view>
</view>
