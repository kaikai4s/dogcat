/* Client incident detail - Cute Pet Style UI redesign */
.incident-detail-page {
  min-height: 100vh;
  padding: 0 28rpx 120rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.incident-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon { font-size: 28rpx; }

.hero-title {
  color: #2d211a;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.card:first-of-type { margin-top: 0; }

.card-subtitle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  margin-bottom: 18rpx;
}

.sub-icon {
  color: #e9672f;
  font-size: 34rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.08);
}

.info-row:last-child { border-bottom: none; }

.label {
  color: #8e8580;
  font-size: 24rpx;
  flex-shrink: 0;
  min-width: 130rpx;
}

.value {
  color: #574b42;
  font-size: 25rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #e6f8ea;
  color: #00b42a;
  font-size: 22rpx;
  font-weight: 850;
  white-space: nowrap;
}

.desc-text {
  color: #7a6a5e;
  font-size: 26rpx;
  line-height: 1.6;
}

.resolution-card {
  background: linear-gradient(145deg, #ffffff 0%, #fff9f0 52%, #fff2ec 100%);
}

.resolution-title {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 950;
  margin-bottom: 10rpx;
}

.refund-price {
  margin-top: 14rpx;
  color: #e9672f;
  font-size: 40rpx;
  font-weight: 950;
}

.evidence-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.evidence-image,
.evidence-item {
  width: 100%;
  height: 190rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff0e2;
}

.evidence-item {
  position: relative;
}

.evidence-item image,
.evidence-image {
  width: 100%;
  height: 190rpx;
}

.remove {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(45, 33, 26, 0.58);
}

.remove .remix-icon {
  font-size: 28rpx;
  line-height: 1;
}

.timeline {
  padding-left: 18rpx;
  border-left: 2rpx solid rgba(255, 153, 102, 0.18);
}

.timeline-item {
  position: relative;
  padding-bottom: 24rpx;
}

.timeline-item:last-child { padding-bottom: 0; }

.timeline-dot {
  position: absolute;
  left: -28rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e9672f;
  border: 5rpx solid #fff0e2;
}

.timeline-content {
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff8ec;
}

.timeline-title {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 950;
}

.timeline-desc,
.timeline-time {
  margin-top: 8rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.45;
}

.timeline-time { color: #a89b90; }

.textarea-field {
  width: 100%;
  min-height: 230rpx;
  padding: 24rpx;
  border-radius: 26rpx;
  background: #fff8ec;
  border: 1rpx solid rgba(255, 153, 102, 0.16);
  color: #2d211a;
  font-size: 27rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.upload-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
}

.upload-count {
  color: #8e8580;
  font-size: 24rpx;
}

.mini-btn {
  min-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff0e2;
  color: #d45f22;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 23rpx;
  font-weight: 900;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.mini-btn::after { display: none; }

.primary-btn,
.ghost-btn {
  min-height: 80rpx;
  border-radius: 26rpx;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  line-height: 1;
}

.primary-btn::after,
.ghost-btn::after { display: none; }

.primary-btn .remix-icon,
.ghost-btn .remix-icon { font-size: 30rpx; }

.primary-btn {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(255, 122, 69, 0.22);
}

.ghost-btn {
  background: #fff0e2;
  color: #7a6a5e;
}

.bottom-actions {
  display: grid;
  gap: 16rpx;
  margin-top: 28rpx;
}

button[disabled] { opacity: 0.62; }
