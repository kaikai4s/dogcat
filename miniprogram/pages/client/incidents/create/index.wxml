<view class="page">
  <view class="dashboard-header">
    <view class="badge">售后纠纷</view>
    <view class="title">发起订单投诉</view>
    <view class="tip">描述服务问题，平台会根据证据、订单记录和双方沟通处理。</view>
  </view>

  <view class="notice danger">
    <view class="strong">请尽量补充完整情况</view>
    <view class="muted">如涉及宠物安全、服务缺失、退款争议，可上传现场照片作为证据。</view>
  </view>

  <view class="card form-card">
    <view class="subtitle">问题类型</view>
    <picker mode="selector" range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="chooseType">
      <view class="field">{{typeOptions[typeIndex].label}}</view>
    </picker>

    <view class="subtitle">标题</view>
    <input placeholder="例如：服务未按约完成" value="{{title}}" bindinput="inputTitle" maxlength="40" />

    <view class="subtitle">问题说明</view>
    <textarea placeholder="请说明发生了什么、希望平台如何处理" value="{{description}}" bindinput="inputDescription" maxlength="500" />

    <view class="between">
      <view class="subtitle">证据照片</view>
      <view class="muted">{{mediaFileIds.length}}/9</view>
    </view>
    <view class="evidence-grid" wx:if="{{mediaFileIds.length}}">
      <view class="evidence-item" wx:for="{{mediaFileIds}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill" />
        <view class="remove" data-index="{{index}}" bindtap="removeEvidence">×</view>
      </view>
    </view>
    <button class="ghost" wx:if="{{mediaFileIds.length < 9}}" bindtap="chooseEvidence">添加照片</button>
  </view>

  <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交投诉</button>
</view>
