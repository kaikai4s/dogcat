.evidence-item {
  position: relative;
  height: 190rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff7fa;
}

.evidence-item image {
  width: 100%;
  height: 100%;
}

.remove {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: rgba(0, 0, 0, 0.46);
  font-weight: 900;
}
