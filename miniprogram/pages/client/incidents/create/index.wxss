/* Client incident create - Cute Pet Style UI redesign */
.incident-create-page {
  min-height: 100vh;
  padding: 0 28rpx 120rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.incident-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.danger-hero {
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 52%, #fff1f2 100%);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon { font-size: 28rpx; }

.hero-title {
  color: #2d211a;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.notice-card,
.card {
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
  border-radius: 36rpx;
}

.notice-card {
  display: flex;
  gap: 18rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.notice-card.danger {
  background: linear-gradient(145deg, #ffffff 0%, #fff7ed 100%);
}

.notice-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 22rpx;
  background: #fff0e2;
  color: #e9672f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.notice-title {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 950;
}

.notice-desc {
  margin-top: 8rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.45;
}

.form-card {
  padding: 28rpx;
}

.care-context-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #22c55e;
}

.care-context-pet {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: #f7fbfa;
  border: 1rpx solid rgba(34, 197, 94, 0.12);
}

.care-context-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.care-name {
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 950;
}

.care-risk {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 900;
}

.care-risk.risk-normal { color: #15803d; background: #ecfdf3; }
.care-risk.risk-caution { color: #d97706; background: #fff7ed; }
.care-risk.risk-high { color: #be123c; background: #fff1f2; }

.care-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.care-tag {
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  color: #166534;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 850;
}

.care-text {
  margin-top: 10rpx;
  color: #574b42;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
}

.field-group {
  margin-bottom: 28rpx;
}

.card-subtitle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  margin-bottom: 16rpx;
}

.no-margin { margin-bottom: 0; }

.sub-icon {
  color: #e9672f;
  font-size: 34rpx;
}

.select-field,
.input-field,
.textarea-field {
  width: 100%;
  box-sizing: border-box;
  border-radius: 26rpx;
  background: #fff8ec;
  border: 1rpx solid rgba(255, 153, 102, 0.16);
  color: #2d211a;
  font-size: 27rpx;
}

.select-field,
.input-field {
  height: 84rpx;
  padding: 0 24rpx;
}

.select-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.select-field .remix-icon {
  color: #a89b90;
  font-size: 30rpx;
}

.textarea-field {
  min-height: 230rpx;
  padding: 24rpx;
  line-height: 1.55;
}

.upload-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.upload-count {
  color: #8e8580;
  font-size: 24rpx;
  flex-shrink: 0;
}

.evidence-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 18rpx;
}

.evidence-item {
  position: relative;
  height: 190rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff0e2;
}

.evidence-item image {
  width: 100%;
  height: 100%;
}

.remove {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(45, 33, 26, 0.58);
}

.remove .remix-icon {
  font-size: 28rpx;
  line-height: 1;
}

.primary-btn,
.ghost-btn {
  min-height: 80rpx;
  border-radius: 26rpx;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  line-height: 1;
}

.primary-btn::after,
.ghost-btn::after { display: none; }

.primary-btn .remix-icon,
.ghost-btn .remix-icon { font-size: 30rpx; }

.primary-btn {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(255, 122, 69, 0.22);
}

.ghost-btn {
  background: #fff0e2;
  color: #7a6a5e;
}

.upload-btn {
  margin-top: 18rpx;
  width: 100%;
}

.submit-btn {
  margin-top: 28rpx;
  width: 100%;
}

button[disabled] { opacity: 0.62; }
