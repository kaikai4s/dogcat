/* Client addresses list - Cute Pet Style UI redesign */
.address-list-page { min-height: 100vh; padding: 0 28rpx 100rpx; background: linear-gradient(180deg,#fff8ec 0%,#fffaf6 42%,#f7fbfa 100%); color: #2d211a; box-sizing: border-box; }
.address-hero { margin: 0 -28rpx 24rpx; padding: 42rpx 34rpx 38rpx; border-bottom-left-radius: 48rpx; border-bottom-right-radius: 48rpx; background: linear-gradient(135deg,#fff0c9 0%,#ffd9c8 54%,#fff5f0 100%); box-shadow: 0 18rpx 44rpx rgba(123,89,62,.08); }
.hero-badge { display: inline-flex; align-items: center; gap: 8rpx; padding: 6rpx 18rpx; border-radius: 999rpx; color: #d45f22; background: rgba(255,255,255,.85); font-size: 24rpx; font-weight: 850; margin-bottom: 16rpx; }
.hero-icon { font-size: 28rpx; }
.hero-title { color: #2d211a; font-size: 42rpx; font-weight: 950; line-height: 1.2; }
.hero-desc { margin-top: 12rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.4; }
.primary-btn,
.ghost-btn { min-height: 76rpx; border-radius: 26rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; font-size: 25rpx; font-weight: 900; border: none; line-height: 1; }
.primary-btn::after,
.ghost-btn::after { display: none; }
.primary-btn .remix-icon,
.ghost-btn .remix-icon { font-size: 28rpx; }
.primary-btn { background: linear-gradient(135deg,#ffb86c 0%,#ff7a45 100%); color: #fff; box-shadow: 0 10rpx 26rpx rgba(255,122,69,.22); }
.ghost-btn { background: #fff0e2; color: #7a6a5e; }
.ghost-btn.danger { color: #be123c; background: #fff1f2; }
.compact-btn { flex: 1; min-height: 68rpx; font-size: 23rpx; margin: 0; padding: 0 12rpx; }
.address-actions { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.search-card,
.card,
.loading-card,
.empty-state { background: #fff; border: 1rpx solid rgba(255,153,102,.14); box-shadow: 0 14rpx 34rpx rgba(123,89,62,.06); border-radius: 36rpx; }
.search-card { padding: 22rpx; margin-bottom: 20rpx; }
.search-field { height: 78rpx; border-radius: 26rpx; background: #fff8ec; border: 1rpx solid rgba(255,153,102,.14); display: flex; align-items: center; gap: 10rpx; padding: 0 22rpx; }
.search-field .remix-icon { color: #e9672f; font-size: 30rpx; }
.search-field input { flex: 1; min-width: 0; color: #2d211a; font-size: 26rpx; }
.search-actions { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 14rpx; margin-top: 16rpx; }
.loading-card { padding: 30rpx; color: #8e8580; text-align: center; font-size: 25rpx; }
.address-card { padding: 24rpx; margin-bottom: 20rpx; }
.address-main { display: flex; gap: 18rpx; }
.address-icon { width: 74rpx; height: 74rpx; border-radius: 26rpx; background: #fff0e2; color: #e9672f; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.address-icon .remix-icon { font-size: 36rpx; }
.address-content { flex: 1; min-width: 0; }
.address-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.address-title { color: #2d211a; font-size: 30rpx; font-weight: 950; line-height: 1.35; }
.badge-row { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; flex-shrink: 0; }
.status-badge,
.select-badge { display: inline-flex; align-items: center; justify-content: center; padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 850; white-space: nowrap; }
.status-badge { background: #e6f8ea; color: #00b42a; }
.select-badge { background: #fff0e2; color: #d45f22; }
.address-line { margin-top: 8rpx; color: #574b42; font-size: 25rpx; line-height: 1.45; }
.address-detail { margin-top: 8rpx; color: #8e8580; font-size: 24rpx; line-height: 1.45; }
.card-actions { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; margin-top: 20rpx; }
.list-tip { text-align: center; padding: 26rpx 0; color: #8e8580; font-size: 24rpx; }
.empty-state { min-height: 420rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 44rpx; }
.empty-icon { color: #e9672f; font-size: 100rpx; margin-bottom: 16rpx; }
.empty-title { color: #2d211a; font-size: 30rpx; font-weight: 950; }
.empty-desc { margin-top: 10rpx; color: #8e8580; font-size: 24rpx; line-height: 1.45; margin-bottom: 24rpx; }
