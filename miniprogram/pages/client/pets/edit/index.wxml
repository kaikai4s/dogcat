<view class="page"><view class="title">宠物资料</view><view class="form"><input placeholder="宠物名称" value="{{form.name}}" data-field="name" bindinput="input"/><input placeholder="品种" value="{{form.breed}}" data-field="breed" bindinput="input"/><input placeholder="体重 kg" type="digit" value="{{form.weight}}" data-field="weight" bindinput="input"/><textarea placeholder="敏感备注：爆冲、护食、攻击倾向等" value="{{form.specialNotes}}" data-field="specialNotes" bindinput="input"/></view><button class="primary" bindtap="save">保存</button></view>