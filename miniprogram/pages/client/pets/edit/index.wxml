<view class="pet-edit-page {{themeClass}} {{fontClass}} page">
  <view class="pet-hero">
    <view class="hero-badge"><text class="remix-icon ri-paw-print-fill hero-icon"></text><text>爱宠资料</text></view>
    <view class="hero-title">{{id ? '编辑宠物资料' : '添加自己的宠物'}}</view>
    <view class="pet-title-badge" wx:if="{{form.beautyTitle && form.beautyTitle.title}}"><text class="remix-icon ri-vip-crown-line"></text>{{form.beautyTitle.title}}</view>
    <view class="hero-desc">填写名字、照片、生日、品种和照顾习惯，后续可用于 AI 宠物互动。</view>
  </view>

  <view class="card form-card">
    <view class="card-subtitle"><text class="remix-icon ri-image-add-line sub-icon"></text><text>宠物美照</text><text class="required-tag">1-9张</text></view>
    <view class="beauty-tip">第一张会作为宠物头像；每月1日可删除美照，2日后将锁定保留。</view>
    <view class="beauty-grid">
      <view class="beauty-photo" wx:for="{{form.beautyPhotos}}" wx:key="id">
        <image class="beauty-image" src="{{item.fileId}}" mode="aspectFill" data-url="{{item.fileId}}" bindtap="previewPhoto" />
        <view class="cover-tag" wx:if="{{index === 0}}">头像</view>
        <view class="delete-photo {{canDeleteBeautyPhoto ? '' : 'disabled'}}" data-index="{{index}}" catchtap="removeBeautyPhoto"><text class="remix-icon ri-delete-bin-4-line"></text></view>
      </view>
      <view class="beauty-add" wx:if="{{form.beautyPhotos.length < 9}}" bindtap="chooseBeautyPhotos">
        <text class="remix-icon ri-image-add-line"></text>
        <text>{{uploadingBeauty ? '上传中' : '添加美照'}}</text>
      </view>
    </view>
    <view class="photo-actions beauty-actions">
      <button class="ghost-btn photo-btn" bindtap="chooseBeautyPhotos" disabled="{{uploadingBeauty || form.beautyPhotos.length >= 9}}"><text class="remix-icon ri-image-edit-line"></text><text>{{form.beautyPhotos.length ? '继续添加' : '选择美照'}}</text></button>
      <button wx:if="{{enablePetBreedAi}}" class="primary-btn photo-btn" bindtap="recognizeBreed" loading="{{recognizingBreed}}" disabled="{{recognizingBreed || !form.avatarFileId}}"><text class="remix-icon ri-sparkling-line"></text><text>AI 识别种类/品种</text></button>
    </view>

    <view class="ai-result-box" wx:if="{{aiResultText}}">
      <view class="ai-result-header">
        <text class="remix-icon ri-sparkling-line"></text>
        <text class="ai-result-title">AI 识别结果（已自动回填，可手动修改）</text>
      </view>
      <view class="ai-result-content">{{aiResultText}}</view>
    </view>

    <view class="card-subtitle"><text class="remix-icon ri-profile-line sub-icon"></text><text>基础信息</text></view>
    <input class="input-field" placeholder="宠物名字（必填）" value="{{form.name}}" data-field="name" bindinput="input" />
    <view class="picker-grid">
      <picker range="{{speciesOptions}}" range-key="label" value="{{speciesIndex}}" bindchange="chooseSpecies">
        <view class="select-field"><text>类型：{{speciesOptions[speciesIndex].label}}</text><text class="remix-icon ri-arrow-down-s-line"></text></view>
      </picker>
      <picker range="{{genderOptions}}" value="{{genderIndex}}" bindchange="chooseGender">
        <view class="select-field"><text>性别：{{form.gender}}</text><text class="remix-icon ri-arrow-down-s-line"></text></view>
      </picker>
    </view>
    <input class="input-field" placeholder="品种，如 金毛 / 布偶 / 柯基" value="{{form.breed}}" data-field="breed" bindinput="input" />
    <view class="picker-grid">
      <picker mode="date" value="{{form.birthday}}" bindchange="chooseBirthday">
        <view class="select-field"><text>生日：{{form.birthday || '请选择'}}</text><text class="remix-icon ri-calendar-event-line"></text></view>
      </picker>
      <view class="weight-field">
        <input placeholder="体重，只填数字" type="digit" value="{{form.weight}}" data-field="weight" bindinput="input" />
        <view class="weight-unit">kg</view>
      </view>
    </view>

    <view class="card-subtitle"><text class="remix-icon ri-medal-line sub-icon"></text><text>宠物头衔</text></view>
    <view class="title-equip-box">
      <view class="pet-equipped-title badge-{{form.equippedTitle.badgeStyle || 'gold'}}" wx:if="{{form.equippedTitle && form.equippedTitle.name}}">
        <text wx:if="{{form.equippedTitle.icon}}">{{form.equippedTitle.icon}}</text>
        <text class="title-text {{form.equippedTitle.nameEffect && form.equippedTitle.nameEffect !== 'none' ? 'name-effect-' + form.equippedTitle.nameEffect : ''}}" style="{{form.equippedTitle.nameColor ? 'color:' + form.equippedTitle.nameColor + ';' : ''}}">{{form.equippedTitle.name}}</text>
      </view>
      <view class="field-tip" wx:else>{{id ? '当前未佩戴头衔' : '保存宠物档案后可佩戴已拥有头衔'}}</view>
      <picker wx:if="{{id}}" range="{{titleOptions}}" range-key="label" value="{{selectedTitleOptionIndex}}" bindchange="chooseTitle" disabled="{{titleSaving}}">
        <view class="select-field title-select"><text>{{titleSaving ? '更新头衔中...' : ('选择头衔：' + titleOptions[selectedTitleOptionIndex].label)}}</text><text class="remix-icon ri-arrow-down-s-line"></text></view>
      </picker>
      <view class="field-tip" wx:if="{{id && titleOptions.length <= 1}}">暂无可佩戴头衔，可通过奖励邮箱或抽奖获得。</view>
    </view>

    <view class="card-subtitle"><text class="remix-icon ri-vip-crown-line sub-icon"></text><text>月度称号</text></view>
    <view class="title-equip-box">
      <view class="pet-title-badge" wx:if="{{form.beautyTitle && form.beautyTitle.title}}"><text class="remix-icon ri-vip-crown-line"></text>{{form.beautyTitle.monthKey}} · {{form.beautyTitle.title}}</view>
      <view class="field-tip" wx:else>{{id ? '当前未佩戴月度称号' : '月榜结算获奖后，可在这里选择佩戴称号'}}</view>
      <picker wx:if="{{id && !beautyTitleLoadFailed}}" range="{{beautyTitleOptions}}" range-key="label" value="{{selectedBeautyTitleIndex}}" bindchange="chooseBeautyTitle" disabled="{{beautyTitleSaving || beautyTitleLoading}}">
        <view class="select-field title-select"><text>{{beautyTitleLoading ? '加载称号中...' : beautyTitleSaving ? '更新称号中...' : ('选择称号：' + beautyTitleOptions[selectedBeautyTitleIndex].label)}}</text><text class="remix-icon ri-arrow-down-s-line"></text></view>
      </picker>
      <button wx:if="{{id && beautyTitleLoadFailed}}" class="ghost-btn" bindtap="loadBeautyTitles">称号加载失败，点击重试</button>
      <view class="field-tip" wx:if="{{id && !beautyTitleLoading && !beautyTitleLoadFailed && beautyTitleOptions.length <= 1}}">暂无月度称号，参与宠物颜值月榜即可争取获得。</view>
      <view class="field-tip">选择后立即生效，可与头衔同时佩戴。取下后仍保留获奖记录，可随时重新佩戴。</view>
    </view>

    <view class="card-subtitle"><text class="remix-icon ri-heart-pulse-line sub-icon"></text><text>照顾资料</text></view>
    <input class="input-field" placeholder="性格特点，如 胆小 / 活泼 / 粘人" value="{{form.personality}}" data-field="personality" bindinput="input" />
    <input class="input-field" placeholder="喜欢的食物或玩具" value="{{form.favoriteFood}}" data-field="favoriteFood" bindinput="input" />
    <input class="input-field" placeholder="不喜欢/害怕什么" value="{{form.dislikes}}" data-field="dislikes" bindinput="input" />
    <textarea class="textarea-field" placeholder="健康情况：过敏、用药、疫苗、绝育、慢性病等" value="{{form.healthNotes}}" data-field="healthNotes" bindinput="input" />
    <textarea class="textarea-field" placeholder="照顾备注：爆冲、护食、攻击倾向、外出习惯、喂食要求等" value="{{form.specialNotes}}" data-field="specialNotes" bindinput="input" />
  </view>

  <view class="card form-card ai-card">
    <view class="ai-head">
      <view>
        <view class="card-subtitle no-margin"><text class="remix-icon ri-robot-2-line sub-icon"></text><text>AI 宠物互动资料</text></view>
        <view class="field-tip">根据宠物资料生成拟人化互动设定</view>
      </view>
      <switch checked="{{form.aiInteractionEnabled}}" bindchange="toggleAi" />
    </view>
    <button class="ghost-btn generate-btn" bindtap="generateAiProfile"><text class="remix-icon ri-sparkling-line"></text><text>一键生成 AI 互动设定</text></button>
    <textarea class="textarea-field" placeholder="AI 性格设定，例如：用第一视角模拟宠物和主人互动" value="{{form.aiPersona}}" data-field="aiPersona" bindinput="input" />
    <input class="input-field" placeholder="AI 打招呼文案" value="{{form.aiGreeting}}" data-field="aiGreeting" bindinput="input" />
  </view>

  <button class="primary-btn submit-btn" bindtap="save"><text class="remix-icon ri-save-3-line"></text><text>保存宠物档案</text></button>
</view>
