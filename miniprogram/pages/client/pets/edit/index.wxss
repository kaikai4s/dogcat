.photo-section { display: flex; align-items: center; gap: 24rpx; margin-bottom: 22rpx; }
.photo-box { width: 200rpx; height: 200rpx; border-radius: 36rpx; overflow: hidden; background: #fff2f7; border: 2rpx dashed rgba(244, 63, 107, 0.28); flex-shrink: 0; }
.photo-wrapper { width: 100%; height: 100%; position: relative; }
.photo-preview { width: 100%; height: 100%; }
.photo-empty { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.photo-icon { width: 64rpx; height: 64rpx; border-radius: 50%; background: #f43f6b; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 38rpx; margin-bottom: 8rpx; }
.photo-actions { flex: 1; display: flex; flex-direction: column; gap: 16rpx; }
.photo-btn { font-size: 26rpx; height: 72rpx; line-height: 72rpx; border-radius: 36rpx; margin: 0; }
.ai-breed-btn { font-size: 26rpx; height: 72rpx; line-height: 72rpx; border-radius: 36rpx; margin: 0; background: linear-gradient(135deg, #ff7e5f, #feb47b); color: #fff; font-weight: 700; border: none; box-shadow: 0 4rpx 16rpx rgba(255, 126, 95, 0.3); }
.ai-result-box { background: linear-gradient(135deg, #fff5f0, #fff0f5); border: 2rpx solid #ffe0d8; border-radius: 28rpx; padding: 24rpx; margin-bottom: 22rpx; }
.ai-result-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.ai-result-title { font-size: 26rpx; font-weight: 800; color: #ff5e3a; }
.ai-apply-btn { font-size: 22rpx; color: #fff; background: #ff7e5f; padding: 6rpx 18rpx; border-radius: 20rpx; font-weight: 700; }
.ai-result-content { font-size: 26rpx; color: #4a4a4a; line-height: 1.6; word-break: break-all; }
.required-tag { color: #f43f6b; font-size: 24rpx; font-weight: normal; margin-left: 8rpx; }
.picker-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.weight-field { display: flex; align-items: center; background: #fff; border-radius: 24rpx; padding-right: 24rpx; }
.weight-field input { flex: 1; margin-bottom: 0; }
.weight-unit { color: #f43f6b; font-weight: 800; font-size: 28rpx; }
.ai-card textarea { margin-top: 18rpx; }
.no-margin { margin: 0; }
