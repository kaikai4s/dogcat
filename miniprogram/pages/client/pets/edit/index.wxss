.photo-box { width: 220rpx; height: 220rpx; border-radius: 44rpx; overflow: hidden; background: #fff2f7; border: 2rpx dashed rgba(244, 63, 107, 0.28); margin-bottom: 22rpx; }
.photo-preview { width: 100%; height: 100%; }
.photo-empty { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.photo-icon { width: 72rpx; height: 72rpx; border-radius: 50%; background: #f43f6b; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 42rpx; margin-bottom: 12rpx; }
.picker-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18rpx; }
.weight-field { display: flex; align-items: center; background: #fff; border-radius: 24rpx; padding-right: 24rpx; }
.weight-field input { flex: 1; margin-bottom: 0; }
.weight-unit { color: #f43f6b; font-weight: 800; font-size: 28rpx; }
.ai-card textarea { margin-top: 18rpx; }
.no-margin { margin: 0; }
