/* Client pets list - Cute Pet Style UI redesign */
.pet-list-page {
  min-height: 100vh;
  padding: 0 28rpx 100rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.pet-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge { display: inline-flex; align-items: center; gap: 8rpx; padding: 6rpx 18rpx; border-radius: 999rpx; color: #d45f22; background: rgba(255,255,255,.85); font-size: 24rpx; font-weight: 850; margin-bottom: 16rpx; }
.hero-icon { font-size: 28rpx; }
.hero-title { color: #2d211a; font-size: 42rpx; font-weight: 950; line-height: 1.2; }
.hero-desc { margin-top: 12rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.4; }

.primary-btn,
.ghost-btn {
  min-height: 78rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 900;
  border: none;
  line-height: 1;
}
.primary-btn::after,
.ghost-btn::after { display: none; }
.primary-btn .remix-icon,
.ghost-btn .remix-icon { font-size: 30rpx; }
.primary-btn { background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%); color: #fff; box-shadow: 0 10rpx 26rpx rgba(255,122,69,.22); }
.ghost-btn { background: #fff0e2; color: #7a6a5e; }
.add-btn { width: 100%; margin-bottom: 20rpx; }
.compact-btn { min-height: 68rpx; font-size: 24rpx; }

.status-tabs { display: flex; gap: 14rpx; overflow-x: auto; padding-bottom: 8rpx; margin-bottom: 18rpx; white-space: nowrap; }
.status-tab { flex-shrink: 0; padding: 14rpx 24rpx; border-radius: 999rpx; background: #fff; border: 1rpx solid rgba(255,153,102,.14); color: #7a6a5e; font-size: 25rpx; font-weight: 850; box-shadow: 0 8rpx 18rpx rgba(123,89,62,.04); }
.status-tab.active { color: #fff; background: linear-gradient(135deg,#ffb86c 0%,#ff7a45 100%); border-color: transparent; }

.search-card,
.card,
.empty-state { background: #fff; border: 1rpx solid rgba(255,153,102,.14); box-shadow: 0 14rpx 34rpx rgba(123,89,62,.06); border-radius: 36rpx; }
.search-card { padding: 22rpx; margin-bottom: 20rpx; }
.search-field { height: 78rpx; border-radius: 26rpx; background: #fff8ec; border: 1rpx solid rgba(255,153,102,.14); display: flex; align-items: center; gap: 10rpx; padding: 0 22rpx; }
.search-field .remix-icon { color: #e9672f; font-size: 30rpx; }
.search-field input { flex: 1; min-width: 0; color: #2d211a; font-size: 26rpx; }
.search-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; margin-top: 16rpx; }

.pet-card { display: flex; gap: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.pet-photo { width: 132rpx; height: 132rpx; border-radius: 34rpx; background: #fff0e2; flex-shrink: 0; }
.empty-photo { display: flex; align-items: center; justify-content: center; color: #e9672f; font-size: 56rpx; }
.pet-main { flex: 1; min-width: 0; }
.pet-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.pet-name { color: #2d211a; font-size: 30rpx; font-weight: 950; }
.pet-badge { padding: 6rpx 16rpx; border-radius: 999rpx; background: #e6f8ea; color: #00b42a; font-size: 22rpx; font-weight: 850; white-space: nowrap; }
.pet-meta,
.pet-desc { margin-top: 8rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.45; }
.beauty-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; margin-top: 10rpx; }
.beauty-title,
.exclusive-id { display: inline-flex; align-items: center; gap: 6rpx; padding: 6rpx 14rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 900; }
.beauty-title { color: #b45309; background: #fff7d6; }
.beauty-title .remix-icon { font-size: 22rpx; }
.exclusive-id { color: #d45f22; background: #fff0e2; }
.pet-desc { color: #8e8580; }
.chip-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.chip { padding: 8rpx 16rpx; border-radius: 999rpx; background: #fff0e2; color: #d45f22; font-size: 22rpx; font-weight: 850; }
.chip.pink { background: #fff1f2; color: #be123c; }
.chip.blue { background: #eaf3ff; color: #2563eb; }
.list-tip { text-align: center; padding: 26rpx 0; color: #8e8580; font-size: 24rpx; }
.empty-state { min-height: 420rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 44rpx; }
.empty-icon { color: #e9672f; font-size: 100rpx; margin-bottom: 16rpx; }
.empty-title { color: #2d211a; font-size: 30rpx; font-weight: 950; }
.empty-desc { margin-top: 10rpx; color: #8e8580; font-size: 24rpx; line-height: 1.45; }
