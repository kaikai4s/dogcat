/* Client order detail - Cute Pet Style UI redesign */
.order-detail-page {
  min-height: 100vh;
  padding: 0 28rpx 120rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.detail-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon { font-size: 28rpx; }

.hero-title {
  color: #2d211a;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.summary-price {
  color: #d45f22;
  font-size: 46rpx;
  font-weight: 950;
  line-height: 1;
}

.order-message-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  margin-bottom: 22rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fffbf7 100%);
  border: 1rpx solid rgba(255, 153, 102, 0.22);
}

.order-message-entry .entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.order-message-entry .entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  background: #fff0e2;
  color: #e9672f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.order-message-entry .entry-title {
  font-size: 28rpx;
  font-weight: 850;
  color: #2d211a;
  line-height: 1.3;
}

.order-message-entry .entry-desc {
  font-size: 22rpx;
  color: #8a7a70;
  margin-top: 4rpx;
}

.order-message-entry .entry-arrow {
  color: #c4b5a8;
  font-size: 36rpx;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.card,
.summary-card {
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
  border-radius: 36rpx;
}

.summary-card {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.summary-label {
  color: #8e8580;
  font-size: 24rpx;
}

.summary-status {
  margin-top: 8rpx;
  color: #2d211a;
  font-size: 34rpx;
  font-weight: 950;
}

.summary-price,
.price {
  color: #e9672f;
  font-weight: 950;
}

.summary-price {
  font-size: 44rpx;
  flex-shrink: 0;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.card-subtitle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  margin-bottom: 18rpx;
}

.sub-icon {
  color: #e9672f;
  font-size: 34rpx;
}

.order-person {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.order-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: #fff0e2;
  flex-shrink: 0;
}

.order-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9672f;
  font-size: 42rpx;
}

.person-info {
  min-width: 0;
}

.person-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
}

.person-phone {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.08);
}

.info-row:last-child { border-bottom: none; }

.label {
  color: #8e8580;
  font-size: 24rpx;
  flex-shrink: 0;
  min-width: 150rpx;
}

.value {
  color: #574b42;
  font-size: 25rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.pet-title-value { display: inline-flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 8rpx; }
.pet-title-badge { display: inline-flex; padding: 4rpx 12rpx; border-radius: 999rpx; color: #b45309; background: #fff7d6; font-size: 20rpx; font-weight: 900; }

.discount { color: #00b42a; }

.session-list {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 22rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.12);
}

.session-label {
  color: #6b5b52;
  font-size: 23rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
}

.session-item {
  color: #574b42;
  font-size: 23rpx;
  line-height: 1.55;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #e6f8ea;
  color: #00b42a;
  font-size: 22rpx;
  font-weight: 850;
  white-space: nowrap;
}

.notice-text {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 25rpx;
  line-height: 1.55;
}

.status-green {
  color: #18a87c !important;
  font-weight: 850;
}

.status-orange {
  color: #ff7a45 !important;
  font-weight: 850;
}

.security-block {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: #fff8ec;
}

.image-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.security-image {
  width: 100%;
  height: 160rpx;
  border-radius: 22rpx;
  background: #fff0e2;
}

.session-codes-wrap {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: #fffdf9;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 153, 102, 0.16);
}

.session-codes-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #2d211a;
  margin-bottom: 12rpx;
}

.session-code-row {
  padding: 10rpx 0;
  border-bottom: 1rpx dashed rgba(0, 0, 0, 0.06);
}

.session-code-row:last-child {
  border-bottom: none;
}

.session-code-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.session-code-day {
  font-size: 24rpx;
  font-weight: 700;
  color: #2d211a;
}

.session-code-val {
  font-size: 24rpx;
  color: #ff7a45;
  font-weight: 800;
}

.session-code-val.destroyed {
  color: #059669;
  font-weight: 600;
}

.security-destroyed-banner {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
}

.destroyed-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #065f46;
  margin-bottom: 8rpx;
}

.destroyed-desc {
  font-size: 23rpx;
  line-height: 1.45;
  color: #047857;
}

.destroyed-time {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #059669;
}

.session-code-time {
  font-size: 21rpx;
  color: #8e8580;
  margin-top: 4rpx;
}

.reset-panel {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: #fff8ec;
}

.reset-tip-box {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 18rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #ff7a45;
}

.reset-tip-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  font-weight: 800;
  color: #ff7a45;
  margin-bottom: 6rpx;
}

.reset-tip-desc {
  font-size: 23rpx;
  color: #5f5650;
  line-height: 1.45;
}

.session-picker-wrap {
  margin-bottom: 14rpx;
}

.picker-field {
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: #ffffff;
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 700;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 153, 102, 0.2);
}

.reset-panel input {
  height: 78rpx;
  padding: 0 22rpx;
  margin-bottom: 14rpx;
  border-radius: 22rpx;
  background: #ffffff;
  color: #2d211a;
  font-size: 26rpx;
  box-sizing: border-box;
}

.primary-btn,
.ghost-btn {
  min-height: 78rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  line-height: 1;
  box-sizing: border-box;
}

.primary-btn::after,
.ghost-btn::after { display: none; }

.primary-btn .remix-icon,
.ghost-btn .remix-icon {
  font-size: 30rpx;
  line-height: 1;
}

.primary-btn {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.ghost-btn {
  background: #fff0e2;
  color: #7a6a5e;
}

.inline-btn {
  margin: 18rpx 0 0;
  width: fit-content;
  min-width: 260rpx;
  padding: 0 22rpx;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.timeline {
  padding-left: 18rpx;
  border-left: 2rpx solid rgba(255, 153, 102, 0.18);
}

.timeline-item {
  position: relative;
  padding-bottom: 24rpx;
}

.timeline-item:last-child { padding-bottom: 0; }

.timeline-dot {
  position: absolute;
  left: -28rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e9672f;
  border: 5rpx solid #fff0e2;
}

.timeline-content {
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff8ec;
}

.timeline-title {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 950;
}

.timeline-desc,
.timeline-time {
  margin-top: 8rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.45;
}

.timeline-time { color: #a89b90; }

.review-score {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: #fff0e2;
  font-size: 26rpx;
  font-weight: 900;
}

.review-stars {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
}

.review-stars .remix-icon {
  font-size: 28rpx;
}

.review-stars .star-active {
  color: #ffb020;
}

.review-stars .star-inactive {
  color: #d8d3cf;
}

.review-rating-num {
  font-size: 26rpx;
  color: #d45f22;
  font-weight: 900;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff0e2;
  color: #d45f22;
  font-size: 23rpx;
  font-weight: 800;
}

.bottom-actions {
  display: grid;
  gap: 16rpx;
  margin-top: 28rpx;
}

button[disabled] { opacity: 0.62; }

/* 快捷联系栏 */
.contact-actions-bar {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
  margin-bottom: 6rpx;
}
.contact-btn {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #ffffff !important;
  border: 1rpx solid #ffd0b3 !important;
  color: #d45f22 !important;
  border-radius: 20rpx !important;
  height: 76rpx !important;
  line-height: 76rpx !important;
}

/* 时空雷达卡片 */
.radar-card {
  background: linear-gradient(135deg, #e6f7ff 0%, #ffffff 100%);
  border: 2rpx solid #91d5ff;
}
.radar-pulse-icon {
  color: #1890ff;
  font-size: 34rpx;
}
.radar-stats-grid {
  display: flex;
  gap: 20rpx;
  margin: 18rpx 0;
}
.radar-stat-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.9);
  padding: 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid #bae7ff;
  text-align: center;
}
.radar-stat-label {
  font-size: 24rpx;
  color: #595959;
}
.radar-stat-val {
  font-size: 36rpx;
  font-weight: 900;
  color: #096dd9;
  margin-top: 8rpx;
}
.radar-proximity-banner {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  background: #f6ffed;
  border: 1rpx solid #b7eb8f;
  border-radius: 16rpx;
  color: #389e0d;
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1.4;
  margin-bottom: 16rpx;
}
.radar-tip-text {
  font-size: 24rpx;
  color: #8c8c8c;
  line-height: 1.4;
}

/* 现场照料实时流（即拍即达） */
.live-stream-card {
  background: linear-gradient(135deg, #fffbf0 0%, #ffffff 100%);
  border: 2rpx solid #ffd591;
}
.live-stream-icon {
  color: #fa541c;
  font-size: 34rpx;
}
.live-stream-desc {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-bottom: 20rpx;
}
.live-stream-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.live-stream-item {
  display: flex;
  gap: 20rpx;
  background: #ffffff;
  padding: 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid #ffe7ba;
}
.live-photo-wrap {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
}
.live-photo {
  width: 100%;
  height: 100%;
}
.live-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.live-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.live-tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 800;
  background: #fff2e8;
  color: #d4380d;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}
.live-time {
  font-size: 22rpx;
  color: #bfbfbf;
}
.live-remark {
  font-size: 26rpx;
  color: #262626;
  line-height: 1.4;
  margin-top: 8rpx;
}

/* 通用弹窗蒙层与内容 */
.custom-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 32rpx;
  box-sizing: border-box;
}
.custom-modal-box {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 36rpx;
  padding: 36rpx;
  box-sizing: border-box;
}
.custom-modal-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #262626;
  margin-bottom: 24rpx;
}
.security-badge-icon {
  color: #52c41a;
  font-size: 38rpx;
}
.privacy-warning-box {
  background: #fffbe6;
  border: 1rpx solid #ffe58f;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}
.warning-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #d48806;
  margin-bottom: 10rpx;
}
.warning-text {
  font-size: 24rpx;
  color: #8c6d1f;
  line-height: 1.5;
}
.privacy-phone-card {
  background: #f5f5f5;
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
  margin-bottom: 28rpx;
}
.phone-label {
  font-size: 24rpx;
  color: #8c8c8c;
}
.phone-number {
  font-size: 44rpx;
  font-weight: 950;
  color: #d45f22;
  margin: 10rpx 0;
}
.phone-ext {
  font-size: 28rpx;
  font-weight: 800;
  color: #262626;
}
.phone-target {
  font-size: 24rpx;
  color: #595959;
  margin-top: 10rpx;
}
.custom-modal-actions {
  display: flex;
  gap: 20rpx;
}
.call-action-btn {
  flex: 1.4;
}
.cancel-action-btn {
  flex: 1;
}

/* 聊天弹窗 */
.chat-modal-box {
  width: 100%;
  max-width: 680rpx;
  height: 820rpx;
  max-height: 90vh;
  background: #ffffff;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.chat-title {
  font-size: 32rpx;
  font-weight: 850;
  color: #262626;
}
.close-btn {
  font-size: 38rpx;
  color: #8c8c8c;
  padding: 8rpx;
}
.chat-warning-banner {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #fff2e8;
  color: #d4380d;
  font-size: 22rpx;
  line-height: 1.4;
}
.chat-body {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 24rpx;
  box-sizing: border-box;
  background: #fafafa;
}
.chat-empty {
  text-align: center;
  color: #bfbfbf;
  font-size: 26rpx;
  margin-top: 100rpx;
}
.chat-msg-row {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}
.chat-msg-row.self {
  align-items: flex-end;
}
.chat-msg-row.other {
  align-items: flex-start;
}
.msg-sender {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-bottom: 6rpx;
}
.msg-bubble {
  max-width: 75%;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.4;
  word-break: break-all;
}
.chat-msg-row.self .msg-bubble {
  background: #ff7d38;
  color: #ffffff;
  border-bottom-right-radius: 4rpx;
}
.chat-msg-row.other .msg-bubble {
  background: #ffffff;
  color: #262626;
  border: 1rpx solid #e8e8e8;
  border-bottom-left-radius: 4rpx;
}
.msg-time {
  font-size: 20rpx;
  color: #bfbfbf;
  margin-top: 6rpx;
}
.chat-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #ffffff;
}
.chat-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 32rpx;
  height: 72rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
}
.chat-send-btn {
  width: 140rpx !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  font-size: 26rpx !important;
  padding: 0 !important;
}

.chat-header, .chat-warning-banner, .chat-footer, .chat-sync-status, .chat-new-messages { flex-shrink: 0; }
.chat-sync-status, .chat-new-messages { padding: 14rpx 24rpx; font-size: 24rpx; line-height: 1.5; text-align: center; color: #a65127; background: #fff4e8; }

.subscribe-notice-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fff7eb 0%, #fff1df 100%);
  border: 1rpx solid rgba(245, 154, 35, 0.3);
  border-radius: 20rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 20rpx;
}
.subscribe-banner-content {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}
.subscribe-icon {
  font-size: 32rpx;
  color: #ea7019;
}
.subscribe-text {
  font-size: 24rpx;
  color: #8c4c16;
  font-weight: 500;
}
.subscribe-btn-text {
  font-size: 22rpx;
  color: #ffffff;
  background: #ea7019;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-weight: bold;
}

