/* Client order detail - Cute Pet Style UI redesign */
.order-detail-page {
  min-height: 100vh;
  padding: 0 28rpx 120rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.detail-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon { font-size: 28rpx; }

.hero-title {
  color: #2d211a;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.card,
.summary-card {
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
  border-radius: 36rpx;
}

.summary-card {
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.summary-label {
  color: #8e8580;
  font-size: 24rpx;
}

.summary-status {
  margin-top: 8rpx;
  color: #2d211a;
  font-size: 34rpx;
  font-weight: 950;
}

.summary-price,
.price {
  color: #e9672f;
  font-weight: 950;
}

.summary-price {
  font-size: 44rpx;
  flex-shrink: 0;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.card-subtitle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  margin-bottom: 18rpx;
}

.sub-icon {
  color: #e9672f;
  font-size: 34rpx;
}

.order-person {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.order-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 32rpx;
  background: #fff0e2;
  flex-shrink: 0;
}

.order-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9672f;
  font-size: 42rpx;
}

.person-info {
  min-width: 0;
}

.person-name {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
}

.person-phone {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.08);
}

.info-row:last-child { border-bottom: none; }

.label {
  color: #8e8580;
  font-size: 24rpx;
  flex-shrink: 0;
  min-width: 150rpx;
}

.value {
  color: #574b42;
  font-size: 25rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.discount { color: #00b42a; }

.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #e6f8ea;
  color: #00b42a;
  font-size: 22rpx;
  font-weight: 850;
  white-space: nowrap;
}

.notice-text {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 25rpx;
  line-height: 1.55;
}

.security-block {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: #fff8ec;
}

.image-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.security-image {
  width: 100%;
  height: 160rpx;
  border-radius: 22rpx;
  background: #fff0e2;
}

.reset-panel {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: #fff8ec;
}

.reset-panel input {
  height: 78rpx;
  padding: 0 22rpx;
  margin-bottom: 14rpx;
  border-radius: 22rpx;
  background: #ffffff;
  color: #2d211a;
  font-size: 26rpx;
  box-sizing: border-box;
}

.primary-btn,
.ghost-btn {
  min-height: 78rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
  line-height: 1;
  box-sizing: border-box;
}

.primary-btn::after,
.ghost-btn::after { display: none; }

.primary-btn .remix-icon,
.ghost-btn .remix-icon {
  font-size: 30rpx;
  line-height: 1;
}

.primary-btn {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(255, 122, 69, 0.2);
}

.ghost-btn {
  background: #fff0e2;
  color: #7a6a5e;
}

.inline-btn {
  margin: 18rpx 0 0;
  width: fit-content;
  min-width: 260rpx;
  padding: 0 22rpx;
}

.action-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.timeline {
  padding-left: 18rpx;
  border-left: 2rpx solid rgba(255, 153, 102, 0.18);
}

.timeline-item {
  position: relative;
  padding-bottom: 24rpx;
}

.timeline-item:last-child { padding-bottom: 0; }

.timeline-dot {
  position: absolute;
  left: -28rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e9672f;
  border: 5rpx solid #fff0e2;
}

.timeline-content {
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff8ec;
}

.timeline-title {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 950;
}

.timeline-desc,
.timeline-time {
  margin-top: 8rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.45;
}

.timeline-time { color: #a89b90; }

.review-score {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: #fff0e2;
  font-size: 26rpx;
  font-weight: 900;
}

.review-score .remix-icon {
  color: #ffb020;
  font-size: 30rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff0e2;
  color: #d45f22;
  font-size: 23rpx;
  font-weight: 800;
}

.bottom-actions {
  display: grid;
  gap: 16rpx;
  margin-top: 28rpx;
}

button[disabled] { opacity: 0.62; }
