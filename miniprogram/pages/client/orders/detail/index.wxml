<view class="page {{themeClass}} {{fontClass}}" wx:if="{{order}}">
  <view class="dashboard-header">
    <view class="badge">订单详情</view>
    <view class="title">{{order.serviceSummary || (order.serviceType === 'walk' ? '上门遛狗' : '上门喂养')}}</view>
    <view class="tip">订单号 {{order.orderNo}}</view>
  </view>

  <view class="soft-panel">
    <view class="between">
      <view>
        <view class="muted">当前状态</view>
        <view class="strong">{{order.statusText}}</view>
      </view>
      <view class="price">¥{{order.payAmount}}</view>
    </view>
  </view>

  <view class="card">
    <view class="subtitle">客户信息</view>
    <view class="order-person">
      <image class="order-avatar" wx:if="{{order.clientSnapshot && order.clientSnapshot.avatarUrl}}" src="{{order.clientSnapshot.avatarUrl}}" mode="aspectFill" />
      <view class="order-avatar" wx:else>🐾</view>
      <view>
        <view class="strong">{{order.clientSnapshot.displayName || '宠物主'}}</view>
        <view class="muted">{{order.clientSnapshot.phoneMasked || '当前下单账号'}}</view>
      </view>
    </view>
  </view>

  <view class="card info-list">
    <view class="info-row"><view class="label">服务</view><view class="value">{{order.serviceSummary || (order.serviceType === 'walk' ? '遛狗' : '喂养')}}</view></view>
    <view class="info-row"><view class="label">发布方式</view><view class="value">{{order.publishMode === 'direct' ? '指定宠托师' : '公开发布抢单'}}</view></view>
    <view class="info-row" wx:if="{{order.publishMode === 'direct'}}"><view class="label">指定宠托师</view><view class="value">{{order.requestedStaffName || '已指定宠托师'}}</view></view>
    <view class="info-row"><view class="label">宠物</view><view class="value">{{order.petName}}</view></view>
    <view class="info-row"><view class="label">地址</view><view class="value">{{order.serviceAddress}}</view></view>
    <view class="info-row" wx:if="{{order.addressDetail}}"><view class="label">详细地址</view><view class="value">{{order.addressDetail}}</view></view>
    <view class="info-row" wx:if="{{order.doorplate}}"><view class="label">门牌说明</view><view class="value">{{order.doorplate}}</view></view>
    <view class="info-row" wx:if="{{order.orderHomeSecurity}}"><view class="label">入户方式</view><view class="value">{{order.orderHomeSecurity.lockMethodText}}</view></view>
    <view class="info-row" wx:if="{{order.orderHomeSecurity && order.orderHomeSecurity.oneTimeCode}}"><view class="label">一次性密码</view><view class="value">{{order.orderHomeSecurity.oneTimeCode.masked}} · {{order.orderHomeSecurity.oneTimeCode.effectiveStart}} 至 {{order.orderHomeSecurity.oneTimeCode.effectiveEnd}}</view></view>
    <view class="info-row"><view class="label">时间</view><view class="value">{{order.startTime}} - {{order.endTime}}</view></view>
    <view class="info-row" wx:if="{{order.durationMinutes}}"><view class="label">时长</view><view class="value">{{order.durationMinutes}}分钟</view></view>
    <view class="info-row"><view class="label">状态</view><view class="badge">{{order.statusText}}</view></view>
    <view class="info-row"><view class="label">原价</view><view class="value">¥{{order.amount}}</view></view>
    <view class="info-row" wx:if="{{order.discountAmount}}"><view class="label">优惠券</view><view class="value">-¥{{order.discountAmount}} {{order.couponName}}</view></view>
    <view class="info-row"><view class="label">实付金额</view><view class="price">¥{{order.payAmount}}</view></view>
    <view class="info-row"><view class="label">支付状态</view><view class="value">{{order.paymentStatusText}}</view></view>
    <view class="info-row" wx:if="{{order.paymentNo}}"><view class="label">支付单号</view><view class="value">{{order.paymentNo}}</view></view>
    <view class="info-row" wx:if="{{order.paidAt}}"><view class="label">支付时间</view><view class="value">{{order.paidAt}}</view></view>
    <view class="info-row"><view class="label">接单微信通知</view><view class="value">{{order.acceptedNotifyStatusText}}</view></view>
    <view class="info-row"><view class="label">接单通知失败</view><view class="value">{{order.acceptedNotifyErrorText}}</view></view>
    <view class="info-row" wx:if="{{order.refundText}}"><view class="label">退款进度</view><view class="value">{{order.refundText}}</view></view>
    <view class="info-row" wx:if="{{order.refundNo}}"><view class="label">退款单号</view><view class="value">{{order.refundNo}}</view></view>
  </view>

  <view class="card" wx:if="{{order.orderHomeSecurity}}">
    <view class="subtitle">家庭安防</view>
    <view class="info-row"><view class="label">方式</view><view class="value">{{order.orderHomeSecurity.lockMethodText}}</view></view>
    <view wx:if="{{order.orderHomeSecurity.type === 'someone_home'}}" class="muted">有人在家，宠托师到达后敲门即可。</view>
    <view wx:if="{{order.orderHomeSecurity.type === 'remote_unlock'}}">
      <view class="muted">宠托师到达后可请求你远程开门，系统会发送微信提醒；电话催办由平台客服转接。</view>
      <view class="info-row" wx:if="{{order.orderHomeSecurity.remoteUnlock && order.orderHomeSecurity.remoteUnlock.lastRequestedAt}}"><view class="label">最近请求</view><view class="value">{{order.orderHomeSecurity.remoteUnlock.lastRequestedAt}}</view></view>
    </view>
    <view wx:if="{{order.orderHomeSecurity.oneTimeCode}}">
      <view class="info-row"><view class="label">密码状态</view><view class="value">已设置 {{order.orderHomeSecurity.oneTimeCode.masked}}</view></view>
      <view class="info-row"><view class="label">有效区间</view><view class="value">{{order.orderHomeSecurity.oneTimeCode.effectiveStart}} 至 {{order.orderHomeSecurity.oneTimeCode.effectiveEnd}}</view></view>
      <view class="muted">{{order.orderHomeSecurity.oneTimeCode.coversServiceTime ? '已覆盖全程服务时间' : '未覆盖全程服务时间，请重新设置'}}</view>
      <button class="ghost" bindtap="showResetOneTimeCode">重新设置一次性密码</button>
    </view>
    <view wx:if="{{order.orderHomeSecurity.key}}">
      <view class="info-row"><view class="label">钥匙位置</view><view class="value">{{order.orderHomeSecurity.key.location}}</view></view>
      <view class="image-list" wx:if="{{order.orderHomeSecurity.key.imageFileIds.length}}"><image wx:for="{{order.orderHomeSecurity.key.imageFileIds}}" wx:key="*this" class="security-image" src="{{item}}" mode="aspectFill" /></view>
      <view class="info-row"><view class="label">放回状态</view><view class="value">{{order.orderHomeSecurity.key.returnedAt ? '已放回' : '待宠托师放回打卡'}}</view></view>
      <view class="image-list" wx:if="{{order.orderHomeSecurity.key.returnImageFileIds.length}}"><image wx:for="{{order.orderHomeSecurity.key.returnImageFileIds}}" wx:key="*this" class="security-image" src="{{item}}" mode="aspectFill" /></view>
    </view>
    <view class="notice" wx:if="{{resettingCode}}">
      <input password placeholder="新的开门密码" value="{{resetCodeForm.code}}" data-field="code" bindinput="inputResetCode" />
      <input placeholder="生效时间，如 2026-08-25 09:30" value="{{resetCodeForm.effectiveStart}}" data-field="effectiveStart" bindinput="inputResetCode" />
      <input placeholder="失效时间，如 2026-08-25 12:00" value="{{resetCodeForm.effectiveEnd}}" data-field="effectiveEnd" bindinput="inputResetCode" />
      <button class="primary" bindtap="saveResetOneTimeCode">保存新密码</button>
      <button class="ghost" bindtap="cancelResetOneTimeCode">取消</button>
    </view>
  </view>

  <view class="card" wx:if="{{order.earlyStartRequest}}">
    <view class="subtitle">提前开始服务申请</view>
    <view class="muted">{{order.earlyStartRequest.reason || '宠护师申请提前开始服务'}}</view>
    <view class="badge">{{order.earlyStartRequest.status === 'approved' ? '已同意' : (order.earlyStartRequest.status === 'rejected' ? '已拒绝' : '待处理')}}</view>
    <view class="chip-row" wx:if="{{order.earlyStartRequest.status === 'pending'}}">
      <button class="primary" loading="{{handlingEarlyStart}}" disabled="{{handlingEarlyStart}}" data-action="approve" bindtap="handleEarlyStart">同意提前开始</button>
      <button class="ghost" loading="{{handlingEarlyStart}}" disabled="{{handlingEarlyStart}}" data-action="reject" bindtap="handleEarlyStart">拒绝</button>
    </view>
  </view>

  <view class="card" wx:if="{{timeline.length}}">
    <view class="subtitle">订单进度</view>
    <view class="timeline">
      <view class="timeline-item" wx:for="{{timeline}}" wx:key="_id">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="strong">{{item.title}}</view>
          <view class="muted">{{item.detail}}</view>
          <view class="muted">{{item.createdAt}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{review}}">
    <view class="subtitle">服务评价</view>
    <view class="strong">{{review.rating}} 星</view>
    <view class="muted">{{review.content || '客户未填写文字评价'}}</view>
    <view class="tag-row" wx:if="{{review.tags.length}}">
      <view class="tag" wx:for="{{review.tags}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <button class="primary" wx:if="{{order.status === 'pending_pay'}}" loading="{{paying}}" disabled="{{paying}}" bindtap="pay">立即支付</button>
  <button class="ghost" wx:if="{{order.status === 'pending_pay' || order.status === 'paid' || order.status === 'assigned'}}" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancelOrder">{{cancelling ? '处理中...' : '取消订单 / 查看退款'}}</button>
  <button class="ghost" wx:if="{{order.status === 'completed' && !review}}" bindtap="reviewOrder">评价服务</button>
  <button class="ghost" wx:if="{{order.status === 'assigned' || order.status === 'in_service' || order.status === 'completed'}}" bindtap="createIncident">发起投诉 / 售后</button>
  <button class="ghost" wx:if="{{order.status === 'completed'}}" bindtap="rebook">再次预约</button>
  <button class="ghost" wx:if="{{order.status === 'in_service' || order.status === 'completed'}}" bindtap="tracking">查看轨迹 / 打卡</button>
  <button class="ghost" wx:if="{{order.status === 'completed'}}" bindtap="report">服务报告</button>
</view>
