<view class="page" wx:if="{{order}}"><view class="title">订单详情</view><view class="card"><view class="strong">{{order.orderNo}}</view><view>服务：{{order.serviceType === 'walk' ? '遛狗' : '喂养'}}</view><view>宠物：{{order.petName}}</view><view>状态：{{order.status}}</view><view>金额：¥{{order.payAmount}}</view></view><button class="primary" wx:if="{{order.status === 'pending_pay'}}" bindtap="pay">Mock 支付</button><button class="ghost" bindtap="tracking">查看轨迹/打卡</button><button class="ghost" bindtap="report">服务报告</button></view>