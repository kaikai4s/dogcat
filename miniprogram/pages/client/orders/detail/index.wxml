<wxs module="beijingTime" src="../../../../utils/beijing-time.wxs" />
<view class="page order-detail-page {{themeClass}} {{fontClass}}" wx:if="{{order}}">
  <view class="detail-hero">
    <view class="hero-badge"><text class="remix-icon ri-file-list-3-fill hero-icon"></text><text>订单详情</text></view>
    <view class="hero-title">{{order.serviceSummary || (order.serviceType === 'walk' ? '上门遛狗' : '上门喂养')}}</view>
    <view class="hero-desc">订单号 {{order.orderNo}}</view>
  </view>

  <view class="summary-card">
    <view class="summary-main">
      <view class="summary-label">当前状态</view>
      <view class="summary-status">{{order.statusText}}</view>
    </view>
    <view class="summary-price">¥{{order.payAmount}}</view>
  </view>

  <!-- 微信服务通知订阅授权栏（针对进行中的订单补充授权配额） -->
  <view class="subscribe-notice-banner" wx:if="{{order.status === 'paid' || order.status === 'assigned' || order.status === 'on_the_way' || order.status === 'in_service'}}" bindtap="subscribeServiceUpdates">
    <view class="subscribe-banner-content">
      <text class="remix-icon ri-notification-3-line subscribe-icon"></text>
      <text class="subscribe-text">开启微信服务动态提醒（接单、出发与打卡通知）</text>
    </view>
    <text class="subscribe-btn-text">开启提醒</text>
  </view>

  <!-- 隐私沟通与通话快捷栏 -->
  <view class="contact-actions-bar" wx:if="{{order.staffOpenid}}">
    <button class="ghost-btn contact-btn" bindtap="openPrivacyCall">
      <text class="remix-icon ri-phone-lock-fill"></text>
      <text>双向隐私通话</text>
    </button>
    <button class="ghost-btn contact-btn" bindtap="openSessionChat">
      <text class="remix-icon ri-message-3-fill"></text>
      <text>在线即时沟通</text>
    </button>
  </view>

  <!-- 时空雷达提醒卡片（宠托师在路上或已触发临近提醒） -->
  <view class="card radar-card" wx:if="{{order.status === 'on_the_way' || order.travelEtaMinutes !== undefined}}">
    <view class="card-subtitle">
      <text class="remix-icon ri-radar-fill sub-icon radar-pulse-icon"></text>
      <text>时空雷达：宠托师正赶往中</text>
    </view>
    <view class="radar-stats-grid">
      <view class="radar-stat-item">
        <view class="radar-stat-label">预计到达时间</view>
        <view class="radar-stat-val">约 {{order.travelEtaMinutes !== undefined ? order.travelEtaMinutes : 10}} 分钟</view>
      </view>
      <view class="radar-stat-item">
        <view class="radar-stat-label">距离您家</view>
        <view class="radar-stat-val">约 {{order.travelDistanceKm !== undefined ? order.travelDistanceKm : 1.0}} 公里</view>
      </view>
    </view>
    <view class="radar-proximity-banner" wx:if="{{order.radarProximityNotified || (order.travelDistanceKm !== undefined && order.travelDistanceKm <= 1.0)}}">
      <text class="remix-icon ri-alarm-warning-fill"></text>
      <text>【临近到家提醒】宠托师已进入您家1公里范围（预计10分钟内到达），请留意门铃或查看开门提醒！</text>
    </view>
    <view class="radar-tip-text">系统基于实时GPS测距计算预计到达时间，宠托师到达后将先进行隔离消毒拍照。</view>
  </view>

  <!-- 现场照料实时流（即拍即达） -->
  <view class="card live-stream-card" wx:if="{{liveCheckins && liveCheckins.length}}">
    <view class="card-subtitle">
      <text class="remix-icon ri-live-fill sub-icon live-stream-icon"></text>
      <text>现场照料实时流（即拍即达）</text>
    </view>
    <view class="live-stream-desc">宠托师现场打卡即时同步，如同现场图文直播</view>
    <view class="live-stream-list">
      <view class="live-stream-item" wx:for="{{liveCheckins}}" wx:key="_id">
        <view class="live-photo-wrap">
          <image class="live-photo" src="{{item.mediaFileId}}" mode="aspectFill" data-url="{{item.mediaFileId}}" bindtap="previewLiveCheckinPhoto" />
        </view>
        <view class="live-info">
          <view class="live-header">
            <text class="live-tag">{{item.eventType === 'sanitization' ? '进门消毒' : (item.eventType === 'feed' ? '添加粮食' : (item.eventType === 'water' ? '更换饮水' : (item.eventType === 'litter' ? '清理猫砂' : (item.eventType === 'play' ? '陪伴玩耍' : (item.eventType === 'medicine' ? '喂药照料' : (item.eventType === 'pet_beauty_photo' ? '毛孩子美照' : '现场打卡'))))))}}</text>
            <text class="live-time">{{beijingTime.format(item.recordedAt || item.createdAt)}}</text>
          </view>
          <view class="live-remark">{{item.remark || '宠托师已完成该项照料打卡'}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card order-message-entry interactive" bindtap="openOrderMessages">
    <view class="entry-left">
      <view class="entry-icon remix-icon ri-chat-3-fill"></view>
      <view class="entry-texts">
        <view class="entry-title">订单消息记录</view>
        <view class="entry-desc">查看此订单的历史通知、服务进度与系统消息</view>
      </view>
    </view>
    <view class="remix-icon ri-arrow-right-s-line entry-arrow"></view>
  </view>

  <view class="card person-card">
    <view class="card-subtitle"><text class="remix-icon ri-user-heart-line sub-icon"></text><text>客户信息</text></view>
    <view class="order-person">
      <view class="avatar-level-wrap">
        <image class="order-avatar" wx:if="{{order.clientSnapshot && order.clientSnapshot.avatarUrl}}" src="{{order.clientSnapshot.avatarUrl}}" mode="aspectFill" />
        <view class="order-avatar placeholder" wx:else><text class="remix-icon ri-paw-print-line"></text></view>
        <view class="avatar-level-badge badge-{{order.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{order.clientSnapshot && (order.clientSnapshot.badgeTag || order.clientSnapshot.memberLevelName)}}">{{order.clientSnapshot.badgeTag || order.clientSnapshot.memberLevelName}}</view>
      </view>
      <view class="person-info">
        <view class="person-name">
          <text class="{{order.clientSnapshot.nameEffect && order.clientSnapshot.nameEffect !== 'none' ? 'name-effect-' + order.clientSnapshot.nameEffect : ''}}" style="{{(!order.clientSnapshot.nameEffect || order.clientSnapshot.nameEffect === 'none' || order.clientSnapshot.nameEffect === '3d_emboss') && order.clientSnapshot.nameColor ? 'color: ' + order.clientSnapshot.nameColor + ';' : ''}}">{{order.clientSnapshot.nickname || order.clientSnapshot.displayName || '宠物主'}}</text>
          <text class="member-badge badge-{{order.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{order.clientSnapshot && (order.clientSnapshot.badgeTag || order.clientSnapshot.memberLevelName)}}">{{order.clientSnapshot.badgeTag || order.clientSnapshot.memberLevelName}}</text>
        </view>
        <view class="person-phone">{{order.clientSnapshot.phoneMasked || '当前下单账号'}}</view>
      </view>
    </view>
  </view>

  <view class="card info-card">
    <view class="card-subtitle"><text class="remix-icon ri-list-check-3-line sub-icon"></text><text>服务与支付</text></view>
    <view class="info-row"><view class="label">服务</view><view class="value">{{order.serviceSummary || (order.serviceType === 'walk' ? '遛狗' : '喂养')}}</view></view>
    <view class="info-row"><view class="label">发布方式</view><view class="value">{{order.publishMode === 'direct' ? '指定宠托师' : '公开发布抢单'}}</view></view>
    <view class="info-row"><view class="label">宠托师性别要求</view><view class="value">{{order.staffGenderRequirement === 'male' ? '男性宠托师' : (order.staffGenderRequirement === 'female' ? '女性宠托师' : '不限')}}</view></view>
    <view class="info-row" wx:if="{{order.publishMode === 'direct'}}"><view class="label">指定宠托师</view><view class="value">{{order.requestedStaffName || '已指定宠托师'}}</view></view>
    <view class="info-row"><view class="label">宠物</view><view class="value pet-title-value">{{order.petName}}<text class="pet-title-badge" wx:if="{{order.petSnapshot && order.petSnapshot.beautyTitle && order.petSnapshot.beautyTitle.title}}">{{order.petSnapshot.beautyTitle.title}}</text></view></view>
    <view class="info-row"><view class="label">地址</view><view class="value">{{order.serviceAddress}}</view></view>
    <view class="info-row" wx:if="{{order.addressDetail}}"><view class="label">详细地址</view><view class="value">{{order.addressDetail}}</view></view>
    <view class="info-row" wx:if="{{order.doorplate}}"><view class="label">门牌说明</view><view class="value">{{order.doorplate}}</view></view>
    <view class="info-row" wx:if="{{order.orderHomeSecurity}}"><view class="label">入户方式</view><view class="value">{{order.orderHomeSecurity.lockMethodText}}</view></view>
    <view class="info-row" wx:if="{{order.orderHomeSecurity && order.orderHomeSecurity.oneTimeCode}}"><view class="label">一次性密码</view><view class="value">{{order.orderHomeSecurity.oneTimeCode.masked}} · {{beijingTime.format(order.orderHomeSecurity.oneTimeCode.effectiveStart)}} 至 {{beijingTime.format(order.orderHomeSecurity.oneTimeCode.effectiveEnd)}}</view></view>
    <view class="info-row"><view class="label">时间</view><view class="value">{{beijingTime.format(order.startTime)}} - {{beijingTime.format(order.endTime)}}</view></view>
    <view wx:if="{{order.petServiceDurations && order.petServiceDurations.length}}" class="session-list">
      <view class="session-label">每日服务任务{{order.sessionCount > 1 ? '（每天相同）' : ''}}</view>
      <view class="session-item" wx:for="{{order.petServiceDurations}}" wx:key="index">{{index + 1}}. {{item.petName}}｜{{item.serviceLabel}}｜{{item.durationMinutes}}分钟</view>
    </view>
    <view class="info-row" wx:if="{{order.durationMinutes}}"><view class="label">{{order.petServiceDurations.length ? '每日合计' : '时长'}}</view><view class="value">{{order.durationMinutes}}分钟{{order.sessionCount > 1 ? ' × ' + order.sessionCount + '次' : ''}}</view></view>
    <view wx:if="{{order.serviceSessions.length > 1}}" class="session-list">
      <view class="session-label">每日服务安排</view>
      <view class="session-item" wx:for="{{order.serviceSessions}}" wx:key="index">第{{item.index}}天 · {{item.date}} · {{beijingTime.format(item.startTime)}} 至 {{beijingTime.format(item.endTime)}}</view>
    </view>
    <view class="info-row"><view class="label">状态</view><view class="status-badge">{{order.statusText}}</view></view>
    <view class="info-row"><view class="label">原价</view><view class="value">¥{{order.amount}}</view></view>
    <view class="info-row" wx:if="{{order.discountAmount}}"><view class="label">优惠券</view><view class="value discount">-¥{{order.discountAmount}} {{order.couponName}}</view></view>
    <view class="info-row"><view class="label">实付金额</view><view class="price">¥{{order.payAmount}}</view></view>
    <view class="info-row"><view class="label">支付状态</view><view class="value">{{order.paymentStatusText}}</view></view>
    <view class="info-row" wx:if="{{order.paymentNo}}"><view class="label">支付单号</view><view class="value">{{order.paymentNo}}</view></view>
    <view class="info-row" wx:if="{{order.paidAt}}"><view class="label">支付时间</view><view class="value">{{beijingTime.format(order.paidAt)}}</view></view>
    <view class="info-row" wx:if="{{order.refundText}}"><view class="label">退款进度</view><view class="value">{{order.refundText}}</view></view>
    <view class="info-row" wx:if="{{order.refundNo}}"><view class="label">退款单号</view><view class="value">{{order.refundNo}}</view></view>
  </view>

  <view class="card security-card" wx:if="{{order.orderHomeSecurity}}">
    <view class="card-subtitle"><text class="remix-icon ri-door-lock-line sub-icon"></text><text>家庭安防</text></view>
    <view class="info-row"><view class="label">方式</view><view class="value">{{order.orderHomeSecurity.lockMethodText}}</view></view>
    <view wx:if="{{order.orderHomeSecurity.type === 'someone_home'}}" class="security-block">
      <view class="info-row"><view class="label">入户方式</view><view class="value">有人在家</view></view>
      <view class="notice-text">服务时段内家中有人，宠托师到达后敲门即可进门；若宠物易激动请提前协助安抚。</view>
    </view>
    <view wx:if="{{order.orderHomeSecurity.type === 'remote_unlock'}}" class="security-block">
      <view class="info-row"><view class="label">入户方式</view><view class="value">上门后远程开门</view></view>
      <view class="notice-text">宠托师到达后会发起远程开门请求，请注意查看微信通知，并在智能锁 App 中为宠托师远程开门。</view>
      <view class="info-row" wx:if="{{order.orderHomeSecurity.remoteUnlock && order.orderHomeSecurity.remoteUnlock.lastRequestedAt}}"><view class="label">最近请求</view><view class="value">{{beijingTime.format(order.orderHomeSecurity.remoteUnlock.lastRequestedAt)}}</view></view>
      <view class="info-row" wx:if="{{order.orderHomeSecurity.remoteUnlock && order.orderHomeSecurity.remoteUnlock.requestCount}}"><view class="label">请求次数</view><view class="value">{{order.orderHomeSecurity.remoteUnlock.requestCount}} 次</view></view>
    </view>
    <view wx:if="{{order.orderHomeSecurity.oneTimeCode}}" class="security-block">
      <view class="info-row"><view class="label">入户方式</view><view class="value">智能门锁一次性密码</view></view>
      <view class="info-row"><view class="label">首场密码</view><view class="value">{{order.orderHomeSecurity.oneTimeCode.destroyed ? '已脱敏销毁' : ('已设置 ' + order.orderHomeSecurity.oneTimeCode.masked)}}</view></view>
      <view class="info-row"><view class="label">有效区间</view><view class="value">{{beijingTime.format(order.orderHomeSecurity.oneTimeCode.effectiveStart)}} 至 {{beijingTime.format(order.orderHomeSecurity.oneTimeCode.effectiveEnd)}}</view></view>
      <view class="notice-text" wx:if="{{!order.orderHomeSecurity.destroyed && !order.isDoorLockCodeDestroyed}}">{{order.orderHomeSecurity.oneTimeCode.coversServiceTime ? '已覆盖全程服务时间' : '未覆盖全程服务时间，请重新设置'}}</view>
      <view class="security-destroyed-banner" wx:if="{{order.orderHomeSecurity.destroyed || order.isDoorLockCodeDestroyed || order.orderHomeSecurity.isPasswordDestroyed}}">
        <view class="destroyed-title"><text class="remix-icon ri-shield-check-fill"></text> 门锁密码已脱敏销毁存证</view>
        <view class="destroyed-desc">服务完成并点击“确认离开”后，系统已自动在云端对门锁密码进行脱敏抹除，宠托师端已永久不可见，严密守护您的家庭安全。</view>
        <view class="destroyed-time" wx:if="{{order.doorLockCodeDestroyedAt || order.orderHomeSecurity.passwordDestroyedAt}}">销毁时间：{{beijingTime.format(order.doorLockCodeDestroyedAt || order.orderHomeSecurity.passwordDestroyedAt)}}</view>
      </view>
      <view wx:if="{{order.orderHomeSecurity.sessionCodes && order.orderHomeSecurity.sessionCodes.length}}" class="session-codes-wrap">
        <view class="session-codes-title"><text class="remix-icon ri-calendar-check-line"></text> 各天专属智能锁密码：</view>
        <view class="session-code-row" wx:for="{{order.orderHomeSecurity.sessionCodes}}" wx:key="sessionIndex">
          <view class="session-code-header">
            <text class="session-code-day">第{{item.sessionIndex}}天 ({{item.date}})</text>
            <text class="session-code-val {{item.destroyed ? 'destroyed' : ''}}">{{item.destroyed ? '已脱敏销毁' : (item.masked || '已设置')}}</text>
          </view>
          <view class="session-code-time">有效时间：{{beijingTime.format(item.effectiveStart)}} 至 {{beijingTime.format(item.effectiveEnd)}}</view>
        </view>
      </view>
      <button class="ghost-btn inline-btn" wx:if="{{!order.orderHomeSecurity.destroyed && !order.orderHomeSecurity.isPasswordDestroyed && !order.isDoorLockCodeDestroyed && order.status !== 'completed' && order.status !== 'cancelled'}}" bindtap="showResetOneTimeCode"><text class="remix-icon ri-key-2-line"></text><text>重新设置一次性密码</text></button>
    </view>
    <view wx:if="{{order.orderHomeSecurity.key}}" class="security-block">
      <view class="info-row"><view class="label">入户方式</view><view class="value">钥匙入户</view></view>
      <view class="info-row"><view class="label">钥匙位置</view><view class="value">{{order.orderHomeSecurity.key.location}}</view></view>
      <view class="image-list" wx:if="{{order.orderHomeSecurity.key.imageFileIds.length}}"><image wx:for="{{order.orderHomeSecurity.key.imageFileIds}}" wx:key="*this" class="security-image" src="{{item}}" mode="aspectFill" /></view>
      <view class="info-row"><view class="label">放回状态</view><view class="value {{order.orderHomeSecurity.key.returnedAt ? 'status-green' : 'status-orange'}}">{{order.orderHomeSecurity.key.returnedAt ? '已放回原位' : '服务中 · 待宠托师放回打卡'}}</view></view>
      <view class="image-list" wx:if="{{order.orderHomeSecurity.key.returnImageFileIds.length}}"><image wx:for="{{order.orderHomeSecurity.key.returnImageFileIds}}" wx:key="*this" class="security-image" src="{{item}}" mode="aspectFill" /></view>
      <view class="notice-text" wx:if="{{!order.orderHomeSecurity.key.returnedAt}}">宠托师必须在服务完成离开前将钥匙放回原位置并拍照打卡，平台全程留痕存证。</view>
      <view class="notice-text" wx:if="{{order.orderHomeSecurity.key.returnedAt}}">钥匙已于 {{order.orderHomeSecurity.key.returnedAt}} 放回原位置并拍照留存。</view>
    </view>
    <view class="reset-panel" wx:if="{{resettingCode}}">
      <view class="reset-tip-box">
        <view class="reset-tip-title"><text class="remix-icon ri-shield-check-line"></text> 智能门锁一次性密码设置指引</view>
        <view class="reset-tip-desc">请确认家中为智能门锁，并在门锁手机 App（如米家、鹿客、凯迪仕等）中生成服务时间段对应的临时密码后填入保存：</view>
      </view>
      <view class="session-picker-wrap" wx:if="{{resetSessionOptions.length > 1}}">
        <picker range="{{resetSessionOptions}}" range-key="label" value="{{selectedResetSessionIdx}}" bindchange="chooseResetSession">
          <view class="field picker-field">设置目标：{{resetSessionOptions[selectedResetSessionIdx].label}} <text class="remix-icon ri-arrow-down-s-line"></text></view>
        </picker>
      </view>
      <input password placeholder="智能门锁App生成的临时密码" value="{{resetCodeForm.code}}" data-field="code" bindinput="inputResetCode" />
      <input placeholder="生效时间，如 2026-08-25 09:30" value="{{resetCodeForm.effectiveStart}}" data-field="effectiveStart" bindinput="inputResetCode" />
      <input placeholder="失效时间，如 2026-08-25 12:00" value="{{resetCodeForm.effectiveEnd}}" data-field="effectiveEnd" bindinput="inputResetCode" />
      <button class="primary-btn" bindtap="saveResetOneTimeCode"><text class="remix-icon ri-save-3-line"></text><text>保存新密码</text></button>
      <button class="ghost-btn" bindtap="cancelResetOneTimeCode">取消</button>
    </view>
  </view>

  <view class="card request-card" wx:if="{{order.earlyStartRequest}}">
    <view class="card-subtitle"><text class="remix-icon ri-time-line sub-icon"></text><text>提前开始服务申请</text></view>
    <view class="notice-text">{{order.earlyStartRequest.reason || '宠护师申请提前开始服务'}}</view>
    <view class="status-badge">{{order.earlyStartRequest.status === 'approved' ? '已同意' : (order.earlyStartRequest.status === 'rejected' ? '已拒绝' : '待处理')}}</view>
    <view class="action-row" wx:if="{{order.earlyStartRequest.status === 'pending'}}">
      <button class="primary-btn" loading="{{handlingEarlyStart}}" disabled="{{handlingEarlyStart}}" data-action="approve" bindtap="handleEarlyStart">同意提前开始</button>
      <button class="ghost-btn" loading="{{handlingEarlyStart}}" disabled="{{handlingEarlyStart}}" data-action="reject" bindtap="handleEarlyStart">拒绝</button>
    </view>
  </view>

  <view class="card timeline-card" wx:if="{{timeline.length}}">
    <view class="card-subtitle"><text class="remix-icon ri-history-line sub-icon"></text><text>订单进度</text></view>
    <view class="timeline">
      <view class="timeline-item" wx:for="{{timeline}}" wx:key="_id">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="timeline-title">{{item.title}}</view>
          <view class="timeline-desc">{{item.detail}}</view>
          <view class="timeline-time">{{beijingTime.format(item.createdAt)}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="card review-card" wx:if="{{review}}">
    <view class="card-subtitle"><text class="remix-icon ri-star-smile-line sub-icon"></text><text>服务评价</text></view>
    <view class="review-score">
      <view class="review-stars">
        <text class="remix-icon {{review.rating >= star ? 'ri-star-fill star-active' : 'ri-star-line star-inactive'}}" wx:for="{{[1,2,3,4,5]}}" wx:for-item="star" wx:key="*this"></text>
      </view>
      <text class="review-rating-num">{{review.rating}} 分</text>
    </view>
    <view class="notice-text">{{review.content || '客户未填写文字评价'}}</view>
    <view class="tag-row" wx:if="{{review.tags.length}}">
      <view class="tag" wx:for="{{review.tags}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <view class="bottom-actions">
    <button class="primary-btn" wx:if="{{order.status === 'pending_pay'}}" loading="{{paying}}" disabled="{{paying}}" bindtap="pay"><text class="remix-icon ri-bank-card-line"></text><text>立即支付</text></button>
    <button class="ghost-btn" wx:if="{{order.status === 'pending_pay' || order.status === 'paid' || order.status === 'assigned' || order.status === 'on_the_way' || order.status === 'day_completed'}}" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancelOrder"><text class="remix-icon ri-refund-2-line"></text><text>{{cancelling ? '处理中...' : (order.status === 'day_completed' ? '取消剩余天数 / 查看退款' : '取消订单 / 查看退款')}}</text></button>
    <button class="ghost-btn" wx:if="{{order.status === 'completed' && !review}}" bindtap="reviewOrder"><text class="remix-icon ri-star-smile-line"></text><text>评价服务</text></button>
    <button class="ghost-btn" wx:if="{{order.status === 'assigned' || order.status === 'in_service' || order.status === 'completed'}}" bindtap="createIncident"><text class="remix-icon ri-customer-service-2-line"></text><text>发起投诉 / 售后</text></button>
    <button class="ghost-btn" wx:if="{{order.status === 'completed'}}" bindtap="rebook"><text class="remix-icon ri-calendar-check-line"></text><text>再次预约</text></button>
    <button class="ghost-btn" bindtap="openOrderMessages"><text class="remix-icon ri-chat-3-line"></text><text>消息记录</text></button>
    <button class="ghost-btn" wx:if="{{order.status === 'in_service' || order.status === 'completed'}}" bindtap="tracking"><text class="remix-icon ri-route-line"></text><text>查看轨迹 / 打卡</text></button>
    <button class="ghost-btn" wx:if="{{order.status === 'completed'}}" bindtap="report"><text class="remix-icon ri-file-text-line"></text><text>服务报告</text></button>
  </view>
</view>

<!-- 双向隐私通话合规弹窗 -->
<view class="custom-modal-mask" wx:if="{{showCallModal}}">
  <view class="custom-modal-box">
    <view class="custom-modal-title">
      <text class="remix-icon ri-shield-check-fill security-badge-icon"></text>
      <text>双向隐私保护通话</text>
    </view>
    <view class="privacy-warning-box">
      <view class="warning-title">
        <text class="remix-icon ri-alarm-warning-fill"></text>
        <text>通话全程录音与质检提醒</text>
      </view>
      <view class="warning-text">{{privacyCallInfo.warningNotice || '平台提示：通话全程已录音并开启AI风控质检。请严格遵守平台规范，严禁私下索要或告知电话、微信、私下交易等跳单导流行为，违者将被取消保障并按平台规则处理。'}}</view>
    </view>
    <view class="privacy-phone-card">
      <view class="phone-label">平台分配隐私保护号：</view>
      <view class="phone-number">{{privacyCallInfo.privacyNumber || '400-888-9999'}}</view>
      <view class="phone-ext" wx:if="{{privacyCallInfo.extensionCode}}">分机号：{{privacyCallInfo.extensionCode}}</view>
      <view class="phone-target">接听方：宠托师（{{privacyCallInfo.maskedTargetPhone || '号码已隐藏'}}）</view>
    </view>
    <view class="custom-modal-actions">
      <button class="primary-btn call-action-btn" bindtap="confirmPrivacyCall">拨打虚拟号</button>
      <button class="ghost-btn cancel-action-btn" bindtap="closePrivacyCallModal">取消</button>
    </view>
  </view>
</view>

<!-- 在线即时安全沟通弹窗 -->
<view class="custom-modal-mask" wx:if="{{showChatModal}}">
  <view class="chat-modal-box">
    <view class="chat-header">
      <view class="chat-title">订单安全即时沟通</view>
      <view class="remix-icon ri-close-line close-btn" bindtap="closeSessionChat"></view>
    </view>
    <view class="chat-warning-banner">
      <text class="remix-icon ri-shield-alert-fill"></text>
      <text>严禁索要或发送微信号/手机号/私下转账，系统AI实时风控拦截。</text>
    </view>
    <view wx:if="{{sessionChatError}}" class="chat-sync-status">{{sessionChatError}}</view>
    <scroll-view class="chat-body" scroll-y scroll-into-view="{{sessionScrollTarget}}" bindscroll="onSessionChatScroll" bindscrolltolower="onSessionChatBottom" lower-threshold="60">
      <view class="chat-empty" wx:if="{{!sessionMessages.length}}">暂无沟通记录，可在此与宠托师即时沟通服务细节</view>
      <view class="chat-msg-row {{item.senderRole === 'client' ? 'self' : 'other'}}" wx:for="{{sessionMessages}}" wx:key="_id" id="session-message-{{index}}">
        <view class="msg-sender">{{item.senderRole === 'client' ? '我 (宠物主)' : '宠托师'}}</view>
        <view class="msg-bubble">{{item.content}}</view>
        <view class="msg-time">{{beijingTime.format(item.createdAt)}}</view>
      </view>
    </scroll-view>
    <view wx:if="{{sessionUnreadCount}}" class="chat-new-messages" bindtap="scrollSessionChatToBottom">{{sessionUnreadCount}} 条新消息 · 点击查看</view>
    <view class="chat-footer">
      <input class="chat-input" placeholder="输入沟通信息（自动风控过滤）" value="{{sessionInputText}}" bindinput="onChatInput" />
      <button class="primary-btn chat-send-btn" loading="{{sendingChatMessage}}" disabled="{{sendingChatMessage}}" bindtap="sendChatMessage">发送</button>
    </view>
  </view>
</view>

<global-loading />
