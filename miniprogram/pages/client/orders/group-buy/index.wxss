.group-page{min-height:100vh;box-sizing:border-box;padding:28rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));background:var(--theme-bg);color:var(--theme-text)}
.group-page button::after{border:0}.group-page button{box-sizing:border-box}
.group-hero{padding:34rpx;border-radius:32rpx;background:var(--theme-hero);box-shadow:0 12rpx 36rpx var(--theme-shadow)}
.hero-eyebrow{display:flex;align-items:center;gap:10rpx;font-size:23rpx;color:var(--theme-hero-text);font-weight:600}
.hero-eyebrow .remix-icon{font-size:30rpx}.hero-title{font-size:42rpx;line-height:1.4;font-weight:800;margin:14rpx 0 8rpx;word-break:break-all}
.hero-description{font-size:24rpx;color:var(--theme-muted);line-height:1.6}
.hero-benefits{display:flex;margin:28rpx 0;padding:24rpx 0;border-top:1rpx solid var(--theme-border);border-bottom:1rpx solid var(--theme-border)}
.hero-benefits>view{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;border-right:1rpx solid var(--theme-border);gap:8rpx}.hero-benefits>view:last-child{border:0}
.benefit-value{font-size:40rpx;line-height:1.3;font-weight:800;color:var(--theme-hero-text)}.benefit-unit{font-size:23rpx;font-weight:500;margin-left:6rpx}.benefit-small{font-size:28rpx;line-height:52rpx}.benefit-label{font-size:22rpx;color:var(--theme-muted)}
.group-primary{display:flex;justify-content:center;align-items:center;gap:18rpx;width:100%;margin:24rpx 0 0;padding:0 20rpx;line-height:88rpx;border-radius:22rpx;background:var(--theme-primary);color:#fff;font-size:28rpx;font-weight:700}.hero-note{font-size:25rpx;margin-top:20rpx;color:var(--theme-muted)}
.privacy-note{display:flex;align-items:flex-start;gap:12rpx;margin:24rpx 4rpx 32rpx;font-size:22rpx;line-height:1.7;color:var(--theme-muted)}.privacy-note .remix-icon{font-size:29rpx;color:var(--theme-primary)}
.section-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:34rpx 2rpx 20rpx;font-size:31rpx;font-weight:700}.section-count{font-size:23rpx;font-weight:500;color:var(--theme-primary);background:var(--theme-primary-soft);border-radius:10rpx;padding:3rpx 12rpx;margin-left:8rpx}.section-hint{font-size:21rpx;font-weight:400;color:var(--theme-muted)}
.group-card{margin-bottom:22rpx;padding:28rpx;border:1rpx solid var(--theme-border);border-radius:28rpx;background:var(--theme-card-bg);box-shadow:0 8rpx 24rpx var(--theme-shadow)}
.card-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx}.card-title{font-size:30rpx;line-height:1.5;font-weight:700;flex:1;min-width:0;word-break:break-all}.status-badge{flex-shrink:0;max-width:240rpx;padding:8rpx 14rpx;font-size:21rpx;line-height:1.4;border-radius:10rpx;color:var(--theme-primary);background:var(--theme-primary-soft)}.status-badge.formed{color:#287457;background:#e8f5ed}.status-badge.expired,.status-badge.neutral{color:var(--theme-muted);background:var(--theme-bg-soft)}
.schedule-row{display:flex;align-items:center;flex-wrap:wrap;gap:10rpx;margin-top:18rpx;font-size:25rpx;color:var(--theme-muted)}.schedule-row .remix-icon{font-size:28rpx}.session-tag{font-size:21rpx;background:var(--theme-bg-soft);padding:4rpx 10rpx;border-radius:7rpx}
.progress-heading{display:flex;justify-content:space-between;gap:12rpx;margin-top:26rpx;font-size:24rpx;color:var(--theme-muted)}.household-number{font-size:32rpx;font-weight:700;color:var(--theme-text)}.progress-track{height:10rpx;border-radius:8rpx;overflow:hidden;background:var(--theme-primary-soft);margin:12rpx 0}.progress-fill{height:100%;border-radius:8rpx;background:linear-gradient(90deg,var(--theme-primary-2),var(--theme-primary))}.is-closed .progress-fill{background:#c5bdb7}
.deadline-note{font-size:22rpx;color:var(--theme-muted);line-height:1.6}.card-footer{display:flex;justify-content:space-between;align-items:center;gap:16rpx;margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid var(--theme-border)}.price-block{flex:1;min-width:0;display:flex;flex-direction:column;gap:5rpx}.price-label{font-size:22rpx;color:var(--theme-muted)}.price-amount{font-size:36rpx;font-weight:800;color:var(--theme-primary)}
.card-action{display:flex;align-items:center;justify-content:center;flex-shrink:0;gap:6rpx;margin:0;padding:0 22rpx;line-height:76rpx;border-radius:18rpx;background:var(--theme-primary-soft);color:var(--theme-primary);font-size:25rpx;font-weight:600}.action-primary{background:var(--theme-primary);color:#fff}
.empty-card{text-align:center;padding:42rpx 24rpx;background:var(--theme-card-bg);border:1rpx dashed var(--theme-border);border-radius:26rpx;color:var(--theme-muted);font-size:23rpx;line-height:1.8}.empty-icon{display:block;font-size:48rpx;color:var(--theme-primary);margin-bottom:12rpx}.empty-title{font-size:28rpx;font-weight:600;color:var(--theme-text);margin-bottom:6rpx}
.load-error{display:flex;align-items:center;justify-content:space-between;padding:22rpx;border-radius:20rpx;background:var(--theme-primary-soft);font-size:25rpx}.load-error button{margin:0;font-size:24rpx;color:var(--theme-primary);background:var(--theme-card-bg);line-height:64rpx}.page-footnote{text-align:center;font-size:21rpx;color:var(--theme-muted);margin-top:32rpx}
