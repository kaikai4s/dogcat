<dovlin-refresh id="dovlinRefresh" bind:refresh="onCustomRefresh" bind:scrolltolower="onReachBottom">
<view class="page order-list-page {{themeClass}} {{fontClass}}">
  <view class="order-list-hero">
    <view class="order-list-kicker">我的预约</view>
    <view class="order-list-title">订单中心</view>
    <view class="order-list-desc">查看预约进度、服务状态和历史照护记录。</view>
  </view>

  <view class="order-filter-card">
    <view class="search-input-wrap">
      <text class="remix-icon ri-search-line search-icon"></text>
      <input
        class="filter-input"
        placeholder="搜索订单号 / 宠物名 / 服务"
        value="{{orderKeyword}}"
        bindinput="inputKeyword"
        bindconfirm="confirmSearch"
        confirm-type="search"
      />
      <text class="remix-icon ri-close-circle-fill clear-icon" wx:if="{{orderKeyword}}" bindtap="clearKeyword"></text>
      <view class="search-confirm-btn" bindtap="confirmSearch">搜索</view>
    </view>
    <view class="date-filter-row">
      <picker mode="date" value="{{startDate}}" bindchange="changeStartDate" class="date-picker-item">
        <view class="date-picker-btn {{startDate ? 'has-val' : ''}}">
          <text class="remix-icon ri-calendar-line picker-icon"></text>
          <text class="date-text">{{startDate || '开始日期'}}</text>
        </view>
      </picker>
      <text class="date-sep">至</text>
      <picker mode="date" value="{{endDate}}" bindchange="changeEndDate" class="date-picker-item">
        <view class="date-picker-btn {{endDate ? 'has-val' : ''}}">
          <text class="remix-icon ri-calendar-line picker-icon"></text>
          <text class="date-text">{{endDate || '结束日期'}}</text>
        </view>
      </picker>
      <view class="filter-reset-btn" wx:if="{{orderKeyword || startDate || endDate}}" bindtap="resetFilters">
        <text class="remix-icon ri-refresh-line"></text>
        <text>重置</text>
      </view>
    </view>
  </view>

  <scroll-view scroll-x class="status-tabs">
    <view class="status-tab {{activeStatus === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" data-status="{{item.value}}" bindtap="chooseStatus">{{item.label}}</view>
  </scroll-view>

  <view class="order-list-content">
    <!-- 骨架屏加载状态（叠加从左到右流光渐变） -->
    <view class="order-skeleton-list" wx:if="{{loading && !orders.length}}">
      <view class="card order-card order-skeleton-card" wx:for="{{[1, 2, 3]}}" wx:key="*this" style="margin-bottom: 24rpx;">
        <view class="order-card-head" style="display:flex; justify-content:space-between; align-items:center;">
          <view class="order-person" style="display:flex; align-items:center; gap: 16rpx;">
            <view class="skeleton-shimmer" style="width: 80rpx; height: 80rpx; border-radius: 50%; flex-shrink: 0;"></view>
            <view>
              <view class="skeleton-shimmer" style="width: 200rpx; height: 32rpx; border-radius: 6rpx; margin-bottom: 12rpx;"></view>
              <view class="skeleton-shimmer" style="width: 130rpx; height: 24rpx; border-radius: 6rpx;"></view>
            </view>
          </view>
          <view class="skeleton-shimmer" style="width: 110rpx; height: 44rpx; border-radius: 999rpx;"></view>
        </view>
        <view style="display:grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin: 24rpx 0; padding: 20rpx; background: rgba(20,89,56,0.03); border-radius: 16rpx;">
          <view>
            <view class="skeleton-shimmer" style="width: 100rpx; height: 22rpx; border-radius: 4rpx; margin-bottom: 8rpx;"></view>
            <view class="skeleton-shimmer" style="width: 160rpx; height: 28rpx; border-radius: 6rpx;"></view>
          </view>
          <view>
            <view class="skeleton-shimmer" style="width: 100rpx; height: 22rpx; border-radius: 4rpx; margin-bottom: 8rpx;"></view>
            <view class="skeleton-shimmer" style="width: 140rpx; height: 32rpx; border-radius: 6rpx;"></view>
          </view>
        </view>
        <view style="display:flex; gap: 12rpx;">
          <view class="skeleton-shimmer" style="width: 120rpx; height: 36rpx; border-radius: 8rpx;"></view>
          <view class="skeleton-shimmer" style="width: 120rpx; height: 36rpx; border-radius: 8rpx;"></view>
          <view class="skeleton-shimmer" style="width: 120rpx; height: 36rpx; border-radius: 8rpx;"></view>
        </view>
      </view>
    </view>

    <!-- 真实内容（数据返回后平滑模糊淡入） -->
    <view class="order-real-list {{contentLoaded ? 'blur-fade-in' : ''}}" wx:if="{{orders.length}}">
      <view class="order-card interactive" wx:for="{{orders}}" wx:key="_id" data-id="{{item._id}}" bindtap="detail">
      <view class="order-card-head">
        <view class="order-person">
          <view class="avatar-level-wrap">
            <image class="order-avatar" wx:if="{{item.clientSnapshot && item.clientSnapshot.avatarUrl}}" src="{{item.clientSnapshot.avatarUrl}}" mode="aspectFill" />
            <view class="order-avatar placeholder" wx:else><view class="remix-icon ri-file-user-line"></view></view>
            <view class="avatar-level-badge badge-{{item.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{item.clientSnapshot && (item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName)}}">{{item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName}}</view>
          </view>
          <view class="order-person-main">
            <view class="order-title-row">
              <text class="order-title {{item.clientSnapshot.nameEffect && item.clientSnapshot.nameEffect !== 'none' ? 'name-effect-' + item.clientSnapshot.nameEffect : ''}}" style="{{(!item.clientSnapshot.nameEffect || item.clientSnapshot.nameEffect === 'none' || item.clientSnapshot.nameEffect === '3d_emboss') && item.clientSnapshot.nameColor ? 'color: ' + item.clientSnapshot.nameColor + ';' : ''}}">{{item.clientSnapshot.nickname || item.clientSnapshot.displayName || '宠物主'}}</text>
              <text class="member-badge badge-{{item.clientSnapshot.badgeStyle || 'gold'}}" wx:if="{{item.clientSnapshot && (item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName)}}">{{item.clientSnapshot.badgeTag || item.clientSnapshot.memberLevelName}}</text>
              <text class="order-title">· {{item.petName}}</text>
              <view class="pet-title" wx:if="{{(item.petSnapshot && item.petSnapshot.beautyTitle && (item.petSnapshot.beautyTitle.title || item.petSnapshot.beautyTitle)) || (item.beautyTitle && (item.beautyTitle.title || item.beautyTitle))}}">
                <text class="remix-icon ri-vip-crown-fill"></text>
                <text>{{(item.petSnapshot && item.petSnapshot.beautyTitle && (item.petSnapshot.beautyTitle.title || item.petSnapshot.beautyTitle)) || (item.beautyTitle && (item.beautyTitle.title || item.beautyTitle))}}</text>
              </view>
            </view>
            <view class="order-service-wrap">
              <text class="group-buy-order-badge" wx:if="{{item.isGroupBuy || item.source === 'community_groupbuy' || item.groupBuyId}}">🏡 同小区拼单</text>
              <text class="order-service">{{item.serviceSummary || (item.serviceType === 'walk' ? '上门遛狗' : '上门喂养')}}</text>
            </view>
          </view>
        </view>
        <view class="badge {{item.isGroupBuy ? (item.groupBuyStatus === 'recruiting' ? 'badge-group-recruiting' : (item.groupBuyStatus === 'formed' ? 'badge-group-formed' : '')) : ''}}">{{item.statusText}}</view>
      </view>
      <view class="order-info-grid">
        <view><view class="order-label">创建时间</view><view class="order-value">{{item.createdAtText || '-'}}</view></view>
        <view><view class="order-label">预约时间</view><view class="order-value">{{item.appointmentTimeText || '-'}}</view></view>
        <view class="amount-cell"><view class="order-label">订单金额</view><view class="order-amount">¥{{item.payAmount}}</view></view>
        <view wx:if="{{item.discountAmount}}"><view class="order-label">已优惠</view><view class="order-value discount">¥{{item.discountAmount}}</view></view>
      </view>
      <view class="chip-row">
        <view class="chip">安心履约</view>
        <view class="chip pink">实时打卡</view>
        <view class="chip blue">服务报告</view>
      </view>
      <!-- 拼单专属进度提示与快捷入口 -->
      <view class="group-buy-card-footer" wx:if="{{item.isGroupBuy || item.source === 'community_groupbuy' || item.groupBuyId}}">
        <view class="group-buy-tip-text">
          <text class="remix-icon ri-group-line"></text>
          <text>{{item.groupBuyProgressText || '同小区拼单特惠'}}</text>
        </view>
        <view class="group-buy-detail-link" catchtap="openGroupBuyDetail" data-group-id="{{item.groupBuyId}}">
          <text>拼单详情</text>
          <text class="remix-icon ri-arrow-right-s-line"></text>
        </view>
      </view>
    </view>
    </view>

    <view class="list-state" wx:if="{{loading && orders.length}}">正在加载更多...</view>
    <view class="list-state" wx:if="{{!loading && orders.length && !hasMore}}">已显示全部订单</view>

    <view class="empty order-empty" wx:if="{{!loading && !orders.length}}">
      <view class="empty-icon remix-icon ri-file-list-3-line"></view>
      <view class="empty-title">暂时还没有订单</view>
      <view class="empty-desc">给爱宠预约一次上门照护，轨迹、打卡和报告都会实时记录。</view>
      <navigator class="primary empty-btn" url="/pages/client/orders/create/index">去预约</navigator>
    </view>

    <view class="subscribe-card">
      <view class="remix-icon ri-message-3-line subscribe-icon"></view>
      <view class="subscribe-main"><view class="strong">关注公众号订阅订单信息</view><view class="muted">服务进度、打卡提醒和优惠消息及时送达。</view></view>
      <view class="badge">立即订阅</view>
    </view>
  </view>
</view>
</dovlin-refresh>

<view class="bottom-nav client-bottom-nav">
  <view class="nav-item" data-url="/pages/client/home/index" bindtap="go"><view class="nav-icon remix-icon ri-home-5-line"></view><view>首页</view></view>
  <view class="nav-item" data-url="/pages/client/sitters/list/index" bindtap="go"><view class="nav-icon remix-icon ri-team-line"></view><view>宠托师</view></view>
  <view class="nav-item active"><view class="nav-icon remix-icon ri-file-list-3-fill"></view><view>订单</view></view>
  <view class="nav-item" data-url="/pages/client/messages/index" bindtap="go"><view class="nav-icon remix-icon ri-message-3-line"><view class="nav-unread-count" wx:if="{{messageUnreadCount > 0}}">{{messageUnreadCountText}}</view></view><view>消息</view></view>
  <view class="nav-item" data-url="/pages/client/profile/index" bindtap="go"><view class="nav-icon remix-icon ri-user-3-line"></view><view>我的</view></view>
</view>
<global-loading />
