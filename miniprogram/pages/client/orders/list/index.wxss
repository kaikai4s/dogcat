/* Client order list: rebuilt status-driven order center */
.order-list-page {
  padding: 0 0 178rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  overflow-x: hidden;
}

.order-list-page::before,
.order-list-page::after {
  display: none;
}

.order-list-page .remix-icon {
  position: relative;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  color: #ff8a45;
  font-size: 40rpx;
}

.order-list-page .remix-icon::before {
  font-family: "remixicon" !important;
  font-size: inherit;
  line-height: 1;
}

.order-list-hero {
  padding: 34rpx 30rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background:
    radial-gradient(circle at 90% 18%, rgba(255, 255, 255, 0.50) 0 64rpx, transparent 65rpx),
    linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.order-list-kicker {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  font-weight: 850;
}

.order-list-title {
  margin-top: 20rpx;
  color: #2d211a;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.18;
}

.order-list-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 26rpx;
  line-height: 1.45;
}

.status-tabs {
  position: sticky;
  top: 0;
  z-index: 20;
  width: auto;
  white-space: nowrap;
  margin: 0;
  padding: 18rpx 28rpx;
  background: rgba(255, 250, 246, 0.94);
  border-bottom: 1rpx solid rgba(255, 153, 102, 0.10);
  backdrop-filter: blur(14rpx);
}

.status-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 66rpx;
  margin-right: 14rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #8e8580;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  font-size: 26rpx;
  font-weight: 760;
  box-shadow: 0 8rpx 20rpx rgba(123, 89, 62, 0.05);
}

.status-tab.active {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  border-color: transparent;
  box-shadow: 0 12rpx 26rpx rgba(255, 122, 69, 0.22);
}

.order-list-content {
  padding: 6rpx 28rpx 0;
}

.order-card,
.subscribe-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 94% 16%, rgba(255, 184, 108, 0.14) 0 44rpx, transparent 45rpx),
    linear-gradient(180deg, #ffffff 0%, #fffaf4 100%);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.order-card-head,
.order-person,
.chip-row,
.subscribe-card {
  display: flex;
  align-items: center;
}

.order-card-head {
  justify-content: space-between;
  gap: 18rpx;
  align-items: flex-start;
}

.order-person {
  min-width: 0;
  flex: 1;
  gap: 18rpx;
}

.order-avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #fff0c9 0%, #fffaf4 100%);
  box-shadow: inset 0 -10rpx 24rpx rgba(255, 184, 108, 0.14);
  overflow: hidden;
}

.order-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9672f;
}

.order-person-main {
  min-width: 0;
  flex: 1;
}

.order-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-service,
.muted,
.order-label,
.list-state,
.empty-desc {
  margin-top: 6rpx;
  color: #8e8580;
  font-size: 24rpx;
  line-height: 1.42;
}

.strong {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.badge,
.chip {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: #fff0e2;
  font-size: 21rpx;
  font-weight: 850;
}

.order-info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 22rpx;
}

.order-info-grid > view {
  min-height: 104rpx;
  padding: 16rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.10);
}

.order-value {
  margin-top: 8rpx;
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 760;
  line-height: 1.32;
}

.order-amount {
  margin-top: 8rpx;
  color: #e9672f;
  font-size: 32rpx;
  font-weight: 950;
  line-height: 1.1;
}

.discount {
  color: #18a87c;
}

.chip-row {
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.chip.pink {
  color: #c04d68;
  background: #fff2f5;
}

.chip.blue {
  color: #3b82f6;
  background: #eff6ff;
}

.list-state {
  padding: 28rpx 0 10rpx;
  text-align: center;
}

.order-empty {
  margin-top: 42rpx;
  padding: 52rpx 34rpx;
  border-radius: 36rpx;
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  text-align: center;
}

.empty-icon {
  width: 132rpx;
  height: 132rpx;
  margin: 0 auto 22rpx;
  border-radius: 42rpx;
  color: #e9672f;
  background: #fff0e2;
}


.empty-title {
  color: #2d211a;
  font-size: 32rpx;
  font-weight: 950;
}

.empty-btn {
  width: 260rpx;
  min-height: 84rpx;
  margin: 26rpx auto 0;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-size: 28rpx;
  font-weight: 950;
}

.subscribe-card {
  gap: 18rpx;
  background: linear-gradient(135deg, #effbf7 0%, #ffffff 100%);
  border-color: rgba(114, 211, 183, 0.18);
}

.subscribe-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 22rpx;
  color: #18a87c;
  background: #eafaf3;
}

.subscribe-main {
  flex: 1;
  min-width: 0;
}

.client-bottom-nav {
  border-top: 1rpx solid rgba(255, 153, 102, 0.12);
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 36rpx rgba(123, 89, 62, 0.08);
}

.client-bottom-nav .nav-item {
  color: #8e8580;
}

.client-bottom-nav .nav-item.active {
  color: #e9672f;
  font-weight: 850;
}

.client-bottom-nav .nav-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}


.nav-red-dot {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #f53f3f;
  box-shadow: 0 0 0 5rpx rgba(245, 63, 63, 0.12);
}

.status-tab:active,
.order-card:active,
.subscribe-card:active,
.nav-item:active {
  transform: scale(0.985);
  opacity: 0.86;
}
