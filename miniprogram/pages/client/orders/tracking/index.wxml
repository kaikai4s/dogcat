<view class="page tracking-page {{themeClass}} {{fontClass}}">
  <view class="tracking-hero">
    <view class="hero-badge"><text class="remix-icon ri-route-fill hero-icon"></text><text>实时履约</text></view>
    <view class="hero-title">服务轨迹</view>
    <view class="hero-desc">查看宠托师服务期间的轨迹路径、起终点和关键打卡位置。</view>
  </view>

  <view class="stats-grid tracking-stats">
    <view class="stat-card highlight"><view class="stat-number">{{trackSummary.distanceText}}</view><view class="stat-label">轨迹距离</view></view>
    <view class="stat-card"><view class="stat-number">{{tracks.length}}</view><view class="stat-label">轨迹点</view></view>
    <view class="stat-card"><view class="stat-number">{{checkins.length}}</view><view class="stat-label">打卡记录</view></view>
  </view>

  <view class="map-card">
    <view class="map-header">
      <view>
        <view class="card-subtitle no-margin"><text class="remix-icon ri-map-pin-line sub-icon"></text><text>服务路径</text></view>
        <view class="card-desc">{{trackSummary.startTimeText}} - {{trackSummary.endTimeText}}</view>
      </view>
      <view class="live-pill" wx:if="{{hasMapData}}">轨迹已生成</view>
    </view>
    <view class="map-shell" wx:if="{{hasMapData}}">
      <map
        class="tracking-map"
        latitude="{{mapLatitude}}"
        longitude="{{mapLongitude}}"
        markers="{{markers}}"
        polyline="{{polyline}}"
        include-points="{{includePoints}}"
        show-location
        show-compass
        scale="15"
      ></map>
      <cover-view class="map-legend">
        <cover-view class="legend-item"><cover-view class="legend-dot start"></cover-view><cover-view>起点</cover-view></cover-view>
        <cover-view class="legend-item"><cover-view class="legend-dot route"></cover-view><cover-view>轨迹</cover-view></cover-view>
        <cover-view class="legend-item"><cover-view class="legend-dot checkin"></cover-view><cover-view>打卡</cover-view></cover-view>
        <cover-view class="legend-item"><cover-view class="legend-dot end"></cover-view><cover-view>终点</cover-view></cover-view>
      </cover-view>
    </view>
    <view wx:else class="empty-map">
      <text class="remix-icon ri-map-pin-range-line empty-map-icon"></text>
      <view class="empty-title">暂无有效定位数据</view>
      <view class="empty-desc">宠托师记录位置或打卡后会自动生成地图路径。</view>
    </view>
  </view>

  <view class="card timeline-card">
    <view class="card-subtitle"><text class="remix-icon ri-time-line sub-icon"></text><text>打卡时间轴</text></view>
    <view class="timeline" wx:if="{{checkinGroups.length}}">
      <view class="timeline-item" wx:for="{{checkinGroups}}" wx:key="eventType">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <view class="timeline-title">{{item.eventTypeText}} · {{item.count}}张</view>
          <view class="timeline-desc">{{item.remarkText || '暂无备注'}}</view>
          <view class="image-list" wx:if="{{item.photos.length}}">
            <view class="photo-item" wx:for="{{item.photos}}" wx:for-item="photo" wx:key="_id">
              <image class="security-image" src="{{photo.mediaFileId}}" mode="aspectFill" data-url="{{photo.mediaFileId}}" bindtap="previewCheckinPhoto" />
              <view class="photo-time">{{photo.recordedAtText || '未记录时间'}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="empty-state">暂无打卡记录。</view>
  </view>
</view>
