<view class="page">
  <view class="top-nav">
    <view class="nav-round" bindtap="goBack">‹</view>
  </view>
  <view class="dashboard-header">
    <view class="badge">实时履约</view>
    <view class="title">服务轨迹</view>
    <view class="tip">实时轨迹和打卡时间轴会在服务过程中持续更新。</view>
  </view>

  <view class="stats-grid">
    <view class="stat-card">
      <view class="stat-number">{{tracks.length}}</view>
      <view class="stat-label">轨迹点</view>
    </view>
    <view class="stat-card">
      <view class="stat-number">{{checkins.length}}</view>
      <view class="stat-label">打卡记录</view>
    </view>
  </view>

  <view class="card">
    <view class="subtitle">服务路径</view>
    <map wx:if="{{hasMapData}}" class="tracking-map" latitude="{{mapLatitude}}" longitude="{{mapLongitude}}" markers="{{markers}}" polyline="{{polyline}}" include-points="{{includePoints}}" show-location></map>
    <view wx:else class="muted">暂无有效定位数据，宠托师记录位置或打卡后会生成地图路径。</view>
  </view>

  <view class="card">
    <view class="subtitle">打卡时间轴</view>
    <view class="timeline">
      <view class="timeline-item" wx:for="{{checkins}}" wx:key="_id">
        <view class="strong">{{item.eventTypeText}}</view>
        <view class="muted">{{item.remark || '暂无备注'}}</view>
      </view>
    </view>
  </view>
</view>
