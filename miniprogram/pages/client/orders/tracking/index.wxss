/* Client service tracking - Cute Pet Style UI redesign */
.tracking-page {
  min-height: 100vh;
  padding: 0 28rpx 100rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 42%, #f7fbfa 100%);
  color: #2d211a;
  box-sizing: border-box;
}

.tracking-hero {
  margin: 0 -28rpx 24rpx;
  padding: 42rpx 34rpx 38rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background: linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
  font-weight: 850;
  margin-bottom: 16rpx;
}

.hero-icon { font-size: 28rpx; }

.hero-title {
  color: #2d211a;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.2;
}

.hero-desc {
  margin-top: 12rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.4;
}

.tracking-stats {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card,
.map-card,
.card {
  background: #ffffff;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.stat-card {
  padding: 22rpx 16rpx;
  border-radius: 28rpx;
}

.stat-card.highlight {
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
}

.stat-number {
  color: #2d211a;
  font-size: 34rpx;
  font-weight: 950;
}

.stat-label {
  margin-top: 6rpx;
  color: #8e8580;
  font-size: 22rpx;
}

.stat-card.highlight .stat-number,
.stat-card.highlight .stat-label {
  color: #ffffff;
}

.map-card,
.card {
  border-radius: 36rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}

.map-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.card-subtitle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 950;
  margin-bottom: 18rpx;
}

.no-margin { margin-bottom: 0; }

.sub-icon {
  color: #e9672f;
  font-size: 34rpx;
}

.card-desc {
  margin-top: 8rpx;
  color: #7a6a5e;
  font-size: 24rpx;
}

.live-pill {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e6f8ea;
  color: #00b42a;
  font-size: 22rpx;
  font-weight: 850;
  flex-shrink: 0;
}

.map-shell {
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  background: #f8fafc;
  border: 1rpx solid rgba(255, 153, 102, 0.14);
}

.tracking-map {
  width: 100%;
  height: 620rpx;
}

.map-legend {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.12);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.start { background: #16a34a; }
.legend-dot.route { background: #ff7a45; border-radius: 8rpx; width: 32rpx; }
.legend-dot.checkin { background: #f59e0b; }
.legend-dot.end { background: #e11d48; }

.empty-map,
.empty-state {
  min-height: 360rpx;
  border-radius: 28rpx;
  background: #fff8ec;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 40rpx;
  color: #8e8580;
}

.empty-map-icon {
  color: #e9672f;
  font-size: 90rpx;
  margin-bottom: 18rpx;
}

.empty-title {
  color: #2d211a;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 24rpx;
}

.timeline-card {
  overflow: hidden;
}

.timeline {
  padding-left: 18rpx;
  border-left: 2rpx solid rgba(255, 153, 102, 0.18);
}

.timeline-item {
  position: relative;
  display: flex;
  gap: 18rpx;
  padding: 0 0 24rpx 0;
}

.timeline-item:last-child { padding-bottom: 0; }

.timeline-dot {
  position: absolute;
  left: -28rpx;
  top: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e9672f;
  border: 5rpx solid #fff0e2;
}

.timeline-content {
  flex: 1;
  min-width: 0;
  background: #fff8ec;
  border-radius: 24rpx;
  padding: 20rpx;
}

.timeline-title {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 950;
}

.timeline-desc {
  margin-top: 8rpx;
  color: #7a6a5e;
  font-size: 24rpx;
  line-height: 1.45;
}

.image-list {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 16rpx;
}

.photo-item {
  min-width: 0;
}

.security-image {
  width: 100%;
  height: 160rpx;
  border-radius: 22rpx;
  background: #fff0e2;
}

.photo-time {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 21rpx;
  line-height: 1.3;
  text-align: center;
}
