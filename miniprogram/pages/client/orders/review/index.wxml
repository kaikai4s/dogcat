<view class="page {{themeClass}} {{fontClass}}">
  <view class="dashboard-header">
    <view class="badge">服务评价</view>
    <view class="title">评价这次宠护服务</view>
    <view class="tip">真实评价会帮助其他宠物主选择可靠宠托师。</view>
  </view>

  <view class="card form-card">
    <view class="subtitle">整体评分</view>
    <view class="rating-panel">
      <view class="rating-row">
        <view class="rating-star {{rating >= item ? 'active' : ''}}" wx:for="{{ratingOptions}}" wx:key="*this" data-rating="{{item}}" bindtap="chooseRating">★</view>
      </view>
      <view class="rating-text">{{ratingText}}</view>
    </view>

    <view class="subtitle">服务标签</view>
    <view class="tag-grid">
      <view class="tag-option {{item.selected ? 'active' : ''}}" wx:for="{{tags}}" wx:key="label" data-label="{{item.label}}" bindtap="toggleTag">{{item.label}}</view>
    </view>

    <view class="textarea-wrap">
      <textarea placeholder="写下服务表现、宠物状态、沟通反馈，帮助其他宠物主参考" value="{{content}}" bindinput="input" maxlength="300" />
      <view class="word-count">{{contentCount}}/300</view>
    </view>
  </view>

  <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交评价</button>
</view>
