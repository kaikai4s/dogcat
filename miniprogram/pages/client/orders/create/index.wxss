/* Client order create: stepped booking architecture */
.order-create-page {
  padding: 0 0 220rpx;
  background: linear-gradient(180deg, #fff8ec 0%, #fffaf6 44%, #f7fbfa 100%);
  color: #2d211a;
  overflow-x: hidden;
}

.order-create-page::before,
.order-create-page::after {
  display: none;
}

.order-create-page .remix-icon {
  position: relative;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  color: #ff8a45;
  font-size: 40rpx;
}

.order-create-page .remix-icon::before {
  font-family: "remixicon" !important;
  font-size: inherit;
  line-height: 1;
}

.booking-hero {
  padding: 34rpx 30rpx 42rpx;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  background:
    radial-gradient(circle at 90% 18%, rgba(255, 255, 255, 0.50) 0 64rpx, transparent 65rpx),
    radial-gradient(circle at 12% 74%, rgba(114, 211, 183, 0.16) 0 74rpx, transparent 75rpx),
    linear-gradient(135deg, #fff0c9 0%, #ffd9c8 54%, #fff5f0 100%);
  box-shadow: 0 18rpx 44rpx rgba(123, 89, 62, 0.08);
}

.booking-badge {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #d45f22;
  background: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  font-weight: 850;
}

.booking-title {
  margin-top: 20rpx;
  color: #2d211a;
  font-size: 44rpx;
  font-weight: 950;
  line-height: 1.18;
}

.booking-desc {
  width: 620rpx;
  max-width: 100%;
  margin-top: 14rpx;
  color: #7a6a5e;
  font-size: 26rpx;
  line-height: 1.5;
}

.booking-step-card,
.booking-side-card,
.quote-card {
  margin: 24rpx 28rpx 0;
  padding: 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 14rpx 34rpx rgba(123, 89, 62, 0.06);
}

.step-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.step-index {
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-size: 24rpx;
  font-weight: 950;
  box-shadow: 0 10rpx 22rpx rgba(255, 122, 69, 0.18);
}

.step-title {
  color: #2d211a;
  font-size: 32rpx;
  font-weight: 950;
  line-height: 1.25;
}

.chip.gold { background: #fff7d6; color: #b45309; }

.step-desc,
.muted {
  margin-top: 6rpx;
  color: #8e8580;
  font-size: 24rpx;
  line-height: 1.42;
}

.strong {
  color: #2d211a;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
}

.publish-grid,
.service-grid,
.picker-grid,
.address-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.publish-option,
.service-option {
  position: relative;
  min-height: 166rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fffaf4 100%);
  border: 2rpx solid rgba(255, 153, 102, 0.16);
  overflow: hidden;
}

.publish-option.active,
.service-option.active,
.pet-option.active,
.visit-fee-card.active {
  background:
    radial-gradient(circle at 92% 14%, rgba(255, 184, 108, 0.22) 0 38rpx, transparent 39rpx),
    linear-gradient(135deg, #fff8e8 0%, #fff3f0 100%);
  border-color: #ff9b66;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 69, 0.16);
}

.option-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 14rpx;
  border-radius: 22rpx;
  color: #e9672f;
  background: #fff0e2;
}

.service-title,
.pet-option-name {
  color: #2d211a;
  font-size: 29rpx;
  font-weight: 950;
  line-height: 1.3;
}

.service-price {
  margin-top: 8rpx;
  color: #e9672f;
  font-size: 28rpx;
  font-weight: 950;
}

.service-desc,
.pet-option-meta,
.pet-option-hint {
  margin-top: 8rpx;
  color: #8e8580;
  font-size: 23rpx;
  line-height: 1.38;
}

.service-desc-clamp {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.selected-service-section {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.selected-service-title {
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 900;
}

.selected-service-card {
  padding: 16rpx 18rpx;
  border-radius: 22rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.16);
}

.selected-service-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.selected-service-card .service-title {
  font-size: 26rpx;
}

.selected-service-card .service-price {
  margin-top: 4rpx;
  font-size: 24rpx;
}

.service-detail-text {
  margin-top: 10rpx;
  color: #5f5047;
  font-size: 23rpx;
  line-height: 1.45;
  white-space: pre-wrap;
  word-break: break-all;
}

.service-detail-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.service-expand,
.service-case-link {
  color: #e9672f;
  font-size: 23rpx;
  font-weight: 850;
}

.service-case-link {
  color: #1677ff;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(22, 119, 255, 0.08);
}

.visit-fee-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 128rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  border: 2rpx solid rgba(255, 153, 102, 0.18);
}

.visit-fee-main {
  flex: 1;
  min-width: 0;
}

.visit-fee-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.fixed-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  color: #18a87c;
  background: #eafaf3;
  font-size: 21rpx;
  font-weight: 900;
}

.business-service-title {
  margin: 24rpx 0 14rpx;
  color: #6b5b52;
  font-size: 25rpx;
  font-weight: 900;
}

.sitter-summary,
.pet-empty,
.address-summary,
.save-row,
.booking-side-card,
.quote-head,
.info-row {
  display: flex;
  align-items: center;
}

.sitter-summary {
  display: block;
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #effbf7 0%, #ffffff 100%);
  border: 1rpx solid rgba(114, 211, 183, 0.18);
}

.sitter-summary-top {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.order-avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 30rpx;
  background: #fff0e2;
  overflow: hidden;
}

.order-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9672f;
}

.sitter-summary-main,
.pet-empty-main,
.side-main {
  flex: 1;
  min-width: 0;
}

.sitter-meta {
  display: inline-flex;
  align-items: center;
  margin-top: 8rpx;
  margin-right: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #18a87c;
  background: rgba(24, 168, 124, 0.08);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.sitter-schedule-line {
  margin: 18rpx 0 0 114rpx;
  padding: 16rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(24, 168, 124, 0.08);
}

.schedule-label {
  color: #18a87c;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.3;
}

.schedule-text {
  margin-top: 6rpx;
  color: #18a87c;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.45;
  word-break: break-all;
}

.ghost.compact-btn,
.address-actions .compact-btn,
.upload-btn,
.quote-btn {
  min-height: 76rpx;
  padding: 0 22rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d45f22;
  background: #fff0e2;
  font-size: 25rpx;
  font-weight: 850;
}

.sitter-change-btn {
  width: auto;
  min-width: 220rpx;
  margin: 20rpx 0 0 114rpx;
  gap: 6rpx;
}

.pet-selector {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.pet-option {
  display: flex;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fffaf4 100%);
  border: 2rpx solid rgba(255, 153, 102, 0.16);
}

.pet-option-avatar,
.pet-empty-icon {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #fff0c9 0%, #fffaf4 100%);
  box-shadow: inset 0 -10rpx 24rpx rgba(255, 184, 108, 0.14);
}

.pet-option-avatar.empty,
.pet-empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9672f;
}

.pet-option-info {
  flex: 1;
  min-width: 0;
}

.pet-option-head,
.chip-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pet-option-name {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pet-selected-badge,
.badge,
.chip {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff0e2;
  color: #d45f22;
  font-size: 21rpx;
  font-weight: 850;
}

.pet-selected-badge {
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
}

.muted-badge {
  color: #18a87c;
  background: #eafaf3;
}

.pet-chip-row {
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.chip.pink {
  color: #c04d68;
  background: #fff2f5;
}

.chip.blue {
  color: #3b82f6;
  background: #eff6ff;
}

.pet-voice {
  position: relative;
  padding: 22rpx 24rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 92% 18%, rgba(114, 211, 183, 0.20) 0 36rpx, transparent 37rpx),
    linear-gradient(135deg, #fff8e8 0%, #effbf7 100%);
  border: 2rpx solid rgba(114, 211, 183, 0.18);
}

.pet-voice-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pet-voice-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #18a87c;
  font-size: 23rpx;
  font-weight: 900;
}

.pet-voice-tag {
  font-size: 19rpx;
  font-weight: 700;
  padding: 2rpx 10rpx;
  border-radius: 99rpx;
  background: rgba(24, 168, 124, 0.12);
  color: #128a64;
}

.pet-voice-refresh {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #18a87c;
  font-size: 22rpx;
  font-weight: 600;
  opacity: 0.88;
}

.pet-voice-refresh-hover {
  opacity: 0.6;
}

.pet-voice-refresh .rotating {
  animation: pet-voice-spin 1s linear infinite;
}

@keyframes pet-voice-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.pet-voice-text {
  margin-top: 8rpx;
  color: #4a4248;
  font-size: 27rpx;
  line-height: 1.5;
  font-weight: 760;
}

.pet-empty {
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx;
  border-radius: 32rpx;
  background: #fffdf9;
  border: 2rpx dashed rgba(255, 153, 102, 0.28);
  flex-wrap: wrap;
}

.pet-empty-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  font-size: 42rpx;
}

.pet-empty-main {
  padding-top: 4rpx;
}

.pet-empty .compact-btn {
  width: 100%;
  min-height: 68rpx;
  margin: 4rpx 0 0;
  font-size: 24rpx;
  border-radius: 22rpx;
}

.address-actions {
  margin-bottom: 18rpx;
}

.address-actions .compact-btn {
  width: 100%;
}

.address-summary,
.notice {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.12);
}

.address-summary {
  align-items: flex-start;
  gap: 16rpx;
}

.address-icon,
.side-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 22rpx;
  color: #18a87c;
  background: #eafaf3;
}

input,
textarea,
.field {
  width: 100%;
  min-height: 88rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
  color: #2d211a;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.16);
  font-size: 27rpx;
}

textarea {
  min-height: 164rpx;
  padding-top: 22rpx;
  line-height: 1.45;
}

.field {
  display: flex;
  align-items: center;
  color: #5f5650;
  font-weight: 760;
}

.save-row {
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 18rpx 4rpx 0;
}

.lock-panel {
  margin-top: 18rpx;
}

.pet-duration-panel {
  margin-top: 24rpx;
}

.pet-duration-row {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 153, 102, 0.16);
}

.duration-stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 16rpx 0;
}

.duration-stepper .duration-step {
  width: 72rpx;
  height: 64rpx;
  min-height: 0;
  margin: 0;
  padding: 0;
  line-height: 64rpx;
  border-radius: 18rpx;
  background: #fff0e2;
  color: #d45f22;
  font-size: 30rpx;
}

.duration-stepper .duration-step[disabled] {
  opacity: 0.4;
}

.duration-value {
  min-width: 160rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 850;
}

.notice.warning {
  border-color: rgba(255, 125, 0, 0.32);
  background: #fff8e8;
}

.notice-smartlock {
  background: linear-gradient(135deg, #fffaf4 0%, #fff4ec 100%);
  border: 1rpx solid rgba(255, 122, 69, 0.28);
  border-radius: 24rpx;
  padding: 22rpx;
  margin-bottom: 20rpx;
}

.smartlock-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.smartlock-icon {
  font-size: 34rpx;
  color: #ff7a45;
}

.smartlock-steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.smartlock-step-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.step-badge {
  flex-shrink: 0;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #ff7a45;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}

.step-text {
  font-size: 24rpx;
  line-height: 1.45;
  color: #5f5650;
}

.step-text .strong {
  color: #2d211a;
  font-weight: 800;
}

.highlight-text {
  color: #ff6b35;
  font-weight: 800;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.image-chip {
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0e2;
  color: #d45f22;
  font-size: 23rpx;
  font-weight: 850;
}

.booking-side-card {
  gap: 18rpx;
}

.booking-side-card .menu-arrow {
  color: #b8aaa0;
  font-size: 48rpx;
  line-height: 1;
}

.trust-note {
  background: linear-gradient(135deg, #effbf7 0%, #ffffff 100%);
  border-color: rgba(114, 211, 183, 0.18);
}

.quote-card {
  background:
    radial-gradient(circle at 92% 16%, rgba(255, 184, 108, 0.16) 0 54rpx, transparent 55rpx),
    linear-gradient(180deg, #ffffff 0%, #fffaf4 100%);
}

.quote-head,
.info-row {
  justify-content: space-between;
  gap: 18rpx;
}

.price {
  margin-top: 8rpx;
  color: #e9672f;
  font-size: 46rpx;
  font-weight: 950;
  line-height: 1.1;
}

.price-breakdown {
  margin-top: 22rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 153, 102, 0.14);
}

.info-row {
  padding: 12rpx 0;
  color: #5f5650;
  font-size: 25rpx;
}

.info-row .label {
  color: #8e8580;
}

.info-row .value {
  color: #2d211a;
  font-weight: 850;
}

.quote-section-title {
  margin-top: 18rpx;
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 950;
}

.quote-duration-list {
  margin-top: 10rpx;
}

.duration-task {
  margin-top: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 248, 232, 0.88);
  color: #5f5650;
  font-size: 24rpx;
}

.booking-submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: grid;
  grid-template-columns: 220rpx minmax(0, 1fr);
  gap: 18rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(255, 153, 102, 0.12);
  box-shadow: 0 -12rpx 36rpx rgba(123, 89, 62, 0.08);
  backdrop-filter: blur(14rpx);
}

.booking-submit-bar .quote-btn,
.booking-submit-bar .create-btn {
  width: 100%;
  min-width: 0;
  height: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  line-height: 1;
}

.create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-weight: 950;
  box-shadow: 0 14rpx 30rpx rgba(255, 122, 69, 0.22);
}

.create-btn[disabled],
.upload-btn[disabled] {
  opacity: 0.64;
}

.publish-option:active,
.service-option:active,
.pet-option:active,
.booking-side-card:active,
.image-chip:active,
button:active {
  transform: scale(0.985);
  opacity: 0.86;
}

.sitter-summary-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.intern-summary-tip {
  margin-top: 10rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #2563eb;
  background: #eff6ff;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 750;
}

.quote-intern-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  margin: 14rpx 0 10rpx;
  border-radius: 16rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 750;
}

.out-of-range-banner {
  margin: 16rpx 0 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
}

.out-of-range-banner .warning-title {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #dc2626;
  font-size: 25rpx;
  font-weight: 900;
}

.out-of-range-banner .warning-icon {
  font-size: 28rpx;
  color: #dc2626;
}

.out-of-range-banner .warning-desc {
  margin-top: 6rpx;
  color: #b91c1c;
  font-size: 23rpx;
  line-height: 1.4;
}

.range-distance-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f0fdf4;
  color: #16a34a;
  font-size: 22rpx;
  font-weight: 750;
}

.range-distance-pill.danger {
  background: #fef2f2;
  color: #dc2626;
}
.staff-gender-field { margin-top: 24rpx; padding: 24rpx; border-radius: 24rpx; background: #fff8ec; }
.staff-gender-options { display: flex; align-items: center; flex-wrap: wrap; gap: 28rpx; margin: 22rpx 0; }
.staff-gender-options label { display: flex; align-items: center; gap: 6rpx; font-size: 27rpx; }

.agreement-confirm-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f7fdfb 0%, #ffffff 100%);
  border: 1rpx solid rgba(16, 185, 129, 0.16);
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.05);
  margin-top: 24rpx;
}

.agreement-check-cell {
  flex-shrink: 0;
  padding-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.agreement-check-cell .agreement-checkbox {
  transform: scale(0.88);
}

.agreement-main-cell {
  flex: 1;
  min-width: 0;
}

.agreement-header-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.agreement-shield-icon {
  font-size: 32rpx;
  color: #ff7a45;
}

.agreement-desc-row {
  font-size: 24rpx;
  line-height: 1.6;
  color: #7b7168;
}

.agreement-link-text {
  color: #ff6a2a;
  font-weight: 650;
  display: inline;
}

.agreement-sep {
  color: #a3978c;
}

/* Service time interactive card */
.service-time-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #fffcf7 0%, #ffffff 100%);
  border: 2rpx solid rgba(255, 122, 69, 0.22);
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 122, 69, 0.06);
}

.service-time-card:active {
  transform: scale(0.99);
  background: #fff8f0;
}

.time-card-icon-col {
  flex-shrink: 0;
}

.time-card-icon {
  font-size: 46rpx !important;
  color: #ff7a45 !important;
}

.time-card-main-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.time-card-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.time-card-label {
  font-size: 25rpx;
  color: #8c827a;
}

.time-card-value {
  font-size: 27rpx;
  font-weight: 750;
  color: #2d211a;
}

.surcharge-pill {
  font-size: 20rpx;
  font-weight: 700;
  color: #c2410c;
  background: #ffedd5;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(234, 88, 12, 0.2);
}

.surcharge-pill.slot-pill {
  color: #b45309;
  background: #fef3c7;
  border-color: rgba(217, 119, 6, 0.2);
}

.time-warning-pill {
  font-size: 21rpx;
  font-weight: 750;
  color: #dc2626;
  background: #fef2f2;
  padding: 4rpx 14rpx;
  border-radius: 99rpx;
  line-height: 1.3;
}

.time-card-arrow-col {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.time-change-btn {
  font-size: 25rpx;
  font-weight: 650;
  color: #ff7a45;
}

.time-card-arrow-col .menu-arrow {
  font-size: 36rpx;
  color: #ff7a45;
}

/* Calendar Modal Sheet */
.calendar-modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 2000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.calendar-modal-sheet {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border-top-left-radius: 38rpx;
  border-top-right-radius: 38rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.16);
  animation: slideUp 0.22s ease-out;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.calendar-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f2ece6;
}

.modal-sheet-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #2d211a;
}

.close-sheet-icon {
  font-size: 40rpx;
  color: #9c9189;
  padding: 8rpx;
}

.calendar-sheet-body {
  flex: 1;
  max-height: calc(85vh - 230rpx);
  padding: 20rpx 28rpx 40rpx;
  box-sizing: border-box;
}

/* Sheet Order Type Tabs */
.sheet-order-type-tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.sheet-tab {
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #f8f6f4;
  border: 2rpx solid transparent;
  text-align: center;
  transition: all 0.18s ease;
}

.sheet-tab.active {
  background: #fff6ee;
  border-color: #ff7a45;
}

.sheet-tab.active .strong {
  color: #ea580c;
}

/* Calendar Panel */
.calendar-panel {
  background: #ffffff;
  border: 1rpx solid #efe8e1;
  border-radius: 28rpx;
  padding: 22rpx 18rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.calendar-month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx 16rpx;
}

.current-month-label {
  font-size: 30rpx;
  font-weight: 800;
  color: #2d211a;
}

.month-nav-btn {
  font-size: 38rpx;
  color: #ff7a45;
  padding: 8rpx 16rpx;
}

.month-nav-btn.disabled {
  color: #d1c8c0;
}

.calendar-weekdays {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #9c9189;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f6f1ec;
}

.calendar-weekdays .weekday-col {
  width: 14.2857%;
  flex: 0 0 14.2857%;
  text-align: center;
  box-sizing: border-box;
}

.calendar-days-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
  box-sizing: border-box;
  padding-top: 10rpx;
}

.calendar-day-cell {
  width: 14.2857%;
  flex: 0 0 14.2857%;
  height: 106rpx;
  padding: 5rpx 4rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.calendar-day-cell.calendar-empty-cell {
  visibility: hidden;
  pointer-events: none;
  min-height: 0 !important;
  max-height: 106rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
  border: none !important;
}

.calendar-day-cell.calendar-empty-cell::before,
.calendar-day-cell.calendar-empty-cell::after {
  display: none !important;
  content: none !important;
}

.day-cell-inner {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #faf8f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.16s ease;
  box-sizing: border-box;
}

.calendar-day-cell.past .day-cell-inner {
  background: transparent;
  opacity: 0.32;
}

.calendar-day-cell.sitter-disabled .day-cell-inner {
  background: #f6f3f0;
  opacity: 0.42;
}

.calendar-day-cell.sitter-disabled .day-number {
  color: #b5a99f;
}

.day-rest-badge {
  font-size: 18rpx;
  font-weight: 800;
  color: #8c7e73;
  background: #e9e4df;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  line-height: 1.1;
  white-space: nowrap;
}

.calendar-day-cell .day-number {
  font-size: 27rpx;
  font-weight: 750;
  color: #2d211a;
  line-height: 1.15;
}

.day-sub-row {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 24rpx;
  margin-top: 4rpx;
}

.day-today {
  font-size: 19rpx;
  color: #ff7a45;
  font-weight: 750;
  line-height: 1;
}

.day-today-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ff7a45;
}

.day-surcharge-badge {
  font-size: 18rpx;
  font-weight: 850;
  color: #dc2626;
  background: #fee2e2;
  padding: 2rpx 6rpx;
  border-radius: 6rpx;
  line-height: 1.1;
  white-space: nowrap;
}

.calendar-day-cell.selected .day-cell-inner,
.calendar-day-cell.range-start .day-cell-inner,
.calendar-day-cell.range-end .day-cell-inner {
  background: linear-gradient(135deg, #ff7a45 0%, #fa541c 100%) !important;
  box-shadow: 0 6rpx 16rpx rgba(250, 84, 28, 0.32);
}

.calendar-day-cell.selected .day-number,
.calendar-day-cell.range-start .day-number,
.calendar-day-cell.range-end .day-number {
  color: #ffffff !important;
}

.calendar-day-cell.selected .day-today,
.calendar-day-cell.range-start .day-today,
.calendar-day-cell.range-end .day-today {
  color: #ffffff !important;
}

.calendar-day-cell.selected .day-today-dot,
.calendar-day-cell.range-start .day-today-dot,
.calendar-day-cell.range-end .day-today-dot {
  background: #ffffff !important;
}

.calendar-day-cell.selected .day-surcharge-badge,
.calendar-day-cell.range-start .day-surcharge-badge,
.calendar-day-cell.range-end .day-surcharge-badge {
  background: #ffffff !important;
  color: #ea580c !important;
}

.calendar-day-cell.in-range .day-cell-inner {
  background: #fff0e2;
  border-radius: 8rpx;
}

.calendar-day-cell.in-range .day-number {
  color: #d45f22;
}

.calendar-hint-bar {
  margin-top: 14rpx;
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #fff8ec;
  color: #d46b08;
  font-size: 23rpx;
  text-align: center;
}

/* Time Slot Panel */
.time-slot-panel {
  background: #ffffff;
  border: 1rpx solid #efe8e1;
  border-radius: 28rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.time-slot-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.time-slot-head .strong {
  font-size: 29rpx;
  color: #2d211a;
}

.sitter-schedule-tip {
  font-size: 22rpx;
  font-weight: 750;
  color: #18a87c;
  margin-top: 6rpx;
}

.time-slot-head .muted {
  font-size: 22rpx;
  color: #9c9189;
}

.time-slots-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.time-slot-chip {
  width: calc((100% - 36rpx) / 4);
  flex: 0 0 calc((100% - 36rpx) / 4);
  height: 84rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #f9f7f5;
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.time-slot-chip .clock-label {
  font-size: 27rpx;
  font-weight: 750;
  color: #2d211a;
  line-height: 1.1;
}

.time-slot-chip.has-surcharge {
  border-color: rgba(251, 146, 60, 0.35);
  background: #fffbf7;
}

.slot-surcharge-tag {
  font-size: 19rpx;
  font-weight: 800;
  color: #ea580c;
  margin-top: 2rpx;
  line-height: 1.1;
}

.time-slot-chip.selected {
  background: linear-gradient(135deg, #ff7a45, #fa541c) !important;
  border-color: #ff7a45 !important;
  box-shadow: 0 6rpx 18rpx rgba(250, 84, 28, 0.28);
}

.time-slot-chip.selected .clock-label {
  color: #ffffff !important;
}

.time-slot-chip.selected .slot-surcharge-tag {
  color: #ffe7ba !important;
}

.time-slot-chip.disabled {
  opacity: 0.35;
  background: #f3efe9;
}

.time-slot-chip.outside-schedule {
  opacity: 0.35;
  background: #f5f2ee;
}

.slot-disabled-tag {
  font-size: 18rpx;
  font-weight: 750;
  color: #a89d93;
  margin-top: 2rpx;
  line-height: 1.1;
}

/* Calendar Sheet Foot */
.calendar-sheet-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 30rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f2ece6;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.sheet-summary {
  flex: 1;
  min-width: 0;
}

.sheet-date-text {
  font-size: 26rpx;
  font-weight: 750;
  color: #2d211a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sheet-surcharge-text {
  font-size: 22rpx;
  color: #ea580c;
  font-weight: 650;
  margin-top: 4rpx;
}

.confirm-sheet-btn {
  width: 220rpx !important;
  height: 80rpx !important;
  min-height: 80rpx !important;
  line-height: 80rpx !important;
  font-size: 28rpx !important;
  border-radius: 24rpx !important;
  margin: 0 !important;
}
