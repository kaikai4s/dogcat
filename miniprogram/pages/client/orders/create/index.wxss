.order-create-page {
  padding-top: 0;
  overflow: hidden;
}

.order-create-page .top-nav {
  margin-top: 0;
}

.publish-grid,
.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.publish-option,
.service-option {
  min-height: 156rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: var(--theme-bg-soft);
  border: 2rpx solid var(--theme-border);
}

.publish-option.active,
.service-option.active {
  background: linear-gradient(135deg, #ffe3ec 0%, #fff8fb 100%);
  border-color: var(--theme-primary);
  box-shadow: 0 12rpx 28rpx var(--theme-shadow);
}

.service-title {
  color: var(--theme-title);
  font-size: 29rpx;
  font-weight: 850;
}

.service-price {
  margin-top: 8rpx;
  color: var(--theme-primary);
  font-size: 28rpx;
  font-weight: 900;
}

.service-desc {
  margin-top: 8rpx;
  color: var(--theme-muted);
  font-size: 23rpx;
  line-height: 1.35;
}

.address-actions,
.picker-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
}

.address-actions .compact-btn {
  width: 100%;
  min-width: 0;
  margin: 0;
}

.save-row { margin-top: 20rpx; }

.price-breakdown {
  margin-top: 22rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--theme-border);
}

.pet-selector {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.pet-option {
  display: flex;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: var(--theme-bg-soft);
  border: 2rpx solid var(--theme-border);
}

.pet-option.active {
  background: linear-gradient(135deg, #ffe3ec 0%, #fff8fb 100%);
  border-color: var(--theme-primary);
  box-shadow: 0 12rpx 28rpx var(--theme-shadow);
}

.pet-option-avatar {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border-radius: 26rpx;
  background: #ffeef4;
}

.pet-option-avatar.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--theme-primary);
  font-size: 48rpx;
}

.pet-option-info {
  flex: 1;
  min-width: 0;
}

.pet-option-head {
  align-items: center;
  gap: 12rpx;
}

.pet-option-name {
  color: var(--theme-title);
  font-size: 30rpx;
  font-weight: 900;
}

.pet-selected-badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--theme-primary);
  color: #fff;
  font-size: 21rpx;
  font-weight: 800;
}

.pet-option-meta,
.pet-option-hint {
  margin-top: 8rpx;
  color: var(--theme-muted);
  font-size: 23rpx;
  line-height: 1.35;
}

.pet-option-hint {
  color: #6f676d;
}

.pet-chip-row {
  margin-top: 12rpx;
}

.pet-voice {
  position: relative;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff2d7 0%, #fff8fb 100%);
  border: 2rpx solid var(--theme-border);
}

.pet-voice::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 52rpx;
  width: 24rpx;
  height: 24rpx;
  background: #fff2d7;
  transform: rotate(45deg);
  border-left: 2rpx solid var(--theme-border);
  border-top: 2rpx solid var(--theme-border);
}

.pet-voice-label {
  color: var(--theme-primary);
  font-size: 23rpx;
  font-weight: 850;
}

.pet-voice-text {
  margin-top: 8rpx;
  color: #4a4248;
  font-size: 27rpx;
  line-height: 1.5;
  font-weight: 700;
}

.pet-empty {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: var(--theme-bg-soft);
  border: 2rpx dashed var(--theme-border);
}

.pet-empty-icon {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #ffeef4;
  color: var(--theme-primary);
  font-size: 40rpx;
}
