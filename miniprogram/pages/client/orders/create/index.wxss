.publish-grid,
.service-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.publish-option,
.service-option {
  min-height: 156rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: #fff7fa;
  border: 2rpx solid rgba(244, 63, 107, 0.1);
}

.publish-option.active,
.service-option.active {
  background: linear-gradient(135deg, #ffe3ec 0%, #fff8fb 100%);
  border-color: #f43f6b;
  box-shadow: 0 12rpx 28rpx rgba(244, 63, 107, 0.14);
}

.service-title {
  color: #262125;
  font-size: 29rpx;
  font-weight: 850;
}

.service-price {
  margin-top: 8rpx;
  color: #f43f6b;
  font-size: 28rpx;
  font-weight: 900;
}

.service-desc {
  margin-top: 8rpx;
  color: #969196;
  font-size: 23rpx;
  line-height: 1.35;
}

.address-actions,
.picker-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
}

.save-row { margin-top: 20rpx; }

.price-breakdown {
  margin-top: 22rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(244, 63, 107, 0.12);
}
