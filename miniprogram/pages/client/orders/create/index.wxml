<view class="page order-create-page {{themeClass}} {{fontClass}}">
  <view class="booking-hero">
    <view class="booking-badge">立即预约</view>
    <view class="booking-title">安排一次安心上门照护</view>
    <view class="booking-desc">按步骤确认宠物、服务、地址和入户方式，系统会自动试算价格。</view>
  </view>

  <view class="booking-step-card">
    <view class="step-head">
      <view class="step-index">01</view>
      <view><view class="step-title">发布方式</view><view class="step-desc">选择公开抢单或指定宠托师</view></view>
    </view>
    <view class="publish-grid">
      <view class="publish-option {{form.publishMode === 'open' ? 'active' : ''}}" data-mode="open" bindtap="choosePublishMode">
        <view class="remix-icon ri-broadcast-line option-icon"></view>
        <view class="service-title">公开发布抢单</view>
        <view class="service-desc">支付后附近审核通过的宠托师可抢单</view>
      </view>
      <view class="publish-option {{form.publishMode === 'direct' ? 'active' : ''}}" data-mode="direct" bindtap="choosePublishMode">
        <view class="remix-icon ri-user-star-line option-icon"></view>
        <view class="service-title">指定宠托师接单</view>
        <view class="service-desc">支付后仅指定宠托师可看到并接单</view>
      </view>
    </view>
    <view class="staff-gender-field">
      <view class="strong">宠托师性别要求</view>
      <radio-group class="staff-gender-options" bindchange="chooseStaffGender">
        <label><radio value="any" checked="{{form.staffGenderRequirement === 'any'}}" color="#e9672f" />不限</label>
        <label><radio value="male" checked="{{form.staffGenderRequirement === 'male'}}" color="#e9672f" />男</label>
        <label><radio value="female" checked="{{form.staffGenderRequirement === 'female'}}" color="#e9672f" />女</label>
      </radio-group>
      <view class="muted">默认不限；指定性别后，仅符合要求的宠托师可查看并接单。</view>
    </view>
    <view class="sitter-summary" wx:if="{{form.publishMode === 'direct'}}">
      <view class="sitter-summary-top">
        <image class="order-avatar" wx:if="{{requestedSitter && requestedSitter.avatarUrl}}" src="{{requestedSitter.avatarUrl}}" mode="aspectFill" />
        <view class="order-avatar placeholder" wx:else><view class="remix-icon ri-service-line"></view></view>
        <view class="sitter-summary-main">
          <view class="sitter-summary-name-row">
            <text class="strong">{{requestedSitter ? requestedSitter.displayName : '还未选择宠托师'}}</text>
            <text class="badge-pill blue" wx:if="{{requestedSitter && requestedSitter.staffLevel === 'intern'}}">实习特惠</text>
          </view>
          <view class="muted">{{requestedSitter ? requestedSitter.serviceSummary : '请从宠托师列表选择指定对象'}}</view>
          <view class="muted" wx:if="{{requestedSitter}}">性别：{{requestedSitter.gender === 'male' ? '男' : (requestedSitter.gender === 'female' ? '女' : '待平台核实')}}</view>
          <view class="sitter-meta" wx:if="{{requestedSitter && requestedSitter.serviceRadiusKm}}">接单范围：{{requestedSitter.serviceRadiusKm}}km 内</view>
          <view class="intern-summary-tip" wx:if="{{requestedSitter && requestedSitter.staffLevel === 'intern'}}">
            <text class="remix-icon ri-discount-percent-fill"></text> 已享受实习专属特惠计费
          </view>
        </view>
      </view>
      <view class="sitter-schedule-line" wx:if="{{requestedSitter && requestedSitter.weeklyScheduleText}}">
        <view class="schedule-label">可预约时间</view>
        <view class="schedule-text">{{requestedSitter.weeklyScheduleText}}</view>
      </view>
      <view class="out-of-range-banner" wx:if="{{isOutOfRange && rangeWarningText}}">
        <view class="warning-title">
          <text class="remix-icon ri-error-warning-fill warning-icon"></text>
          <text>超出接单范围提醒</text>
        </view>
        <view class="warning-desc">{{rangeWarningText}}</view>
      </view>
      <button class="ghost compact-btn sitter-change-btn" bindtap="chooseSitter"><text class="remix-icon ri-user-search-line"></text><text>重新选择</text></button>
    </view>
  </view>

  <view class="booking-step-card">
    <view class="step-head">
      <view class="step-index">02</view>
      <view><view class="step-title">服务对象</view><view class="step-desc">确认今天需要照护的宠物</view></view>
    </view>
    <view class="pet-selector" wx:if="{{pets.length}}">
      <view class="pet-option {{item.selected ? 'active' : ''}}" wx:for="{{pets}}" wx:key="_id" data-id="{{item._id}}" bindtap="choosePet">
        <image class="pet-option-avatar" wx:if="{{item.avatarFileId}}" src="{{item.avatarFileId}}" mode="aspectFill" />
        <view class="pet-option-avatar empty" wx:else><view class="remix-icon ri-file-user-line"></view></view>
        <view class="pet-option-info">
          <view class="pet-option-head"><view class="pet-option-name">{{item.name}}</view><view class="pet-selected-badge" wx:if="{{item.selected}}">已选中</view><view class="pet-selected-badge muted-badge" wx:else>可多选</view></view>
          <view class="pet-option-meta">{{item.metaText}}</view>
          <view class="pet-option-hint">{{item.hintText}}</view>
          <view class="chip-row pet-chip-row">
            <view class="chip gold" wx:if="{{item.beautyTitle && item.beautyTitle.title}}">{{item.beautyTitle.title}}</view>
            <view class="chip">{{item.speciesText}}</view>
            <view class="chip pink">{{item.gender || '未填性别'}}</view>
            <view class="chip blue">{{item.specialNotes || item.healthNotes ? '有照顾说明' : '健康乖巧'}}</view>
          </view>
        </view>
      </view>
      <view class="pet-voice" wx:if="{{selectedPets.length && petVoiceMessage}}">
        <view class="pet-voice-header">
          <view class="pet-voice-label">
            <text>{{selectedPetsTitle}}</text>
            <text class="pet-voice-tag" wx:if="{{selectedPets.length === 1}}">AI 心声</text>
          </view>
          <view class="pet-voice-refresh" wx:if="{{selectedPets.length === 1}}" bindtap="refreshPetVoice" hover-class="pet-voice-refresh-hover">
            <text class="remix-icon {{loadingPetVoice ? 'ri-loader-4-line rotating' : 'ri-refresh-line'}}"></text>
            <text>{{loadingPetVoice ? '感应中...' : '换一句'}}</text>
          </view>
        </view>
        <view class="pet-voice-text">“{{petVoiceMessage}}”</view>
      </view>
    </view>
    <view class="pet-empty" wx:else>
      <view class="pet-empty-icon"><view class="remix-icon ri-file-user-line"></view></view>
      <view class="pet-empty-main">
        <view class="strong">请先添加宠物</view>
        <view class="muted">完善宠物头像和档案后，宠托师能更好地照顾它。</view>
      </view>
      <button class="ghost compact-btn" bindtap="addPet">添加宠物</button>
    </view>
  </view>

  <view class="booking-step-card">
    <view class="step-head">
      <view class="step-index">03</view>
      <view><view class="step-title">服务项目</view><view class="step-desc">上门费固定必选，再选择至少一项照护服务</view></view>
    </view>
    <block wx:for="{{serviceOptions}}" wx:key="key">
      <view wx:if="{{item.isVisitFee}}" class="visit-fee-card active" data-key="{{item.key}}" bindtap="toggleService">
        <view class="remix-icon ri-home-heart-line option-icon"></view>
        <view class="visit-fee-main">
          <view class="service-title">{{item.label}}</view>
          <view class="service-desc">{{item.description}}</view>
        </view>
        <view class="visit-fee-side"><view class="fixed-badge">固定必选</view><view class="service-price">¥{{item.price}}</view></view>
      </view>
    </block>
    <view class="business-service-title">选择照护内容</view>
    <view class="service-grid business-service-grid">
      <block wx:for="{{serviceOptions}}" wx:key="key">
        <view wx:if="{{!item.isVisitFee}}" class="service-option {{item.selected ? 'active' : ''}}" data-key="{{item.key}}" bindtap="toggleService">
          <view class="remix-icon ri-service-line option-icon"></view>
          <view class="service-title">{{item.label}}</view>
          <view class="service-price">¥{{item.price}} 起</view>
          <view class="service-desc service-desc-clamp">{{item.description}}</view>
        </view>
      </block>
    </view>

    <view class="selected-service-section" wx:if="{{selectedServiceDetails.length}}">
      <view class="selected-service-title">已选服务说明</view>
      <view class="selected-service-card" wx:for="{{selectedServiceDetails}}" wx:key="key">
        <view class="selected-service-head">
          <view>
            <view class="service-title">{{item.label}}</view>
            <view class="service-price">¥{{item.price}}{{item.isVisitFee ? '' : ' 起'}}</view>
          </view>
          <view class="fixed-badge" wx:if="{{item.isVisitFee}}">固定必选</view>
        </view>
        <view class="service-detail-text">{{item.detailDisplayText || '暂无详细说明'}}</view>
        <view class="service-detail-actions">
          <view class="service-expand" wx:if="{{item.detailLong}}" data-key="{{item.key}}" catchtap="toggleServiceDetail">{{item.detailExpanded ? '收起说明' : '展开完整说明'}}</view>
          <view class="service-case-link" wx:if="{{item.caseImageFileIds.length}}" data-key="{{item.key}}" catchtap="previewServiceCases">点击查看服务案例</view>
        </view>
      </view>
    </view>
  </view>

  <view class="booking-step-card">
    <view class="step-head">
      <view class="step-index">04</view>
      <view><view class="step-title">服务地点</view><view class="step-desc">选择常用地址或地图定位</view></view>
    </view>
    <view class="address-actions">
      <button class="ghost compact-btn" bindtap="chooseSavedAddress">常用地址</button>
      <button class="ghost compact-btn" bindtap="useCurrentLocation">地图选择</button>
    </view>
    <view class="address-summary" wx:if="{{locationReady || form.serviceAddress}}">
      <view class="remix-icon ri-map-pin-2-line address-icon"></view>
      <view>
        <view class="muted">服务位置</view>
        <view class="strong">{{form.serviceAddress}}</view>
        <view class="muted">{{locationTip}}</view>
        <view class="range-distance-pill" wx:if="{{form.publishMode === 'direct' && rangeDistanceText && !isOutOfRange}}">
          <text class="remix-icon ri-map-pin-range-line"></text> 距宠托师约 {{rangeDistanceText}}（接单范围内）
        </view>
        <view class="range-distance-pill danger" wx:if="{{form.publishMode === 'direct' && isOutOfRange}}">
          <text class="remix-icon ri-close-circle-fill"></text> {{rangeWarningText}}
        </view>
      </view>
    </view>
    <input placeholder="详细地址（如 3栋2单元18楼）" value="{{form.addressDetail}}" data-field="addressDetail" bindinput="input" />
    <input placeholder="门牌号 / 入户说明（如 1802，门牌朝南）" value="{{form.doorplate}}" data-field="doorplate" bindinput="input" />
    <view class="save-row">
      <view><view class="strong">保存为常用地址</view><view class="muted">下次预约自动带入默认地址</view></view>
      <switch checked="{{saveAddress}}" bindchange="toggleSaveAddress" />
    </view>
  </view>

  <view class="booking-step-card">
    <view class="step-head">
      <view class="step-index">05</view>
      <view><view class="step-title">家庭安防 / 入户方式</view><view class="step-desc">选择宠托师如何安全入户</view></view>
    </view>
    <view class="service-grid">
      <view class="service-option {{form.lockMethod === item.value ? 'active' : ''}}" wx:for="{{lockMethodOptions}}" wx:key="value" data-value="{{item.value}}" bindtap="chooseLockMethod">
        <view class="remix-icon ri-shield-keyhole-line option-icon"></view>
        <view class="service-title">{{item.label}}</view>
        <view class="service-desc">{{item.desc}}</view>
      </view>
    </view>

    <view class="notice notice-smartlock" wx:if="{{form.lockMethod === 'someone_home'}}">
      <view class="smartlock-header">
        <text class="remix-icon ri-home-heart-line smartlock-icon"></text>
        <text class="strong">有人在家接待指引</text>
      </view>
      <view class="smartlock-steps">
        <view class="smartlock-step-item">
          <text class="step-badge">1</text>
          <view class="step-text"><text class="strong">配合开门：</text>预约服务时段内请确保家中有人协助开门，宠托师到达后敲门即可，无需提供密码或钥匙。</view>
        </view>
        <view class="smartlock-step-item">
          <text class="step-badge">2</text>
          <view class="step-text"><text class="strong">宠物安抚：</text>若家中有大型犬或易激惹护卫宠物，请提前系好牵引绳或做好安抚配合，方便宠托师安全进门。</view>
        </view>
      </view>
    </view>

    <view class="notice notice-smartlock" wx:if="{{form.lockMethod === 'remote_unlock'}}">
      <view class="smartlock-header">
        <text class="remix-icon ri-cellphone-line smartlock-icon"></text>
        <text class="strong">上门后远程开门使用指引</text>
      </view>
      <view class="smartlock-steps">
        <view class="smartlock-step-item">
          <text class="step-badge">1</text>
          <view class="step-text"><text class="strong">门锁要求：</text>需家中门锁为<text class="highlight-text">联网智能门锁</text>（已配网关保持在线），且门锁手机 App 支持远程开锁功能。</view>
        </view>
        <view class="smartlock-step-item">
          <text class="step-badge">2</text>
          <view class="step-text"><text class="strong">微信提醒：</text>宠托师到达家门口后会在小程序中点击“请求开门”，系统会立即向您的微信推送服务开门提醒。</view>
        </view>
        <view class="smartlock-step-item">
          <text class="step-badge">3</text>
          <view class="step-text"><text class="strong">手机开锁：</text>收到提醒后，请打开您门锁对应的手机 App（如米家、鹿客、华为、德施曼、凯迪仕等）完成远程开锁；请确保服务时段内手机畅通、网关在线。</view>
        </view>
      </view>
    </view>

    <view class="lock-panel" wx:if="{{form.lockMethod === 'one_time_code'}}">
      <view class="notice notice-smartlock">
        <view class="smartlock-header">
          <text class="remix-icon ri-shield-check-line smartlock-icon"></text>
          <text class="strong">智能门锁一次性密码设置指引</text>
        </view>
        <view class="smartlock-steps">
          <view class="smartlock-step-item">
            <text class="step-badge">1</text>
            <view class="step-text"><text class="strong">门锁要求：</text>需家中门锁为<text class="highlight-text">智能门锁</text>且支持在门锁手机 App 中设置“一次性临时密码”。普通机械锁请选择“钥匙”或“有人在家”。</view>
          </view>
          <view class="smartlock-step-item">
            <text class="step-badge">2</text>
            <view class="step-text"><text class="strong">生成密码：</text>请先打开您家智能锁对应的手机 App（如米家、鹿客、凯迪仕、华为智慧生活、德施曼、Aqara等），根据下方服务时间生成一次性临时有效密码。</view>
          </view>
          <view class="smartlock-step-item">
            <text class="step-badge">3</text>
            <view class="step-text"><text class="strong">填入生效：</text>将 App 生成的密码及有效时间填入下方。若为多天服务，建议每日分别生成专属临时密码（可在下单后于“订单详情”按天逐日更新），更享安全保障。</view>
          </view>
        </view>
      </view>

      <input password placeholder="智能门锁App生成的一次性密码（本单专用）" value="{{form.doorLockCode}}" data-field="doorLockCode" bindinput="input" />
      <view class="picker-grid">
        <picker mode="date" value="{{form.doorLockCodeStartDate}}" bindchange="chooseCodeStartDate"><view class="field">生效日期：{{form.doorLockCodeStartDate}}</view></picker>
        <picker mode="time" value="{{form.doorLockCodeStartClock}}" bindchange="chooseCodeStartClock"><view class="field">生效时间：{{form.doorLockCodeStartClock}}</view></picker>
      </view>
      <view class="picker-grid">
        <picker mode="date" value="{{form.doorLockCodeEndDate}}" bindchange="chooseCodeEndDate"><view class="field">失效日期：{{form.doorLockCodeEndDate}}</view></picker>
        <picker mode="time" value="{{form.doorLockCodeEndClock}}" bindchange="chooseCodeEndClock"><view class="field">失效时间：{{form.doorLockCodeEndClock}}</view></picker>
      </view>
      <view class="notice {{securityCoverageOk ? '' : 'warning'}}">
        <view class="muted">服务时间：{{form.startTime}} 至 {{form.endTime}}</view>
        <view class="strong">密码区间：{{form.doorLockCodeStartTime}} 至 {{form.doorLockCodeEndTime}}</view>
        <view class="muted">{{securityCoverageText}}</view>
      </view>
    </view>

    <view class="lock-panel" wx:if="{{form.lockMethod === 'key'}}">
      <view class="notice notice-smartlock">
        <view class="smartlock-header">
          <text class="remix-icon ri-key-2-line smartlock-icon"></text>
          <text class="strong">钥匙入户与存放安全指引</text>
        </view>
        <view class="smartlock-steps">
          <view class="smartlock-step-item">
            <text class="step-badge">1</text>
            <view class="step-text"><text class="strong">安全存放：</text>推荐使用<text class="highlight-text">门边机械密码盒/钥匙箱</text>（挂于门把手或隐蔽处更安全防丢），并在下方详细说明存放位置及开盒密码；也可放置于地垫、消防栓等隐蔽处。</view>
          </view>
          <view class="smartlock-step-item">
            <text class="step-badge">2</text>
            <view class="step-text"><text class="strong">拍照存证：</text>请点击下方按钮上传存放位置清晰照片（建议包含周边参照物），便于宠托师准确寻匙，避免在楼道过多走动。</view>
          </view>
          <view class="smartlock-step-item">
            <text class="step-badge">3</text>
            <view class="step-text"><text class="strong">归还闭环：</text>服务完成离开前，宠托师必须将钥匙<text class="highlight-text">原样放回原位置并强制拍照打卡</text>，平台全程记录存证，确保钥匙安全归位。</view>
          </view>
        </view>
      </view>

      <input placeholder="钥匙存放详细位置（若为密码盒请注明开盒密码）" value="{{form.keyLocation}}" data-field="keyLocation" bindinput="input" />
      <button class="ghost upload-btn" loading="{{uploadingKeyImage}}" disabled="{{uploadingKeyImage}}" bindtap="chooseKeyImage"><text class="remix-icon ri-camera-line"></text> 上传钥匙位置参考图片</button>
      <view class="image-list" wx:if="{{form.keyImageFileIds.length}}">
        <view class="image-chip" wx:for="{{form.keyImageFileIds}}" wx:key="*this" data-index="{{index}}" bindtap="removeKeyImage">图片{{index + 1}} · 点击移除</view>
      </view>
    </view>

    <textarea placeholder="入户备注（如敲门说明、安防提示、注意事项）" value="{{form.entryNotes}}" data-field="entryNotes" bindinput="input" />
  </view>

  <view class="booking-step-card">
    <view class="step-head">
      <view class="step-index">06</view>
      <view><view class="step-title">服务时间</view><view class="step-desc">确认单次预约或连续多天服务</view></view>
    </view>
    <view class="service-grid frequency-grid">
      <view class="service-option {{form.orderType === 'single' ? 'active' : ''}}" data-type="single" bindtap="chooseOrderType">
        <view class="service-title">单次服务</view>
        <view class="service-desc">只预约当天一次上门</view>
      </view>
      <view class="service-option {{form.orderType === 'multi_day' ? 'active' : ''}}" data-type="multi_day" bindtap="chooseOrderType">
        <view class="service-title">连续多天</view>
        <view class="service-desc">每天同一时间上门服务</view>
      </view>
    </view>
    <view class="picker-grid">
      <picker mode="date" value="{{form.startDate}}" start="{{minDate}}" bindchange="chooseDate"><view class="field">开始日期：{{form.startDate}}</view></picker>
      <picker mode="date" wx:if="{{form.orderType === 'multi_day'}}" value="{{form.endDate}}" start="{{form.startDate}}" bindchange="chooseEndDate"><view class="field">结束日期：{{form.endDate}}</view></picker>
      <picker mode="time" value="{{form.startClock}}" start="{{minClock}}" bindchange="chooseClock"><view class="field">开始：{{form.startClock}}</view></picker>
    </view>
    <view class="pet-duration-panel" wx:if="{{hasTimedServices}}">
      <view class="strong">逐宠物服务时长 · 每日配置</view>
      <view class="muted">遛狗覆盖所有已选狗狗；陪玩覆盖所有已选宠物。每项30分钟起，每次增减30分钟。</view>
      <view class="pet-duration-row" wx:for="{{petDurationRows}}" wx:key="key">
        <view class="strong">{{item.petName}} · {{item.serviceLabel}}</view>
        <view class="duration-stepper">
          <button class="duration-step" data-key="{{item.key}}" data-step="{{-30}}" disabled="{{item.durationMinutes <= 30}}" bindtap="changePetDuration">−</button>
          <text class="duration-value">{{item.durationMinutes}} 分钟</text>
          <button class="duration-step" data-key="{{item.key}}" data-step="{{30}}" disabled="{{item.durationMinutes >= 240 || timedDurationTotal >= 240}}" bindtap="changePetDuration">＋</button>
        </view>
        <view class="muted" wx:if="{{item.feeKnown}}">含30分钟；续时 ¥{{item.extraHalfHourFee}}/只/30分钟，本只本项每日续时费 ¥{{item.extraFee}}</view>
        <view class="muted" wx:else>含30分钟；续时单价待加载，以试算价格为准</view>
      </view>
      <view class="notice {{timedDurationTotal > 240 || walkWithoutDog ? 'warning' : ''}}">
        <view class="strong">每日合计：{{timedDurationTotal}} / 240 分钟</view>
        <view class="muted" wx:if="{{walkWithoutDog}}">遛狗服务需至少选择一只狗狗，请调整宠物或取消遛狗。</view>
        <view class="muted" wx:if="{{timedDurationTotal > 240}}">已超每日上限，请减少时长、宠物或服务后再提交。</view>
        <view class="muted">基础价包含首只宠物30分钟，额外宠物加价包含新增宠物30分钟，均照常收取。仅每只每项超过30分钟的部分收续时费，其他服务不随时长加价。</view>
        <view class="muted">续时单价按宠托师等级展示，最终金额以试算为准。</view>
        <view class="muted" wx:if="{{form.orderType === 'multi_day'}}">多天订单每天使用相同的宠物、服务与时长配置，费用按服务天数累计。</view>
      </view>
    </view>
    <picker wx:else range="{{durationOptions}}" range-key="label" value="{{durationIndex}}" bindchange="chooseDuration">
      <view class="field">服务时长：{{durationOptions[durationIndex].label}}</view>
    </picker>
    <view class="notice">
      <view class="muted">预计时间</view>
      <view class="strong">{{form.startTime}} 至 {{form.endTime}}</view>
      <view class="muted" wx:if="{{form.orderType === 'multi_day'}}">连续多天订单将按每天一次服务计费和校验宠托师时间</view>
    </view>
    <view class="notice" wx:if="{{form.publishMode === 'direct' && selectedAvailability}}">
      <view class="muted">宠托师当天排班</view>
      <view class="strong">{{selectedAvailability.status === 'available' ? selectedAvailability.slotText : '当天休息'}}</view>
      <view class="muted">{{selectedAvailability.source === 'exception' ? '按日期例外' : '按周规则'}} · 已接订单 {{selectedAvailability.busyOrders.length || 0}} 个</view>
      <view class="muted">{{selectedAvailability.timeFitText}}</view>
    </view>
  </view>

  <view class="booking-side-card interactive" bindtap="chooseCoupon">
    <view class="remix-icon ri-coupon-3-line side-icon"></view>
    <view class="side-main"><view class="strong">优惠券</view><view class="muted">{{selectedCoupon ? selectedCoupon.name : '自动选择最优优惠券'}}</view></view>
    <view class="menu-arrow remix-icon ri-arrow-right-s-line"></view>
  </view>

  <view class="booking-side-card trust-note">
    <view class="remix-icon ri-shield-check-line side-icon"></view>
    <view><view class="strong">下单后你能看到什么？</view><view class="muted">服务轨迹、关键打卡、服务报告都会在订单详情里持续更新。</view></view>
  </view>

  <view class="booking-side-card trust-note">
    <view class="remix-icon ri-file-shield-2-line side-icon"></view>
    <view>
      <view class="strong">下单协议提醒</view>
      <view class="muted">创建订单即表示你已阅读并同意 <text data-type="user_service" bindtap="openAgreement">《用户服务协议》</text>、<text data-type="trade_rules" bindtap="openAgreement">《平台交易规则》</text>、<text data-type="refund_cancel" bindtap="openAgreement">《退款/取消订单规则》</text>。</view>
    </view>
  </view>

  <view class="quote-card" wx:if="{{quote}}">
    <view class="quote-head">
      <view><view class="muted">预计支付</view><view class="price">¥{{quote.payAmount}}</view></view>
      <view class="badge">{{quote.serviceSummary}}</view>
    </view>
    <view class="quote-intern-badge" wx:if="{{quote.priceSnapshot && quote.priceSnapshot.staffPriceLevel === 'intern'}}">
      <text class="remix-icon ri-discount-percent-fill"></text>
      <text>已应用实习宠托师专享特惠定价</text>
    </view>
    <view class="price-breakdown">
      <view class="info-row"><view class="label">原价</view><view class="value">¥{{quote.amount}}</view></view>
      <view class="info-row" wx:if="{{quote.sessionCount > 1}}"><view class="label">服务次数</view><view class="value">{{quote.sessionCount}} 次</view></view>
      <view class="quote-section-title">基础服务费</view>
      <block wx:for="{{quote.priceItems}}" wx:key="key"><view class="info-row" wx:if="{{!item.type}}"><view class="label">{{item.label}}</view><view class="value">¥{{item.price}}</view></view></block>
      <view class="quote-section-title">多宠物加价</view>
      <block wx:for="{{quote.priceItems}}" wx:key="key"><view class="info-row" wx:if="{{item.type === 'extra_pet_fee'}}"><view class="label">{{item.label}}</view><view class="value">¥{{item.price}}</view></view></block>
      <view class="quote-section-title">逐宠物续时费</view>
      <view class="muted">基础价含首只30分钟，额外宠物加价含新增宠物30分钟；以下仅为超过30分钟的续时费用。</view>
      <block wx:for="{{quote.priceItems}}" wx:key="key"><view class="info-row" wx:if="{{item.type === 'pet_time_extra_fee'}}"><view class="label">{{item.label}}</view><view class="value">¥{{item.price}}</view></view></block>
      <view wx:if="{{quote.petServiceDurations && quote.petServiceDurations.length}}" class="quote-duration-list">
        <view class="quote-section-title">每日服务清单</view>
        <view class="muted" wx:if="{{quote.sessionCount > 1}}">以下宠物时长每天相同，费用按{{quote.sessionCount}}次累计。</view>
        <view class="duration-task" wx:for="{{quote.petServiceDurations}}" wx:key="index">{{item.petName}} · {{item.serviceLabel}} · {{item.durationMinutes}}分钟</view>
      </view>
      <view class="info-row" wx:if="{{quote.discountAmount}}"><view class="label">优惠券</view><view class="value">-¥{{quote.discountAmount}}</view></view>
    </view>
  </view>

  <view class="booking-submit-bar">
    <button class="ghost quote-btn" bindtap="quoteOrder">试算价格</button>
    <button class="primary create-btn" loading="{{creating}}" disabled="{{creating}}" bindtap="create">{{creating ? '创建中...' : '创建订单'}}</button>
  </view>
</view>
