<view class="page"><view class="title">预约服务</view><picker range="{{pets}}" range-key="name" bindchange="choosePet"><view class="field">宠物：{{pets.length ? '已选择' : '请先添加宠物'}}</view></picker><view class="tabs"><button class="tab" data-type="walk" bindtap="chooseType">遛狗</button><button class="tab" data-type="feed" bindtap="chooseType">喂养</button></view><input placeholder="服务地址" value="{{form.serviceAddress}}" data-field="serviceAddress" bindinput="input"/><input placeholder="开始时间 2026-07-28 10:00" value="{{form.startTime}}" data-field="startTime" bindinput="input"/><input placeholder="结束时间 2026-07-28 11:00" value="{{form.endTime}}" data-field="endTime" bindinput="input"/><button class="ghost" bindtap="quoteOrder">试算价格</button><view class="card" wx:if="{{quote}}">预计支付：¥{{quote.payAmount}}</view><button class="primary" bindtap="create">创建订单</button></view>