/* Client public review detail - Cute Pet Style UI redesign */
.public-detail-page { min-height: 100vh; padding: 0 28rpx 100rpx; background: linear-gradient(180deg,#fff8ec 0%,#fffaf6 42%,#f7fbfa 100%); color: #2d211a; box-sizing: border-box; }
.public-hero { margin: 0 -28rpx 24rpx; padding: 42rpx 34rpx 38rpx; border-bottom-left-radius: 48rpx; border-bottom-right-radius: 48rpx; background: linear-gradient(135deg,#fff0c9 0%,#ffd9c8 54%,#fff5f0 100%); box-shadow: 0 18rpx 44rpx rgba(123,89,62,.08); }
.hero-badge { display: inline-flex; align-items: center; gap: 8rpx; padding: 6rpx 18rpx; border-radius: 999rpx; color: #d45f22; background: rgba(255,255,255,.85); font-size: 24rpx; font-weight: 850; margin-bottom: 16rpx; }
.hero-icon { font-size: 28rpx; }
.hero-title { color: #2d211a; font-size: 42rpx; font-weight: 950; line-height: 1.2; }
.hero-desc { margin-top: 12rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.4; }
.card { margin-top: 24rpx; padding: 28rpx; background: #fff; border: 1rpx solid rgba(255,153,102,.14); box-shadow: 0 14rpx 34rpx rgba(123,89,62,.06); border-radius: 36rpx; }
.public-order-hero { margin-top: 0; background: linear-gradient(135deg,#fff 0%,#fff8ec 100%); }
.order-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.order-main { flex: 1; min-width: 0; }
.order-title { color: #2d211a; font-size: 30rpx; font-weight: 950; line-height: 1.35; }
.order-time,
.muted-text,
.photo-caption { margin-top: 8rpx; color: #8e8580; font-size: 24rpx; line-height: 1.45; }
.status-badge { padding: 6rpx 16rpx; border-radius: 999rpx; background: #e6f8ea; color: #00b42a; font-size: 22rpx; font-weight: 850; white-space: nowrap; }
.public-service-name { margin-top: 20rpx; color: #2d211a; font-size: 34rpx; font-weight: 950; }
.public-people-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18rpx; margin-top: 22rpx; }
.public-people-grid > view { padding: 20rpx; border-radius: 24rpx; background: #fff; border: 1rpx solid rgba(255,153,102,.12); }
.person-label { color: #8e8580; font-size: 23rpx; }
.person-name { margin-top: 6rpx; color: #2d211a; font-size: 27rpx; font-weight: 950; }
.card-subtitle { display: flex; align-items: center; gap: 10rpx; color: #2d211a; font-size: 30rpx; font-weight: 950; margin-bottom: 18rpx; }
.sub-icon { color: #e9672f; font-size: 34rpx; }
.public-stars { display: flex; align-items: center; gap: 4rpx; margin-bottom: 14rpx; color: #ffb020; font-size: 30rpx; font-weight: 900; }
.rating-text { margin-left: 10rpx; color: #d45f22; font-size: 25rpx; }
.review-content { color: #574b42; font-size: 27rpx; font-weight: 850; line-height: 1.55; }
.tag-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.tag-pill { padding: 8rpx 16rpx; border-radius: 999rpx; background: #fff0e2; color: #d45f22; font-size: 22rpx; font-weight: 850; }
.public-checkin-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16rpx; margin-top: 22rpx; }
.public-checkin-item { min-width: 0; }
.public-checkin-photo { width: 100%; height: 210rpx; border-radius: 24rpx; background: #fff0e2; }
