<wxs module="beijingTime" src="../../../../utils/beijing-time.wxs" />
<view class="public-detail-page {{themeClass}} {{fontClass}} page" wx:if="{{detail}}">
  <view class="public-hero">
    <view class="hero-badge"><text class="remix-icon ri-file-shield-2-fill hero-icon"></text><text>完成订单</text></view>
    <view class="hero-title">{{detail.petName}} · {{detail.serviceSummary}}</view>
    <view class="hero-desc">公开展示已脱敏，不包含服务地址、经纬度、门牌和联系方式。</view>
  </view>

  <view class="card public-order-hero">
    <view class="order-head">
      <view class="order-main">
        <view class="order-title">{{detail.orderTitle}}</view>
        <view class="order-time">{{beijingTime.format(detail.startTime || detail.completedAt)}}</view>
      </view>
      <view class="status-badge">{{detail.statusText}}</view>
    </view>
    <view class="public-service-name">{{detail.serviceSummary}}</view>
    <view class="public-people-grid">
      <view><view class="person-label">宠物主</view><view class="person-name">{{detail.clientName}}</view></view>
      <view><view class="person-label">宠托师</view><view class="person-name">{{detail.staffName}}</view></view>
    </view>
  </view>

  <view class="card" wx:if="{{detail.review}}">
    <view class="card-subtitle"><text class="remix-icon ri-star-smile-line sub-icon"></text><text>用户评价</text></view>
    <view class="public-stars">
      <text class="remix-icon {{detail.review.rating >= star ? 'ri-star-fill star-active' : 'ri-star-line star-inactive'}}" wx:for="{{[1,2,3,4,5]}}" wx:for-item="star" wx:key="*this"></text>
      <text class="rating-text">{{detail.review.ratingText || detail.review.rating + '.0'}}</text>
    </view>
    <view class="review-content" wx:if="{{detail.review.content}}">“{{detail.review.content}}”</view>
    <view class="tag-row" wx:if="{{detail.review.tags.length}}"><text class="tag-pill" wx:for="{{detail.review.tags}}" wx:key="*this">{{item}}</text></view>
  </view>

  <view class="card checkin-detail-card">
    <view class="checkin-head-row">
      <view class="card-subtitle"><text class="remix-icon ri-camera-lens-line sub-icon"></text><text>宠托师服务拍照打卡</text></view>
      <view class="photo-total-pill" wx:if="{{detail.totalPhotoCount}}">共 {{detail.totalPhotoCount}} 张打卡照片</view>
    </view>
    <view class="muted-text" wx:if="{{detail.checkinCount}}">共完成 {{detail.checkinCount}} 个服务项目：{{detail.checkinSummary}}</view>

    <!-- 按照项目展示所有的打卡拍照 -->
    <view class="checkin-section-list" wx:if="{{detail.checkinSections && detail.checkinSections.length}}">
      <view class="checkin-section-group" wx:for="{{detail.checkinSections}}" wx:key="eventType" wx:for-item="sec" wx:for-index="secIndex">
        <view class="section-group-header">
          <view class="section-title-wrap">
            <text class="remix-icon ri-checkbox-circle-fill section-title-icon"></text>
            <text class="section-title-text">{{sec.eventText}}</text>
          </view>
          <text class="section-photo-count">共 {{sec.photos.length}} 张照片</text>
        </view>
        <view class="section-photo-grid">
          <view class="section-photo-card" wx:for="{{sec.photos}}" wx:key="_id" wx:for-item="photo">
            <image class="section-photo-img" src="{{photo.mediaFileId}}" mode="aspectFill" data-url="{{photo.mediaFileId}}" data-section-index="{{secIndex}}" bindtap="previewPhoto" />
            <view class="section-photo-time" wx:if="{{photo.timeText}}">{{photo.timeText}}</view>
          </view>
        </view>
      </view>
    </view>
    <view class="public-checkin-grid" wx:elif="{{detail.checkinPhotos && detail.checkinPhotos.length}}">
      <view class="public-checkin-item" wx:for="{{detail.checkinPhotos}}" wx:key="_id">
        <image class="public-checkin-photo" src="{{item.mediaFileId}}" mode="aspectFill" data-url="{{item.mediaFileId}}" bindtap="previewPhoto" />
        <view class="photo-caption">{{item.eventText}}</view>
      </view>
    </view>
    <view class="muted-text" wx:elif="{{detail.checkinPhotosHidden}}">用户已设置隐藏公共展示打卡照片。</view>
    <view class="muted-text" wx:else>本单暂无公开打卡照片。</view>
  </view>
</view>
