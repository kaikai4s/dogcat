<wxs module="beijingTime" src="../../../../utils/beijing-time.wxs" />
<view class="service-detail-page {{themeClass}} {{fontClass}} page">
  <block wx:if="{{loading}}">
    <view class="skeleton-hero"></view>
    <view class="skeleton-card"></view>
    <view class="skeleton-card"></view>
  </block>

  <view class="error-state card" wx:elif="{{errorText || !service}}">
    <text class="remix-icon ri-error-warning-line error-icon"></text>
    <view class="error-title">{{errorText || '服务信息暂不可用'}}</view>
    <view class="error-desc">请稍后下拉刷新重试，或返回首页浏览其他服务</view>
    <button class="retry-btn" bindtap="loadDetail">重新加载</button>
  </view>

  <block wx:else>
    <!-- 顶部头图与核心价格卡 -->
    <view class="detail-hero">
      <view class="hero-media-wrap" wx:if="{{coverUrl}}" bindtap="previewCover">
        <image class="hero-cover-img" src="{{coverUrl}}" mode="aspectFill" />
        <view class="hero-cover-scrim"></view>
        <view class="hero-badge hero-badge-float">
          <text class="remix-icon ri-sparkling-fill"></text>
          <text>多芙琳标准宠护</text>
        </view>
      </view>
      <view class="hero-icon-banner" wx:else>
        <view class="hero-badge">
          <text class="remix-icon ri-sparkling-fill"></text>
          <text>多芙琳标准宠护</text>
        </view>
        <view class="hero-big-icon">
          <text class="remix-icon {{serviceIcon}}"></text>
        </view>
      </view>

      <view class="hero-info-card">
        <view class="hero-title-row">
          <view class="hero-title">{{service.label}}</view>
          <view class="hero-price-pill">
            <text class="price-symbol">¥</text>
            <text class="price-num">{{service.price}}</text>
            <text class="price-unit">起</text>
          </view>
        </view>
        <view class="hero-subtitle" wx:if="{{service.description}}">{{service.description}}</view>
        <view class="assurance-strip">
          <view class="assurance-pill"><text class="remix-icon ri-shield-check-fill"></text><text>实名认证</text></view>
          <view class="assurance-pill"><text class="remix-icon ri-map-pin-time-line"></text><text>轨迹打卡</text></view>
          <view class="assurance-pill"><text class="remix-icon ri-customer-service-2-fill"></text><text>售后保障</text></view>
        </view>
      </view>
    </view>

    <!-- 项目详情 -->
    <view class="detail-card card">
      <view class="section-head">
        <view class="section-icon-wrap"><text class="remix-icon ri-file-list-3-fill"></text></view>
        <view>
          <view class="section-title">项目详情</view>
          <view class="section-desc">服务内容、计费规则与注意事项</view>
        </view>
      </view>

      <view class="fee-grid" wx:if="{{feeRules.length}}">
        <view class="fee-item" wx:for="{{feeRules}}" wx:key="label">
          <view class="fee-label">{{item.label}}</view>
          <view class="fee-value">{{item.value}}</view>
        </view>
      </view>

      <view class="detail-body">
        <text class="detail-text" user-select="{{true}}">{{service.detailText || '专业宠托师按平台标准流程上门服务，全程拍照/轨迹透明可查，让爱宠在家也能安心舒适。'}}</text>
      </view>
    </view>

    <!-- 服务流程 -->
    <view class="detail-card card" wx:if="{{flowSteps.length}}">
      <view class="section-head">
        <view class="section-icon-wrap"><text class="remix-icon ri-route-fill"></text></view>
        <view>
          <view class="section-title">服务流程</view>
          <view class="section-desc">每一步均有标准打卡留痕，安全透明</view>
        </view>
      </view>

      <view class="flow-timeline">
        <view class="flow-step" wx:for="{{flowSteps}}" wx:key="eventType">
          <view class="flow-rail">
            <view class="flow-node">
              <text class="remix-icon {{item.icon}}"></text>
            </view>
            <view class="flow-line" wx:if="{{index < flowSteps.length - 1}}"></view>
          </view>
          <view class="flow-content">
            <view class="flow-content-head">
              <text class="flow-step-index">STEP {{item.stepNumber}}</text>
              <text class="flow-step-badge {{item.optional ? 'is-optional' : 'is-required'}}">{{item.optional ? '可选记录' : '必做环节'}}</text>
            </view>
            <view class="flow-step-title">{{item.label}}</view>
            <view class="flow-step-desc" wx:if="{{item.description}}">{{item.description}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 相关服务案例 -->
    <view class="detail-card card">
      <view class="section-head section-head-between">
        <view class="section-head-left">
          <view class="section-icon-wrap"><text class="remix-icon ri-camera-lens-fill"></text></view>
          <view>
            <view class="section-title">相关服务案例</view>
            <view class="section-desc">真实服务记录与现场实拍参考</view>
          </view>
        </view>
        <view class="section-more" bindtap="openAllCases">
          <text>全部记录</text>
          <text class="remix-icon ri-arrow-right-s-line"></text>
        </view>
      </view>

      <!-- 官方精选案例图集 -->
      <view class="official-cases-block" wx:if="{{caseImageUrls.length}}">
        <view class="sub-block-label">精选服务实拍（点击查看大图）</view>
        <view class="case-gallery-grid">
          <view class="case-gallery-item" wx:for="{{caseImageUrls}}" wx:key="*this">
            <image class="case-gallery-img" src="{{item}}" mode="aspectFill" data-url="{{item}}" bindtap="previewCaseImage" />
          </view>
        </view>
      </view>

      <!-- 真实脱敏订单案例 -->
      <view class="real-cases-block" wx:if="{{cases.length}}">
        <view class="sub-block-label" wx:if="{{caseImageUrls.length}}">近期真实服务案例</view>
        <view class="case-order-card" wx:for="{{cases}}" wx:key="_id">
          <view class="case-order-head">
            <view class="case-order-main">
              <view class="case-order-title">{{item.orderTitle}} · {{item.petName}}</view>
              <view class="case-order-time">{{beijingTime.format(item.startTime || item.completedAt)}}</view>
            </view>
            <view class="case-status-badge">{{item.statusText || '已完成'}}</view>
          </view>

          <view class="case-people-row">
            <view class="case-person-chip">
              <text class="case-person-label">宠物主</text>
              <text class="case-person-name">{{item.clientName}}</text>
            </view>
            <view class="case-person-chip">
              <text class="case-person-label">宠托师</text>
              <text class="case-person-name">{{item.staffName}}</text>
            </view>
          </view>

          <view class="case-review-box" wx:if="{{item.review}}">
            <view class="case-stars">
              <text class="remix-icon {{item.review.rating >= star ? 'ri-star-fill star-active' : 'ri-star-line star-inactive'}}" wx:for="{{[1,2,3,4,5]}}" wx:for-item="star" wx:key="*this"></text>
              <text class="case-rating-text">{{item.review.ratingText || item.review.rating + '.0'}}</text>
            </view>
            <view class="case-review-content" wx:if="{{item.review.content}}">“{{item.review.content}}”</view>
            <view class="case-tag-row" wx:if="{{item.review.tags.length}}">
              <text class="case-tag-pill" wx:for="{{item.review.tags}}" wx:key="*this">{{item}}</text>
            </view>
          </view>

          <view class="case-checkin-meta" wx:if="{{item.checkinCount}}">
            <text class="remix-icon ri-checkbox-circle-line"></text>
            <text>完成 {{item.checkinCount}} 个服务环节 · {{item.checkinSummary}}</text>
          </view>

          <view class="case-photo-grid" wx:if="{{item.checkinPhotos && item.checkinPhotos.length}}">
            <view class="case-photo-item" wx:for="{{item.checkinPhotos}}" wx:for-item="photo" wx:key="_id">
              <image class="case-photo-img" src="{{photo.mediaFileId}}" mode="aspectFill" data-url="{{photo.mediaFileId}}" data-order-id="{{item._id}}" catchtap="previewOrderPhoto" />
              <view class="case-photo-badge" wx:if="{{photo.eventText}}">{{photo.eventText}}</view>
            </view>
          </view>

          <view class="case-detail-link" data-id="{{item._id}}" bindtap="openPublicOrderDetail">
            <text>查看完整脱敏服务记录</text>
            <text class="remix-icon ri-arrow-right-s-line"></text>
          </view>
        </view>
      </view>

      <view class="empty-cases" wx:if="{{!caseImageUrls.length && !cases.length}}">
        <text class="remix-icon ri-image-line empty-cases-icon"></text>
        <view class="empty-cases-text">暂无公开展示案例，欢迎体验并分享爱宠服务瞬间</view>
      </view>
    </view>

    <!-- 底部悬浮去下单栏 -->
    <view class="bottom-bar-spacer"></view>
    <view class="bottom-cta-bar">
      <view class="bottom-price-box">
        <view class="bottom-price-label">{{service.label}}</view>
        <view class="bottom-price-value">¥{{service.price}}<text class="bottom-price-unit">起</text></view>
      </view>
      <button class="bottom-order-btn" loading="{{navigatingOrder}}" disabled="{{navigatingOrder}}" bindtap="goOrder">
        去下单
      </button>
    </view>
  </block>
</view>
<global-loading />
