.service-detail-page {
  min-height: 100vh;
  padding: 0 28rpx 40rpx;
  background: var(--theme-bg);
  color: var(--theme-text);
  box-sizing: border-box;
}

.card {
  background: var(--theme-card-bg);
  border: 1rpx solid var(--theme-border);
  box-shadow: 0 14rpx 34rpx var(--theme-shadow);
  border-radius: 36rpx;
}

/* 骨架屏 */
.skeleton-hero {
  height: 420rpx;
  margin: 0 -28rpx 24rpx;
  border-bottom-left-radius: 44rpx;
  border-bottom-right-radius: 44rpx;
  background: linear-gradient(90deg, rgba(255, 224, 196, 0.35) 25%, rgba(255, 240, 226, 0.7) 50%, rgba(255, 224, 196, 0.35) 75%);
}

.skeleton-card {
  height: 260rpx;
  margin-bottom: 24rpx;
  border-radius: 36rpx;
  background: var(--theme-card-bg);
  border: 1rpx solid var(--theme-border);
}

/* 错误态 */
.error-state {
  margin-top: 48rpx;
  padding: 64rpx 40rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.error-icon {
  font-size: 92rpx;
  color: var(--theme-primary);
  margin-bottom: 18rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--theme-title);
}

.error-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--theme-muted);
  line-height: 1.5;
}

.retry-btn {
  margin-top: 28rpx;
  padding: 0 44rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 850;
  border: none;
}

/* 顶部 Hero */
.detail-hero {
  margin: 0 -28rpx 24rpx;
}

.hero-media-wrap {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
  background: var(--theme-hero);
}

.hero-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-cover-scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 140rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(45, 33, 26, 0.28) 100%);
}

.hero-icon-banner {
  padding: 36rpx 34rpx 56rpx;
  background: var(--theme-hero);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 18rpx;
}

.hero-big-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--theme-primary);
  font-size: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(255, 122, 69, 0.16);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #d45f22;
  font-size: 23rpx;
  font-weight: 850;
}

.hero-badge-float {
  position: absolute;
  top: 24rpx;
  left: 28rpx;
  backdrop-filter: blur(6px);
}

.hero-info-card {
  position: relative;
  margin: -36rpx 28rpx 0;
  padding: 30rpx 28rpx 28rpx;
  border-radius: 36rpx;
  background: var(--theme-card-bg);
  border: 1rpx solid var(--theme-border);
  box-shadow: 0 16rpx 38rpx var(--theme-shadow);
}

.hero-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-title {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 950;
  line-height: 1.25;
  color: var(--theme-title);
}

.hero-price-pill {
  flex-shrink: 0;
  display: inline-flex;
  align-items: baseline;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
}

.price-symbol {
  font-size: 24rpx;
  font-weight: 900;
}

.price-num {
  font-size: 38rpx;
  font-weight: 950;
  line-height: 1;
  margin: 0 2rpx;
}

.price-unit {
  font-size: 22rpx;
  font-weight: 800;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--theme-muted);
}

.assurance-strip {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed var(--theme-border);
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.assurance-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--theme-bg-soft);
  border: 1rpx solid var(--theme-border);
  font-size: 22rpx;
  font-weight: 800;
  color: var(--theme-text);
}

.assurance-pill .remix-icon {
  color: var(--theme-primary);
  font-size: 26rpx;
}

/* 通用板块卡 */
.detail-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 22rpx;
}

.section-head-between {
  justify-content: space-between;
}

.section-head-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 22rpx;
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 950;
  color: var(--theme-title);
  line-height: 1.25;
}

.section-desc {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: var(--theme-muted);
}

.section-more {
  display: inline-flex;
  align-items: center;
  gap: 2rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
  font-size: 23rpx;
  font-weight: 850;
  flex-shrink: 0;
}

/* 计费规则网格 */
.fee-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.fee-item {
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: var(--theme-bg-soft);
  border: 1rpx solid var(--theme-border);
}

.fee-label {
  font-size: 22rpx;
  color: var(--theme-muted);
}

.fee-value {
  margin-top: 6rpx;
  font-size: 25rpx;
  font-weight: 900;
  color: var(--theme-title);
  line-height: 1.35;
}

.detail-body {
  padding: 22rpx;
  border-radius: 24rpx;
  background: var(--theme-bg-soft);
  border: 1rpx solid var(--theme-border);
}

.detail-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--theme-text);
  white-space: pre-wrap;
  word-break: break-word;
}

/* 服务流程时间线 */
.flow-timeline {
  display: flex;
  flex-direction: column;
}

.flow-step {
  display: flex;
  gap: 18rpx;
}

.flow-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 56rpx;
  flex-shrink: 0;
}

.flow-node {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 18rpx rgba(255, 122, 69, 0.22);
  flex-shrink: 0;
}

.flow-line {
  width: 3rpx;
  flex: 1;
  min-height: 28rpx;
  margin: 8rpx 0;
  background: linear-gradient(180deg, rgba(255, 122, 69, 0.45) 0%, rgba(255, 184, 108, 0.18) 100%);
  border-radius: 999rpx;
}

.flow-content {
  flex: 1;
  min-width: 0;
  padding: 4rpx 0 28rpx;
}

.flow-step:last-child .flow-content {
  padding-bottom: 4rpx;
}

.flow-content-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.flow-step-index {
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  color: var(--theme-primary);
}

.flow-step-badge {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.flow-step-badge.is-required {
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
}

.flow-step-badge.is-optional {
  background: rgba(122, 106, 94, 0.12);
  color: var(--theme-muted);
}

.flow-step-title {
  margin-top: 6rpx;
  font-size: 29rpx;
  font-weight: 900;
  color: var(--theme-title);
}

.flow-step-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--theme-muted);
}

/* 相关服务案例 */
.sub-block-label {
  font-size: 24rpx;
  font-weight: 850;
  color: var(--theme-muted);
  margin-bottom: 14rpx;
}

.official-cases-block {
  margin-bottom: 24rpx;
}

.case-gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.case-gallery-item {
  width: 100%;
  height: 186rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: var(--theme-primary-soft);
}

.case-gallery-img {
  width: 100%;
  height: 100%;
  display: block;
}

.case-order-card {
  padding: 24rpx;
  border-radius: 28rpx;
  background: var(--theme-bg-soft);
  border: 1rpx solid var(--theme-border);
  margin-bottom: 18rpx;
}

.case-order-card:last-child {
  margin-bottom: 0;
}

.case-order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.case-order-main {
  flex: 1;
  min-width: 0;
}

.case-order-title {
  font-size: 29rpx;
  font-weight: 950;
  color: var(--theme-title);
  line-height: 1.35;
}

.case-order-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--theme-muted);
}

.case-status-badge {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #e6f8ea;
  color: #00b42a;
  font-size: 21rpx;
  font-weight: 850;
}

.case-people-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.case-person-chip {
  padding: 14rpx 16rpx;
  border-radius: 20rpx;
  background: var(--theme-card-bg);
  border: 1rpx solid var(--theme-border);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.case-person-label {
  font-size: 21rpx;
  color: var(--theme-muted);
}

.case-person-name {
  font-size: 25rpx;
  font-weight: 900;
  color: var(--theme-title);
}

.case-review-box {
  margin-top: 16rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: var(--theme-card-bg);
  border: 1rpx solid var(--theme-border);
}

.case-stars {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 26rpx;
}

.case-stars .star-active {
  color: #ffb020;
}

.case-stars .star-inactive {
  color: #d8d3cf;
}

.case-rating-text {
  margin-left: 8rpx;
  font-size: 24rpx;
  font-weight: 900;
  color: #d45f22;
}

.case-review-content {
  margin-top: 10rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: var(--theme-text);
}

.case-tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.case-tag-pill {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
  font-size: 21rpx;
  font-weight: 800;
}

.case-checkin-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: var(--theme-muted);
  line-height: 1.45;
}

.case-checkin-meta .remix-icon {
  color: var(--theme-primary);
  font-size: 26rpx;
  flex-shrink: 0;
}

.case-photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.case-photo-item {
  position: relative;
  width: 100%;
  height: 152rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: var(--theme-primary-soft);
}

.case-photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.case-photo-badge {
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  bottom: 6rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.56);
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 700;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.case-detail-link {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4rpx;
  color: var(--theme-primary);
  font-size: 24rpx;
  font-weight: 900;
}

.empty-cases {
  padding: 44rpx 24rpx;
  border-radius: 24rpx;
  background: var(--theme-bg-soft);
  border: 1rpx dashed var(--theme-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-cases-icon {
  font-size: 64rpx;
  color: var(--theme-primary);
  opacity: 0.72;
  margin-bottom: 10rpx;
}

.empty-cases-text {
  font-size: 24rpx;
  color: var(--theme-muted);
  line-height: 1.5;
}

/* 底部悬浮去下单栏 */
.bottom-bar-spacer {
  height: 156rpx;
}

.bottom-cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--theme-card-bg);
  border-top: 1rpx solid var(--theme-border);
  box-shadow: 0 -10rpx 30rpx var(--theme-shadow);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  backdrop-filter: blur(10px);
}

.bottom-price-box {
  flex: 1;
  min-width: 0;
}

.bottom-price-label {
  font-size: 23rpx;
  color: var(--theme-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bottom-price-value {
  margin-top: 2rpx;
  font-size: 38rpx;
  font-weight: 950;
  color: var(--theme-primary);
  line-height: 1.15;
}

.bottom-price-unit {
  font-size: 22rpx;
  font-weight: 800;
  margin-left: 4rpx;
}

.bottom-order-btn {
  flex-shrink: 0;
  min-width: 280rpx;
  height: 86rpx;
  line-height: 86rpx;
  padding: 0 42rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  border: none;
  box-shadow: 0 12rpx 26rpx rgba(255, 122, 69, 0.28);
}

.bottom-order-btn::after {
  border: none;
}
