<view class="page {{themeClass}} {{fontClass}}" wx:if="{{report}}">
  <view class="dashboard-header">
    <view class="badge">完成报告</view>
    <view class="title">服务报告</view>
    <view class="tip">服务完成后自动汇总轨迹、打卡和履约证据。</view>
  </view>

  <view class="soft-panel">
    <view class="between">
      <view>
        <view class="muted">订单编号</view>
        <view class="strong">{{report.order.orderNo}}</view>
      </view>
      <view class="badge">{{report.order.statusText}}</view>
    </view>
  </view>

  <view class="card info-list">
    <view class="info-row"><view class="label">订单</view><view class="value">{{report.order.orderNo}}</view></view>
    <view class="info-row"><view class="label">状态</view><view class="badge">{{report.order.statusText}}</view></view>
    <view class="info-row"><view class="label">轨迹点</view><view class="value">{{report.tracks.length}}</view></view>
    <view class="info-row"><view class="label">打卡数</view><view class="value">{{report.checkins.length}}</view></view>
  </view>

  <view class="card" style="margin-top:24rpx;padding:24rpx;">
    <view class="between" style="align-items:center;">
      <view>
        <view class="subtitle" style="margin-bottom:0;">服务轨迹</view>
        <view class="muted">查看地图轨迹、起终点和打卡位置</view>
      </view>
      <button class="ghost compact-btn" bindtap="goTracking">查看轨迹</button>
    </view>
  </view>

  <view class="card" style="margin-top:24rpx;padding:24rpx;">
    <view class="subtitle">打卡照片</view>
    <view wx:if="{{report.checkinGroups.length}}">
      <view wx:for="{{report.checkinGroups}}" wx:key="eventType" style="margin-top:18rpx;">
        <view class="strong">{{item.eventTypeText}} · {{item.count}}张</view>
        <view class="muted" wx:if="{{item.remarkText}}">{{item.remarkText}}</view>
        <view class="image-list">
          <image wx:for="{{item.photos}}" wx:for-item="photo" wx:key="_id" class="security-image" src="{{photo.mediaFileId}}" mode="aspectFill" data-url="{{photo.mediaFileId}}" bindtap="previewPhoto" />
        </view>
      </view>
    </view>
    <view class="empty" wx:else>暂无打卡照片。</view>
  </view>

  <view class="card" style="margin-top:24rpx;padding:24rpx;">
    <view class="between" style="align-items:center;">
      <view class="subtitle" style="margin-bottom:0;">🤖 AI 智能总结</view>
      <button class="primary compact-btn" loading="{{loadingAi}}" bindtap="generateAiReport">一键生成总结</button>
    </view>
    <view wx:if="{{aiSummary}}" class="muted" style="margin-top:16rpx;line-height:1.6;white-space:pre-wrap;background:#fff8fa;padding:20rpx;border-radius:12rpx;">
      {{aiSummary}}
    </view>
  </view>
</view>
