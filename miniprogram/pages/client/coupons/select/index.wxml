<view class="coupon-select-page {{themeClass}} {{fontClass}} page">
  <view class="coupon-hero">
    <view class="hero-badge"><text class="remix-icon ri-coupon-3-fill hero-icon"></text><text>选择优惠</text></view>
    <view class="hero-title">选择优惠券</view>
    <view class="hero-desc">不可用优惠券会显示原因，最终优惠以后端试算为准。</view>
  </view>

  <button class="ghost-btn clear-btn" bindtap="clearCoupon"><text class="remix-icon ri-magic-line"></text><text>不使用优惠券，自动选择最优</text></button>

  <view class="loading-card" wx:if="{{loading}}">正在计算可用优惠券...</view>

  <view class="coupon-card {{!item.applicable ? 'disabled' : ''}} {{selectedCouponId === item._id ? 'active' : ''}}" wx:for="{{coupons}}" wx:key="_id" data-index="{{index}}" bindtap="select">
    <view class="coupon-amount"><text class="amount-symbol">¥</text>{{item.discountAmount}}</view>
    <view class="coupon-main">
      <view class="coupon-head">
        <view class="coupon-title">{{item.name}}</view>
        <view class="status-badge" wx:if="{{item.applicable}}">可省 ¥{{item.discountAmount}}</view>
        <view class="status-badge disabled-badge" wx:else>不可用</view>
      </view>
      <view class="coupon-rule">{{item.ruleText}}</view>
      <view class="coupon-desc" wx:if="{{item.applicable}}">使用后预计支付 ¥{{item.payAmountAfterDiscount}}</view>
      <view class="coupon-desc disabled-text" wx:else>{{item.reason}}</view>
      <view class="coupon-meta"><text class="remix-icon ri-time-line"></text><text>有效期至 {{item.validTo}}</text></view>
    </view>
    <view class="select-mark" wx:if="{{selectedCouponId === item._id}}"><text class="remix-icon ri-check-line"></text></view>
  </view>

  <view class="empty-state" wx:if="{{!loading && !coupons.length}}">
    <text class="remix-icon ri-coupon-3-line empty-icon"></text>
    <view class="empty-title">暂无可选择优惠券</view>
  </view>
</view>
