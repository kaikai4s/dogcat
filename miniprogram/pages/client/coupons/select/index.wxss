/* Client coupon select - Cute Pet Style UI redesign */
.coupon-select-page { min-height: 100vh; padding: 0 28rpx 100rpx; background: linear-gradient(180deg,#fff8ec 0%,#fffaf6 42%,#f7fbfa 100%); color: #2d211a; box-sizing: border-box; }
.coupon-hero { margin: 0 -28rpx 24rpx; padding: 42rpx 34rpx 38rpx; border-bottom-left-radius: 48rpx; border-bottom-right-radius: 48rpx; background: linear-gradient(135deg,#fff0c9 0%,#ffd9c8 54%,#fff5f0 100%); box-shadow: 0 18rpx 44rpx rgba(123,89,62,.08); }
.hero-badge { display: inline-flex; align-items: center; gap: 8rpx; padding: 6rpx 18rpx; border-radius: 999rpx; color: #d45f22; background: rgba(255,255,255,.85); font-size: 24rpx; font-weight: 850; margin-bottom: 16rpx; }
.hero-icon { font-size: 28rpx; }
.hero-title { color: #2d211a; font-size: 42rpx; font-weight: 950; line-height: 1.2; }
.hero-desc { margin-top: 12rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.4; }
.ghost-btn { min-height: 78rpx; border-radius: 26rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; font-size: 26rpx; font-weight: 900; border: none; line-height: 1; background: #fff0e2; color: #7a6a5e; }
.ghost-btn::after { display: none; }
.ghost-btn .remix-icon { font-size: 30rpx; }
.clear-btn { width: 100%; margin-bottom: 22rpx; }
.loading-card,
.empty-state { background: #fff; border: 1rpx solid rgba(255,153,102,.14); box-shadow: 0 14rpx 34rpx rgba(123,89,62,.06); border-radius: 36rpx; }
.loading-card { padding: 30rpx; color: #8e8580; text-align: center; font-size: 25rpx; }
.coupon-card { position: relative; margin-bottom: 22rpx; padding: 28rpx; display: flex; gap: 24rpx; align-items: center; border-radius: 36rpx; background: #fff; box-shadow: 0 14rpx 34rpx rgba(123,89,62,.06); border: 2rpx solid transparent; }
.coupon-card.active { border-color: #ff7a45; background: linear-gradient(135deg,#fff8ec 0%,#fff 100%); }
.coupon-card.disabled { opacity: .56; filter: grayscale(.16); }
.coupon-amount { min-width: 150rpx; color: #e9672f; font-size: 56rpx; font-weight: 950; line-height: 1; }
.amount-symbol { font-size: 30rpx; margin-right: 4rpx; }
.coupon-main { flex: 1; min-width: 0; }
.coupon-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 14rpx; }
.coupon-title { flex: 1; min-width: 0; color: #2d211a; font-size: 30rpx; font-weight: 950; line-height: 1.35; }
.status-badge { padding: 6rpx 16rpx; border-radius: 999rpx; background: #e6f8ea; color: #00b42a; font-size: 22rpx; font-weight: 850; white-space: nowrap; }
.disabled-badge { background: #f0eae5; color: #8e8580; }
.coupon-rule,
.coupon-desc { margin-top: 10rpx; color: #7a6a5e; font-size: 24rpx; line-height: 1.45; }
.disabled-text { color: #be123c; }
.coupon-meta { display: flex; align-items: center; gap: 8rpx; margin-top: 10rpx; color: #a89b90; font-size: 23rpx; }
.coupon-meta .remix-icon { color: #e9672f; font-size: 26rpx; }
.select-mark { position: absolute; right: 18rpx; bottom: 18rpx; width: 42rpx; height: 42rpx; border-radius: 50%; background: linear-gradient(135deg,#ffb86c 0%,#ff7a45 100%); color: #fff; display: flex; align-items: center; justify-content: center; }
.select-mark .remix-icon { font-size: 28rpx; }
.empty-state { min-height: 420rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 44rpx; }
.empty-icon { color: #e9672f; font-size: 100rpx; margin-bottom: 16rpx; }
.empty-title { color: #2d211a; font-size: 30rpx; font-weight: 950; }
