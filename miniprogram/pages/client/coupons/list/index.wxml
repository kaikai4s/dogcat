<view class="coupon-page {{themeClass}} {{fontClass}} page">
  <view class="coupon-hero">
    <view class="hero-badge"><text class="remix-icon ri-coupon-3-fill hero-icon"></text><text>福利中心</text></view>
    <view class="hero-title">我的优惠券</view>
    <view class="hero-desc">下单时可自动选择最优惠券，也可手动选择。</view>
  </view>

  <view class="status-tabs">
    <view class="status-tab {{activeStatus === item.value ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="value" data-status="{{item.value}}" bindtap="chooseStatus">{{item.label}}</view>
  </view>

  <view class="loading-card" wx:if="{{loading}}">正在加载优惠券...</view>

  <view class="coupon-card {{item.status !== 'available' ? 'disabled' : ''}}" wx:for="{{coupons}}" wx:key="_id">
    <view class="coupon-amount"><text class="amount-symbol">¥</text>{{item.discountAmount}}</view>
    <view class="coupon-main">
      <view class="coupon-head">
        <view class="coupon-title">{{item.name}}</view>
        <view class="status-badge">{{item.statusText}}</view>
      </view>
      <view class="coupon-rule">{{item.ruleText}}</view>
      <view class="coupon-meta"><text class="remix-icon ri-time-line"></text><text>有效期至 {{item.validTo}}</text></view>
      <view class="coupon-desc" wx:if="{{item.description}}">{{item.description}}</view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && !coupons.length}}">
    <text class="remix-icon ri-coupon-3-line empty-icon"></text>
    <view class="empty-title">暂无优惠券</view>
  </view>
</view>
