.coupon-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  display: flex;
  gap: 24rpx;
  align-items: center;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #fff 0%, #fff5f8 100%);
  box-shadow: 0 14rpx 36rpx rgba(116, 91, 101, 0.1);
  border: 1rpx solid rgba(244, 63, 107, 0.12);
}

.coupon-card.disabled {
  opacity: 0.58;
  filter: grayscale(0.2);
}

.coupon-amount {
  min-width: 150rpx;
  color: #f43f6b;
  font-size: 54rpx;
  font-weight: 900;
}

.coupon-main {
  flex: 1;
  min-width: 0;
}
