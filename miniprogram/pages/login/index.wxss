.login-simple {
  min-height: 100vh;
  padding: 96rpx 32rpx 48rpx;
  position: relative;
  overflow: hidden;
  background: var(--theme-bg);
}

.login-title {
  margin-top: 80rpx;
  color: var(--theme-title);
  font-size: 56rpx;
  font-weight: 900;
}

.login-subtitle {
  margin: 24rpx 0 48rpx;
  color: var(--theme-muted);
  font-size: 28rpx;
  line-height: 1.6;
}

.login-error {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--theme-card-bg);
  color: var(--theme-primary);
  font-size: 26rpx;
  line-height: 1.5;
}
