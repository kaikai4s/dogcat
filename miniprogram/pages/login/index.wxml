<view class="login-simple {{themeClass}} {{fontClass}}">
  <view class="login-title">VIP 宠护</view>
  <view class="login-subtitle">登录后可预约上门喂猫、遛狗，并查看轨迹与服务报告。</view>

  <view class="login-error" wx:if="{{!envReady}}">
    云环境未初始化，请重新编译并检查 envList.js。
  </view>

  <view class="login-error" wx:if="{{errorText}}">
    登录失败：{{errorText}}
  </view>

  <button class="primary" disabled="{{!envReady}}" loading="{{loading}}" bindtap="login">微信登录</button>
  <button class="ghost" bindtap="openInit">开发初始化</button>
</view>
