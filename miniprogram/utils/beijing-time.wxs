// WXS display formatter: stored instants stay unchanged; service text is already UTC+8.
function pad(value) {
  return value < 10 ? '0' + value : '' + value;
}

function format(value) {
  if (value === undefined || value === null || value === '') return '';
  var text = '' + value;
  var local = text.match(getRegExp('^(\\d{4})-(\\d{1,2})-(\\d{1,2})(?:[ T](\\d{1,2}):(\\d{1,2})(?::(\\d{1,2}))?)?$'));
  if (local) {
    var day = local[1] + '-' + pad(local[2] * 1) + '-' + pad(local[3] * 1);
    if (!local[4]) return day;
    return day + ' ' + pad(local[4] * 1) + ':' + pad(local[5] * 1) + ':' + pad((local[6] || 0) * 1);
  }
  var date;
  if (typeof value === 'number') {
    date = getDate(value);
  } else if (text.match(getRegExp('^\\d{10,13}$'))) {
    date = getDate(text * (text.length === 10 ? 1000 : 1));
  } else {
    // Keep ISO's Z/offset: removing them would reinterpret UTC as device-local time.
    date = getDate(text);
  }
  var timestamp = date.getTime();
  if (timestamp !== timestamp) return text;
  var beijing = getDate(timestamp + 28800000);
  return beijing.getUTCFullYear() + '-' + pad(beijing.getUTCMonth() + 1) + '-' + pad(beijing.getUTCDate()) +
    ' ' + pad(beijing.getUTCHours()) + ':' + pad(beijing.getUTCMinutes()) + ':' + pad(beijing.getUTCSeconds());
}

module.exports = { format: format };
