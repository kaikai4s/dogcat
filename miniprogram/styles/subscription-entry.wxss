.subscription-entry { display: flex; align-items: center; gap: 18rpx; margin: 22rpx 0; padding: 26rpx 22rpx; border-radius: 26rpx; background: #fff3df; border: 1rpx solid #ffe1b5; }
.subscription-entry-icon { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 68rpx; height: 68rpx; border-radius: 22rpx; background: #ffe5b9; color: #e47b10; font-size: 35rpx; }
.subscription-entry-copy { flex: 1; min-width: 0; }
.subscription-entry-title { font-size: 29rpx; font-weight: 750; color: #7b461b; }
.subscription-entry-desc { font-size: 22rpx; color: #aa815e; line-height: 1.5; margin-top: 7rpx; }
.subscription-entry-action { display: flex; align-items: center; flex-shrink: 0; gap: 3rpx; color: #db771c; font-size: 25rpx; font-weight: 650; }
.theme-night .subscription-entry { background: #30271f; border-color: #55402b; }
.theme-night .subscription-entry-title { color: #f4d5aa; }
.theme-night .subscription-entry-desc { color: #c3a387; }
