.titles-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 31000; background: rgba(24, 36, 29, .45); display: flex; align-items: flex-end; animation: mask-in .18s ease-out; }
.titles-panel { box-sizing: border-box; width: 100%; height: 72vh; max-height: 88vh; display: flex; flex-direction: column; padding: 14rpx 30rpx calc(26rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fbfcf8; color: #304739; animation: sheet-in .24s ease-out; }
.sheet-handle { flex-shrink: 0; width: 64rpx; height: 6rpx; margin: 0 auto 24rpx; border-radius: 6rpx; background: #d4ded3; }
.titles-header { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; flex-shrink: 0; }
.titles-heading { font-size: 32rpx; font-weight: 700; }
button { margin: 0; border-radius: 16rpx; font-size: 25rpx; line-height: 1.6; padding: 16rpx 22rpx; color: #365a42; background: #e7efdf; box-sizing: border-box; }
button::after { border: 0; }
button[disabled] { opacity: .55; }
.close { min-width: 72rpx; min-height: 72rpx; font-size: 42rpx; line-height: 1; background: transparent; padding: 8rpx 12rpx; color: #73816f; }
.title-preview { flex-shrink: 0; margin: 18rpx 0 26rpx; padding: 24rpx; background: #f4efdf; border-radius: 16rpx; border: 1rpx solid #e8dec0; }
.preview-label { color: #8c774e; font-size: 21rpx; }
.preview-name { margin-top: 10rpx; color: #805a20; font-size: 32rpx; font-weight: 700; line-height: 1.5; word-break: break-all; }
.preview-scope { font-size: 24rpx; line-height: 1.5; color: #8c774e; margin-top: 8rpx; word-break: break-all; }
.titles-caption { font-size: 22rpx; line-height: 1.6; color: #817455; margin-top: 14rpx; }
.list-heading { display: flex; justify-content: space-between; font-size: 24rpx; color: #53654d; margin-bottom: 8rpx; flex-shrink: 0; }
.list-heading text { color: #7c8976; font-size: 22rpx; }
.titles-list { flex: 1; min-height: 0; height: 0; }
.title-row { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 14rpx; border-bottom: 1rpx solid #e6ecdf; border-left: 4rpx solid transparent; }
.title-row.selected { background: #edf4e7; border-left-color: #608353; }
.title-copy { flex: 1; min-width: 0; }
.title-name { font-size: 28rpx; font-weight: 600; line-height: 1.5; color: #98661d; word-break: break-all; }
.title-community { font-size: 23rpx; line-height: 1.6; margin-top: 6rpx; color: #778471; word-break: break-all; }
.title-row button { min-width: 128rpx; flex-shrink: 0; }
.title-row .equipped[disabled] { color: #42704a; background: transparent; opacity: 1; }
.titles-empty { font-size: 24rpx; color: #78836e; line-height: 1.8; padding: 36rpx 12rpx; text-align: center; }
.empty-title { font-size: 27rpx; color: #53654d; font-weight: 600; margin-bottom: 14rpx; }
.retry { width: 220rpx; margin: 20rpx auto 0; }
.unequip { margin-top: 20rpx; flex-shrink: 0; }
.update-error { font-size: 24rpx; line-height: 1.6; color: #a13f32; margin-top: 16rpx; flex-shrink: 0; }
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheet-in { from { transform: translateY(44rpx); opacity: .6; } to { transform: translateY(0); opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .titles-mask, .titles-panel { animation: none; } }
