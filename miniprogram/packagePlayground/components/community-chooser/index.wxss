.chooser-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 3000; display: flex; align-items: flex-end; background: rgba(27, 43, 32, .48); animation: mask-in .18s ease-out; }
.chooser-card { box-sizing: border-box; width: 100%; height: 82vh; max-height: 88vh; display: flex; flex-direction: column; padding: 14rpx 30rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: #fbfcf8; color: #304739; animation: sheet-in .24s ease-out; }
.sheet-handle { flex-shrink: 0; width: 64rpx; height: 6rpx; margin: 0 auto 24rpx; border-radius: 6rpx; background: #d4ded3; }
.chooser-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; flex-shrink: 0; }
.heading-copy { flex: 1; min-width: 0; }
.chooser-title { font-size: 32rpx; font-weight: 700; line-height: 1.5; }
.chooser-caption { margin-top: 8rpx; font-size: 23rpx; color: #73816f; line-height: 1.6; }
button { box-sizing: border-box; margin: 0; padding: 18rpx 22rpx; border-radius: 16rpx; line-height: 1.5; font-size: 25rpx; }
button::after { border: none; }
button[disabled] { opacity: .55; }
.close { flex-shrink: 0; min-width: 72rpx; min-height: 72rpx; padding: 8rpx 12rpx; font-size: 42rpx; line-height: 1; color: #73816f; background: transparent; }
.search-row { display: flex; align-items: center; gap: 10rpx; margin: 28rpx 0 22rpx; flex-shrink: 0; }
.search-row input { box-sizing: border-box; height: 76rpx; padding: 14rpx 16rpx; background: #fff; border: 1rpx solid #dce5d7; border-radius: 16rpx; font-size: 24rpx; }
.city-input { width: 190rpx; flex-shrink: 0; }
.keyword-input { flex: 1; min-width: 0; }
.search-row button { background: #e7efdf; color: #426239; flex-shrink: 0; }
.list-label { display: flex; justify-content: space-between; gap: 14rpx; margin-bottom: 8rpx; color: #53654d; font-size: 24rpx; flex-shrink: 0; }
.list-label text { font-size: 21rpx; color: #7c8976; }
.community-list, .application-form { flex: 1; min-height: 0; height: 0; }
.community-row { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 4rpx; border-bottom: 1rpx solid #e6ecdf; transition: background-color .15s; }
.community-row-pressed { background: #edf4e7; }
.community-copy { flex: 1; min-width: 0; }
.name { font-size: 28rpx; line-height: 1.5; font-weight: 600; word-break: break-all; }
.address { margin-top: 6rpx; font-size: 22rpx; color: #778471; line-height: 1.6; word-break: break-all; }
.community-tag { display: inline-block; font-size: 19rpx; color: #73816f; background: #eef1e8; border-radius: 6rpx; margin-top: 10rpx; padding: 3rpx 10rpx; }
.community-tag.mine { color: #3c7046; background: #e2efdf; }
.residents { flex-shrink: 0; text-align: right; color: #56774b; }
.count { font-size: 34rpx; font-weight: 700; }
.residents view { margin-top: 3rpx; font-size: 20rpx; }
.row-arrow { color: #94a18b; font-size: 36rpx; }
.empty, .list-error { padding: 44rpx 12rpx; color: #78836e; text-align: center; font-size: 24rpx; line-height: 1.8; }
.empty-title { font-size: 28rpx; font-weight: 600; color: #506347; margin-bottom: 12rpx; }
.list-error button { background: #e7efdf; color: #426239; width: 220rpx; margin: 20rpx auto 0; }
.more { background: transparent; color: #56774b; margin: 16rpx auto; }
.chooser-footer { display: flex; gap: 16rpx; padding-top: 22rpx; border-top: 1rpx solid #e6ecdf; flex-shrink: 0; }
.chooser-footer button { flex: 1; min-width: 0; }
.confirm { color: #fff; background: #427659; }
.map-button { background: #e7efdf; color: #365a42; }
.application-notice { flex-shrink: 0; font-size: 23rpx; line-height: 1.7; padding: 16rpx 18rpx; margin-bottom: 20rpx; border-radius: 12rpx; color: #365a42; background: #e9f2e4; }
.application-form { margin-top: 20rpx; }
.form-label { display: flex; align-items: center; gap: 12rpx; margin: 22rpx 0 12rpx; font-size: 25rpx; font-weight: 600; }
.form-label text { font-size: 21rpx; font-weight: 400; color: #7c8976; }
.application-form input { box-sizing: border-box; width: 100%; height: 84rpx; padding: 16rpx 20rpx; background: #fff; border: 1rpx solid #dce5d7; border-radius: 16rpx; font-size: 26rpx; }
.application-help { margin: 28rpx 0 20rpx; font-size: 23rpx; color: #73816f; line-height: 1.8; }
.application-help view + view { margin-top: 12rpx; }
.form-error { font-size: 24rpx; color: #a13f32; line-height: 1.7; padding-bottom: 24rpx; }
.skeleton-row { padding: 32rpx 4rpx; border-bottom: 1rpx solid #e6ecdf; }
.skeleton-line { height: 26rpx; width: 52%; background: #e7ecdf; border-radius: 6rpx; animation: skeleton-pulse 1.2s ease-in-out infinite alternate; }
.skeleton-line.short { width: 72%; height: 20rpx; margin-top: 18rpx; }
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheet-in { from { transform: translateY(44rpx); opacity: .6; } to { transform: translateY(0); opacity: 1; } }
@keyframes skeleton-pulse { from { opacity: .45; } to { opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .chooser-mask, .chooser-card, .skeleton-line { animation: none; } .community-row { transition: none; } }
