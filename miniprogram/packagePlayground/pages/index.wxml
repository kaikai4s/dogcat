<view class="page playground-page">
  <view class="playground-hero">
    <view class="hero-copy">
      <view class="hero-badge"><text class="remix-icon ri-gamepad-fill"></text><text>宠物乐园 · 2D 互动</text></view>
      <view class="hero-title">进入爱宠的阳光庄园</view>
      <view class="hero-desc">在大草地上拖动、缩放浏览，点击地面控制爱宠行走，为自己选择宅基地。</view>
    </view>
    <view class="hero-actions">
      <button class="ghost-btn small-btn" bindtap="customize">专属形象定制</button>
      <button class="ghost-btn small-btn" bindtap="goPets">宠物档案</button>
      <button class="primary-btn small-btn" bindtap="load" loading="{{loading}}">刷新乐园</button>
    </view>
  </view>

  <view class="loading-card" wx:if="{{loading}}">
    <view class="remix-icon ri-loader-4-line loading-icon"></view>
    <view class="strong">正在唤醒宠物乐园...</view>
    <view class="muted">正在读取 2D 草地场景和宠物档案</view>
  </view>

  <view class="empty-card" wx:elif="{{empty}}">
    <view class="remix-icon ri-paw-print-line empty-icon"></view>
    <view class="empty-title">还没有宠物进入乐园</view>
    <view class="empty-desc">先添加宠物档案，带 TA 进入 2D 庄园散步。</view>
    <button class="primary-btn empty-btn" bindtap="goAddPet">添加宠物</button>
  </view>

  <view class="community-card" wx:if="{{!loading}}">
    <view class="community-left">
      <view class="remix-icon ri-home-5-fill community-icon"></view>
      <view class="community-info">
        <view class="community-label">当前常住小区</view>
        <view class="community-name strong" wx:if="{{userCommunity && userCommunity.name}}">{{userCommunity.name}}</view>
        <view class="community-name muted" wx:else>未绑定常住小区（单人庄园模式）</view>
      </view>
    </view>
    <button class="ghost-btn mini-btn" bindtap="openChooseCommunity">{{userCommunity && userCommunity.name ? '修改小区' : '选择小区'}}</button>
  </view>

  <view class="daily-status">
    <view class="daily-title">开始 2D 庄园游戏</view>
    <view class="daily-desc">
      <text wx:if="{{hasCommunity}}">已加入同小区共享草地，选址安家后可带宠物拜访邻居。</text>
      <text wx:else>可以先浏览草地，设置常住小区后可选择永久宅基地。</text>
    </view>
    <button class="primary-btn" bindtap="openWorld">打开 2D 庄园</button>
    <view class="muted">玩法：点选宠物、拖动地图、双指缩放，再用底部按钮安排吃饭、喝水和休息。</view>
  </view>

  <view class="game-features" wx:if="{{!loading && !empty}}">
    <view class="feature-item"><text class="feature-icon">🐾</text><view><view class="feature-title">手动控制行走</view><view class="muted">点击目的地、从院门进出</view></view></view>
    <view class="feature-item"><text class="feature-icon">🏡</text><view><view class="feature-title">邻里庄园</view><view class="muted">查看相邻别墅和绿化</view></view></view>
    <view class="feature-item"><text class="feature-icon">🍖</text><view><view class="feature-title">庭院安置</view><view class="muted">{{overview.world.canRelocate ? '临时开放重新选址' : '空草坪选址，保存后不能搬迁'}}</view></view></view>
  </view>

  <view class="pet-strip" wx:if="{{pets.length}}">
    <view class="strip-title">乐园成员</view>
    <scroll-view scroll-x class="pet-scroll">
      <view class="pet-chip {{selectedPet && selectedPet._id === item._id ? 'active' : ''}}" wx:for="{{pets}}" wx:key="_id" data-id="{{item._id}}" bindtap="choosePet">
        <image class="pet-avatar" wx:if="{{item.avatarFileId}}" src="{{item.avatarFileId}}" mode="aspectFill" />
        <view class="pet-avatar empty" wx:else><text class="remix-icon ri-paw-print-line"></text></view>
        <view class="pet-chip-name">{{item.name}}</view>
        <view class="pet-chip-type">{{item.species === 'cat' ? '猫咪' : '狗狗'}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="pet-popover" wx:if="{{selectedPet}}">
    <view class="popover-card">
      <view class="popover-head">
        <view>
          <view class="popover-title">{{selectedPet.name}}</view>
          <view class="muted">{{selectedPet.species === 'cat' ? '猫咪' : '狗狗'}} · {{selectedPet.breed || '未填写品种'}}</view>
        </view>
        <view class="remix-icon ri-close-line close-btn" bindtap="closePetCard"></view>
      </view>
      <view class="popover-desc">{{selectedPet.personality || '正在 2D 庄园里开心玩耍'}}</view>
      <button class="ghost-btn compact-btn" bindtap="customizePet">为 {{selectedPet.name}} 定制形象</button>
      <button class="primary-btn compact-btn" bindtap="openWorld"><text class="remix-icon ri-play-circle-line"></text>进入庄园互动</button>
    </view>
  </view>

  <view class="community-modal-mask" wx:if="{{showCommunityModal}}" bindtap="closeCommunityModal">
    <view class="community-modal-card" catchtap="stopBubble">
      <view class="community-modal-icon-wrap"><view class="remix-icon ri-home-5-fill modal-icon"></view></view>
      <view class="modal-title">发现同小区的毛孩子邻居</view>
      <view class="modal-desc">选择常住小区后，与同小区住户共享草地。房屋位置由您手动选择，确认后保存位置。</view>
      <view class="modal-tip"><text class="remix-icon ri-map-pin-2-fill tip-icon"></text><text>选择小区只用于匹配邻里庄园位置。</text></view>
      <view class="modal-actions">
        <button class="primary-btn full-btn" bindtap="selectCommunityAndEnter" loading="{{savingCommunity}}"><text class="remix-icon ri-navigation-fill"></text><text>定位并进入邻里庄园</text></button>
        <button class="ghost-btn full-btn" bindtap="enterSoloManor">暂不设置，进入单人庄园</button>
      </view>
    </view>
  </view>
</view>
