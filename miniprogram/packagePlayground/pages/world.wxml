<view class="world">
  <canvas id="worldCanvas" type="2d" class="canvas" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel"></canvas>
  <view class="top" style="top: {{top}}px">
    <button class="round" bindtap="back">返回</button>
    <view class="title">
      <text wx:if="{{hasCommunity && communityName}}">{{communityName}} · 邻里庄园</text>
      <text wx:else>阳光庄园 · 私享模式</text>
      <text class="subtitle">{{worldSize}} · {{hasCommunity ? '同小区共享草地' : '设置常住小区后可安家'}} </text>
    </view>
  </view>
  <view class="error" wx:if="{{error}}">
    <view>场景加载失败</view><view class="detail">{{error}}</view>
    <button bindtap="initialize">重新加载</button>
  </view>
  <view class="loading" wx:elif="{{loading}}"><view class="loader"></view><text>{{status}}</text></view>
  <view class="bottom" style="bottom: {{bottom}}px" wx:else>
    <view class="status">{{status}}</view>
    <scroll-view class="pet-tabs" scroll-x="true" wx:if="{{pets.length}}">
      <view class="pet-chip {{item.selected ? 'selected' : ''}}" wx:for="{{pets}}" wx:key="id" data-id="{{item.id}}" bindtap="selectPet">
        <text>{{item.name}}</text><text class="species">{{item.species === 'cat' ? '猫' : '狗'}}</text>
      </view>
    </scroll-view>
    <view class="controls">
      <button bindtap="overview">{{hasPlot ? '回到家园' : '回到起点'}}</button><button bindtap="follow">跟随宠物</button>
      <button wx:if="{{!hasPlot && hasCommunity && !placing}}" bindtap="choosePlot">选择宅基地</button>
      <button wx:if="{{placing}}" bindtap="cancelPlot" disabled="{{claiming}}">取消选址</button>
      <button wx:if="{{placing}}" bindtap="confirmPlot" disabled="{{!canConfirm || claiming}}" loading="{{claiming}}">永久安置</button>
    </view>
    <view class="hint">点击草地行走 · 点击名字切换宠物 · 单指拖动 · 双指缩放</view>
  </view>
</view>
