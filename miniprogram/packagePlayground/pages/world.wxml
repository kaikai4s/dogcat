<view class="world">
  <canvas id="worldCanvas" type="webgl" class="canvas" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel"></canvas>
  <view class="top" style="top: {{top}}px">
    <button class="round" bindtap="back">返回</button>
    <view class="title"><text>阳光庄园</text><text class="subtitle">多宠物活动样板 · 狗狗本地模型 · 猫咪云端模型</text></view>
  </view>
  <view class="error" wx:if="{{error}}">
    <view>场景加载失败</view><view class="detail">{{error}}</view>
    <button bindtap="initialize">重新加载</button>
  </view>
  <view class="loading" wx:elif="{{loading}}"><view class="loader"></view><text>{{status}}</text></view>
  <view class="bottom" style="bottom: {{bottom}}px" wx:else>
    <view class="status">{{status}}</view>
    <scroll-view class="pet-tabs" scroll-x="true" wx:if="{{pets.length}}">
      <view class="pet-chip {{item.selected ? 'selected' : ''}} {{item.available ? '' : 'disabled'}}" wx:for="{{pets}}" wx:key="id" data-id="{{item.id}}" bindtap="selectPet">
        <text>{{item.name}}</text><text class="species">{{item.species === 'cat' ? '猫' : '狗'}}</text>
        <text class="pending" wx:if="{{!item.available}}">模型待接入</text>
      </view>
    </scroll-view>
    <view class="controls">
      <button bindtap="overview">查看全场</button><button bindtap="follow">跟随选中</button>
      <button bindtap="activity" data-action="eat">去吃饭</button><button bindtap="activity" data-action="drink">去喝水</button><button bindtap="activity" data-action="sleep">去睡觉</button>
    </view>
    <view class="hint">点宠物或名字可选中 · 控制只作用于当前选中的宠物 · 拖动旋转 · 双指缩放</view>
  </view>
</view>
