<view class="world">
  <canvas id="worldCanvas" type="2d" class="canvas" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel"></canvas>
  <view class="top" style="top: {{top}}px">
    <button class="round settings-icon" bindtap="openSettings" aria-label="场景设置">⚙</button>
    <button class="round back-button" bindtap="back">‹ 返回</button>
    <view class="title" bindtap="communityActions">
      <text class="community-name">{{communityName || '阳光庄园'}}</text>
      <view class="subtitle"><text>{{visiting ? '正在访问' : hasAvatar ? '我的小区' : '待建庭院'}} · 切换 ▾</text><text class="resident-count">已入住 {{residentCount}} 人</text></view>
    </view>
  </view>
  <view class="error" wx:if="{{error}}">
    <view>场景加载失败</view><view class="detail">{{error}}</view>
    <button bindtap="initialize">重新加载</button>
  </view>
  <view class="loading" wx:elif="{{loading}}"><view class="loader"></view><text>{{status}}</text></view>
  <view class="garden-edit-hint" wx:if="{{farmEditMode && !farmOpen}}"><text>选择自家草块，走近后布置</text><button bindtap="endGardenEdit">完成选地</button></view>
  <view wx:if="{{hasAvatar && !loading && !error && !placing && !settingsOpen && !socialOpen && !farmOpen && !disputesOpen && !justiceOpen && !buildOpen && !historyModalOpen && !serviceDiaryOpen && !publicCareOpen && !mallSuppliesOpen && !rewardsOpen && !riding && !showPetScale && (joystickMode === 'always' || joystickActive)}}" class="joystick-pad {{joystickMode === 'always' ? 'joystick-fixed' : ''}} {{joystickRunning ? 'running' : ''}}" style="left: {{joystickLeft}}px; top: {{joystickTop}}px; opacity: {{joystickOpacity / 100}};" catchtouchstart="fixedJoystickStart" catchtouchmove="fixedJoystickMove" catchtouchend="fixedJoystickEnd" catchtouchcancel="fixedJoystickEnd">
    <view class="joystick-ring"></view>
    <view class="joystick-knob" style="transform: translate({{joystickX}}px, {{joystickY}}px)"></view>
    <text class="joystick-caption">{{driving ? '代步巡检 · 慢速前行' : joystickRunning ? '快步行走' : '轻推漫游 · 可轻触地面导航'}}</text>
  </view>
  <view class="player-hud {{joystickHand === 'right' ? 'right-hand' : ''}}" style="bottom: {{bottom + 260 + (showPetScale ? 105 : 0)}}px" wx:if="{{hasAvatar && !loading && !error && !placing && !settingsOpen && !socialOpen && !farmOpen && !disputesOpen && !justiceOpen && !buildOpen && !historyModalOpen && !serviceDiaryOpen && !publicCareOpen && !mallSuppliesOpen && !rewardsOpen}}">
    <view class="interaction-actions">
      <button wx:if="{{nearbyInvite}}" data-operation="invite" data-player="{{nearbyInvite.id}}" bindtap="rideOperation" disabled="{{rideBusy}}">邀请 {{nearbyInvite.name}} 上车</button>
      <button wx:if="{{nearbyRide}}" data-operation="request" data-player="{{nearbyRide.playerId}}" bindtap="rideOperation" disabled="{{rideBusy}}">申请乘坐 {{nearbyRide.name}} 的车</button>
      <button wx:if="{{nearbyVehicle && !driving}}" data-operation="enter" bindtap="operateVehicle" disabled="{{vehicleOperating}}" loading="{{vehicleOperating}}">进入车辆</button>
      <button wx:if="{{nearbyVehicle && !driving}}" data-operation="garage" bindtap="operateVehicle" disabled="{{vehicleOperating}}">车辆入库</button>
      <button wx:if="{{nearbyPlayer && !nearbyPlayer.friend}}" bindtap="requestFriend" disabled="{{socialBusy}}">添加 {{nearbyPlayer.name}} 为好友</button>
      <button wx:if="{{nearbyGate}}" bindtap="requestVisit" disabled="{{socialBusy}}">申请访问 {{nearbyGate.name}} 的庭院</button>
      <view wx:if="{{nearbySitter}}" class="nearby-sitter-card">
        <view class="nearby-sitter-title"><text class="remix-icon ri-verified-badge-fill"></text>宠托师服务</view>
        <view class="nearby-sitter-caption">已到达宠托师别墅门口</view>
        <view class="nearby-sitter-actions"><button bindtap="viewNearbySitter">名片与评价</button><button class="sitter-book-primary" bindtap="bookNearbySitter">预约服务</button></view>
      </view>
      <button wx:if="{{nearbyCarePet}}" class="nearby-care-button" bindtap="viewNearbyPetCare">{{nearbyCarePet.name}} · 照护记录</button>
      <button wx:if="{{nearbyBowl}}" class="fill-bowl" bindtap="fillBowl" disabled="{{feeding || nearbyBowl.food >= 100}}" loading="{{feeding}}">{{nearbyBowl.food >= 100 ? '猫狗碗已添满' : '给猫狗碗添粮'}}</button>
      <button wx:if="{{nearbyBowl}}" class="mall-supplies-btn" bindtap="openMallSupplies">口粮补给站</button>
      <button wx:if="{{nearbyPoop}}" bindtap="pickupPoop">拾取便便</button>
      <button wx:if="{{nearbyPoop}}" bindtap="reportPoopAction">向居委会反馈便便</button>
      <block wx:if="{{selectedBuildingInfo && nearbyBuilding && selectedBuildingInfo.plotId === nearbyBuilding.plotId && selectedBuildingInfo.buildingInstanceId === nearbyBuilding.buildingInstanceId}}">
      <button wx:if="{{nearbyBuilding && nearbyBuilding.type === 'committee'}}" bindtap="openDisputes">社区服务站</button>
      <button wx:if="{{nearbyBuilding && nearbyBuilding.type === 'repair_shop'}}" bindtap="cleanVehicleAction">便民爱车清洗</button>
      <button wx:if="{{nearbyBuilding && nearbyBuilding.type === 'repair_shop'}}" bindtap="repairVehicleAction">车辆便民养护</button>
      <button wx:if="{{nearbyBuilding && nearbyBuilding.type === 'pet_hospital'}}" data-type="wash" bindtap="hospitalCareAction">宠物专业洗护</button>
      <button wx:if="{{nearbyBuilding && nearbyBuilding.type === 'pet_hospital'}}" data-type="treat" bindtap="hospitalCareAction">宠物健康调理</button>
      <button wx:if="{{nearbyBuilding && nearbyBuilding.type === 'wood_cabin'}}" bindtap="woodCabinAction">木屋营地·静享时光</button>
      <button wx:if="{{nearbyBuilding && (nearbyBuilding.type === 'decoration' || nearbyBuilding.category === 'decoration' || (!['committee', 'repair_shop', 'pet_hospital', 'wood_cabin', 'tree', 'police_station', 'prison'].includes(nearbyBuilding.type) && nearbyBuilding.type !== 'floor' && nearbyBuilding.category !== 'floor'))}}" bindtap="decorationAction">观赏·{{nearbyBuilding.name}}</button>
      <button wx:if="{{nearbyBuilding && nearbyBuilding.type === 'tree'}}" bindtap="treeAction">树荫休憩·微风拂面</button>
      <button wx:if="{{nearbyBuilding && nearbyBuilding.type === 'police_station'}}" bindtap="openJustice">文明出行督导站</button>
      <button wx:if="{{nearbyBuilding && nearbyBuilding.type === 'prison'}}" bindtap="openJustice">交通安全宣教室</button>
      <button wx:if="{{nearbyBuilding && nearbyBuilding.canRelocate}}" class="relocate-building-btn" data-plotid="{{nearbyBuilding.plotId}}" data-instanceid="{{nearbyBuilding.buildingInstanceId}}" bindtap="startRelocateBuildingAction">调整建筑位置</button>
      <button wx:if="{{nearbyBuilding && nearbyBuilding.mine && nearbyBuilding.canDismantle}}" class="dismantle-building-btn" data-plotid="{{nearbyBuilding.plotId}}" data-instanceid="{{nearbyBuilding.buildingInstanceId}}" bindtap="dismantleBuildingAction">拆除该建筑</button>
      </block>
      <button wx:if="{{myJailStatus && myJailStatus.isJailed}}" bindtap="openJustice" class="jail-status-btn">宣教自省中({{myJailStatus.remainingSeconds}}s)·提前结业</button>
      <view wx:if="{{selectedBuildingInfo}}" class="building-info-card" catchtouchstart="swallowTouch" catchtouchmove="swallowTouch" catchtouchend="swallowTouch" catchtap="swallowTouch">
        <view class="building-info-title"><text class="remix-icon ri-home-5-line"></text><text>{{selectedBuildingInfo.name}}</text><button class="building-info-close" catchtap="closeBuildingInfo" aria-label="收起建筑信息">×</button></view>
        <view class="building-info-caption">{{selectedBuildingInfo.mine ? '我的建筑' : '社区建筑'}} · 走近后可使用对应服务</view>
        <view wx:if="{{selectedBuildingInfo.canRelocate}}" class="building-info-actions">
          <button class="relocate-building-btn" data-plotid="{{selectedBuildingInfo.plotId}}" data-instanceid="{{selectedBuildingInfo.buildingInstanceId}}" bindtap="startRelocateBuildingAction">调整建筑位置</button>
        </view>
      </view>
    </view>
  </view>
  <view class="bottom" style="bottom: {{bottom}}px" wx:if="{{!loading && !error}}">
    <view class="status-container">
      <view class="status {{statusMessage || connectionMessage ? 'status-visible' : 'status-hidden'}}">
        <text>{{statusMessage || connectionMessage}}</text>
      </view>
      <button class="history-msg-btn" bindtap="openHistoryModal" aria-label="查看历史消息">
        <text class="history-btn-icon">📋</text>
        <text class="history-btn-text">消息</text>
        <text class="history-badge" wx:if="{{messageHistory.length}}">{{messageHistory.length}}</text>
      </button>
    </view>
    <view class="trip-bar" wx:if="{{driving}}"><view><text>{{riding ? '正在搭乘 · 由车主驾驶' : '驾驶中 · 乘客 ' + passengers.length + '/3'}}</text><text class="settings-tip">跟随宠物将与你一起下车</text></view><button wx:if="{{riding}}" data-operation="leave" bindtap="rideOperation" disabled="{{rideBusy}}">一起下车</button><button wx:else data-operation="exit" bindtap="operateVehicle" disabled="{{vehicleOperating}}">一起下车</button></view>
    <view class="unplaced" wx:if="{{!hasAvatar && !placing}}">
      <text>尚未安置庭院，建好后角色和宠物将进入场景</text>
      <button bindtap="chooseCommunityAndBuild">选择小区并建造庭院</button>
    </view>
    <view class="field-context" wx:if="{{nearbyFarm && !farmOpen && !settingsOpen && !socialOpen && !disputesOpen && !justiceOpen && !buildOpen && !historyModalOpen && !serviceDiaryOpen && !publicCareOpen && !mallSuppliesOpen && !rewardsOpen && !placing}}">
      <view class="field-heading"><text>{{nearbyFarm.name || nearbyFarm.label || '正在查看土地…'}}</text><text>{{nearbyFarm.cropId ? nearbyFarm.label : '庭院装饰'}}</text></view>
      <block wx:if="{{nearbyFarm.loaded}}">
        <scroll-view scroll-x class="field-seeds" wx:if="{{nearbyFarm.state === 'empty'}}"><view class="field-seed-row"><block wx:for="{{farm.crops}}" wx:key="id"><button wx:if="{{item.unlocked}}" class="{{farmCropId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectFarmCrop">{{item.name}}</button></block></view></scroll-view>
        <view class="field-actions">
          <button wx:if="{{nearbyFarm.state === 'grass'}}" data-plot="{{nearbyFarm.plotId}}" data-bed="{{nearbyFarm.id}}" data-operation="convert" bindtap="farmOperation" disabled="{{farmBusy}}">获得耕地</button>
          <button wx:if="{{nearbyFarm.state === 'soil'}}" data-plot="{{nearbyFarm.plotId}}" data-bed="{{nearbyFarm.id}}" data-operation="till" bindtap="farmOperation" disabled="{{farmBusy}}">开垦</button>
          <button wx:if="{{nearbyFarm.state === 'empty'}}" data-plot="{{nearbyFarm.plotId}}" data-bed="{{nearbyFarm.id}}" data-operation="plant" bindtap="farmOperation" disabled="{{farmBusy || !farmSeedAvailable}}">种植</button>
          <button wx:if="{{nearbyFarm.state !== 'grass' && nearbyFarm.state !== 'soil' && nearbyFarm.stage !== 'watered'}}" data-plot="{{nearbyFarm.plotId}}" data-bed="{{nearbyFarm.id}}" data-operation="water" bindtap="farmOperation" disabled="{{farmBusy}}">浇水</button>
          <button wx:if="{{nearbyFarm.state === 'ready'}}" data-plot="{{nearbyFarm.plotId}}" data-bed="{{nearbyFarm.id}}" data-operation="harvest" bindtap="farmOperation" disabled="{{farmBusy}}">收整植株</button>
          <button wx:if="{{nearbyFarm.state !== 'grass'}}" data-plot="{{nearbyFarm.plotId}}" data-bed="{{nearbyFarm.id}}" data-operation="lawn" bindtap="farmOperation" disabled="{{farmBusy}}">恢复草坪</button>
        </view>
      </block>
    </view>
    <view class="character-selection" wx:if="{{characterSelected && !placing}}">已选中自己的角色 · 点击空地移动</view>
    <view class="pet-actions vehicle-actions" wx:if="{{vehicleSelected && !placing}}">
      <text class="selected-pet-name">{{driving ? '已选中车辆 · 点击空地驾驶，可连续更换目标' : vehicleParked ? '我的蓝色轿车 · 停在车位' : '我的蓝色轿车 · 靠近后可以上车或入库'}}</text>
      <button wx:if="{{vehicleParked}}" data-operation="start" bindtap="operateVehicle" disabled="{{vehicleOperating}}" loading="{{vehicleOperating}}">启动车辆</button>
      <button wx:if="{{driving}}" data-operation="exit" bindtap="operateVehicle" disabled="{{vehicleOperating}}" loading="{{vehicleOperating}}">下车</button>
      <button wx:if="{{vehicleSoiled}}" bindtap="cleanVehicleAction">洗车清洁</button>
    </view>
    <view class="pet-actions" wx:if="{{selectedPetId && !placing}}">
      <text class="selected-pet-name">{{selectedPetName}} · {{selectedPet.activity}} · 疲惫 {{selectedPet.fatigue}}%</text>
      <view class="pet-needs"><view class="pet-need {{item.low ? 'need-low' : ''}}" wx:for="{{selectedPet.needs}}" wx:key="key"><view><text>{{item.label}}</text><text>{{item.value}}%</text></view><view class="need-track"><view style="width: {{item.value}}%;"></view></view></view></view>
      <button wx:if="{{nearbyPet && selectedPetId === nearbyPet.id}}" bindtap="interactPet">摸摸</button>
      <button bindtap="petCare" data-operation="{{selectedPet.following ? 'stay' : 'follow'}}" disabled="{{petCareBusy || driving}}">{{selectedPet.following ? '取消跟随' : '让它跟我走'}}</button>
      <button bindtap="petCare" data-operation="feed" disabled="{{petCareBusy}}">喂零食</button>
      <button bindtap="petCare" data-operation="eat" wx:if="{{hasPlot && !driving}}" disabled="{{petCareBusy}}">去碗边吃饭</button>
      <button bindtap="petCare" data-operation="sleep" wx:if="{{hasPlot && !driving}}" disabled="{{petCareBusy}}">回窝休息</button>
      <button bindtap="petCare" data-operation="drink" wx:if="{{hasPlot && !driving}}" disabled="{{petCareBusy}}">去喷泉喝水</button>
      <button bindtap="follow">镜头跟随</button>
      <button bindtap="togglePetScale">{{showPetScale ? '收起大小调节' : '调整宠物大小'}}</button>
    </view>
    <view class="pet-size-panel" wx:if="{{showPetScale && selectedPetId && !placing}}">
      <view class="pet-size-heading"><text>{{selectedPetName}} · {{petScalePercent}}%</text><text class="pet-size-tip">{{petScaleSaving ? '保存中…' : '松手自动保存'}}</text></view>
      <view class="pet-size-slider"><text>小</text><slider min="50" max="200" step="5" value="{{petScalePercent}}" disabled="{{petScaleSaving}}" activeColor="#6f8d58" block-color="#6f8d58" block-size="20" bindchanging="previewPetScale" bindchange="savePetScale"/><text>大</text><button bindtap="resetPetScale" disabled="{{petScaleSaving}}">恢复默认</button></view>
    </view>
    <view class="plot-size-bar" wx:if="{{placing && isPlacingNewPlot && !isPlacingBuilding}}">
      <text class="plot-size-label">绿地规格：</text>
      <button wx:for="{{plotSizes}}" wx:key="size" class="plot-size-chip {{selectedPlotSize === item.size ? 'active' : ''}}" data-size="{{item.size}}" bindtap="selectPlotSize" disabled="{{isPlacingNewPlot && !item.unlocked}}">{{item.label}} {{isPlacingNewPlot && !item.unlocked ? item.unlockText : ''}}</button>
    </view>
    <view class="controls">
      <button wx:if="{{hasAvatar && !placing}}" bindtap="focusCharacter">回到角色</button>
      <button wx:if="{{!placing}}" bindtap="fullOverview">地图中心</button>
      <button wx:if="{{!placing}}" bindtap="overview">{{hasPlot ? '回到家园' : '回到起点'}}</button>
      <button wx:if="{{hasPlot && hasCommunity && !hasHomeElsewhere && !placing}}" bindtap="buyNewPlotAction">认领专属爱心绿地</button>
      <button wx:if="{{(!hasPlot || canRelocate) && hasCommunity && !hasHomeElsewhere && !placing}}" bindtap="choosePlot">{{hasPlot ? '调整原别墅' : '安置庭院'}}</button>
      <button wx:if="{{placing && !isPlacingBuilding}}" bindtap="cycleGateDirection">门口：{{gateDirectionText}} ▾</button>
      <button wx:if="{{placing}}" bindtap="cancelPlot" disabled="{{claiming}}">{{isPlacingBuilding ? '取消建造' : '取消选址'}}</button>
      <button wx:if="{{placing}}" bindtap="confirmPlot" disabled="{{!canConfirm || claiming}}" loading="{{claiming}}">{{isPlacingBuilding ? (isRelocatingBuilding ? '确认新位置' : '确认建造') : (isPlacingNewPlot ? '确认认领绿地' : '确认位置')}}</button>
    </view>
    <view class="hint">{{hasAvatar ? joystickMode === 'hold' ? '长按草地1秒显示摇杆 · ' : '摇杆轻推走 / 拉远跑 · ' : ''}}点击角色 / 宠物选择 · 双指缩放</view>
  </view>
  <view class="settings-backdrop" wx:if="{{settingsOpen}}" catchtap="closeSettings" catchtouchmove="swallowTouch">
    <view class="settings-panel" catchtap="swallowTouch">
      <view class="settings-heading"><view><text>场景设置</text><text class="settings-tip">按你的习惯，自在逛家园</text></view><button bindtap="closeSettings">完成</button></view>
      <scroll-view scroll-y="true" class="settings-content">
        <view class="compliance-banner" style="background: rgba(111,141,88,0.08); border-radius: 8px; padding: 10px 12px; margin-bottom: 12px;">
          <text style="font-size: 11px; color: #556b46; line-height: 1.5; display: block;">植物用于庭院装饰，收整不提供收益。有效洗车、环境反馈和纠纷处理奖励计入会员积分，可在积分记录中查看。</text>
        </view>
        <button class="settings-entry" bindtap="openSocial">
          <text class="settings-entry-icon">友</text>
          <view class="settings-entry-copy"><text class="settings-entry-title">好友与庭院访问</text><text class="settings-tip">查看好友，处理好友与来访申请</text></view>
          <text class="settings-count" wx:if="{{socialRequests.length}}">{{socialRequests.length}}</text><text class="settings-chevron">›</text>
        </button>
        <button class="settings-entry" bindtap="customizeAppearance"><text class="settings-entry-icon">绘</text><view class="settings-entry-copy"><text class="settings-entry-title">专属形象定制</text><text class="settings-tip">上传照片，为角色或爱宠申请专属形象</text></view><text class="settings-chevron">›</text></button>
        <text class="settings-section">操控习惯</text>
        <view class="settings-card">
          <view class="settings-row"><view><text>长按显示摇杆</text><text class="settings-tip">关闭时常显，开启后长按草地 1 秒</text></view><switch checked="{{joystickMode === 'hold'}}" color="#6f8d58" bindchange="changeJoystickMode"/></view>
          <view class="settings-hand"><text>习惯用手</text><view class="hand-options"><button class="{{joystickHand === 'left' ? 'active' : ''}}" data-hand="left" bindtap="changeJoystickHand" aria-pressed="{{joystickHand === 'left'}}">左手摇杆</button><button class="{{joystickHand === 'right' ? 'active' : ''}}" data-hand="right" bindtap="changeJoystickHand" aria-pressed="{{joystickHand === 'right'}}">右手摇杆</button></view><text class="settings-tip">常显摇杆靠近所选侧边</text></view>
          <view class="settings-opacity"><view class="settings-value"><text>摇杆不透明度</text><text>{{joystickOpacity}}%</text></view><slider min="10" max="100" step="5" value="{{joystickOpacity}}" activeColor="#6f8d58" block-color="#6f8d58" block-size="20" bindchanging="changeJoystickOpacity" bindchange="changeJoystickOpacity"/></view>
          <view class="settings-opacity"><view class="settings-value"><text>车辆最高速度</text><text>跑步的 {{vehicleSpeed}} 倍</text></view><slider min="20" max="50" step="1" value="{{vehicleSpeed * 10}}" disabled="{{vehicleSpeedSaving}}" activeColor="#6f8d58" block-color="#6f8d58" block-size="20" bindchanging="previewVehicleSpeed" bindchange="changeVehicleSpeed"/><text class="settings-tip">默认 2 倍，最高 5 倍；与角色共用摇杆设置</text></view>
        </view>
        <text class="settings-section">场景显示</text>
        <view class="settings-card"><view class="settings-row"><view><text>显示庭院主人</text><text class="settings-tip">在每个庭院上方显示用户昵称</text></view><switch checked="{{showYardOwners}}" color="#6f8d58" bindchange="changeYardOwners"/></view></view>
        <button wx:if="{{hasAvatar && !hasCustomCharacter}}" class="settings-entry character-entry" bindtap="switchCharacter" disabled="{{characterChanging || placing}}" loading="{{characterChanging}}"><text class="settings-entry-icon">人</text><view class="settings-entry-copy"><text class="settings-entry-title">{{characterType === 'girl' ? '换成男孩' : '换成女孩'}}</text><text class="settings-tip">当前角色：{{characterType === 'girl' ? '女孩' : '男孩'}}</text></view><text class="settings-chevron">›</text></button>
      </scroll-view>
    </view>
  </view>
  <view class="settings-backdrop" wx:if="{{socialOpen}}" catchtap="closeSocial" catchtouchmove="swallowTouch">
    <view class="settings-panel" catchtap="swallowTouch">
      <view class="settings-heading"><text>好友与庭院访问</text><button bindtap="closeSocial">完成</button></view>
      <scroll-view scroll-y="true" class="social-list">
        <view class="social-section">待处理申请</view>
        <text class="settings-tip" wx:if="{{!socialRequests.length}}">暂无新申请</text>
        <view class="social-item" wx:for="{{socialRequests}}" wx:key="id">
          <text>{{item.name}} {{item.type === 'rideInvite' ? '邀请你和同行宠物上车' : item.type === 'rideRequest' ? '申请乘坐你的车' : item.type === 'visit' ? '申请访问你的庭院' : '申请添加你为好友'}}</text>
          <text class="settings-tip">{{item.type === 'rideInvite' || item.type === 'rideRequest' ? '60秒内有效 · 双方需保持停车并在车旁 · 同行宠物一起乘车' : item.type === 'visit' ? '同意后可访问至今天24点（北京时间）' : '成为好友后可以互相进出庭院'}}</text>
          <view class="social-actions" wx:if="{{item.type === 'rideInvite' || item.type === 'rideRequest'}}"><button data-operation="respond" data-id="{{item.id}}" data-accept="{{true}}" bindtap="rideOperation" disabled="{{rideBusy}}">一起上车</button><button data-operation="respond" data-id="{{item.id}}" data-accept="{{false}}" bindtap="rideOperation" disabled="{{rideBusy}}">婉拒</button></view>
          <view class="social-actions" wx:else><button data-id="{{item.id}}" data-accept="{{true}}" bindtap="respondRequest" disabled="{{socialBusy}}">同意</button><button data-id="{{item.id}}" data-accept="{{false}}" bindtap="respondRequest" disabled="{{socialBusy}}">拒绝</button></view>
        </view>
        <view class="social-section">我的好友 · {{socialFriends.length}}</view>
        <text class="settings-tip" wx:if="{{!socialFriends.length}}">走近场景中的其他角色，即可申请添加好友</text>
        <view class="social-item social-friend" wx:for="{{socialFriends}}" wx:key="id"><text>{{item.name}}</text><button data-id="{{item.id}}" bindtap="removeFriend" disabled="{{socialBusy}}">解除好友</button></view>
        <view class="social-section" wx:if="{{socialOutgoing.length}}">我发出的申请</view>
        <view class="social-item" wx:for="{{socialOutgoing}}" wx:key="id"><text>{{item.name}} · {{item.type === 'rideInvite' ? '邀请乘车' : item.type === 'rideRequest' ? '申请乘车' : item.type === 'visit' ? '访问庭院' : '添加好友'}}</text><text class="settings-tip">{{item.status === 'accepted' ? '已同意' : item.status === 'rejected' ? '已拒绝' : item.expiresAt && item.expiresAt < socialClock ? '已过期' : '等待对方处理'}}</text></view>
      </scroll-view>
    </view>
  </view>
  <view class="settings-backdrop" wx:if="{{historyModalOpen}}" catchtap="closeHistoryModal" catchtouchmove="swallowTouch">
    <view class="settings-panel history-panel" catchtap="swallowTouch">
      <view class="settings-heading">
        <view>
          <text class="panel-main-title">📋 场景提示历史</text>
          <text class="settings-tip">回看近期系统提示与操作通知</text>
        </view>
        <button bindtap="closeHistoryModal">完成</button>
      </view>
      <scroll-view scroll-y="true" class="history-content">
        <block wx:if="{{messageHistory.length}}">
          <view class="history-row" wx:for="{{messageHistory}}" wx:key="index">
            <text class="history-time">{{item.time}}</text>
            <text class="history-body">{{item.text}}</text>
          </view>
        </block>
        <view wx:else class="history-empty">暂无历史提示消息</view>
      </scroll-view>
      <view class="history-footer" wx:if="{{messageHistory.length}}">
        <button class="clear-history-btn" bindtap="clearHistoryMessages">清空历史</button>
      </view>
    </view>
  </view>
  <include src="./world-life.wxml" />
</view>
