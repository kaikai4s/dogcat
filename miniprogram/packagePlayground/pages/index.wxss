.playground-page, .playground-page view, .playground-page text, .playground-page button, .playground-page image { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
.playground-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff8ec 0%, #e8f8d9 52%, #fff5e6 100%);
}

.playground-hero {
  padding: 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #ffcf8d 0%, #ff9f7a 48%, #8edb91 100%);
  color: #fff;
  box-shadow: 0 22rpx 46rpx rgba(230, 129, 72, 0.22);
}

.hero-badge,
.hero-actions,
.game-features,
.feature-item,
.community-left,
.popover-head,
.modal-actions {
  display: flex;
  align-items: center;
}

.hero-badge { gap: 10rpx; font-size: 24rpx; opacity: .95; }
.hero-title { margin-top: 16rpx; font-size: 42rpx; font-weight: 900; line-height: 1.18; }
.hero-desc { margin-top: 12rpx; font-size: 26rpx; line-height: 1.6; opacity: .94; }
.hero-actions { gap: 18rpx; margin-top: 24rpx; flex-wrap: wrap; }

.small-btn { min-width: 170rpx; height: 66rpx; line-height: 66rpx; border-radius: 999rpx; font-size: 24rpx; }
.loading-card, .empty-card, .dock-item, .pet-strip, .popover-card {
  background: rgba(255, 255, 255, .92);
  border-radius: 34rpx;
  box-shadow: 0 18rpx 42rpx rgba(134, 109, 74, .12);
}
.loading-card, .empty-card { margin-top: 28rpx; padding: 56rpx 32rpx; text-align: center; }
.loading-icon, .empty-icon { display: block; margin-bottom: 18rpx; font-size: 72rpx; color: #ff9f57; }
.strong { font-weight: 800; color: #513827; }
.muted { color: #8d7a65; font-size: 24rpx; line-height: 1.45; }
.empty-title { font-size: 34rpx; font-weight: 900; color: #513827; }
.empty-desc { max-width: 540rpx; margin: 14rpx auto 28rpx; color: #8d7a65; font-size: 26rpx; line-height: 1.6; }
.empty-btn { width: 260rpx; border-radius: 999rpx; }

.daily-status {
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,255,255,.94), rgba(239,255,226,.94));
  box-shadow: 0 16rpx 36rpx rgba(112, 147, 86, .12);
}
.daily-title { font-size: 28rpx; font-weight: 900; color: #513827; }
.daily-desc { margin-top: 10rpx; color: #7b6a57; font-size: 24rpx; line-height: 1.55; }

.game-features {
  gap: 12rpx;
  margin-top: 22rpx;
  padding: 18rpx 14rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, .76);
}
.feature-item { flex: 1; min-width: 0; gap: 8rpx; }
.feature-icon { font-size: 36rpx; }
.feature-title { color: #513827; font-size: 23rpx; font-weight: 800; white-space: nowrap; }
.feature-item .muted { margin-top: 4rpx; font-size: 19rpx; white-space: nowrap; }

.community-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 12rpx 32rpx rgba(134, 109, 74, .1);
}
.community-left { flex: 1; gap: 20rpx; }
.community-icon { width: 72rpx; height: 72rpx; line-height: 72rpx; border-radius: 20rpx; background: #ebf6ec; color: #5ea364; font-size: 44rpx; text-align: center; }
.community-info { display: flex; flex-direction: column; gap: 4rpx; }
.community-label { color: #9c8a77; font-size: 20rpx; }
.community-name { max-width: 380rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 28rpx; }
.mini-btn { height: 58rpx; line-height: 58rpx; padding: 0 24rpx; border-radius: 999rpx; background: #f7ede1; color: #8c572b; font-size: 22rpx; }

.pet-strip { margin-top: 24rpx; padding: 24rpx 0 24rpx 24rpx; }
.strip-title { margin-bottom: 18rpx; color: #513827; font-weight: 900; }
.pet-scroll { white-space: nowrap; }
.pet-chip { display: inline-flex; align-items: center; gap: 14rpx; min-width: 210rpx; margin-right: 18rpx; padding: 16rpx 18rpx; border: 2rpx solid transparent; border-radius: 999rpx; background: #fff8ec; vertical-align: top; }
.pet-chip.active { border-color: #ff9f57; background: #fff0dc; }
.pet-avatar { width: 62rpx; height: 62rpx; border-radius: 50%; background: #ffe0b9; }
.pet-avatar.empty { display: flex; align-items: center; justify-content: center; color: #ff9f57; }
.pet-chip-name { max-width: 120rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #513827; font-size: 26rpx; font-weight: 900; }
.pet-chip-type { color: #9b8a76; font-size: 21rpx; }

.pet-popover { position: fixed; right: 24rpx; bottom: 34rpx; left: 24rpx; z-index: 20; }
.popover-card { padding: 28rpx; border: 2rpx solid rgba(255, 159, 87, .2); }
.popover-head { justify-content: space-between; }
.popover-title { color: #513827; font-size: 34rpx; font-weight: 900; }
.close-btn { padding: 12rpx; color: #8d7a65; font-size: 34rpx; }
.popover-desc { margin-top: 18rpx; color: #6f5a44; font-size: 26rpx; line-height: 1.6; }

.primary-btn { border: none; color: #fff; background: linear-gradient(135deg, #ff9f57, #ff7d66); }
.ghost-btn { border: none; color: #7a4d24; background: rgba(255, 255, 255, .86); }
.compact-btn { display: flex; align-items: center; justify-content: center; gap: 8rpx; width: 100%; height: 72rpx; margin-top: 24rpx; border-radius: 999rpx; font-size: 26rpx; }
.interactive:active { transform: scale(.98); }

.community-modal-mask { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; box-sizing: border-box; padding: 40rpx; background: rgba(30, 24, 18, .62); }
.community-modal-card { width: 100%; max-width: 620rpx; box-sizing: border-box; padding: 46rpx 36rpx; border-radius: 40rpx; background: #fffdf9; box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, .28); text-align: center; }
.community-modal-icon-wrap { width: 110rpx; height: 110rpx; margin: 0 auto 24rpx; line-height: 110rpx; border-radius: 50%; background: linear-gradient(135deg, #e8f7dc, #cbecc0); }
.modal-icon { color: #4b8242; font-size: 58rpx; }
.modal-title { margin-bottom: 16rpx; color: #473220; font-size: 36rpx; font-weight: 900; }
.modal-desc { margin-bottom: 24rpx; color: #725e4c; font-size: 26rpx; line-height: 1.6; text-align: left; }
.modal-tip { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 34rpx; padding: 18rpx 22rpx; border-radius: 20rpx; background: #fdf5ea; color: #9e6b36; font-size: 22rpx; line-height: 1.5; text-align: left; }
.tip-icon { flex-shrink: 0; margin-top: 2rpx; font-size: 26rpx; }
.modal-actions { flex-direction: column; gap: 20rpx; }
.full-btn { display: flex; align-items: center; justify-content: center; gap: 12rpx; width: 100%; height: 84rpx; line-height: 84rpx; border-radius: 999rpx; font-size: 28rpx; font-weight: 700; }

button::after { border: none; }
