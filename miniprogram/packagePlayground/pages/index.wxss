.playground-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff8ec 0%, #e8f8d9 52%, #fff5e6 100%);
}

.playground-hero {
  padding: 30rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #ffcf8d 0%, #ff9f7a 48%, #8edb91 100%);
  color: #fff;
  box-shadow: 0 22rpx 46rpx rgba(230, 129, 72, 0.22);
}

.hero-badge,
.hero-actions,
.scene-top-mask,
.action-dock,
.popover-head {
  display: flex;
  align-items: center;
}

.hero-badge {
  gap: 10rpx;
  font-size: 24rpx;
  opacity: 0.95;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.94;
}

.hero-actions {
  gap: 18rpx;
  margin-top: 24rpx;
}

.small-btn {
  min-width: 170rpx;
  height: 66rpx;
  line-height: 66rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.loading-card,
.empty-card,
.scene-card,
.dock-item,
.pet-strip,
.popover-card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 34rpx;
  box-shadow: 0 18rpx 42rpx rgba(134, 109, 74, 0.12);
}

.loading-card,
.empty-card {
  margin-top: 28rpx;
  padding: 56rpx 32rpx;
  text-align: center;
}

.loading-icon,
.empty-icon {
  display: block;
  font-size: 72rpx;
  color: #ff9f57;
  margin-bottom: 18rpx;
}

.strong {
  font-weight: 800;
  color: #513827;
}

.muted {
  color: #8d7a65;
  font-size: 24rpx;
  line-height: 1.45;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #513827;
}

.empty-desc {
  margin: 14rpx auto 28rpx;
  max-width: 540rpx;
  color: #8d7a65;
  font-size: 26rpx;
  line-height: 1.6;
}

.empty-btn {
  width: 260rpx;
  border-radius: 999rpx;
}

.scene-card {
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  height: 940rpx;
  background: #bfe9ff;
}

.playground-canvas {
  width: 100%;
  height: 100%;
}

.scene-top-mask {
  position: absolute;
  left: 22rpx;
  right: 22rpx;
  top: 22rpx;
  justify-content: space-between;
  gap: 12rpx;
  pointer-events: none;
}

.scene-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  color: #65452d;
  background: rgba(255, 255, 255, 0.84);
  font-size: 22rpx;
  font-weight: 800;
}

.daily-status {
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.94), rgba(239, 255, 226, 0.94));
  box-shadow: 0 16rpx 36rpx rgba(112, 147, 86, 0.12);
}

.daily-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #513827;
}

.daily-desc {
  margin-top: 10rpx;
  color: #7b6a57;
  font-size: 24rpx;
  line-height: 1.55;
}

.render-error {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 30rpx;
  text-align: center;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
}

.compact-btn {
  margin-top: 20rpx;
  width: 180rpx;
  height: 62rpx;
  line-height: 62rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.action-dock {
  gap: 20rpx;
  margin-top: 24rpx;
}

.dock-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
}

.dock-icon {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  color: #fff;
  font-size: 36rpx;
}

.dock-icon.pink { background: linear-gradient(135deg, #ff8ab8, #ffb0d0); }
.dock-icon.orange { background: linear-gradient(135deg, #ff9f57, #ffc36d); }

.dock-title {
  font-size: 28rpx;
  font-weight: 900;
  color: #513827;
}

.dock-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9b8a76;
}

.pet-strip {
  margin-top: 24rpx;
  padding: 24rpx 0 24rpx 24rpx;
}

.strip-title {
  margin-bottom: 18rpx;
  font-weight: 900;
  color: #513827;
}

.pet-scroll {
  white-space: nowrap;
}

.pet-chip {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  min-width: 210rpx;
  margin-right: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 999rpx;
  background: #fff8ec;
  border: 2rpx solid transparent;
  vertical-align: top;
}

.pet-chip.active {
  border-color: #ff9f57;
  background: #fff0dc;
}

.pet-avatar {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #ffe0b9;
}

.pet-avatar.empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ff9f57;
}

.pet-chip-name {
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  font-weight: 900;
  color: #513827;
}

.pet-chip-type {
  font-size: 21rpx;
  color: #9b8a76;
}

.pet-popover {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 34rpx;
  z-index: 20;
}

.popover-card {
  padding: 28rpx;
  border: 2rpx solid rgba(255, 159, 87, 0.2);
}

.popover-head {
  justify-content: space-between;
}

.popover-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #513827;
}

.close-btn {
  padding: 12rpx;
  color: #8d7a65;
  font-size: 34rpx;
}

.popover-desc {
  margin-top: 18rpx;
  color: #6f5a44;
  font-size: 26rpx;
  line-height: 1.6;
}

.primary-btn {
  color: #fff;
  background: linear-gradient(135deg, #ff9f57, #ff7d66);
  border: none;
}

.ghost-btn {
  color: #7a4d24;
  background: rgba(255, 255, 255, 0.86);
  border: none;
}

.interactive:active {
  transform: scale(0.98);
}
