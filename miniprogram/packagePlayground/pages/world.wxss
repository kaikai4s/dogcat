@import "./world-life.wxss";
page { height: 100%; overflow: hidden; background: #d7e7db; }
.world, .world view, .world text, .world button, .world canvas { user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; }
.world, .canvas { position: fixed; inset: 0; width: 100%; height: 100%; }
.top { position: fixed; left: 12px; right: 12px; z-index: 10; display: flex; align-items: center; gap: 6px; }
.top .round { flex: 0 0 36px; width: 36px; min-width: 0; max-width: 36px; white-space: nowrap; margin: 0; padding: 0; height: 36px; line-height: 36px; border-radius: 18px; background: rgba(255,253,243,.94); font-size: 13px; color: #415345; }
.top .settings-icon { font-size: 21px; }
.top .back-button { flex-basis: 54px; width: 54px; max-width: 54px; }
.title { flex: 1; min-width: 0; display: flex; flex-direction: column; padding: 8px 10px; border-radius: 16px; background: rgba(255,253,243,.88); color: #263e2b; font-size: 17px; font-weight: 700; }
.community-name { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 23px; }
.subtitle { display: flex; align-items: center; justify-content: space-between; gap: 4px; font-size: 10px; font-weight: 400; margin-top: 3px; line-height: 16px; }
.subtitle > text:first-child { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.resident-count { flex: none; white-space: nowrap; }
.bottom { position: fixed; left: 12px; right: 12px; z-index: 10; text-align: center; }
.status { display: inline-block; max-width: 92%; padding: 8px 16px; border-radius: 20px; background: rgba(255,253,243,.92); font-size: 12px; color: #45614a; }
.pet-actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; padding: 10px; border-radius: 18px; background: rgba(255,253,243,.96); }
.selected-pet-name { width: 100%; color: #385743; font-size: 12px; text-align: left; }
.pet-actions button { flex: 1 0 27%; margin: 0; padding: 0 8px; line-height: 32px; border-radius: 14px; font-size: 11px; color: #385743; background: #e4eddb; }
.unplaced { padding: 12px; margin-top: 8px; border-radius: 18px; background: rgba(255,253,243,.96); font-size: 12px; color: #385743; }
.unplaced button { margin: 8px 0 0; font-size: 13px; border-radius: 18px; color: white; background: #6f8d58; }
.pet-size-entry { display: flex; justify-content: center; margin-top: 8px; }
.pet-size-entry button { margin: 0; padding: 0 14px; line-height: 30px; border-radius: 16px; background: rgba(255,253,243,.94); color: #385743; font-size: 12px; }
.pet-size-panel { margin-top: 8px; padding: 10px 14px; border-radius: 18px; background: rgba(255,253,243,.96); color: #385743; font-size: 12px; text-align: left; }
.pet-size-heading { display: flex; justify-content: space-between; gap: 8px; }
.pet-size-tip { font-size: 10px; color: #74816e; }
.pet-size-slider { display: flex; align-items: center; gap: 8px; }
.pet-size-slider slider { flex: 1; margin: 10px 0; }
.pet-size-slider button { margin: 0 0 0 4px; padding: 0 8px; line-height: 28px; font-size: 11px; color: #385743; background: #e4eddb; border-radius: 12px; }
.controls { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; padding: 8px; border-radius: 22px; background: rgba(247,248,235,.94); box-shadow: 0 8px 24px rgba(48,71,45,.16); }
.controls button { flex: 1 0 28%; white-space: nowrap; margin: 0; padding: 0 5px; font-size: 11px; line-height: 36px; border-radius: 16px; color: #355842; background: #e4eddb; }
button::after { border: none; }
.hint { margin-top: 8px; color: #304c35; font-size: 11px; text-shadow: 0 1px 3px #fff; }
.loading, .error { position: fixed; left: 24px; right: 24px; top: 40%; border-radius: 24px; background: #fffcf0; padding: 28px; text-align: center; color: #385743; box-shadow: 0 10px 40px #65876033; }
.loading { display: flex; flex-direction: column; align-items: center; gap: 18px; font-size: 14px; }
.loader { width: 30px; height: 30px; border: 3px solid #d6e5cf; border-top-color: #68875d; border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.detail { margin: 16px 0; font-size: 12px; word-break: break-all; }
.player-hud { position: fixed; left: 18px; right: 18px; z-index: 12; display: flex; justify-content: flex-end; align-items: flex-end; pointer-events: none; }
.joystick-pad { position: fixed; z-index: 20; pointer-events: none; width: 144px; height: 144px; border-radius: 50%; background: rgba(255,253,243,.55); box-shadow: inset 0 0 0 2px rgba(255,255,255,.65), 0 6px 22px rgba(48,71,45,.16); }
.joystick-pad.running { background: rgba(255,226,165,.65); box-shadow: inset 0 0 0 2px rgba(222,158,53,.8); }
.joystick-fixed { pointer-events: auto; }
.settings-backdrop { position: fixed; inset: 0; z-index: 40; display: flex; align-items: center; justify-content: center; background: rgba(22,44,28,.32); }
.settings-panel { width: 90%; max-width: 420px; max-height: 82vh; overflow: hidden; padding: 20px; box-sizing: border-box; border-radius: 24px; background: #fffcf0; color: #385743; font-size: 14px; }
.settings-heading, .settings-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.settings-heading { font-size: 18px; font-weight: bold; margin-bottom: 12px; }
.settings-heading button { margin: 0; padding: 0 12px; font-size: 12px; line-height: 32px; border-radius: 16px; color: white; background: #6f8d58; }
.settings-row { padding: 14px 0; border-bottom: 1px solid #e4eddb; }
.settings-tip { display: block; margin-top: 5px; color: #74816e; font-size: 11px; }
.settings-opacity { padding: 16px 0 0; }
.settings-hand { padding: 16px 0; border-bottom: 1px solid #e4eddb; }
.hand-options { display: flex; gap: 8px; margin-top: 10px; }
.hand-options button { flex: 1; width: auto; min-width: 0; margin: 0; padding: 0 8px; line-height: 36px; border-radius: 16px; font-size: 13px; color: #385743; background: #e4eddb; }
.hand-options button.active { color: white; background: #6f8d58; }
.joystick-ring { position: absolute; inset: 37px; border: 1px dashed rgba(82,115,69,.5); border-radius: 50%; }
.joystick-knob { position: absolute; left: 48px; top: 48px; width: 48px; height: 48px; border-radius: 50%; background: #6f8d58; box-shadow: inset 0 2px 5px rgba(255,255,255,.3), 0 4px 12px rgba(48,71,45,.25); }
.running .joystick-knob { background: #cc923f; }
.joystick-caption { position: absolute; top: 153px; left: -24px; width: 192px; text-align: center; font-size: 11px; color: #304c35; text-shadow: 0 1px 3px #fff; }
.interaction-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; max-width: 58%; }
.player-hud.right-hand { justify-content: flex-start; }
.right-hand .interaction-actions { align-items: flex-start; }
.interaction-actions button { pointer-events: auto; margin: 0; padding: 0 18px; line-height: 44px; border-radius: 22px; font-size: 13px; color: #fffdf3; box-shadow: 0 5px 16px rgba(48,71,45,.15); }
.interaction-actions .interact-pet { background: #c77b84; }
.interaction-actions .fill-bowl { background: #6f8d58; }
.interaction-actions button { background: #6f8d58; }
.request-badge { pointer-events: auto; flex: 0 1 auto; max-width: 100%; margin: 0 0 0 auto; padding: 0 14px; line-height: 32px; border-radius: 18px; color: #fff; background: #b2744c; font-size: 12px; white-space: normal; }
.social-list { max-height: 56vh; height: 56vh; }
.social-section { margin: 18px 0 8px; font-weight: bold; }
.social-item { padding: 12px 0; border-bottom: 1px solid #e4eddb; font-size: 13px; }
.social-actions, .social-friend { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
.social-actions button, .social-friend button { margin: 8px 0 0; padding: 0 14px; font-size: 12px; line-height: 32px; border-radius: 16px; color: #385743; background: #e4eddb; }
.interaction-actions button[disabled] { color: #6b7c5f; background: #e4eddb; }
.interaction-tip { padding: 10px 12px; border-radius: 14px; font-size: 11px; line-height: 18px; text-align: right; color: #486346; background: rgba(255,253,243,.85); }
@media (max-height: 500px) {
  .player-hud { bottom: 96px !important; }
  .joystick-caption, .interaction-tip { display: none; }
}

.settings-content { height: 60vh; max-height: calc(82vh - 116px); }
.settings-heading { margin-bottom: 18px; align-items: flex-start; }
.settings-heading .settings-tip { font-weight: normal; margin-top: 6px; }
.settings-section { display: block; padding: 18px 4px 10px; color: #829078; font-size: 11px; letter-spacing: 1px; }
.settings-card { padding: 0 14px; border-radius: 18px; background: #f0f3e8; }
.settings-card .settings-row:last-child { border-bottom: none; }
.settings-row > view { flex: 1; min-width: 0; }
.settings-row switch { flex: none; transform: scale(.85); transform-origin: right center; }
.settings-hand { padding: 14px 0; }
.hand-options { padding: 4px; gap: 4px; background: #e4eadb; border-radius: 14px; }
.hand-options button { background: transparent; line-height: 34px; border-radius: 11px; font-size: 12px; }
.hand-options button.active { background: #fffdf3; color: #44653e; box-shadow: 0 2px 6px #526c4420; font-weight: 600; }
.settings-opacity { padding: 14px 0 6px; }
.settings-opacity slider { margin: 12px 0 8px; }
.settings-value { display: flex; justify-content: space-between; }
.settings-value > text:last-child { font-size: 12px; color: #6f8d58; }
.settings-entry { display: flex; align-items: center; gap: 12px; width: 100%; padding: 14px; margin: 0; line-height: 1.5; border-radius: 18px; background: #edf2e4; color: #385743; text-align: left; }
.settings-entry-icon { flex: none; display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; border-radius: 13px; color: #fffdf3; background: #6f8d58; font-size: 18px; }
.settings-entry-copy { flex: 1; min-width: 0; }
.settings-entry-title { display: block; font-size: 14px; font-weight: 600; }
.settings-entry .settings-tip { font-size: 10px; white-space: normal; }
.settings-chevron { flex: none; color: #8d9d80; font-size: 24px; }
.settings-count { flex: none; min-width: 20px; height: 20px; border-radius: 10px; line-height: 20px; text-align: center; font-size: 11px; background: #be7855; color: #fff; }
.character-entry { margin-top: 14px; margin-bottom: 6px; background: #f0f3e8; }
.character-entry .settings-entry-icon { color: #6f8d58; background: #e1e9d7; }
.character-selection { margin-top: 8px; padding: 10px; border-radius: 16px; color: #385743; background: #fffdf3ed; font-size: 12px; }
.social-item { padding: 14px; margin-bottom: 10px; background: #f0f3e8; border-radius: 16px; border-bottom: none; }
.social-actions { justify-content: flex-end; }
.social-actions button:first-child { color: white; background: #6f8d58; }
.social-section { font-size: 12px; color: #75836b; }
.social-list { max-height: calc(82vh - 116px); }

/* 顶部功能菜单折叠 */
.menu-collapse-btn { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; font-size: 11px; font-weight: 600; color: #355842; background: rgba(247,248,235,.94); border-radius: 14px; box-shadow: 0 4px 12px rgba(48,71,45,.12); position: relative; }
.menu-badge { width: 7px; height: 7px; border-radius: 50%; background: #e55353; position: absolute; top: 3px; right: 4px; }

/* 底部状态消息容器与历史提示按钮 */
.status-container { display: flex; align-items: center; justify-content: space-between; gap: 8px; width: 100%; margin-bottom: 6px; }
.status-container .status { flex: 1; min-height: 28px; line-height: 28px; padding: 0 12px; border-radius: 14px; font-size: 11px; color: #355842; background: rgba(247,248,235,.92); box-shadow: 0 4px 14px rgba(48,71,45,.10); transition: opacity .4s ease; }
.status-visible { opacity: 1; }
.status-hidden { opacity: 0; pointer-events: none; }
.history-msg-btn { flex: none; display: inline-flex; align-items: center; gap: 3px; height: 28px; line-height: 28px; padding: 0 9px; font-size: 11px; border-radius: 14px; color: #355842; background: rgba(247,248,235,.94); box-shadow: 0 4px 12px rgba(48,71,45,.12); position: relative; margin: 0; }
.history-btn-icon { font-size: 12px; }
.history-badge { min-width: 15px; height: 15px; line-height: 15px; border-radius: 8px; font-size: 9px; background: #6f8d58; color: #fff; text-align: center; padding: 0 3px; }

/* 历史消息抽屉/弹窗 */
.history-panel { max-height: 68vh; }
.history-content { max-height: 48vh; padding: 4px 0; }
.history-row { display: flex; align-items: flex-start; gap: 8px; padding: 8px 12px; margin-bottom: 6px; background: #edf2e4; border-radius: 12px; font-size: 11px; }
.history-time { flex: none; color: #6f8d58; font-weight: 600; font-size: 10px; margin-top: 1px; }
.history-body { flex: 1; color: #355842; word-break: break-all; }
.history-empty { text-align: center; color: #889980; font-size: 12px; padding: 32px 0; }
.history-footer { display: flex; justify-content: flex-end; padding-top: 10px; }
.clear-history-btn { font-size: 11px; color: #8a9682; background: #e5ede0; border-radius: 12px; padding: 4px 14px; margin: 0; }

/* 选址地皮尺寸工具栏 */
.plot-size-bar { display: flex; align-items: center; gap: 4px; padding: 6px 8px; margin-top: 8px; border-radius: 16px; background: rgba(247,248,235,.94); box-shadow: 0 6px 18px rgba(48,71,45,.12); }
.plot-size-label { font-size: 10px; color: #526e5a; font-weight: 600; flex: none; }
.plot-size-chip { flex: 1; font-size: 10px; line-height: 28px; padding: 0 4px; border-radius: 12px; color: #385743; background: #e4eddb; margin: 0; white-space: nowrap; }
.plot-size-chip.active { color: #fff; background: #4f7956; font-weight: 600; }

