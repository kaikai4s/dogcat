page { height: 100%; overflow: hidden; background: #d7e7db; }
.world, .canvas { position: fixed; inset: 0; width: 100%; height: 100%; }
.top { position: fixed; left: 18px; right: 18px; z-index: 10; display: flex; align-items: center; gap: 12px; }
.round { margin: 0; padding: 0 16px; height: 40px; line-height: 40px; border-radius: 24px; background: rgba(255,253,243,.94); font-size: 14px; color: #415345; }
.title { display: flex; flex-direction: column; color: #263e2b; font-size: 21px; font-weight: 700; text-shadow: 0 1px 4px #fff; }
.subtitle { font-size: 10px; font-weight: 400; margin-top: 4px; }
.bottom { position: fixed; left: 12px; right: 12px; z-index: 10; text-align: center; }
.status { display: inline-block; max-width: 92%; padding: 8px 16px; border-radius: 20px; background: rgba(255,253,243,.92); font-size: 12px; color: #45614a; }
.pet-tabs { margin-top: 10px; white-space: nowrap; width: 100%; }
.pet-chip { display: inline-flex; align-items: center; gap: 5px; margin-right: 8px; padding: 7px 11px; border-radius: 18px; background: rgba(255,253,243,.9); color: #385743; font-size: 12px; box-shadow: 0 5px 14px rgba(48,71,45,.1); }
.pet-chip.selected { background: #6f8d58; color: #fff; }
.pet-chip.disabled { opacity: .62; }
.species { padding: 1px 5px; border-radius: 9px; background: rgba(77,105,67,.14); font-size: 10px; }
.selected .species { background: rgba(255,255,255,.22); }
.pending { font-size: 10px; color: #a36a3d; }
.selected .pending { color: #ffe0b7; }
.controls { display: flex; gap: 6px; margin-top: 10px; padding: 8px; border-radius: 22px; background: rgba(247,248,235,.94); box-shadow: 0 8px 24px rgba(48,71,45,.16); }
.controls button { flex: 1; margin: 0; padding: 0; font-size: 11px; line-height: 40px; border-radius: 16px; color: #355842; background: #e4eddb; }
button::after { border: none; }
.hint { margin-top: 8px; color: #304c35; font-size: 11px; text-shadow: 0 1px 3px #fff; }
.loading, .error { position: fixed; left: 24px; right: 24px; top: 40%; border-radius: 24px; background: #fffcf0; padding: 28px; text-align: center; color: #385743; box-shadow: 0 10px 40px #65876033; }
.loading { display: flex; flex-direction: column; align-items: center; gap: 18px; font-size: 14px; }
.loader { width: 30px; height: 30px; border: 3px solid #d6e5cf; border-top-color: #68875d; border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.detail { margin: 16px 0; font-size: 12px; word-break: break-all; }
