.manor-payment-time{color:#bc8345;margin-top:3px}.groupbuy-retry{display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#927347;margin:10px 0}.groupbuy-retry button{margin:0;font-size:11px;background:#f5eddb;line-height:30px;color:#927347}
.public-care-panel{max-height:72vh}.public-care-active{display:flex;align-items:center;gap:7px;padding:11px 12px;border-radius:12px;background:#e7f1df;color:#4d783b;font-size:12px;margin-bottom:12px}.public-care-list{height:36vh;max-height:300px}.public-care-row{display:flex;align-items:center;gap:10px;padding:15px 2px;border-bottom:1px solid #e8eedf;font-size:12px}.public-care-dot{height:7px;width:7px;border-radius:50%;background:#8eac6c;flex-shrink:0}.public-care-label{flex:1;color:#465d3d}.public-care-date{font-size:11px;color:#8c9984}.public-care-privacy{display:flex;align-items:center;gap:7px;font-size:10px;color:#8b9980;margin-top:16px;line-height:1.8}
