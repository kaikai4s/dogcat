<view class="manor-screen">
  <canvas wx:if="{{mountCanvas}}" id="manor-canvas" type="webgl" class="manor-canvas"
    catchtouchstart="onTouchStart" catchtouchmove="onTouchMove" catchtouchend="onTouchEnd" catchtouchcancel="onTouchCancel" />

  <view wx:if="{{status === 'loading'}}" class="manor-shade">
    <view class="manor-panel">
      <text class="manor-kicker">3D 庄园</text>
      <text class="manor-title">晴溪庄园</text>
      <text class="manor-caption">{{stage}}</text>
      <progress wx:if="{{progress >= 0}}" percent="{{progress}}" activeColor="#337364" backgroundColor="#e6eee4" border-radius="4" stroke-width="5" />
      <text wx:if="{{progress >= 0}}" class="manor-percent">{{progress}}%</text>
    </view>
  </view>
  <view wx:elif="{{status === 'error' || status === 'unavailable'}}" class="manor-shade">
    <view class="manor-panel">
      <text class="manor-kicker">3D 庄园</text>
      <text class="manor-title">{{status === 'unavailable' ? '暂未开放' : '加载中断'}}</text>
      <text class="manor-caption">{{status === 'unavailable' ? '当前版本可继续进入 2D 庄园' : error}}</text>
      <view class="manor-panel-actions">
        <button wx:if="{{status === 'error'}}" class="manor-action manor-primary" bindtap="retryLandscape">重新加载</button>
        <button class="manor-action" bindtap="goBack">返回宠物庄园</button>
      </view>
    </view>
  </view>
  <block wx:elif="{{status === 'ready'}}">
    <view class="manor-notices {{minimap && !mapMode && !insideVilla ? 'manor-notices-with-map' : ''}}" wx:if="{{communityStatus === 'loading' || communityStatus === 'error' || characterStatus === 'loading' || characterStatus === 'drawing' || characterStatus === 'error' || villaStatus === 'loading' || villaStatus === 'drawing' || villaStatus === 'error' || interiorStatus === 'loading' || interiorStatus === 'drawing' || interiorStatus === 'error' || petModelsStatus === 'loading' || petModelsStatus === 'error' || (vehicleLoadError && !insideVilla && !mapMode && !buildMode)}}">
      <view wx:if="{{communityStatus === 'loading' || communityStatus === 'error'}}" class="manor-notice manor-community-notice">
        <text wx:if="{{communityStatus === 'loading'}}" class="manor-notice-text">正在连接{{communityName ? ' · ' + communityName : '庄园场景'}}</text>
        <block wx:else>
          <text class="manor-notice-text">{{communityError}}</text>
          <button class="manor-link" bindtap="retryCommunity">重试</button>
        </block>
      </view>
      <view wx:if="{{characterStatus === 'loading' || characterStatus === 'drawing' || characterStatus === 'error'}}" class="manor-notice">
        <text wx:if="{{characterStatus === 'drawing'}}" class="manor-notice-text">正在准备角色</text>
        <text wx:elif="{{characterStatus === 'loading'}}" class="manor-notice-text">正在加载角色{{characterProgress >= 0 ? ' ' + characterProgress + '%' : ''}}</text>
        <block wx:else>
          <text class="manor-notice-text">{{characterError}}</text>
          <button class="manor-link" bindtap="retryCharacter">重试</button>
        </block>
      </view>
      <view wx:if="{{villaStatus === 'loading' || villaStatus === 'drawing' || villaStatus === 'error'}}" class="manor-notice">
        <text wx:if="{{villaStatus === 'drawing'}}" class="manor-notice-text">正在绘制别墅</text>
        <text wx:elif="{{villaStatus === 'loading'}}" class="manor-notice-text">正在加载别墅{{villaProgress >= 0 ? ' ' + villaProgress + '%' : ''}}</text>
        <block wx:else>
          <text class="manor-notice-text">{{villaError}}</text>
          <button class="manor-link" bindtap="retryVilla">重试</button>
        </block>
      </view>
      <view wx:if="{{interiorStatus === 'loading' || interiorStatus === 'drawing' || interiorStatus === 'error'}}" class="manor-notice manor-interior-notice">
        <text wx:if="{{interiorStatus === 'drawing'}}" class="manor-notice-text">正在准备别墅内部</text>
        <text wx:elif="{{interiorStatus === 'loading'}}" class="manor-notice-text">正在加载别墅内部{{interiorProgress >= 0 ? ' ' + interiorProgress + '%' : ''}}</text>
        <block wx:else>
          <text class="manor-notice-text">{{interiorError}}</text>
          <button class="manor-link" bindtap="retryInterior">重试</button>
        </block>
      </view>
      <view wx:if="{{petModelsStatus === 'loading' || petModelsStatus === 'error'}}" class="manor-notice manor-pet-notice">
        <text wx:if="{{petModelsStatus === 'loading'}}" class="manor-notice-text">正在准备猫狗模型</text>
        <block wx:else><text class="manor-notice-text">{{petModelsError}}</text><button class="manor-link" bindtap="retryPetModels">重试</button></block>
      </view>
      <view wx:if="{{vehicleLoadError && !insideVilla && !mapMode && !buildMode}}" class="manor-notice">
        <text class="manor-notice-text">{{vehicleLoadError}}</text>
        <button class="manor-link" bindtap="retryVehicle">重试</button>
      </view>
    </view>
    <view wx:if="{{buildMode}}" class="manor-build-panel" aria-label="建筑建造">
      <view class="manor-build-header">
        <text class="manor-build-title">建造建筑</text>
        <text class="manor-build-detail">占地 {{buildFootprint}}</text>
      </view>
      <view class="manor-build-catalog" aria-label="选择建筑款式">
        <button wx:for="{{buildCatalog}}" wx:key="id" data-building-id="{{item.id}}" bindtap="chooseBuilding"
          disabled="{{buildSaving}}" class="manor-action manor-build-option {{buildId === item.id ? 'manor-build-selected' : ''}}">{{item.name}}</button>
      </view>
      <view class="manor-build-orientation">
        <button class="manor-action manor-build-turn" data-delta="-90" bindtap="rotateBuilding" disabled="{{buildSaving}}">左转 90°</button>
        <text class="manor-build-angle" aria-label="朝向 {{buildRotation}} 度">{{buildRotation}}°</text>
        <button class="manor-action manor-build-turn" data-delta="90" bindtap="rotateBuilding" disabled="{{buildSaving}}">右转 90°</button>
      </view>
      <view class="manor-build-feedback" aria-live="polite">
        <text class="manor-build-hint">{{buildHint}}</text>
        <text wx:if="{{buildError}}" class="manor-build-error">{{buildError}}</text>
        <text wx:if="{{buildId === 'songying_courtyard' && courtyardStatus === 'loading'}}" class="manor-build-detail">正在加载松影叠院{{courtyardProgress >= 0 ? ' ' + courtyardProgress + '%' : ''}}</text>
        <view wx:if="{{buildId === 'songying_courtyard' && courtyardStatus === 'error'}}" class="manor-build-retry">
          <text class="manor-build-error">{{courtyardError}}</text><button class="manor-link" bindtap="retryCourtyard">重试</button>
        </view>
      </view>
      <button class="manor-action manor-primary manor-build-submit" bindtap="confirmBuilding"
        disabled="{{!buildCanConfirm || buildSaving}}" loading="{{buildSaving}}">{{buildSaving ? '正在建造' : '确认建造'}}</button>
    </view>
    <view wx:elif="{{mapMode}}" class="manor-map-bar">
      <text class="manor-map-hint">单指旋转 · 双指同向滑动平移 · 捏合缩放</text>
    </view>
    <block wx:else>
      <button wx:if="{{minimap && !insideVilla}}" class="manor-minimap" style="{{minimapTop ? 'top:' + minimapTop + 'px' : ''}}"
        bindtap="openMap" disabled="{{vehicleState !== 'walking' || vehiclePanelOpen}}" aria-label="展开庄园地图">
        <view class="manor-minimap-land">
          <view wx:if="{{minimap.river}}" class="manor-minimap-river"
            style="clip-path:{{minimap.river}};-webkit-clip-path:{{minimap.river}}"></view>
          <view wx:for="{{minimap.plots}}" wx:key="id" class="manor-minimap-mark manor-minimap-plot"
            style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.width}}%;height:{{item.height}}%"></view>
          <view wx:for="{{minimap.trees}}" wx:key="id" class="manor-minimap-mark manor-minimap-tree"
            style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.width}}%;height:{{item.height}}%"></view>
          <view wx:for="{{minimap.crossings}}" wx:key="id" class="manor-minimap-mark manor-minimap-bridge"
            style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.width}}%;height:{{item.height}}%;transform:translate(-50%,-50%) rotate({{item.angle}}deg)"></view>
          <view wx:for="{{minimap.towers}}" wx:key="id" class="manor-minimap-mark manor-minimap-tower"
            style="left:{{item.x}}%;top:{{item.y}}%;width:{{item.width}}%;height:{{item.height}}%"></view>
          <view wx:for="{{mapNeighbors}}" wx:key="id" class="manor-minimap-mark manor-minimap-neighbor"
            style="left:{{item.x}}%;top:{{item.y}}%"></view>
          <view wx:if="{{mapVehicle}}" class="manor-minimap-mark manor-minimap-vehicle"
            style="left:{{mapVehicle.x}}%;top:{{mapVehicle.y}}%" aria-label="我的车"></view>
          <view wx:if="{{mapPlayer}}" class="manor-minimap-mark manor-minimap-player"
            style="left:{{mapPlayer.x}}%;top:{{mapPlayer.y}}%"></view>
        </view>
        <text class="manor-minimap-label">{{mapNeighbors.length ? '邻居 ' + mapNeighbors.length : '地图'}}</text>
      </button>
      <view wx:if="{{pets.length && !insideVilla && !mapMode && !buildMode}}" class="manor-pet-hud">
        <button class="manor-pet-roster-toggle {{petRosterOpen ? 'manor-pet-roster-open' : ''}}" bindtap="togglePetRoster"
          aria-label="{{petRosterOpen ? '收起宠物列表' : '打开宠物列表'}}">
          <text class="manor-pet-hud-icon">🐾</text><text>宠物 {{pets.length}}</text>
        </button>
        <view wx:if="{{petRosterOpen}}" class="manor-pet-roster" catchtap="swallowPetTouch">
          <view class="manor-pet-roster-heading"><text>我的伙伴</text><text class="manor-pet-roster-count">{{pets.length}} 只</text></view>
          <scroll-view scroll-y class="manor-pet-roster-list">
            <button wx:for="{{pets}}" wx:key="id" data-pet-id="{{item.id}}" bindtap="selectPet"
              class="manor-pet-roster-item {{selectedPetId === item.id ? 'manor-pet-roster-selected' : ''}}">
              <view class="manor-pet-roster-main"><text class="manor-pet-roster-name">{{item.name}}</text><text class="manor-pet-roster-meta">{{item.species === 'cat' ? '猫咪' : '狗狗'}} · {{item.activity || '自由活动'}}</text></view>
              <text wx:if="{{item.following}}" class="manor-pet-roster-follow">跟随</text>
            </button>
          </scroll-view>
        </view>
      </view>
      <view wx:if="{{activeCharacter && !vehiclePanelOpen && (vehicleState === 'walking' || vehicleState === 'driver')}}"
        class="manor-joystick {{stickActive ? 'manor-joystick-active' : ''}} {{restLocked || doorBusy || (elevator && elevator.busy) ? 'manor-joystick-locked' : ''}}" id="manor-stick"
        aria-label="{{vehicleState === 'driver' ? '向上加速，向下减速或倒车，左右转向' : '轻推摇杆行走，推远奔跑'}}" catchtouchstart="onStickStart" catchtouchmove="onStickMove"
        catchtouchend="onStickEnd" catchtouchcancel="onStickCancel">
        <view class="manor-stick-axis manor-stick-north"></view>
        <view class="manor-stick-axis manor-stick-south"></view>
        <view class="manor-stick-axis manor-stick-west"></view>
        <view class="manor-stick-axis manor-stick-east"></view>
        <view class="manor-stick-knob" style="transform: translate({{stickX}}px, {{stickY}}px);"></view>
      </view>
      <view wx:if="{{!menuOpen && !vehiclePanelOpen && vehicleState === 'walking'}}"
        class="manor-player-actions" aria-label="角色动作">
        <view class="manor-context-actions" aria-label="附近交互">
          <button wx:if="{{doorPrompt && !insideVilla}}" class="manor-action manor-context-action" bindtap="enterVilla" aria-label="{{courtyardDoorLabel ? courtyardDoorLabel + '，开门进入' : '开门进入别墅'}}">开门进入</button>
          <button wx:if="{{insideVilla && (!insideCourtyard || courtyardDoorLabel)}}" class="manor-action manor-context-action"
            disabled="{{doorBusy || restLocked || (elevator && elevator.busy)}}" bindtap="exitVilla">{{insideCourtyard ? '开门离开' : '离开别墅'}}</button>
          <button wx:if="{{insideCourtyard && roomDoor}}" class="manor-action manor-context-action" data-door-id="{{roomDoor.id}}" bindtap="useRoomDoor"
            disabled="{{roomDoor.busy}}" aria-label="{{roomDoor.label + '，' + (roomDoor.open ? '关门' : '开门')}}">{{roomDoor.busy ? '开关门中' : roomDoor.open ? '关门' : '开门'}}</button>
          <block wx:if="{{insideVilla && elevator}}">
            <block wx:if="{{!elevator.busy}}">
              <button wx:for="{{elevator.buttons}}" wx:key="floor" class="manor-action manor-context-action"
                data-floor="{{item.floor}}" bindtap="useElevator" disabled="{{restLocked || doorBusy}}">前往{{item.label}}</button>
            </block>
            <text wx:if="{{elevator.busy}}" class="manor-context-status" aria-live="polite">{{elevator.title}} · {{elevator.destination}}</text>
          </block>
          <button wx:if="{{playerActions && vehicleNearby && !insideVilla && !doorBusy}}" class="manor-action manor-context-action" bindtap="openVehiclePanel" aria-label="为 Copper GT 选座上车">选座上车</button>
          <button wx:if="{{nearbyPet && !insideVilla && !doorBusy}}" class="manor-action manor-context-action" bindtap="interactPet" disabled="{{petCareBusy}}">摸摸 {{nearbyPet.name}}</button>
        </view>
        <view wx:if="{{playerActions && !doorBusy && !(elevator && elevator.busy)}}" class="manor-player-action-row">
          <button class="manor-action manor-player-action manor-player-rest manor-player-sit" data-rest-kind="sit" bindtap="interactRest"
            disabled="{{!playerActions.sit || playerActions.sit.busy}}"
            aria-label="{{playerActions.sit ? playerActions.sit.label + '，' + playerActions.sit.name : '坐下，靠近可坐的家具后可用'}}">{{playerActions.sit ? playerActions.sit.label : '坐下'}}</button>
          <button class="manor-action manor-player-action manor-player-rest manor-player-lie" data-rest-kind="lie" bindtap="interactRest"
            disabled="{{!playerActions.lie || playerActions.lie.busy}}"
            aria-label="{{playerActions.lie ? playerActions.lie.label + '，' + playerActions.lie.name : '躺下，靠近可躺的家具后可用'}}">{{playerActions.lie ? playerActions.lie.label : '躺下'}}</button>
          <button class="manor-action manor-player-action manor-player-jump {{!playerActions.jump ? 'manor-player-jump-disabled' : ''}}"
            catchtouchstart="jumpPlayer" aria-disabled="{{!playerActions.jump}}">跳跃</button>
        </view>
      </view>
      <view wx:if="{{selectedPet && !insideVilla && !mapMode && !buildMode && !vehiclePanelOpen}}" class="manor-pet-panel" catchtap="swallowPetTouch">
        <view class="manor-pet-panel-heading">
          <view><text class="manor-pet-panel-name">{{selectedPet.name}}</text><text class="manor-pet-panel-activity">{{selectedPet.activity || '自由活动'}}</text></view>
          <button class="manor-pet-panel-close" bindtap="clearSelectedPet" aria-label="收起宠物状态">×</button>
        </view>
        <view class="manor-pet-needs" wx:if="{{selectedPet.needs && selectedPet.needs.length}}">
          <view wx:for="{{selectedPet.needs}}" wx:key="key" class="manor-pet-need {{item.low ? 'manor-pet-need-low' : ''}}">
            <view class="manor-pet-need-label"><text>{{item.label}}</text><text>{{item.value}}%</text></view>
            <view class="manor-pet-need-track"><view style="width:{{item.value}}%"></view></view>
          </view>
        </view>
        <view class="manor-pet-actions">
          <button class="manor-action manor-pet-action-primary" data-operation="{{selectedPet.following ? 'stay' : 'follow'}}" bindtap="petAction" disabled="{{petCareBusy}}">{{selectedPet.following ? '取消跟随' : '让它跟我走'}}</button>
          <button class="manor-action" data-operation="feed" bindtap="petAction" disabled="{{petCareBusy}}">喂零食</button>
          <button class="manor-action" data-operation="eat" bindtap="petAction" disabled="{{petCareBusy}}">去碗边吃饭</button>
          <button class="manor-action" data-operation="drink" bindtap="petAction" disabled="{{petCareBusy}}">去喝水</button>
          <button class="manor-action" data-operation="sleep" bindtap="petAction" disabled="{{petCareBusy}}">回窝休息</button>
          <button wx:if="{{selectedPet.hasCleanableWaste}}" class="manor-action manor-pet-action-warn" bindtap="clearPetWaste" disabled="{{petCareBusy}}">清理便便</button>
        </view>
      </view>
      <block wx:if="{{!insideVilla && activeCharacter}}">
        <view wx:if="{{vehiclePanelOpen}}" class="manor-vehicle-panel" aria-label="选择 Copper GT 的座位">
          <view class="manor-vehicle-header">
            <view class="manor-vehicle-heading">
              <text class="manor-vehicle-name">Copper GT</text>
              <text class="manor-vehicle-caption">选择空座</text>
            </view>
            <button class="manor-action manor-vehicle-close" bindtap="closeVehiclePanel" aria-label="关闭选座">
              <text class="ri-close-line" aria-hidden="true"></text>
            </button>
          </view>
          <view class="manor-vehicle-front"><text>车头</text></view>
          <view class="manor-vehicle-seats">
            <button wx:for="{{vehicleSeats}}" wx:key="id" data-seat="{{item.id}}" bindtap="selectVehicleSeat"
              class="manor-action manor-vehicle-seat" disabled="{{item.occupied}}"
              aria-label="{{item.label + (index === 0 ? '，左门' : '，右门') + (item.occupied ? '，已占用' : '，可上车')}}">
              <text class="manor-vehicle-seat-name">{{item.label}}</text>
              <text class="manor-vehicle-seat-status">{{index === 0 ? '左门' : '右门'}} · {{item.occupied ? '已占用' : '空座'}}</text>
            </button>
          </view>
        </view>
        <view wx:elif="{{vehicleState === 'entering' || vehicleState === 'exiting'}}" class="manor-vehicle-progress" aria-live="polite">
          <view class="manor-vehicle-spinner" aria-hidden="true"></view>
          <text>{{vehicleStatus || (vehicleState === 'entering' ? '正在上车' : '正在下车')}}</text>
        </view>
        <view wx:elif="{{vehicleState === 'driver' || vehicleState === 'passenger'}}" class="manor-vehicle-console" aria-label="车辆控制">
          <view class="manor-vehicle-console-readout">
            <text class="manor-vehicle-seat-label">{{vehicleSeatLabel || (vehicleState === 'driver' ? '驾驶位' : '乘客位')}}</text>
            <view class="manor-vehicle-speed"><text>{{vehicleSpeed}}</text><text class="manor-vehicle-speed-unit">km/h</text></view>
          </view>
          <view class="manor-vehicle-console-actions">
            <button wx:if="{{vehicleState === 'driver'}}" class="manor-action manor-vehicle-brake" bindtap="brakeVehicle">刹车</button>
            <button class="manor-action manor-vehicle-exit" bindtap="exitVehicle" disabled="{{!vehicleCanExit}}">下车</button>
          </view>
          <text class="manor-vehicle-console-hint" wx:if="{{!vehicleCanExit}}">停车后可下车</text>
          <text class="manor-vehicle-console-hint" wx:elif="{{vehicleState === 'driver'}}">↑ 加速 ↓ 减速／倒车 ↔ 转向</text>
        </view>
      </block>
    </block>
  </block>
  <view wx:if="{{status === 'loading' || status === 'ready'}}" class="manor-top-controls">
    <block wx:if="{{status === 'ready' && !mapMode && !buildMode}}">
      <button class="manor-hud-button {{menuOpen ? 'manor-hud-active' : ''}}" bindtap="toggleMenu"
        aria-label="{{menuOpen ? '收起庄园设置' : '庄园设置'}}">
        <view class="manor-hud-face"><view class="manor-more-icon"></view></view>
      </button>
        <view wx:if="{{menuOpen}}" class="manor-menu" aria-label="庄园设置">
          <button wx:if="{{canBuildManor3d && !insideVilla && vehicleState === 'walking' && !vehiclePanelOpen}}" class="manor-menu-action" bindtap="openBuild">建造</button>
          <button wx:if="{{!insideVilla && vehicleState === 'walking' && !vehiclePanelOpen}}" class="manor-menu-action" bindtap="openMap">查看地图</button>
          <button wx:if="{{mapVehicle && !insideVilla && vehicleState === 'walking' && !vehiclePanelOpen}}" class="manor-menu-action" bindtap="focusVehicle">找车</button>
          <button wx:if="{{!insideVilla && villaStatus === 'ready' && vehicleState === 'walking' && !vehiclePanelOpen}}" class="manor-menu-action" bindtap="focusVilla">看别墅</button>
          <button wx:if="{{activeCharacter}}" class="manor-menu-action" bindtap="focusCharacter">回到角色</button>
          <view class="manor-sensitivity">
            <view class="manor-sensitivity-label"><text>旋转灵敏度</text><text>{{cameraSensitivity}}%</text></view>
            <slider class="manor-sensitivity-slider" min="25" max="150" step="5" value="{{cameraSensitivity}}"
              activeColor="#2f6a57" backgroundColor="#d9e4d7" block-color="#2f6a57" block-size="18"
              bindchanging="onCameraSensitivityChanging" bindchange="onCameraSensitivityChange" />
          </view>
          <view wx:if="{{vehicleState === 'walking' && !vehiclePanelOpen}}" class="manor-character-select" aria-label="选择角色">
            <button class="manor-character-option {{characterType === 'boy' ? 'manor-character-selected' : ''}}"
              data-character="boy" bindtap="selectCharacter">男孩</button>
            <button class="manor-character-option {{characterType === 'girl' ? 'manor-character-selected' : ''}}"
              data-character="girl" bindtap="selectCharacter">女孩</button>
          </view>
        </view>
      <button wx:if="{{activeCharacter && !restLocked}}" class="manor-hud-button manor-view-toggle {{firstPerson ? 'manor-hud-active' : ''}}" bindtap="toggleFirstPerson"
        aria-label="{{firstPerson ? '切换到第三人称' : '切换到第一人称'}}" aria-pressed="{{firstPerson}}">
        <view class="manor-hud-face"><text class="ri-eye-line" aria-hidden="true"></text><text>第一人称</text></view>
      </button>
    </block>
    <button class="manor-hud-button manor-exit-control {{mapMode || buildMode ? 'manor-map-back' : ''}}" bindtap="goBack" disabled="{{buildSaving}}"
      aria-label="{{buildMode ? '退出建造' : mapMode ? '退出地图预览，回到角色' : '退出 3D 庄园'}}">
      <view class="manor-hud-face"><view class="manor-back-arrow"></view><text wx:if="{{mapMode || buildMode}}">{{buildMode ? '退出建造' : '回到角色'}}</text></view>
    </button>
  </view>
</view>
