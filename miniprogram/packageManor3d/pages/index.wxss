.manor-pet-roster-item + .manor-pet-roster-item { border-top: 1px solid #e3ebe1; }
.manor-pet-roster-selected { background: #e5f0e4; }
.manor-pet-roster-main { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
.manor-pet-roster-name { font-size: 13px; font-weight: 800; }
.manor-pet-roster-meta { overflow: hidden; max-width: 154px; color: #667b70; font-size: 10px; text-overflow: ellipsis; white-space: nowrap; }
.manor-pet-roster-follow { color: #2f6a57; font-size: 10px; font-weight: 700; }
.manor-pet-panel {
  box-sizing: border-box;
  position: absolute;
  z-index: 3;
  left: 12px;
  left: calc(12px + env(safe-area-inset-left));
  bottom: 132px;
  bottom: calc(132px + env(safe-area-inset-bottom));
  width: 248px;
  max-width: calc(100% - 24px);
  padding: 10px;
  border: 1px solid rgba(255, 255, 255, .9);
  border-radius: 14px;
  background: rgba(250, 252, 245, .96);
  color: #244a3e;
  box-shadow: 0 6px 20px rgba(23, 53, 46, .25);
  pointer-events: auto;
}
.manor-pet-panel-heading { padding: 0 2px 8px; }
.manor-pet-panel-heading > view { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.manor-pet-panel-name { font-size: 16px; font-weight: 800; }
.manor-pet-panel-activity { overflow: hidden; max-width: 182px; color: #667b70; font-size: 11px; text-overflow: ellipsis; white-space: nowrap; }
.manor-pet-panel-close { width: 30px; min-width: 30px; height: 30px; min-height: 30px; padding: 0; border-radius: 50%; color: #536b5f; background: #e9f0e6; font-size: 19px; line-height: 1; }
.manor-pet-panel-close::after { border: 0; }
.manor-pet-needs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 8px; padding: 0 2px 9px; }
.manor-pet-need { min-width: 0; }
.manor-pet-need-label { color: #667b70; font-size: 10px; line-height: 1.2; }
.manor-pet-need-low .manor-pet-need-label { color: #a65335; font-weight: 700; }
.manor-pet-need-track { height: 4px; margin-top: 3px; overflow: hidden; border-radius: 3px; background: #dce8dc; }
.manor-pet-need-track > view { height: 100%; border-radius: inherit; background: #5c956c; }
.manor-pet-need-low .manor-pet-need-track > view { background: #c17849; }
.manor-pet-actions { display: flex; flex-wrap: wrap; gap: 5px; }
.manor-pet-actions .manor-action { min-height: 34px; padding: 0 8px; border-radius: 7px; font-size: 11px; }
.manor-pet-action-primary { color: #fff; background: #2f6a57; }
.manor-pet-action-warn { color: #7d432d; background: #f2dfcf; }
.manor-pet-notice { border-left: 3px solid #a36a42; }

@media (orientation: landscape) {
  .manor-pet-hud { top: 112px; top: calc(112px + env(safe-area-inset-top)); }
  .manor-pet-panel { bottom: 116px; bottom: calc(116px + env(safe-area-inset-bottom)); }
}

@media (orientation: landscape) {
  .manor-top-controls { top: 8px; top: calc(8px + env(safe-area-inset-top)); }
  .manor-joystick { left: 28px; left: calc(28px + env(safe-area-inset-left)); transform: none; }
  .manor-minimap { top: 54px; top: calc(54px + env(safe-area-inset-top)); }
  .manor-notices { top: 56px; top: calc(56px + env(safe-area-inset-top)); flex-direction: row; flex-wrap: wrap; }
  .manor-vehicle-panel, .manor-vehicle-progress {
    left: auto;
    right: 14px;
    right: calc(14px + env(safe-area-inset-right));
    bottom: 20px;
    bottom: calc(20px + env(safe-area-inset-bottom));
    transform: none;
  }
}
@media (max-height: 340px), (max-width: 350px) {
  .manor-joystick { width: 78px; height: 78px; }
  .manor-panel { padding: 16px; gap: 7px; }
  .manor-vehicle-console { width: 168px; }
}
@media (prefers-reduced-motion: reduce) {
  .manor-vehicle-spinner { animation: none; }
}
@media (max-height: 380px) and (orientation: landscape) {
  .manor-menu { width: 214px; flex-direction: row; flex-wrap: wrap; }
  .manor-character-select { width: 100%; }
  .manor-sensitivity { flex: 1 0 100%; }
  .manor-sensitivity-slider { margin: 4px 0 2px; }
  .manor-menu-action { flex: 1 0 43%; border: 0; }
  .manor-menu-action + .manor-menu-action { border: 0; }
}
