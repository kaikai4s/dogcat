/* miniprogram/components/dovlin-refresh/index.wxss */

:host {
  display: block;
  width: 100%;
  height: 100%;
}

.dovlin-scroll-view {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.dovlin-scroll-content {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
}

/* 下拉刷新区域容器 (高度精确匹配 threshold: 92px) */
.dovlin-refresher-container {
  width: 100%;
  height: 92px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #FFF9EB;
  overflow: hidden;
  box-sizing: border-box;
  padding: 4px 0;
}

/* 下拉刷新头容器 */
.dovlin-refresh-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  box-sizing: border-box;
}

.dovlin-refresh-header.is-slot-mode {
  padding: 6px 0;
}

/* 图标核心容器 (紧凑精致的 64px x 64px，绝不挤压或被顶部截断) */
.dovlin-avatar-box {
  width: 64px;
  height: 64px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  transform-origin: center center;
  will-change: transform;
}

/* 1. 圆环包装盒 (52px x 52px) */
.dovlin-ring-box {
  width: 52px;
  height: 52px;
  position: absolute;
  top: 6px;
  left: 6px;
  border-radius: 50%;
  pointer-events: none;
}

/* 虚线导轨参考 */
.dovlin-ring-track {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  box-sizing: border-box;
  border: 1.8px dashed rgba(247, 195, 70, 0.35);
  position: absolute;
  top: 0;
  left: 0;
}

/* 深绿色动态圆环填充 */
.dovlin-ring-fill {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 0;
  box-sizing: border-box;
  -webkit-mask: radial-gradient(transparent 23.5px, #000 24px);
  mask: radial-gradient(transparent 23.5px, #000 24px);
  transform: rotate(-90deg);
  transition: transform 0.08s linear;
}

/* 2. Dovlin 官方小狗图片 (52px x 52px) */
.dovlin-dog-img {
  width: 52px;
  height: 52px;
  position: absolute;
  top: 6px;
  left: 6px;
  display: block;
  z-index: 2;
  transform-origin: center center;
  will-change: transform;
}

/* 3. 围绕四周 360° 旋转的爪印层 (64px x 64px，中心点 32px 32px) */
.paws-orbit-layer {
  width: 64px;
  height: 64px;
  position: absolute;
  top: 0;
  left: 0;
  pointer-events: none;
  transform-origin: 32px 32px;
  z-index: 3;
  will-change: transform;
}

.paw-item {
  width: 10px;
  height: 10px;
  position: absolute;
  transform-origin: center center;
  opacity: 0;
  transform: scale(0);
  transition: opacity 0.22s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.paw-item.active {
  opacity: 1;
  transform: scale(1);
}

.paw-icon {
  width: 100%;
  height: 100%;
  display: block;
}

/* 状态提示文案 (紧凑小巧，字号 20rpx) */
.dovlin-status-text {
  margin-top: 3px;
  font-size: 20rpx;
  font-weight: 600;
  color: #145938;
  opacity: 0.85;
  letter-spacing: 0.5px;
}

/* ==================== 状态机动画定义 ==================== */

/* 加载状态：爪印围着图标持续 360° 无限奔跑旋转！ */
.state-loading .paws-orbit-layer {
  animation: pawsOrbitSpin 1.35s linear infinite !important;
}

.state-loading .dovlin-ring-fill {
  animation: ringSpin 1.1s linear infinite;
}

.state-loading .dovlin-dog-img {
  animation: dogWiggle 1.2s ease-in-out infinite alternate;
}

.state-loading .paw-item {
  opacity: 1;
  transform: scale(1);
  animation: pawTwinkle 1.3s ease-in-out infinite var(--delay);
}

/* 完成状态：小狗开心点头收起 */
.state-success .dovlin-ring-fill {
  background: conic-gradient(#145938 360deg, transparent 0deg) !important;
  transition: none;
}

.state-success .dovlin-dog-img {
  animation: dogHappyNod 0.65s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.state-success .dovlin-avatar-box {
  animation: successRetract 0.5s 0.25s cubic-bezier(0.4, 0, 0.2, 1) forwards;
}

/* ==================== 关键帧动画 ==================== */
@keyframes pawsOrbitSpin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes ringSpin {
  0% {
    transform: rotate(-90deg);
  }
  100% {
    transform: rotate(270deg);
  }
}

@keyframes dogWiggle {
  0% {
    transform: rotate(-2deg);
  }
  50% {
    transform: translateY(-1.5px) rotate(2.5deg);
  }
  100% {
    transform: rotate(-2deg);
  }
}

@keyframes pawTwinkle {
  0%, 100% {
    transform: scale(1);
    opacity: 0.85;
  }
  50% {
    transform: scale(1.15);
    opacity: 1;
  }
}

@keyframes dogHappyNod {
  0% {
    transform: scale(1);
  }
  30% {
    transform: scale(1.08) rotate(-3deg);
  }
  60% {
    transform: scale(0.95) rotate(4deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
  }
}

@keyframes successRetract {
  0% {
    transform: scale(1);
    opacity: 1;
  }
  60% {
    transform: scale(1.08);
    opacity: 1;
  }
  100% {
    transform: scale(0.7) translateY(-10px);
    opacity: 0;
  }
}
