.role-bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: grid;
  grid-auto-flow: column;
  grid-auto-columns: minmax(0, 1fr);
  gap: 8rpx;
  padding: 14rpx 12rpx calc(14rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(255, 153, 102, 0.14);
  box-shadow: 0 -10rpx 36rpx rgba(123, 89, 62, 0.12);
  backdrop-filter: blur(16rpx);
  box-sizing: border-box;
  pointer-events: auto;
}

.role-bottom-nav .nav-item {
  min-width: 0;
  min-height: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  text-align: center;
  color: #8e8580;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.role-bottom-nav .nav-item.active {
  color: #e9672f;
  font-weight: 900;
}

.role-bottom-nav .nav-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: currentColor;
  font-size: 42rpx;
  line-height: 1;
}

.role-bottom-nav .nav-item:active {
  transform: scale(0.96);
  opacity: 0.85;
}
