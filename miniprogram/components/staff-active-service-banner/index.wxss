.active-service-banner {
  margin: 18rpx 28rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
  border: 1rpx solid rgba(255, 122, 69, 0.18);
  box-shadow: 0 10rpx 26rpx rgba(255, 122, 69, 0.12);
  box-sizing: border-box;
}

.banner-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb86c 0%, #ff7a45 100%);
  font-size: 30rpx;
}

.banner-content {
  flex: 1;
  min-width: 0;
}

.banner-title {
  color: #2d211a;
  font-size: 25rpx;
  font-weight: 950;
  line-height: 1.25;
}

.banner-desc {
  margin-top: 4rpx;
  color: #dc2626;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.35;
}

.banner-action {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  background: #ff7a45;
  font-size: 22rpx;
  font-weight: 900;
}
