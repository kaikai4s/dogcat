:host { display: block; min-width: 0; }

.notice-marquee {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  height: 68rpx;
  box-sizing: border-box;
  padding: 0 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(72, 100, 84, .15);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, .94);
  box-shadow: 0 5rpx 16rpx rgba(73, 70, 58, .05);
  color: #35463c;
}

.notice-icon {
  display: flex;
  flex: 0 0 38rpx;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 8rpx;
  background: #e6f2ec;
  color: #30745d;
  font-size: 25rpx;
}

.notice-icon text { font-family: "remixicon" !important; line-height: 1; }
.notice-label { flex: none; margin-left: 10rpx; font-size: 23rpx; font-weight: 600; }
.notice-divider { flex: 0 0 1rpx; height: 24rpx; margin: 0 16rpx; background: #dedfd5; }
.notice-window { flex: 1; min-width: 0; height: 100%; overflow: hidden; }
.notice-track { display: inline-flex; align-items: center; height: 100%; white-space: nowrap; animation: notice-scroll 12s linear infinite; }
.notice-group { display: flex; flex: none; align-items: center; height: 100%; }
.notice-item { display: block; flex: none; margin-right: 48rpx; font-size: 25rpx; line-height: 68rpx; white-space: nowrap; }

.notice-marquee.theme-night { border-color: rgba(147, 177, 159, .27); background: rgba(36, 43, 43, .96); color: #eff5ef; }
.theme-night .notice-icon { background: #344d41; color: #a7d8b4; }
.theme-night .notice-divider { background: #58635b; }

@keyframes notice-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
