.households{margin:24rpx 0;padding:26rpx;border:1rpx solid #eedbc9;border-radius:28rpx;background:#fffcf7;color:#3b3027;box-sizing:border-box}.roster-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;font-size:29rpx;font-weight:700}.roster-count{flex-shrink:0;white-space:nowrap;font-size:23rpx;color:#9d623a}.household-scroll{width:100%;margin:22rpx 0}.household-tabs{display:flex;gap:12rpx;white-space:nowrap;padding-bottom:6rpx}.household-tab{flex-shrink:0;max-width:340rpx;box-sizing:border-box;padding:16rpx 20rpx;border:2rpx solid #efdfd1;border-radius:18rpx;background:#fff}.household-tab.active{border-color:#dc8754;background:#fff0df}.tab-household,.tab-pets{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.tab-household{font-size:24rpx;font-weight:700}.tab-pets{margin-top:6rpx;font-size:22rpx;color:#8b7565}.household-owner{display:flex;align-items:center;gap:12rpx;font-size:26rpx;font-weight:600;flex-wrap:wrap}.household-owner image{width:48rpx;height:48rpx;border-radius:50%;flex-shrink:0}.done{font-size:21rpx;color:#3c805d}.household-service{font-size:23rpx;line-height:1.6;color:#8b7565;margin:12rpx 0}.household-pet{display:flex;align-items:flex-start;gap:18rpx;padding:20rpx 0;border-top:1rpx solid #f0e6dc}.pet-avatar,.pet-placeholder{width:104rpx;height:104rpx;border-radius:20rpx;flex-shrink:0}.pet-placeholder{display:flex;align-items:center;justify-content:center;background:#f7eadb;font-size:44rpx}.pet-copy{flex:1;min-width:0}.pet-name{font-size:28rpx;font-weight:700;word-break:break-all}.pet-meta,.pet-note{font-size:23rpx;color:#8b7565;line-height:1.6;margin-top:5rpx;word-break:break-all}.open-household{margin:16rpx 0 0;padding:0 16rpx;line-height:74rpx;border-radius:18rpx;font-size:25rpx;font-weight:600;color:#a45b2c;background:#ffecd8}.open-household::after{border:0}
