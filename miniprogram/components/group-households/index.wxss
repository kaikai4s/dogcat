.refund-status{font-size:21rpx}.refund-status.refunded{color:#3c805d}.refund-status.refunding{color:#b45309}.refund-status.partial{color:#9a3412}
/* Component styles are isolated: never depend on the parent page for sizing. */
:host { display: block; }
.households { box-sizing: border-box; margin: 24rpx 0; padding: 26rpx; border: 1rpx solid #efe4d5; border-radius: 28rpx; background: #fffdf8; color: #47382c; }
.roster-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 28rpx; font-weight: 700; }
.roster-count { flex-shrink: 0; padding: 7rpx 16rpx; border-radius: 20rpx; background: #f9eddd; color: #a46a38; font-size: 22rpx; font-weight: 400; }
.household-scroll { margin-top: 22rpx; width: 100%; white-space: nowrap; }
.household-tabs { display: inline-flex; gap: 14rpx; padding-bottom: 8rpx; }
.household-tab { display: flex; flex-direction: column; box-sizing: border-box; width: 270rpx; padding: 18rpx 20rpx; border: 2rpx solid #f0e8dd; border-radius: 20rpx; background: #faf7f1; }
.household-tab.active { background: #fff1df; border-color: #eab67c; }
.tab-household, .tab-pets { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tab-household { font-size: 24rpx; font-weight: 600; }
.tab-pets { margin-top: 8rpx; color: #97806a; font-size: 22rpx; }
.household-detail { margin-top: 20rpx; padding-top: 22rpx; border-top: 1rpx solid #f0e7dc; }
.household-owner { display: flex; align-items: center; flex-wrap: wrap; gap: 12rpx; font-size: 25rpx; font-weight: 600; }
.household-owner image { width: 56rpx; height: 56rpx; flex: 0 0 56rpx; border-radius: 50%; background: #f2e9de; }
.household-owner .done { color: #478264; font-size: 21rpx; padding: 5rpx 12rpx; border-radius: 10rpx; background: #eaf5ed; }
.household-service { margin: 14rpx 0 18rpx; color: #9b7a5d; font-size: 23rpx; line-height: 1.6; }
.household-pet { display: flex; align-items: flex-start; gap: 20rpx; padding: 20rpx; margin-top: 14rpx; border-radius: 20rpx; background: #faf6ef; }
.household-pet .pet-avatar, .pet-placeholder { width: 112rpx; height: 112rpx; flex: 0 0 112rpx; border-radius: 18rpx; background: #efe5d7; }
.pet-placeholder { display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.pet-copy { flex: 1; min-width: 0; }
.pet-name { font-size: 27rpx; font-weight: 700; overflow-wrap: anywhere; line-height: 1.5; }
.pet-meta, .pet-note { margin-top: 7rpx; font-size: 22rpx; line-height: 1.65; color: #8a7664; overflow-wrap: anywhere; }
.open-household { margin: 24rpx 0 0; width: 100%; padding: 20rpx 16rpx; font-size: 25rpx; line-height: 1.5; color: #a46a38; background: #ffedda; border-radius: 18rpx; }
.open-household::after { border: 0; }
