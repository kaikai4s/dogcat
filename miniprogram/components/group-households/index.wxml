<view class="households" wx:if="{{bundle && bundle.members.length}}">
  <view class="roster-heading"><text>拼单住户与宠物</text><text class="roster-count">共 {{bundle.members.length}} 户</text></view>
  <scroll-view scroll-x class="household-scroll" enhanced show-scrollbar="{{false}}">
    <view class="household-tabs">
      <view wx:for="{{bundle.members}}" wx:key="orderId" class="household-tab {{selectedId === item.orderId ? 'active' : ''}}" data-id="{{item.orderId}}" bindtap="select">
        <text class="tab-household">{{item.householdLabel}} · {{item.clientName}}</text>
        <text class="tab-pets">{{item.petName}}</text>
      </view>
    </view>
  </scroll-view>
  <view class="household-detail" wx:if="{{selected}}">
    <view class="household-owner"><image wx:if="{{selected.clientAvatar}}" src="{{selected.clientAvatar}}" mode="aspectFill"/><text>{{selected.householdLabel}} · {{selected.clientName}}</text><text wx:if="{{selected.isCompleted}}" class="done">已完成</text></view>
    <view class="household-service">{{selected.serviceSummary || selected.serviceType}}</view>
    <view class="household-pet" wx:for="{{selected.petSnapshots}}" wx:for-item="pet" wx:key="name">
      <image wx:if="{{pet.avatarFileId}}" class="pet-avatar" src="{{pet.avatarFileId}}" mode="aspectFill" data-url="{{pet.avatarFileId}}" bindtap="preview"/>
      <view wx:else class="pet-placeholder">🐾</view>
      <view class="pet-copy"><view class="pet-name">{{pet.name}}</view><view class="pet-meta">{{pet.species === 'cat' ? '猫咪' : pet.species === 'dog' ? '狗狗' : '宠物'}}{{pet.breed ? ' · ' + pet.breed : ''}}{{pet.weight ? ' · ' + pet.weight + 'kg' : ''}}</view>
        <view class="pet-note" wx:if="{{pet.personality}}">性格：{{pet.personality}}</view>
        <view class="pet-note" wx:if="{{pet.specialNotes}}">照护：{{pet.specialNotes}}</view>
        <view class="pet-note" wx:if="{{pet.healthNotes}}">健康：{{pet.healthNotes}}</view>
      </view>
    </view>
    <view class="pet-note" wx:if="{{!selected.petSnapshots.length}}">服务宠物：{{selected.petName}}</view>
    <button wx:if="{{allowSwitch && selected.orderId !== currentId && selected.status !== 'cancelled' && selected.status !== 'refunded'}}" class="open-household" bindtap="open">切换到此住户服务</button>
  </view>
</view>
