page{background:#f3f3eb;color:#34483b}.memory-page{padding:28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));max-width:960rpx;margin:auto;box-sizing:border-box}.hero{text-align:center;padding:36rpx 24rpx 48rpx}.hero-mark{font-size:54rpx;color:#a48b54;margin-bottom:18rpx}.eyebrow,.section-kicker{font-size:20rpx;letter-spacing:4rpx;color:#89917b}.title{font-size:62rpx;margin:20rpx 0;font-weight:600;overflow-wrap:anywhere}.date,.tip{font-size:24rpx;line-height:1.8;color:#7b8476}.epitaph{font-size:29rpx;line-height:1.9;margin:26rpx auto 0;max-width:630rpx;white-space:pre-wrap;overflow-wrap:anywhere}.card,.owner-bar{padding:32rpx;background:#fffef8;border:1rpx solid #e4e7d9;border-radius:28rpx;margin-bottom:24rpx;box-shadow:0 8rpx 30rpx #34492b05}.owner-bar{background:#e8eddf}.owner-heading{display:flex;gap:14rpx;align-items:center;justify-content:space-between;flex-wrap:wrap;font-size:29rpx;font-weight:600}.status-tag,.count-tag{font-size:21rpx;color:#617457;background:#f7f9ee;padding:7rpx 14rpx;border-radius:30rpx;font-weight:400}.status-line{font-size:25rpx;color:#5e7555;margin:22rpx 0 8rpx}.actions{display:flex;align-items:stretch;gap:14rpx;margin-top:20rpx;flex-wrap:wrap}.actions .memory-button{flex:1;min-width:220rpx;margin:0}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.section-title{font-size:31rpx;font-weight:600;line-height:1.6;margin:14rpx 0 22rpx}.word-count{flex:none;font-size:22rpx;color:#87917d}.story-text{white-space:pre-wrap;overflow-wrap:anywhere;line-height:2;font-size:29rpx}.photos{display:flex;gap:12rpx;flex-wrap:wrap;margin:22rpx 0}.memory-photo{width:186rpx;height:186rpx;border-radius:18rpx}.photo-item{width:186rpx}.memory-video{display:block;width:100%;border-radius:18rpx;margin:16rpx 0}.editor-section{margin-top:36rpx;padding-top:32rpx;border-top:1rpx solid #e7ebdf}.memory-button{display:flex;align-items:center;justify-content:center;box-sizing:border-box;width:100%;min-height:88rpx;padding:20rpx 26rpx;margin:18rpx 0 0;border:1rpx solid transparent;border-radius:18rpx;font-size:26rpx;font-weight:500;line-height:1.6;text-align:center;white-space:normal;box-shadow:none}.memory-button::after{border:0}.button-primary{background:#506d4e;color:#fffdf3;box-shadow:0 6rpx 16rpx #314b2712}.button-secondary{background:#f8faef;color:#46623f;border-color:#cbd8c0}.button-upload{display:flex;flex-wrap:wrap;gap:4rpx 10rpx;background:#f3f6ec;color:#526e49;border:2rpx dashed #c9d6bc;padding:24rpx;min-height:108rpx}.upload-plus{font-size:34rpx;line-height:1}.button-caption{width:100%;font-size:22rpx;font-weight:400;color:#89947d}.button-remove{background:#f4ece4;color:#97785f;min-height:64rpx;padding:10rpx 18rpx;font-size:23rpx}.button-quiet{color:#71816a;background:transparent;min-height:72rpx}.button-save{min-height:98rpx;font-size:28rpx}.memory-button[disabled]{opacity:.5;background:#e5e9de;color:#929c89;box-shadow:none}.story-editor{width:100%;height:430rpx;background:#f5f6ef;padding:24rpx;box-sizing:border-box;font-size:28rpx;line-height:1.9;border:1rpx solid #e4e9dc;border-radius:18rpx}.privacy{display:flex;gap:18rpx;padding:26rpx;margin:36rpx 0 24rpx;background:#f0f4e8;border-radius:20rpx;align-items:center}.privacy-copy{flex:1;min-width:0}.privacy-title{font-size:27rpx;margin-bottom:8rpx}.memory-empty{padding:70rpx 24rpx;text-align:center;line-height:1.8;font-size:28rpx}.music-panel{padding:24rpx;background:#f5f6ed;border-radius:18rpx;margin:20rpx 0}.music-name{font-size:26rpx;overflow-wrap:anywhere}.music-play{margin-top:28rpx}.review-note{font-size:25rpx;color:#997b5e;padding:18rpx 0 0;line-height:1.8;white-space:pre-wrap}.upload-progress{padding:18rpx;background:#edf3e3;color:#5b7549;border-radius:14rpx;font-size:24rpx}.reference-grid{display:flex;gap:18rpx;margin-top:26rpx}.reference-item{flex:1;min-width:0}.reference-image,.reference-placeholder{width:100%;height:240rpx;border-radius:16rpx;background:#f0f3e7}.reference-placeholder{display:flex;align-items:center;jus