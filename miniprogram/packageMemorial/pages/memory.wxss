.memory-empty{margin:24rpx 0;background:#fffef8;border:1rpx solid #e4e7d9;border-radius:28rpx;padding:74rpx 32rpx;color:#68755f}.memory-loading-mark{display:flex;align-items:center;justify-content:center;width:144rpx;height:144rpx;border-radius:50%;background:#edf2e5;color:#849875;margin:0 auto 30rpx}.memory-loading-mark .remix-icon{font-size:68rpx}

/* Keep native WeChat button defaults from stretching the two photo columns. */
.memory-page .reference-grid{display:flex;align-items:stretch;gap:20rpx}
.memory-page .reference-item{box-sizing:border-box;flex:1 1 0;width:0;min-width:0;padding:16rpx;background:#f6f7ef;border:1rpx solid #e0e6d7;border-radius:20rpx;overflow:hidden}
.reference-title{font-size:25rpx;font-weight:600;color:#536b4b;margin-bottom:14rpx}
.memory-page .reference-image,.memory-page .reference-placeholder{display:flex;width:100%;height:220rpx;border-radius:12rpx;box-sizing:border-box}
.memory-page .reference-placeholder{flex-direction:column;gap:16rpx;font-size:22rpx;color:#7b8b70;background:#eaf0e0}
.reference-placeholder .remix-icon{font-size:48rpx;color:#9bab8d}
.memory-page .reference-item .reference-upload{display:flex;box-sizing:border-box;width:100%;min-width:0;max-width:100%;height:auto;min-height:44px;margin:16rpx 0 0;padding:16rpx 4rpx;border-radius:12rpx;font-size:25rpx;line-height:1.5;white-space:normal;word-break:keep-all}
.memory-page .entrance-toggle{padding:12rpx 4rpx;min-height:72rpx;border:1rpx solid #cbd8c0;background:#f4f7ec;color:#617457;font-size:23rpx;margin-top:10rpx}
.memory-page .entrance-selected{background:#e0ebd5;border-color:#96af83;color:#3f6039}

/* Native button:not([size='mini']) has its own width. Constrain every button
   to its card and keep photo actions within the two responsive columns. */
.memory-page button.memory-button{box-sizing:border-box;width:100%;min-width:0;max-width:100%;height:auto}
.memory-page .editor-photos{display:flex;align-items:stretch;flex-wrap:wrap;gap:20rpx;margin:24rpx 0}
.memory-page .editor-photos .photo-item{box-sizing:border-box;flex:0 0 calc((100% - 20rpx)/2);width:calc((100% - 20rpx)/2);min-width:0;max-width:100%;padding:12rpx;border:1rpx solid #e1e7d7;border-radius:22rpx;background:#f7f8f0;overflow:hidden}
.memory-page .editor-photos .memory-photo{display:block;width:100%;height:232rpx;border-radius:14rpx}
.photo-actions{display:flex;flex-direction:column;gap:10rpx;padding-top:12rpx}
.memory-page .photo-actions .memory-button{margin:0;min-height:44px;padding:12rpx 4rpx;border-radius:12rpx;font-size:24rpx;line-height:1.5;white-space:normal;overflow-wrap:anywhere}
.memory-page .photo-actions .button-remove{background:transparent;color:#94795f;border-color:#e5dfd2}
.memory-page .video-item{box-sizing:border-box;min-width:0;margin:24rpx 0;padding:14rpx;background:#f7f8f0;border:1rpx solid #e1e7d7;border-radius:22rpx;overflow:hidden}
.memory-page .video-item .memory-video{margin:0 0 14rpx}
.video-actions{display:flex;align-items:stretch;gap:12rpx}
.memory-page .video-actions .memory-button{flex:1 1 0;width:0;min-width:0;margin:0;min-height:44px;padding:12rpx 8rpx;line-height:1.5;font-size:24rpx}
.media-help{padding:22rpx;background:#f1f5e8;border-radius:16rpx;margin:0 0 20rpx}
.media-help-title{font-size:25rpx;font-weight:500;color:#617653;margin-bottom:8rpx}
.media-save-error{padding:18rpx;background:#f8eee6;color:#976746;border-radius:14rpx;font-size:24rpx;line-height:1.7;overflow-wrap:anywhere}
.autosave-note{font-size:23rpx;color:#7b8871;line-height:1.8;margin:24rpx 0 8rpx}

.portrait-pose-label{font-size:26rpx;color:#516650;margin:26rpx 0 16rpx}.portrait-pose-options{display:flex;gap:16rpx;margin-bottom:28rpx}.memory-page .portrait-pose{flex:1;min-width:0;min-height:92px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8rpx;padding:20rpx 8rpx;border:2rpx solid #dce4d5;background:#f7f8f1;color:#65715e;line-height:1.5;white-space:normal}.memory-page .portrait-pose.selected{border-color:#668360;background:#e8f0df;color:#3f633e;box-shadow:inset 0 0 0 1rpx #668360}.pose-title{font-size:28rpx;font-weight:600}.pose-caption{font-size:22rpx;font-weight:400}
