page{background:#f4f3e9;color:#344c3c}.entrance-page{padding:64rpx 36rpx 90rpx}.eyebrow{font-size:22rpx;letter-spacing:5rpx;color:#788772}.title{font-size:44rpx;font-weight:600;line-height:1.5;margin:20rpx 0}.description{font-size:27rpx;line-height:1.8;color:#72816c;margin-bottom:42rpx}.garden-card{background:#fffef8;border:1rpx solid #dfe4d5;border-radius:30rpx;padding:32rpx;margin-bottom:24rpx;box-shadow:0 12rpx 32rpx #3b553509}.garden-mark{font-size:48rpx;color:#9caa7b;float:right}.garden-name{font-size:34rpx;font-weight:600;margin:8rpx 0 14rpx}.garden-status{font-size:24rpx;color:#7a8875}.garden-card button{margin-top:28rpx;background:#526e56;color:#fff;border-radius:18rpx;font-size:28rpx;line-height:86rpx}.garden-card button[disabled]{background:#e4e8dc;color:#929e8d}button::after{border:0}.hint{color:#76836e;text-align:center;font-size:26rpx;padding:24rpx}.more{background:transparent;color:#526e56;font-size:26rpx}

.entrance-page{box-sizing:border-box;max-width:560px;margin:auto;padding-bottom:calc(60rpx + env(safe-area-inset-bottom))}
.entrance-page button{box-sizing:border-box;width:100%;min-height:44px;height:auto;padding:12px 16px;line-height:1.5;white-space:normal;overflow-wrap:anywhere}
.garden-card{position:relative}.garden-name{padding-right:42rpx;overflow-wrap:anywhere}.garden-mark{position:absolute;right:32rpx;top:32rpx;float:none}
.description,.garden-status,.hint{color:#64735f}.recycle-entry{margin-top:40rpx;padding-top:30rpx;border-top:1rpx solid #d6decd;font-size:28rpx}.recycle-entry .description{font-size:24rpx;margin:12rpx 0}.recycle-entry .more{border:1rpx solid #cdd8c4;background:#f9fbf2;border-radius:18rpx}.hint button{margin-top:16rpx;background:#e8eddf;color:#46603f;border-radius:16rpx}
