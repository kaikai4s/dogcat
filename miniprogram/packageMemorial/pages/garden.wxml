<view class="garden-page" catchtouchmove="stopBubble">
  <canvas id="gardenCanvas" type="2d" class="garden-canvas" catchtouchstart="mapTouchStart" catchtouchmove="mapTouchMove" catchtouchend="mapTouchEnd" catchtouchcancel="cancelMapGesture"></canvas>
  <view class="garden-header">
    <view class="garden-heading"><view class="eyebrow">留住爱 · 慢慢走</view><view class="garden-title">{{overview ? '纪念园大地图' : '思念在这里生长'}}</view></view>
    <button class="settings-button" bindtap="toggleSettings">设置 ⚙</button>
  </view>
  <view class="map-help" wx:if="{{overview}}">{{selectingPlot ? '点击草坪空位申请建碑 · 绿色为空位' : '蓝点是你的位置 · 点击地图选择目的地'}}</view>
  <view class="nav-banner" wx:elif="{{navigation.active || navigation.arrived}}"><text>{{navigation.arrived ? '已到达：' : '跟随箭头：'}}{{navigation.name}}</text><button bindtap="cancelNavigation">结束</button></view>
  <button class="audio-note" wx:if="{{audioError && !loading}}" bindtap="retryAudio">{{audioError}}</button>
  <button class="stream-note" wx:if="{{streamError && !loading && !overview}}" bindtap="retryChunks">附近场景加载失败 · 重试</button>
  <view class="stream-note" wx:elif="{{streaming && !loading && !overview}}">正在加载附近场景…</view>
  <view class="zoom-controls" wx:if="{{!loading && !error && !overview}}"><button bindtap="zoom" data-delta="0.3">＋</button><button bindtap="zoom" data-delta="-0.3">−</button></view>
  <view class="walk-controls {{overview ? 'controls-hidden' : ''}}">
    <view class="joystick" id="joystick" catchtouchstart="joystickStart" catchtouchmove="joystickMove" catchtouchend="joystickEnd" catchtouchcancel="joystickEnd"><view class="compass north">↑</view><view class="compass south">↓</view><view class="compass west">←</view><view class="compass east">→</view><view class="joystick-knob" style="transform: translate({{stickX}}px, {{stickY}}px)"><view></view></view></view>
    <view class="walk-hint">摇杆行走 · 双指缩放</view>
  </view>
  <view class="garden-actions" wx:if="{{!selection}}">
    <button wx:if="{{!following && !overview}}" class="scene-button" bindtap="followPlayer">跟随人物 ⊙</button>
    <button class="scene-button" bindtap="toggleOverview" disabled="{{loading || error}}">{{overview ? '返回散步' : '大地图'}} ↗</button>
    <button class="scene-button" bindtap="choosePlot" disabled="{{loading || error}}">申请建碑</button>
  </view>
  <view class="map-selection" wx:if="{{overview && selection}}"><view class="selection-title">{{selection.name}}</view><view class="panel-tip" wx:if="{{selection.epitaph}}">{{selection.date}} · {{selection.epitaph}}</view><view class="selection-actions"><button bindtap="clearSelection">取消</button><button bindtap="startNavigation">追踪到这里 →</button><button wx:if="{{selection.plotId}}" bindtap="openApplication">申请此墓位</button></view></view>
  <view class="map-error" wx:if="{{selectingPlot && applicationError}}">{{applicationError}}<button bindtap="refreshMemorials">刷新墓位</button></view>
  <view class="load-mask" wx:if="{{loading || error}}"><view class="load-card"><view class="load-symbol">✦</view><view class="load-title">{{error ? '暂时未能进入园区' : '正在走进纪念园'}}</view><view class="load-description">{{error || '阳光、草木和思念，都在这里。'}}</view><button wx:if="{{error}}" bindtap="retry">重新加载</button></view></view>
  <view class="panel-mask" wx:if="{{settingsOpen}}" bindtap="toggleSettings"><scroll-view scroll-y class="settings-panel" catchtap="stopBubble"><view class="panel-title">园区设置<button bindtap="toggleSettings">关闭</button></view><view class="setting-row"><text>角色</text><view class="avatar-switch"><button class="{{gender === 'boy' ? 'selected' : ''}}" data-gender="boy" bindtap="chooseGender" disabled="{{changing || loading}}">男生</button><button class="{{gender === 'girl' ? 'selected' : ''}}" data-gender="girl" bindtap="chooseGender" disabled="{{changing || loading}}">女生</button></view></view><view class="setting-row"><text>背景音乐</text><switch checked="{{music}}" data-setting="music" bindchange="toggleSound" color="#516d51" /></view><view class="setting-row"><text>脚步与提示音</text><switch checked="{{effects}}" data-setting="effects" bindchange="toggleSound" color="#516d51" /></view><view class="panel-tip">声音选择自动保存，下次进入沿用。</view><button wx:if="{{audioError}}" bindtap="retryAudio">重试声音</button><button bindtap="showApplications">我的建碑申请 ›</button><button bindtap="resetPosition">回到入口</button></scroll-view></view>
  <view class="panel-mask" wx:if="{{form || applications}}"><view class="application-panel"><view class="panel-title">{{form ? '申请建立纪念碑' : '我的建碑申请'}}<button bindtap="closeApplication" disabled="{{submitting}}">关闭</button></view><scroll-view scroll-y class="panel-scroll"><block wx:if="{{form}}"><view class="panel-tip">{{form.lawn}} · 审核通过后公开展示名字、日期与寄语</view><view class="field-label">宠物名字</view><input maxlength="20" value="{{form.petName}}" data-field="petName" bindinput="inputApplication" disabled="{{submitting}}" placeholder="请输入宠物名字" /><view class="field-label">纪念日期</view><picker mode="date" value="{{form.date}}" data-field="date" bindchange="inputApplication" disabled="{{submitting}}"><view class="date-field">{{form.date || '请选择日期'}}</view></picker><view class="field-label">想对它说的话</view><textarea maxlength="120" value="{{form.epitaph}}" data-field="epitaph" bindinput="inputApplication" disabled="{{submitting}}" placeholder="留下一段寄语（120字以内）" /><button class="submit-button" bindtap="submitApplication" loading="{{submitting}}" disabled="{{submitting}}">提交申请</button></block><block wx:else><view class="application-record" wx:for="{{applications}}" wx:key="_id"><view>{{item.petName}} · {{item.statusText}}</view><view class="panel-tip">{{item.lawn}} · {{item.date}}</view><view class="panel-tip" wx:if="{{item.reason}}">审核意见：{{item.reason}}</view><button wx:if="{{item.status === 'approved'}}" data-plot="{{item.plotId}}" bindtap="visitMemorial">追踪纪念碑 →</button></view><view class="panel-tip" wx:if="{{!applications.length && !recordsLoading && !recordsError}}">暂无申请，先在大地图选择一个空位。</view><view wx:if="{{recordsError}}">{{recordsError}}</view><button bindtap="showApplications" loading="{{recordsLoading}}" disabled="{{recordsLoading}}">刷新申请</button><button wx:if="{{recordsMore}}" data-more="true" bindtap="showApplications" disabled="{{recordsLoading}}">加载更多</button></block></scroll-view></view></view>
</view>
