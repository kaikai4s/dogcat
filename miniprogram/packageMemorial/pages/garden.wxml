<view class="garden-page" style="--hud-top:{{hudTop}}px; --hud-left:{{hudLeft}}px; --hud-right:{{hudRight}}px" catchtouchmove="stopBubble" bindtouchstart="unlockAudio">
  <canvas id="gardenCanvas" type="2d" class="garden-canvas" catchtouchstart="mapTouchStart" catchtouchmove="mapTouchMove" catchtouchend="mapTouchEnd" catchtouchcancel="cancelMapGesture"></canvas>
  <view class="garden-header {{loading || error ? 'header-loading' : ''}}">
    <button class="back-button" bindtap="leaveGarden">{{overview ? '‹ 返回散步' : '‹ 离开园区'}}</button><view class="garden-title">{{move ? '为小筑选择新位置' : selectingPlot ? '为爱留一处时光' : gardenName}}</view>
    <button class="settings-button" bindtap="toggleSettings" disabled="{{loading || error || offeringBusy}}">设置 ⚙</button>
  </view>
  <view class="environment-note" wx:if="{{!loading && !error && !overview && !(navigation && (navigation.active || navigation.arrived))}}">{{environmentLabel}}</view>
  <view class="presence-note" wx:if="{{!loading && !error && !overview && !(navigation && (navigation.active || navigation.arrived))}}">{{presenceMessage || (visitorCount + ' 位访客在园中')}}</view>
  <view class="move-banner" wx:if="{{(move || moveLoading || moveError) && !form && !settingsOpen && !applications && !memorialCard && !gardenListOpen}}"><view>{{moveLoading ? '正在读取小筑资料…' : moveError || ((restoring ? '恢复：' : '迁移：') + move.petName + ' · ' + gardenName)}}</view><view class="move-actions"><button wx:if="{{moveError}}" bindtap="loadMove">重试</button><button bindtap="changeMoveGarden" disabled="{{submitting}}">换个纪念园</button><button bindtap="cancelMove" disabled="{{submitting}}">{{restoring ? '取消恢复' : '取消迁移'}}</button></view></view>
  <view class="map-help" wx:if="{{overview}}">{{selectingPlot ? '拖动 / 双指缩放 · 点击绿色编号选择位置' : '蓝点是你的位置 · 点击地图选择目的地'}}</view>
  <view class="plot-legend" wx:if="{{selectingPlot && !move}}"><text class="legend-free">● 可申请</text><text class="legend-taken">● 已占用</text><text class="legend-selected">● 已选择</text><text wx:if="{{worldLoading}}">更新位置中…</text></view>
  <view class="nav-banner" wx:if="{{!overview && (navigation.active || navigation.arrived)}}"><text>{{navigation.arrived ? '已到达：' : '跟随箭头：'}}{{navigation.name}}</text><button bindtap="cancelNavigation">结束</button></view>
  <view class="audio-note" wx:if="{{audioError && !audioDismissed && !loading && !settingsOpen && !form && !applications && !memorialCard}}"><button bindtap="retryAudio">{{audioError}}</button><button class="audio-dismiss" bindtap="dismissAudio" aria-label="关闭声音提示">×</button></view>
  <button class="stream-note" wx:if="{{streamError && !loading && !overview}}" bindtap="retryChunks">附近场景加载失败 · 重试</button>
  <view class="stream-note" wx:elif="{{streaming && !loading && !overview}}">正在加载附近场景…</view>
  <view class="zoom-controls" wx:if="{{!loading && !error}}"><button bindtap="zoom" data-delta="0.3">＋</button><button bindtap="zoom" data-delta="-0.3">−</button></view>
  <view class="offering-progress" wx:if="{{offeringBusy}}"><view class="offering-progress-symbol">✿</view><text>{{offeringMessage}}</text><button wx:if="{{offeringStage === 'approach'}}" bindtap="cancelOffering">结束前往</button></view>
  <view class="walk-controls {{offeringBusy ? 'controls-hidden' : ''}} {{overview ? 'controls-hidden' : ''}}">
    <view class="joystick" id="joystick" catchtouchstart="joystickStart" catchtouchmove="joystickMove" catchtouchend="joystickEnd" catchtouchcancel="joystickEnd"><view class="compass north">↑</view><view class="compass south">↓</view><view class="compass west">←</view><view class="compass east">→</view><view class="joystick-knob" style="transform: translate({{stickX}}px, {{stickY}}px)"><view></view></view></view>
    <view class="walk-hint">摇杆行走 · 双指缩放</view>
  </view>
  <view class="garden-actions" wx:if="{{!selection && !offeringBusy}}">
    <button wx:if="{{!following && !overview}}" class="scene-button" bindtap="followPlayer">跟随人物 ⊙</button>
    <button wx:if="{{!overview}}" class="scene-button" bindtap="toggleOverview" disabled="{{loading || error}}">大地图 ↗</button><button wx:else class="scene-button" bindtap="returnToWalk">返回散步 ↘</button>
    <button wx:if="{{!selectingPlot}}" class="scene-button" bindtap="choosePlot" disabled="{{loading || error}}">申请时光小筑</button><button wx:else class="scene-button" bindtap="showWholeMap">查看全园</button>
  </view>
  <view class="map-selection" wx:if="{{overview && selection}}"><view class="selection-title">{{selection.name}}</view><view class="panel-tip" wx:if="{{selection.epitaph}}">{{selection.date}} · {{selection.epitaph}}</view><view class="selection-actions"><button bindtap="clearSelection">重新选择</button><button bindtap="startNavigation">追踪到这里 →</button><button class="selection-primary" wx:if="{{selection.plotId && selectingPlot}}" bindtap="openApplication">{{move ? (restoring ? '在这里恢复小筑' : '迁移到这里') : '选这里安放思念'}}</button></view></view>
  <view class="map-error" wx:if="{{selectingPlot && applicationError}}">{{applicationError}}<button bindtap="refreshMemorials">刷新位置</button></view>
  <view class="load-mask" wx:if="{{loading || error}}"><view class="load-card"><view class="load-symbol">✦</view><view class="load-title">{{error ? '暂时未能进入园区' : '正在走进纪念园'}}</view><view class="load-description">{{error || '阳光、草木和思念，都在这里。'}}</view><button wx:if="{{error}}" bindtap="retry">重新加载</button></view></view>
  <view class="panel-mask" wx:if="{{settingsOpen}}" bindtap="toggleSettings"><scroll-view scroll-y class="settings-panel" catchtap="stopBubble"><view class="panel-title">园区设置<button bindtap="toggleSettings">关闭</button></view><view class="setting-row"><text>角色</text><view class="avatar-switch"><button class="{{gender === 'boy' ? 'selected' : ''}}" data-gender="boy" bindtap="chooseGender" disabled="{{changing || loading}}">男生</button><button class="{{gender === 'girl' ? 'selected' : ''}}" data-gender="girl" bindtap="chooseGender" disabled="{{changing || loading}}">女生</button></view></view><view class="setting-row"><text>背景音乐</text><switch checked="{{music}}" data-setting="music" bindchange="toggleSound" color="#516d51" /></view><view class="setting-row"><text>脚步与提示音</text><switch checked="{{effects}}" data-setting="effects" bindchange="toggleSound" color="#516d51" /></view><view class="environment-setting"><view>北京时间 {{environmentTime}} · {{environmentLabel}}</view><view class="panel-tip">光线随时间流转，草木随四季更替。同园共享模拟天气。</view><view class="setting-row"><text>雨雪、飘叶与薄雾</text><switch checked="{{weatherEffects}}" bindchange="toggleWeatherEffects" color="#516d51" /></view><view class="panel-tip">关闭动态特效可减少绘制，昼夜与四季仍会变化。</view><button wx:if="{{environmentError}}" bindtap="retryEnvironment">{{environmentError}}</button></view><view class="panel-tip">{{presenceMessage || ('同园实时连接 · ' + visitorCount + ' 人')}}</view><view wx:if="{{presenceDetail}}" class="panel-tip">{{presenceDetail}}</view><button wx:if="{{presenceMessage}}" bindtap="retryPresence">重新连接同园访客</button><view class="panel-tip">声音选择自动保存，下次进入沿用。</view><view class="panel-tip" wx:if="{{audioError}}">{{audioError}}<text wx:if="{{audioDetail}}"> · {{audioDetail}}</text></view><button wx:if="{{audioError}}" bindtap="retryAudio">重试声音</button><view class="panel-tip">当前园区：{{gardenName}} · {{gardenAccepting ? '接收新申请' : '暂停新申请，仍可探望'}}</view><button bindtap="showGardens">切换纪念园 ›</button><button bindtap="showApplications">我的时光小筑 ›</button><button bindtap="openRecycle">小筑回收站 · 7 天恢复期 ›</button><button bindtap="resetPosition">回到入口</button></scroll-view></view>
  <view class="panel-mask" wx:if="{{form || applications}}"><view class="application-panel"><view class="panel-title">{{form ? (move ? (restoring ? '恢复时光小筑' : '迁移时光小筑') : '为毛孩子申请时光小筑') : '我的时光小筑'}}<button bindtap="closeApplication" disabled="{{submitting}}">关闭</button></view><scroll-view scroll-y class="panel-scroll"><block wx:if="{{form}}"><view class="panel-tip">{{form.lawn}} · {{form.plotNumber}}号 · {{move ? '全部内容随小筑保留' : '审核通过后公开展示名字、日期与寄语'}}</view><view class="field-label">小筑样式</view><image wx:if="{{styleAtlas}}" class="style-preview" src="{{styleAtlas}}" mode="widthFix" /><view class="style-options"><button class="{{form.style === 'arch' ? 'selected' : ''}}" data-style="arch" bindtap="chooseStyle" disabled="{{submitting}}">暖石拱碑</button><button class="{{form.style === 'cottage' ? 'selected' : ''}}" data-style="cottage" bindtap="chooseStyle" disabled="{{submitting}}">花园小屋</button><button class="{{form.style === 'moon' ? 'selected' : ''}}" data-style="moon" bindtap="chooseStyle" disabled="{{submitting}}">月光纪念碑</button></view><view class="panel-tip">鲜花与零食摆放在碑旁，专属宠物画像安放在前方陪伴平台。</view><block wx:if="{{!move}}"><view class="field-label">宠物名字</view><input maxlength="20" value="{{form.petName}}" data-field="petName" bindinput="inputApplication" disabled="{{submitting}}" placeholder="请输入宠物名字" /><view class="field-label">纪念日期</view><picker mode="date" value="{{form.date}}" data-field="date" bindchange="inputApplication" disabled="{{submitting}}"><view class="date-field">{{form.date || '请选择日期'}}</view></picker><view class="field-label">想对它说的话</view><textarea maxlength="120" value="{{form.epitaph}}" data-field="epitaph" bindinput="inputApplication" disabled="{{submitting}}" placeholder="留下一段寄语（120字以内）" /></block></block><block wx:else><view class="application-record" wx:for="{{applications}}" wx:key="_id"><view>{{item.petName}} · {{item.statusText}}</view><view class="panel-tip">{{item.gardenName}} · {{item.lawn}} · {{item.plotNumber}}号 · {{item.date}}</view><view class="panel-tip" wx:if="{{item.reason}}">审核意见：{{item.reason}}</view><button wx:if="{{item.status === 'approved'}}" data-plot="{{item.plotId}}" data-id="{{item._id}}" bindtap="visitMemorial">去看看它 →</button><button wx:if="{{item.status === 'approved'}}" data-id="{{item._id}}" bindtap="manageRecord">回忆与小筑管理</button></view><view class="panel-tip" wx:if="{{!applications.length && !recordsLoading && !recordsError}}">给思念一个温柔的归处，先为它选一处时光小筑。</view><view wx:if="{{recordsError}}">{{recordsError}}</view><button bindtap="showApplications" loading="{{recordsLoading}}" disabled="{{recordsLoading}}">刷新申请</button><button wx:if="{{recordsMore}}" data-more="true" bindtap="showApplications" disabled="{{recordsLoading}}">加载更多</button></block></scroll-view><view class="application-footer" wx:if="{{form}}"><view class="form-error" wx:if="{{formError}}">{{formError}}</view><button class="submit-button" bindtap="submitApplication" loading="{{submitting}}" disabled="{{submitting}}">{{submitting ? '正在处理…' : move ? (restoring ? '确认恢复到这里' : '确认迁移到这里') : '提交申请'}}</button></view></view></view>
</view>

<view class="garden-page memorial-overlay" wx:if="{{memorialCard}}" style="--hud-top:{{hudTop}}px; --hud-left:{{hudLeft}}px; --hud-right:{{hudRight}}px">
  <view class="panel-mask" bindtap="closeMemorial"><view class="application-panel entrance-panel" catchtap="stopBubble">
    <view class="panel-title"><text class="entrance-title">{{memorialCard.name}}的时光小筑</text><button bindtap="closeMemorial">关闭</button></view>
    <scroll-view scroll-y class="entrance-scroll">
      <view class="entrance-date">{{memorialCard.date}}</view><view class="entrance-epitaph">{{memorialCard.epitaph}}</view>
      <view class="offering-card"><view class="offering-heading">留在这里的心意</view><view class="offering-counts"><view><text class="offering-number">{{offeringTotals.flower}}</text><text>束鲜花</text></view><view><text class="offering-number">{{offeringTotals.snack}}</text><text>份零食</text></view></view><view class="offering-actions"><button class="offering-flower" data-kind="flower" bindtap="giveOffering" disabled="{{offeringBusy || offeringLoading || !offeringStatus || offeringStatus.given.flower}}">✿ {{offeringStatus.given.flower ? '今日已献花' : '献一束鲜花'}}</button><button class="offering-snack" data-kind="snack" bindtap="giveOffering" disabled="{{offeringBusy || offeringLoading || !offeringStatus || offeringStatus.given.snack}}">♡ {{offeringStatus.given.snack ? '今日已放零食' : '放一份零食'}}</button></view><view class="offering-note">{{offeringLoading ? '正在读取心意记录…' : '每人每天可分别献上一次 · 北京时间零点更新'}}</view><view class="offering-error" wx:if="{{offeringError}}">{{offeringError}}<button bindtap="loadOfferingStatus">重新读取</button></view></view>
      <view class="panel-tip" wx:if="{{entranceLoading}}">正在翻开珍藏的片段…</view>
      <view wx:if="{{entranceError}}" class="panel-tip">{{entranceError}}<button bindtap="loadEntrance">重新读取</button></view>
      <block wx:if="{{entrance.images.length || entrance.videos.length}}">
        <view class="entrance-label">主人分享的温柔片段</view>
        <view class="entrance-photos"><image wx:for="{{entrance.images}}" wx:key="uploadId" class="entrance-photo" lazy-load src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="previewEntranceImage" /></view>
        <video wx:for="{{entrance.videos}}" wx:key="uploadId" class="entrance-video" id="entrance-video-{{index}}" src="{{item.url}}" controls bindplay="pauseEntranceSound" bindpause="resumeEntranceSound" bindended="resumeEntranceSound" binderror="resumeEntranceSound" />
      </block>
      <view class="panel-tip">在这里陪它一会儿，也可以翻开完整的回忆，看看它的故事。</view>
    </scroll-view>
    <button class="submit-button" bindtap="openMemory">打开它的回忆</button>
  </view></view>
</view>

<view class="garden-page memorial-overlay" wx:if="{{gardenListOpen}}" style="--hud-top:{{hudTop}}px; --hud-left:{{hudLeft}}px; --hud-right:{{hudRight}}px"><view class="panel-mask"><view class="application-panel"><view class="panel-title">选择纪念园<button bindtap="closeGardens">关闭</button></view><scroll-view scroll-y class="panel-scroll"><view class="application-record" wx:for="{{gardens}}" wx:key="id"><view>{{item.name}}{{item.id === currentGardenId ? ' · 当前园区' : ''}}</view><view class="panel-tip">{{item.accepting ? '可以申请新的时光小筑' : '暂停新申请，已有小筑仍可探望'}}</view><button data-id="{{item.id}}" bindtap="chooseGarden">{{item.id === currentGardenId ? '继续散步' : '进入园区 →'}}</button></view><view class="panel-tip" wx:if="{{gardensError}}">{{gardensError}}</view><button wx:if="{{gardensError}}" bindtap="showGardens">重新加载</button><view wx:if="{{gardensLoading}}" class="panel-tip">正在读取园区…</view><button wx:if="{{gardensMore}}" data-more="true" bindtap="showGardens" disabled="{{gardensLoading}}">更多纪念园</button></scroll-view></view></view></view>
