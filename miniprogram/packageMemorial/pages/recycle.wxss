page{background:#f4f3e9;color:#344c3c}.recycle-page{padding:52rpx 30rpx 80rpx}.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:#7c886f}.title{font-size:44rpx;font-weight:600;margin:20rpx 0}.description{font-size:26rpx;line-height:1.9;color:#77836f;margin-bottom:34rpx}.recycle-card{padding:32rpx;background:#fffef8;border:1rpx solid #dfe4d5;border-radius:28rpx;margin:22rpx 0}.pet-name{font-size:36rpx;font-weight:600}.location{font-size:23rpx;color:#7a8772;line-height:1.8;margin-top:12rpx}.deadline{padding:20rpx 0;font-size:24rpx;color:#926b4a;line-height:1.8}.deadline text{display:block;font-size:21rpx;color:#a18c75}.actions{display:flex;gap:16rpx}.actions button{flex:1;margin:0;background:#526e56;color:white;font-size:25rpx;border-radius:16rpx;padding:0 10rpx;line-height:84rpx}.actions .secondary{background:#e8eddf;color:#536d4d}button::after{border:0}.actions button[disabled]{opacity:.5}.notice{background:#e7eddc;padding:24rpx;border-radius:20rpx;font-size:26rpx;line-height:1.8}.notice button,.more{font-size:26rpx;color:#536d4d;background:transparent}.error{background:#f5e9dc;color:#926b4a}.empty{text-align:center;padding:60rpx 0;color:#85917c;font-size:26rpx}

.recycle-page{box-sizing:border-box;max-width:560px;margin:auto;padding-bottom:calc(60rpx + env(safe-area-inset-bottom))}
.recycle-page button{box-sizing:border-box;min-height:44px;height:auto;line-height:1.5;padding:12px 10px;white-space:normal;overflow-wrap:anywhere}
.recycle-page .actions{margin-top:14rpx;flex-wrap:wrap}.recycle-page .actions button{flex:1 1 0;width:0;min-width:0}.recycle-page .actions .secondary{border:1rpx solid #cad5bf;background:#f7faef}
.pet-name,.location,.notice{overflow-wrap:anywhere}.description,.location,.empty{color:#65735f}.deadline text{color:#887459}.error-help{font-size:23rpx;margin-top:10rpx}.notice{margin-bottom:20rpx}.notice button{width:100%;margin-top:12rpx;border:1rpx solid #cbd6bf;border-radius:16rpx;background:#f9fbf2}.error button{border-color:#ddcbb6}.empty{padding:48rpx 24rpx;background:#fffef8;border-radius:24rpx;margin-top:24rpx}
@media(max-width:340px){.recycle-page .actions{flex-direction:column}.recycle-page .actions button{width:100%;flex:auto}}
