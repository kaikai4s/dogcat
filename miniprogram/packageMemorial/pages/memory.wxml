<view class="memory-page">
  <view wx:if="{{loading}}" class="memory-empty"><view class="memory-loading-mark"><view class="remix-icon ri-leaf-line"></view></view><view>正在翻开回忆…</view></view>
  <view wx:elif="{{error}}" class="memory-empty">{{error}}<button class="memory-button button-primary" bindtap="load">重新加载</button></view>
  <block wx:elif="{{detail}}">
    <view class="hero"><view class="hero-mark">✧</view><view class="eyebrow">留在时光里的陪伴</view><view class="title">{{detail.petName}}</view><view class="date">{{detail.date}} · {{detail.gardenName}} · {{detail.lawn}} {{plotNumber}}号</view><view class="epitaph">“{{detail.epitaph}}”</view></view>
    <view class="owner-bar" wx:if="{{detail.owner}}">
      <block wx:if="{{previewing}}"><view class="status-line">访客视角 · 仅显示已公开的回忆</view><button class="memory-button button-secondary" bindtap="closePreview">返回主人视角</button></block>
      <block wx:else><view class="owner-heading"><text>把陪伴好好珍藏</text><text class="status-tag">{{reviewLabel}}</text></view><view class="tip">故事、照片与旋律，留住它来过的痕迹。</view><view class="actions"><button class="memory-button button-primary" bindtap="edit" disabled="{{uploading || saving}}">整理回忆</button><button class="memory-button button-secondary" bindtap="preview" disabled="{{uploading || saving}}">像访客一样看看</button></view><view wx:if="{{detail.reason}}" class="review-note">审核意见：{{detail.reason}}</view></block>
    </view>
    <view class="card editor-card" wx:if="{{editing}}">
      <view class="section-heading"><view><view class="section-kicker">01 / STORY</view><view class="section-title">我们的故事</view></view><text class="word-count">已写 {{textCount}} 字</text></view>
      <textarea class="story-editor" maxlength="-1" value="{{draft.text}}" bindinput="input" disabled="{{saving}}" placeholder="写下它的习惯、你们的相遇，以及那些舍不得忘记的小事…" /><view class="tip">慢慢写，回忆不必匆忙。</view>
      <view class="editor-section"><view class="section-kicker">02 / PHOTOS</view><view class="section-heading"><view class="section-title">珍藏的照片</view><text class="count-tag">{{draft.images.length}} / 12</text></view><view class="tip">选为“入口展示”的照片和视频，通过公开审核后会显示在点击小筑的弹窗里。未选择的内容仍留在完整回忆中；关闭回忆公开后，入口也会隐藏。</view><view class="photos"><view class="photo-item" wx:for="{{draft.images}}" wx:key="uploadId"><image class="memory-photo" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="showImage" /><button class="memory-button entrance-toggle {{item.entrance ? 'entrance-selected' : ''}}" data-kind="images" data-id="{{item.uploadId}}" bindtap="toggleEntrance" disabled="{{saving || uploading}}">{{item.entrance ? '✓ 入口展示' : '在入口展示'}}</button><button class="memory-button button-remove" data-kind="images" data-index="{{index}}" bindtap="remove" disabled="{{saving || uploading}}">移除照片</button></view></view><button class="memory-button button-upload" data-kind="image" bindtap="addMedia" disabled="{{saving || uploading || draft.images.length >= 12}}"><text class="upload-plus">＋</text> 添加照片<text class="button-caption">可以一次选择多张</text></button></view>
      <view class="editor-section"><view class="section-kicker">03 / MOMENTS</view><view class="section-heading"><view class="section-title">会动的回忆</view><text class="count-tag">{{draft.videos.length}} / 6</text></view><view class="video-item" wx:for="{{draft.videos}}" wx:key="uploadId"><video class="memory-video" src="{{item.url}}" controls /><button class="memory-button entrance-toggle {{item.entrance ? 'entrance-selected' : ''}}" data-kind="videos" data-id="{{item.uploadId}}" bindtap="toggleEntrance" disabled="{{saving || uploading}}">{{item.entrance ? '✓ 已选为入口展示' : '在小筑入口展示'}}</button><button class="memory-button button-remove" data-kind="videos" data-index="{{index}}" bindtap="remove" disabled="{{saving || uploading}}">移除这段视频</button></view><button class="memory-button button-upload" data-kind="video" bindtap="addMedia" disabled="{{saving || uploading || draft.videos.length >= 6}}"><text class="upload-plus">＋</text> 添加视频<text class="button-caption">每段最多 30MB</text></button></view>
      <view class="editor-section"><view class="section-kicker">04 / MELODY</view><view class="section-title">陪伴的旋律</view><view class="tip">MP3 / M4A / WAV · 最多 10MB · 访客点击后播放</view><view wx:if="{{draft.music}}" class="music-panel"><text class="music-name">{{draft.music.name}}</text><view class="actions"><button class="memory-button button-secondary" data-url="{{draft.music.url}}" bindtap="playMusic">{{playing ? '暂停' : '试听'}}</button><button class="memory-button button-remove" data-kind="music" bindtap="remove" disabled="{{saving || uploading}}">移除音乐</button></view></view><button class="memory-button button-upload" data-kind="music" bindtap="addMedia" disabled="{{saving || uploading}}">{{draft.music ? '更换' : '上传'}}背景音乐</button></view>
      <view class="privacy"><view class="privacy-copy"><view class="privacy-title">允许大家阅读它的回忆</view><view class="tip">名字、日期与碑上寄语始终公开。关闭公开并保存后，回忆立即隐藏；公开或更新公开回忆需审核。</view></view><switch checked="{{isPublic}}" bindchange="privacy" disabled="{{saving}}" color="#597456" /></view>
      <view wx:if="{{uploading}}" class="upload-progress">{{uploadTip}}</view><button class="memory-button button-primary button-save" bindtap="save" loading="{{saving}}" disabled="{{saving || uploading}}">{{isPublic ? '保存并提交公开审核' : '保存这份私人回忆'}}</button><button class="memory-button button-quiet" bindtap="finishEditing" disabled="{{saving || uploading}}">暂时收起编辑</button>
    </view>
    <block wx:else><template is="story" data="{{content: detail.owner && !previewing ? draft : story, playing: playing}}" /><view class="memory-empty" wx:if="{{(!detail.owner || previewing) && !detail.hasPublicStory}}">主人暂未分享它的故事。<view class="tip">在这里安静地陪它一会儿，也是一份温柔。</view></view></block>
    <view class="card portrait-card" wx:if="{{detail.owner && !previewing && !editing}}"><view class="section-kicker">A LITTLE COMPANION</view><view class="section-title">让它的模样，留在小筑前</view><view class="tip">上传正面与侧面照片，审核员会为它制作专属画像。制作完成后，会安放在小筑前的陪伴平台。</view><image wx:if="{{portrait.result.url}}" class="portrait-result" src="{{portrait.result.url}}" mode="aspectFit" /><view class="status-line" wx:if="{{portrait}}">{{portraitLabel}}</view><view class="tip" wx:if="{{portrait && portrait.status !== 'empty'}}">申请姿势：{{portraitPoseLabel}}</view><view class="review-note" wx:if="{{portrait.reason}}">{{portrait.reason}}</view><view class="review-note" wx:if="{{portraitError}}">{{portraitError}}<button class="memory-button button-secondary" bindtap="loadPortrait">重新读取申请</button></view><button wx:if="{{!portraitForm}}" class="memory-button button-secondary" bindtap="openPortrait" disabled="{{uploading || saving || !portrait || portrait.status === 'pending'}}">{{portrait.status === 'approved' ? '申请更新画像' : portrait.status === 'pending' ? '画像正在制作中' : '申请专属宠物画像'}}</button>
      <view wx:if="{{portraitForm}}"><view class="portrait-pose-label">希望它以怎样的姿势陪伴你？</view><view class="portrait-pose-options"><button class="memory-button portrait-pose {{portraitPose === 'sitting' ? 'selected' : ''}}" data-pose="sitting" bindtap="selectPortraitPose" disabled="{{uploading || saving}}"><text class="pose-title">乖巧坐着</text><text class="pose-caption">像从前一样等你</text></button><button class="memory-button portrait-pose {{portraitPose === 'sleeping' ? 'selected' : ''}}" data-pose="sleeping" bindtap="selectPortraitPose" disabled="{{uploading || saving}}"><text class="pose-title">安心趴睡</text><text class="pose-caption">在熟悉的梦里休息</text></button></view><view class="reference-grid"><view class="reference-item"><view class="reference-title">正面照片</view><image wx:if="{{portraitPhotos.front}}" class="reference-image" src="{{portraitPhotos.front.url}}" mode="aspectFill" /><view wx:else class="reference-placeholder"><view class="remix-icon ri-image-line"></view><text>选择正面照片</text></view><button class="memory-button button-secondary reference-upload" data-side="front" bindtap="addPortraitPhoto" disabled="{{uploading || saving}}">{{portraitPhotos.front ? '更换正面照' : '上传正面照'}}</button></view><view class="reference-item"><view class="reference-title">侧面照片</view><image wx:if="{{portraitPhotos.side}}" class="reference-image" src="{{portraitPhotos.side.url}}" mode="aspectFill" /><view wx:else class="reference-placeholder"><view class="remix-icon ri-image-line"></view><text>选择侧面照片</text></view><button class="memory-button button-secondary reference-upload" data-side="side" bindtap="addPortraitPhoto" disabled="{{uploading || saving}}">{{portraitPhotos.side ? '更换侧面照' : '上传侧面照'}}</button></view></view><view class="tip">尽量选择清晰、完整的照片，保留毛色、花纹、耳朵和尾巴细节。原始照片仅主人和有权限的审核员可见，完成后的画像会公开展示。</view><textarea class="portrait-note" maxlength="500" placeholder="它有哪些特别的花纹、神态或小习惯？（选填）" value="{{portraitNote}}" bindinput="inputPortraitNote" disabled="{{uploading || saving}}" /><view class="upload-progress" wx:if="{{uploading}}">{{uploadTip}}</view><button class="memory-button button-primary" bindtap="submitPortrait" disabled="{{uploading || saving || !portraitPhotos.front || !portraitPhotos.side}}" loading="{{saving}}">提交画像制作申请</button><button class="memory-button button-quiet" bindtap="closePortrait" disabled="{{uploading || saving}}">稍后再申请</button></view>
    </view>
  </block>
</view>
<template name="story"><view class="card story-card" wx:if="{{content}}"><view class="section-kicker">OUR MEMORIES</view><view class="section-title">那些一起走过的时光</view><text class="story-text" user-select>{{content.text || '有些思念，藏在照片和声音里。'}}</text><view class="photos"><image class="memory-photo" wx:for="{{content.images}}" wx:key="uploadId" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="showImage" /></view><video class="memory-video" wx:for="{{content.videos}}" wx:key="uploadId" src="{{item.url}}" controls /><button wx:if="{{content.music}}" class="memory-button button-secondary music-play" data-url="{{content.music.url}}" bindtap="playMusic">{{playing ? '暂停旋律' : '播放陪伴的旋律'}} · {{content.music.name}}</button></view></template>
