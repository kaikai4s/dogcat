<view class="memory-page">
  <view wx:if="{{demolished}}" class="memory-empty">小筑已移入回收站，原位置已释放。<view class="tip">请在北京时间 {{recoverUntilText}} 前恢复，逾期永久清除全部内容。</view><button class="memory-button button-primary" bindtap="openRecycle">前往回收站恢复</button><button class="memory-button button-secondary" bindtap="chooseGarden">返回纪念园入口</button></view>
  <view wx:elif="{{loading}}" class="memory-empty"><view class="memory-loading-mark"><view class="remix-icon ri-leaf-line"></view></view><view>正在翻开回忆…</view></view>
  <view wx:elif="{{error}}" class="memory-empty">{{error}}<button class="memory-button button-primary" bindtap="load">重新加载</button></view>
  <block wx:elif="{{detail}}">
    <view class="hero"><view class="hero-mark">✧</view><view class="eyebrow">留在时光里的陪伴</view><view class="title">{{detail.petName}}</view><view class="date">{{detail.lifeSpanText ? detail.lifeSpanText + ' · ' : ''}}{{detail.date}} · {{detail.gardenName}} · {{detail.lawn}} {{plotNumber}}号</view><view class="epitaph">“{{detail.epitaph}}”</view></view>
    <view class="owner-bar" wx:if="{{detail.owner}}">
      <block wx:if="{{previewing}}"><view class="status-line">访客视角 · 仅显示已公开的回忆</view><button class="memory-button button-secondary" bindtap="closePreview">返回主人视角</button></block>
      <block wx:else><view class="owner-heading"><text>把陪伴好好珍藏</text><text class="status-tag">{{editing ? '正在整理回忆' : reviewLabel}}</text></view><view class="tip">故事、照片与旋律，留住它来过的痕迹。</view><view class="actions"><button class="memory-button {{editing ? 'button-primary editing-mode-button' : 'button-secondary'}}" bindtap="edit" disabled="{{managing || uploading || saving || mediaSaving}}">{{editing ? '返回整理区' : '整理回忆'}}</button><button class="memory-button button-secondary" bindtap="preview" disabled="{{managing || uploading || saving || mediaSaving}}">像访客一样看看</button></view><view wx:if="{{detail.reason}}" class="review-note">审核意见：{{detail.reason}}</view></block>
    </view>
    <view class="card years-card" wx:if="{{detail.owner && !previewing}}">
      <view class="section-heading">
        <view>
          <view class="section-kicker">MONUMENT YEARS</view>
          <view class="section-title">出生与去世年份</view>
        </view>
        <text class="status-tag">{{editLifeSpanPreview || detail.lifeSpanText || '未知 — 未知'}}</text>
      </view>
      <view class="tip">可随时补充或修改出生与去世年份，不确定时可设为「未知」。</view>
      <view class="life-years-row">
        <view class="life-year-col">
          <view class="life-year-head">
            <text class="life-year-caption">出生年份</text>
            <text class="year-unknown-chip {{editBirthYear === 'unknown' ? 'active' : ''}}" data-field="birthYear" bindtap="setYearUnknown">未知</text>
          </view>
          <picker mode="selector" range="{{yearOptions}}" range-key="label" value="{{birthYearIndex}}" data-field="birthYear" bindchange="chooseYear" disabled="{{managing || yearSaving}}">
            <view class="year-field">{{editBirthYear === 'unknown' ? '未知' : (editBirthYear ? editBirthYear + '年' : '请选择')}}</view>
          </picker>
        </view>
        <view class="life-year-col">
          <view class="life-year-head">
            <text class="life-year-caption">去世年份</text>
            <text class="year-unknown-chip {{editPassingYear === 'unknown' ? 'active' : ''}}" data-field="passingYear" bindtap="setYearUnknown">未知</text>
          </view>
          <picker mode="selector" range="{{yearOptions}}" range-key="label" value="{{passingYearIndex}}" data-field="passingYear" bindchange="chooseYear" disabled="{{managing || yearSaving}}">
            <view class="year-field">{{editPassingYear === 'unknown' ? '未知' : (editPassingYear ? editPassingYear + '年' : '请选择')}}</view>
          </picker>
        </view>
      </view>
      <view class="media-save-error" wx:if="{{yearError}}">{{yearError}}</view>
      <button class="memory-button button-primary years-save-btn" bindtap="saveYears" loading="{{yearSaving}}" disabled="{{managing || yearSaving || !hasYearChanges}}">{{hasYearChanges ? '保存生卒年份' : '生卒年份已是最新'}}</button>
    </view>
    <view class="card management-card" wx:if="{{detail.owner && !previewing && !editing && !portraitForm}}">
      <view class="section-title">小筑管理</view><view class="tip">迁移可更换园区、位置和碑型，全部已保存内容随小筑保留。</view><view class="management-note">拆除后原位置释放，内容在回收站保留 7 天。</view><view class="media-save-error" wx:if="{{managementError}}">{{managementError}}</view>
      <view class="actions"><button class="memory-button button-secondary" data-operation="relocate" bindtap="manageMemorial" disabled="{{managing || uploading || saving || mediaSaving}}">迁移小筑</button><button class="memory-button button-quiet demolition-button" data-operation="demolish" bindtap="manageMemorial" disabled="{{managing || uploading || saving || mediaSaving}}">拆除小筑</button></view>
    </view>
    <view id="memory-editor" class="card editor-card" wx:if="{{editing}}">
      <view class="section-heading"><view><view class="section-kicker">01 / STORY</view><view class="section-title">我们的故事</view><view class="editing-status">编辑模式 · 文字保存后提交审核</view></view><text class="word-count">已写 {{textCount}} 字</text></view>
      <view class="format-switch"><button class="format-option {{draft.mode === 'plain' ? 'selected' : ''}}" data-mode="plain" bindtap="selectFormat" disabled="{{managing || saving || uploading || mediaSaving}}">普通回忆</button><button class="format-option {{draft.mode === 'novel' ? 'selected' : ''}}" data-mode="novel" bindtap="selectFormat" disabled="{{managing || saving || uploading || mediaSaving}}">小说模式</button></view>
      <block wx:if="{{draft.mode === 'novel'}}"><view class="tip novel-tip">按章节记录生平；访客阅读时会逐页翻看。你可以决定是否在第一章前加入序章。</view><view class="prologue-toggle"><view><view class="prologue-toggle-title">加入序章</view><view class="tip">用于写开场引子、相识前的背景或致读者的话。</view></view><switch color="#597456" checked="{{hasPrologue}}" bindchange="togglePrologue" disabled="{{managing || saving || uploading || mediaSaving}}" /></view><view class="chapter-editor prologue-editor" wx:if="{{hasPrologue && draft.prologue}}"><view class="chapter-editor-head"><text>序章</text><text class="prologue-badge">开场部分</text></view><input class="chapter-title-input" maxlength="50" value="{{draft.prologue.title}}" bindinput="inputPrologueTitle" disabled="{{managing || saving}}" placeholder="序章标题"/><textarea class="story-editor chapter-story-editor" maxlength="30000" value="{{draft.prologue.text}}" bindinput="inputPrologueText" disabled="{{managing || saving}}" placeholder="写下故事开始之前的引子…" /></view><view class="chapter-editor" wx:for="{{draft.chapters}}" wx:key="id"><view class="chapter-editor-head"><text>第 {{index + 1}} 章</text><button class="chapter-remove" data-index="{{index}}" bindtap="removeChapter" disabled="{{managing || saving || uploading || mediaSaving}}" aria-label="删除第{{index + 1}}章">移除</button></view><input class="chapter-title-input" maxlength="50" value="{{item.title}}" data-index="{{index}}" bindinput="inputChapterTitle" disabled="{{managing || saving}}" placeholder="章节标题"/><textarea class="story-editor chapter-story-editor" maxlength="30000" value="{{item.text}}" data-index="{{index}}" bindinput="inputChapterText" disabled="{{managing || saving}}" placeholder="记录这一阶段的故事…" /></view><button class="memory-button button-secondary add-chapter" bindtap="addChapter" disabled="{{managing || saving || uploading || mediaSaving || draft.chapters.length >= 100}}">＋ 添加章节</button></block>
      <block wx:else><textarea class="story-editor" maxlength="30000" value="{{draft.text}}" bindinput="input" disabled="{{managing || saving}}" placeholder="写下它的习惯、你们的相遇，以及那些舍不得忘记的小事…" /><view class="tip">慢慢写，回忆不必匆忙。</view></block>
      <view class="editor-section">
        <view class="section-kicker">02 / PHOTOS</view>
        <view class="section-heading"><view class="section-title">珍藏的照片</view><text class="count-tag">{{draft.images.length}} / 12</text></view>
        <view class="media-help"><view class="media-help-title">入口展示，随时调整</view><view class="tip">已公开的照片和视频，点击展示或取消即可生效，移除也会立即保存。新上传的内容须提交审核，通过后才会对大家展示。</view></view>
        <view wx:if="{{mediaSaveError}}" class="media-save-error">{{mediaSaveError}}</view>
        <view class="photos editor-photos">
          <view class="photo-item" wx:for="{{draft.images}}" wx:key="uploadId">
            <image class="memory-photo" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="showImage" />
            <view class="photo-actions">
              <button class="memory-button entrance-toggle {{item.entrance ? 'entrance-selected' : ''}}" data-kind="images" data-id="{{item.uploadId}}" bindtap="toggleEntrance" disabled="{{managing || saving || uploading || mediaSaving}}" aria-label="{{item.entrance ? '取消这张照片的入口展示' : '在入口展示这张照片'}}">{{item.entrance ? '✓ 取消展示' : '在入口展示'}}</button>
              <button class="memory-button button-remove" data-kind="images" data-index="{{index}}" bindtap="remove" disabled="{{managing || saving || uploading || mediaSaving}}">移除照片</button>
            </view>
          </view>
        </view>
        <button class="memory-button button-upload" data-kind="image" bindtap="addMedia" disabled="{{managing || saving || uploading || mediaSaving || draft.images.length >= 12}}"><text class="upload-plus">＋</text> 添加照片<text class="button-caption">可以一次选择多张</text></button>
      </view>
      <view class="editor-section">
        <view class="section-kicker">03 / MOMENTS</view>
        <view class="section-heading"><view class="section-title">会动的回忆</view><text class="count-tag">{{draft.videos.length}} / 6</text></view>
        <view class="video-item" wx:for="{{draft.videos}}" wx:key="uploadId">
          <video class="memory-video" src="{{item.url}}" controls />
          <view class="video-actions">
            <button class="memory-button entrance-toggle {{item.entrance ? 'entrance-selected' : ''}}" data-kind="videos" data-id="{{item.uploadId}}" bindtap="toggleEntrance" disabled="{{managing || saving || uploading || mediaSaving}}">{{item.entrance ? '✓ 取消入口展示' : '在小筑入口展示'}}</button>
            <button class="memory-button button-remove" data-kind="videos" data-index="{{index}}" bindtap="remove" disabled="{{managing || saving || uploading || mediaSaving}}">移除视频</button>
          </view>
        </view>
        <button class="memory-button button-upload" data-kind="video" bindtap="addMedia" disabled="{{managing || saving || uploading || mediaSaving || draft.videos.length >= 6}}"><text class="upload-plus">＋</text> 添加视频<text class="button-caption">每段最多 30MB</text></button>
      </view>
      <view class="editor-section"><view class="section-kicker">04 / MELODY</view><view class="section-title">陪伴的旋律</view><view class="tip">MP3 / M4A / WAV · 最多 10MB · 访客点击后播放</view><view wx:if="{{draft.music}}" class="music-panel"><text class="music-name">{{draft.music.name}}</text><view class="actions"><button class="memory-button button-secondary" data-url="{{draft.music.url}}" bindtap="playMusic">{{playing ? '暂停' : '试听'}}</button><button class="memory-button button-remove" data-kind="music" bindtap="remove" disabled="{{managing || saving || uploading || mediaSaving}}">移除音乐</button></view></view><button class="memory-button button-upload" data-kind="music" bindtap="addMedia" disabled="{{managing || saving || uploading || mediaSaving}}">{{draft.music ? '更换' : '上传'}}背景音乐</button></view>
      <view class="privacy"><view class="privacy-copy"><view class="privacy-title">允许大家阅读它的回忆</view><view class="tip">保存关闭设置后，访客无法阅读。所有文字和章节修改都需管理员审核；图片、视频移除即时生效。公开内容修改也需审核。</view></view><switch checked="{{isPublic}}" bindchange="privacy" disabled="{{managing || saving}}" color="#597456" /></view>
      <view wx:if="{{uploading}}" class="upload-progress">{{uploadTip}}</view><view wx:if="{{mediaSaving}}" class="upload-progress">正在保存这项调整…</view><view class="autosave-note">入口展示设置和图片、视频移除会自动保存，无需提交文字审核。</view><button class="memory-button button-primary button-save" bindtap="save" loading="{{saving}}" disabled="{{managing || saving || uploading || mediaSaving || !hasUnsavedChanges}}">{{hasUnsavedChanges ? (isPublic ? '保存并提交审核' : '保存文字并提交审核') : '暂无待保存的修改'}}</button><button class="memory-button button-quiet" bindtap="finishEditing" disabled="{{managing || saving || uploading || mediaSaving}}">暂时收起编辑</button>
    </view>
    <block wx:else><template is="story" data="{{content: detail.owner && !previewing ? draft : story, playing: playing, readerChapterIndex: readerChapterIndex, readerChapterTitle: readerChapterTitle, readerSectionLabel: readerSectionLabel, readerSectionCount: readerSectionCount, readerPageIndex: readerPageIndex, readerPageCount: readerPageCount, readerPageText: readerPageText, readerCanPrev: readerCanPrev, readerCanNext: readerCanNext}}" /><view class="memory-empty" wx:if="{{(!detail.owner || previewing) && !detail.hasPublicStory}}">主人暂未分享它的故事。<view class="tip">在这里安静地陪它一会儿，也是一份温柔。</view></view></block>
    <view class="card portrait-card" wx:if="{{detail.owner && !previewing && !editing}}"><view class="section-kicker">A LITTLE COMPANION</view><view class="section-title">让它的模样，留在小筑前</view><view class="tip">上传正面与侧面照片，审核员会为它制作专属画像。制作完成后，会安放在小筑前的陪伴平台。</view><image wx:if="{{portrait.result.url}}" class="portrait-result" src="{{portrait.result.url}}" mode="aspectFit" /><view class="status-line" wx:if="{{portrait}}">{{portraitLabel}}</view><view class="tip" wx:if="{{portrait && portrait.status !== 'empty'}}">申请姿势：{{portraitPoseLabel}}</view><view class="review-note" wx:if="{{portrait.reason}}">{{portrait.reason}}</view><view class="review-note" wx:if="{{portraitError}}">{{portraitError}}<button class="memory-button button-secondary" bindtap="loadPortrait">重新读取申请</button></view><button wx:if="{{!portraitForm}}" class="memory-button button-secondary" bindtap="openPortrait" disabled="{{managing || uploading || saving || !portrait || portrait.status === 'pending'}}">{{portrait.status === 'approved' ? '申请更新画像' : portrait.status === 'pending' ? '画像正在制作中' : '申请专属宠物画像'}}</button>
      <view wx:if="{{portraitForm}}"><view class="portrait-pose-label">希望它以怎样的姿势陪伴你？</view><view class="portrait-pose-options"><button class="memory-button portrait-pose {{portraitPose === 'sitting' ? 'selected' : ''}}" data-pose="sitting" bindtap="selectPortraitPose" disabled="{{managing || uploading || saving || mediaSaving}}"><text class="pose-title">乖巧坐着</text><text class="pose-caption">像从前一样等你</text></button><button class="memory-button portrait-pose {{portraitPose === 'sleeping' ? 'selected' : ''}}" data-pose="sleeping" bindtap="selectPortraitPose" disabled="{{managing || uploading || saving || mediaSaving}}"><text class="pose-title">安心趴睡</text><text class="pose-caption">在熟悉的梦里休息</text></button></view><view class="reference-grid"><view class="reference-item"><view class="reference-title">正面照片</view><image wx:if="{{portraitPhotos.front}}" class="reference-image" src="{{portraitPhotos.front.url}}" mode="aspectFill" /><view wx:else class="reference-placeholder"><view class="remix-icon ri-image-line"></view><text>选择正面照片</text></view><button class="memory-button button-secondary reference-upload" data-side="front" bindtap="addPortraitPhoto" disabled="{{managing || uploading || saving || mediaSaving}}">{{portraitPhotos.front ? '更换正面照' : '上传正面照'}}</button></view><view class="reference-item"><view class="reference-title">侧面照片</view><image wx:if="{{portraitPhotos.side}}" class="reference-image" src="{{portraitPhotos.side.url}}" mode="aspectFill" /><view wx:else class="reference-placeholder"><view class="remix-icon ri-image-line"></view><text>选择侧面照片</text></view><button class="memory-button button-secondary reference-upload" data-side="side" bindtap="addPortraitPhoto" disabled="{{managing || uploading || saving || mediaSaving}}">{{portraitPhotos.side ? '更换侧面照' : '上传侧面照'}}</button></view></view><view class="tip">尽量选择清晰、完整的照片，保留毛色、花纹、耳朵和尾巴细节。原始照片仅主人和有权限的审核员可见，完成后的画像会公开展示。</view><textarea class="portrait-note" maxlength="500" placeholder="它有哪些特别的花纹、神态或小习惯？（选填）" value="{{portraitNote}}" bindinput="inputPortraitNote" disabled="{{managing || uploading || saving || mediaSaving}}" /><view class="upload-progress" wx:if="{{uploading}}">{{uploadTip}}</view><button class="memory-button button-primary" bindtap="submitPortrait" disabled="{{managing || uploading || saving || !portraitPhotos.front || !portraitPhotos.side}}" loading="{{saving}}">提交画像制作申请</button><button class="memory-button button-quiet" bindtap="closePortrait" disabled="{{managing || uploading || saving || mediaSaving}}">稍后再申请</button></view>
    </view>
  </block>
</view>
<template name="story"><view class="card story-card" wx:if="{{content}}"><view class="section-kicker">OUR MEMORIES</view><view class="section-title">那些一起走过的时光</view><block wx:if="{{content.mode === 'novel'}}"><view class="novel-reader"><view class="chapter-reader-kicker">{{readerSectionLabel}}</view><view class="chapter-reader-title">{{readerChapterTitle}}</view><view class="story-text reader-page" user-select>{{readerPageText}}</view><view class="reader-page-count">第 {{readerPageIndex + 1}} 页 / 共 {{readerPageCount}} 页</view><view class="reader-controls"><button class="reader-arrow" data-direction="prev" bindtap="moveReader" disabled="{{!readerCanPrev}}">上一页</button><text>{{readerChapterIndex + 1}} / {{readerSectionCount}} 节</text><button class="reader-arrow" data-direction="next" bindtap="moveReader" disabled="{{!readerCanNext}}">下一页</button></view></view></block><text wx:else class="story-text" user-select>{{content.text || '有些思念，藏在照片和声音里。'}}</text><view class="photos"><image class="memory-photo" wx:for="{{content.images}}" wx:key="uploadId" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="showImage" /></view><video class="memory-video" wx:for="{{content.videos}}" wx:key="uploadId" src="{{item.url}}" controls /><button wx:if="{{content.music}}" class="memory-button button-secondary music-play" data-url="{{content.music.url}}" bindtap="playMusic">{{playing ? '暂停旋律' : '播放陪伴的旋律'}} · {{content.music.name}}</button></view></template>
