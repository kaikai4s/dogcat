/** app.wxss - 粉色宠护全局视觉系统 **/

page {
  --theme-bg: linear-gradient(180deg, #fff0f5 0%, #fcf3f6 40%, #f7f7f9 100%);
  --theme-bg-soft: #fff7fa;
  --theme-card-bg: rgba(255, 255, 255, 0.96);
  --theme-primary: #f43f6b;
  --theme-primary-2: #ff7a93;
  --theme-primary-soft: #fff0f5;
  --theme-text: #2b2528;
  --theme-title: #1f1b1d;
  --theme-muted: #969196;
  --theme-border: rgba(255, 129, 161, 0.12);
  --theme-shadow: rgba(116, 91, 101, 0.1);
  --theme-hero: linear-gradient(135deg, #ffd2df 0%, #ffc0d2 58%, #ffe7ef 100%);
  --theme-hero-text: #7c3b12;
  --app-font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --app-title-font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  min-height: 100vh;
  background: var(--theme-bg);
  color: var(--theme-text);
  font-family: var(--app-font-family);
  font-size: 28rpx;
}

.font-system {
  --app-font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --app-title-font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.font-rounded {
  --app-font-family: "AppRoundedFont", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
  --app-title-font-family: "AppRoundedTitleFont", "AppRoundedFont", "Microsoft YaHei UI", "PingFang SC", sans-serif;
}

.font-clean {
  --app-font-family: "AppKaiFont", "Kaiti SC", "STKaiti", "KaiTi", "PingFang SC", cursive, sans-serif;
  --app-title-font-family: "AppKaiTitleFont", "AppKaiFont", "Kaiti SC", "STKaiti", "KaiTi", cursive, sans-serif;
}

.font-serif {
  --app-font-family: "AppSongFont", "Songti SC", "STSong", "SimSun", serif;
  --app-title-font-family: "AppSongTitleFont", "AppSongFont", "Songti SC", "STSong", serif;
}

.font-cute {
  --app-font-family: "AppCuteFont", "Kaiti SC", "STKaiti", "KaiTi", "PingFang SC", cursive, sans-serif;
  --app-title-font-family: "AppCuteTitleFont", "AppCuteFont", "Kaiti SC", "STKaiti", "KaiTi", cursive, sans-serif;
}

.font-system,
.font-rounded,
.font-clean,
.font-serif,
.font-cute {
  font-family: var(--app-font-family);
}

.theme-night {
  position: relative;
  overflow: hidden;
  --theme-bg: linear-gradient(180deg, #15131d 0%, #1f2030 48%, #11131b 100%);
  --theme-bg-soft: #242638;
  --theme-card-bg: rgba(36, 38, 54, 0.96);
  --theme-primary: #7c8cff;
  --theme-primary-2: #a78bfa;
  --theme-primary-soft: #2e335f;
  --theme-text: #f5f4fb;
  --theme-title: #ffffff;
  --theme-muted: #b9b6c8;
  --theme-border: rgba(124, 140, 255, 0.24);
  --theme-shadow: rgba(0, 0, 0, 0.32);
  --theme-hero: linear-gradient(135deg, #20233a 0%, #373154 58%, #181927 100%);
  --theme-hero-text: #ffffff;
}

.theme-sunshine {
  --theme-bg: linear-gradient(180deg, #fff6d8 0%, #fff9eb 46%, #fffef8 100%);
  --theme-bg-soft: #fff7dc;
  --theme-card-bg: rgba(255, 255, 255, 0.96);
  --theme-primary: #f59e0b;
  --theme-primary-2: #facc15;
  --theme-primary-soft: #fff3bf;
  --theme-text: #33270f;
  --theme-title: #241a08;
  --theme-muted: #8a7550;
  --theme-border: rgba(245, 158, 11, 0.22);
  --theme-shadow: rgba(162, 113, 23, 0.12);
  --theme-hero: linear-gradient(135deg, #ffe082 0%, #ffc857 58%, #fff1b8 100%);
  --theme-hero-text: #684100;
}

.theme-warm {
  --theme-bg: linear-gradient(180deg, #fff2e8 0%, #fff7ef 48%, #fffaf6 100%);
  --theme-bg-soft: #fff3ec;
  --theme-card-bg: rgba(255, 255, 255, 0.96);
  --theme-primary: #ea6a3d;
  --theme-primary-2: #fb923c;
  --theme-primary-soft: #ffe5d6;
  --theme-text: #332019;
  --theme-title: #25140f;
  --theme-muted: #8a6b60;
  --theme-border: rgba(234, 106, 61, 0.2);
  --theme-shadow: rgba(144, 79, 54, 0.12);
  --theme-hero: linear-gradient(135deg, #ffd7c2 0%, #ffb894 58%, #fff0e5 100%);
  --theme-hero-text: #743018;
}

.page.theme-day,
.page.theme-night,
.page.theme-sunshine,
.page.theme-warm,
.profile-settings-page.theme-day,
.profile-settings-page.theme-night,
.profile-settings-page.theme-sunshine,
.profile-settings-page.theme-warm {
  background: var(--theme-bg);
  color: var(--theme-text);
}

view,
text,
input,
textarea,
button,
navigator,
image,
camera {
  box-sizing: border-box;
  font-family: inherit;
}

.font-system view,
.font-system text,
.font-system input,
.font-system textarea,
.font-system button,
.font-system navigator,
.font-rounded view,
.font-rounded text,
.font-rounded input,
.font-rounded textarea,
.font-rounded button,
.font-rounded navigator,
.font-clean view,
.font-clean text,
.font-clean input,
.font-clean textarea,
.font-clean button,
.font-clean navigator,
.font-serif view,
.font-serif text,
.font-serif input,
.font-serif textarea,
.font-serif button,
.font-serif navigator,
.font-cute view,
.font-cute text,
.font-cute input,
.font-cute textarea,
.font-cute button,
.font-cute navigator {
  font-family: var(--app-font-family);
}

.font-rounded {
  letter-spacing: 0.5rpx;
}

.font-clean {
  letter-spacing: 0.2rpx;
}

.font-serif {
  letter-spacing: 0.8rpx;
}

.font-cute {
  letter-spacing: 1rpx;
}

.brand,
.title,
.subtitle,
.hero-title,
.hero-kicker,
.badge,
.strong,
.role-name,
.service-title,
.header-title,
.profile-name {
  font-family: var(--app-title-font-family);
}

.font-rounded .title,
.font-rounded .hero-title,
.font-cute .title,
.font-cute .hero-title {
  letter-spacing: 2rpx;
}

.font-clean .title,
.font-clean .hero-title,
.font-serif .title,
.font-serif .hero-title {
  letter-spacing: 1.4rpx;
}

button {
  background: initial;
  padding: 0;
  margin: 0;
  line-height: 1.2;
  font-size: 28rpx;
}

button:focus { outline: 0; }
button::after { border: none; }

.page {
  position: relative;
  min-height: 100vh;
  padding: 36rpx 30rpx 170rpx;
  overflow: hidden;
}

.top-nav {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 0 0 24rpx;
}

.page::before,
.dashboard-page::before,
.login-page::before {
  content: "";
  position: absolute;
  right: -120rpx;
  top: 150rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 148, 172, 0.28) 0 12rpx, transparent 13rpx) 0 0 / 48rpx 48rpx;
  opacity: 0.55;
  pointer-events: none;
}

.page::after {
  content: "🐾";
  position: absolute;
  left: 44rpx;
  top: 210rpx;
  color: rgba(244, 63, 107, 0.09);
  font-size: 92rpx;
  transform: rotate(-12deg);
  pointer-events: none;
}

.theme-night::before {
  content: "";
  position: absolute;
  right: 0;
  top: 118rpx;
  width: 100%;
  height: 520rpx;
  border-radius: 0;
  background:
    radial-gradient(circle, rgba(255, 255, 255, 0.92) 0 3rpx, transparent 4rpx) 12% 18% / 180rpx 170rpx,
    radial-gradient(circle, rgba(167, 139, 250, 0.72) 0 4rpx, transparent 5rpx) 72% 10% / 230rpx 210rpx,
    radial-gradient(circle, rgba(124, 140, 255, 0.7) 0 3rpx, transparent 4rpx) 38% 58% / 210rpx 190rpx,
    radial-gradient(circle, rgba(255, 255, 255, 0.56) 0 2rpx, transparent 3rpx) 86% 54% / 150rpx 130rpx,
    radial-gradient(circle at 82% 18%, #fff8cf 0 34rpx, transparent 35rpx);
  opacity: 0.78;
  pointer-events: none;
}

.theme-night::after {
  content: "✦  ✧   ✦";
  position: absolute;
  left: 44rpx;
  top: 180rpx;
  color: rgba(255, 248, 207, 0.78);
  font-size: 38rpx;
  letter-spacing: 28rpx;
  transform: rotate(-8deg);
  text-shadow: 160rpx 76rpx 0 rgba(255,255,255,0.45), 420rpx -20rpx 0 rgba(167,139,250,0.52), 540rpx 138rpx 0 rgba(255,255,255,0.36);
  pointer-events: none;
}

.page.theme-night::after {
  content: "✦  ✧   ✦";
}

.login-page {
  padding-top: 84rpx;
  background: linear-gradient(180deg, #ffdbe6 0%, #fff5f8 56%, #fff 100%);
}

.hero,
.dashboard-header {
  position: relative;
  z-index: 1;
  margin-bottom: 32rpx;
}

.dashboard-header {
  padding: 10rpx 6rpx 2rpx;
}

.brand {
  font-size: 68rpx;
  line-height: 1.08;
  font-weight: 900;
  color: var(--theme-title);
  letter-spacing: 1rpx;
}

.title {
  font-size: 46rpx;
  line-height: 1.22;
  font-weight: 900;
  color: var(--theme-title);
  margin-bottom: 14rpx;
}

.subtitle {
  font-size: 32rpx;
  font-weight: 850;
  color: var(--theme-text);
  margin: 36rpx 0 18rpx;
}

.tip,
.muted,
.empty {
  color: var(--theme-muted);
  font-size: 26rpx;
  line-height: 1.55;
}

.empty {
  min-height: 460rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  text-align: center;
  padding: 72rpx 32rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 18rpx 46rpx rgba(108, 91, 99, 0.08);
}

.empty::before {
  content: "🐶";
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #e9f5ff 0%, #f9fbff 100%);
  font-size: 82rpx;
  box-shadow: inset 0 -16rpx 36rpx rgba(120, 178, 238, 0.12);
}

.strong {
  font-size: 32rpx;
  font-weight: 850;
  color: var(--theme-text);
  line-height: 1.45;
}

.price {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--theme-primary);
}

.card,
.role,
.field,
.notice,
.soft-panel,
.quick-card {
  position: relative;
  z-index: 1;
  background: var(--theme-card-bg);
  border-radius: 34rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 18rpx 48rpx var(--theme-shadow);
  border: 1rpx solid var(--theme-border);
}

.card.compact { padding: 22rpx; }

.interactive,
.role,
.action-card,
.order-card,
.task-card,
.audit-card,
.incident-card,
.quick-card {
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.interactive:active,
.role:active,
.action-card:active,
.order-card:active,
.task-card:active,
.audit-card:active,
.incident-card:active,
.quick-card:active {
  transform: scale(0.985);
  box-shadow: 0 8rpx 26rpx rgba(244, 63, 107, 0.12);
}

.notice {
  background: linear-gradient(135deg, #fff6d9 0%, #fff 100%);
  color: #a06b00;
  box-shadow: 0 12rpx 32rpx rgba(255, 190, 72, 0.12);
}

.notice.danger,
.warn {
  background: linear-gradient(135deg, #fff0f4 0%, #fff 100%);
  color: #d63158;
}

.hero-carousel-wrapper {
  padding: 0 0 28rpx 0 !important;
  min-height: 480rpx;
  position: relative;
  overflow: hidden;
  margin-top: -36rpx;
  background: linear-gradient(180deg, #ffdce5 0%, #fff0f4 60%, rgba(255, 240, 244, 0) 100%);
}

.hero-carousel-wrapper::after {
  content: "🐶";
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  font-size: 64rpx;
  opacity: 0.25;
  z-index: 8;
  filter: drop-shadow(0 4rpx 10rpx rgba(0, 0, 0, 0.1));
  pointer-events: none;
}

.hero-carousel-wrapper .hero-top {
  position: relative;
  margin: 20rpx 34rpx 20rpx;
  z-index: 10;
  pointer-events: auto;
}

.hero-swiper {
  width: 100%;
  height: 420rpx;
}

.hero-swiper-item {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.slide-media-container {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 12rpx 36rpx rgba(244, 63, 107, 0.12);
  transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.slide-media-container.active-slide {
  transform: scale(1);
  opacity: 1;
  box-shadow: 0 16rpx 40rpx rgba(244, 63, 107, 0.18);
}

.slide-media-container.inactive-slide {
  transform: scale(0.88);
  opacity: 0.65;
}

.slide-image,
.slide-video,
.slide-video-box {
  width: 100%;
  height: 100%;
}

.video-poster-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
}

.video-play-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
  color: var(--theme-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  padding-left: 6rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.25);
}

.slide-overlay-content {
  position: absolute;
  left: 34rpx;
  right: 34rpx;
  bottom: 44rpx;
  z-index: 5;
  pointer-events: none;
}

.slide-overlay-content .hero-kicker {
  display: inline-block;
  margin-top: 0;
  background: rgba(255, 242, 168, 0.95);
}

.slide-overlay-content .hero-subtitle {
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
  margin-top: 12rpx;
}

.carousel-dots {
  position: absolute;
  bottom: 18rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  z-index: 10;
}

.carousel-dots .dot-item {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
}

.carousel-dots .dot-item.active {
  width: 32rpx;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.hero-carousel-wrapper .pet-hero::after {
  display: none !important;
}

.pet-hero {
  position: relative;
  z-index: 1;
  min-height: 430rpx;
  padding: 42rpx 34rpx;
  margin: 0 -30rpx 28rpx;
  overflow: hidden;
  background: var(--theme-hero);
  border-bottom-left-radius: 46rpx;
  border-bottom-right-radius: 46rpx;
}

.pet-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, rgba(244, 63, 107, 0.14) 0 12rpx, transparent 13rpx) 0 0 / 48rpx 48rpx;
  opacity: 0.5;
}

.pet-hero::after {
  content: "🐶";
  position: absolute;
  right: 20rpx;
  bottom: 10rpx;
  font-size: 88rpx;
  opacity: 0.35;
  filter: drop-shadow(0 8rpx 12rpx rgba(169, 98, 62, 0.1));
  pointer-events: none;
}

.hero-location,
.hero-kicker,
.hero-title,
.hero-subtitle,
.hero-chip {
  position: relative;
  z-index: 1;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-location {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 54rpx;
  max-width: 330rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #4e323c;
  background: rgba(255, 255, 255, 0.76);
  font-weight: 750;
  box-shadow: 0 8rpx 18rpx rgba(244, 63, 107, 0.1);
}

.location-pin {
  font-size: 20rpx;
  flex-shrink: 0;
}

.location-name {
  max-width: 220rpx;
  font-size: 20rpx;
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-tip {
  max-width: 220rpx;
  margin-top: 2rpx;
  color: #8a727c;
  font-size: 16rpx;
  line-height: 1.05;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-arrow {
  color: #5c454e;
  font-size: 18rpx;
  flex-shrink: 0;
}

.hero-mini-pill {
  position: relative;
  z-index: 1;
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  color: #8a5500;
  background: #fff2a8;
  font-size: 20rpx;
  font-weight: 850;
  white-space: nowrap;
}

.hero-kicker {
  display: inline-flex;
  margin-top: 48rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff2a8;
  color: #8a5500;
  font-size: 26rpx;
  font-weight: 900;
  transform: rotate(-3deg);
}

.hero-title {
  margin-top: 18rpx;
  max-width: 440rpx;
  font-size: 56rpx;
  line-height: 1.12;
  font-weight: 950;
  color: var(--theme-hero-text);
  text-shadow: 0 5rpx 0 rgba(255, 255, 255, 0.55);
}

.hero-subtitle {
  margin-top: 18rpx;
  color: #573f48;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-chip {
  display: inline-flex;
  margin-top: 28rpx;
  padding: 12rpx 22rpx;
  border: 4rpx solid #2a2428;
  border-radius: 999rpx;
  color: #2a2428;
  background: rgba(255, 255, 255, 0.35);
  font-weight: 900;
}

.pet-search {
  position: relative;
  z-index: 1;
  min-height: 84rpx;
  padding: 0 18rpx 0 34rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: #f6f6f7;
  border-radius: 999rpx;
  color: #aaa5aa;
  font-size: 28rpx;
}

.search-icon { font-size: 38rpx; color: #b8b4b8; }
.search-button {
  min-width: 126rpx;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--theme-primary);
  font-weight: 850;
}

.grid,
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
}

.stats-grid,
.evidence-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: linear-gradient(145deg, #fff 0%, #fff2f6 100%);
  border-radius: 30rpx;
  padding: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(116, 91, 101, 0.09);
}

.stat-number {
  font-size: 46rpx;
  font-weight: 950;
  color: var(--theme-primary);
}

.stat-label {
  margin-top: 8rpx;
  color: var(--theme-muted);
  font-size: 24rpx;
}

.action-card,
.quick-card {
  min-height: 172rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: linear-gradient(145deg, #fff 0%, #fff7fa 100%);
}

.service-card {
  min-height: 286rpx;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #fff;
}

.service-card .action-icon {
  width: 136rpx;
  height: 136rpx;
  border-radius: 40rpx;
  margin: 0 0 18rpx;
  font-size: 72rpx;
}

.action-icon,
.role-mark,
.pet-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ffe1e9 0%, #fff4c6 100%);
  color: var(--theme-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.pet-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin: 0 24rpx 0 0;
  font-size: 58rpx;
  flex-shrink: 0;
  box-shadow: inset 0 -10rpx 28rpx rgba(244, 63, 107, 0.1);
}

.row,
.info-row,
.between {
  display: flex;
  align-items: center;
}

.between,
.info-row { justify-content: space-between; }
.info-list { overflow: hidden; }

.info-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1edf0;
  gap: 24rpx;
}

.info-row:last-child { border-bottom: none; }

.label {
  color: var(--theme-muted);
  font-size: 26rpx;
  flex-shrink: 0;
}

.value {
  color: var(--theme-text);
  font-size: 27rpx;
  text-align: right;
  word-break: break-all;
}

.primary,
.ghost,
.danger,
.mini-btn {
  width: 100%;
  min-height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 850;
  margin: 22rpx 0;
}

.primary {
  color: #fff;
  background: linear-gradient(135deg, var(--theme-primary-2) 0%, var(--theme-primary) 100%);
  box-shadow: 0 16rpx 34rpx var(--theme-shadow);
}

.ghost {
  color: var(--theme-primary);
  background: #fff;
  border: 2rpx solid var(--theme-border);
}

.danger {
  color: #fff;
  background: linear-gradient(135deg, #ff6b7d 0%, #d92d4e 100%);
  box-shadow: 0 16rpx 34rpx rgba(217, 45, 78, 0.25);
}

.mini-btn,
button[size="mini"] {
  width: auto;
  min-height: 58rpx;
  padding: 0 28rpx;
  margin: 18rpx 0 0;
  border-radius: 999rpx;
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
  font-size: 24rpx;
}

.form,
.form-card {
  position: relative;
  z-index: 1;
}

input,
textarea,
.field {
  width: 100%;
  min-height: 94rpx;
  background: #f8f8f9;
  border-radius: 26rpx;
  border: 1rpx solid rgba(244, 63, 107, 0.08);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  color: var(--theme-text);
}

textarea {
  min-height: 188rpx;
  line-height: 1.5;
}

.field {
  display: flex;
  align-items: center;
  color: var(--theme-primary);
  background: var(--theme-bg-soft);
}

.tabs,
.status-tabs {
  display: flex;
  gap: 18rpx;
  margin: 12rpx 0 26rpx;
}

.status-tabs {
  gap: 0;
  justify-content: space-between;
  padding: 0 4rpx 18rpx;
  border-bottom: 1rpx solid #f0edf0;
}

.status-tab {
  position: relative;
  color: #666064;
  font-size: 30rpx;
  font-weight: 750;
  padding-bottom: 18rpx;
}

.status-tab.active {
  color: #232024;
  font-weight: 950;
}

.status-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 42rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--theme-primary);
  transform: translateX(-50%);
}

.tab {
  flex: 1;
  min-height: 80rpx;
  border-radius: 999rpx;
  background: var(--theme-bg-soft);
  color: var(--theme-primary);
  font-weight: 800;
  border: 2rpx solid var(--theme-border);
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: var(--theme-primary-soft);
  color: var(--theme-primary);
  font-size: 22rpx;
  font-weight: 850;
}

.badge.danger {
  background: #ffecef;
  color: #d63158;
}

.chip-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.chip {
  min-height: 44rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 12rpx;
  color: #e0a01a;
  border: 2rpx solid #efbd44;
  font-size: 24rpx;
  font-weight: 700;
}

.chip.pink {
  color: #d35a75;
  border-color: #e18498;
}

.chip.blue {
  color: #4b9bdd;
  border-color: #68afe8;
}

.order-card {
  overflow: hidden;
}

.order-card-head {
  align-items: flex-start;
  gap: 18rpx;
}

.order-card-address {
  margin-top: 12rpx;
}

.order-person {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
}

.order-person .strong,
.order-person .muted {
  word-break: break-word;
}

.order-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.82);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--theme-primary);
  font-size: 42rpx;
  box-shadow: 0 12rpx 28rpx rgba(244, 63, 107, 0.12);
}

.sitter-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #ffe3ec 0%, #fff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--theme-primary);
  overflow: hidden;
}

.order-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 10rpx;
  height: 100%;
  background: linear-gradient(180deg, var(--theme-primary-2) 0%, var(--theme-primary) 100%);
}

.timeline {
  position: relative;
  padding-left: 28rpx;
}

.timeline-item {
  position: relative;
  padding: 0 0 28rpx 28rpx;
  border-left: 2rpx solid rgba(244, 63, 107, 0.18);
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: -10rpx;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--theme-primary);
  box-shadow: 0 0 0 8rpx rgba(244, 63, 107, 0.15);
}

.camera {
  width: 100%;
  height: 560rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background: #222;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.15);
}

.camera-shell {
  padding: 14rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.76);
  margin-bottom: 24rpx;
}

.actions { margin-top: 24rpx; }

.role {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.role-mark { margin: 0; }

.row .action-icon,
.row .pet-avatar {
  margin-bottom: 0;
}

.role-name {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--theme-text);
}

.role-tip {
  margin-top: 8rpx;
  color: var(--theme-muted);
  font-size: 25rpx;
}

.bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 9999;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  padding: 18rpx 10rpx 10rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 34rpx;
  box-shadow: 0 14rpx 38rpx rgba(116, 91, 101, 0.16);
  border: 1rpx solid rgba(244, 63, 107, 0.1);
  pointer-events: auto;
}

.nav-item {
  min-height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #a8a4ac;
  font-size: 24rpx;
  pointer-events: auto;
}

.nav-icon {
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto 6rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #c7c3cc;
}

.nav-item.active {
  color: var(--theme-primary);
  font-weight: 850;
}

.nav-item.active .nav-icon {
  border-color: var(--theme-primary);
  background: var(--theme-primary-soft);
}

.profile-page {
  padding-top: 32rpx;
}

.menu-list .subtitle {
  margin: 0 0 18rpx;
}

.profile-hero {
  position: relative;
  z-index: 1;
  min-height: 300rpx;
  margin: -36rpx -30rpx 28rpx;
  padding: 96rpx 30rpx 46rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(180deg, #ffd7e2 0%, #fff3f7 100%);
  overflow: hidden;
}

.profile-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, rgba(244, 63, 107, 0.12) 0 12rpx, transparent 13rpx) 12rpx 6rpx / 76rpx 76rpx;
}

.profile-hero::after {
  content: "🐾";
  position: absolute;
  right: 120rpx;
  bottom: 26rpx;
  color: rgba(244, 63, 107, 0.12);
  font-size: 74rpx;
}

.profile-avatar,
.profile-main,
.checkin-pill {
  position: relative;
  z-index: 1;
}

.profile-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--theme-primary);
  font-size: 72rpx;
  box-shadow: 0 16rpx 36rpx rgba(244, 63, 107, 0.12);
}

.profile-main {
  flex: 1;
}

.profile-name {
  font-size: 54rpx;
  font-weight: 950;
  color: #111;
  line-height: 1.15;
}

.profile-points {
  margin-top: 14rpx;
  color: #686267;
  font-size: 28rpx;
}

.checkin-pill {
  min-width: 136rpx;
  min-height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 850;
  background: linear-gradient(135deg, #ff9a53 0%, #f43f8b 100%);
  box-shadow: 0 12rpx 30rpx rgba(244, 63, 107, 0.25);
}

.profile-card {
  min-height: 128rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.profile-card .action-icon {
  margin: 0;
  flex-shrink: 0;
}

.reward-banner {
  min-height: 178rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fff3c8 0%, #ffe0e8 58%, #fff 100%);
}

.menu-list {
  padding: 10rpx 30rpx;
}

.menu-item {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0edf0;
  color: var(--theme-text);
  font-size: 32rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--theme-primary);
  border: 3rpx solid #3f3b40;
  font-size: 24rpx;
  font-weight: 850;
}

.menu-arrow {
  color: #aaa5aa;
  font-size: 56rpx;
  line-height: 1;
}

/* 首页全新视觉风格样式 */
.hero-services-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 10rpx 0 24rpx;
}

.hero-service-card {
  position: relative;
  min-height: 180rpx;
  border-radius: 32rpx;
  padding: 30rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.hero-service-card.pink-theme {
  background: linear-gradient(135deg, #ffffff 0%, #fff0f5 100%);
  border: 2rpx solid #ffe1eb;
}

.hero-service-card.blue-theme {
  background: linear-gradient(135deg, #ffffff 0%, #f0f7ff 100%);
  border: 2rpx solid #e1efff;
}

.card-text-box {
  position: relative;
  z-index: 2;
}

.service-title {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--theme-title);
  margin-bottom: 8rpx;
}

.service-sub {
  font-size: 22rpx;
  color: #8c8287;
  font-weight: 500;
}

.service-emoji {
  font-size: 72rpx;
  line-height: 1;
  opacity: 0.9;
  filter: drop-shadow(0 6rpx 12rpx rgba(0,0,0,0.08));
}

/* 快捷金刚导航栏 */
.nav-quick-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 16rpx !important;
  border-radius: 32rpx !important;
  background: #ffffff !important;
}

.quick-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.nav-icon-box {
  width: 90rpx;
  height: 90rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon-box.pink { background: #fff0f4; }
.nav-icon-box.orange { background: #fff6ed; }
.nav-icon-box.red { background: #ffeef0; }
.nav-icon-box.purple { background: #f6f0ff; }
.nav-icon-box.green { background: #eefbf4; }

.icon-emoji {
  font-size: 44rpx;
}

.nav-label {
  font-size: 24rpx;
  color: #383236;
  font-weight: 600;
}

/* 历史数据统计看板 */
.history-stats-card {
  border-radius: 32rpx !important;
  padding: 28rpx !important;
}

.card-header {
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--theme-title);
}

.header-more {
  font-size: 24rpx;
  color: #c29d68;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.stats-three-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.stat-box {
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat-box.yellow-bg { background: #fffbe8; }
.stat-box.pink-bg { background: #fff2f5; }
.stat-box.blue-bg { background: #eff7ff; }

.stat-icon-circle {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-bottom: 12rpx;
}

.stat-icon-circle.yellow { background: #ffe9a3; }
.stat-icon-circle.pink { background: #ffd4df; }
.stat-icon-circle.blue { background: #cce5ff; }

.stat-num {
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.stat-num.yellow-text { color: #d99200; }
.stat-num.pink-text { color: #e0486e; }
.stat-num.blue-text { color: #2980b9; }

.stat-unit {
  font-size: 22rpx;
  font-weight: normal;
}

.stat-desc {
  font-size: 22rpx;
  color: #7a7377;
  margin-top: 6rpx;
}

/* 优选宠托师卡片 */
.sitter-featured-card {
  border-radius: 32rpx !important;
  padding: 28rpx !important;
}

.sitter-item-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.sitter-avatar-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ffe1e9 0%, #ffd4a3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sitter-avatar-emoji {
  font-size: 56rpx;
}

.sitter-main-info {
  flex: 1;
  min-width: 0;
}

.sitter-name {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--theme-title);
}

.sitter-distance {
  font-size: 22rpx;
  color: #999;
}

.sitter-rating-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  margin: 6rpx 0;
}

.sitter-rating-line .score {
  font-weight: 800;
  color: var(--theme-title);
}

.sitter-rating-line .divider { color: #ddd; }
.sitter-rating-line .count { color: #888; }

.sitter-bio {
  font-size: 24rpx;
  color: #666;
