/** app.wxss - 粉色宠护全局视觉系统 **/

page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff3f7 0%, #fff8fb 42%, #f7f7f8 100%);
  color: #2b2528;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

view,
text,
input,
textarea,
button,
navigator,
image,
camera {
  box-sizing: border-box;
}

button {
  background: initial;
  padding: 0;
  margin: 0;
  line-height: 1.2;
  font-size: 28rpx;
}

button:focus { outline: 0; }
button::after { border: none; }

.page {
  position: relative;
  min-height: 100vh;
  padding: 36rpx 30rpx 170rpx;
  overflow: hidden;
}

.top-nav {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 0 0 24rpx;
}

.nav-round {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.96);
  color: #f43f6b;
  font-size: 34rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 30rpx rgba(116, 91, 101, 0.12);
  border: 1rpx solid rgba(244, 63, 107, 0.1);
}

.nav-round:active {
  transform: scale(0.96);
}

.page::before,
.dashboard-page::before,
.login-page::before {
  content: "";
  position: absolute;
  right: -120rpx;
  top: 150rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 148, 172, 0.28) 0 12rpx, transparent 13rpx) 0 0 / 48rpx 48rpx;
  opacity: 0.55;
  pointer-events: none;
}

.page::after {
  content: "🐾";
  position: absolute;
  left: 44rpx;
  top: 210rpx;
  color: rgba(244, 63, 107, 0.09);
  font-size: 92rpx;
  transform: rotate(-12deg);
  pointer-events: none;
}

.login-page {
  padding-top: 84rpx;
  background: linear-gradient(180deg, #ffdbe6 0%, #fff5f8 56%, #fff 100%);
}

.hero,
.dashboard-header {
  position: relative;
  z-index: 1;
  margin-bottom: 32rpx;
}

.dashboard-header {
  padding: 10rpx 6rpx 2rpx;
}

.brand {
  font-size: 68rpx;
  line-height: 1.08;
  font-weight: 900;
  color: #1f1b1d;
  letter-spacing: 1rpx;
}

.title {
  font-size: 46rpx;
  line-height: 1.22;
  font-weight: 900;
  color: #1f1b1d;
  margin-bottom: 14rpx;
}

.subtitle {
  font-size: 32rpx;
  font-weight: 850;
  color: #2b2528;
  margin: 36rpx 0 18rpx;
}

.tip,
.muted,
.empty {
  color: #969196;
  font-size: 26rpx;
  line-height: 1.55;
}

.empty {
  min-height: 460rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  text-align: center;
  padding: 72rpx 32rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow: 0 18rpx 46rpx rgba(108, 91, 99, 0.08);
}

.empty::before {
  content: "🐶";
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #e9f5ff 0%, #f9fbff 100%);
  font-size: 82rpx;
  box-shadow: inset 0 -16rpx 36rpx rgba(120, 178, 238, 0.12);
}

.strong {
  font-size: 32rpx;
  font-weight: 850;
  color: #262125;
  line-height: 1.45;
}

.price {
  font-size: 48rpx;
  font-weight: 900;
  color: #f43f6b;
}

.card,
.role,
.field,
.notice,
.soft-panel,
.quick-card {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 34rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 18rpx 48rpx rgba(116, 91, 101, 0.1);
  border: 1rpx solid rgba(255, 129, 161, 0.12);
}

.card.compact { padding: 22rpx; }

.interactive,
.role,
.action-card,
.order-card,
.task-card,
.audit-card,
.incident-card,
.quick-card {
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.interactive:active,
.role:active,
.action-card:active,
.order-card:active,
.task-card:active,
.audit-card:active,
.incident-card:active,
.quick-card:active {
  transform: scale(0.985);
  box-shadow: 0 8rpx 26rpx rgba(244, 63, 107, 0.12);
}

.notice {
  background: linear-gradient(135deg, #fff6d9 0%, #fff 100%);
  color: #a06b00;
  box-shadow: 0 12rpx 32rpx rgba(255, 190, 72, 0.12);
}

.notice.danger,
.warn {
  background: linear-gradient(135deg, #fff0f4 0%, #fff 100%);
  color: #d63158;
}

.pet-hero {
  position: relative;
  z-index: 1;
  min-height: 430rpx;
  padding: 42rpx 34rpx;
  margin: 0 -30rpx 28rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #ffd2df 0%, #ffc0d2 58%, #ffe7ef 100%);
  border-bottom-left-radius: 46rpx;
  border-bottom-right-radius: 46rpx;
}

.pet-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, rgba(244, 63, 107, 0.14) 0 12rpx, transparent 13rpx) 0 0 / 48rpx 48rpx;
  opacity: 0.5;
}

.pet-hero::after {
  content: "🐕";
  position: absolute;
  right: 42rpx;
  bottom: 16rpx;
  font-size: 178rpx;
  filter: drop-shadow(0 18rpx 20rpx rgba(169, 98, 62, 0.16));
}

.hero-location,
.hero-kicker,
.hero-title,
.hero-subtitle,
.hero-chip {
  position: relative;
  z-index: 1;
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-location {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  min-height: 54rpx;
  max-width: 330rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #4e323c;
  background: rgba(255, 255, 255, 0.76);
  font-weight: 750;
  box-shadow: 0 8rpx 18rpx rgba(244, 63, 107, 0.1);
}

.location-pin {
  font-size: 20rpx;
  flex-shrink: 0;
}

.location-name {
  max-width: 220rpx;
  font-size: 20rpx;
  line-height: 1.1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-tip {
  max-width: 220rpx;
  margin-top: 2rpx;
  color: #8a727c;
  font-size: 16rpx;
  line-height: 1.05;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-arrow {
  color: #5c454e;
  font-size: 18rpx;
  flex-shrink: 0;
}

.hero-mini-pill {
  position: relative;
  z-index: 1;
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  color: #8a5500;
  background: #fff2a8;
  font-size: 20rpx;
  font-weight: 850;
  white-space: nowrap;
}

.hero-kicker {
  display: inline-flex;
  margin-top: 48rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff2a8;
  color: #8a5500;
  font-size: 26rpx;
  font-weight: 900;
  transform: rotate(-3deg);
}

.hero-title {
  margin-top: 18rpx;
  max-width: 440rpx;
  font-size: 56rpx;
  line-height: 1.12;
  font-weight: 950;
  color: #7c3b12;
  text-shadow: 0 5rpx 0 rgba(255, 255, 255, 0.55);
}

.hero-subtitle {
  margin-top: 18rpx;
  color: #573f48;
  font-size: 28rpx;
  font-weight: 700;
}

.hero-chip {
  display: inline-flex;
  margin-top: 28rpx;
  padding: 12rpx 22rpx;
  border: 4rpx solid #2a2428;
  border-radius: 999rpx;
  color: #2a2428;
  background: rgba(255, 255, 255, 0.35);
  font-weight: 900;
}

.pet-search {
  position: relative;
  z-index: 1;
  min-height: 84rpx;
  padding: 0 18rpx 0 34rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: #f6f6f7;
  border-radius: 999rpx;
  color: #aaa5aa;
  font-size: 28rpx;
}

.search-icon { font-size: 38rpx; color: #b8b4b8; }
.search-button {
  min-width: 126rpx;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #f43f6b;
  font-weight: 850;
}

.grid,
.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
}

.stats-grid,
.evidence-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: linear-gradient(145deg, #fff 0%, #fff2f6 100%);
  border-radius: 30rpx;
  padding: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(116, 91, 101, 0.09);
}

.stat-number {
  font-size: 46rpx;
  font-weight: 950;
  color: #f43f6b;
}

.stat-label {
  margin-top: 8rpx;
  color: #969196;
  font-size: 24rpx;
}

.action-card,
.quick-card {
  min-height: 172rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: linear-gradient(145deg, #fff 0%, #fff7fa 100%);
}

.service-card {
  min-height: 286rpx;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: #fff;
}

.service-card .action-icon {
  width: 136rpx;
  height: 136rpx;
  border-radius: 40rpx;
  margin: 0 0 18rpx;
  font-size: 72rpx;
}

.action-icon,
.role-mark,
.pet-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #ffe1e9 0%, #fff4c6 100%);
  color: #f43f6b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.pet-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin: 0 24rpx 0 0;
  font-size: 58rpx;
  flex-shrink: 0;
  box-shadow: inset 0 -10rpx 28rpx rgba(244, 63, 107, 0.1);
}

.row,
.info-row,
.between {
  display: flex;
  align-items: center;
}

.between,
.info-row { justify-content: space-between; }
.info-list { overflow: hidden; }

.info-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1edf0;
  gap: 24rpx;
}

.info-row:last-child { border-bottom: none; }

.label {
  color: #969196;
  font-size: 26rpx;
  flex-shrink: 0;
}

.value {
  color: #2b2528;
  font-size: 27rpx;
  text-align: right;
  word-break: break-all;
}

.primary,
.ghost,
.danger,
.mini-btn {
  width: 100%;
  min-height: 92rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 850;
  margin: 22rpx 0;
}

.primary {
  color: #fff;
  background: linear-gradient(135deg, #ff7a93 0%, #f43f6b 100%);
  box-shadow: 0 16rpx 34rpx rgba(244, 63, 107, 0.28);
}

.ghost {
  color: #f43f6b;
  background: #fff;
  border: 2rpx solid rgba(244, 63, 107, 0.16);
}

.danger {
  color: #fff;
  background: linear-gradient(135deg, #ff6b7d 0%, #d92d4e 100%);
  box-shadow: 0 16rpx 34rpx rgba(217, 45, 78, 0.25);
}

.mini-btn,
button[size="mini"] {
  width: auto;
  min-height: 58rpx;
  padding: 0 28rpx;
  margin: 18rpx 0 0;
  border-radius: 999rpx;
  background: #fff0f5;
  color: #f43f6b;
  font-size: 24rpx;
}

.form,
.form-card {
  position: relative;
  z-index: 1;
}

input,
textarea,
.field {
  width: 100%;
  min-height: 94rpx;
  background: #f8f8f9;
  border-radius: 26rpx;
  border: 1rpx solid rgba(244, 63, 107, 0.08);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  color: #2b2528;
}

textarea {
  min-height: 188rpx;
  line-height: 1.5;
}

.field {
  display: flex;
  align-items: center;
  color: #f43f6b;
  background: #fff7fa;
}

.tabs,
.status-tabs {
  display: flex;
  gap: 18rpx;
  margin: 12rpx 0 26rpx;
}

.status-tabs {
  gap: 0;
  justify-content: space-between;
  padding: 0 4rpx 18rpx;
  border-bottom: 1rpx solid #f0edf0;
}

.status-tab {
  position: relative;
  color: #666064;
  font-size: 30rpx;
  font-weight: 750;
  padding-bottom: 18rpx;
}

.status-tab.active {
  color: #232024;
  font-weight: 950;
}

.status-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 42rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #f43f6b;
  transform: translateX(-50%);
}

.tab {
  flex: 1;
  min-height: 80rpx;
  border-radius: 999rpx;
  background: #fff7fa;
  color: #f43f6b;
  font-weight: 800;
  border: 2rpx solid rgba(244, 63, 107, 0.16);
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #fff0f5;
  color: #f43f6b;
  font-size: 22rpx;
  font-weight: 850;
}

.badge.danger {
  background: #ffecef;
  color: #d63158;
}

.chip-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.chip {
  min-height: 44rpx;
  padding: 0 16rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 12rpx;
  color: #e0a01a;
  border: 2rpx solid #efbd44;
  font-size: 24rpx;
  font-weight: 700;
}

.chip.pink {
  color: #d35a75;
  border-color: #e18498;
}

.chip.blue {
  color: #4b9bdd;
  border-color: #68afe8;
}

.order-card {
  overflow: hidden;
}

.order-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  width: 10rpx;
  height: 100%;
  background: linear-gradient(180deg, #ff9ab0 0%, #f43f6b 100%);
}

.timeline {
  position: relative;
  padding-left: 28rpx;
}

.timeline-item {
  position: relative;
  padding: 0 0 28rpx 28rpx;
  border-left: 2rpx solid rgba(244, 63, 107, 0.18);
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: -10rpx;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #f43f6b;
  box-shadow: 0 0 0 8rpx rgba(244, 63, 107, 0.15);
}

.camera {
  width: 100%;
  height: 560rpx;
  border-radius: 34rpx;
  overflow: hidden;
  background: #222;
  box-shadow: 0 18rpx 44rpx rgba(0, 0, 0, 0.15);
}

.camera-shell {
  padding: 14rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.76);
  margin-bottom: 24rpx;
}

.actions { margin-top: 24rpx; }

.role {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.role-mark { margin: 0; }

.row .action-icon,
.row .pet-avatar {
  margin-bottom: 0;
}

.role-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #262125;
}

.role-tip {
  margin-top: 8rpx;
  color: #969196;
  font-size: 25rpx;
}

.bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 9999;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  padding: 18rpx 10rpx 10rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 34rpx;
  box-shadow: 0 14rpx 38rpx rgba(116, 91, 101, 0.16);
  border: 1rpx solid rgba(244, 63, 107, 0.1);
  pointer-events: auto;
}

.nav-item {
  min-height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #a8a4ac;
  font-size: 24rpx;
  pointer-events: auto;
}

.nav-icon {
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto 6rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #c7c3cc;
}

.nav-item.active {
  color: #f43f6b;
  font-weight: 850;
}

.nav-item.active .nav-icon {
  border-color: #f43f6b;
  background: #ffe7ee;
}

.profile-page {
  padding-top: 32rpx;
}

.profile-hero {
  position: relative;
  z-index: 1;
  min-height: 300rpx;
  margin: -36rpx -30rpx 28rpx;
  padding: 96rpx 30rpx 46rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: linear-gradient(180deg, #ffd7e2 0%, #fff3f7 100%);
  overflow: hidden;
}

.profile-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle, rgba(244, 63, 107, 0.12) 0 12rpx, transparent 13rpx) 12rpx 6rpx / 76rpx 76rpx;
}

.profile-hero::after {
  content: "🐾";
  position: absolute;
  right: 120rpx;
  bottom: 26rpx;
  color: rgba(244, 63, 107, 0.12);
  font-size: 74rpx;
}

.profile-avatar,
.profile-main,
.checkin-pill {
  position: relative;
  z-index: 1;
}

.profile-avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f43f6b;
  font-size: 72rpx;
  box-shadow: 0 16rpx 36rpx rgba(244, 63, 107, 0.12);
}

.profile-main {
  flex: 1;
}

.profile-name {
  font-size: 54rpx;
  font-weight: 950;
  color: #111;
  line-height: 1.15;
}

.profile-points {
  margin-top: 14rpx;
  color: #686267;
  font-size: 28rpx;
}

.checkin-pill {
  min-width: 136rpx;
  min-height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 850;
  background: linear-gradient(135deg, #ff9a53 0%, #f43f8b 100%);
  box-shadow: 0 12rpx 30rpx rgba(244, 63, 107, 0.25);
}

.profile-card {
  min-height: 128rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.profile-card .action-icon {
  margin: 0;
  flex-shrink: 0;
}

.reward-banner {
  min-height: 178rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #fff3c8 0%, #ffe0e8 58%, #fff 100%);
}

.menu-list {
  padding: 10rpx 30rpx;
}

.menu-item {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f0edf0;
  color: #2b2528;
  font-size: 32rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  width: 54rpx;
  height: 54rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #f43f6b;
  border: 3rpx solid #3f3b40;
  font-size: 24rpx;
  font-weight: 850;
}

.menu-arrow {
  color: #aaa5aa;
  font-size: 56rpx;
  line-height: 1;
}
