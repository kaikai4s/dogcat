}

.lottery-icon { font-size: 54rpx; }
.lottery-info { flex: 1; }
.lottery-title { font-size: 28rpx; font-weight: 800; }
.lottery-sub { font-size: 22rpx; color: #ccc; margin-top: 4rpx; }
.lottery-btn {
  background: #ff4d4f;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
}
