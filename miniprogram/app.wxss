}

.sitter-tags-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag-pill {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

.yellow-tag {
